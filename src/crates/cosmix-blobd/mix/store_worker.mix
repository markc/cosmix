-- version: 0.3.0
-- Primary wakes are explicit kicks. Only escaping infrastructure failures retry.
fn drain($run_job, $finish, $pause, $context)
  $retries = 0
  $finished = nil
  while true
    try
      if $finished == nil then $finished = $run_job($context) end
      if $finished == nil then return end
      $finish($finished)
      $finished = nil
    catch $message, $error
      if $error.code == "STORE_SUPERSEDED" then return end
      eprint("stored retry: " .. $error.code .. ": " .. $message)
      if $retries >= 3 then raise($error.code, $message) end
      $retries = $retries + 1
      $pause(60)
      continue
    end
  end
end
