-- version: 0.5.0
$c = require("store_client.mix")
$checks = buffer()
$dir = env("TMPDIR", "/tmp") .. "/store-client-test-" .. uuid()
mkdir($dir)
fn check($condition, $token)
  if not $condition then raise("TEST", $token) end
  buffer_push($checks, 1)
end
try
  $destination = $c.restore_begin($dir .. "/restored")
  write_file($destination.root .. "/verified", "bytes")
  check(not exists($destination.requested) and contains($destination.root, ".restored.partial-"), "INCOMPLETE_RESTORE_IS_DISTINCT")
  check($c.restore_publish($destination) == $dir .. "/restored" and read_file($dir .. "/restored/verified") == "bytes", "PUBLISH_COMPLETE_TREE")
  $caught = ""
  try
    $c.restore_begin($dir .. "/restored")
  catch $message, $error
    $caught = $error.code
  end
  check($caught == "STORE_DESTINATION", "RESTORE_NO_CLOBBER")
  mkdir($dir .. "/tree/nested")
  write_file($dir .. "/tree/empty", "")
  write_file($dir .. "/tree/nested/binary", bytes_from([0, 255, 1, 128]))
  write_file($dir .. "/tree/copy", bytes_from([0, 255, 1, 128]))
  $v = $c.inventory($dir .. "/tree")
  check($v.file_count == 3 and $v.size == 8, "BINARY_EMPTY_NESTED")
  check(length(keys($v.objects)) == 2, "DUPLICATE_BYTES")
  check($v.manifest.files[0].blob == "b3:" .. hash_file($dir .. "/tree/copy", "blake3"), "EXPLICIT_BLAKE3")
  check($c.inventory($dir .. "/tree").canonical == $v.canonical, "STABLE_INVENTORY")
  write_file($dir .. "/tree/copy", "changed")
  check($c.inventory($dir .. "/tree").id != $v.id, "MUTATION_DETECTED")
  symlink("nested/binary", $dir .. "/tree/link")
  $caught = ""
  try
    $c.inventory($dir .. "/tree")
  catch $message, $error
    $caught = $error.code
  end
  check($caught == "STORE_SOURCE", "SYMLINK_REFUSED")
  write_file($dir .. "/tree/.storeignore", "# literal rules\nlink\nnested/\n.storeignore\n")
  $ignored = $c.inventory($dir .. "/tree")
  check($ignored.file_count == 2, "LITERAL_AND_SUBTREE_IGNORE")
  write_file($dir .. "/tree/notes:2026.txt", "not representable")
  write_file($dir .. "/tree/*.tmp", "literal star")
  write_file($dir .. "/tree/.storeignore", "link\nnotes:2026.txt\n*.tmp\n.storeignore\n")
  check($c.inventory($dir .. "/tree").file_count == 3, "EXCLUDE_BEFORE_PATH_VALIDATION_AND_LITERAL_STAR")
  write_file($dir .. "/tree/.storeignore", "../escape\n")
  $caught = ""
  try
    $c.inventory($dir .. "/tree")
  catch $message, $error
    $caught = $error.code
  end
  check($caught == "STORE_IGNORE", "STRUCTURAL_IGNORE_VALIDATION")
  mkdir($dir .. "/excluded")
  $rules = ".storeignore\n"
  for $i = 0 to 10000
    $name = "e" .. to_string($i)
    write_file($dir .. "/excluded/" .. $name, "")
    $rules = $rules .. $name .. "\n"
  end
  write_file($dir .. "/excluded/.storeignore", $rules)
  check($c.inventory($dir .. "/excluded").file_count == 0, "EXCLUSIONS_DO_NOT_SPEND_WALK_LIMIT")
  $cfg = $c.configuration({node: "archive", instance: "two", "local-blobd": "blobd-fetch"})
  check($cfg.service == "stored-two.archive.bus" and $cfg.blobd == "blobd-two.archive.bus" and $cfg.local_blobd == "blobd-fetch", "EXPLICIT_ROUTING")
  check(length($c.configuration({instance: repeat("x", 24)}).service) == 31, "MAX_SERVICE_NAME")
  $caught = ""
  try
    $c.configuration({instance: repeat("x", 25)})
  catch $message, $error
    $caught = $error.code
  end
  check($caught == "STORE_CONFIG", "OVERSIZE_SERVICE_REFUSED")
  $c.cache_lock($dir .. "/cache", nil)
  mkdir($dir .. "/existing-cache")
  chmod($dir .. "/existing-cache", 0o755)
  $c.cache_lock($dir .. "/existing-cache", nil)
  check(stat($dir .. "/existing-cache").perm == 0o755, "EXISTING_CACHE_MODE_PRESERVED")
  for each $cache in [$dir .. "/tree/.", $dir .. "/tree/child-cache"]
    $caught = ""
    try
      $c.cache_lock($cache, realpath($dir .. "/tree"))
    catch $message, $error
      $caught = $error.code
    end
    check($caught == "STORE_CACHE" and not exists($cache .. "/.lock"), "INSIDE_SOURCE_REFUSED_BEFORE_LOCK")
  end
  $probe = "if flock(" .. json_encode($dir .. "/cache/.lock") .. ") then exit(1) end"
  check(run_argv(["/opt/cosmix/bin/mix", "-c", $probe]).ok, "SECOND_PROCESS_LOCK_REFUSED")
  check(stat($dir .. "/cache").perm == 0o700, "PRIVATE_CACHE")
  $caught = ""
  try
    mkdir($dir .. "/tree", {parents: false})
  catch $message
    $caught = $message
  end
  check($caught != "", "EXISTING_RESTORE_ROOT_REFUSED")
finally
  remove_dir($dir)
end
print("store_client_test: PASS " .. to_string(length(freeze($checks))))
