{
  "name": "epoch change, restored text differs",
  "about": "The restart lost the last edit (the fake restores the pre-edit text). The mirror goes Live on the service's text and keeps its own as a detached copy with a notice.",
  "path": "/fixture/doc.txt",
  "initial": "hello world\n",
  "run_id": 1,
  "steps": [
    {"local": {"id": "L1", "edit": {"items": [[5, 5, "!"]], "coalesce": true}}},
    {"send": {"id": "L1", "verb": "edit.insert", "caller": "local:ced",
      "args": {"buffer": "b1_0000e1e1", "at": 5, "text": "!", "base_rev": 0, "coalesce": true, "origin": "human:ced", "op_id": "c00000001-000001"},
      "expect": {"rc": 0, "rev": 1}}},
    {"deliver_all": {}},
    {"epoch_change": {"new_epoch": "0000e1e2", "text": "hello world\n"}}
  ],
  "expect": {"server_text": "hello world\n", "server_rev": 0, "converged": true, "conflicts": 0, "detached": true,
             "detached_text": "hello! world\n"}
}
