-- datatable.mix — SHARED SSR DataTable widget for every webd Mix-SSR list page.
-- ONE copy at /opt/cosmix/vhosts/shared/; `include`-d by a list handler
-- (after lib.mix, so esc()/url_encode() resolve at call-time). Gives sortable
-- columns + global search + numbered pagination driven ENTIRELY through the URL
-- query string, so the dcs.spa shell SPA swap enhances it for free and it
-- degrades to plain navigation with JS off. NO webd Rust change: db_query already
-- does ORDER BY/LIMIT/OFFSET/COUNT(*); jmap() already passes {filter,sort,
-- position,limit} → {ids,total}; the SPA already intercepts /admin/* + /pim/*.
--
-- ARCHITECTURE: state + render are SOURCE-AGNOSTIC and pure (call no db_query /
-- jmap); only the fetch differs, behind two thin adapters — dt_sql (SQLite) and
-- dt_jmap (maild) — both returning {rows, total}. The same $total feeds the same
-- pager. A handler picks the adapter matching its OWN granted capability; the
-- unused adapter is defined but never CALLED, and capability is enforced at
-- builtin dispatch (not a static scan), so this one shared file loads safely
-- under either a Db-only (admin) or Jmap-only (pim) handler profile.
--
-- SQL-INJECTION FIREWALL (§3 of the plan): the URL `sort` value is used ONLY to
-- select a spec row by exact ==; the string spliced into ORDER BY is the spec's
-- author-literal `col`, never the URL value. dir is bool-selected ASC/DESC. The
-- search term is ALWAYS a bind. The table name is a fixed handler literal. The
-- whitelist IS the firewall — a hostile ?sort=…)/DROP… matches no key and falls
-- back to the default column.

-- Row actions can render as a right-click (RMB) context menu instead of an inline
-- Actions column (opts.row_actions_contextmenu) — so the widget auto-generates a
-- cm_menu from row_action_specs + a modal shell, which needs contextmenu.mix +
-- modals.mix. include is load-once + script-relative, so handlers that also include
-- them dedup. (Pure SSR HTML builders — no db/jmap/bus — safe under any handler profile.)
include "/opt/cosmix/vhosts/shared/widgets/contextmenu.mix"
include "/opt/cosmix/vhosts/shared/widgets/modals.mix"

-- ─────────────────────── targeted partial patches ───────────────────────
-- A datatable sort/page/search/size click re-renders ONLY that table's region
-- via a Datastar SSE patch, not the whole content column. The boost shim
-- (shell.html) detects a link/form INSIDE a region (closest [id^="dt-region"])
-- and sends a `Datastar-Target: <region-id>` header; a list handler short-
-- circuits to dt_partial($html, $id) when dt_wants_partial($id) is true, BEFORE
-- building the full page body. No-JS, a full nav, and a view-change link (e.g.
-- "+ New") all skip this and get the full shell via doc(). Requires the
-- `datastar` Mix feature.
--
-- MULTI-INSTANCE: a single table uses opts.id "" → the historic "dt-region" +
-- bare URL params (?sort=&q=…), byte-identical to before. Two+ tables on one
-- page each set a distinct opts.id → region "dt-region-<id>" + namespaced params
-- (?<id>.sort=…), so their state and partial swaps never collide.

-- True when this request is a datatable in-region interaction (sort/page/
-- search/size): a Datastar GET (is_datastar_request, lib.mix) carrying the
-- shim's `Datastar-Target: dt-region` header. STRICTER than is_datastar_request
-- alone — an ordinary boosted nav into a list page is a Datastar GET too but
-- wants the full .cms-wrap patch, so it must NOT match here.
-- Region DOM id for a datatable instance. A nil/"" id → the single historic
-- "dt-region" (byte-identical to the pre-multi-instance widget); a non-empty id
-- → "dt-region-<id>", so two+ tables on ONE page get distinct patch targets.
-- The boost shim sends back the actual region id it found a click/submit inside
-- (closest [id^="dt-region"]), so dt_wants_partial matches the right instance.
function dt_region_id($id)
  if $id == nil or $id == "" then
    return "dt-region"
  end
  return "dt-region-" .. $id
end

-- True when this request is a datatable in-region interaction (sort/page/search/
-- size) for the instance $id (default = the single table). A Datastar GET
-- (is_datastar_request, lib.mix) carrying the shim's `Datastar-Target` header set
-- to THIS instance's region id. STRICTER than is_datastar_request alone — an
-- ordinary boosted nav into a list page is a Datastar GET too but wants the full
-- .cms-wrap patch, so it must NOT match here. With two tables on a page, each
-- handler tests its own id so only the interacted table re-renders.
function dt_wants_partial($id)
  if not is_datastar_request() then
    return false
  end
  if not has_key($HEADERS, "datastar-target") then
    return false
  end
  return ("" .. $HEADERS["datastar-target"]) == dt_region_id($id)
end

-- Wrap a datatable's rendered HTML in its stable region container. The wrapper
-- persists across partial swaps (the shim patches its INNER); emit this in the
-- full-page body so the region exists on the first/no-JS render and is the patch
-- target thereafter. $id (optional) namespaces the region for multi-table pages.
-- $skin (optional) adds the `.datatable-skin` class so assets/datatable.css
-- applies the Filament look — the class rides on the PERSISTENT region div (not
-- the swapped inner), so the skin survives every sort/page/search partial. Omit
-- it (or pass false/nil) for the historic unskinned region, byte-identical to
-- before. Pair with opts.skin:true so dt_render emits the matching markup.
function dt_region($html, $id, $skin)
  $cls = ""
  if $skin then
    $cls = ' class="datatable-skin"'
  end
  return '<div id="' .. dt_region_id($id) .. '"' .. $cls .. '>' .. $html .. '</div>'
end

-- The region-only SSE response: patch the instance's region inner with the freshly
-- rendered datatable html. $html is TRUSTED handler output (same trust as
-- {{CONTENT}}/doc()'s body) — framed verbatim. mode:inner matches the shim's
-- supported subset; the wrapper is NOT re-sent (it persists). $id (optional)
-- selects the region for multi-table pages (default = the single "dt-region").
function dt_partial($html, $id)
  $sel = "#" .. dt_region_id($id)
  $hdrs = { "Content-Type": "text/event-stream", "X-Content-Type-Options": "nosniff", "Cache-Control": "no-store" }
  return { status: 200, headers: $hdrs, body: ds_sse([ds_patch_elements($html, { selector: $sel, mode: "inner" })]) }
end

-- The DOM id of a datatable instance's RESULTS slot (the table + footer, inside the region):
-- "dt-results" / "dt-results-<id>". A SEARCH submit targets this (not the whole region) so
-- only the data table re-renders; the search box / filters / header (outside the slot) stay.
function dt_results_region_id($id)
  if $id == nil or $id == "" then
    return "dt-results"
  end
  return "dt-results-" .. $id
end

-- True when this request is a SEARCH-style results-only interaction for instance $id: a
-- Datastar GET whose `Datastar-Target` header is the RESULTS slot id (the search form sets
-- data-dt-target to it when live_search). The handler answers with dt_results_partial. A
-- non-search in-region interaction (sort/page/filter) targets the region id → dt_wants_partial.
function dt_wants_results($id)
  if not is_datastar_request() then
    return false
  end
  if not has_key($HEADERS, "datastar-target") then
    return false
  end
  return ("" .. $HEADERS["datastar-target"]) == dt_results_region_id($id)
end

-- The results-only SSE response: patch ONLY the instance's #dt-results slot inner (the
-- freshly rendered filter bar + table + footer, from dt_results_inner). $inner is TRUSTED
-- handler output. Used for a search submit so the header + search box (which stay OUTSIDE
-- the slot) are never swapped — no whole-region flicker, search focus naturally preserved.
-- (The filter bar IS inside the slot, so its q stays in sync; see dt_results_inner.)
function dt_results_partial($inner, $id)
  $sel = "#" .. dt_results_region_id($id)
  $hdrs = { "Content-Type": "text/event-stream", "X-Content-Type-Options": "nosniff", "Cache-Control": "no-store" }
  return { status: 200, headers: $hdrs, body: ds_sse([ds_patch_elements($inner, { selector: $sel, mode: "inner" })]) }
end

-- ═══════════════════════ Filament skin helpers (Phase 1) ═══════════════════════
-- The "skin" is OPT-IN and content-only: a handler sets opts.skin:true and wraps
-- its region with dt_region($html, $id, true) → a `.datatable-skin` class on
-- #dt-region. assets/datatable.css scopes the whole Filament look under that
-- class, so a page that does NOT opt in is byte-identical to before even though
-- the stylesheet is loaded globally. Everything below is additive — an existing
-- column/handler that sets none of the new opts renders exactly as it did.

-- Inline SVG icon registry (author-literal, never client input). A small set of
-- Heroicons-style outline glyphs (stroke=currentColor so they take the cell's
-- colour). Unknown name → "" (no icon), so a typo degrades silently rather than
-- emitting broken markup. Sized by CSS (.datatable-skin svg). No builtin, no
-- network — the markup is a fixed literal, so it can't carry an injection.
function dt_icon($name)
  $n = "" .. $name
  if $n == "search" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>'
  end
  if $n == "pencil" or $n == "edit" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>'
  end
  if $n == "trash" or $n == "delete" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path></svg>'
  end
  if $n == "check" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>'
  end
  if $n == "x" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>'
  end
  if $n == "plus" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>'
  end
  if $n == "eye" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>'
  end
  if $n == "funnel" or $n == "filter" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18l-7 8v6l-4 2v-8Z"></path></svg>'
  end
  if $n == "columns" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 3v18"></path><path d="M15 3v18"></path></svg>'
  end
  if $n == "chevron-left" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>'
  end
  if $n == "chevron-right" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>'
  end
  if $n == "chevrons-left" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17-5-5 5-5"></path><path d="m18 17-5-5 5-5"></path></svg>'
  end
  if $n == "chevrons-right" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 17 5-5-5-5"></path><path d="m13 17 5-5-5-5"></path></svg>'
  end
  if $n == "star" then
    return '<svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.8 5.9 21.4l1.4-6.8L2.2 9.9l6.9-.8Z"></path></svg>'
  end
  if $n == "clock" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>'
  end
  if $n == "dots" then
    return '<svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><circle cx="12" cy="5" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="12" cy="19" r="1.6"></circle></svg>'
  end
  if $n == "group" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18"></path><path d="M7 12h14"></path><path d="M7 19h14"></path><path d="M3 11v9"></path></svg>'
  end
  if $n == "list" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13"></path><path d="M8 12h13"></path><path d="M8 18h13"></path><path d="M3 6h.01"></path><path d="M3 12h.01"></path><path d="M3 18h.01"></path></svg>'
  end
  if $n == "grid" then
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg>'
  end
  -- The hardcoded SVGs above are the core chrome icons (render instantly, no JS).
  -- ANY other name (e.g. "mail-open" for the bulk Mark-read button) falls back to
  -- lucide — the SAME mechanism the row context menu uses — so a bulk_actions icon
  -- outside the core set renders instead of a blank button. (Was `return ""`, which
  -- silently dropped the mail-open bulk icon.)
  if $n == "" then return "" end
  return '<i data-lucide="' .. esc($n) .. '" aria-hidden="true"></i>'
end

-- Badge-variant whitelist: only these six class suffixes exist in datatable.css,
-- so an off-list (or nil) variant resolves to "gray" — a column's `color`/badge
-- variant can never inject an arbitrary class fragment. (S-4 / §3.1 discipline.)
function dt_color_ok($v)
  $s = lower(trim("" .. dt_or($v, "")))
  if $s == "primary" or $s == "success" or $s == "warning" or $s == "danger" or $s == "info" or $s == "gray" then
    return $s
  end
  return "gray"
end

-- A Filament badge pill. $text is escaped here (untrusted value); $variant is
-- whitelisted; $icon is an author-literal dt_icon name ("" = none). Use it from a
-- render lambda, or via a column's declarative `badge` opt (dt_cell calls it).
function dt_badge($text, $variant, $icon)
  $cls = "dt-badge dt-badge-" .. dt_color_ok($variant)
  $ic = ""
  $in = "" .. dt_or($icon, "")
  if $in != "" then
    $ic = dt_icon($in)
  end
  return '<span class="' .. $cls .. '">' .. $ic .. esc("" .. $text) .. '</span>'
end

-- A verified-style ring icon (green check ring / red x ring), matching the
-- Filament IconColumn->boolean() look. Truthiness via the existing dt_truthy.
function dt_cell_ring($v)
  if dt_truthy($v) then
    return '<span class="dt-icon-ring dt-ring-yes" title="Yes" aria-label="Yes">' .. dt_icon("check") .. '</span>'
  end
  return '<span class="dt-icon-ring dt-ring-no" title="No" aria-label="No">' .. dt_icon("x") .. '</span>'
end

-- Variant → CSS class for an action link/button (the ONE mapping, shared by
-- dt_action_link + the declarative dt_render_action). "primary" amber pill (default)
-- | "ghost" | "danger" | "action" (a bare amber text+icon link, the row-action style)
-- | "action-danger". An off-list variant falls back to "primary" (no class injection).
function dt_action_class($var)
  $v = "" .. dt_or($var, "primary")
  if $v == "ghost" then
    return "btn btn-ghost"
  end
  if $v == "danger" then
    return "btn btn-danger"
  end
  if $v == "action" then
    return "dt-action"
  end
  if $v == "action-danger" then
    return "dt-action dt-action-danger"
  end
  return "btn btn-primary"
end

-- One header/row action as a styled link. $a = { label, href, icon?, variant? }
-- href + label are author-literal (esc'd); icon is an author-literal dt_icon name.
function dt_action_link($a)
  $cls = dt_action_class($a["variant"])
  $ic = ""
  $in = "" .. dt_or($a["icon"], "")
  if $in != "" then
    $ic = dt_icon($in)
  end
  $label = "" .. dt_or($a["label"], "")
  -- A `post: true` field makes this a same-origin POST <form> button (href = the
  -- form action URL, `action` = the hidden action-verb field). Use it for a header
  -- action that triggers an bus_call on a route carrying MUTATING bus verbs: a GET
  -- <a> can't carry the X-CSRF-Token webd's bus gate demands off-POST, but a plain
  -- same-origin form POST satisfies the gate's POST branch (Origin/Referer + the
  -- SameSite session cookie), exactly like every SSR mutating form. No-JS safe (a
  -- native full-page submit); confirm/modal don't combine with it.
  if $a["post"] == true then
    $far = esc("" .. dt_or($a["href"], "#"))
    $av = esc("" .. dt_or($a["action"], ""))
    return '<form method="post" action="' .. $far .. '" class="dt-hdr-postform" style="display:inline">' .. '<input type="hidden" name="action" value="' .. $av .. '"><button type="submit" class="' .. $cls .. '">' .. $ic .. esc($label) .. '</button></form>'
  end
  -- A `modal` field makes this action a modal TRIGGER: a <button> that opens the
  -- dialog of that id (modals.mix / md_script), instead of an <a href> link. Only
  -- fires when `modal` is set, so href-based actions are byte-identical. The id is
  -- validated with dt_id_ok (same [a-z0-9_-] rule as modals.mix's md_id_ok — datatable
  -- can't depend on modals.mix) so a typo'd id is a loud config error, not a dead
  -- trigger; it is also esc'd, so it can never break out of the attribute.
  if $a["modal"] != nil then
    if not dt_id_ok("" .. $a["modal"]) then
      die("datatable: invalid action modal id (allowed [a-z0-9_-]): " .. ("" .. $a["modal"]))
    end
    -- A `modal_src` makes this a FETCH-on-open header action: an <a> whose href is the
    -- no-JS fallback AND the data-modal-src (modals.mix md_script lazy-fetches it into
    -- <dialog id=modal>, X-Modal-Fetch). Without modal_src it stays the static-dialog
    -- trigger (<button data-modal-open>) for a pre-rendered modal (e.g. media Upload).
    -- Symmetric with dt_render_action's row-action modal branch.
    $msrc = $a["modal_src"]
    if $msrc != nil then
      $mse = esc("" .. $msrc)
      return '<a class="' .. $cls .. '" href="' .. $mse .. '" data-modal-open="' .. esc("" .. $a["modal"]) .. '" data-modal-src="' .. $mse .. '">' .. $ic .. esc($label) .. '</a>'
    end
    return '<button type="button" class="' .. $cls .. '" data-modal-open="' .. esc("" .. $a["modal"]) .. '">' .. $ic .. esc($label) .. '</button>'
  end
  -- nil-guard href/label: `"" .. nil` is the literal "nil" in Mix, so a misconfigured
  -- action would otherwise emit a dead <a href="nil">nil</a>. Default to a no-op "#".
  $href = "" .. dt_or($a["href"], "#")
  return '<a class="' .. $cls .. '" href="' .. esc($href) .. '">' .. $ic .. esc($label) .. '</a>'
end

-- ─────────────────────── declarative row actions (Phase 3) ───────────────────────
-- dt_action($name, $opts) → one declarative row-action spec (opt-in via
-- opts.row_action_specs). Two kinds, by which of href/action is set:
--   NAV (href = fn($row) -> url): a styled <a>, no POST, no modal — Filament's own rule.
--   MUTATING (action = a verb string): a <button> that submits the table's wrapping
--     POST form carrying name=action value="row:<verb>:<id>" (id = bulk_id($row)); the
--     handler parses it with dt_row_action and BINDS the id. confirm (string) gates it
--     via the native <dialog> (S-6). The mini-form is the table's shared bulk/action
--     form — a row action never opens its OWN <form> (no nested forms).
--   label/icon/variant are author literals; variant → dt_action_class.
--   MODAL (modal = a static dialog id + href = fn($row) -> url): a per-row <a> that
--     (no-JS) navigates to href($row) and (JS) is intercepted by modals.mix's md_script
--     fetch-open handler to lazy-load href($row) into <dialog id=modal>. Filament's
--     "row Edit opens a modal" — see dt_render_action. href is the load-bearing url
--     (it is BOTH the no-JS fallback and the data-modal-src), so a modal action needs
--     href set; modal alone (no href) renders a dead trigger ("#").
function dt_action($name, $opts)
  $label = ""
  $icon = nil
  $variant = "action"
  $href = nil
  $action = nil
  $confirm = nil
  $modal = nil
  -- optional overrides for a mutating action in context-menu mode: post to a custom
  -- route (e.g. a native webd route that unlinks a file) with custom fields, instead of
  -- base_route + the row:<verb>:<id> wire format.
  $post_route = nil
  $post_fields = nil
  -- optional one-level flyout: a list of cm_item-shaped maps (e.g. one POST-per-folder using
  -- the {id} placeholder). Renders as a submenu in the auto-RMB (e.g. Move-to-folder).
  $submenu = nil
  if $opts != nil then
    if $opts["label"] != nil then
      $label = "" .. $opts["label"]
    end
    if $opts["icon"] != nil then
      $icon = $opts["icon"]
    end
    if $opts["variant"] != nil then
      $variant = "" .. $opts["variant"]
    end
    if $opts["href"] != nil then
      $href = $opts["href"]
    end
    if $opts["action"] != nil then
      $action = "" .. $opts["action"]
    end
    if $opts["confirm"] != nil then
      $confirm = "" .. $opts["confirm"]
    end
    if $opts["modal"] != nil then
      $modal = "" .. $opts["modal"]
    end
    if $opts["post_route"] != nil then
      $post_route = "" .. $opts["post_route"]
    end
    if $opts["post_fields"] != nil then
      $post_fields = $opts["post_fields"]
    end
    if $opts["submenu"] != nil then
      $submenu = $opts["submenu"]
    end
  end
  return { name: $name, "label": $label, icon: $icon, variant: $variant, href: $href, action: $action, confirm: $confirm, modal: $modal, post_route: $post_route, post_fields: $post_fields, submenu: $submenu }
end

-- Render ONE declarative action for a row. A mutating action (a[`action`] set) → a
-- submit button carrying the row:<verb>:<id> value; otherwise a nav <a> from href($row).
-- Action inner content + extra attrs, honouring the labels toggle. With opts.action_labels
-- == false AND an icon present, the label is moved to title + aria-label (icon-ONLY, but
-- still hover-discoverable + screen-reader-named) and dropped from the visible body. Default
-- (or when there's no icon, so the control is never empty) → icon + visible label, exactly
-- as before. $label is ALREADY esc'd (so it's attribute-safe). The ONE place the toggle is
-- applied → flip opts.action_labels to switch every row action at once.
function dt_action_body($ic, $label, $opts)
  -- icon-only ONLY when there's an icon AND a non-blank label — the label becomes the
  -- icon's ONLY accessible name (title + aria-label), since dt_icon SVGs are aria-hidden.
  -- A blank / whitespace-only label falls through to the default (icon + label body) so we
  -- never emit title=""/aria-label="" (an empty accessible name is worse than none).
  -- CONTRACT (unenforceable here): an action used with action_labels:false MUST carry a
  -- meaningful label, or the control has no accessible name at all — the widget can't
  -- manufacture one. Every Edit/View/Delete-style spec already does.
  if $opts["action_labels"] == false and $ic != "" and trim($label) != "" then
    return { inner: $ic, attrs: ' title="' .. $label .. '" aria-label="' .. $label .. '"' }
  end
  return { inner: ($ic .. $label), attrs: "" }
end

function dt_render_action($a, $row, $opts)
  $cls = dt_action_class($a["variant"])
  $ic = ""
  $in = "" .. dt_or($a["icon"], "")
  if $in != "" then
    $ic = dt_icon($in)
  end
  $label = esc("" .. dt_or($a["label"], ""))
  $body = dt_action_body($ic, $label, $opts)
  if $a["action"] != nil then
    -- mutating: submit the table's wrapping form with action=row:<verb>:<id>.
    $id = "" .. $opts["bulk_id"]($row)
    $cattr = ""
    if $a["confirm"] != nil and ("" .. $a["confirm"]) != "" then
      $cattr = ' data-confirm="' .. esc("" .. $a["confirm"]) .. '"'
    end
    return '<button type="submit" name="action" value="' .. esc("row:" .. ("" .. $a["action"]) .. ":" .. $id) .. '" class="' .. $cls .. '"' .. $cattr .. $body["attrs"] .. '>' .. $body["inner"] .. '</button>'
  end
  -- modal-trigger nav: a per-row <a> whose href($row) is BOTH the no-JS fallback (a full
  -- navigation to the edit page) AND the data-modal-src (modals.mix md_script fetches it
  -- with X-Modal-Fetch → the handler returns md_fragment(md_panel(...)) → patched into
  -- <dialog id=$a["modal"]> + showModal()). modal is an author-literal dialog id →
  -- dt_id_ok validated (same [a-z0-9_-] as md_id_ok; datatable can't depend on modals.mix);
  -- href is esc()'d once and reused for both attrs. Only fires when modal is set, so every
  -- existing href/action row spec is byte-identical.
  if $a["modal"] != nil then
    if not dt_id_ok("" .. $a["modal"]) then
      die("datatable: invalid row action modal id (allowed [a-z0-9_-]): " .. ("" .. $a["modal"]))
    end
    $murl = "#"
    if $a["href"] != nil then
      $murl = "" .. $a["href"]($row)
    end
    $me = esc($murl)
    return '<a class="' .. $cls .. '" href="' .. $me .. '" data-modal-open="' .. esc("" .. $a["modal"]) .. '" data-modal-src="' .. $me .. '"' .. $body["attrs"] .. '>' .. $body["inner"] .. '</a>'
  end
  -- nav: a styled <a> (href is a fn($row) -> url; nil-guarded to "#").
  $href = "#"
  if $a["href"] != nil then
    $href = "" .. $a["href"]($row)
  end
  return '<a class="' .. $cls .. '" href="' .. esc($href) .. '"' .. $body["attrs"] .. '>' .. $body["inner"] .. '</a>'
end

-- True when the table renders an actions column: a raw row_actions lambda (escape
-- hatch, wins) OR a non-empty declarative row_action_specs list.
function dt_has_row_actions($opts)
  if $opts["row_actions"] != nil then
    return true
  end
  if $opts["row_action_specs"] != nil and length($opts["row_action_specs"]) > 0 then
    return true
  end
  return false
end

-- True when any declarative row action is MUTATING (so dt_render must open the wrapping
-- POST form even without bulk). A raw row_actions lambda is the author's responsibility.
function dt_specs_have_mutation($opts)
  if $opts["row_action_specs"] == nil then
    return false
  end
  for each $a in $opts["row_action_specs"]
    if $a["action"] != nil then
      return true
    end
  end
  return false
end

-- True when any declarative row action carries a submenu. A submenu action has no `action`
-- of its own (so dt_specs_have_mutation misses it), but its POST sub-items use the {id}
-- placeholder, so the table still needs bulk_id to bind data-cm-id (dt_actions_cm_bind).
function dt_specs_have_submenu($opts)
  if $opts["row_action_specs"] == nil then
    return false
  end
  for each $a in $opts["row_action_specs"]
    if $a["submenu"] != nil then
      return true
    end
  end
  return false
end

-- ─────────────────── row actions as an RMB context menu (opt-in) ───────────────────
-- When opts.row_actions_contextmenu is set, the per-row Actions COLUMN is suppressed and
-- the SAME row_action_specs render as a right-click context menu instead: ONE generated
-- cm_menu template (built once), a per-row cm_bind payload spliced onto each <tr>, and a
-- modal shell + shim emitted once by the handler (dt_actions_chrome). A nav/modal action's
-- href is a per-ROW lambda, so the resolved per-row URL is bound WHOLE into data-cm-<name>
-- and the menu item references it via the no-encode {!<name>} placeholder; a mutating action
-- becomes a one-click POST submitting the identical row:<verb>:<id> wire format (so the
-- handler's dt_row_action dispatch is unchanged). Requires a non-empty declarative spec list
-- (a raw row_actions lambda can't be decomposed into items).

function dt_actions_as_menu($opts)
  if $opts["row_actions_contextmenu"] != true then
    return false
  end
  if $opts["row_action_specs"] == nil then
    return false
  end
  return length($opts["row_action_specs"]) > 0
end

-- Visible per-row Actions COLUMN? True in normal mode; in cm mode only when the
-- handler ALSO opted in via opts.row_actions_column (the cm menu stays a shortcut
-- over the SAME specs — one wire format, two affordances).
function dt_actions_column($opts)
  if not dt_has_row_actions($opts) then
    return false
  end
  if not dt_actions_as_menu($opts) then
    return true
  end
  return $opts["row_actions_column"] == true
end

-- Per-instance menu DOM id (mirrors the dt-bulk-form naming; satisfies cm_id_ok).
function dt_actions_menu_id($opts)
  if $opts["id"] == "" then
    return "dt-rowmenu"
  end
  return "dt-rowmenu-" .. $opts["id"]
end

-- The DATATABLE-owned modal dialog id for any modal row action. Distinct from a handler's
-- own md-* dialogs, so the generated chrome never duplicates a DOM id the handler emits.
function dt_actions_modal_id($opts)
  return dt_actions_menu_id($opts) .. "-modal"
end

-- Build the cm_menu item list ONCE from the specs (not per row). A separator precedes the
-- first danger/mutating item (Filament convention).
function dt_actions_cm_items($opts)
  $items = []
  $base = $opts["base_route"]
  $sep_added = false
  for each $a in $opts["row_action_specs"]
    -- cm_token the name so the {!<tok>} placeholder matches the data-cm-<tok> key cm_bind
    -- produces (cm_bind tokenises payload keys to [a-z0-9-]); an action name with "_"/caps
    -- would otherwise bind one key but reference another → a dead link.
    $tok = cm_token("" .. $a["name"])
    $is_mut = ($a["action"] != nil)
    $danger = ($a["variant"] == "action-danger" or $a["variant"] == "danger")
    -- a separator before the first danger OR mutating item (Filament convention)
    if ($danger or $is_mut) and not $sep_added then
      push($items, { sep: true })
      $sep_added = true
    end
    if $is_mut then
      -- MUTATING: one-click POST. By default → base_route with the row:<verb>:<id> wire
      -- format (handler dispatch unchanged). A spec MAY override post_route + post_fields to
      -- target a different route — e.g. a native webd route that can unlink a file, which the
      -- Mix base_route handler is sandboxed from doing (media delete). {id} resolves from the
      -- bound bulk_id either way.
      if $a["post_route"] != nil then
        $it = { "label": $a["label"], icon: $a["icon"], danger: $danger, post: $a["post_route"], fields: $a["post_fields"] }
      else
        $it = { "label": $a["label"], icon: $a["icon"], danger: $danger, post: $base, fields: { action: ("row:" .. ("" .. $a["action"]) .. ":{id}") } }
      end
      if $a["confirm"] != nil then
        $it["confirm"] = $a["confirm"]
      end
      push($items, $it)
    else
      if $a["submenu"] != nil then
        -- SUBMENU: a one-level flyout whose sub-items are author-built cm_item maps (e.g. one
        -- POST-per-folder using the {id} placeholder, resolved from the bound data-cm-id).
        -- cm_item renders the flyout; the sub-items are NOT pushed to $items (so they never
        -- trip the top-level separator). Not danger/mutating itself.
        push($items, { "label": $a["label"], icon: $a["icon"], submenu: $a["submenu"] })
      else
        if $a["modal"] != nil then
          -- MODAL: lazy-fetch the per-row URL (bound whole) into the datatable-owned dialog
          -- (its own id, never clashing with a handler's md-* dialog). The spec's modal value
          -- is only a marker here — dt owns the dialog id.
          push($items, { "label": $a["label"], icon: $a["icon"], modal: dt_actions_modal_id($opts), src: ("{!" .. $tok .. "}"), href: ("{!" .. $tok .. "}") })
        else
          -- NAV: a link whose whole href is the bound per-row URL
          push($items, { "label": $a["label"], icon: $a["icon"], href: ("{!" .. $tok .. "}") })
        end
      end
    end
  end
  return $items
end

-- Per-row cm_bind payload: each nav/modal action's RESOLVED per-row URL under data-cm-<name>,
-- plus data-cm-id (the bulk_id) when any mutating action exists. Appended to the <tr> attrs in
-- the row loop, so it re-emits on every SSE swap. Returns the ' data-cm-menu=.. data-cm-..' frag.
function dt_actions_cm_bind($opts, $row)
  $payload = {}
  $needs_id = false
  for each $a in $opts["row_action_specs"]
    if $a["action"] != nil then
      $needs_id = true
    else
      if $a["submenu"] != nil then
        -- a submenu action has no per-row href of its own; its POST sub-items use {id}
        -- (data-cm-id), so it needs the id bound but contributes no data-cm-<name>.
        $needs_id = true
      else
        $payload["" .. $a["name"]] = "" .. $a["href"]($row)
      end
    end
  end
  if $needs_id then
    $payload["id"] = "" .. $opts["bulk_id"]($row)
  end
  return cm_bind(dt_actions_menu_id($opts), $payload)
end

-- The once-per-page chrome: the generated menu template + one md_shell per distinct modal id
-- among the specs + the shim. The HANDLER appends this AFTER dt_region (full-page render ONLY,
-- so it lands in #content OUTSIDE the swapped region); the SSE partial returns do NOT. "" when
-- not in cm mode (so a handler can append it unconditionally).
function dt_actions_chrome($opts)
  if not dt_actions_as_menu($opts) then
    return ""
  end
  $h = cm_menu(dt_actions_menu_id($opts), dt_actions_cm_items($opts))
  -- ONE datatable-owned modal dialog covers every modal row action (so it never duplicates
  -- a handler's own md-* dialog). Emitted only when a modal action exists.
  $has_modal = false
  for each $a in $opts["row_action_specs"]
    if $a["modal"] != nil then
      $has_modal = true
    end
  end
  if $has_modal then
    -- The context-menu action modal is this ONE shared shell (every modal row action fetches
    -- into it). Its width defaults to "md"; a page whose row-action modals show wide content
    -- (e.g. /ssh/hosts CLI tool output) sets `action_modal_size` in its dt opts.
    $h = $h .. md_shell(dt_actions_modal_id($opts), { size: "" .. dt_or($opts["action_modal_size"], "md") })
  end
  $h = $h .. md_script()
  return $h
end

-- The actions <td> inner HTML for a row. The raw row_actions lambda WINS (S-9); else
-- the declarative specs render in order, optionally wrapped in a "⋮" <details> menu
-- (opts.row_actions_menu).
function dt_row_actions_html($opts, $row)
  if $opts["row_actions"] != nil then
    return $opts["row_actions"]($row)
  end
  $inner = ""
  for each $a in $opts["row_action_specs"]
    $inner = $inner .. dt_render_action($a, $row, $opts) .. " "
  end
  if $opts["row_actions_menu"] == true then
    return '<details class="dt-row-menu"><summary class="dt-iconbtn" aria-label="Row actions" title="Actions">' .. dt_icon("dots") .. '</summary><div class="dt-row-menu-panel">' .. $inner .. '</div></details>'
  end
  return $inner
end

-- Parse a posted row-action submit value "row:<verb>:<id>" → { verb, id } (strip the
-- "row:" prefix, split on the FIRST remaining ":" so an id may itself contain ":").
-- nil when the action isn't a row action or verb/id is empty. The handler dispatches on
-- the author-literal verb and treats `id` as UNTRUSTED — bind it, never splice it.
function dt_row_action($form)
  $a = $form["action"]
  if $a == nil then
    return nil
  end
  $a = "" .. $a
  if not starts_with($a, "row:") then
    return nil
  end
  $rest = substr($a, 4, length($a) - 4)
  $ci = pos(":", $rest)
  if $ci == 0 then
    return nil
  end
  $verb = substr($rest, 0, $ci - 1)
  $id = substr($rest, $ci, length($rest) - $ci)
  if $verb == "" or $id == "" then
    return nil
  end
  return { verb: $verb, id: $id }
end

-- ─────────────────────────── reorder (Phase 5, move-links, SQL-only) ───────────────────────────
-- True when the table is reorderable (opt-in opts.reorder = { col, id_col }). The order col
-- holds the manual sort position; ▲/▼ per-row buttons submit the table's shared POST form
-- with action="reorder:<dir>:<id>" (dir up|down), and the handler dispatches via
-- dt_reorder_action → dt_reorder_swap (an adjacent-row swap on the author-literal order col).
-- No drag-DnD (D-1). Default off → no reorder column, no form, byte-identical.
function dt_has_reorder($opts)
  if $opts["reorder"] == nil then
    return false
  end
  return true
end

-- Parse a posted reorder submit value "reorder:<dir>:<id>" → { dir, id } (dir is "up" or
-- "down"; split on the FIRST remaining ":" so an id may contain ":"). nil when it isn't a
-- reorder action or dir/id is empty / dir is not up|down. The handler treats `id` as
-- UNTRUSTED (binds it via dt_reorder_swap), exactly like dt_row_action.
function dt_reorder_action($form)
  $a = $form["action"]
  if $a == nil then
    return nil
  end
  $a = "" .. $a
  if not starts_with($a, "reorder:") then
    return nil
  end
  $rest = substr($a, 8, length($a) - 8)
  $ci = pos(":", $rest)
  if $ci == 0 then
    return nil
  end
  $dir = substr($rest, 0, $ci - 1)
  $id = substr($rest, $ci, length($rest) - $ci)
  if $id == "" or ($dir != "up" and $dir != "down") then
    return nil
  end
  return { dir: $dir, id: $id }
end

-- The reorder <td> inner HTML for a row: ▲ (up) / ▼ (down) submit buttons carrying
-- reorder:<dir>:<id> (id = bulk_id($row)), submitting the table's shared wrapping POST
-- form (no nested form — same model as a mutating row action / bulk). Both buttons always
-- render; a move with no adjacent row (top/bottom) is a server-side no-op (dt_reorder_swap
-- returns false), so an end-of-list press just redirects unchanged.
function dt_reorder_controls($opts, $row)
  $id = "" .. $opts["bulk_id"]($row)
  $h = '<span class="dt-reorder">'
  $h = $h .. '<button type="submit" name="action" value="' .. esc("reorder:up:" .. $id) .. '" class="dt-move-btn" aria-label="Move up" title="Move up">▲</button>'
  $h = $h .. '<button type="submit" name="action" value="' .. esc("reorder:down:" .. $id) .. '" class="dt-move-btn" aria-label="Move down" title="Move down">▼</button>'
  $h = $h .. '</span>'
  return $h
end

-- Codepoint-safe truncate with an ellipsis (col opt `limit`). $n <= 0 → unchanged.
function dt_truncate($s, $n)
  $str = "" .. $s
  if $n == nil or $n <= 0 then
    return $str
  end
  if length($str) <= $n then
    return $str
  end
  return substr($str, 0, $n) .. "…"
end

-- ─────────────────────────── column spec ───────────────────────────
-- dt_col($key, $label, $col, $opts) → one column map. Build each column with
-- this so optional keys default cleanly.
--   key       : stable id in the URL (?sort=key) + the whitelist token (exact ==).
--   label     : <th> text.
--   col       : the TRUSTED backing name — SQL column for dt_sql, maild sort
--               PROPERTY for dt_jmap. The ONLY thing spliced into ORDER BY /
--               sort[]. NEVER the URL value.
--   opts.sortable   (bool) render a sort link on the header.
--   opts.searchable (bool) include in the SQL LIKE OR-group (SQL only; JMAP
--                          search is whole-row text via filter:{text}).
--   opts.hidden     (bool) not rendered as a column, but may still be the
--                          default sort (e.g. an `updated` column).
--   opts.render     (fn($row)->html) owns the <td> inner HTML; output MUST
--                          already be escaped, and a first-column render lambda
--                          must NOT emit its own <a> (the widget supplies the
--                          row link; nested <a> is invalid HTML).
--   opts.type       ("text"|"boolean"|"datetime") cell-format sugar for a column
--                          WITHOUT a render lambda: boolean → a ✓/✗ glyph,
--                          datetime → a trimmed "YYYY-MM-DD HH:MM". A render
--                          lambda still wins (full control). Default "text".
--   opts.min_rank   (int)  role gate: hide this column (header + cells + search +
--                          sort) from a viewer whose opts.viewer_rank is below it.
--                          The rank is an INTEGER the handler computes from its
--                          OWN role ladder (role_rank), so the widget stays role-
--                          system-agnostic. See dt_rank_ok / the §gate note.
function dt_col($key, $label, $col, $opts)
  $sortable = false
  $searchable = false
  $hidden = false
  $render = nil
  $type = "text"
  $min_rank = nil
  -- Phase-1 declarative cell opts (all default nil → byte-identical for a column
  -- that sets none of them; dt_cell applies each only when present).
  --   badge  : fn($row) -> { text, variant?, icon? }  (a Filament badge pill)
  --   desc   : fn($row) -> a muted secondary line under the value (raw text)
  --   fmt    : fn($value) -> RAW replacement text (escaped once by dt_cell)
  --   prefix/suffix : author-literal raw text wrapped around the value
  --   limit  : int — truncate the value to N codepoints + ellipsis
  --   placeholder   : text shown (muted) when the backing value is nil
  $badge = nil
  $desc = nil
  $fmt = nil
  $prefix = nil
  $suffix = nil
  $limit = nil
  $placeholder = nil
  -- toggleable (Phase 2): when true, this column is USER-hideable via the column
  -- manager + the ?<pfx>hide= URL param. Display-only — a hidden-by-toggle column is
  -- still searchable/sortable (unlike min_rank, which also gates search+sort). Default
  -- off → the column always shows (byte-identical for any column that doesn't set it).
  $toggleable = false
  -- default_hidden (Phase 5): a TOGGLEABLE column that starts HIDDEN — not rendered until
  -- the user enables it in the Columns menu. Implies toggleable (a default-hidden column
  -- that isn't toggleable could never be shown). Drives the "managed-hide sentinel" in
  -- dt_state so a later "show" choice persists across sort/page (see there). Default off.
  $default_hidden = false
  -- summarize (Phase 4a): an aggregate over the WHOLE filtered dataset, rendered in the
  -- table's <tfoot> under this column. A string from the dt_agg_ok allowlist
  -- (sum|avg|count|min|max|range — the firewall for the SQL function name). The aggregate
  -- runs in a FRESH `SELECT <agg(col)> FROM <table> <where>` query, so `col` MUST be a real
  -- base-table column/expression — NOT a data-query-only projection alias (e.g. the
  -- `author` relationship alias built in dt_sql's $cols), which exists only in the row
  -- SELECT and would make the aggregate query fail at db_query. `count` ignores `col`
  -- (COUNT(*) row count). The widget can't see the handler's projection to enforce this,
  -- so it's a documented contract that fails LOUD (a SQL error) rather than silently. SQL-only —
  -- a JMAP handler never computes summaries (dt_sql_summary isn't called), so no <tfoot>.
  -- summary_fmt = an optional fn(rawvalue) -> raw text to format the aggregate (escaped
  -- once by dt_tfoot), e.g. fn(v) = v .. " entries". Default nil → both off → no <tfoot>.
  $summarize = nil
  $summary_fmt = nil
  -- align (deferred Phase-1 item): cell + header text alignment. A whitelisted value
  -- left|center|right (dt_align_cls maps it to a fixed .dt-align-* class; anything else →
  -- no class, so it can't inject). Default nil → no alignment class (byte-identical).
  $align = nil
  -- width (S-12): an explicit column width for table-layout:fixed (e.g. "6rem", "8%").
  -- Without it a column shares the remaining space equally with the other widthless
  -- columns. Used to pin a narrow control/thumbnail/short-vocabulary column so it doesn't
  -- grab a full data-column share. A handler LITERAL (never user input); dt_th still
  -- validates it against a safe number+unit pattern (rem|px|%|em|ch) before emitting, so a
  -- malformed value is dropped rather than injected. Default nil → no width (equal share).
  $width = nil
  -- tooltip (hover full-content): a fn($row) -> RAW text used as the cell <td>'s `title`
  -- attribute, so a CSS-ellipsised cell reveals its full content on hover. Default nil →
  -- AUTO: a column without a render/badge lambda derives the title from its backing value
  -- (the full, untruncated string) in dt_cell_tip; set it explicitly for a render-lambda
  -- column (the widget can't plain-text arbitrary HTML) or to override the auto text. The
  -- value is esc()'d once when emitted (attribute-safe). "" → no title attr for that cell.
  $tooltip = nil
  if $opts != nil then
    if $opts["sortable"] != nil then
      $sortable = $opts["sortable"]
    end
    if $opts["searchable"] != nil then
      $searchable = $opts["searchable"]
    end
    if $opts["hidden"] != nil then
      $hidden = $opts["hidden"]
    end
    if $opts["render"] != nil then
      $render = $opts["render"]
    end
    if $opts["type"] != nil then
      $type = $opts["type"]
    end
    if $opts["min_rank"] != nil then
      $min_rank = $opts["min_rank"]
    end
    if $opts["badge"] != nil then
      $badge = $opts["badge"]
    end
    if $opts["desc"] != nil then
      $desc = $opts["desc"]
    end
    if $opts["fmt"] != nil then
      $fmt = $opts["fmt"]
    end
    if $opts["prefix"] != nil then
      $prefix = $opts["prefix"]
    end
    if $opts["suffix"] != nil then
      $suffix = $opts["suffix"]
    end
    if $opts["limit"] != nil then
      $limit = $opts["limit"]
    end
    if $opts["placeholder"] != nil then
      $placeholder = $opts["placeholder"]
    end
    if $opts["toggleable"] != nil then
      $toggleable = $opts["toggleable"]
    end
    if $opts["default_hidden"] != nil then
      $default_hidden = $opts["default_hidden"]
      -- default_hidden implies toggleable (else it could never be un-hidden).
      if $default_hidden then
        $toggleable = true
      end
    end
    if $opts["summarize"] != nil then
      $summarize = $opts["summarize"]
    end
    if $opts["summary_fmt"] != nil then
      $summary_fmt = $opts["summary_fmt"]
    end
    if $opts["align"] != nil then
      $align = $opts["align"]
    end
    if $opts["width"] != nil then
      $width = $opts["width"]
    end
    if $opts["tooltip"] != nil then
      $tooltip = $opts["tooltip"]
    end
  end
  -- `label` is a reserved word in Mix, so the map key must be a string literal
  -- (`"label":`, not `label:`); accessed everywhere as $c["label"]. The other keys
  -- (key/col/render/…) are plain identifiers.
  return { key: $key, "label": $label, col: $col, sortable: $sortable, searchable: $searchable, hidden: $hidden, render: $render, type: $type, min_rank: $min_rank, badge: $badge, desc: $desc, fmt: $fmt, prefix: $prefix, suffix: $suffix, limit: $limit, placeholder: $placeholder, toggleable: $toggleable, default_hidden: $default_hidden, summarize: $summarize, summary_fmt: $summary_fmt, align: $align, width: $width, tooltip: $tooltip }
end

-- ─────────────────────────── filter spec (Phase 2) ───────────────────────────
-- dt_filter($name, $label, $opts) → one FILTER spec map (opt-in via opts.filters).
-- The whole filter surface is structured, never string-rewritten (SPINE S-4): a
-- filter resolves a URL token to author-literal {col, op, bind} SQL fragments and
-- an optional author-literal maild filter-condition — the URL value only ever
-- SELECTS an allowlisted option (or rides in as a bind for `text`), so no hostile
-- ?filter.x= can reach SQL except as a parameter.
--   name   : URL param tail (?<pfx>filter.<name>=) + the funnel control id. A short
--            [a-z0-9_-] token, NOT a reserved view-state name (dt_opts dies else).
--   label  : the funnel field label + the active-filter chip prefix.
--   opts.kind  : "select" (default) | "boolean" | "ternary" | "text".
--     select : opts.options = list of { value, label?, col, op?, bind?, jmap? }.
--              The token is == -matched to an option's `value`; the matched option
--              contributes `col <op> ?` (op default "="; the bind is opt.bind or,
--              absent that, the option's own author-literal value) + an optional
--              `jmap` maild condition. opts.multiple → a comma-joined multi-select
--              (the matched options OR together); see dt_filter_resolve_select.
--     boolean: opts.when_on = { col, op, bind?, jmap? } applied when the token is "1".
--     ternary: opts.when_true / opts.when_false (same predicate shape) for "1" / "0".
--     text   : opts.col → `col LIKE ?` bound to %token% (per-column search; SQL only,
--              no jmap — maild text is whole-object, can't be field-scoped here).
-- Every value spliced into SQL is an author literal (col/op) or a bind (value); the
-- allowlist of ops (dt_op_ok) is the firewall, exactly like sort's column whitelist.
function dt_filter($name, $label, $opts)
  $kind = "select"
  $options = []
  $multiple = false
  $col = nil
  $when_on = nil
  $when_true = nil
  $when_false = nil
  $true_label = nil
  $false_label = nil
  $placeholder = ""
  -- daterange (kind "daterange"): two ISO bounds on the author-literal `col`
  -- (col >= from AND col <= to). jmap_from / jmap_to are OPTIONAL maild property
  -- names (e.g. "after" / "before") that map the bounds into a JMAP condition; absent
  -- → the daterange is SQL-only with a clean JMAP fallback.
  $jmap_from = nil
  $jmap_to = nil
  if $opts != nil then
    if $opts["kind"] != nil then
      $kind = "" .. $opts["kind"]
    end
    if $opts["options"] != nil then
      $options = $opts["options"]
    end
    if $opts["multiple"] != nil then
      $multiple = $opts["multiple"]
    end
    if $opts["col"] != nil then
      $col = $opts["col"]
    end
    if $opts["when_on"] != nil then
      $when_on = $opts["when_on"]
    end
    if $opts["when_true"] != nil then
      $when_true = $opts["when_true"]
    end
    if $opts["when_false"] != nil then
      $when_false = $opts["when_false"]
    end
    if $opts["true_label"] != nil then
      $true_label = $opts["true_label"]
    end
    if $opts["false_label"] != nil then
      $false_label = $opts["false_label"]
    end
    if $opts["placeholder"] != nil then
      $placeholder = "" .. $opts["placeholder"]
    end
    if $opts["jmap_from"] != nil then
      $jmap_from = $opts["jmap_from"]
    end
    if $opts["jmap_to"] != nil then
      $jmap_to = $opts["jmap_to"]
    end
  end
  -- `label` is reserved → string key (as dt_col).
  return { name: $name, "label": $label, kind: $kind, options: $options, multiple: $multiple, col: $col, when_on: $when_on, when_true: $when_true, when_false: $when_false, true_label: $true_label, false_label: $false_label, placeholder: $placeholder, jmap_from: $jmap_from, jmap_to: $jmap_to }
end

-- The SQL comparison-operator allowlist (the filter firewall). col/op spliced into
-- SQL are ALWAYS one of these author literals; the value is always a bind. `IN` is
-- intentionally absent — a multi-select uses an OR of `=` clauses (uniform bind
-- numbering, no comma-placeholder building).
function dt_op_ok($op)
  $o = "" .. $op
  return $o == "=" or $o == "!=" or $o == ">" or $o == "<" or $o == ">=" or $o == "<=" or $o == "LIKE" or $o == "IS NULL" or $o == "IS NOT NULL"
end

-- IS [NOT] NULL take no bind; every other allowlisted op does.
function dt_op_needs_bind($op)
  $o = "" .. $op
  if $o == "IS NULL" or $o == "IS NOT NULL" then
    return false
  end
  return true
end

-- The reserved view-state param names a filter may NOT shadow (S-1). A dt_filter
-- whose name collides would let ?filter.<n>= fight the real state param.
function dt_is_reserved_filter($n)
  $s = "" .. $n
  return $s == "sort" or $s == "dir" or $s == "q" or $s == "page" or $s == "size" or $s == "box" or $s == "group" or $s == "reorder" or $s == "select_all"
end

-- Build a resolved filter from ONE author-literal predicate map (boolean/ternary):
--   $pred = { col, op?, bind?, jmap? }  (op default "="; bind unused for IS [NOT] NULL)
-- Returns nil when $pred is nil (an unconfigured branch → no clause).
function dt_filter_apply_frag($pred, $value, $label)
  if $pred == nil then
    return nil
  end
  $op = "" .. dt_or($pred["op"], "=")
  if not dt_op_ok($op) then
    die("datatable: filter op '" .. $op .. "' is not in the allowlist")
  end
  -- default the bind to the URL token value ($value: "1" boolean, "1"/"0" ternary)
  -- when the predicate omits an explicit bind — so `{ col: "featured" }` means
  -- `featured = 1`, mirroring the select path's dt_or($opt["bind"], $opt["value"]).
  -- IS [NOT] NULL take no bind (has_bind false), so the value is then ignored.
  $frag = { col: $pred["col"], op: $op, bind: dt_or($pred["bind"], $value), has_bind: dt_op_needs_bind($op) }
  return { value: $value, frags: [$frag], jmap: $pred["jmap"], "label": $label }
end

-- Find the author option whose `value` == the URL token (exact ==, the firewall).
-- nil when the token matches no allowlisted option (→ the filter drops).
function dt_filter_opt_for($f, $tok)
  for each $o in $f["options"]
    if ("" .. $o["value"]) == ("" .. $tok) then
      return $o
    end
  end
  return nil
end

-- Resolve a select (single or multiple) token. Each comma token (multiple) is
-- == -matched to an option; matched options' fragments OR together within the
-- filter (dt_where wraps them in one parenthesised group). The canonical `value`
-- is the matched tokens re-joined — so a hostile/garbage token is simply dropped
-- and never re-emitted in a link. jmap = the single condition, or an OR of
-- conditions for a multi-select, or nil when no option carried a jmap (SQL-only).
function dt_filter_resolve_select($f, $raw)
  $tokens = []
  if $f["multiple"] == true then
    for each $t in split("" .. $raw, ",")
      $tt = trim("" .. $t)
      if $tt != "" then
        push($tokens, $tt)
      end
    end
  else
    push($tokens, "" .. $raw)
  end
  $frags = []
  $jmaps = []
  $labels = []
  $vals = []
  for each $tok in $tokens
    $opt = dt_filter_opt_for($f, $tok)
    if $opt != nil then
      $op = "" .. dt_or($opt["op"], "=")
      if not dt_op_ok($op) then
        die("datatable: filter '" .. ("" .. $f["name"]) .. "' option op '" .. $op .. "' is not in the allowlist")
      end
      push($frags, { col: $opt["col"], op: $op, bind: dt_or($opt["bind"], $opt["value"]), has_bind: dt_op_needs_bind($op) })
      if $opt["jmap"] != nil then
        push($jmaps, $opt["jmap"])
      end
      push($labels, "" .. dt_or($opt["label"], $opt["value"]))
      push($vals, "" .. $opt["value"])
    end
  end
  if length($frags) == 0 then
    return nil
  end
  $jmap = nil
  if length($jmaps) == 1 then
    $jmap = $jmaps[0]
  end
  if length($jmaps) > 1 then
    $jmap = { operator: "OR", conditions: $jmaps }
  end
  return { value: join($vals, ","), frags: $frags, jmap: $jmap, "label": ("" .. $f["label"] .. ": " .. join($labels, ", ")) }
end

-- dt_filter_resolve($f, $raw) → the applied filter map { value, frags, jmap, label }
-- or nil when there is no/invalid selection. PURE — never queries. The returned
-- `value` is the canonical (allowlisted) token to re-emit in links + mark the
-- control selected; `frags` are the SQL fragments; `jmap` an optional maild
-- condition; `label` the chip text.
function dt_filter_resolve($f, $raw)
  if $raw == nil or trim("" .. $raw) == "" then
    return nil
  end
  $raw = trim("" .. $raw)
  $kind = "" .. $f["kind"]
  if $kind == "select" then
    return dt_filter_resolve_select($f, $raw)
  end
  if $kind == "boolean" then
    if $raw != "1" then
      return nil
    end
    return dt_filter_apply_frag($f["when_on"], "1", "" .. $f["label"])
  end
  if $kind == "ternary" then
    if $raw == "1" then
      return dt_filter_apply_frag($f["when_true"], "1", ("" .. $f["label"] .. ": " .. ("" .. dt_or($f["true_label"], "Yes"))))
    end
    if $raw == "0" then
      return dt_filter_apply_frag($f["when_false"], "0", ("" .. $f["label"] .. ": " .. ("" .. dt_or($f["false_label"], "No"))))
    end
    return nil
  end
  if $kind == "text" then
    if $f["col"] == nil then
      return nil
    end
    $frag = { col: $f["col"], op: "LIKE", bind: "%" .. $raw .. "%", has_bind: true }
    return { value: $raw, frags: [$frag], jmap: nil, "label": ("" .. $f["label"] .. ": " .. $raw) }
  end
  return nil
end

-- True iff $s is exactly YYYY-MM-DD (10 chars: digits with '-' at index 4 and 7).
-- A pure char loop (like dt_id_ok) — no datetime builtin. It does NOT check calendar
-- validity (month/day ranges); SQLite compares ISO dates lexically, so a wrong-shaped
-- value is dropped and a shaped-but-impossible one simply won't match a real row.
function dt_is_isodate($s)
  $x = "" .. $s
  if length($x) != 10 then
    return false
  end
  $i = 0
  while $i < 10
    $ch = substr($x, $i, 1)
    if $i == 4 or $i == 7 then
      if $ch != "-" then
        return false
      end
    else
      if not ($ch >= "0" and $ch <= "9") then
        return false
      end
    end
    $i = $i + 1
  end
  return true
end

-- Resolve a daterange filter from its two sub-params (?filter.<name>.from / .to). Each
-- bound is ISO-validated (dt_is_isodate) and dropped if malformed — so only well-formed
-- dates ride as binds. Builds `col >= ?from` AND `col <= ?to` (combine:"AND", unlike the
-- OR default), each bound a param. An optional JMAP condition is built from the spec's
-- jmap_from/jmap_to property names (absent → SQL-only). Returns nil when neither bound is
-- valid. The canonical `value` is "from..to" (either side may be empty), threaded as one
-- string and re-split into the two sub-params by dt_filter_param_pairs.
-- NOTE on a DATETIME column: the `to` bound is a lexical date boundary, so a row stamped
-- "2026-06-15 14:00:00" is EXCLUDED by `to=2026-06-15` (the time sorts after the bare
-- date). For an inclusive end-of-day on a datetime column, the handler should point the
-- filter at a DATE column or set `to` to the next day. (Pure DATE columns are exact.)
function dt_filter_resolve_daterange($f, $rawfrom, $rawto)
  if $f["col"] == nil then
    return nil
  end
  $col = $f["col"]
  $from = ""
  $to = ""
  if $rawfrom != nil and dt_is_isodate(trim("" .. $rawfrom)) then
    $from = trim("" .. $rawfrom)
  end
  if $rawto != nil and dt_is_isodate(trim("" .. $rawto)) then
    $to = trim("" .. $rawto)
  end
  if $from == "" and $to == "" then
    return nil
  end
  $frags = []
  $labels = []
  if $from != "" then
    push($frags, { col: $col, op: ">=", bind: $from, has_bind: true })
    push($labels, "from " .. $from)
  end
  if $to != "" then
    push($frags, { col: $col, op: "<=", bind: $to, has_bind: true })
    push($labels, "to " .. $to)
  end
  -- optional JMAP mapping (author-literal property names; only the present bounds).
  $jmap = nil
  if $f["jmap_from"] != nil or $f["jmap_to"] != nil then
    $jm = {}
    if $from != "" and $f["jmap_from"] != nil then
      $jm["" .. $f["jmap_from"]] = $from
    end
    if $to != "" and $f["jmap_to"] != nil then
      $jm["" .. $f["jmap_to"]] = $to
    end
    if length($jm) > 0 then
      $jmap = $jm
    end
  end
  return { value: ($from .. ".." .. $to), frags: $frags, jmap: $jmap, combine: "AND", "label": ("" .. $f["label"] .. ": " .. join($labels, " ")) }
end

-- ─────────────────────────── group spec (Phase 4b, SQL-only) ───────────────────────────
-- dt_group($key, $label, $col, $opts) → one GROUP spec (opt-in via opts.groups). Grouping
-- is RENDER-LAYER clustering (not SQL GROUP BY aggregation): when ?<pfx>group=<key> selects
-- a group, dt_sql prepends `<col> ASC` to ORDER BY and dt_render emits a spanning
-- <tr class="dt-group-header"> whenever the group value changes (re-emitted at the top of
-- every page — groups span pages, COUNT-first intact).
--   key   : the URL token (?group=<key>) + whitelist token (==-matched, the firewall).
--   label : the "Group by" option text + the group-header prefix ("Type: post").
--   col   : the TRUSTED backing name/expression spliced into ORDER BY (NEVER the URL value).
--           May be a data-query projection alias (`author`) OR a SQL expression
--           (`date(updated)`). When NO `value` fn is given, dt_render also reads $row[col]
--           for the group change-detection + header text, so `col` must then be a plain
--           selected column/alias that exists as a row-map key — a bare expression like
--           `date(updated)` is NOT a row key and needs a `value` fn (below).
--   opts.value : OPTIONAL fn($row) -> the group IDENTITY string, used for BOTH the
--                change-detection (when does a new group start) AND the header text. Supply
--                it whenever `col` is an expression (read the real field here), or to show a
--                friendlier label than the raw value. Must be CONSTANT within a SQL-ordered
--                group (it usually mirrors `col`). The header is esc'd regardless.
function dt_group($key, $label, $col, $opts)
  $value = nil
  if $opts != nil then
    if $opts["value"] != nil then
      $value = $opts["value"]
    end
  end
  return { key: $key, "label": $label, col: $col, value: $value }
end

-- ─────────────────────────── table options ───────────────────────────
-- dt_opts($o) fills defaults so a handler passes a sparse map. HARD-FAILS (die)
-- if base_route or default_sort is missing — both are load-bearing and a silent
-- nil poisons every link and the whole sort path.
function dt_opts($o)
  if $o["base_route"] == nil or $o["base_route"] == "" then
    die("datatable: base_route is required")
  end
  if $o["default_sort"] == nil or $o["default_sort"] == "" then
    die("datatable: default_sort is required")
  end
  -- Instance id (multi-table). "" = the single historic table: bare URL params
  -- (?sort=&q=…) + the "dt-region" patch target, byte-identical to before. A
  -- non-empty id namespaces this table's URL params (?<id>.sort=…) AND its region
  -- (#dt-region-<id>), so several tables coexist on one page without colliding.
  if $o["id"] == nil then
    $o["id"] = ""
  end
  if $o["id"] != "" and not dt_id_ok("" .. $o["id"]) then
    die("datatable: opts.id must be a short [a-z0-9_-] token, got '" .. ("" .. $o["id"]) .. "'")
  end
  if $o["page_size"] == nil then
    $o["page_size"] = 25
  end
  -- page_sizes: the "Per page" selector allowlist (also the size-param firewall —
  -- only a value in this list is honoured). Default on; a handler sets it to []
  -- (or a single-element list) to suppress the selector. The handler's page_size
  -- should be one of these so it renders as the active option.
  if $o["page_sizes"] == nil then
    $o["page_sizes"] = [10, 25, 50, 100]
  end
  if $o["default_dir"] == nil then
    $o["default_dir"] = "desc"
  end
  if $o["window"] == nil then
    $o["window"] = 2
  end
  -- simple (deferred Phase-1 item): a Prev/Next-only pager (no numbered page boxes), for a
  -- compact pager on long lists. Default false → the full windowed numbered pager (byte-
  -- identical). NOTE: this is the pager STYLE only; total is still computed via COUNT (the
  -- limit+1/skip-COUNT optimisation is a separate deferred follow-up — low value for the
  -- current small lists).
  if $o["simple"] == nil then
    $o["simple"] = false
  end
  if $o["search"] == nil then
    $o["search"] = false
  end
  if $o["search_placeholder"] == nil then
    $o["search_placeholder"] = "Search…"
  end
  -- search_split (Phase 4c, SQL-only): when true, the search term is tokenised on spaces
  -- and matched as an AND of per-word OR-groups — "foo bar" requires BOTH foo AND bar to
  -- appear (each in any searchable column), each word a bind. Default false → the whole
  -- term is ONE substring match (byte-identical). JMAP search is whole-object text that
  -- maild tokenises server-side, so this flag is a no-op for dt_jmap.
  if $o["search_split"] == nil then
    $o["search_split"] = false
  end
  -- live_search (real-time debounced search): when true, the search input gets a stable id
  -- + a data-dt-live marker, and dt_render emits dt_search_script — an inline debounce that
  -- auto-submits the search form ~250ms after the last keystroke. The boost shim already
  -- aborts the in-flight request + discards superseded responses (so no stale/out-of-order
  -- results) and now preserves the focused field's value+caret across the region swap (so
  -- typing is never disturbed); the live submit REPLACES history (no per-keystroke Back
  -- spam). Default false → no id/marker/script → byte-identical (the Search button baseline
  -- still works with JS off). Requires opts.search.
  if $o["live_search"] == nil then
    $o["live_search"] = false
  end
  -- live_search requires skin: a results-only search swap patches ONLY the #dt-results slot,
  -- and on a NON-skin table the total count ("N total") lives in the heading OUTSIDE the
  -- slot → it would go stale on every keystroke. The skin puts the count in the footer
  -- (inside the slot), so it re-renders with the table. Fail LOUD rather than ship a stale
  -- count. (Skin is the norm for list pages anyway.)
  if $o["live_search"] == true and $o["skin"] != true then
    die("datatable: live_search requires skin:true (the results count must live inside the #dt-results slot)")
  end
  -- compact (opt-in): a single dense top row — title hard-left, then a right-aligned cluster
  -- [bulk-trash · search · group-icon · funnel · columns · header-actions], NO subtitle, so
  -- the table starts right under it. Skin-only (it restyles the header band). With compact,
  -- live search re-renders the FULL region (no fade, focus preserved) since the filter
  -- controls move into the top row, out of the #dt-results slot.
  -- Skinned tables ALWAYS use the compact header (dt_header_band retired 2026-07-13);
  -- a subtitle, if set, becomes the title's tooltip in dt_compact_header. compact
  -- stays a skin-only layout — a NON-skin table keeps the historic inline header.
  if $o["skin"] == true then
    $o["compact"] = true
  end
  if $o["compact"] == nil then
    $o["compact"] = false
  end
  if $o["compact"] == true and $o["skin"] != true then
    die("datatable: compact requires skin:true")
  end
  if $o["caption"] == nil then
    $o["caption"] = ""
  end
  if $o["toolbar"] == nil then
    $o["toolbar"] = ""
  end
  if $o["noun"] == nil then
    $o["noun"] = lower("" .. $o["caption"])
  end
  -- action_labels (default true): show the text label beside each declarative row action's
  -- icon (Edit/View/Delete). Set FALSE for an icon-ONLY actions column — the label moves to
  -- title + aria-label (hover tooltip + screen-reader name preserved), the visible text is
  -- dropped. The toggle: `action_labels: false` → icons only; remove it (or true) → labels
  -- back. Default true = byte-identical (icon + visible label, as before).
  if $o["action_labels"] == nil then
    $o["action_labels"] = true
  end
  -- Bulk selection (opt-in). When on, dt_render adds a leading checkbox column +
  -- a "Delete selected" POST bar; the handler collects the ids with
  -- dt_selected_ids($form) and handles action=bulk_delete. bulk_id is REQUIRED
  -- (fn(row)->the delete id: slug for posts, JMAP id for contacts/events).
  if $o["bulk"] == nil then
    $o["bulk"] = false
  end
  -- Render row actions as a right-click context menu instead of an inline column
  -- (default off → byte-identical column). Requires declarative row_action_specs (a raw
  -- row_actions lambda can't be decomposed into menu items).
  if $o["row_actions_contextmenu"] == nil then
    $o["row_actions_contextmenu"] = false
  end
  if $o["row_actions_contextmenu"] and $o["row_actions"] != nil then
    die("datatable: row_actions_contextmenu needs declarative row_action_specs, not a raw row_actions lambda")
  end
  -- In cm mode, ALSO render the visible Actions column (discoverability — the cm menu
  -- alone is invisible affordance). No-op outside cm mode (the column shows anyway).
  if $o["row_actions_column"] == nil then
    $o["row_actions_column"] = false
  end
  -- Each nav/modal action's name becomes its data-cm-<tok> payload key AND its {!<tok>}
  -- placeholder (tok = cm_token(name)). An EMPTY token (e.g. name "_") never substitutes,
  -- and two names colliding on the same token (cv_edit/cvedit) cross-wire their links — both
  -- silent breaks. Fail LOUD at config rather than ship a dead menu item.
  if $o["row_actions_contextmenu"] and $o["row_action_specs"] != nil then
    $cm_seen = {}
    for each $cma in $o["row_action_specs"]
      if $cma["action"] == nil then
        $cmtk = cm_token("" .. $cma["name"])
        if $cmtk == "" then
          die("datatable: row_actions_contextmenu action name tokenises to empty: " .. ("" .. $cma["name"]))
        end
        if $cm_seen[$cmtk] == true then
          die("datatable: row_actions_contextmenu action names collide on cm token '" .. $cmtk .. "'")
        end
        $cm_seen[$cmtk] = true
      end
    end
  end
  if $o["bulk"] and $o["bulk_id"] == nil then
    die("datatable: bulk requires bulk_id (fn(row)->id)")
  end
  -- a mutating declarative row action also needs bulk_id (the row id rides in the
  -- button value row:<verb>:<id>); require it here so a non-bulk table with a mutating
  -- spec dies LOUD at config rather than crashing on a nil bulk_id per row.
  if dt_specs_have_mutation($o) and $o["bulk_id"] == nil then
    die("datatable: a mutating row_action_specs action requires bulk_id (fn(row)->id)")
  end
  -- a submenu action's POST sub-items resolve {id} from the bound data-cm-id, so it also
  -- needs bulk_id; require it LOUD here rather than crash on a nil bulk_id per row.
  if dt_specs_have_submenu($o) and $o["bulk_id"] == nil then
    die("datatable: a submenu row_action_specs action requires bulk_id (fn(row)->id)")
  end
  -- select-all-across-pages (S-5, opt-in). Requires bulk; the handler MUST dispatch
  -- dt_wants_all → dt_all_ids (re-run dt_where) so it never trusts posted ids. Default
  -- off → the bulk bar + form are byte-identical to before.
  if $o["select_all"] == nil then
    $o["select_all"] = false
  end
  if $o["select_all"] and not $o["bulk"] then
    die("datatable: select_all requires bulk")
  end
  if $o["bulk_label"] == nil then
    $o["bulk_label"] = "Delete selected"
  end
  -- bulk_actions: the generic multi-action bulk bar — a list of
  --   { name, label, class?, confirm? }
  -- each rendered as a submit button POSTing action="bulk_<name>" to base_route
  -- over the selected ids (dt_selected_ids); the handler dispatches on
  -- dt_bulk_action($form). When omitted but bulk is on, a single default
  -- "delete" action is synthesised so the historic bulk:true + bulk_label +
  -- action=bulk_delete contract (and the danger button + confirm) is unchanged.
  if $o["bulk"] and $o["bulk_actions"] == nil then
    $o["bulk_actions"] = [ { "name": "delete", "label": $o["bulk_label"], "class": "danger", "confirm": "Delete the selected items? This cannot be undone." } ]
  end
  -- Filament skin (opt-in, content-only). skin:false → every render path is
  -- byte-identical to the historic widget. skin:true switches dt_render to the
  -- Filament header band + toolbar strip + footer (range label + per-page select
  -- + amber pager). The handler must ALSO pass the flag to dt_region (so the
  -- `.datatable-skin` CSS scope is added): dt_region($html, opts.id, opts.skin).
  if $o["skin"] == nil then
    $o["skin"] = false
  end
  -- subtitle: a muted line under the title in the skin header (Filament's
  -- resource description). "" = none. Ignored when skin is off.
  if $o["subtitle"] == nil then
    $o["subtitle"] = ""
  end
  -- header_actions: a list of { label, href, icon?, variant? } amber pills in the
  -- skin header (e.g. "+ New entry"), the declarative replacement for the raw
  -- `toolbar` string (which still renders, appended, as the escape hatch). nil =
  -- none. Ignored when skin is off (use `toolbar` for the historic look).
  -- row_href / row_actions / row_class stay nil when absent; dt_render guards them.
  -- filters (opt-in, Phase 2). Validate each so a config typo dies LOUD here rather
  -- than silently mis-routing a URL param: the name must be a short [a-z0-9_-] token
  -- (it is a URL param tail + a control id), must not shadow a reserved view-state
  -- name (S-1), must have a known kind, and must carry the col/option backing a
  -- real SQL fragment (else dt_where would splice a nil column).
  if $o["filters"] != nil then
    for each $f in $o["filters"]
      $fn = "" .. $f["name"]
      if not dt_id_ok($fn) then
        die("datatable: filter name '" .. $fn .. "' must be a short [a-z0-9_-] token")
      end
      if dt_is_reserved_filter($fn) then
        die("datatable: filter name '" .. $fn .. "' is reserved (sort/dir/q/page/size/box/group/reorder/select_all)")
      end
      $fk = "" .. $f["kind"]
      if $fk != "select" and $fk != "boolean" and $fk != "ternary" and $fk != "text" and $fk != "daterange" then
        die("datatable: filter '" .. $fn .. "' has unknown kind '" .. $fk .. "'")
      end
      if $fk == "select" then
        if length($f["options"]) == 0 then
          die("datatable: select filter '" .. $fn .. "' has no options")
        end
        for each $o2 in $f["options"]
          if $o2["value"] == nil then
            die("datatable: select filter '" .. $fn .. "' has an option with no value")
          end
          if $o2["col"] == nil then
            die("datatable: select filter '" .. $fn .. "' option '" .. ("" .. $o2["value"]) .. "' has no col")
          end
        end
      end
      if $fk == "boolean" and ($f["when_on"] == nil or $f["when_on"]["col"] == nil) then
        die("datatable: boolean filter '" .. $fn .. "' needs when_on = { col, op?, bind? }")
      end
      if $fk == "ternary" then
        if $f["when_true"] == nil and $f["when_false"] == nil then
          die("datatable: ternary filter '" .. $fn .. "' needs when_true and/or when_false")
        end
        if $f["when_true"] != nil and $f["when_true"]["col"] == nil then
          die("datatable: ternary filter '" .. $fn .. "' when_true needs a col")
        end
        if $f["when_false"] != nil and $f["when_false"]["col"] == nil then
          die("datatable: ternary filter '" .. $fn .. "' when_false needs a col")
        end
      end
      if $fk == "daterange" and $f["col"] == nil then
        die("datatable: daterange filter '" .. $fn .. "' needs a col")
      end
      if $fk == "text" and $f["col"] == nil then
        die("datatable: text filter '" .. $fn .. "' needs a col")
      end
    end
  end
  -- groups (opt-in, Phase 4b). Validate each so a config typo dies LOUD: the key is a
  -- URL param value (?group=<key>) selected by ==, so it must be a short [a-z0-9_-] token,
  -- and `col` is the author literal prepended to ORDER BY. Grouping is SQL-only — dt_jmap
  -- dies if a group is active (the maild contract has no render-layer grouping).
  if $o["groups"] != nil then
    for each $g in $o["groups"]
      $gk = "" .. $g["key"]
      if not dt_id_ok($gk) then
        die("datatable: group key '" .. $gk .. "' must be a short [a-z0-9_-] token")
      end
      if $g["col"] == nil or ("" .. $g["col"]) == "" then
        die("datatable: group '" .. $gk .. "' needs a col")
      end
    end
  end
  -- reorder (opt-in, Phase 5). opts.reorder = { col, id_col } — both author-literal column
  -- names (the order col is swapped; id_col + bulk_id identify the moved row). Requires
  -- bulk_id (the move button carries reorder:<dir>:<bulk_id>). SQL-only.
  if $o["reorder"] != nil then
    if $o["reorder"]["col"] == nil or ("" .. $o["reorder"]["col"]) == "" then
      die("datatable: reorder needs { col, id_col } — col is missing")
    end
    if $o["reorder"]["id_col"] == nil or ("" .. $o["reorder"]["id_col"]) == "" then
      die("datatable: reorder needs { col, id_col } — id_col is missing")
    end
    if $o["bulk_id"] == nil then
      die("datatable: reorder requires bulk_id (fn(row)->id; the move button carries it)")
    end
  end
  return $o
end

-- ─────────────────────────── state parser ───────────────────────────
-- dt_state($query, $spec, $opts) → { q, sort, dir, sort_col, asc, page, pos,
-- limit, box }. Reads q/sort/dir/page/box from the RAW query string and validates
-- every value against the spec whitelist + sane ranges. Garbage falls back to
-- defaults, never errors.
--   q        : trimmed search term ("" = none).
--   sort     : a whitelisted column KEY (always non-empty — falls to default_sort).
--   dir      : "asc" | "desc".
--   sort_col : the TRUSTED backing name (col) for that key ("" = no ORDER BY).
--   asc      : bool.
--   page     : >= 1 integer (hard-ceiling 100000).
--   pos      : (page-1)*limit (the OFFSET / JMAP position).
--   box      : optional secondary nav key (Mail folder); "" when absent.
function dt_state($query, $spec, $opts)
  return dt_state_from_map(parse_query($query), $spec, $opts)
end

-- dt_state_from_map($p, $spec, $opts) — the same state builder over an ALREADY-parsed
-- param map (the body extracted from dt_state). Lets a handler rebuild the view state
-- from a POSTed form (parse_form gives the same name→value map) — the seam
-- select-all-across-pages uses to re-run dt_where server-side (S-5). The GET path
-- (dt_state) is byte-identical: it just parse_query's then delegates here.
function dt_state_from_map($p, $spec, $opts)
  $pfx = dt_pfx($opts)
  $vrank = $opts["viewer_rank"]

  -- A min_rank column with no viewer_rank is a handler misconfiguration: fail
  -- LOUD here rather than silently hiding the column everywhere (so it surfaces
  -- in dev), while a correctly-configured gate still hides cleanly downstream.
  if $vrank == nil then
    for each $gc in $spec
      if $gc["min_rank"] != nil then
        die("datatable: column '" .. ("" .. $gc["key"]) .. "' sets min_rank but opts.viewer_rank is unset")
      end
    end
  end

  $q = $p[$pfx .. "q"]
  if $q == nil then
    $q = ""
  end
  $q = trim("" .. $q)

  -- sort: must be a SORTABLE, role-visible column key present in the spec; else
  -- default_sort. A column gated out by min_rank can't be selected as the sort.
  $sortkey = $p[$pfx .. "sort"]
  if $sortkey == nil then
    $sortkey = ""
  end
  $valid = false
  $sortcol = ""
  for each $c in $spec
    if $c["sortable"] and dt_rank_ok($c, $vrank) and $c["key"] == $sortkey then
      $valid = true
      $sortcol = $c["col"]
    end
  end
  if not $valid then
    -- fall back to default_sort, but ONLY when it is visible to this viewer; a
    -- gated default column yields NO ORDER BY (insert order) rather than ordering
    -- a low-rank viewer by a column they can't see (a hidden default would
    -- otherwise leak ordering through the role gate).
    $sortkey = $opts["default_sort"]
    $sortcol = ""
    for each $dc in $spec
      if $dc["key"] == $sortkey and dt_rank_ok($dc, $vrank) then
        $sortcol = $dc["col"]
      end
    end
  end

  -- dir: exactly "asc"|"desc"; else default_dir.
  $dir = $p[$pfx .. "dir"]
  if $dir != "asc" and $dir != "desc" then
    $dir = $opts["default_dir"]
  end
  $asc = ($dir == "asc")

  -- page: >=1 integer, clamped to a hard ceiling so a hostile ?page=9999999 can't
  -- request an absurd OFFSET (the COUNT-first guard in dt_sql is the real
  -- backstop; this just bounds the arithmetic).
  $page = 1
  $praw = $p[$pfx .. "page"]
  if $praw != nil then
    $pn = to_number("" .. $praw)
    if $pn != nil and $pn >= 1 then
      $page = dt_trunc($pn)
      if $page > 100000 then
        $page = 100000
      end
    end
  end

  $box = $p[$pfx .. "box"]
  if $box == nil then
    $box = ""
  end

  -- size: ONLY a value present in the page_sizes allowlist is honoured (the size-param
  -- firewall); anything else falls back to the handler's page_size. The literal "all"
  -- (deferred Phase-1 item) is a sentinel — "no LIMIT" — honoured ONLY when "all" is itself
  -- in page_sizes (the allowlist is the firewall, exactly like a numeric size). When active
  -- it forces a single page; dt_sql omits LIMIT/OFFSET and dt_jmap uses a large cap.
  $limit = $opts["page_size"]
  $unlimited = false
  $sizeraw = $p[$pfx .. "size"]
  if $sizeraw != nil and $opts["page_sizes"] != nil then
    if ("" .. $sizeraw) == "all" then
      for each $cand in $opts["page_sizes"]
        if ("" .. $cand) == "all" then
          $unlimited = true
        end
      end
    else
      $sn = to_number("" .. $sizeraw)
      if $sn != nil then
        for each $cand in $opts["page_sizes"]
          if $cand == $sn then
            $limit = $sn
          end
        end
      end
    end
  end
  -- size_canon = the token re-emitted in links + matched to mark the active selector option
  -- ("all" or the numeric limit). For "all": page→1, and a large limit (1e9) used ONLY for
  -- pager arithmetic (ceil(total/1e9)=1 → no pager) — dt_sql omits LIMIT entirely on the
  -- `unlimited` flag, so the 1e9 never reaches SQL. NB "all" is SQL-INTENDED: on a JMAP table
  -- dt_jmap has no true unbounded mode and would pass 1e9 as the /query limit (a large cap
  -- maild may clamp/reject), so prefer "all" on SQL tables; a JMAP table opting in gets a
  -- best-effort large-cap fetch, not a guaranteed full set.
  $size_canon = $limit
  if $unlimited then
    $page = 1
    $limit = 1000000000
    $size_canon = "all"
  end
  $pos = ($page - 1) * $limit

  -- filters (S-1): read each ?<pfx>filter.<name>= token and resolve it against the
  -- spec allowlist. dt_filter_resolve returns nil for a missing/garbage/unmatched
  -- token (the filter just drops — never an error, never an unfiltered injection),
  -- so only well-formed selections ride on the state. filter_order preserves spec
  -- order → canonical SQL (dt_where) AND canonical URLs (dt_filter_url_parts).
  --   filters     : name -> { value, frags, jmap, label }  (the applied filters)
  --   filters_raw : name -> canonical token (link threading + control selected-state)
  --   filter_order: list of active filter names, spec order
  $filters = {}
  $filters_raw = {}
  $filter_order = []
  if $opts["filters"] != nil then
    for each $f in $opts["filters"]
      $fnm = "" .. $f["name"]
      -- daterange reads TWO sub-params (?filter.<name>.from / .to); every other kind
      -- is a single ?filter.<name>= token.
      if ("" .. $f["kind"]) == "daterange" then
        $res = dt_filter_resolve_daterange($f, $p[$pfx .. "filter." .. $fnm .. ".from"], $p[$pfx .. "filter." .. $fnm .. ".to"])
      else
        $res = dt_filter_resolve($f, $p[$pfx .. "filter." .. $fnm])
      end
      if $res != nil then
        $filters[$fnm] = $res
        $filters_raw[$fnm] = $res["value"]
        push($filter_order, $fnm)
      end
    end
  end

  -- toggleable column visibility (?<pfx>hide=k1,k2): the comma list of HIDDEN
  -- toggleable column keys. Each token is validated by == against the spec's
  -- TOGGLEABLE keys (unknown / non-toggleable tokens dropped — firewall, like sort);
  -- DISPLAY-only (search/sort unaffected). hide = a {key:true} set; hide_raw = the
  -- canonical comma string in spec order, re-emitted in every link.
  -- default_hidden columns (toggleable, non-spec-hidden, rank-visible), in spec order:
  -- the set that is hidden when the viewer has NOT yet managed columns (no ?hide= param).
  $dh = []
  for each $c in $spec
    if $c["default_hidden"] and $c["toggleable"] and not $c["hidden"] and dt_rank_ok($c, $vrank) then
      push($dh, $c["key"])
    end
  end
  $has_dh = (length($dh) > 0)

  $hide = {}
  $hkeys = []
  $hraw = $p[$pfx .. "hide"]
  if $hraw == nil then
    -- ABSENT: no column management yet. Seed the default-hidden set (none → {} as before).
    for each $k in $dh
      $hide[$k] = true
      push($hkeys, $k)
    end
  else
    -- PRESENT (authoritative — even ""/"~"): the viewer is managing columns, so defaults no
    -- longer apply; parse the real hidden keys. A leading "~" is the managed sentinel (not a
    -- real key → inert here); its job is to keep the param non-empty so a "show all" choice
    -- survives dt_href (which drops an empty value).
    $wanted = {}
    for each $tok in split("" .. $hraw, ",")
      $tt = trim("" .. $tok)
      if $tt != "" then
        $wanted[$tt] = true
      end
    end
    for each $c in $spec
      -- validate against the SAME visible-toggle set the manager offers: toggleable,
      -- not a spec-hidden column, and rank-visible to THIS viewer — so a low-rank
      -- viewer can't probe a role-gated column key via a reflected hide_raw link.
      if $c["toggleable"] and not $c["hidden"] and dt_rank_ok($c, $vrank) and $wanted[$c["key"]] == true then
        $hide[$c["key"]] = true
        push($hkeys, $c["key"])
      end
    end
  end
  -- canonical hide_raw. With default_hidden columns present, ALWAYS carry the "~" sentinel
  -- (managed marker) so the param is never dropped as empty — that's what makes "show the
  -- default-hidden column" persist across a sort/page/filter click. Without any default_hidden
  -- column this is byte-identical to before (plain comma list, "" when nothing hidden).
  if $has_dh then
    -- SINGLE-quoted '~' is mandatory: a double-quoted bare "~" lex-expands to $HOME in Mix
    -- (leading-tilde home expansion). Single quotes keep it the literal sentinel char.
    $hide_raw = '~'
    if length($hkeys) > 0 then
      $hide_raw = '~,' .. join($hkeys, ",")
    end
  else
    $hide_raw = join($hkeys, ",")
  end

  -- grouping (Phase 4b): ?<pfx>group=<key> selects a group-by column KEY, validated by ==
  -- against opts.groups (the firewall, exactly like sort). group = the canonical key
  -- (re-emitted in links + the control selected-state); group_col = the author-literal col
  -- dt_sql prepends to ORDER BY + dt_render reads for the header change detection. Default
  -- OFF (no default_group in v1 — keeps canonical URLs clean: no grouping = param absent).
  -- A param that matches no group simply drops (no grouping). When opts.groups is unset,
  -- both stay "" → byte-identical (no group ORDER BY prepend, no headers).
  $group = ""
  $group_col = ""
  if $opts["groups"] != nil then
    $graw = $p[$pfx .. "group"]
    if $graw != nil then
      $graw = "" .. $graw
      for each $g in $opts["groups"]
        if ("" .. $g["key"]) == $graw then
          $group = $graw
          $group_col = $g["col"]
        end
      end
    end
  end

  -- viewer_rank rides on the state so the source adapters (dt_sql) gate search
  -- without a signature change — they already receive $state.
  return { q: $q, sort: $sortkey, dir: $dir, sort_col: $sortcol, asc: $asc, page: $page, pos: $pos, limit: $limit, size: $size_canon, box: $box, viewer_rank: $vrank, filters: $filters, filters_raw: $filters_raw, filter_order: $filter_order, hide: $hide, hide_raw: $hide_raw, group: $group, group_col: $group_col, search_split: dt_or($opts["search_split"], false), unlimited: $unlimited }
end

-- Integer truncate toward zero. ONLY valid for n >= 0 (page/pos are pre-clamped
-- >=1); do not reuse on negatives (dt_trunc(-1.5) == -1, not -2).
function dt_trunc($n)
  return $n - ($n % 1)
end

-- nil-coalesce helper: $def when $v is nil, else $v.
function dt_or($v, $def)
  if $v == nil then
    return $def
  end
  return $v
end

-- URL param-name prefix for a datatable instance: "" for the default single
-- table (bare ?sort=&q=… — byte-identical to the historic widget), else "<id>."
-- so two+ tables on one page namespace their own state. Read from $opts["id"] so
-- every state/url function shares the one source of truth.
function dt_pfx($opts)
  $id = $opts["id"]
  if $id == nil or $id == "" then
    return ""
  end
  return $id .. "."
end

-- opts.id is author-set (never client input) and flows into a DOM id
-- (dt-region-<id>, dt-bulk-form-<id>), CSS/querySelector selectors, and URL
-- param names — so it must be a short [a-z0-9_-] token. dt_opts dies on anything
-- else, turning a selector/markup-breaking typo into a loud config error.
function dt_id_ok($s)
  if $s == "" then
    return false
  end
  $i = 0
  $n = length($s)
  while $i < $n
    $ch = substr($s, $i, 1)
    if not (($ch >= "a" and $ch <= "z") or ($ch >= "0" and $ch <= "9") or $ch == "-" or $ch == "_") then
      return false
    end
    $i = $i + 1
  end
  return true
end

-- Role gate predicate. A column with no min_rank is visible to everyone. A column
-- WITH min_rank is visible only when the viewer's rank ($vrank, an integer the
-- handler computed from its own role ladder) is set AND meets it — an UNSET rank
-- FAILS CLOSED. dt_state turns a min_rank-without-viewer_rank misconfiguration
-- into a loud die() so it can't silently hide a column in dev.
--
-- ── what min_rank IS, and is NOT (read before relying on it) ──
-- min_rank is a per-column DISPLAY/SEARCH/SORT visibility gate, NOT a data-access
-- ACL. It removes a column from: the <th> header, the <td> cells, the SQL search
-- OR-group (dt_sql), and sort selectability (dt_state) — so a low-rank viewer
-- can neither see, search-by, nor sort-by the column. It deliberately does NOT:
--   • rewrite the SQL projection — dt_sql still does SELECT * (and MUST, so
--     row_href/bulk_id can read backing fields like slug/id that are not spec
--     columns). The gated column's bytes are FETCHED into $row server-side but
--     never rendered to the client. A column whose BYTES are themselves secret
--     (pass_hash) must be excluded from the fetch via dt_sql's $cols projection,
--     exactly as users.mix already does — min_rank is not a substitute for that.
--   • field-scope a JMAP table's text search — dt_jmap's filter:{text} is a
--     WHOLE-OBJECT match in maild that the widget cannot restrict to visible
--     fields. So on a JMAP table, min_rank gates render+sort only; dt_jmap
--     therefore REFUSES (die) the min_rank + caps.text:true combination unless
--     the handler sets caps.text:false, or explicitly accepts whole-object search
--     with caps.allow_gated_text:true (when the gated columns aren't search-sensitive).
-- In short: pair min_rank with $cols (SQL) / caps.text:false (JMAP) and the
-- handler's own auth when a column is a true secret; use it alone for "this
-- column is just clutter / staff-only chrome for lower roles".
function dt_rank_ok($c, $vrank)
  $mr = $c["min_rank"]
  if $mr == nil then
    return true
  end
  if $vrank == nil then
    return false
  end
  return $vrank >= $mr
end

-- Toggle-visibility gate. A non-toggleable column is always visible (?hide= can't
-- touch it); a toggleable column is visible unless its key is in the hide-set.
-- DISPLAY-only — see dt_col_shown for how it composes with the rank/hidden gates.
function dt_col_visible($c, $state)
  if not $c["toggleable"] then
    return true
  end
  return not ($state["hide"][$c["key"]] == true)
end

-- The ONE column render gate: a column is shown iff it is not a hidden spec column,
-- the viewer's rank clears it (min_rank), AND it is not toggled off. The AND with
-- dt_rank_ok means ?hide= can only SUBTRACT a visible column, never reveal a
-- role-gated one (M3). With no toggleable columns this is exactly the historic
-- `not hidden and dt_rank_ok` gate (dt_col_visible returns true) → byte-identical.
function dt_col_shown($c, $opts, $state)
  return not $c["hidden"] and dt_rank_ok($c, $opts["viewer_rank"]) and dt_col_visible($c, $state)
end

-- ─────────────────────────── SQL adapter ───────────────────────────
-- dt_sql($table, $spec, $state[, $cols]) → {rows, total}. $table is a FIXED
-- handler literal, never client input. Search columns + the sort column are spec
-- literals; the search TERM is a bind. COUNT runs FIRST so an out-of-range page
-- skips the data query entirely (no giant-OFFSET scan). Bind placeholders are
-- numbered inline (no second renumber pass). $cols is an OPTIONAL handler-literal
-- column projection (never client input) for the data SELECT — defaults to "*";
-- pass an explicit list to avoid pulling heavy/sensitive columns (media.data
-- base64, users.pass_hash/salt).
-- dt_where($spec, $state) -> { where, binds } — the ONE place the WHERE clause +
-- ordered bind list are assembled (SPINE S-2). Two contributions, both pure:
--   1. the search OR-group over searchable, role-visible columns (term ALWAYS a bind);
--   2. the structured filter AND-groups (S-4) — each active filter becomes one
--      parenthesised OR-group of its `col <op> ?` fragments (multi-select ORs its
--      options), col/op author literals, every value a bind, numbered AFTER the
--      search binds so filters/summaries/select-all share one numbering source.
-- Groups join with AND. PURE — never calls db_query. The caller numbers any trailing
-- LIMIT/OFFSET placeholders from length(binds). With NO filters this is byte-identical
-- to the search-only path (one group → " WHERE (...)"; none → "").
-- dt_search_like_group($spec, $state, $term, $start_bn) → { group, binds, n } — PURE. ONE
-- parenthesised OR-group of `col LIKE ?` over the searchable, role-visible columns for a
-- SINGLE term, binds numbered from $start_bn+1 (n = how many were added). group "" + n 0
-- when no searchable column is visible. Both the whole-term and the split-word paths build
-- on this, so the per-term clause + bind shape is defined in one place.
function dt_search_like_group($spec, $state, $term, $start_bn)
  $clauses = []
  $binds = []
  $bn = $start_bn
  $like = "%" .. $term .. "%"
  for each $c in $spec
    if $c["searchable"] and dt_rank_ok($c, $state["viewer_rank"]) then
      $bn = $bn + 1
      push($clauses, $c["col"] .. " LIKE ?" .. ("" .. $bn))
      push($binds, $like)
    end
  end
  if length($clauses) == 0 then
    return { group: "", binds: [], n: 0 }
  end
  return { group: ("(" .. join($clauses, " OR ") .. ")"), binds: $binds, n: ($bn - $start_bn) }
end

function dt_where($spec, $state)
  $binds = []
  $bn = 0
  $groups = []

  -- 1. search. Default: ONE OR-group over the whole term (byte-identical). With
  --    search_split (Phase 4c): the term is tokenised on spaces into an AND of per-word
  --    OR-groups (each word a bind) — "foo bar" matches rows with BOTH words somewhere.
  --    Search binds always come first (?1..?n), so filters number after them.
  if $state["q"] != "" then
    $terms = []
    if dt_or($state["search_split"], false) then
      for each $word in split($state["q"], " ")
        $w = trim("" .. $word)
        if $w != "" then
          push($terms, $w)
        end
      end
    else
      push($terms, $state["q"])
    end
    for each $term in $terms
      $g = dt_search_like_group($spec, $state, $term, $bn)
      if $g["group"] != "" then
        push($groups, $g["group"])
        for each $b in $g["binds"]
          push($binds, $b)
        end
        $bn = $bn + $g["n"]
      end
    end
  end

  -- 2. structured filter AND-groups, in spec order (filter_order). col/op are
  --    author literals; each bound value is appended after the search binds.
  $fo = $state["filter_order"]
  if $fo != nil then
    for each $fname in $fo
      $rf = $state["filters"][$fname]
      $grp = []
      for each $cl in $rf["frags"]
        if $cl["has_bind"] then
          $bn = $bn + 1
          push($grp, $cl["col"] .. " " .. $cl["op"] .. " ?" .. ("" .. $bn))
          push($binds, $cl["bind"])
        else
          push($grp, $cl["col"] .. " " .. $cl["op"])
        end
      end
      if length($grp) > 0 then
        -- a filter's fragments join with its `combine` (default OR — multi-select; a
        -- daterange sets "AND" so from <= col <= to is a conjunction, not everything).
        $join = " OR "
        if $rf["combine"] == "AND" then
          $join = " AND "
        end
        push($groups, "(" .. join($grp, $join) .. ")")
      end
    end
  end

  $where = ""
  if length($groups) > 0 then
    $where = " WHERE " .. join($groups, " AND ")
  end
  return { where: $where, binds: $binds }
end

-- dt_order_by($state) -> the " ORDER BY …" clause (or "") — PURE, the testable core of
-- dt_sql's ordering. The group col (Phase 4b, when active) is prepended so rows cluster by
-- group, then the whitelisted sort col + bool-selected dir. Both cols are author literals
-- (group_col from the ==-matched group spec, sort_col from the sort spec) — NEVER a URL
-- value. When the group col EQUALS the active sort col it is emitted ONCE in the sort's
-- direction (so sorting the grouped column still reverses it — never "kind ASC, kind DESC"
-- where the prepend would silently override the sort control). With no group this is
-- byte-identical to the historic single-part " ORDER BY sort_col dir"; empty group + empty
-- sort → "" (insert order).
function dt_order_by($state)
  $orderparts = []
  $gc = "" .. dt_or($state["group_col"], "")
  $sc = "" .. dt_or($state["sort_col"], "")
  $sortdir = "ASC"
  if not $state["asc"] then
    $sortdir = "DESC"
  end
  if $gc != "" then
    if $gc == $sc then
      -- grouped column is also the sort column → one term, honouring the sort direction.
      push($orderparts, $gc .. " " .. $sortdir)
    else
      push($orderparts, $gc .. " ASC")
    end
  end
  if $sc != "" and $sc != $gc then
    push($orderparts, $sc .. " " .. $sortdir)
  end
  if length($orderparts) == 0 then
    return ""
  end
  return " ORDER BY " .. join($orderparts, ", ")
end

function dt_sql($table, $spec, $state, $cols)
  -- 1. WHERE + binds via the single builder (search OR-group; Phase-2 filters AND
  --    on inside dt_where). $bn = the number of WHERE binds → LIMIT/OFFSET follow.
  $w = dt_where($spec, $state)
  $where = $w["where"]
  $binds = $w["binds"]
  $bn = length($binds)

  -- 2. COUNT first — same WHERE/binds, no LIMIT. Total drives the pager AND the
  --    out-of-range skip below.
  $countSql = "SELECT COUNT(*) AS total FROM " .. $table .. $where
  $cr = db_query($countSql, $binds)
  $total = 0
  if length($cr) > 0 then
    $total = dt_trunc(to_number("" .. $cr[0]["total"]))
  end

  -- 3. Out of range (page past the end): no data query, just an empty page.
  if $state["pos"] >= $total then
    return { rows: [], total: $total }
  end

  -- 4. ORDER BY via the pure dt_order_by builder (group prepend + whitelisted sort).
  $order = dt_order_by($state)

  -- 5. Data query: optional handler-literal projection ($cols, default "*");
  --    LIMIT/OFFSET as the trailing binds (?bn+1, ?bn+2) — UNLESS size="all" (deferred
  --    Phase-1 item), where the LIMIT/OFFSET are omitted entirely (fetch the whole filtered
  --    set; pos is already 0 / page 1). The COUNT-first guard above still bounds the work.
  $sel = "*"
  if $cols != nil and $cols != "" then
    $sel = $cols
  end
  $dataSql = "SELECT " .. $sel .. " FROM " .. $table .. $where .. $order
  if not dt_or($state["unlimited"], false) then
    $dataSql = $dataSql .. " LIMIT ?" .. ("" .. ($bn + 1)) .. " OFFSET ?" .. ("" .. ($bn + 2))
    push($binds, $state["limit"])
    push($binds, $state["pos"])
  end
  $rows = db_query($dataSql, $binds)
  return { rows: $rows, total: $total }
end

-- ─────────────────────────── summaries (Phase 4a, SQL-only) ───────────────────────────
-- The aggregate-function allowlist (the summary firewall): a column's `summarize`
-- string is ==-matched here, exactly like sort's column whitelist, so a config typo /
-- hostile value can never reach SQL as a function name. `range` is MIN+MAX rendered as
-- "min – max"; the other five map 1:1 to a SQL aggregate (dt_agg_sql).
function dt_agg_ok($fn)
  $f = "" .. $fn
  return $f == "sum" or $f == "avg" or $f == "count" or $f == "min" or $f == "max" or $f == "range"
end

-- enum → SQL aggregate expression over an author-literal col (range is handled inline
-- in dt_sql_summary as MIN+MAX, so it never reaches here). die on an unknown fn — the
-- allowlist is the firewall; this is the second gate behind dt_agg_ok.
function dt_agg_sql($fn, $col)
  $f = "" .. $fn
  if $f == "sum" then
    return "SUM(" .. $col .. ")"
  end
  if $f == "avg" then
    return "AVG(" .. $col .. ")"
  end
  if $f == "count" then
    -- COUNT(*) = row count over the filtered set (Filament's Count summarizer
    -- semantics + the "N entries" intent), NOT COUNT(col) which would silently drop
    -- NULL-valued rows. $col is unused for count.
    return "COUNT(*)"
  end
  if $f == "min" then
    return "MIN(" .. $col .. ")"
  end
  if $f == "max" then
    return "MAX(" .. $col .. ")"
  end
  die("datatable: unknown aggregate '" .. $f .. "'")
end

-- dt_summary_query($table, $spec, $opts, $state) → { sql, binds, meta } or nil. PURE
-- (never calls db_query) — the testable core of dt_sql_summary, mirroring how dt_where
-- was extracted from dt_sql. For every SHOWN column carrying a `summarize` opt it builds
-- one aggregate SELECT expression (range → MIN+MAX) aliased dtsum<i>, reusing dt_where so
-- the footer is search- AND filter-aware (same WHERE + binds, no LIMIT). The aggregate fn
-- is ==-allowlisted (dt_agg_ok, then dt_agg_sql — the firewall for the SQL function name);
-- `col` is the spec's author literal; aliases are widget-generated so a column key with
-- odd chars can't break the SELECT. nil when no shown column summarises.
function dt_summary_query($table, $spec, $opts, $state)
  $exprs = []
  $meta = []
  $i = 0
  for each $c in $spec
    if dt_col_shown($c, $opts, $state) and $c["summarize"] != nil then
      $fn = "" .. $c["summarize"]
      if not dt_agg_ok($fn) then
        die("datatable: column '" .. ("" .. $c["key"]) .. "' summarize '" .. $fn .. "' is not a known aggregate (sum/avg/count/min/max/range)")
      end
      $alias = "dtsum" .. ("" .. $i)
      if $fn == "range" then
        push($exprs, "MIN(" .. $c["col"] .. ") AS " .. $alias .. "_min")
        push($exprs, "MAX(" .. $c["col"] .. ") AS " .. $alias .. "_max")
      else
        push($exprs, dt_agg_sql($fn, $c["col"]) .. " AS " .. $alias)
      end
      push($meta, { key: $c["key"], agg: $fn, "alias": $alias })
      $i = $i + 1
    end
  end
  if length($exprs) == 0 then
    return nil
  end
  $w = dt_where($spec, $state)
  return { sql: ("SELECT " .. join($exprs, ", ") .. " FROM " .. $table .. $w["where"]), binds: $w["binds"], meta: $meta }
end

-- dt_summary_map($row, $meta) → { key -> formatted aggregate string }. PURE — maps a
-- single aggregate result row back to per-column values via the plan's meta (range joins
-- MIN+MAX as "lo – hi"). Separated from the query so both halves are unit-testable
-- without a DB (db_query is an unshadowable builtin).
function dt_summary_map($row, $meta)
  $vals = {}
  for each $m in $meta
    if $m["agg"] == "range" then
      $lo = "" .. dt_or($row[$m["alias"] .. "_min"], "")
      $hi = "" .. dt_or($row[$m["alias"] .. "_max"], "")
      $vals[$m["key"]] = $lo .. " – " .. $hi
    else
      $vals[$m["key"]] = "" .. dt_or($row[$m["alias"]], "")
    end
  end
  return $vals
end

-- dt_sql_summary($table, $spec, $opts, $state) → { key -> formatted aggregate string }
-- for every SHOWN summarising column, or nil when none do. Thin glue over the pure
-- dt_summary_query + dt_summary_map: ONE extra query, no LIMIT. SQL only — a JMAP handler
-- must not call this (the maild contract has no GROUP-less aggregate surface). Whole-
-- dataset scope (per-group / per-page summaries are a deferred follow-up).
function dt_sql_summary($table, $spec, $opts, $state)
  $plan = dt_summary_query($table, $spec, $opts, $state)
  if $plan == nil then
    return nil
  end
  $r = db_query($plan["sql"], $plan["binds"])
  if length($r) == 0 then
    return {}
  end
  return dt_summary_map($r[0], $plan["meta"])
end

-- dt_jmap_filter($base_filter, $caps, $state) → the final maild `filter` map (the
-- ONE place a JMAP query's filter is assembled — the dt_where analogue). Starts from
-- the handler's author-literal base filter, merges the text search (when caps.text),
-- then ANDs the active filters' author-literal `jmap` conditions. A filter whose
-- options carry NO `jmap` key contributes nothing → it's SQL-only with a clean JMAP
-- fallback (simply does not apply). The AND FilterOperator is built ONLY when a
-- filter condition exists, so a handler with no JMAP filters keeps the exact historic
-- flat-filter wire shape (byte-identical for the 4 live PIM tables). PURE — no jmap().
function dt_jmap_filter($base_filter, $caps, $state)
  $filter = $base_filter
  if $filter == nil then
    $filter = {}
  end
  if $caps["text"] and $state["q"] != "" then
    $filter["text"] = $state["q"]
  end
  -- collect the active filters' jmap conditions (author literals, never client text).
  $conds = []
  $fo = $state["filter_order"]
  if $fo != nil then
    for each $fname in $fo
      $jm = $state["filters"][$fname]["jmap"]
      if $jm != nil then
        push($conds, $jm)
      end
    end
  end
  if length($conds) == 0 then
    return $filter
  end
  -- AND the base/text filter (if any) with the filter conditions.
  $all = []
  if length($filter) > 0 then
    push($all, $filter)
  end
  for each $c in $conds
    push($all, $c)
  end
  if length($all) == 1 then
    return $all[0]
  end
  return { operator: "AND", conditions: $all }
end

-- ─────────────────────────── JMAP adapter ───────────────────────────
-- dt_jmap($type, $spec, $state, $caps, $base_filter[, $get_props]) → {rows, total}.
--   $caps = {text: bool, sort: bool} (per the maild capability matrix).
--   $base_filter = a fixed filter the handler supplies (e.g. {inMailbox:$boxid}),
--                  merged with the optional text search.
--   $get_props = OPTIONAL list of properties for the /get call (handler literal).
--                Pass it when the type's /get does NOT return the needed fields by
--                default, or to avoid heavy ones — Email needs an explicit
--                ["id","from","to","subject","receivedAt","keywords"] (no bodyValues);
--                Contact/get returns all fields, so contacts omit it (nil).
-- Pull the result map for callId $cid out of a jmap() BATCH methodResponses
-- list. The batch form returns method-level errors INLINE as ["error",{…},id]
-- triples (it does NOT raise), so this raises on an error triple or a missing
-- response — a JMAP method error must never silently degrade to empty data
-- (which it would if we just read `["list"]` off an error payload). $what is
-- the method label for the error message. Triples are [method, result, callId]
-- (0-indexed): [0]=method, [1]=result, [2]=callId.
function dt_batch_resp($resp, $cid, $what)
  if $resp != nil then
    for each $mr in $resp
      if ("" .. $mr[2]) == $cid then
        if ("" .. $mr[0]) == "error" then
          die("datatable: " .. $what .. " failed in batch: " .. ("" .. dt_or($mr[1]["type"], "unknown error")))
        end
        return $mr[1]
      end
    end
  end
  die("datatable: " .. $what .. " — no matching response in the jmap batch")
end

-- Nil-guards on ids/total/list prevent the length(nil) crash + the silent
-- nil/limit→0-pages bug. Reorder-to-query-order is applied for Email + Calendar-
-- Event (the maild types whose /get is unordered); Contact/get preserves order.
function dt_jmap($type, $spec, $state, $caps, $base_filter, $get_props)
  -- Role gate × whole-object text search are incompatible: maild's filter:{text}
  -- matches the WHOLE object, so a role-gated column's hidden contents could still
  -- decide which rows a low-rank viewer sees. The widget can't field-scope the
  -- search, so refuse the combination LOUDLY at config time (fires for any viewer,
  -- it's about the table's setup). A handler that knows its gated columns aren't
  -- search-sensitive opts in with caps.allow_gated_text:true.
  if $caps["text"] and not $caps["allow_gated_text"] then
    for each $gc in $spec
      if $gc["min_rank"] != nil then
        die("datatable: dt_jmap can't field-scope whole-object text search around role-gated column '" .. ("" .. $gc["key"]) .. "'; set caps.text:false, or caps.allow_gated_text:true to accept whole-object search")
      end
    end
  end

  -- grouping is SQL-only (render-layer clustering driven by an ORDER BY prepend the maild
  -- /query contract can't express). A JMAP handler must not declare opts.groups; if one
  -- did and a group is active, fail LOUD here rather than render mis-clustered headers.
  if dt_or($state["group_col"], "") != "" then
    die("datatable: grouping is SQL-only; a JMAP table cannot group (drop opts.groups)")
  end

  $args = { position: $state["pos"], limit: $state["limit"] }

  $filter = dt_jmap_filter($base_filter, $caps, $state)
  if length($filter) > 0 then
    $args["filter"] = $filter
  end

  if $caps["sort"] and $state["sort_col"] != "" then
    $args["sort"] = [ { property: $state["sort_col"], isAscending: $state["asc"] } ]
  end

  -- PERF: batch /query + /get into ONE jmap() request (one HTTP POST → one
  -- maild auth + one round-trip, vs two). The /get back-references the
  -- /query result's ids via a JMAP #ids ResultReference (RFC 8620 §3.7;
  -- maild's reference resolver handles it server-side). The batch form
  -- returns the methodResponses list verbatim with method-level errors
  -- INLINE, so dt_batch_resp picks each by callId and raises on an error.
  $getargs = { "#ids": { resultOf: "q", name: $type .. "/query", path: "/ids" } }
  if $get_props != nil then
    $getargs["properties"] = $get_props
  end
  $resp = jmap([
    [ $type .. "/query", $args, "q" ],
    [ $type .. "/get", $getargs, "g" ]
  ])
  $qr = dt_batch_resp($resp, "q", $type .. "/query")
  $ids = $qr["ids"]
  if $ids == nil then
    $ids = []
  end
  $total = $qr["total"]
  if $total == nil then
    $total = 0
  end
  $total = dt_trunc(to_number("" .. $total))

  $rows = []
  if length($ids) > 0 then
    -- The /get already ran in the batch (its #ids resolved server-side from
    -- the query). Read its response only when the query returned rows — an
    -- empty query yields an empty (or invalid-ref) /get we don't need.
    $gr = dt_batch_resp($resp, "g", $type .. "/get")
    $rows = $gr["list"]
    if $rows == nil then
      $rows = []
    end
    -- Reorder /get to query order for the maild types whose /get is UNORDERED
    -- (Email + CalendarEvent — both their original handlers reorder manually).
    -- Contact/get preserves query order, so it is NOT reordered.
    if $type == "Email" or $type == "CalendarEvent" then
      $rows = dt_reorder($rows, $ids)
    end
  end
  return { rows: $rows, total: $total }
end

-- Reorder a /get list to match query id order (Email only; its /get is unordered).
function dt_reorder($rows, $ids)
  $byid = {}
  for each $r in $rows
    $byid["" .. $r["id"]] = $r
  end
  $out = []
  for each $id in $ids
    $row = $byid["" .. $id]
    if $row != nil then
      push($out, $row)
    end
  end
  return $out
end

-- data-dt-target on the search <form> when live_search: tells the boost shim to patch ONLY
-- the #dt-results slot (not the whole region) for a search submit (live or manual) — so the
-- header + search box (OUTSIDE the slot) are never swapped. The filter bar IS inside the
-- slot, so it re-renders with the new q. "" when off → the form targets the region (full
-- swap, byte-identical). Safe ONLY for search: typing changes just `q`, and the only q-
-- carrier left outside the slot is the search form itself (its hidden sort/filters/size/
-- group are unchanged by a search). sort/page/filter keep the full-region swap (they DO
-- change that state and must re-render+re-sync the out-of-slot search form).
function dt_target_attr($opts)
  -- compact mode re-renders the FULL region on a search (the filter controls share the top
  -- row, outside the #dt-results slot) → no sub-target. Non-compact live_search → the slot.
  if $opts["live_search"] != true or $opts["compact"] == true then
    return ""
  end
  return ' data-dt-target="' .. dt_results_region_id($opts["id"]) .. '"'
end

-- Extra attributes for the visible search <input> when live_search is on: a STABLE id
-- (so the boost shim can re-find + refocus it by id after a region swap) + a data-dt-live
-- marker carrying the debounce ms (dt_search_script reads it). "" when live_search is off
-- → the input is byte-identical. The id is deterministic from the region id, so it's the
-- same element across every partial swap.
function dt_q_attrs($opts)
  if $opts["live_search"] != true then
    return ""
  end
  -- autocomplete="off" suppresses the browser's history-suggestion dropdown — it re-filters
  -- on every keystroke under a live search, which is visually distracting.
  return ' id="' .. dt_region_id($opts["id"]) .. '-q" data-dt-live="250" autocomplete="off"'
end

-- The in-input clear (×) button for a live search, rendered INSIDE .dt-search-wrap after the
-- input. Hidden (the `hidden` attr) when q is empty — dt_search_script toggles it on input +
-- clears the field on click. "" unless live_search (the script that drives it is live-only).
function dt_clear_btn($opts, $state)
  if $opts["live_search"] != true then
    return ""
  end
  $hid = ""
  if $state["q"] == "" then
    $hid = " hidden"
  end
  return '<button type="button" class="dt-search-clear" aria-label="Clear search" title="Clear search"' .. $hid .. '>' .. dt_icon("x") .. '</button>'
end

-- ─────────────────────────── renderer ───────────────────────────
-- Standalone search form (GET; SPA-swappable). Returns "" when search is off.
-- Reusable so a non-table list (e.g. the media gallery) gets the SAME canonical
-- search box as dt_render. Hidden sort/dir/box are emitted BEFORE the visible q
-- input so the SPA's FormData serialization order (sort, dir, box, q) matches
-- dt_href's canonical param order exactly — a sort link and a search submit to
-- the same logical view then produce byte-identical URLs (SPA same-URL dedup +
-- Back/Forward). Hidden sort/dir only when NON-default, so the URL stays clean.
function dt_search_form($opts, $state)
  if not $opts["search"] then
    return ""
  end
  if $opts["skin"] == true then
    return dt_toolbar_band($opts, $state)
  end
  $route = $opts["base_route"]
  -- Field names carry the instance prefix so a multi-table page's search submit
  -- only touches THIS table's state (default "" → bare names, unchanged).
  $pfx = dt_pfx($opts)
  $h = '<form method="get" action="' .. $route .. '" class="row datatable-toolbar" style="gap:var(--space-2)" role="search"' .. dt_target_attr($opts) .. '>'
  if dt_sort_is_nondefault($state, $opts) then
    $h = $h .. '<input type="hidden" name="' .. $pfx .. 'sort" value="' .. esc($state["sort"]) .. '">'
    $h = $h .. '<input type="hidden" name="' .. $pfx .. 'dir" value="' .. esc($state["dir"]) .. '">'
  end
  if $state["box"] != "" then
    $h = $h .. '<input type="hidden" name="' .. $pfx .. 'box" value="' .. esc($state["box"]) .. '">'
  end
  -- size hidden field (after box, matching dt_href's param order) only when the
  -- page size is non-default, so a search submit preserves the chosen size.
  if ("" .. $state["size"]) != ("" .. $opts["page_size"]) then
    $h = $h .. '<input type="hidden" name="' .. $pfx .. 'size" value="' .. esc("" .. $state["size"]) .. '">'
  end
  $h = $h .. '<input' .. dt_q_attrs($opts) .. ' name="' .. $pfx .. 'q" value="' .. esc($state["q"]) .. '" placeholder="' .. esc($opts["search_placeholder"]) .. '" aria-label="' .. esc($opts["search_placeholder"]) .. '" style="flex:1">'
  -- preserve active filters across a search submit (hidden, after q, matching dt_href).
  $h = $h .. dt_filter_hidden($opts, $state, $pfx)
  $h = $h .. dt_hide_field($opts, $state, $pfx)
  $h = $h .. dt_group_field($opts, $state, $pfx)
  $h = $h .. '<button class="btn btn-primary btn-sm" type="submit">Search</button>'
  if $state["q"] != "" then
    $h = $h .. '<a class="btn btn-ghost btn-sm" href="' .. dt_href($route, { sort: $state["sort"], dir: $state["dir"], box: $state["box"], size: $state["size"], filters: $state["filters_raw"], hide: $state["hide_raw"], group: $state["group"] }, $opts) .. '">Clear</a>'
  end
  $h = $h .. '</form>'
  return $h
end

-- dt_render($spec, $opts, $state, $rows, $total[, $summary]) → html. Source-agnostic:
-- never calls db_query/jmap, only formats. Heading + results-count, the search form
-- (when enabled), the table (semantic <table> + <caption> + scope="col", aria-sort
-- on the ONE active header), and the pager. $summary (optional, Phase 4a) is the map
-- dt_sql_summary returns (key -> formatted aggregate); nil/omitted → no <tfoot>, so a
-- handler that doesn't summarise (and the 5 unchanged callers passing 5 args) is
-- byte-identical.
function dt_render($spec, $opts, $state, $rows, $total, $summary)
  $route = $opts["base_route"]
  $skin = ($opts["skin"] == true)

  -- heading + controls. compact (opt-in) = ONE dense row with the search + all the control
  -- icons + header actions (dt_compact_header), no subtitle, no separate search/filter rows.
  -- Otherwise: the skin header band (or the historic row) + the standalone search form.
  if $opts["compact"] == true then
    $h = dt_compact_header($spec, $opts, $state, $total)
  else
    -- NON-skin tables only (skin ⟹ compact above). The historic inline header row +
    -- the standalone search form beneath it.
    $h = '<div class="row" style="justify-content:space-between;align-items:center"><h1 id="dt-heading" tabindex="-1" style="margin:0">' .. esc($opts["caption"])
    $h = $h .. ' <span class="muted small datatable-results-count">' .. ("" .. $total) .. ' total</span></h1>'
    $h = $h .. '<div class="datatable-toolbar-actions">' .. $opts["toolbar"] .. '</div></div>'
    $h = $h .. dt_search_form($opts, $state)
    -- real-time search module (opts.live_search) — emitted before the empty check so it's
    -- present even when a query produced no rows (so you can keep typing to widen it). The
    -- script is window-flag idempotent + re-injected on swap. "" unless live_search + search.
    if $opts["live_search"] == true and $opts["search"] then
      $h = $h .. dt_search_script()
    end
  end

  -- results slot (#dt-results): the FILTER BAR (funnel/manager/group/chips) + table + footer
  -- (or the empty state) live in their own region so a SEARCH submit can patch ONLY this
  -- (dt_results_partial) — leaving the header + search box untouched (no whole-region
  -- flicker/re-fade; the search input is never swapped). The filter bar is INSIDE the slot
  -- on purpose: it carries q (to preserve the search), so it must re-render with the table
  -- to stay in sync. sort/page/filter still swap the FULL region (dt_partial), re-syncing
  -- the out-of-slot search form's view-state hidden fields.
  $h = $h .. '<div id="' .. dt_results_region_id($opts["id"]) .. '">' .. dt_results_inner($spec, $opts, $state, $rows, $total, $summary) .. '</div>'
  if $skin then
    return '<div class="dt-card">' .. $h .. '</div>'
  end
  return $h
end

-- dt_results_inner(...) → the #dt-results slot inner: the empty-state, or the table (+ bulk
-- bar + wrapping POST form + scripts) + footer/pager. Extracted from dt_render so a search
-- submit re-renders JUST this via dt_results_partial (patching #dt-results), preserving the
-- search box + filter controls. Byte-identical output to the pre-extraction dt_render body
-- (the .dt-card wrap moved up to dt_render).
function dt_results_inner($spec, $opts, $state, $rows, $total, $summary)
  $skin = ($opts["skin"] == true)
  -- the filter funnel/manager/group-select + active-filter chips live INSIDE the slot so a
  -- results-only search swap re-renders them with the CURRENT q — they each carry q (to
  -- preserve the search when you apply a filter / change group / toggle a column / remove a
  -- chip), so if they stayed outside the slot a search would leave them stale and the next
  -- filter/group/toggle would clobber the search term. Returns "" for a table with no
  -- filters/toggleable/groups → byte-identical. Before the empty check so you can still
  -- clear a filter that produced an empty result. COMPACT: the funnel/columns/group are in
  -- the top-row header instead, so only the active-filter chips remain here (full-region
  -- swap keeps everything synced regardless).
  if $opts["compact"] == true then
    $h = dt_filter_chips($opts, $state)
  else
    $h = dt_filter_bar($spec, $opts, $state)
  end
  if length($rows) == 0 then
    return $h .. dt_empty($opts, $state, $total)
  end
  -- table — optionally wrapped in a bulk-delete POST form with a leading
  -- checkbox column + a "Delete selected" bar. Each checkbox is name="sel_<id>"
  -- value="1" (parse_form is last-wins, so repeated `id=` won't work — a unique
  -- key per row is the no-JS-safe encoding; the handler collects them with
  -- dt_selected_ids). The pager/size-selector stay OUTSIDE the form (GET links).
  $bulk = ($opts["bulk"] == true)
  -- the bulk form id is namespaced per instance so two bulk tables on one page
  -- don't collide on a single getElementById("dt-bulk-form"); default "" keeps
  -- the historic id.
  $bform = "dt-bulk-form"
  if $opts["id"] != "" then
    $bform = "dt-bulk-form-" .. $opts["id"]
  end
  -- The table is wrapped in ONE POST form when bulk is on OR a declarative row action
  -- is mutating; the bulk checkboxes + the row-action <button>s share it (no nested
  -- forms, the same SameSite/form-action CSRF model — S-7). A non-bulk table with only
  -- nav (or no) row actions stays form-free → byte-identical.
  -- In RMB mode a mutating row action builds its OWN body-level POST form on click
  -- (site.js cmSubmitPost), so it must NOT force the table's wrapping form — only bulk
  -- and reorder need it.
  -- A visible mutating row action needs the wrapping POST form (cm-only mode posts via
  -- the cm shim's own form instead, so cm-without-column stays formless).
  $needs_form = $bulk or (dt_specs_have_mutation($opts) and dt_actions_column($opts)) or dt_has_reorder($opts)
  if $needs_form then
    -- The wrapping bulk/action form posts to base_route by default; opts.bulk_route overrides
    -- it (e.g. a native webd route that can unlink files — media bulk delete, which posts the
    -- sel_<id> selection to /admin/media/delete instead of the Mix handler).
    $bform_action = dt_or($opts["bulk_route"], $opts["base_route"])
    $h = $h .. '<form method="post" action="' .. $bform_action .. '" id="' .. $bform .. '">'
  end
  -- select-all-across-pages (S-5): carry the dt_where-relevant view state (q + active
  -- filters) as hidden fields so the handler can rebuild $state from the POST
  -- (dt_state_from_map) and re-run dt_where for the full matching id set — never
  -- trusting posted ids. Plus the hidden flag the prompt toggles. Only when opted in.
  -- NB the active group is intentionally NOT carried here: grouping is a VIEW concern
  -- (ORDER BY + render clustering), not a WHERE concern, so it never changes the id set
  -- dt_all_ids resolves. (A bulk POST is a mutation that redirects PRG-style; the GET then
  -- re-derives all view state, group included, from the URL.)
  if $opts["select_all"] == true then
    $sapfx = dt_pfx($opts)
    if $state["q"] != "" then
      $h = $h .. '<input type="hidden" name="' .. $sapfx .. 'q" value="' .. esc($state["q"]) .. '">'
    end
    $h = $h .. dt_filter_hidden($opts, $state, $sapfx)
    $h = $h .. '<input type="hidden" name="select_all_matching" value="0" class="dt-sel-all-flag">'
  end
  if $bulk then
    -- COMPACT: the bulk action button(s) + count are the header TRASH (dt_bulk_trash) — here
    -- we keep ONLY the across-pages prompt (when select_all), in a zero-height bar that's
    -- invisible until JS unhides the prompt. Non-compact: the full bulk bar (buttons +
    -- count + prompt).
    if $opts["compact"] == true then
      -- the count lives on the header trash's badge. The ONLY thing here is the
      -- across-pages prompt, rendered as a BARE span (NO .dt-bulk-bar wrapper → no
      -- grey strip, zero footprint) — `hidden` until JS sees the whole page selected,
      -- then it surfaces inline above the table.
      if $opts["select_all"] == true then
        $h = $h .. '<span class="dt-sel-all-prompt dt-sel-all-prompt-compact small" data-total="' .. ("" .. $total) .. '" hidden><span class="dt-sel-all-msg"></span> <button type="button" class="dt-sel-all-link">Select all</button></span>'
      end
    else
      -- One submit button per bulk action (default = a single danger "delete"). Each
      -- carries name="action" value="bulk_<name>" + an optional data-confirm; the
      -- native-<dialog> gate fires it from the form's submitter. No-JS still submits (an
      -- empty selection being a no-op the handler ignores).
      $h = $h .. '<div class="dt-bulk-bar">'
      for each $act in $opts["bulk_actions"]
        $acls = $act["class"]
        if $acls == nil or ("" .. $acls) == "" then
          $acls = "btn-sm dt-bulk-act"
        else
          $acls = ("" .. $acls) .. " btn-sm dt-bulk-act"
        end
        $cattr = ""
        $aconf = $act["confirm"]
        if $aconf != nil and ("" .. $aconf) != "" then
          $cattr = ' data-confirm="' .. esc("" .. $aconf) .. '"'
        end
        $h = $h .. '<button type="submit" name="action" value="bulk_' .. esc("" .. $act["name"]) .. '" class="btn btn-primary ' .. esc($acls) .. '"' .. $cattr .. '>' .. esc("" .. $act["label"]) .. '</button> '
      end
      $h = $h .. '<span class="dt-bulk-count muted small" aria-live="polite"></span>'
      -- the across-pages prompt (S-5): hidden until JS sees the whole page checked and
      -- there are more matching rows; data-total feeds the "Select all N matching" copy.
      if $opts["select_all"] == true then
        $h = $h .. '<span class="dt-sel-all-prompt small" data-total="' .. ("" .. $total) .. '" hidden><span class="dt-sel-all-msg"></span> <button type="button" class="dt-sel-all-link">Select all</button></span>'
      end
      $h = $h .. '</div>'
    end
  end
  $h = $h .. '<div class="card datatable-scroll-wrapper">'
  -- fixed_layout (opt-in, per-app): switch the table to table-layout:fixed so explicit
  -- per-column widths (dt_col opts.width) are AUTHORITATIVE — columns don't re-measure on
  -- sort (no jump) and overflow elides per the .dt-fixed CSS. Off → table-layout:auto, every
  -- existing table byte-identical.
  $tblcls = "datatable"
  if $opts["fixed_layout"] == true then
    $tblcls = $tblcls .. " dt-fixed"
  end
  $h = $h .. '<table class="' .. $tblcls .. '"><caption class="visually-hidden">' .. esc($opts["caption"]) .. '</caption><thead><tr>'
  if $bulk then
    $h = $h .. '<th scope="col" class="dt-bulk-cell"><input type="checkbox" class="dt-bulk-all" aria-label="Select all rows on this page"></th>'
  end
  $reorder = dt_has_reorder($opts)
  if $reorder then
    $h = $h .. '<th scope="col" class="dt-reorder-cell"><span class="visually-hidden">Reorder</span></th>'
  end
  for each $c in $spec
    if dt_col_shown($c, $opts, $state) then
      $h = $h .. dt_th($c, $state, $opts)
    end
  end
  if dt_actions_column($opts) then
    -- Actions column width hint for table-layout:fixed (no jump on sort): the header
    -- cell carries the column width. Icon-only action sets (action_labels:false — the
    -- admin tables) need a narrow column; the default labeled sets (PIM) need a wider
    -- one. The `.dt-actions-icons` modifier lets the skin width each case.
    $ah_cls = "dt-actions-th"
    if $opts["action_labels"] == false then
      $ah_cls = "dt-actions-th dt-actions-icons"
    end
    $h = $h .. '<th scope="col" class="' .. $ah_cls .. '"><span class="visually-hidden">Actions</span></th>'
  end
  $h = $h .. '</tr></thead><tbody>'
  -- grouping (Phase 4b): when a group is active, find its spec once + the spanning
  -- header colspan (bulk + shown cols + actions — the exact header/body cell count), then
  -- emit a <tr class="dt-group-header"> whenever the group value changes. $have_group
  -- starts false so the FIRST row of every page emits its header (groups span pages).
  $group_spec = nil
  if dt_or($state["group_col"], "") != "" and $opts["groups"] != nil then
    for each $g in $opts["groups"]
      if ("" .. $g["key"]) == ("" .. $state["group"]) then
        $group_spec = $g
      end
    end
  end
  $gcolspan = 0
  if $group_spec != nil then
    if $bulk then
      $gcolspan = $gcolspan + 1
    end
    if $reorder then
      $gcolspan = $gcolspan + 1
    end
    for each $gc in $spec
      if dt_col_shown($gc, $opts, $state) then
        $gcolspan = $gcolspan + 1
      end
    end
    if dt_actions_column($opts) then
      $gcolspan = $gcolspan + 1
    end
  end
  $have_group = false
  $last_group = ""
  -- SCALING (1000+ row tables): accumulate each row's HTML into a LIST and
  -- join() ONCE, instead of `$h = $h .. row` per row. Mix `..` is O(n) per
  -- append (it copies the whole growing string), so appending N rows to the
  -- growing $h is O(n²); per-row `..` (bounded by the fixed column count) plus
  -- one join is O(n). Output is byte-identical (join "" concatenates in order).
  $rowparts = []
  for each $row in $rows
    $rp = ""
    -- group-header row (Phase 4b): emit before the first row of a new group value. The
    -- group IDENTITY (change-detection) + the header text both come from the `value` fn
    -- when present, else from $row[col]. Using value() for change-detection (not $row[col])
    -- is what lets `col` be a SQL ORDER BY EXPRESSION (e.g. date(updated)) that isn't a
    -- row-map key — the handler supplies value() to read the real field. Without a value
    -- fn, `col` must be a plain selected column/alias (it IS the row key).
    if $group_spec != nil then
      if $group_spec["value"] != nil then
        $gval = "" .. $group_spec["value"]($row)
      else
        $gval = "" .. dt_or($row[$group_spec["col"]], "")
      end
      if (not $have_group) or $gval != $last_group then
        $gdisp = $gval
        if $gdisp == "" then
          $gdisp = "—"
        end
        $rp = $rp .. '<tr class="dt-group-header"><td colspan="' .. ("" .. $gcolspan) .. '"><span class="dt-group-label">' .. esc("" .. $group_spec["label"]) .. '</span> ' .. esc($gdisp) .. '</td></tr>'
        $have_group = true
        $last_group = $gval
      end
    end
    -- Optional server-computed row class: row_class = fn($row) -> css class
    -- string ("" = none). esc'd before it reaches the attribute.
    $trclass = ""
    if $opts["row_class"] != nil then
      $rc = "" .. $opts["row_class"]($row)
      if $rc != "" then
        $trclass = ' class="' .. esc($rc) .. '"'
      end
    end
    -- Optional RAW per-row attribute fragment: row_attrs = fn($row) -> string.
    -- Emitted RAW (NOT esc'd), unlike row_class above. CONTRACT: the hook MUST return a
    -- COMPLETE, already-trusted attribute fragment — leading space included, every value
    -- already escaped (e.g. ' data-cm-id="42"'). The shared cm_bind() builder satisfies
    -- this (it tokenises keys + esc()'s each value); ANY OTHER consumer using row_attrs is
    -- responsible for escaping its own values. "" = none, so every existing list (which
    -- omits the key) renders byte-identical — backward compatible.
    $trattrs = ""
    if $opts["row_attrs"] != nil then
      $trattrs = "" .. $opts["row_attrs"]($row)
    end
    -- RMB mode: splice this row's auto-generated cm_bind payload (composes with any
    -- author row_attrs); re-emits on every SSE swap because it lives in the row loop.
    if dt_actions_as_menu($opts) then
      $trattrs = $trattrs .. dt_actions_cm_bind($opts, $row)
    end
    $rp = $rp .. '<tr' .. $trclass .. $trattrs .. '>'
    if $bulk then
      $bid = $opts["bulk_id"]($row)
      $rp = $rp .. '<td class="dt-bulk-cell"><input type="checkbox" class="dt-bulk-cb" name="sel_' .. esc("" .. $bid) .. '" value="1" aria-label="Select row"></td>'
    end
    if $reorder then
      $rp = $rp .. '<td class="dt-reorder-cell">' .. dt_reorder_controls($opts, $row) .. '</td>'
    end
    $first = true
    for each $c in $spec
      if dt_col_shown($c, $opts, $state) then
        $cell = dt_cell($c, $row)
        $tdcls = ""
        $tdal = dt_align_cls($c)
        if $tdal != "" then
          $tdcls = ' class="' .. $tdal .. '"'
        end
        -- Hover tooltip: a `title` on the <td> with the cell's FULL content, so the
        -- skin's text-overflow:ellipsis clip is always recoverable on hover.
        $tip = dt_cell_tip($c, $row)
        $tdtip = ""
        if $tip != "" then
          $tdtip = ' title="' .. esc($tip) .. '"'
        end
        if $first and $opts["row_href"] != nil then
          $href = $opts["row_href"]($row)
          $rp = $rp .. '<td' .. $tdcls .. $tdtip .. '><a href="' .. $href .. '">' .. $cell .. '</a></td>'
          $first = false
        else
          $rp = $rp .. '<td' .. $tdcls .. $tdtip .. '>' .. $cell .. '</td>'
          $first = false
        end
      end
    end
    if dt_actions_column($opts) then
      $rp = $rp .. '<td class="datatable-row-actions">' .. dt_row_actions_html($opts, $row) .. '</td>'
    end
    $rp = $rp .. '</tr>'
    push($rowparts, $rp)
  end
  $h = $h .. join($rowparts, "")
  $h = $h .. '</tbody>'
  -- summary <tfoot> (Phase 4a) — only when the handler computed + passed a summary map;
  -- aligns one cell per SHOWN column (+ bulk / actions spacer cells) so the footer tracks
  -- the visible columns exactly. nil → omitted entirely (byte-identical).
  if $summary != nil then
    $h = $h .. dt_tfoot($spec, $opts, $state, $summary)
  end
  $h = $h .. '</table></div>'
  if $bulk then
    $h = $h .. dt_bulk_script($bform)
    if $opts["select_all"] == true then
      $h = $h .. dt_select_all_script($bform)
    end
  end
  if $needs_form then
    $h = $h .. '</form>'
    -- the form's data-confirm actions (bulk + mutating row actions) are gated by the
    -- native-<dialog> confirm script, which now lives in shell.html (global — fm_*
    -- delete forms and one-off handler forms get the same modal on every page).
  end
  -- close any open row-action "⋮" menu on click-away — emitted whenever the menu is
  -- used, even on a nav-only table with no wrapping form (idempotent window-flag).
  if $opts["row_actions_menu"] == true and dt_has_row_actions($opts) then
    $h = $h .. dt_filter_script()
  end
  -- footer: the skin packs range + per-page select + amber pager into one band;
  -- the historic pager + size-selector pair is byte-identical when skin is off.
  if $skin then
    $h = $h .. dt_footer_band($opts, $state, $total)
    return $h
  end
  $h = $h .. dt_pager($opts, $state, $total)
  $h = $h .. dt_size_selector($opts, $state, $total)
  return $h
end

-- The summary <tfoot> row (Phase 4a). ONE <td> per SHOWN column in spec order, plus the
-- leading bulk spacer cell + a trailing actions spacer cell when those columns exist — so
-- the footer aligns exactly with dt_render's header/body column set. A column with a
-- summary value renders it (optional summary_fmt, then escaped ONCE); every other column
-- gets an empty cell. Reached only when $summary is non-nil AND rows>0 (dt_render
-- early-returns the empty state), so the footer never shows a stale/zero aggregate over
-- an empty page.
function dt_tfoot($spec, $opts, $state, $summary)
  $h = '<tfoot><tr class="dt-summary-row">'
  if $opts["bulk"] == true then
    $h = $h .. '<td class="dt-bulk-cell"></td>'
  end
  if dt_has_reorder($opts) then
    $h = $h .. '<td class="dt-reorder-cell"></td>'
  end
  for each $c in $spec
    if dt_col_shown($c, $opts, $state) then
      $scls = "dt-summary-cell"
      $sal = dt_align_cls($c)
      if $sal != "" then
        $scls = $scls .. " " .. $sal
      end
      $val = $summary[$c["key"]]
      if $val != nil and ("" .. $val) != "" then
        $raw = "" .. $val
        if $c["summary_fmt"] != nil then
          $raw = "" .. $c["summary_fmt"]($val)
        end
        $h = $h .. '<td class="' .. $scls .. '">' .. esc($raw) .. '</td>'
      else
        $h = $h .. '<td class="' .. $scls .. '"></td>'
      end
    end
  end
  if dt_actions_column($opts) then
    $h = $h .. '<td class="dt-summary-cell"></td>'
  end
  $h = $h .. '</tr></tfoot>'
  return $h
end

-- Inline progressive-enhancement script for the bulk bar: wires select-all,
-- a live "N selected" count, disables ALL action buttons when nothing is checked,
-- and fires each action's optional data-confirm from the form's submitter (so a
-- click OR Enter is covered, and different actions can confirm differently).
-- Re-runs on every SPA swap (shell.html re-injects <script> on swap), so it just
-- re-queries the freshly-swapped DOM — idempotent. Without JS the per-row
-- checkboxes still submit (real form controls) and the buttons stay enabled (an
-- empty submit is a no-op the handler ignores; no confirm fires). CSP allows inline.
function dt_bulk_script($formid)
  $s = '<script>(function(){'
  $s = $s .. 'var f=document.getElementById("' .. $formid .. '");if(!f)return;'
  $s = $s .. 'var all=f.querySelector(".dt-bulk-all"),cbs=f.querySelectorAll(".dt-bulk-cb"),'
  -- acts via f.elements (NOT querySelectorAll) so a compact-header trash button that is
  -- form-ASSOCIATED (form="<id>") but lives OUTSIDE the form is still found + toggled.
  $s = $s .. 'acts=[].filter.call(f.elements,function(e){return e.classList&&e.classList.contains("dt-bulk-act");}),'
  $s = $s .. 'cnt=f.querySelector(".dt-bulk-count");'
  $s = $s .. 'function u(){var n=0;cbs.forEach(function(c){if(c.checked)n++});'
  $s = $s .. 'if(cnt)cnt.textContent=n?(n+" selected"):"";'
  -- compact: each act may carry a .dt-bulk-count-badge (the trash count); update it. A
  -- non-compact button has none → querySelector null → no-op (behaviour-identical).
  $s = $s .. 'acts.forEach(function(b){b.disabled=!n;var bg=b.querySelector?b.querySelector(".dt-bulk-count-badge"):null;if(bg){bg.textContent=n;bg.hidden=!n;}});'
  $s = $s .. 'if(all)all.checked=n>0&&n===cbs.length;}'
  $s = $s .. 'if(all)all.onchange=function(){cbs.forEach(function(c){c.checked=all.checked});u();};'
  $s = $s .. 'cbs.forEach(function(c){c.onchange=u;});'
  $s = $s .. 'u();'
  $s = $s .. '})();</script>'
  return $s
end

-- Inline PE for select-all-across-pages (S-5, opt-in). A SEPARATE script (so the
-- historic dt_bulk_script — and the non-select_all bulk pages — stay byte-identical):
-- it manages the across-pages prompt + the hidden select_all_matching flag, coordinating
-- with dt_bulk_script purely through the DOM (a form-level change listener + dispatching
-- change events so the page-count UI stays in sync). The prompt appears only when the
-- whole page is checked AND more matching rows exist (data-total > page rows). Clicking
-- "Select all N matching" sets the flag → the next bulk submit carries it, and the
-- handler re-runs dt_where server-side. No-JS: no across-pages prompt (you select per
-- page) — a graceful reduction, the destructive action still a real POST. Idempotent
-- per form (f.__dtSelAll).
function dt_select_all_script($formid)
  $s = '<script>(function(){'
  $s = $s .. 'var f=document.getElementById("' .. $formid .. '");if(!f||f.__dtSelAll)return;f.__dtSelAll=1;'
  $s = $s .. 'var prompt=f.querySelector(".dt-sel-all-prompt"),flag=f.querySelector(".dt-sel-all-flag");if(!prompt||!flag)return;'
  $s = $s .. 'var total=parseInt(prompt.getAttribute("data-total"),10)||0;'
  $s = $s .. 'var msg=prompt.querySelector(".dt-sel-all-msg"),lk=prompt.querySelector(".dt-sel-all-link"),matching=false;'
  $s = $s .. 'function cbs(){return f.querySelectorAll(".dt-bulk-cb");}'
  $s = $s .. 'function sync(){var cs=cbs(),n=0;cs.forEach(function(c){if(c.checked)n++;});'
  $s = $s .. 'if(matching){prompt.hidden=false;msg.textContent="All "+total+" matching selected.";lk.textContent="Clear selection";}'
  $s = $s .. 'else if(n>0&&n===cs.length&&total>cs.length){prompt.hidden=false;msg.textContent="All "+n+" on this page selected.";lk.textContent="Select all "+total+" matching";}'
  $s = $s .. 'else{prompt.hidden=true;}}'
  $s = $s .. 'lk.onclick=function(){if(matching){matching=false;flag.value="0";cbs().forEach(function(c){if(c.checked){c.checked=false;c.dispatchEvent(new Event("change",{bubbles:true}));}});}else{matching=true;flag.value="1";}sync();};'
  $s = $s .. 'f.addEventListener("change",function(e){var t=e.target;if(t&&t.classList&&(t.classList.contains("dt-bulk-cb")||t.classList.contains("dt-bulk-all"))){matching=false;flag.value="0";sync();}});'
  $s = $s .. 'sync();'
  $s = $s .. '})();</script>'
  return $s
end

-- Native-<dialog> confirm gate (SPINE S-6): MOVED to shell.html so every page —
-- datatable or not — gates data-confirm submits with the same styled modal. The
-- contract is unchanged: any form whose submitter (or the form itself) carries
-- data-confirm is intercepted; no <dialog> support degrades to confirm(); no JS
-- degrades to a plain submit.

-- Collect the ids of the selected rows from a parsed POST form: every key
-- "sel_<id>" with value "1" → <id>. Used by a bulk-delete handler branch.
-- The ids are author-trusted only insofar as they came from the rendered page;
-- a handler MUST still treat each as untrusted input (bind it / pass to a
-- destroy array — never splice into SQL).
function dt_selected_ids($form)
  $ids = []
  for each $k in keys($form)
    if starts_with($k, "sel_") and ("" .. $form[$k]) == "1" then
      push($ids, substr($k, 4, length($k) - 4))
    end
  end
  return $ids
end

-- True when a bulk POST asked to act on ALL matching rows (the select-all-across-pages
-- intent, S-5): the hidden select_all_matching field is "1". The handler then resolves
-- the id set with dt_all_ids (re-running dt_where) instead of dt_selected_ids — NEVER
-- trusting the posted sel_* ids for the across-pages case.
function dt_wants_all($form)
  return ("" .. dt_or($form["select_all_matching"], "")) == "1"
end

-- dt_all_ids($table, $spec, $state, $id_col) → ALL ids matching the current search +
-- filters (SELECT <id_col> over dt_where's WHERE, no LIMIT). The firewall-equivalent
-- for bulk (S-5): the handler rebuilds $state from the POST (dt_state_from_map(parse_form
-- (...))) and re-runs THIS, so "select all matching" can never be spoofed by posted ids.
-- $table + $id_col are author literals (never client input); the WHERE binds are values.
-- SQL only — a JMAP table caps/refuses via caps.select_all (the maild path can't return
-- an unbounded id list cheaply).
function dt_all_ids($table, $spec, $state, $id_col)
  $w = dt_where($spec, $state)
  $sql = "SELECT " .. $id_col .. " FROM " .. $table .. $w["where"]
  $rows = db_query($sql, $w["binds"])
  $ids = []
  for each $r in $rows
    push($ids, "" .. $r[$id_col])
  end
  return $ids
end

-- dt_reorder_swap($table, $order_col, $id_col, $id, $dir) → bool (did a swap happen).
-- The adjacent-row swap behind a ▲/▼ move (Phase 5). $table/$order_col/$id_col are author
-- literals (handler-supplied, never client input); $id is UNTRUSTED (bound). Reads the
-- moved row's order value, finds the immediately adjacent row by order value (next-lower
-- for "up", next-higher for "down"), and swaps the two order values with two bound UPDATEs.
-- No adjacent row (top/bottom), a missing id, a NULL order, or an unknown $dir → no-op,
-- returns false.
--
-- ── handler contract (the widget cannot enforce these — get them right) ──
--   • `$order_col` is a PLAIN, NON-UNIQUE integer column with DISTINCT values across the
--     list. NON-UNIQUE matters: the swap is two independent UPDATEs, so a transient
--     duplicate exists between them — a UNIQUE constraint on the column would abort the
--     first UPDATE. DISTINCT values matter: ties make "the adjacent row" ambiguous (the
--     swap still runs, but against an arbitrary tied row). Seed the column with a gap
--     sequence (10,20,30…) so the order is total.
--   • `$id_col` is a UNIQUE row identity and `bulk_id($row)` returns EXACTLY that column's
--     value (the move button carries bulk_id; the swap matches WHERE id_col = ?). A
--     non-unique id_col would let one move touch several rows; a bulk_id that names a
--     different column silently no-ops (the lookup misses).
--   • Reorder is a property of the WHOLE table, not the current view: the swap ignores the
--     active search/filter/group and the sort direction. Enable it on a single, global,
--     UNFILTERED list displayed ASCENDING by `$order_col` (the natural reorder view) — on a
--     filtered/grouped/desc view the ▲/▼ adjacency won't match what the eye sees.
--   • Not transactional: if the second UPDATE failed (it won't for a by-PK UPDATE on a
--     non-unique column) the first would have landed. Acceptable for the two-UPDATE design;
--     a consumer needing strict atomicity should add a transaction at the handler layer.
-- SQL-only — there is no maild reorder surface.
function dt_reorder_swap($table, $order_col, $id_col, $id, $dir)
  if $dir != "up" and $dir != "down" then
    return false
  end
  $cur = db_query("SELECT " .. $order_col .. " AS ord FROM " .. $table .. " WHERE " .. $id_col .. " = ?1", [$id])
  if length($cur) == 0 then
    return false
  end
  $cur_ord = $cur[0]["ord"]
  if $cur_ord == nil then
    return false
  end
  -- the adjacent row, in the move direction (author-literal op; the value is a bind).
  if $dir == "up" then
    $adj = db_query("SELECT " .. $id_col .. " AS aid, " .. $order_col .. " AS ord FROM " .. $table .. " WHERE " .. $order_col .. " < ?1 ORDER BY " .. $order_col .. " DESC LIMIT 1", [$cur_ord])
  else
    $adj = db_query("SELECT " .. $id_col .. " AS aid, " .. $order_col .. " AS ord FROM " .. $table .. " WHERE " .. $order_col .. " > ?1 ORDER BY " .. $order_col .. " ASC LIMIT 1", [$cur_ord])
  end
  if length($adj) == 0 then
    return false
  end
  $adj_id = $adj[0]["aid"]
  $adj_ord = $adj[0]["ord"]
  -- swap the two order values (two bound UPDATEs; id + adj_id untrusted → bound).
  db_exec("UPDATE " .. $table .. " SET " .. $order_col .. " = ?1 WHERE " .. $id_col .. " = ?2", [$adj_ord, $id])
  db_exec("UPDATE " .. $table .. " SET " .. $order_col .. " = ?1 WHERE " .. $id_col .. " = ?2", [$cur_ord, $adj_id])
  return true
end

-- Which bulk action a POST submitted: the "action" field "bulk_<name>" → "<name>"
-- ("" when absent or not a bulk_ action). Pair with dt_selected_ids($form) to
-- dispatch a multi-action bulk bar (e.g. delete / archive / publish). The single
-- default delete action yields "delete" (its button value is "bulk_delete"), so a
-- handler can branch on dt_bulk_action($f) == "delete" instead of the raw field.
function dt_bulk_action($form)
  $a = $form["action"]
  if $a == nil then
    return ""
  end
  $a = "" .. $a
  if starts_with($a, "bulk_") then
    return substr($a, 5, length($a) - 5)
  end
  return ""
end

-- True when the active sort differs from the table default (so links/forms should
-- carry sort+dir explicitly; otherwise omit for a clean canonical URL).
function dt_sort_is_nondefault($state, $opts)
  if $state["sort"] != $opts["default_sort"] then
    return true
  end
  if $state["dir"] != $opts["default_dir"] then
    return true
  end
  return false
end

-- A column's whitelisted alignment CSS class ("" = none). left|center|right map to a fixed
-- .dt-align-* class; anything else (or nil) → "" so an align value can never inject a class.
function dt_align_cls($c)
  $a = "" .. dt_or($c["align"], "")
  if $a == "right" then
    return "dt-align-right"
  end
  if $a == "center" then
    return "dt-align-center"
  end
  if $a == "left" then
    return "dt-align-left"
  end
  return ""
end

-- A column's explicit width as a ` style="width:…"` attr (or "") for table-layout:fixed.
-- The value is a handler literal, but we still firewall it to <number><unit> with unit in
-- {rem,px,em,ch,%} so a typo/garbage value is dropped rather than emitted into the style
-- attribute. Number part = digits with at most one dot.
function dt_num_only($s)
  if length($s) == 0 then
    return false
  end
  $dots = 0
  $digits = 0
  $i = 0
  while $i < length($s)
    $ch = substr($s, $i, 1)
    if $ch == "." then
      $dots = $dots + 1
    else
      if $ch < "0" or $ch > "9" then
        return false
      end
      $digits = $digits + 1
    end
    $i = $i + 1
  end
  return $digits > 0 and $dots <= 1
end
function dt_width_style($c)
  $w = trim("" .. dt_or($c["width"], ""))
  if $w == "" then
    return ""
  end
  $units = ["rem", "px", "em", "ch", "%"]
  for each $u in $units
    if ends_with($w, $u) then
      $num = substr($w, 0, length($w) - length($u))
      if dt_num_only($num) then
        return ' style="width:' .. $w .. '"'
      end
    end
  end
  return ""
end

-- One header cell. Sortable -> <a> carrying the NEXT sort state; aria-sort on the
-- active column only (never stale on inactive headers). The optional align class is merged
-- into the th class (default none → byte-identical).
function dt_th($c, $state, $opts)
  $al = dt_align_cls($c)
  $wstyle = dt_width_style($c)
  if not $c["sortable"] then
    $clsattr = ""
    if $al != "" then
      $clsattr = ' class="' .. $al .. '"'
    end
    return '<th scope="col"' .. $clsattr .. $wstyle .. '>' .. esc($c["label"]) .. '</th>'
  end
  $active = ($state["sort"] == $c["key"])
  $nextdir = "asc"
  $ariasort = ""
  $caret = ""
  if $active then
    if $state["asc"] then
      $nextdir = "desc"
      $ariasort = ' aria-sort="ascending"'
      $caret = '<span class="dt-caret" aria-hidden="true"> ↑</span>'
    else
      $nextdir = "asc"
      $ariasort = ' aria-sort="descending"'
      $caret = '<span class="dt-caret" aria-hidden="true"> ↓</span>'
    end
  end
  $thcls = "sortable-th"
  if $al != "" then
    $thcls = $thcls .. " " .. $al
  end
  $href = dt_href($opts["base_route"], { sort: $c["key"], dir: $nextdir, q: $state["q"], box: $state["box"], size: $state["size"], filters: $state["filters_raw"], hide: $state["hide_raw"], group: $state["group"] }, $opts)
  return '<th scope="col" class="' .. $thcls .. '"' .. $ariasort .. $wstyle .. '><a href="' .. $href .. '">' .. esc($c["label"]) .. $caret .. '</a></th>'
end

-- Cell inner HTML: a render lambda owns it (must already be escaped + must NOT
-- emit its own <a> for the first column). No render -> the column `type` decides:
-- boolean → a ✓/✗ glyph, datetime → a trimmed stamp, else the plain escaped
-- backing value. Type formatting is sugar; a render lambda always wins.
-- The cell pipeline. Precedence: render lambda (escape hatch) → declarative
-- `badge` opt → nil-value placeholder → type cell (boolean/datetime/ring) →
-- the text path (fmt → prefix/suffix → limit → escape ONCE → optional desc).
-- INVARIANT (escape-once): the type/fmt formatters return RAW text and dt_cell
-- does the single esc(); only render/desc/badge/ring emit HTML, each with the
-- value-portion escaped inside. A column that sets none of the new opts is
-- byte-identical to the historic widget (text → esc("" .. $v); boolean/datetime
-- unchanged; nil → "").
function dt_cell($c, $row)
  if $c["render"] != nil then
    return $c["render"]($row)
  end
  -- declarative badge: fn($row) -> { text, variant?, icon? } (nil = empty cell).
  if $c["badge"] != nil then
    $b = $c["badge"]($row)
    if $b == nil then
      return ""
    end
    return dt_badge("" .. dt_or($b["text"], ""), $b["variant"], $b["icon"])
  end
  $v = $row[$c["col"]]
  if $v == nil then
    $ph = $c["placeholder"]
    if $ph != nil and ("" .. $ph) != "" then
      return '<span class="dt-desc">' .. esc("" .. $ph) .. '</span>'
    end
    return ""
  end
  $t = $c["type"]
  if $t == "boolean" then
    return dt_cell_bool($v)
  end
  if $t == "datetime" then
    return esc(dt_fmt_dt("" .. $v))
  end
  if $t == "ring" then
    return dt_cell_ring($v)
  end
  -- text path: optional fmt (raw) → truncate → prefix/suffix → escape once.
  $raw = "" .. $v
  if $c["fmt"] != nil then
    $raw = "" .. $c["fmt"]($v)
  end
  if $c["limit"] != nil then
    $raw = dt_truncate($raw, $c["limit"])
  end
  $raw = ("" .. dt_or($c["prefix"], "")) .. $raw .. ("" .. dt_or($c["suffix"], ""))
  $out = esc($raw)
  -- optional muted secondary line (col opt `desc`): fn($row) -> raw text.
  if $c["desc"] != nil then
    $dv = "" .. $c["desc"]($row)
    if $dv != "" then
      $out = $out .. '<br><span class="dt-desc">' .. esc($dv) .. '</span>'
    end
  end
  return $out
end

-- The cell's hover tooltip text (the <td>'s `title` attribute), so a CSS-ellipsised cell
-- reveals its full content on hover. A column's explicit `tooltip` fn($row) wins; otherwise
-- AUTO from the backing value — but ONLY for a plain text/datetime column (a render/badge
-- lambda emits arbitrary HTML the widget can't reduce to text; a boolean/ring cell is a
-- glyph, not elidable). Returns the RAW string ("" = no title); the caller esc()'s it once.
function dt_cell_tip($c, $row)
  if $c["tooltip"] != nil then
    return "" .. $c["tooltip"]($row)
  end
  if $c["render"] != nil or $c["badge"] != nil then
    return ""
  end
  $v = $row[$c["col"]]
  if $v == nil then
    return ""
  end
  $t = $c["type"]
  if $t == "boolean" or $t == "ring" then
    return ""
  end
  -- Mirror dt_cell's text pipeline (fmt → prefix/suffix) so the tip matches the visible
  -- text — but WITHOUT `limit`, since the whole point is the full, untruncated content
  -- (e.g. a `/`-prefixed slug cell tips "/the-slug", not the bare "the-slug").
  $raw = "" .. $v
  if $c["fmt"] != nil then
    $raw = "" .. $c["fmt"]($v)
  end
  return ("" .. dt_or($c["prefix"], "")) .. $raw .. ("" .. dt_or($c["suffix"], ""))
end

-- Truthiness for a `type: "boolean"` backing value across the shapes SQLite/JMAP
-- yield: 1/0, "1"/"0", true/false, "true"/"yes"/"t"/"y". Anything else = false.
function dt_truthy($v)
  $s = lower(trim("" .. $v))
  if $s == "1" or $s == "true" or $s == "yes" or $s == "t" or $s == "y" then
    return true
  end
  return false
end

-- Boolean cell glyph (escaped literals; aria-label carries the word for SR users).
function dt_cell_bool($v)
  if dt_truthy($v) then
    return '<span class="dt-bool dt-bool-yes" title="Yes" aria-label="Yes">✓</span>'
  end
  return '<span class="dt-bool dt-bool-no" title="No" aria-label="No">✗</span>'
end

-- Light datetime sugar for `type: "datetime"` columns WITHOUT a render lambda:
-- normalise an ISO-ish stamp to "YYYY-MM-DD HH:MM" (drop the T/Z and seconds),
-- leaving anything unrecognised untouched. Handlers wanting locale/relative
-- formatting still pass a render lambda. Pure string work — no datetime-builtin
-- dependency, so it can't surprise on an odd value. Caller esc()'s the result.
function dt_fmt_dt($s)
  $x = replace("" .. $s, "T", " ")
  $x = replace($x, "Z", "")
  if length($x) >= 16 and substr($x, 4, 1) == "-" and substr($x, 7, 1) == "-" then
    return substr($x, 0, 16)
  end
  return $x
end

-- ─────────────────────────── URL builder ───────────────────────────
-- dt_filter_param_pairs($f, $val) → the { suffix, value } pairs a filter's canonical
-- value expands to as URL params (the param name is `filter.<name><suffix>`). Most
-- kinds are ONE pair (suffix ""); a daterange's "from..to" value splits into the
-- present `.from` / `.to` bounds. The single source both dt_filter_url_parts and
-- dt_filter_hidden use, so a daterange threads as two params everywhere.
function dt_filter_param_pairs($f, $val)
  $pairs = []
  if ("" .. $f["kind"]) == "daterange" then
    $ft = split("" .. $val, "..")
    $from = ""
    $to = ""
    if length($ft) >= 1 then
      $from = trim("" .. $ft[0])
    end
    if length($ft) >= 2 then
      $to = trim("" .. $ft[1])
    end
    if $from != "" then
      push($pairs, { suffix: ".from", value: $from })
    end
    if $to != "" then
      push($pairs, { suffix: ".to", value: $to })
    end
  else
    push($pairs, { suffix: "", value: "" .. $val })
  end
  return $pairs
end

-- dt_filter_url_parts($opts, $filters_raw, $pfx) → the list of `<pfx>filter.<name>…`
-- URL parts for the ACTIVE filters, in SPEC order (canonical). The single source used
-- by dt_href (S-3). Iterates the spec for deterministic order, looks up each name's
-- canonical token in $filters_raw (= $state["filters_raw"]), and expands it via
-- dt_filter_param_pairs (so a daterange emits .from/.to). Only allowlisted/validated
-- values ever reach a URL. Empty list when no filters.
function dt_filter_url_parts($opts, $filters_raw, $pfx)
  $parts = []
  if $opts["filters"] == nil or $filters_raw == nil then
    return $parts
  end
  for each $f in $opts["filters"]
    $nm = "" .. $f["name"]
    $val = $filters_raw[$nm]
    if $val != nil and ("" .. $val) != "" then
      for each $pr in dt_filter_param_pairs($f, $val)
        push($parts, $pfx .. "filter." .. $nm .. $pr["suffix"] .. "=" .. url_encode($pr["value"]))
      end
    end
  end
  return $parts
end

-- dt_href($route, $params, $opts) — canonical-URL discipline. Omits defaults (no
-- page=1, no dir=asc, no empty q) AND omits sort/dir when they equal the table
-- defaults — so a sort link, the search form, and a bookmarked bare URL all
-- produce the SAME canonical string for the same logical view (SPA same-URL dedup
-- + Back/Forward behave). Page is carried only when explicitly passed (sort/search
-- links don't pass it → reset to page 1).
function dt_href($route, $params, $opts)
  -- param names carry the instance prefix ("" for the single table → bare names,
  -- byte-identical to before); only NAMES are prefixed, values still url_encode'd.
  $pfx = dt_pfx($opts)
  $parts = []
  $sort = $params["sort"]
  $dir = $params["dir"]
  if $sort != nil and $sort != "" then
    $isdefault = ($sort == $opts["default_sort"]) and ($dir == $opts["default_dir"])
    if not $isdefault then
      push($parts, $pfx .. "sort=" .. url_encode($sort))
      if $dir != nil and $dir != "" then
        push($parts, $pfx .. "dir=" .. url_encode($dir))
      end
    end
  end
  $box = $params["box"]
  if $box != nil and $box != "" then
    push($parts, $pfx .. "box=" .. url_encode($box))
  end
  -- size: carried only when NON-default, so the canonical URL stays clean. Kept
  -- between box and q (a stable param order shared with dt_search_form's hidden
  -- fields, so a sort link and a search submit yield byte-identical URLs).
  $size = $params["size"]
  if $size != nil and ("" .. $size) != ("" .. $opts["page_size"]) then
    push($parts, $pfx .. "size=" .. url_encode("" .. $size))
  end
  $q = $params["q"]
  if $q != nil and $q != "" then
    push($parts, $pfx .. "q=" .. url_encode($q))
  end
  -- active filters (S-3): the SINGLE source of filter.<name>= URL parts, threaded
  -- through EVERY link builder via $params["filters"] (= $state["filters_raw"]). A
  -- builder that forgets to pass it silently drops filters on its click, so the
  -- "sort link preserves ?filter.*" regression test guards this. Spec order →
  -- canonical. Emitted after q, before page (page stays last).
  $fr = $params["filters"]
  if $fr != nil then
    for each $fpart in dt_filter_url_parts($opts, $fr, $pfx)
      push($parts, $fpart)
    end
  end
  -- hidden toggleable columns (?<pfx>hide=k1,k2). Carried as ONE canonical comma
  -- value ($state["hide_raw"], already spec-order + validated); threaded like
  -- filters so a sort/page/filter click keeps the column-visibility choice.
  $hd = $params["hide"]
  if $hd != nil and ("" .. $hd) != "" then
    push($parts, $pfx .. "hide=" .. url_encode("" .. $hd))
  end
  -- active group (Phase 4b): threaded through EVERY link builder via $params["group"]
  -- (= $state["group"]) so a sort/page/size/filter click keeps the grouping. After hide,
  -- before page (page stays last), matching the hidden-field order in dt_group_field so a
  -- link and a form submit dedupe to the same canonical URL. The "sort link preserves
  -- ?group=" regression test guards a builder that forgets to pass it.
  $grp = $params["group"]
  if $grp != nil and ("" .. $grp) != "" then
    push($parts, $pfx .. "group=" .. url_encode("" .. $grp))
  end
  $page = $params["page"]
  if $page != nil and ("" .. $page) != "1" then
    push($parts, $pfx .. "page=" .. url_encode("" .. $page))
  end
  if length($parts) == 0 then
    return $route
  end
  return $route .. "?" .. join($parts, "&")
end

function dt_page_href($opts, $state, $n)
  return dt_href($opts["base_route"], { sort: $state["sort"], dir: $state["dir"], q: $state["q"], box: $state["box"], size: $state["size"], filters: $state["filters_raw"], hide: $state["hide_raw"], group: $state["group"], page: $n }, $opts)
end

-- Simple (Prev/Next-only) pager (deferred Phase-1 `simple` opt). Prev when page>1, Next when
-- page<pages, + "Page N of M". $skin selects the chevron-icon style vs the text btn style;
-- both reuse dt_page_href. Total is still known (this is the pager STYLE, not the skip-COUNT
-- optimisation), so "of M" is exact.
function dt_pager_simple($opts, $state, $pages, $skin)
  $page = $state["page"]
  $h = '<nav class="datatable-pagination-bar datatable-pager-simple" aria-label="Pagination"><ul class="datatable-page-list">'
  if $skin then
    if $page > 1 then
      $h = $h .. '<li><a class="dt-page-extreme" rel="prev" aria-label="Previous page" href="' .. dt_page_href($opts, $state, $page - 1) .. '">' .. dt_icon("chevron-left") .. '</a></li>'
    end
    $h = $h .. '<li><span class="datatable-page-info muted small">Page ' .. ("" .. $page) .. ' of ' .. ("" .. $pages) .. '</span></li>'
    if $page < $pages then
      $h = $h .. '<li><a class="dt-page-extreme" rel="next" aria-label="Next page" href="' .. dt_page_href($opts, $state, $page + 1) .. '">' .. dt_icon("chevron-right") .. '</a></li>'
    end
  else
    if $page > 1 then
      $h = $h .. '<li><a class="btn btn-ghost btn-sm" rel="prev" href="' .. dt_page_href($opts, $state, $page - 1) .. '">← Prev</a></li>'
    end
    $h = $h .. '<li><span class="datatable-page-info muted small">Page ' .. ("" .. $page) .. ' of ' .. ("" .. $pages) .. '</span></li>'
    if $page < $pages then
      $h = $h .. '<li><a class="btn btn-ghost btn-sm" rel="next" href="' .. dt_page_href($opts, $state, $page + 1) .. '">Next →</a></li>'
    end
  end
  $h = $h .. '</ul></nav>'
  return $h
end

-- ─────────────────────────── pager ───────────────────────────
-- dt_pager($opts, $state, $total) — windowed numbered pagination + prev/next +
-- "page N of M", ARIA-annotated. Single page -> no chrome. opts.simple → Prev/Next only.
function dt_pager($opts, $state, $total)
  $limit = $state["limit"]
  $page = $state["page"]
  $pages = dt_ceil($total / $limit)
  if $pages <= 1 then
    return ""
  end
  if $opts["simple"] == true then
    return dt_pager_simple($opts, $state, $pages, false)
  end
  $h = '<nav class="datatable-pagination-bar" aria-label="Pagination"><ul class="datatable-page-list">'
  if $page > 1 then
    $h = $h .. '<li><a class="btn btn-ghost btn-sm" rel="prev" href="' .. dt_page_href($opts, $state, $page - 1) .. '">← Prev</a></li>'
  end
  $w = $opts["window"]
  $lo = $page - $w
  if $lo < 1 then
    $lo = 1
  end
  $hi = $page + $w
  if $hi > $pages then
    $hi = $pages
  end
  if $lo > 1 then
    $h = $h .. dt_page_num($opts, $state, 1)
    if $lo > 2 then
      $h = $h .. '<li><span class="dt-ellipsis" aria-hidden="true">…</span></li>'
    end
  end
  $n = $lo
  while $n <= $hi
    $h = $h .. dt_page_num($opts, $state, $n)
    $n = $n + 1
  end
  if $hi < $pages then
    if $hi < ($pages - 1) then
      $h = $h .. '<li><span class="dt-ellipsis" aria-hidden="true">…</span></li>'
    end
    $h = $h .. dt_page_num($opts, $state, $pages)
  end
  if $page < $pages then
    $h = $h .. '<li><a class="btn btn-ghost btn-sm" rel="next" href="' .. dt_page_href($opts, $state, $page + 1) .. '">Next →</a></li>'
  end
  $h = $h .. '</ul><span class="datatable-page-info muted small">Page ' .. ("" .. $page) .. ' of ' .. ("" .. $pages) .. '</span></nav>'
  return $h
end

function dt_page_num($opts, $state, $n)
  $label = "" .. $n
  if $n == $state["page"] then
    return '<li><a class="page-number-btn page-number-active" aria-current="page" aria-label="Page ' .. $label .. '" href="' .. dt_page_href($opts, $state, $n) .. '">' .. $label .. '</a></li>'
  end
  return '<li><a class="page-number-btn" aria-label="Page ' .. $label .. '" href="' .. dt_page_href($opts, $state, $n) .. '">' .. $label .. '</a></li>'
end

function dt_ceil($x)
  $f = dt_trunc($x)
  if $x > $f then
    return $f + 1
  end
  return $f
end

-- "Per page" size selector — a compact row of links (e.g. 10 25 50 100), the
-- active size inert. Each link is a real GET to the same route carrying
-- sort/dir/q/box + ?size=N and NO page (changing size lands on page 1).
-- SPA-swappable, no JS, canonical (the default size omits the param). Hidden when
-- there's too little data to paginate even at the smallest option, or when fewer
-- than two sizes are offered. $total bounds the "is it worth showing" decision.
function dt_size_selector($opts, $state, $total)
  $sizes = $opts["page_sizes"]
  if $sizes == nil or length($sizes) < 2 then
    return ""
  end
  -- worth-showing threshold = the smallest NUMERIC size (the "all" sentinel is skipped —
  -- it isn't a number, so comparing it would error and it doesn't bound "is it worth it").
  if $total <= dt_size_min($sizes) then
    return ""
  end
  $h = '<div class="datatable-pagesize muted small"><span>Per page:</span> '
  $links = []
  for each $s in $sizes
    if ("" .. $s) == ("" .. $state["size"]) then
      push($links, '<span class="dt-pagesize-active" aria-current="true">' .. dt_size_label($s) .. '</span>')
    else
      $href = dt_href($opts["base_route"], { sort: $state["sort"], dir: $state["dir"], q: $state["q"], box: $state["box"], size: $s, filters: $state["filters_raw"], hide: $state["hide_raw"], group: $state["group"] }, $opts)
      push($links, '<a href="' .. $href .. '">' .. dt_size_label($s) .. '</a>')
    end
  end
  $h = $h .. join($links, " ") .. '</div>'
  return $h
end

-- The smallest NUMERIC page size (the "all" sentinel, a string, is ignored). Used to decide
-- whether a per-page selector is worth showing. Falls back to a big number if the list is
-- somehow all-"all".
function dt_size_min($sizes)
  $min = nil
  for each $s in $sizes
    $n = to_number("" .. $s)
    if $n != nil then
      if $min == nil or $n < $min then
        $min = $n
      end
    end
  end
  if $min == nil then
    return 1000000000
  end
  return $min
end

-- Display label for a page-size option: "All" for the "all" sentinel, else the number.
function dt_size_label($s)
  if ("" .. $s) == "all" then
    return "All"
  end
  return "" .. $s
end

-- ═══════════════════════ skin render bands (Phase 1) ═══════════════════════
-- Only reached when opts.skin is true (dt_render branches). Each emits the
-- Filament markup the .datatable-skin CSS styles; none runs on an unskinned page.

-- Render header_actions as pills, ALWAYS putting the primary "+ New X" create
-- action on the RIGHT (foundation rule: the create button is top-right on every
-- admin panel). Non-primary pills (Reindex, Fix Perms, Test All, …) render first
-- in their declared order; every variant:"primary" action is moved to the end,
-- so a handler can list header_actions in any order and the New button still
-- lands rightmost. THE enforcement of the invariant — not a per-handler chore.
function dt_header_actions_html($opts)
  if $opts["header_actions"] == nil then return "" end
  $rest = ""
  $primary = ""
  for each $a in $opts["header_actions"]
    if ("" .. dt_or($a["variant"], "")) == "primary" then
      $primary = $primary .. dt_action_link($a)
    else
      $rest = $rest .. dt_action_link($a)
    end
  end
  return $rest .. $primary
end


-- ═══════════════════════ compact header (opt-in opts.compact) ═══════════════════════
-- A single dense top row: title hard-left, then a right-aligned cluster of all the controls
-- (bulk-trash · search · funnel · group-icon · columns · header actions). NO subtitle — the
-- table starts right under it. The funnel/columns/group move OUT of the #dt-results slot up
-- to here, so search re-renders the full region (dt_target_attr returns "" under compact).

-- The compact in-row search form (a touch narrower than the full toolbar). Reuses the live-
-- search id/marker (dt_q_attrs), the × clear (dt_clear_btn), and the state hidden fields so
-- a submit preserves the view. Emits the live debounce script when live_search.
function dt_compact_search($opts, $state)
  if not $opts["search"] then
    return ""
  end
  $route = $opts["base_route"]
  $pfx = dt_pfx($opts)
  $h = '<form method="get" action="' .. $route .. '" class="dt-search-form dt-search-compact" role="search"' .. dt_target_attr($opts) .. '>'
  $h = $h .. dt_hidden_fields($opts, $state, $pfx, "q")
  $h = $h .. dt_filter_hidden($opts, $state, $pfx)
  $h = $h .. dt_hide_field($opts, $state, $pfx)
  $h = $h .. dt_group_field($opts, $state, $pfx)
  $h = $h .. '<div class="dt-search-wrap">' .. dt_icon("search")
  $h = $h .. '<input' .. dt_q_attrs($opts) .. ' name="' .. $pfx .. 'q" value="' .. esc($state["q"]) .. '" placeholder="' .. esc($opts["search_placeholder"]) .. '" aria-label="' .. esc($opts["search_placeholder"]) .. '" type="search">' .. dt_clear_btn($opts, $state) .. '</div>'
  $h = $h .. '</form>'
  if $opts["live_search"] == true then
    $h = $h .. dt_search_script()
  end
  return $h
end

-- Group-by as an ICON popover (compact). A <details> whose panel is a GET form of the
-- group choices (No grouping + each group), auto-submitting on change (Lane A) with an Apply
-- fallback. Count badge "1" when a group is active. "" when no groups (then it's simply
-- dropped — group-by is the least-used control, per Mark). Click-away via dt_filter_script.
function dt_group_pop($opts, $state)
  if $opts["groups"] == nil or length($opts["groups"]) == 0 then
    return ""
  end
  $pfx = dt_pfx($opts)
  $route = $opts["base_route"]
  $cur = "" .. dt_or($state["group"], "")
  $badge = ""
  if $cur != "" then
    $badge = '<span class="dt-badge-count">1</span>'
  end
  $gid = dt_region_id($opts["id"]) .. "-groupby"
  $h = '<details class="dt-groupby-pop">'
  $h = $h .. '<summary class="dt-iconbtn" aria-label="Group by" title="Group by">' .. dt_icon("group") .. $badge .. '</summary>'
  $h = $h .. '<div class="dt-groupby-panel">'
  $h = $h .. '<div class="dt-filter-head"><strong>Group by</strong></div>'
  $h = $h .. '<form method="get" action="' .. $route .. '">'
  $h = $h .. dt_hidden_fields($opts, $state, $pfx, "")
  $h = $h .. dt_filter_hidden($opts, $state, $pfx)
  $h = $h .. dt_hide_field($opts, $state, $pfx)
  $h = $h .. '<select id="' .. $gid .. '" name="' .. $pfx .. 'group" class="dt-perpage-select" data-dt-autosubmit aria-label="Group by">'
  $h = $h .. '<option value="">No grouping</option>'
  for each $g in $opts["groups"]
    $sel = ""
    if ("" .. $g["key"]) == $cur then
      $sel = " selected"
    end
    $h = $h .. '<option value="' .. esc("" .. $g["key"]) .. '"' .. $sel .. '>' .. esc("" .. $g["label"]) .. '</option>'
  end
  $h = $h .. '</select>'
  $h = $h .. '<div class="dt-filter-apply"><button class="btn btn-primary" type="submit">Apply</button></div>'
  $h = $h .. '</form></div></details>'
  $h = $h .. dt_filter_script()
  $h = $h .. dt_skin_script()
  return $h
end

-- Bulk action(s) as icon button(s) in the compact header — the "Delete selected" → a trash
-- ICON, disabled until rows are selected (dt_bulk_script toggles it + a count badge). Each
-- button is form-ASSOCIATED to the table's wrapping bulk POST form (form="<bulk-form-id>")
-- since it lives outside that form, in the header. data-confirm gates it (the dialog).
function dt_bulk_trash($opts)
  $bform = "dt-bulk-form"
  if $opts["id"] != "" then
    $bform = "dt-bulk-form-" .. $opts["id"]
  end
  $h = ""
  for each $act in $opts["bulk_actions"]
    $cattr = ""
    $aconf = $act["confirm"]
    if $aconf != nil and ("" .. $aconf) != "" then
      $cattr = ' data-confirm="' .. esc("" .. $aconf) .. '"'
    end
    $lbl = "" .. dt_or($act["label"], "Action")
    -- per-action icon (bulk_actions `icon`); default trash preserves the
    -- historic delete-only bar. A Mark-read button must NOT be a trashcan.
    $aicon = "" .. dt_or($act["icon"], "trash")
    $h = $h .. '<button type="submit" form="' .. $bform .. '" name="action" value="bulk_' .. esc("" .. $act["name"]) .. '" class="dt-iconbtn dt-bulk-act dt-bulk-trash" disabled' .. $cattr .. ' aria-label="' .. esc($lbl) .. '" title="' .. esc($lbl) .. '">' .. dt_icon($aicon) .. '<span class="dt-bulk-count-badge" hidden></span></button>'
  end
  return $h
end

-- The compact one-row header. Title hard-left; a right-aligned cluster of the controls in
-- the requested order: [bulk-trash][search][funnel][group-icon][columns][header actions].
function dt_compact_header($spec, $opts, $state, $total)
  $h = '<div class="dt-header dt-header-compact">'
  -- A subtitle, if set, surfaces as the title's TOOLTIP (native `title=` on hover)
  -- rather than a separate line — compact keeps its single dense row while the
  -- description stays reachable. (dt_header_band, the old subtitle-as-a-line header,
  -- is retired 2026-07-13.)
  $subtt = ""
  $sub = "" .. dt_or($opts["subtitle"], "")
  if $sub != "" then $subtt = ' title="' .. esc($sub) .. '"' end
  $h = $h .. '<h1 class="dt-title" id="dt-heading" tabindex="-1"' .. $subtt .. '>' .. esc($opts["caption"]) .. '</h1>'
  $h = $h .. '<div class="dt-header-cluster">'
  if $opts["bulk"] == true then
    $h = $h .. dt_bulk_trash($opts)
  end
  $h = $h .. dt_compact_search($opts, $state)
  if $opts["filters"] != nil and length($opts["filters"]) > 0 then
    $h = $h .. dt_filter_pop($opts, $state)
  end
  $h = $h .. dt_group_pop($opts, $state)
  if dt_has_toggleable($spec) then
    $h = $h .. dt_col_manager($spec, $opts, $state)
  end
  $acts = dt_header_actions_html($opts)
  $tb = "" .. dt_or($opts["toolbar"], "")
  if $acts != "" or $tb != "" then
    $h = $h .. '<span class="dt-header-actions">' .. $acts .. $tb .. '</span>'
  end
  $h = $h .. '</div></div>'
  return $h
end

-- Toolbar band: the search box (pill + leading magnifier) right-aligned. Hidden
-- sort/dir/box/size/filters preserve view state across a search (q is the visible
-- field), in dt_href's canonical order so a search submit and a sort link dedupe to
-- the same URL. With NO filters declared this is BYTE-IDENTICAL to the shipped
-- toolbar (the form itself is the `.dt-toolbar` flex strip). When filters exist the
-- band becomes a `.dt-toolbar` WRAPPER holding the search form + the funnel popover
-- as SIBLINGS — the funnel is its own <details><form>, never nested inside the
-- search form (nested forms are invalid HTML).
function dt_toolbar_band($opts, $state)
  $route = $opts["base_route"]
  $pfx = dt_pfx($opts)
  $clear = ""
  if $state["q"] != "" then
    $clear = '<a class="btn btn-ghost" href="' .. dt_href($route, { sort: $state["sort"], dir: $state["dir"], box: $state["box"], size: $state["size"], filters: $state["filters_raw"], hide: $state["hide_raw"], group: $state["group"] }, $opts) .. '">Clear</a>'
  end
  -- live_search keeps the funnel OUT of the search toolbar (it renders standalone via
  -- dt_filter_bar, which sits INSIDE the #dt-results slot — so a search swap re-syncs the
  -- funnel's q). Without live_search, the funnel rides beside the search box as before.
  if $opts["filters"] == nil or length($opts["filters"]) == 0 or $opts["live_search"] == true then
    -- historic toolbar — the <form> is the flex strip (byte-identical).
    $h = '<form method="get" action="' .. $route .. '" class="dt-toolbar" role="search"' .. dt_target_attr($opts) .. '>'
    $h = $h .. '<div class="dt-toolbar-right">'
    $h = $h .. dt_hidden_fields($opts, $state, $pfx, "q")
    $h = $h .. '<div class="dt-search-wrap">' .. dt_icon("search")
    $h = $h .. '<input' .. dt_q_attrs($opts) .. ' name="' .. $pfx .. 'q" value="' .. esc($state["q"]) .. '" placeholder="' .. esc($opts["search_placeholder"]) .. '" aria-label="' .. esc($opts["search_placeholder"]) .. '" type="search">' .. dt_clear_btn($opts, $state) .. '</div>'
    $h = $h .. dt_hide_field($opts, $state, $pfx)
    $h = $h .. dt_group_field($opts, $state, $pfx)
    $h = $h .. '<button class="btn btn-ghost" type="submit">Search</button>'
    $h = $h .. $clear
    $h = $h .. '</div></form>'
    return $h
  end
  -- filtered toolbar — a wrapper div with the search form + funnel as siblings.
  $h = '<div class="dt-toolbar"><div class="dt-toolbar-right">'
  $h = $h .. '<form method="get" action="' .. $route .. '" class="dt-search-form" role="search"' .. dt_target_attr($opts) .. '>'
  $h = $h .. dt_hidden_fields($opts, $state, $pfx, "q")
  $h = $h .. '<div class="dt-search-wrap">' .. dt_icon("search")
  $h = $h .. '<input' .. dt_q_attrs($opts) .. ' name="' .. $pfx .. 'q" value="' .. esc($state["q"]) .. '" placeholder="' .. esc($opts["search_placeholder"]) .. '" aria-label="' .. esc($opts["search_placeholder"]) .. '" type="search"></div>'
  $h = $h .. dt_filter_hidden($opts, $state, $pfx)
  $h = $h .. dt_hide_field($opts, $state, $pfx)
  $h = $h .. dt_group_field($opts, $state, $pfx)
  $h = $h .. '<button class="btn btn-ghost" type="submit">Search</button>'
  $h = $h .. $clear
  $h = $h .. '</form>'
  $h = $h .. dt_filter_pop($opts, $state)
  $h = $h .. '</div></div>'
  return $h
end

-- Hidden state inputs for a GET form, in dt_href's canonical param order
-- (sort, dir, box, size, q). $skip names the form's VISIBLE field, omitted here
-- (a search form skips "q"; a per-page form skips "size"). page is never carried
-- (any state change resets to page 1), matching dt_href.
function dt_hidden_fields($opts, $state, $pfx, $skip)
  $h = ""
  if dt_sort_is_nondefault($state, $opts) then
    $h = $h .. '<input type="hidden" name="' .. $pfx .. 'sort" value="' .. esc($state["sort"]) .. '">'
    $h = $h .. '<input type="hidden" name="' .. $pfx .. 'dir" value="' .. esc($state["dir"]) .. '">'
  end
  if $state["box"] != "" then
    $h = $h .. '<input type="hidden" name="' .. $pfx .. 'box" value="' .. esc($state["box"]) .. '">'
  end
  if $skip != "size" and ("" .. $state["size"]) != ("" .. $opts["page_size"]) then
    $h = $h .. '<input type="hidden" name="' .. $pfx .. 'size" value="' .. esc("" .. $state["size"]) .. '">'
  end
  if $skip != "q" and $state["q"] != "" then
    $h = $h .. '<input type="hidden" name="' .. $pfx .. 'q" value="' .. esc($state["q"]) .. '">'
  end
  return $h
end

-- Footer band: "Showing X to Y of Z" range + the per-page <select> + the amber
-- pager, on one strip. Only the range always shows; the select hides with <2
-- sizes, the pager with a single page. Reached only when rows>0 (dt_render
-- early-returns the empty state), so the range bounds are always valid.
function dt_footer_band($opts, $state, $total)
  if $total <= 0 then
    return ""
  end
  $h = '<div class="dt-footer">'
  $h = $h .. dt_range_label($state, $total)
  $h = $h .. dt_size_select($opts, $state)
  $h = $h .. dt_pager_skin($opts, $state, $total)
  $h = $h .. '</div>'
  $h = $h .. dt_skin_script()
  return $h
end

-- "Showing X to Y of Z results". from = offset+1, to = min(offset+limit, total).
function dt_range_label($state, $total)
  $from = $state["pos"] + 1
  if $from > $total then
    $from = $total
  end
  $to = $state["pos"] + $state["limit"]
  if $to > $total then
    $to = $total
  end
  return '<span class="dt-results-range">Showing ' .. ("" .. $from) .. ' to ' .. ("" .. $to) .. ' of ' .. ("" .. $total) .. ' results</span>'
end

-- Per-page <select> (Filament's "Per page" control). A GET form that boosts to a
-- region partial; an inline script (dt_skin_script) submits it on change and
-- hides the no-JS "Go" button. Honours the page_sizes allowlist (the same
-- size-param firewall dt_state enforces). NO page field → changing size lands on
-- page 1. Hidden state (skip "size") preserves sort/dir/box/q + active filters.
function dt_size_select($opts, $state)
  $sizes = $opts["page_sizes"]
  if $sizes == nil or length($sizes) < 2 then
    return ""
  end
  $pfx = dt_pfx($opts)
  $route = $opts["base_route"]
  $h = '<form method="get" action="' .. $route .. '" class="dt-perpage">'
  $h = $h .. dt_hidden_fields($opts, $state, $pfx, "size")
  $h = $h .. dt_filter_hidden($opts, $state, $pfx)
  $h = $h .. dt_hide_field($opts, $state, $pfx)
  $h = $h .. dt_group_field($opts, $state, $pfx)
  $h = $h .. '<label class="dt-perpage-label" for="' .. dt_region_id($opts["id"]) .. '-perpage">Per page</label>'
  $h = $h .. '<select id="' .. dt_region_id($opts["id"]) .. '-perpage" name="' .. $pfx .. 'size" class="dt-perpage-select" data-dt-autosubmit aria-label="Results per page">'
  for each $s in $sizes
    $sel = ""
    if ("" .. $s) == ("" .. $state["size"]) then
      $sel = " selected"
    end
    $h = $h .. '<option value="' .. esc("" .. $s) .. '"' .. $sel .. '>' .. dt_size_label($s) .. '</option>'
  end
  $h = $h .. '</select>'
  $h = $h .. '<button type="submit" class="dt-perpage-go">Go</button>'
  $h = $h .. '</form>'
  return $h
end

-- "Group by" <select> (Phase 4b, Lane A). A GET form that boosts to a region partial;
-- the shared dt_skin_script auto-submits it on change + hides the no-JS "Go". The leading
-- "No grouping" option (value "") clears the group. NO page field → regrouping lands on
-- page 1. Hidden state (skip "") preserves sort/dir/box/size/q + filters + hide — but NOT
-- group (this select IS the group control). "" when no groups declared → never rendered.
function dt_group_select($opts, $state)
  if $opts["groups"] == nil or length($opts["groups"]) == 0 then
    return ""
  end
  $pfx = dt_pfx($opts)
  $route = $opts["base_route"]
  $cur = "" .. dt_or($state["group"], "")
  $gid = dt_region_id($opts["id"]) .. "-groupby"
  $h = '<form method="get" action="' .. $route .. '" class="dt-groupby">'
  $h = $h .. dt_hidden_fields($opts, $state, $pfx, "")
  $h = $h .. dt_filter_hidden($opts, $state, $pfx)
  $h = $h .. dt_hide_field($opts, $state, $pfx)
  $h = $h .. '<label class="dt-perpage-label" for="' .. $gid .. '">Group by</label>'
  $h = $h .. '<select id="' .. $gid .. '" name="' .. $pfx .. 'group" class="dt-perpage-select" data-dt-autosubmit aria-label="Group by">'
  $h = $h .. '<option value="">No grouping</option>'
  for each $g in $opts["groups"]
    $sel = ""
    if ("" .. $g["key"]) == $cur then
      $sel = " selected"
    end
    $h = $h .. '<option value="' .. esc("" .. $g["key"]) .. '"' .. $sel .. '>' .. esc("" .. $g["label"]) .. '</option>'
  end
  $h = $h .. '</select>'
  $h = $h .. '<button type="submit" class="dt-perpage-go">Go</button>'
  $h = $h .. '</form>'
  $h = $h .. dt_skin_script()
  return $h
end

-- Skinned pager: amber numbered boxes (reusing dt_page_num's markup) bracketed by
-- ‹ prev / › next and « first / » last extreme links. Single page → no chrome.
function dt_pager_skin($opts, $state, $total)
  $limit = $state["limit"]
  $page = $state["page"]
  $pages = dt_ceil($total / $limit)
  if $pages <= 1 then
    return ""
  end
  if $opts["simple"] == true then
    return dt_pager_simple($opts, $state, $pages, true)
  end
  $h = '<nav class="datatable-pagination-bar" aria-label="Pagination"><ul class="datatable-page-list">'
  if $page > 1 then
    $h = $h .. '<li><a class="dt-page-extreme" rel="first" aria-label="First page" href="' .. dt_page_href($opts, $state, 1) .. '">' .. dt_icon("chevrons-left") .. '</a></li>'
    $h = $h .. '<li><a class="dt-page-extreme" rel="prev" aria-label="Previous page" href="' .. dt_page_href($opts, $state, $page - 1) .. '">' .. dt_icon("chevron-left") .. '</a></li>'
  end
  $w = $opts["window"]
  $lo = $page - $w
  if $lo < 1 then
    $lo = 1
  end
  $hi = $page + $w
  if $hi > $pages then
    $hi = $pages
  end
  if $lo > 1 then
    $h = $h .. dt_page_num($opts, $state, 1)
    if $lo > 2 then
      $h = $h .. '<li><span class="dt-ellipsis" aria-hidden="true">…</span></li>'
    end
  end
  $n = $lo
  while $n <= $hi
    $h = $h .. dt_page_num($opts, $state, $n)
    $n = $n + 1
  end
  if $hi < $pages then
    if $hi < ($pages - 1) then
      $h = $h .. '<li><span class="dt-ellipsis" aria-hidden="true">…</span></li>'
    end
    $h = $h .. dt_page_num($opts, $state, $pages)
  end
  if $page < $pages then
    $h = $h .. '<li><a class="dt-page-extreme" rel="next" aria-label="Next page" href="' .. dt_page_href($opts, $state, $page + 1) .. '">' .. dt_icon("chevron-right") .. '</a></li>'
    $h = $h .. '<li><a class="dt-page-extreme" rel="last" aria-label="Last page" href="' .. dt_page_href($opts, $state, $pages) .. '">' .. dt_icon("chevrons-right") .. '</a></li>'
  end
  $h = $h .. '</ul></nav>'
  return $h
end

-- Inline PE for the skin: auto-submit any [data-dt-autosubmit] <select> on change
-- (requestSubmit so the boost shim catches it as a region partial; .submit()
-- fallback = a full nav, still correct) and hide its no-JS "Go" button. Wired
-- once per element (dtWired flag), idempotent across SPA swaps. CSP allows inline.
function dt_skin_script()
  $s = '<script>(function(){'
  $s = $s .. 'document.querySelectorAll("select[data-dt-autosubmit]").forEach(function(s){'
  $s = $s .. 'if(s.dataset.dtWired)return;s.dataset.dtWired="1";'
  $s = $s .. 's.addEventListener("change",function(){var f=s.form;if(!f)return;if(f.requestSubmit){f.requestSubmit();}else{f.submit();}});'
  $s = $s .. 'var go=s.form&&s.form.querySelector(".dt-perpage-go");if(go){go.style.display="none";}'
  $s = $s .. '});})();</script>'
  return $s
end

-- ═══════════════════════ filter funnel UI (Phase 2) ═══════════════════════
-- Lane B (S-10): a native <details> popover whose panel is a real GET <form>, so
-- "Apply" submits + boosts to a region partial even with JS off; inline JS only adds
-- click-away/ESC. Every control is single-choice (a <select> of allowlisted values
-- or a text input) — multi-value selection is URL/agent-level this commit (a native
-- multiple <select> serialises as repeated params, which parse_query collapses
-- last-wins; a checkbox-group control is a follow-up). All emission is gated on a
-- non-empty opts.filters, so a table with no filters is byte-identical.

-- The icon-button bar emitted by dt_render after the search form: the standalone
-- filter funnel (only when it is NOT already inside the skin search toolbar) + the
-- column-visibility manager + the active-filter chips. Returns "" when the table has
-- neither filters nor toggleable columns → byte-identical for the unchanged pages.
function dt_filter_bar($spec, $opts, $state)
  $skin = ($opts["skin"] == true)
  $has_filters = ($opts["filters"] != nil and length($opts["filters"]) > 0)
  $has_groups = ($opts["groups"] != nil and length($opts["groups"]) > 0)
  -- the funnel already sits inside the skin search toolbar when search is on; here we
  -- only emit it standalone (search off, or a non-skin table).
  -- live_search → funnel renders standalone here (so it's inside the #dt-results slot and a
  -- search swap re-syncs its q); else it rides inside the search toolbar (dt_toolbar_band).
  $funnel_in_search = ($skin and $opts["search"] == true and $has_filters and $opts["live_search"] != true)
  $icons = ""
  -- the Group-by select (Phase 4b) leads the toolbar-right controls; "" when no groups.
  if $has_groups then
    $icons = $icons .. dt_group_select($opts, $state)
  end
  if $has_filters and not $funnel_in_search then
    $icons = $icons .. dt_filter_pop($opts, $state)
  end
  if dt_has_toggleable($spec) then
    $icons = $icons .. dt_col_manager($spec, $opts, $state)
  end
  $h = ""
  if $icons != "" then
    if $skin then
      $h = '<div class="dt-toolbar"><div class="dt-toolbar-right">' .. $icons .. '</div></div>'
    else
      $h = $icons
    end
  end
  if $has_filters then
    $h = $h .. dt_filter_chips($opts, $state)
  end
  return $h
end

-- True when any spec column is user-toggleable (gates the column manager).
function dt_has_toggleable($spec)
  for each $c in $spec
    if $c["toggleable"] then
      return true
    end
  end
  return false
end

-- The ?hide= value with one column's key flipped (added when currently visible,
-- removed when hidden), rebuilt in spec order so the URL stays canonical.
-- Is there a managed-hide sentinel for this spec/viewer? TRUE when a default_hidden column is
-- actually offered to this viewer (toggleable, not spec-hidden, rank-visible) — the SINGLE
-- predicate dt_state_from_map (seeding) and dt_hide_toggle (link building) MUST share, so the
-- canonical hide_raw they each emit can't diverge (e.g. for a future default_hidden+min_rank col).
function dt_has_default_hidden($spec, $vrank)
  for each $c in $spec
    if $c["default_hidden"] and $c["toggleable"] and not $c["hidden"] and dt_rank_ok($c, $vrank) then
      return true
    end
  end
  return false
end

function dt_hide_toggle($spec, $state, $key)
  $keys = []
  $has_dh = dt_has_default_hidden($spec, $state["viewer_rank"])
  for each $c in $spec
    if $c["toggleable"] then
      $is_hidden = ($state["hide"][$c["key"]] == true)
      $flip = ($c["key"] == $key)
      if ($is_hidden and not $flip) or (not $is_hidden and $flip) then
        push($keys, $c["key"])
      end
    end
  end
  -- mirror dt_state's canonical form: with default_hidden columns, carry the "~" managed
  -- sentinel so an empty result (showing every default-hidden column) still round-trips as
  -- a non-dropped param. Byte-identical (plain list) when there are no default_hidden cols.
  if $has_dh then
    -- SINGLE-quoted '~' (a double-quoted "~" expands to $HOME in Mix). See dt_state.
    if length($keys) == 0 then
      return '~'
    end
    return '~,' .. join($keys, ",")
  end
  return join($keys, ",")
end

-- The column-visibility manager: a <details> popover (Lane A — pure toggle LINKS, so
-- it is fully no-JS-correct; the shared click-away script also closes .dt-col-toggle).
-- Each TOGGLEABLE, rank-visible, non-spec-hidden column is a link that flips its
-- membership in ?hide= (carrying the full current view state via dt_href). A leading
-- check / box marks current visibility. "" when nothing is toggleable.
function dt_col_manager($spec, $opts, $state)
  $route = $opts["base_route"]
  $vrank = $opts["viewer_rank"]
  $items = ""
  for each $c in $spec
    if $c["toggleable"] and dt_rank_ok($c, $vrank) and not $c["hidden"] then
      $visible = not ($state["hide"][$c["key"]] == true)
      $newhide = dt_hide_toggle($spec, $state, $c["key"])
      -- preserve the page: toggling a display-only column doesn't change the row set,
      -- so don't bounce the viewer back to page 1.
      $href = dt_href($route, { sort: $state["sort"], dir: $state["dir"], q: $state["q"], box: $state["box"], size: $state["size"], filters: $state["filters_raw"], hide: $newhide, group: $state["group"], page: $state["page"] }, $opts)
      $mark = '<span class="dt-col-box" aria-hidden="true"></span>'
      $cls = "dt-col-item"
      if $visible then
        $mark = dt_icon("check")
        $cls = "dt-col-item dt-col-on"
      end
      $items = $items .. '<a class="' .. $cls .. '" href="' .. $href .. '" role="menuitemcheckbox" aria-checked="' .. ("" .. $visible) .. '">' .. $mark .. esc("" .. $c["label"]) .. '</a>'
    end
  end
  if $items == "" then
    return ""
  end
  $h = '<details class="dt-col-toggle">'
  $h = $h .. '<summary class="dt-iconbtn" aria-label="Toggle columns" title="Columns">' .. dt_icon("columns") .. '</summary>'
  $h = $h .. '<div class="dt-col-panel" role="menu">' .. $items .. '</div></details>'
  $h = $h .. dt_filter_script()
  return $h
end

-- The funnel: an icon button carrying an active-count badge that toggles a <details>
-- popover. The panel is a GET <form> of the filter controls + Apply; a Reset link
-- (when any filter is active) clears all filters while preserving sort/dir/q/box/size.
-- Hidden fields preserve the OTHER view state; the filters are the visible controls.
function dt_filter_pop($opts, $state)
  if $opts["filters"] == nil or length($opts["filters"]) == 0 then
    return ""
  end
  $pfx = dt_pfx($opts)
  $route = $opts["base_route"]
  $active = length($state["filter_order"])
  $badge = ""
  if $active > 0 then
    $badge = '<span class="dt-badge-count">' .. ("" .. $active) .. '</span>'
  end
  $h = '<details class="dt-filter-pop">'
  $h = $h .. '<summary class="dt-iconbtn" aria-label="Filters" title="Filters">' .. dt_icon("funnel") .. $badge .. '</summary>'
  $h = $h .. '<div class="dt-filter-panel">'
  $h = $h .. '<div class="dt-filter-head"><strong>Filters</strong>'
  if $active > 0 then
    $reset = dt_href($route, { sort: $state["sort"], dir: $state["dir"], q: $state["q"], box: $state["box"], size: $state["size"], hide: $state["hide_raw"], group: $state["group"] }, $opts)
    $h = $h .. '<a class="dt-filter-reset" href="' .. $reset .. '">Reset</a>'
  end
  $h = $h .. '</div>'
  $h = $h .. '<form method="get" action="' .. $route .. '">'
  -- preserve every OTHER view-state param as hidden; the filters are the visible
  -- controls. skip="" → dt_hidden_fields emits sort/dir/box/size/q (none skipped).
  $h = $h .. dt_hidden_fields($opts, $state, $pfx, "")
  $h = $h .. dt_hide_field($opts, $state, $pfx)
  $h = $h .. dt_group_field($opts, $state, $pfx)
  for each $f in $opts["filters"]
    $h = $h .. dt_filter_control($f, $state, $pfx)
  end
  $h = $h .. '<div class="dt-filter-apply"><button class="btn btn-primary" type="submit">Apply</button></div>'
  $h = $h .. '</form></div></details>'
  $h = $h .. dt_filter_script()
  if dt_has_multi($opts) then
    $h = $h .. dt_multi_script()
  end
  return $h
end

-- One filter control in the popover: a text <input> (text), a checkbox group
-- (select + multiple), or a labelled <select> (select single / boolean / ternary).
-- The current selection is marked from filters_raw.
function dt_filter_control($f, $state, $pfx)
  $nm = "" .. $f["name"]
  $cur = $state["filters_raw"][$nm]
  if $cur == nil then
    $cur = ""
  else
    $cur = "" .. $cur
  end
  $field = $pfx .. "filter." .. $nm
  $h = '<div class="dt-filter-field"><label for="' .. esc($field) .. '">' .. esc("" .. $f["label"]) .. '</label>'
  $kind = "" .. $f["kind"]
  if $kind == "text" then
    $h = $h .. '<input id="' .. esc($field) .. '" name="' .. esc($field) .. '" value="' .. esc($cur) .. '" placeholder="' .. esc("" .. $f["placeholder"]) .. '" type="search">'
  else
    if $kind == "daterange" then
      $h = $h .. dt_filter_daterange($f, $cur, $field)
    else
      if $kind == "select" and $f["multiple"] == true then
        $h = $h .. dt_filter_checks($f, $cur, $field)
      else
        $h = $h .. '<select id="' .. esc($field) .. '" name="' .. esc($field) .. '">'
        $h = $h .. dt_filter_options($f, $cur)
        $h = $h .. '</select>'
      end
    end
  end
  $h = $h .. '</div>'
  return $h
end

-- Two native <input type="date"> bounds for a daterange filter. They submit their own
-- ?filter.<name>.from / .to params — fully no-JS-correct (no JS join needed). The
-- current bounds come from the canonical "from..to" value. The label associates with
-- the `from` input (id=$field).
function dt_filter_daterange($f, $cur, $field)
  $ft = split("" .. $cur, "..")
  $from = ""
  $to = ""
  if length($ft) >= 1 then
    $from = trim("" .. $ft[0])
  end
  if length($ft) >= 2 then
    $to = trim("" .. $ft[1])
  end
  $lab = esc("" .. $f["label"])
  $h = '<div class="dt-daterange">'
  $h = $h .. '<input id="' .. esc($field) .. '" type="date" name="' .. esc($field .. ".from") .. '" value="' .. esc($from) .. '" aria-label="' .. $lab .. ' from">'
  $h = $h .. '<span class="dt-daterange-sep" aria-hidden="true">→</span>'
  $h = $h .. '<input type="date" name="' .. esc($field .. ".to") .. '" value="' .. esc($to) .. '" aria-label="' .. $lab .. ' to">'
  $h = $h .. '</div>'
  return $h
end

-- A checkbox group for a multiple-select filter. Each option is a checkbox named for
-- the filter field; the data-dt-multi attr lets dt_multi_script JOIN the checked
-- values into ONE comma `filter.<name>` value on submit (matching the engine's comma
-- grammar). NO-JS degrades to a single value: the repeated-name checkboxes submit as
-- repeated params, which parse_query collapses last-wins — so you filter by one value
-- without JS, by several with it (a graceful reduction, not a broken baseline).
function dt_filter_checks($f, $cur, $field)
  $sel = {}
  for each $tok in split("" .. $cur, ",")
    $tt = trim("" .. $tok)
    if $tt != "" then
      $sel[$tt] = true
    end
  end
  $h = '<div class="dt-filter-checks" data-dt-multi="' .. esc($field) .. '">'
  for each $o in $f["options"]
    $ov = "" .. $o["value"]
    $chk = ""
    if $sel[$ov] == true then
      $chk = " checked"
    end
    $h = $h .. '<label class="dt-check"><input type="checkbox" name="' .. esc($field) .. '" value="' .. esc($ov) .. '"' .. $chk .. '> ' .. esc("" .. dt_or($o["label"], $ov)) .. '</label>'
  end
  $h = $h .. '</div>'
  return $h
end

-- True when any of the table's filters is a multiple-select (gates dt_multi_script).
function dt_has_multi($opts)
  if $opts["filters"] == nil then
    return false
  end
  for each $f in $opts["filters"]
    if ("" .. $f["kind"]) == "select" and $f["multiple"] == true then
      return true
    end
  end
  return false
end

-- Inline PE for multiple-select filters: ONE capture-phase submit listener (window-flag
-- idempotent across SPA swaps) that, for each [data-dt-multi] checkbox group in the
-- submitting form, disables the checkboxes and appends a single hidden input carrying
-- the comma-joined checked values — so the URL becomes ?filter.<name>=a,b (the engine's
-- grammar) instead of repeated last-wins params. CSP allows inline.
function dt_multi_script()
  $s = '<script>(function(){'
  $s = $s .. 'if(window.__dtMultiWired)return;window.__dtMultiWired=1;'
  $s = $s .. 'document.addEventListener("submit",function(e){'
  $s = $s .. 'var f=e.target;if(!f||!f.querySelectorAll)return;'
  $s = $s .. 'f.querySelectorAll("[data-dt-multi]").forEach(function(g){'
  $s = $s .. 'var name=g.getAttribute("data-dt-multi"),vals=[];'
  $s = $s .. 'g.querySelectorAll("input[type=checkbox]").forEach(function(c){if(c.checked)vals.push(c.value);c.disabled=true;});'
  -- reuse ONE hidden input per group (stored on the group node) so a re-submit before
  -- an SPA swap updates it rather than appending a duplicate filter.<name> param.
  $s = $s .. 'var h=g.__dtH;if(!h){h=document.createElement("input");h.type="hidden";h.name=name;g.__dtH=h;f.appendChild(h);}'
  $s = $s .. 'h.value=vals.join(",");'
  $s = $s .. '});},true);'
  $s = $s .. '})();</script>'
  return $s
end

-- <option> tags for a select/boolean/ternary control: a leading "All" (the unset
-- state, value "") + each allowlisted choice, the current one marked selected.
function dt_filter_options($f, $cur)
  $kind = "" .. $f["kind"]
  $h = dt_opt_tag("", "All", $cur)
  if $kind == "select" then
    for each $o in $f["options"]
      $h = $h .. dt_opt_tag("" .. $o["value"], "" .. dt_or($o["label"], $o["value"]), $cur)
    end
    return $h
  end
  if $kind == "boolean" then
    $h = $h .. dt_opt_tag("1", "" .. dt_or($f["true_label"], "Yes"), $cur)
    return $h
  end
  if $kind == "ternary" then
    $h = $h .. dt_opt_tag("1", "" .. dt_or($f["true_label"], "Yes"), $cur)
    $h = $h .. dt_opt_tag("0", "" .. dt_or($f["false_label"], "No"), $cur)
    return $h
  end
  return $h
end

function dt_opt_tag($value, $label, $cur)
  $sel = ""
  if $value == $cur then
    $sel = " selected"
  end
  return '<option value="' .. esc($value) .. '"' .. $sel .. '>' .. esc($label) .. '</option>'
end

-- Active-filter chips: one removable pill per active filter, each linking to the
-- current view MINUS that one filter (dt_filters_without drops its key). "" when no
-- filter is active.
function dt_filter_chips($opts, $state)
  if length($state["filter_order"]) == 0 then
    return ""
  end
  $h = '<div class="dt-filter-chips">'
  for each $nm in $state["filter_order"]
    $rf = $state["filters"][$nm]
    $minus = dt_filters_without($state["filters_raw"], $nm)
    $href = dt_href($opts["base_route"], { sort: $state["sort"], dir: $state["dir"], q: $state["q"], box: $state["box"], size: $state["size"], filters: $minus, hide: $state["hide_raw"], group: $state["group"] }, $opts)
    $h = $h .. '<a class="dt-filter-chip" href="' .. $href .. '" aria-label="Remove filter ' .. esc("" .. $rf["label"]) .. '">' .. esc("" .. $rf["label"]) .. ' ' .. dt_icon("x") .. '</a>'
  end
  $h = $h .. '</div>'
  return $h
end

-- A copy of the filters_raw map without one key (the "remove this filter" link).
function dt_filters_without($raw, $skip)
  $out = {}
  for each $k in keys($raw)
    if $k != $skip then
      $out[$k] = $raw[$k]
    end
  end
  return $out
end

-- Hidden inputs carrying the ACTIVE filter tokens, for the OTHER forms (search box,
-- per-page select) so submitting them preserves the filters. The funnel popover owns
-- the VISIBLE filter controls and does NOT use this. Spec order, after q (matching
-- dt_href). "" when the table declares no filters → byte-identical for the search box.
function dt_filter_hidden($opts, $state, $pfx)
  $h = ""
  if $opts["filters"] == nil then
    return $h
  end
  for each $f in $opts["filters"]
    $nm = "" .. $f["name"]
    $val = $state["filters_raw"][$nm]
    if $val != nil and ("" .. $val) != "" then
      for each $pr in dt_filter_param_pairs($f, $val)
        $h = $h .. '<input type="hidden" name="' .. esc($pfx .. "filter." .. $nm .. $pr["suffix"]) .. '" value="' .. esc($pr["value"]) .. '">'
      end
    end
  end
  return $h
end

-- A single hidden input carrying the active ?hide= value, for the OTHER forms (search
-- box, per-page select, funnel) so submitting them preserves the column-visibility
-- choice (the column manager owns the toggle LINKS). "" when nothing is hidden →
-- byte-identical for a table with no toggleable columns.
function dt_hide_field($opts, $state, $pfx)
  if $state["hide_raw"] == nil or ("" .. $state["hide_raw"]) == "" then
    return ""
  end
  return '<input type="hidden" name="' .. esc($pfx .. "hide") .. '" value="' .. esc("" .. $state["hide_raw"]) .. '">'
end

-- A single hidden input carrying the active ?group= value, for the OTHER forms (search
-- box, per-page select, funnel) so submitting them preserves the grouping (the Group-by
-- select owns the visible control). Emitted AFTER dt_hide_field so the form's field order
-- matches dt_href's (…hide, group), keeping a form submit + a link byte-identical. ""
-- when no group is active → byte-identical for a table without grouping.
function dt_group_field($opts, $state, $pfx)
  if dt_or($state["group"], "") == "" then
    return ""
  end
  return '<input type="hidden" name="' .. esc($pfx .. "group") .. '" value="' .. esc("" .. $state["group"]) .. '">'
end

-- Inline PE for the funnel + column manager: ONE document-level pair of listeners
-- (window-flag idempotent across SPA swaps) that close any open .dt-filter-pop /
-- .dt-col-toggle on a click outside it or on Escape. The no-JS baseline is fully
-- correct without this — the <details> still toggles, "Apply" still submits, and the
-- column toggle LINKS still navigate. CSP allows inline.
function dt_filter_script()
  $s = '<script>(function(){'
  $s = $s .. 'if(window.__dtFilterWired)return;window.__dtFilterWired=1;'
  $s = $s .. 'var sel="details.dt-filter-pop[open],details.dt-col-toggle[open],details.dt-row-menu[open],details.dt-groupby-pop[open]";'
  $s = $s .. 'document.addEventListener("click",function(e){'
  $s = $s .. 'document.querySelectorAll(sel).forEach(function(d){if(!d.contains(e.target))d.removeAttribute("open");});});'
  $s = $s .. 'document.addEventListener("keydown",function(e){if(e.key==="Escape"){document.querySelectorAll(sel).forEach(function(d){d.removeAttribute("open");});}});'
  $s = $s .. '})();</script>'
  return $s
end

-- Inline PE for real-time search (opts.live_search). ONE document-level `input` listener
-- (window-flag idempotent across SPA swaps): for a [data-dt-live] search field, debounce
-- by its data-dt-live ms (~250) then submit the field's form. It sets f.__boostReplace so
-- the shim REPLACES history (no per-keystroke Back spam) and uses the boosted region-swap
-- path — which aborts the in-flight request, discards superseded responses, and (now)
-- restores the field's value+caret across the swap, so typing is never disturbed. No-JS
-- (or JS that never fires this) keeps the Search-button baseline. CSP allows inline.
function dt_search_script()
  $s = '<script>(function(){'
  $s = $s .. 'if(window.__dtLiveWired)return;window.__dtLiveWired=1;'
  $s = $s .. 'var T;'
  $s = $s .. 'document.addEventListener("input",function(e){'
  $s = $s .. 'var i=e.target;if(!i||!i.matches||!i.matches("[data-dt-live]"))return;'
  -- show the in-input × only while there's text (the button sits next to the input in
  -- .dt-search-wrap).
  $s = $s .. 'var clr=i.parentNode&&i.parentNode.querySelector(".dt-search-clear");if(clr)clr.hidden=!i.value;'
  -- capture the input ID (not the element/form): a region swap that lands while the user
  -- keeps typing replaces the input + form, so at fire time we RE-FIND the current input by
  -- its stable id and submit THAT (the old captured form would be detached → its submit
  -- never reaches the document listener → a lost query). Instance-correct (each table's
  -- input has its own id).
  $s = $s .. 'var id=i.id,d=parseInt(i.getAttribute("data-dt-live"),10)||250;'
  $s = $s .. 'clearTimeout(T);T=setTimeout(function(){'
  $s = $s .. 'var cur=(id&&document.getElementById(id))||null,f=cur&&cur.form;'
  $s = $s .. 'if(f&&f.requestSubmit){f.__boostReplace=true;f.requestSubmit();}'
  $s = $s .. '},d);'
  $s = $s .. '});'
  -- a manual submit (Enter / Search button) while a debounce is pending cancels it, so the
  -- live timer can't fire right after and replace the manual push-history entry. (On a live
  -- submit T has already fired → this clear is a harmless no-op.)
  $s = $s .. 'document.addEventListener("submit",function(){clearTimeout(T);});'
  -- the in-input × clears the field + submits IMMEDIATELY (no debounce wait — it's an
  -- explicit action) so the full set returns at once; __boostReplace keeps it off the Back
  -- stack. The submit listener above clears any pending debounce.
  $s = $s .. 'document.addEventListener("click",function(e){'
  $s = $s .. 'var c=e.target.closest&&e.target.closest(".dt-search-clear");if(!c)return;'
  $s = $s .. 'e.preventDefault();var w=c.parentNode,i=w&&w.querySelector("[data-dt-live]");if(!i)return;'
  $s = $s .. 'i.value="";c.hidden=true;i.focus();'
  $s = $s .. 'var f=i.form;if(f&&f.requestSubmit){f.__boostReplace=true;f.requestSubmit();}'
  $s = $s .. '});'
  $s = $s .. '})();</script>'
  return $s
end

-- Empty-state card: distinguishes a page past the end (total>0) from a genuinely
-- empty set, and a no-match search from a never-populated table.
function dt_empty($opts, $state, $total)
  $route = $opts["base_route"]
  if $total > 0 then
    return '<div class="card datatable-empty-state"><p class="muted">Nothing on this page. <a href="' .. $route .. '">Back to the start</a>.</p></div>'
  end
  $noun = esc($opts["noun"])
  if $state["q"] != "" then
    return '<div class="card datatable-empty-state"><p class="muted">No ' .. $noun .. ' match “' .. esc($state["q"]) .. '”.</p></div>'
  end
  return '<div class="card datatable-empty-state"><p class="muted">No ' .. $noun .. ' yet.</p></div>'
end
