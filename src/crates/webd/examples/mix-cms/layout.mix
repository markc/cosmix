-- layout.mix — shared page chrome for the mix-CMS example.
--
-- `include "layout.mix"` from a handler to reuse this wrapper across
-- pages (the layout/partials pattern). The embed resolves the include
-- relative to the calling handler's directory (under the vhost
-- www_dir), so co-located handlers share one lib — no copy/paste.

-- Wrap body HTML in a complete document with an escaped <title>.
function page($title, $body)
  return "<!doctype html>\n<meta charset=\"utf-8\"><title>" .. html_escape($title) .. "</title>\n" .. $body
end
