-- variables.mix: test variable assignment and types
-- Expected output:
-- hello
-- 42
-- 3.14
-- true
-- false
-- nil
-- string
-- number
-- bool
-- nil
-- 10
-- hello world

$s = "hello"
$n = 42
$f = 3.14
$t = true
$b = false
$x = nil

print $s
print $n
print $f
print $t
print $b
print $x

print type($s)
print type($n)
print type($t)
print type($x)

-- arithmetic with coercion
$a = "7"
$result = $a + 3
print $result

-- string concat with +
$greeting = "hello" + " " + "world"
print $greeting
