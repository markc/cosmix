-- deep_eq.mix: structural equality (0.63.0) — maps order-independent,
-- lists order-sensitive, scalars agree with == (so functions are never
-- equal, even to themselves), adversarial nesting raises catchably,
-- and the == contrast — which since 0.68.0 RAISES on maps/lists rather
-- than answering false (the A.1 flip landed).
-- Expected output:
-- true
-- true
-- true
-- false
-- false
-- false
-- false
-- true
-- true
-- true
-- false
-- TYPE_ERROR
-- false
-- deep-eq-depth-raises

$a = {x: 1, l: [1, {y: 2}]}
$b = $a
print(deep_eq($a, $b))
print(deep_eq({x: 1, l: [1, {y: 2}]}, {l: [1, {y: 2}], x: 1}))
print(deep_eq([1, 2], [1, 2]))
print(deep_eq([1, 2], [2, 1]))
print(deep_eq({a: 1}, {a: 2}))
print(deep_eq({a: 1}, {a: 1, b: 2}))
print(deep_eq([], {}))
print(deep_eq("5", 5))
print(deep_eq(nil, nil))
print(deep_eq([{deep: [1, [2]]}], [{deep: [1, [2]]}]))
print(deep_eq([{deep: [1, [2]]}], [{deep: [1, [3]]}]))
-- contrast: `==` on maps/lists RAISES since 0.68.0 (the A.1 flip landed).
-- Until then this printed `false` — a constant dressed as a comparison,
-- which is exactly what deep_eq exists to replace.
try
  print($a == $b)
catch $msg, $err
  print($err.code)
end
-- inherited == corners (GLM review MINOR 2): a function value is never
-- equal, even to itself — a callback-bearing map is not deep_eq itself.
$h = {on: fn() = 1}
print(deep_eq($h, $h))
-- adversarial nesting raises catchably instead of aborting (depth cap)
$deepv = []
for $i = 1 to 600
  $deepv = [$deepv]
end
try
  deep_eq($deepv, $deepv)
catch $e
  print "deep-eq-depth-raises"
end
