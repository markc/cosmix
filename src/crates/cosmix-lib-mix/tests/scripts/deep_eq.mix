-- deep_eq.mix: structural equality (0.63.0) — maps order-independent,
-- lists order-sensitive, scalars agree with ==, and the == contrast
-- (always false on maps/lists) pinned until the A.1 flip.
-- Expected output:
-- true
-- true
-- true
-- false
-- false
-- false
-- false
-- true
-- true
-- true
-- false
-- false

$a = {x: 1, l: [1, {y: 2}]}
$b = $a
print(deep_eq($a, $b))
print(deep_eq({x: 1, l: [1, {y: 2}]}, {l: [1, {y: 2}], x: 1}))
print(deep_eq([1, 2], [1, 2]))
print(deep_eq([1, 2], [2, 1]))
print(deep_eq({a: 1}, {a: 2}))
print(deep_eq({a: 1}, {a: 1, b: 2}))
print(deep_eq([], {}))
print(deep_eq("5", 5))
print(deep_eq(nil, nil))
print(deep_eq([{deep: [1, [2]]}], [{deep: [1, [2]]}]))
print(deep_eq([{deep: [1, [2]]}], [{deep: [1, [3]]}]))
-- contrast: == on the same map is still always false today (flips in A.1)
print($a == $b)
