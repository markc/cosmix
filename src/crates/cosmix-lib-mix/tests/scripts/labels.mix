-- Expected output:
-- found at 1
-- inner 1
-- inner 1
-- inner 1
-- done
-- loop break at 2
-- while 1
-- while 1
-- while 1

-- Test 1: break with label on counted for
$result = ""
for $i = 1 to 5 label outer
    for $j = 1 to 5
        if $j == 3 then
            $result = $i
            break outer
        end
    next
next
print "found at ${result}"

-- Test 2: continue with label on for-each
for $i = 1 to 3 label outer
    for $j = 1 to 3
        continue outer if $j == 2
        print "inner ${j}"
    next
next
print "done"

-- Test 3: break label on loop
$count = 0
loop label outer
    $count = $count + 1
    loop
        break outer if $count == 2
        break
    done
done
print "loop break at ${count}"

-- Test 4: continue label on while
$x = 0
while $x < 3 label outer
    $x = $x + 1
    for $k = 1 to 3
        continue outer if $k == 2
        print "while ${k}"
    next
done
