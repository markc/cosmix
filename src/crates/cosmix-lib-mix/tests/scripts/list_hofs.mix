-- list_hofs.mix: Phase 2 higher-order list helpers
-- Expected output:
-- [2, 4, 6, 8, 10]
-- [1, 3, 5]
-- 15
-- [1, 1, 2, 3, 4, 5]
-- [5, 4, 3, 2, 1]
-- true
-- false
-- true
-- false
-- 3
-- bob
-- eve
-- 85
-- eve
-- {false: [1, 3, 5], true: [2, 4]}
-- [apple, banana, cherry]

$xs = [1, 2, 3, 4, 5]

-- map
print map($xs, function($x) = $x * 2)

-- filter (keep odd)
print filter($xs, function($x) = $x % 2 == 1)

-- reduce (sum)
print reduce($xs, 0, function($acc, $x) = $acc + $x)

-- sort_by ascending
print sort_by([3, 1, 4, 1, 5, 2], function($x) = $x)

-- sort_by descending
print sort_by([1, 2, 3, 4, 5], function($x) = 0 - $x)

-- any (has even)
print any($xs, function($x) = $x % 2 == 0)

-- any (has > 100)
print any($xs, function($x) = $x > 100)

-- all (all positive)
print all($xs, function($x) = $x > 0)

-- all (all even)
print all($xs, function($x) = $x % 2 == 0)

-- count (evens is 2, odds is 3)
print count($xs, function($x) = $x % 2 == 1)

-- min_by / max_by: return the ITEM with min/max key
$users = [
    {name: "alice", score: 72},
    {name: "bob", score: 41},
    {name: "eve", score: 85}
]
print min_by($users, function($u) = $u.score).name
print max_by($users, function($u) = $u.score).name
print sum_by($users, function($u) = $u.score) - 113

-- sort_by on maps: top-N pattern (this is the digest acceptance test)
$top1 = sort_by($users, function($u) = 0 - $u.score)[0]
print $top1.name

-- group_by: split evens and odds (bool keys stringified)
print group_by($xs, function($x) = $x % 2 == 0)

-- unique_by: dedup by first character
$words = ["apple", "ant", "banana", "bat", "cherry"]
print unique_by($words, function($w) = $w[0])
