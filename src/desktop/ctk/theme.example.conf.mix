-- Cosmix theme (strict-data .conf.mix) — copy to one of:
--   ~/.config/cosmix/theme.conf.mix        (desktop-wide: every cosmix app)
--   <app config dir>/theme.conf.mix        (per-app override of the above)
--
-- Resolution cascade: built-in Ocean-light  ←  shared  ←  per-app.
-- A missing or malformed file is skipped, never fatal.
--
-- The palette model is shared verbatim with the web design system
-- (dcs.spa / webd site.css): a scheme is a hue; only the accent's L/C is
-- materially per-scheme. See
-- _decisions/2026-07-22-cosmix-visual-identity-own-palette.md (in cmctl).

-- Pick a scheme + mode (the common case — matches the web setScheme/setTheme).
-- scheme: ocean | crimson | stone | forest | sunset | mono
-- mode:   light | dark
scheme: "ocean"
mode: "dark"

-- Optional per-token #rrggbb hex overrides, applied ON TOP of the scheme.
-- Uncomment to tweak individual console tokens; unset tokens keep the scheme.
-- These colours hot-swap for legacy UiTheme-token consumers. CtkButton does
-- not read these token overrides: its colours and metrics come from the
-- embedded revision-1 compiled design (or an in-memory complete-source
-- replacement). On-disk design sections are not read yet.
--
-- surface:        "#0b0d17"   -- window background
-- panel:          "#141726"   -- strip panel
-- master_panel:   "#1a1829"   -- master strip panel
-- track:          "#070812"   -- fader/meter well
-- control:        "#2a2d45"   -- resting control body
-- control_active: "#8b8fe6"   -- fader fill / lit accent
-- thumb:          "#aab0f0"   -- fader/scrubber thumb
-- meter_green:    "#22c55e"   -- meter healthy   (status; scheme-invariant)
-- meter_amber:    "#f59e0b"   -- meter hot
-- meter_red:      "#ef4444"   -- meter clip
-- text:           "#e6e8f0"   -- primary text
-- text_dim:       "#8b90a6"   -- captions / readouts / footers

-- Legacy non-button layout metrics (pixels). Uncomment to override; relaunch
-- to apply. CtkButton metrics do not come from these fields.
-- control_gap:    8.0
-- corner_radius:  5.0
-- fader_width:    42.0
-- fader_height:   250.0
-- knob_size:      58.0
-- meter_width:    28.0
