            "palette.accent.hover": { color_space: "oklch", l: 0.46, c: 0.18, h: 45.0 }
          }
        }
      },
      {
        when: { scheme: "sunset", mode: "dark" },
        primitives: {
          colors: {
            "palette.background.1": { color_space: "oklch", l: 0.12, c: 0.02, h: 45.0 },
            "palette.background.2": { color_space: "oklch", l: 0.16, c: 0.025, h: 45.0 },
            "palette.background.3": { color_space: "oklch", l: 0.22, c: 0.03, h: 45.0 },
            "palette.foreground.default": { color_space: "oklch", l: 0.95, c: 0.025, h: 45.0 },
            "palette.foreground.muted": { color_space: "oklch", l: 0.61, c: 0.05, h: 45.0 },
            "palette.accent.default": { color_space: "oklch", l: 0.72, c: 0.14, h: 45.0 },
            "palette.accent.hover": { color_space: "oklch", l: 0.82, c: 0.12, h: 45.0 }
          }
        }
      },
      {
        when: { scheme: "mono", mode: "light" },
        primitives: {
          colors: {
            "palette.background.1": { color_space: "oklch", l: 0.98, c: 0.0, h: 0.0 },
            "palette.background.2": { color_space: "oklch", l: 0.96, c: 0.0, h: 0.0 },
            "palette.background.3": { color_space: "oklch", l: 0.92, c: 0.0, h: 0.0 },
            "palette.foreground.default": { color_space: "oklch", l: 0.20, c: 0.0, h: 0.0 },
            "palette.foreground.muted": { color_space: "oklch", l: 0.50, c: 0.0, h: 0.0 },
            "palette.accent.default": { color_space: "oklch", l: 0.25, c: 0.0, h: 0.0 },
