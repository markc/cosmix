                name: "focus_ring",
                args: [
                  { kind: "colour", value: "ring" },
                  { kind: "pair", value: "accent" }
                ]
              }
            }
          },
          {
            when: { variant: "default", interaction: "disabled", focus_visible: true },
            set: { ring: { kind: "null" } }
          },
          {
            when: { variant: "primary", interaction: "disabled", focus_visible: true },
            set: { ring: { kind: "null" } }
          },
          {
            when: { variant: "destructive", interaction: "disabled", focus_visible: true },
            set: { ring: { kind: "null" } }
          },
          {
            when: { variant: "ghost", interaction: "disabled", focus_visible: true },
            set: { ring: { kind: "null" } }
          }
        ]
      }
    },
