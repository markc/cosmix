          }
        }
      },
      {
        when: { scheme: "mono", mode: "dark" },
        primitives: {
          colors: {
            "palette.background.1": { color_space: "oklch", l: 0.10, c: 0.0, h: 0.0 },
            "palette.background.2": { color_space: "oklch", l: 0.15, c: 0.0, h: 0.0 },
            "palette.background.3": { color_space: "oklch", l: 0.22, c: 0.0, h: 0.0 },
            "palette.foreground.default": { color_space: "oklch", l: 0.95, c: 0.0, h: 0.0 },
            "palette.foreground.muted": { color_space: "oklch", l: 0.61, c: 0.0, h: 0.0 },
            "palette.accent.default": { color_space: "oklch", l: 0.85, c: 0.0, h: 0.0 },
            "palette.accent.hover": { color_space: "oklch", l: 0.92, c: 0.0, h: 0.0 }
          }
        }
      },
      {
        when: { mode: "dark" },
        primitives: {
          colors: {
            "status.success": { color_space: "oklch", l: 0.70, c: 0.15, h: 145.0 },
            "status.warning": { color_space: "oklch", l: 0.80, c: 0.15, h: 85.0 },
            "status.danger": { color_space: "oklch", l: 0.70, c: 0.18, h: 25.0 }
          }
        },
        semantics: {
          pairs: {
            muted: {
              surface: "transparent",
              foreground: "palette.foreground.default",
              backdrop: "palette.background.1"
            }
          }
        }
      }
    ],
    semantics: {
      pairs: {
        base: { surface: "palette.background.1", foreground: "palette.foreground.default" },
        card: { surface: "palette.background.1", foreground: "palette.foreground.default" },
        popover: { surface: "palette.background.1", foreground: "palette.foreground.default" },
        primary: {
          derive: {
            name: "selection_pair",
            args: [
              { kind: "colour", value: "palette.accent.default" },
              { kind: "colour", value: "palette.background.2" }
            ]
          }
        },
        secondary: { surface: "palette.background.2", foreground: "palette.foreground.default" },
        muted: {
          surface: "transparent",
          foreground: "palette.foreground.muted",
          backdrop: "palette.background.1"
        },
        accent: {
          derive: {
            name: "control_pair",
            args: [
              { kind: "colour", value: "palette.background.3" },
              { kind: "colour", value: "palette.accent.default" },
              { kind: "colour", value: "palette.background.1" },
              { kind: "colour", value: "palette.foreground.default" }
            ]
          }
        },
        destructive: { surface: "status.danger", foreground: "palette.background.1" }
      },
      non_text: {
        border: { value: "palette.background.3", adjacent: ["secondary"] },
        input: { value: "transparent", adjacent: ["muted"] },
        ring: { value: "palette.accent.default", adjacent: ["accent", "muted", "secondary"] }
      }
    },
    typography: {
      records: {
        "button.md": { family: "Noto Sans", type_step: "type.body", weight: 400 },
        "button.sm": { family: "Noto Sans", type_step: "type.compact", weight: 400 }
      }
    },
    families: {
      button: {
        coverage: "explicit",
        base: {
          pair: { kind: "pair", value: "secondary" },
          border: { kind: "token", value: "border" },
          ring: { kind: "null" },
          height: { kind: "metric", value: "button.height.md" },
          min_width: { kind: "metric", value: "button.min_width.standard" },
          padding_x: { kind: "metric", value: "button.padding_x" },
          border_width: { kind: "metric", value: "button.border_width" },
          radius: { kind: "metric", value: "radius.md" },
          typography: { kind: "typography", value: "button.md" }
        },
        variants: [
          {
            when: { variant: "primary" },
            set: { pair: { kind: "pair", value: "primary" } }
          },
          {
            when: { variant: "destructive" },
            set: { pair: { kind: "pair", value: "destructive" } }
          },
          {
            when: { variant: "ghost" },
            set: {
              pair: { kind: "pair", value: "muted" },
              border: { kind: "token", value: "input" }
            }
          },
          {
            when: { size: "sm" },
            set: {
              height: { kind: "metric", value: "button.height.sm" },
              min_width: { kind: "metric", value: "button.min_width.none" },
              typography: { kind: "typography", value: "button.sm" }
            }
          },
          {
            when: { size: "lg" },
            set: { height: { kind: "metric", value: "button.height.lg" } }
          }
        ],
        states: [
          {
            when: { focus_visible: true },
            set: {
              ring: {
                kind: "derive",
                name: "focus_ring",
                args: [
                  { kind: "colour", value: "ring" },
                  { kind: "pair", value: "secondary" }
                ]
              }
            }
          }
        ],
        compoundVariants: [
          {
            when: { variant: "primary", interaction: "hovered" },
            set: {
              pair: {
                kind: "derive",
                name: "contrast_safe_lift",
                args: [
                  { kind: "pair", value: "primary" },
                  { kind: "ratio", value: "lift.hover" }
                ]
              }
            }
          },
          {
            when: { variant: "default", interaction: "hovered" },
            set: {
              pair: {
                kind: "derive",
                name: "contrast_safe_lift",
                args: [
                  { kind: "pair", value: "secondary" },
                  { kind: "ratio", value: "lift.hover" }
                ]
              }
            }
          },
          {
            when: { variant: "destructive", interaction: "hovered" },
            set: {
              pair: {
                kind: "derive",
                name: "contrast_safe_lift",
                args: [
                  { kind: "pair", value: "destructive" },
                  { kind: "ratio", value: "lift.hover" }
                ]
              }
            }
          },
          {
            when: { variant: "ghost", interaction: "hovered" },
            set: {
              pair: {
                kind: "derive",
                name: "contrast_safe_toward",
                args: [
                  { kind: "pair", value: "accent" },
                  { kind: "ratio", value: "lift.ghost.hover" }
                ]
              }
            }
          },
          {
            when: { variant: "default", interaction: "pressed" },
            set: {
              pair: {
                kind: "derive",
                name: "contrast_safe_toward",
                args: [
                  { kind: "pair", value: "secondary" },
                  { kind: "ratio", value: "lift.press" }
                ]
              }
            }
          },
          {
            when: { variant: "primary", interaction: "pressed" },
            set: {
              pair: {
                kind: "derive",
                name: "contrast_safe_toward",
                args: [
                  { kind: "pair", value: "primary" },
                  { kind: "ratio", value: "lift.press" }
                ]
              }
            }
          },
          {
            when: { variant: "destructive", interaction: "pressed" },
            set: {
              pair: {
                kind: "derive",
                name: "contrast_safe_toward",
                args: [
                  { kind: "pair", value: "destructive" },
                  { kind: "ratio", value: "lift.press" }
                ]
              }
            }
          },
          {
            when: { variant: "ghost", interaction: "pressed" },
            set: {
              pair: {
                kind: "derive",
                name: "contrast_safe_toward",
                args: [
                  { kind: "pair", value: "accent" },
                  { kind: "ratio", value: "lift.ghost.press" }
                ]
              }
            }
          },
          {
            when: { variant: "default", interaction: "disabled" },
            set: {
              pair: {
                kind: "derive",
                name: "disabled_pair",
                args: [
                  { kind: "pair", value: "secondary" },
                  { kind: "ratio", value: "lift.disabled" },
                  { kind: "ratio", value: "disabled.chroma_reduction" }
                ]
              }
            }
          },
          {
            when: { variant: "primary", interaction: "disabled" },
            set: {
              pair: {
                kind: "derive",
                name: "disabled_pair",
                args: [
                  { kind: "pair", value: "primary" },
                  { kind: "ratio", value: "lift.disabled" },
                  { kind: "ratio", value: "disabled.chroma_reduction" }
                ]
              }
            }
          },
          {
            when: { variant: "destructive", interaction: "disabled" },
            set: {
              pair: {
                kind: "derive",
                name: "disabled_pair",
                args: [
                  { kind: "pair", value: "destructive" },
                  { kind: "ratio", value: "lift.disabled" },
                  { kind: "ratio", value: "disabled.chroma_reduction" }
                ]
              }
            }
          },
          {
            when: { variant: "ghost", interaction: "disabled" },
            set: {
              pair: {
                kind: "derive",
                name: "disabled_pair",
                args: [
                  { kind: "pair", value: "accent" },
                  { kind: "ratio", value: "lift.ghost.disabled" },
                  { kind: "ratio", value: "disabled.chroma_reduction" }
                ]
              }
            }
          },
          {
            when: { variant: "primary", focus_visible: true },
            set: {
              ring: {
                kind: "derive",
                name: "focus_ring",
                args: [
                  { kind: "colour", value: "ring" },
                  { kind: "pair", value: "primary" }
                ]
              }
            }
          },
          {
            when: { variant: "destructive", focus_visible: true },
            set: {
              ring: {
                kind: "derive",
                name: "focus_ring",
                args: [
                  { kind: "colour", value: "ring" },
