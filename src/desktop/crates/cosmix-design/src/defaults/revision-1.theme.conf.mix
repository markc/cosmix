scheme: "ocean"
mode: "light"
typography: { family: "Noto Sans", body_px: 13.333 }
surface: "#f3fafc"
panel: "#e9f4f7"
master_panel: "#d8e8ed"
track: "#e9f4f7"
control: "#d8f4fd"
control_active: "#006f87"
thumb: "#005f75"
meter_green: "#006818"
meter_amber: "#c79600"
meter_red: "#c21725"
text: "#002631"
text_dim: "#386b7b"
border: "#d8e8ed"
row_hover: "#e9f4f7"
row_selected: "#1d5869"
row_selected_text: "#e9f4f7"
row_selected_text_dim: "#e9f4f7"
scrim: "#00000000"
danger_surface: "#c21725"
control_gap: 8.0
corner_radius: 5.0
fader_width: 42.0
fader_height: 250.0
knob_size: 58.0
meter_width: 28.0

design: {
  schema_version: 1,
  "v1": {
    kind: "base",
    resolution_order: ["scheme", "mode"],
    primitives: {
      colors: {
        "palette.background.1": { color_space: "oklch", l: 0.98, c: 0.008, h: 220.0 },
        "palette.background.2": { color_space: "oklch", l: 0.96, c: 0.012, h: 220.0 },
        "palette.background.3": { color_space: "oklch", l: 0.92, c: 0.018, h: 220.0 },
        "palette.foreground.default": { color_space: "oklch", l: 0.25, c: 0.06, h: 220.0 },
        "palette.foreground.muted": { color_space: "oklch", l: 0.50, c: 0.06, h: 220.0 },
        "palette.accent.default": { color_space: "oklch", l: 0.50, c: 0.12, h: 220.0 },
        "palette.accent.hover": { color_space: "oklch", l: 0.45, c: 0.14, h: 220.0 },
        "status.success": { color_space: "oklch", l: 0.45, c: 0.15, h: 145.0 },
        "status.warning": { color_space: "oklch", l: 0.70, c: 0.15, h: 85.0 },
        "status.danger": { color_space: "oklch", l: 0.52, c: 0.20, h: 25.0 },
        "transparent": { color_space: "oklch", l: 0.0, c: 0.0, h: 0.0, alpha: 0.0 }
      },
      metrics: {
        "button.height.sm": { kind: "px", value: 24.0 },
        "button.height.md": { kind: "px", value: 28.0 },
        "button.height.lg": { kind: "px", value: 32.0 },
        "button.min_width.none": { kind: "px", value: 0.0 },
        "button.min_width.standard": { kind: "px", value: 72.0 },
        "button.padding_x": { kind: "step", scale: "spacing", value: 5 },
        "button.border_width": { kind: "px", value: 1.0 },
        "radius": { kind: "px", value: 6.0 },
        "radius.md": { kind: "step", scale: "radius", value: 1 },
        "type.body": { kind: "step", scale: "type", value: 1 },
        "type.compact": { kind: "step", scale: "type", value: 0 },
        "lift.hover": { kind: "ratio", value: 0.06 },
        "lift.ghost.hover": { kind: "ratio", value: 0.03 },
        "lift.press": { kind: "ratio", value: 0.06 },
        "lift.ghost.press": { kind: "ratio", value: 0.09 },
        "lift.disabled": { kind: "ratio", value: 0.09 },
        "lift.ghost.disabled": { kind: "ratio", value: 0.13 },
        "disabled.chroma_reduction": { kind: "ratio", value: 0.50 },
        "legacy.control_gap": { kind: "px", value: 8.0 },
        "legacy.corner_radius": { kind: "px", value: 5.0 },
        "legacy.fader_width": { kind: "px", value: 42.0 },
        "legacy.fader_height": { kind: "px", value: 250.0 },
        "legacy.knob_size": { kind: "px", value: 58.0 },
        "legacy.meter_width": { kind: "px", value: 28.0 }
      },
      scales: {
        spacing: [
          { kind: "px", value: 0.0 },
          { kind: "px", value: 2.0 },
          { kind: "px", value: 4.0 },
          { kind: "px", value: 6.0 },
          { kind: "px", value: 8.0 },
          { kind: "px", value: 10.0 },
          { kind: "px", value: 12.0 },
          { kind: "px", value: 16.0 },
          { kind: "px", value: 20.0 },
          { kind: "px", value: 24.0 }
        ],
        type: [
          { kind: "px", value: 11.333 },
          { kind: "px", value: 13.333 }
        ]
      }
    },
    modifiers: [
      {
        when: { scheme: "ocean", mode: "light" }
      },
      {
        when: { scheme: "ocean", mode: "dark" },
        primitives: {
          colors: {
            "palette.background.1": { color_space: "oklch", l: 0.12, c: 0.015, h: 220.0 },
            "palette.background.2": { color_space: "oklch", l: 0.16, c: 0.02, h: 220.0 },
