-- Accepted parity deltas between the two bake-off arms (ADR 2026-09-17
-- test C). The driver's parity guard loads this with load_data() and accepts
-- exactly these differences; anything else it finds is a parity failure.
--
-- Three of the original five closed when `cosmix-iced-widgets` slice 4
-- landed: Fader and LevelMeter now take the feed's own tapers (so a dB sits
-- at the same height in both arms), LevelMeter takes the feed's peak, hold
-- and clip latch instead of running its own timer, and PianoRoll takes a
-- per-track palette. What is left is one deliberate choice and one limit of
-- the token adapter. Neither changes how many quads or glyphs a frame draws,
-- so neither moves a measured number.
known_deltas: {
  schema_version: 1,
  arms: ["bevy", "iced-wgpu", "iced-tiny-skia"],
  deltas: [
    {
      arm: "iced",
      item: "roll-playhead",
      reason: "PianoRoll can draw a playhead on its own layer but the Bevy arm draws none, so the iced arm passes None: the absence is the parity choice, not a missing feature"
    },
    {
      arm: "iced",
      item: "colour-role-mapping",
      reason: "CTK reads the design's palette roles directly (palette.background.1/2/3 for the window, strip and master panels, palette.accent.default for the roll's hue base); cosmix_iced_widgets::Tokens maps colour PAIRS and names no such rungs, and in Ocean/Dark base, card, popover and muted all resolve to #020709. The iced arm therefore takes its two panel lifts from border and selection and its accent from ring: same ordering, same per-track spread, different exact values"
    }
  ]
}
