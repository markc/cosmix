# Settings/Appearance scene data. Loaded by settings.rs with a live model.
{
  "root": {"widget":"column","fill":true,"min_height":0,"children":["viewport"]},
  "viewport": {"widget":"list","row":"content","row_height":760,"grow":1,"rows":[{"id":"appearance","cells":[]}],"basis":0,"min_height":0,"shrink":1},
  "content": {"widget":"column","gap":10,"padding":12,"children":["title","theme_head","scheme_ocean","scheme_crimson","scheme_stone","scheme_forest","scheme_sunset","scheme_mono","motion_head","motion_slide","motion_fade","fade_reason","size_head","size_top","size_bottom","size_left","size_right"]},
  "title": {"widget":"text","text":"Appearance","size":16,"color":"#fcfcfc","bold":true},
  "theme_head": {"widget":"text","text":"Colour scheme","size":13,"color":"#fcfcfc","bold":true},
  "scheme_ocean": {"widget":"row","height":32,"padding":6,"gap":8,"align":"center","radius":6,"background":"= $model.schemes.ocean.background","hover":"#ffffff1a","on_click":"shell.settings.scheme","children":["scheme_ocean_chip","scheme_ocean_name","scheme_ocean_mark"]},
  "scheme_ocean_chip": {"widget":"row","height":16,"min_width":16,"max_width":16,"radius":8,"background":"= $model.schemes.ocean.accent","children":[]},
  "scheme_ocean_name": {"widget":"text","text":"Ocean","size":13,"color":"#fcfcfc","fill":true,"elide":true},
  "scheme_ocean_mark": {"widget":"text","text":"= $model.schemes.ocean.mark","size":13,"color":"#fcfcfc"},
  "scheme_crimson": {"widget":"row","height":32,"padding":6,"gap":8,"align":"center","radius":6,"background":"= $model.schemes.crimson.background","hover":"#ffffff1a","on_click":"shell.settings.scheme","children":["scheme_crimson_chip","scheme_crimson_name","scheme_crimson_mark"]},
  "scheme_crimson_chip": {"widget":"row","height":16,"min_width":16,"max_width":16,"radius":8,"background":"= $model.schemes.crimson.accent","children":[]},
  "scheme_crimson_name": {"widget":"text","text":"Crimson","size":13,"color":"#fcfcfc","fill":true,"elide":true},
  "scheme_crimson_mark": {"widget":"text","text":"= $model.schemes.crimson.mark","size":13,"color":"#fcfcfc"},
  "scheme_stone": {"widget":"row","height":32,"padding":6,"gap":8,"align":"center","radius":6,"background":"= $model.schemes.stone.background","hover":"#ffffff1a","on_click":"shell.settings.scheme","children":["scheme_stone_chip","scheme_stone_name","scheme_stone_mark"]},
  "scheme_stone_chip": {"widget":"row","height":16,"min_width":16,"max_width":16,"radius":8,"background":"= $model.schemes.stone.accent","children":[]},
  "scheme_stone_name": {"widget":"text","text":"Stone","size":13,"color":"#fcfcfc","fill":true,"elide":true},
  "scheme_stone_mark": {"widget":"text","text":"= $model.schemes.stone.mark","size":13,"color":"#fcfcfc"},
  "scheme_forest": {"widget":"row","height":32,"padding":6,"gap":8,"align":"center","radius":6,"background":"= $model.schemes.forest.background","hover":"#ffffff1a","on_click":"shell.settings.scheme","children":["scheme_forest_chip","scheme_forest_name","scheme_forest_mark"]},
  "scheme_forest_chip": {"widget":"row","height":16,"min_width":16,"max_width":16,"radius":8,"background":"= $model.schemes.forest.accent","children":[]},
  "scheme_forest_name": {"widget":"text","text":"Forest","size":13,"color":"#fcfcfc","fill":true,"elide":true},
  "scheme_forest_mark": {"widget":"text","text":"= $model.schemes.forest.mark","size":13,"color":"#fcfcfc"},
  "scheme_sunset": {"widget":"row","height":32,"padding":6,"gap":8,"align":"center","radius":6,"background":"= $model.schemes.sunset.background","hover":"#ffffff1a","on_click":"shell.settings.scheme","children":["scheme_sunset_chip","scheme_sunset_name","scheme_sunset_mark"]},
  "scheme_sunset_chip": {"widget":"row","height":16,"min_width":16,"max_width":16,"radius":8,"background":"= $model.schemes.sunset.accent","children":[]},
  "scheme_sunset_name": {"widget":"text","text":"Sunset","size":13,"color":"#fcfcfc","fill":true,"elide":true},
  "scheme_sunset_mark": {"widget":"text","text":"= $model.schemes.sunset.mark","size":13,"color":"#fcfcfc"},
  "scheme_mono": {"widget":"row","height":32,"padding":6,"gap":8,"align":"center","radius":6,"background":"= $model.schemes.mono.background","hover":"#ffffff1a","on_click":"shell.settings.scheme","children":["scheme_mono_chip","scheme_mono_name","scheme_mono_mark"]},
  "scheme_mono_chip": {"widget":"row","height":16,"min_width":16,"max_width":16,"radius":8,"background":"= $model.schemes.mono.accent","children":[]},
  "scheme_mono_name": {"widget":"text","text":"Mono","size":13,"color":"#fcfcfc","fill":true,"elide":true},
  "scheme_mono_mark": {"widget":"text","text":"= $model.schemes.mono.mark","size":13,"color":"#fcfcfc"},
  "motion_head": {"widget":"text","text":"Carousel motion","size":13,"color":"#fcfcfc","bold":true},
  "motion_slide": {"widget":"row","height":32,"padding":6,"on_click":"shell.settings.motion","hover":"#ffffff1a","children":["motion_slide_t"]},
  "motion_slide_t": {"widget":"text","text":"= $model.motion.slide","size":13,"color":"#fcfcfc"},
  "motion_fade": {"widget":"row","height":28,"padding":6,"children":["motion_fade_t"]},
  "motion_fade_t": {"widget":"text","text":"= $model.motion.fade","size":13,"color":"#a1a9b1"},
  "fade_reason": {"widget":"text","text":"= $model.fade_reason","size":11,"color":"#a1a9b1"},
  "size_head": {"widget":"text","text":"Panel size","size":13,"color":"#fcfcfc","bold":true},
  "size_top": {"widget":"row","height":32,"gap":4,"align":"center","children":["size_top_label","size_top_minus","size_top_value","size_top_plus"]},
  "size_top_label": {"widget":"text","text":"Top height","size":12,"color":"#fcfcfc","fill":true,"elide":true},
  "size_top_minus": {"widget":"row","height":28,"min_width":24,"max_width":24,"align":"center","justify":"center","on_click":"shell.settings.size","hover":"#ffffff1a","children":["size_top_minus_t"]},
  "size_top_minus_t": {"widget":"text","text":"−","size":13,"color":"#fcfcfc"},
  "size_top_plus": {"widget":"row","height":28,"min_width":24,"max_width":24,"align":"center","justify":"center","on_click":"shell.settings.size","hover":"#ffffff1a","children":["size_top_plus_t"]},
  "size_top_plus_t": {"widget":"text","text":"+","size":13,"color":"#fcfcfc"},
  "size_top_value": {"widget":"text","text":"= $model.sizes.top","size":12,"color":"#fcfcfc","width":48,"align":"right"},
  "size_bottom": {"widget":"row","height":32,"gap":4,"align":"center","children":["size_bottom_label","size_bottom_minus","size_bottom_value","size_bottom_plus"]},
  "size_bottom_label": {"widget":"text","text":"Bottom height","size":12,"color":"#fcfcfc","fill":true,"elide":true},
  "size_bottom_minus": {"widget":"row","height":28,"min_width":24,"max_width":24,"align":"center","justify":"center","on_click":"shell.settings.size","hover":"#ffffff1a","children":["size_bottom_minus_t"]},
  "size_bottom_minus_t": {"widget":"text","text":"−","size":13,"color":"#fcfcfc"},
  "size_bottom_plus": {"widget":"row","height":28,"min_width":24,"max_width":24,"align":"center","justify":"center","on_click":"shell.settings.size","hover":"#ffffff1a","children":["size_bottom_plus_t"]},
  "size_bottom_plus_t": {"widget":"text","text":"+","size":13,"color":"#fcfcfc"},
  "size_bottom_value": {"widget":"text","text":"= $model.sizes.bottom","size":12,"color":"#fcfcfc","width":48,"align":"right"},
  "size_left": {"widget":"row","height":32,"gap":4,"align":"center","children":["size_left_label","size_left_minus","size_left_value","size_left_plus"]},
  "size_left_label": {"widget":"text","text":"Left width","size":12,"color":"#fcfcfc","fill":true,"elide":true},
  "size_left_minus": {"widget":"row","height":28,"min_width":24,"max_width":24,"align":"center","justify":"center","on_click":"shell.settings.size","hover":"#ffffff1a","children":["size_left_minus_t"]},
  "size_left_minus_t": {"widget":"text","text":"−","size":13,"color":"#fcfcfc"},
  "size_left_plus": {"widget":"row","height":28,"min_width":24,"max_width":24,"align":"center","justify":"center","on_click":"shell.settings.size","hover":"#ffffff1a","children":["size_left_plus_t"]},
  "size_left_plus_t": {"widget":"text","text":"+","size":13,"color":"#fcfcfc"},
  "size_left_value": {"widget":"text","text":"= $model.sizes.left","size":12,"color":"#fcfcfc","width":48,"align":"right"},
  "size_right": {"widget":"row","height":32,"gap":4,"align":"center","children":["size_right_label","size_right_minus","size_right_value","size_right_plus"]},
  "size_right_label": {"widget":"text","text":"Right width","size":12,"color":"#fcfcfc","fill":true,"elide":true},
  "size_right_minus": {"widget":"row","height":28,"min_width":24,"max_width":24,"align":"center","justify":"center","on_click":"shell.settings.size","hover":"#ffffff1a","children":["size_right_minus_t"]},
  "size_right_minus_t": {"widget":"text","text":"−","size":13,"color":"#fcfcfc"},
  "size_right_plus": {"widget":"row","height":28,"min_width":24,"max_width":24,"align":"center","justify":"center","on_click":"shell.settings.size","hover":"#ffffff1a","children":["size_right_plus_t"]},
  "size_right_plus_t": {"widget":"text","text":"+","size":13,"color":"#fcfcfc"},
  "size_right_value": {"widget":"text","text":"= $model.sizes.right","size":12,"color":"#fcfcfc","width":48,"align":"right"}
}
