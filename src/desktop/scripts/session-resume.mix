-- version: 0.1.0
-- session-resume -- the detached half of desktop.session.restart
-- (session-control.mix starts it with systemd-run; it is not a citizen).
--
-- Why detached: restarting the desktop closes every desktop window,
-- including the terminal whoever asked for the restart typed into. The
-- restart and the resume therefore run in a transient unit of their own,
-- which neither the desktop unit nor the citizen's reply can take down.
-- Why by id: `claude -c` resumes the MOST RECENT conversation of a
-- directory, so two sessions in one directory would reopen the same one.
--
--   mix session-resume.mix --phase2 STATE        (root, in the transient unit)
--       restart the desktop unit, wait until it is active AND its boot
--       terminal is a NEW process, then run --resume-fresh as the desktop
--       user. Never types anywhere while the old terminal could still answer.
--   mix session-resume.mix --resume-fresh STATE PID  (desktop user)
--   mix session-resume.mix --resume-only STATE       (desktop user, by hand)
--       --resume-fresh types only into the term PROCESS whose pid is PID (the
--       new boot term unit's MainPID, which phase 2 read): it checks the pid
--       the term's term.panes reports before every keystroke batch, so a stray term
--       holding the Bus name `term` never receives them. On a mismatch it
--       fails closed with the recovery hint.
--       per session: a pane (the boot tab's for the first one after a fresh
--       restart, else a new tab), then term.type of its resume line. Every
--       term.tab.new / term.type carries a stable request_id keyed on the
--       state file and the session, and each resumed id is appended to
--       STATE.done, so a rerun after a lost reply replays instead of typing
--       twice. --resume-only is the recovery: it skips STATE.done and opens a
--       new tab for every session.
--
-- Settings come from the environment the citizen hands over (see
-- lib/session.mix worker_env): COSMIX_SESSION_USER, COSMIX_SESSION_HOME,
-- COSMIX_DESKTOP_UNIT, COSMIX_BOOT_TERM_UNIT, COSMIX_SESSION_TERM_SERVICE.
$session = require("lib/session.mix")
$SELF = realpath($0)
$cfg = $session.config()
$TERM = $cfg.term_service
-- The term process keys may go to (--resume-fresh), or nil (--resume-only,
-- where the user is at the keyboard and chose the terminal).
$EXPECTED_PID = nil
-- The state file in use, for recovery hints from helpers.
$STATEFILE = ""

fn fail($msg)
  print("session-resume: " .. $msg)
  exit(1)
end

fn recovery($statefile)
  return "mix " .. $SELF .. " --resume-only " .. $statefile .. "   (as the desktop user; skips sessions listed in " .. $statefile .. ".done and opens a NEW tab for each)"
end

fn done_ids($statefile)
  if not is_file($statefile .. ".done") then return [] end
  return lines(trim(read_file($statefile .. ".done")))
end

-- The pid the term answering on the Bus reports in its term.panes lines
-- (term-core >= 0.8.1), or nil. Self-reported: a program in a pane cannot
-- change it (pane lines carry no free text), but a process registering the
-- name `term` itself could claim any pid; a broker-attested owner pid is
-- future noded work.
fn term_pid()
  $r = send $TERM "term.panes" body="{}" timeout=3
  if $rc != 0 then return nil end
  $lines = split(to_string($r), "\n")
  if len($lines) == 0 then return nil end
  return $session.reply_int($lines[0], "pid")
end

-- True when the Bus name answers AND, if a process is expected, is that
-- process.
fn term_is_ours()
  if $EXPECTED_PID == nil then
    send $TERM "term.tabs" body="{}" timeout=3
    return $rc == 0
  end
  return term_pid() == $EXPECTED_PID
end

fn wait_term($deadline)
  while time() < $deadline
    if term_is_ours() then return true end
    sleep(2)
  end
  return false
end

-- A term.type target for a pane of $tab: its active pane when $pane is nil,
-- else that pane if the tab lists it. `instance` rides along when the term
-- reports one, so a restarted term never takes keys meant for its old self.
fn pane_target($tab, $pane)
  $r = send $TERM "term.panes" body=json_encode({tab: $tab}) timeout=5
  if $rc != 0 then return nil end
  for each $line in split(to_string($r), "\n")
    $id = $session.reply_int($line, "id")
    if ($pane == nil and re_match($line, "(?:^| )active=true( |$)")) or ($pane != nil and $id == $pane) then
      $target = {pane: $id}
      $instance = $session.reply_int($line, "instance")
      if $EXPECTED_PID != nil then
        -- Bind the process and its instance in ONE reply: this line's pid
        -- must be the expected one, and the instance sent with the keys is
        -- this same line's, so term.type's own instance check refuses them
        -- in any other process.
        $pid = $session.reply_int($line, "pid")
        if $pid != $EXPECTED_PID or $instance == nil then
          fail("term.panes named pid " .. to_string($pid) .. " instance " .. to_string($instance) .. " for the pane, not the new boot term (pid " .. to_string($EXPECTED_PID) .. "); NOT typing. Recover with: " .. recovery($STATEFILE))
        end
      end
      if $instance != nil then $target.instance = $instance end
      return $target
    end
  end
  return nil
end

-- The boot tab is tab 1 (ids are per-process counters from 1), named
-- explicitly so a tab switch during the waits cannot redirect the keys. The
-- term can answer before its first tab attaches, so retry within the budget.
fn boot_target($deadline)
  while time() < $deadline
    $target = pane_target(1, nil)
    if $target != nil then return $target end
    sleep(1)
  end
  return nil
end

fn resume_sessions($statefile, $fresh)
  $sessions = json_parse(read_file($statefile))
  $done = done_ids($statefile)
  -- Keyed on this capture as well as the session: two captures resuming the
  -- same session never collide in the term's replay cache.
  $capture = replace(basename($statefile), ".json", "")
  $deadline = time() + $cfg.term_wait + 10 * len($sessions)
  if len($sessions) == 0 then return 0 end
  if not wait_term($deadline) then
    $seen = $EXPECTED_PID == nil ? "" : " as the new boot term (expected pid " .. to_string($EXPECTED_PID) .. ", the term answering reports " .. to_string(term_pid()) .. ")"
    fail("the terminal never answered on the Bus" .. $seen .. "; NOT typing. Recover with: " .. recovery($statefile))
  end
  sleep(2)
  $use_boot_tab = $fresh and len($done) == 0
  $n = 0
  for each $s in $sessions
    $line = $session.resume_line($s)
    if contains($done, $s.id) then
      print("already resumed " .. $s.id .. "; skipping")
    elif $line == nil then
      print("not typing " .. $s.id .. ": its directory or id needs shell quoting (" .. $s.cwd .. "); resume it by hand")
    else
      $target = nil
      $type_id = ""
      if $use_boot_tab then
        $target = boot_target($deadline)
        if $target == nil then fail("term.panes named no active pane in boot tab 1; recover with: " .. recovery($statefile)) end
        $type_id = "resume-type-boot-" .. $capture .. "-" .. $s.id
      else
        -- Stable request_ids: a rerun after a lost reply replays the same tab
        -- and the same keys instead of repeating them into a live prompt.
        $r = send $TERM "term.tab.new" body=json_encode({request_id: "resume-tab-" .. $capture .. "-" .. $s.id}) timeout=5
        if $rc != 0 then fail("term.tab.new failed (" .. to_string($r) .. "); recover with: " .. recovery($statefile)) end
        $tab = $session.reply_int(to_string($r), "tab")
        $pane = $session.reply_int(to_string($r), "pane")
        if $tab == nil or $pane == nil then fail("term.tab.new named no tab/pane (" .. to_string($r) .. "); recover with: " .. recovery($statefile)) end
        $target = nil
        while $target == nil and time() < $deadline
          $target = pane_target($tab, $pane)
          if $target == nil then sleep(1) end
        end
        if $target == nil then fail("term.panes {tab:" .. to_string($tab) .. "} did not list pane " .. to_string($pane) .. "; recover with: " .. recovery($statefile)) end
        $type_id = "resume-type-tab-" .. $capture .. "-" .. $s.id
        sleep(1)
      end
      $use_boot_tab = false
      -- The Bus name may have changed hands since the wait: bind every
      -- keystroke batch to the expected process again.
      if not term_is_ours() then
        fail("the term answering on the Bus is not the new boot term (expected pid " .. to_string($EXPECTED_PID) .. ", got " .. to_string(term_pid()) .. "); NOT typing. Recover with: " .. recovery($statefile))
      end
      $target.text = $line
      $target.request_id = $type_id
      $r = send $TERM "term.type" body=json_encode($target) timeout=5
      if $rc != 0 and contains(to_string($r), "request_id already used") then
        -- Our own id already typed these keys on an earlier run whose reply
        -- was lost: never type them a second time.
        append_file($statefile .. ".done", $s.id .. "\n")
        print("already typed " .. $s.id .. " (request_id " .. $type_id .. " used by an earlier run); marked done")
      else
        if $rc != 0 then fail("term.type failed for " .. $s.id .. " (" .. to_string($r) .. "); recover with: " .. recovery($statefile)) end
        append_file($statefile .. ".done", $s.id .. "\n")
        print("resumed " .. $s.id .. " in " .. $s.cwd)
      end
      $n = $n + 1
      sleep(2)
    end
  end
  return $n
end

fn unit_prop($unit, $prop)
  return trim(run_argv(["systemctl", "show", "-p", $prop, "--value", $unit], {timeout: 10}).stdout)
end

$a = args()
-- Set here, at top level: a fn cannot assign a global.
if len($a) >= 2 then $STATEFILE = $a[1] end
if len($a) == 2 and $a[0] == "--resume-only" then
  $n = resume_sessions($a[1], false)
  print("resume done: " .. to_string($n) .. " session(s)")
  exit(0)
end
if len($a) == 3 and $a[0] == "--resume-fresh" then
  if not re_match($a[2], "^[1-9][0-9]*$") then fail("--resume-fresh needs the new boot term's pid") end
  $EXPECTED_PID = to_number($a[2])
  $n = resume_sessions($a[1], true)
  print("resume done: " .. to_string($n) .. " session(s)")
  exit(0)
end
if len($a) != 2 or $a[0] != "--phase2" then
  fail("usage: session-resume.mix --phase2 STATE | --resume-fresh STATE PID | --resume-only STATE")
end
if uid() != 0 then fail("--phase2 must run as root (it restarts " .. $cfg.desktop_unit .. ")") end
if $cfg.user == "" then fail("COSMIX_SESSION_USER is not set") end

$statefile = $a[1]
-- First journal line: how to recover if anything below fails.
print("state file " .. $statefile .. "; if resuming fails, recover with: " .. recovery($statefile))
$old_term = unit_prop($cfg.boot_term_unit, "MainPID")
$r = run_argv(["systemctl", "restart", $cfg.desktop_unit], {timeout: 120})
if $r.exit_code != 0 then fail("restart failed (exit " .. to_string($r.exit_code) .. ": " .. trim($r.stderr) .. "); NOT typing into any terminal") end
-- Refuse to type anywhere until the desktop is active AND the boot terminal
-- is a NEW process: an old terminal still on the Bus would take the keys into
-- whatever runs in its active tab.
$deadline = time() + 120
$state = ""
$new_term = ""
while time() < $deadline
  $state = unit_prop($cfg.desktop_unit, "ActiveState")
  $new_term = unit_prop($cfg.boot_term_unit, "MainPID")
  if $state == "active" and $new_term != "" and $new_term != "0" and $new_term != $old_term then break end
  sleep(2)
end
print($cfg.desktop_unit .. " ActiveState=" .. $state .. "; boot term pid " .. $old_term .. " -> " .. $new_term)
if $state != "active" or $new_term == "" or $new_term == "0" or $new_term == $old_term then
  fail("the desktop or its boot terminal did not come back as a new process; NOT typing. Recover by hand: " .. recovery($statefile))
end
$env = {HOME: $cfg.home}
for each $k in ["COSMIX_NODE_CONFIG", "COSMIX_RUN", "COSMIX_SESSION_TERM_SERVICE", "MIX_STATS"]
  if env($k, "") != "" then $env[$k] = env($k, "") end
end
-- Budget: the terminal wait, then a few seconds per session.
$count = len(json_parse(read_file($statefile)))
$q = run_argv(["runuser", "-u", $cfg.user, "--", $cfg.mix, $SELF, "--resume-fresh", $statefile, $new_term], {timeout: 180 + 20 * $count, env: $env})
print(trim($q.stdout) .. " " .. trim($q.stderr))
exit($q.exit_code)
