-- Desktop Bus capability provider v0.3.5. Trusted session configuration only.
-- Requests never select executable paths, environment, display or session bus.
$_nul = json_parse("\"\\u0000\"")

fn error($code, $status)
  return {rc:$status, body:{error:$code}}
end

fn client_name()
  -- 80 random bits, within noded's 31-character service-name limit.
  return "desktopctl-" .. slice(replace(uuid(),"-",""),0,20)
end

fn is_int($v)
  return type($v) == "number" and $v == floor($v)
end

fn keys_are($body, $expected)
  if type($body) != "map" or len(keys($body)) != len($expected) then return false end
  for each $key in keys($body)
    if not contains($expected, $key) then return false end
  end
  return true
end

fn keys_subset($body, $required, $optional)
  -- Exact-set membership like keys_are, but with optional keys; an explicitly
  -- nil-valued key is rejected so absent and present-but-nil stay distinct.
  if type($body) != "map" then return false end
  for each $key in keys($body)
    if not contains($required, $key) and not contains($optional, $key) then return false end
    if $body[$key] == nil then return false end
  end
  for each $key in $required
    if not contains(keys($body), $key) then return false end
  end
  return true
end

fn list_remove($list, $idx)
  $out = []
  for each $i in range(0, len($list) - 1)
    if $i != $idx then $out = concat($out, [$list[$i]]) end
  end
  return $out
end

fn list_page($list, $offset, $limit)
  $out = []
  for each $i in range(0, len($list) - 1)
    if $i >= $offset and len($out) < $limit then $out = concat($out, [$list[$i]]) end
  end
  return $out
end

fn merge_maps($a, $b)
  $out = {}
  for each $key in keys($a)
    $out[$key] = $a[$key]
  end
  for each $key in keys($b)
    $out[$key] = $b[$key]
  end
  return $out
end

-- ── Clipboard history state ─────────────────────────────────────────────
-- One history per session provider, persisted as JSON under $XDG_STATE_HOME
-- (fallback ~/.local/state). Atomic replacement via write_new + rename; no
-- fsync builtin exists yet, so persistence is atomic, not power-loss durable.

fn history_used($entries)
  $total = 0
  for each $entry in $entries
    $total = $total + $entry.bytes
  end
  return $total
end

fn history_quarantine($path, $h, $reason)
  -- Move a corrupt store aside and start empty. A quarantine that fails
  -- leaves degraded mode set: the file is never overwritten from a bad read.
  -- Quarantine copies retain real clipboard content (0600), so only the two
  -- newest are kept — repeated corruption must not accumulate stale secrets.
  try
    rename($path, $path .. ".corrupt-" .. slice(replace(uuid(),"-",""),0,8))
  catch $err
    $h.degraded = "quarantine-failed"
  end
  $copies = glob($path .. ".corrupt-*")
  if len($copies) > 2 then
    $keep = []
    for each $n in range(1, 2)
      $newest = nil
      $newest_mtime = -1
      for each $c in $copies
        if not contains($keep, $c) then
          try
            $m = stat($c).mtime
            if $m > $newest_mtime then
              $newest_mtime = $m
              $newest = $c
            end
          catch $err
          end
        end
      end
      if $newest != nil then $keep = concat($keep, [$newest]) end
    end
    for each $c in $copies
      if not contains($keep, $c) then
        try
          remove($c)
        catch $err
        end
      end
    end
  end
  $h.entries = []
  $h.next_id = 1
  $h.revision = 0
  $h.skipped = 0
  $h.used = 0
  return $h
end

fn history_entries_valid($entries)
  -- Structural validity only: ids are unique positive ints and fields are
  -- well-typed. Array order (newest-first) is convention, NOT an invariant —
  -- dedupe move-to-front and pick legitimately reorder entries, so a
  -- reloaded store must not be quarantined for its order.
  if type($entries) != "list" then return false end
  $ids = []
  for each $entry in $entries
    if not keys_are($entry, ["id","text","bytes","at"]) then return false end
    if not is_int($entry.id) or $entry.id < 1 then return false end
    if contains($ids, $entry.id) then return false end
    $ids = concat($ids, [$entry.id])
    if type($entry.text) != "string" or contains($entry.text, $_nul) then return false end
    if $entry.bytes != byte_length($entry.text) then return false end
    if type($entry.at) != "number" then return false end
  end
  return true
end

fn history_load($h)
  if not exists($h.path) then return $h end
  try
    $content = read_file($h.path)
  catch $err
    $h.degraded = "load-error"
    return $h
  end
  try
    $parsed = json_parse($content)
  catch $err
    return history_quarantine($h.path, $h, "parse")
  end
  if type($parsed) != "map" or not is_int($parsed.schema_version) then
    return history_quarantine($h.path, $h, "schema")
  end
  if $parsed.schema_version > 1 then
    -- A newer schema is preserved untouched, never overwritten.
    $h.degraded = "schema-newer"
    return $h
  end
  if not is_int($parsed.next_id) or $parsed.next_id < 1 then
    return history_quarantine($h.path, $h, "next-id")
  end
  if not is_int($parsed.skipped) or $parsed.skipped < 0 then
    return history_quarantine($h.path, $h, "skipped")
  end
  if not is_int($parsed.revision) or $parsed.revision < 0 then
    return history_quarantine($h.path, $h, "revision")
  end
  if type($parsed.paused) != "bool" then
    return history_quarantine($h.path, $h, "paused")
  end
  if not history_entries_valid($parsed.entries) then
    return history_quarantine($h.path, $h, "entries")
  end
  $max_id = 0
  for each $entry in $parsed.entries
    if $entry.id > $max_id then $max_id = $entry.id end
  end
  if $parsed.next_id <= $max_id then
    return history_quarantine($h.path, $h, "next-id")
  end
  -- Apply CURRENT limits to stores written under looser ones: entries over
  -- today's cap are dropped individually (a limits change, not corruption),
  -- then the tail is trimmed to depth/budget.
  $kept = []
  for each $entry in $parsed.entries
    if $entry.bytes <= $h.cap_bytes then $kept = concat($kept, [$entry]) end
  end
  while len($kept) > $h.depth or history_used($kept) > $h.budget_bytes
    $kept = list_remove($kept, len($kept) - 1)
  end
  $h.entries = $kept
  $h.next_id = $parsed.next_id
  $h.skipped = $parsed.skipped
  $h.revision = $parsed.revision
  $h.paused = $parsed.paused
  $h.used = history_used($h.entries)
  -- A limits change that drops entries is a committed mutation, not a
  -- silent vanishing: count the drops and bump revision once.
  $dropped = len($parsed.entries) - len($kept)
  if $dropped > 0 then
    $h.skipped = $h.skipped + $dropped
    $h.revision = $h.revision + 1
  end
  return $h
end

fn history_state($cfg, $session)
  -- Build (and lock, and load) the history store for one session provider.
  if $cfg == nil then $cfg = {} end
  if type($cfg) != "map" then raise("DESKTOP_CONFIG", "history must be a map") end
  $depth = $cfg.depth == nil ? 100 : $cfg.depth
  $cap_bytes = $cfg.cap_bytes == nil ? 65536 : $cfg.cap_bytes
  $budget_bytes = $cfg.budget_bytes == nil ? 4194304 : $cfg.budget_bytes
  if not is_int($depth) or $depth < 1 or $depth > 1000 then raise("DESKTOP_CONFIG", "history.depth must be 1..1000") end
  if not is_int($cap_bytes) or $cap_bytes < 1 or $cap_bytes > 65536 then raise("DESKTOP_CONFIG", "history.cap_bytes must be 1..65536") end
  if not is_int($budget_bytes) or $budget_bytes < 65536 or $budget_bytes > 67108864 then raise("DESKTOP_CONFIG", "history.budget_bytes must be 65536..67108864") end
  if $budget_bytes < $cap_bytes then raise("DESKTOP_CONFIG", "history.budget_bytes must be >= cap_bytes") end
  $root = env("XDG_STATE_HOME")
  if $root == "" or not starts_with($root, "/") then
    $root = env("HOME") .. "/.local/state"
  end
  $path = $cfg.path
  if $path == nil then
    $path = $root .. "/cosmix/clipboard/history-" .. $session .. ".json"
  elif type($path) != "string" or not starts_with($path, "/") then
    raise("DESKTOP_CONFIG", "history.path must be absolute")
  end
  $h = {path:$path, depth:$depth, cap_bytes:$cap_bytes, budget_bytes:$budget_bytes,
    entries:[], next_id:1, revision:0, skipped:0, paused:false, used:0, degraded:"",
    save_failed:false}
  try
    mkdir(re_replace($path, "/[^/]*$", ""), {parents:true})
  catch $err
    $h.degraded = "state-dir"
    return $h
  end
  try
    if not flock($path .. ".lock") then
      -- Another live provider owns this store; serve in-memory only and
      -- never read or write its file.
      $h.degraded = "locked"
      return $h
    end
  catch $err
    $h.degraded = "lock-error"
    return $h
  end
  return history_load($h)
end

fn history_persist($h)
  -- Save and return the updated history (the save_failed flag must survive
  -- into the caller's context — fn args are by value). Only a temp file THIS
  -- call created is ever removed: a name collision with a pre-existing file
  -- fails write_new without giving us ownership of it.
  if $h.degraded != "" then return {h:$h, persisted:false} end
  $payload = {schema_version:1, next_id:$h.next_id, revision:$h.revision,
    skipped:$h.skipped, paused:$h.paused, entries:$h.entries}
  $tmpf = $h.path .. ".tmp-" .. slice(replace(uuid(),"-",""),0,8)
  $created = false
  try
    write_new($tmpf, json_encode($payload), "0600")
    $created = true
    rename($tmpf, $h.path)
    $h.save_failed = false
    return {h:$h, persisted:true}
  catch $err
    if $created then
      -- Our own half-written temp file holds clipboard content: remove it.
      try
        remove($tmpf)
      catch $err2
      end
    end
    $h.save_failed = true
    return {h:$h, persisted:false}
  end
end

fn history_publish($ctx, $action, $id)
  -- Invalidation events carry no clipboard text; subscribers refetch.
  try
    $body = {instance:$ctx.instance, session:$ctx.session, revision:$ctx.history.revision, action:$action}
    if $id != nil then $body.id = $id end
    publish("desktop.clipboard.changed", json_encode($body))
  catch $err
    -- Best effort: a failed publish never fails the mutation.
  end
end

fn history_publish_action($ctx, $action)
  -- A control event (menu toggle): same topic, no revision semantics.
  history_publish($ctx, $action, nil)
end

fn history_find($h, $text)
  for each $i in range(0, len($h.entries) - 1)
    if $h.entries[$i].text == $text then return $i end
  end
  return nil
end

fn history_find_id($h, $id)
  for each $i in range(0, len($h.entries) - 1)
    if $h.entries[$i].id == $id then return $i end
  end
  return nil
end

fn history_capture($ctx, $text)
  -- Returns {context?, body}; context present only when state committed.
  $h = $ctx.history
  if $h.paused then
    return {body:{stored:false, reason:"paused"}}
  end
  $bytes = byte_length($text)
  if $bytes > $h.cap_bytes then
    -- Never stored, never truncated: the skip is counted, not remembered.
    $h.skipped = $h.skipped + 1
    $h.revision = $h.revision + 1
    $save = history_persist($h)
    $ctx.history = $save.h
    history_publish($ctx, "skip", nil)
    return {context:$ctx, body:{stored:false, reason:"oversize", bytes:$bytes, skipped:$h.skipped, persisted:$save.persisted}}
  end
  $idx = history_find($h, $text)
  if $idx != nil then
    if $idx == 0 then
      -- A re-copy of the newest entry (or the watcher echo of our own pick)
      -- is a no-op: no revision bump, no write, no event.
      return {body:{stored:false, reason:"duplicate", id:$h.entries[0].id}}
    end
    $entry = $h.entries[$idx]
    $h.entries = concat([$entry], list_remove($h.entries, $idx))
    $h.used = history_used($h.entries)
    $h.revision = $h.revision + 1
    $save = history_persist($h)
    $ctx.history = $save.h
    history_publish($ctx, "capture", $entry.id)
    return {context:$ctx, body:{stored:true, id:$entry.id, duplicate:true, persisted:$save.persisted}}
  end
  $entry = {id:$h.next_id, text:$text, bytes:$bytes, at:time()}
  $h.next_id = $h.next_id + 1
  $h.entries = concat([$entry], $h.entries)
  while len($h.entries) > $h.depth or history_used($h.entries) > $h.budget_bytes
    $h.entries = list_remove($h.entries, len($h.entries) - 1)
  end
  $h.used = history_used($h.entries)
  $h.revision = $h.revision + 1
  $save = history_persist($h)
  $ctx.history = $save.h
  history_publish($ctx, "capture", $entry.id)
  return {context:$ctx, body:{stored:true, id:$entry.id, persisted:$save.persisted}}
end

fn history_preview($text)
  $p = slice($text, 0, 80)
  $p = replace($p, "\r", "")
  $p = replace($p, "\n", "⏎")
  $p = replace($p, "\t", "␉")
  if len($text) > 80 then $p = $p .. "…" end
  return $p
end

-- ── Session configuration ───────────────────────────────────────────────

fn session_config($config)
  if type($config) != "map" or type($config.session) != "string" or not re_match($config.session, "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$") then
    raise("DESKTOP_CONFIG", "session must be a short Bus-safe name")
  end
  $opener = $config.opener
  if type($opener) != "string" or not starts_with($opener, "/") then
    raise("DESKTOP_CONFIG", "opener must be an absolute executable path")
  end
  $mesh_nodes = $config.mesh_clipboard_nodes
  if $mesh_nodes == nil then $mesh_nodes = [] end
  if type($mesh_nodes) != "list" or len($mesh_nodes) > 32 then raise("DESKTOP_CONFIG","invalid mesh clipboard grants") end
  for each $node in $mesh_nodes
    if type($node) != "string" or not re_match($node,"^[a-z][a-z0-9-]{0,23}$") then raise("DESKTOP_CONFIG","invalid mesh node") end
  end
  -- History read grants are an explicit SUBSET of the clipboard transfer
  -- grants: a node may read this session's history only where it may already
  -- read its selection, and only by being named twice.
  $mesh_history = $config.mesh_history_nodes
  if $mesh_history == nil then $mesh_history = [] end
  if type($mesh_history) != "list" or len($mesh_history) > 32 then raise("DESKTOP_CONFIG","invalid mesh history grants") end
  for each $node in $mesh_history
    if type($node) != "string" or not re_match($node,"^[a-z][a-z0-9-]{0,23}$") then raise("DESKTOP_CONFIG","invalid mesh history node") end
    if not contains($mesh_nodes, $node) then raise("DESKTOP_CONFIG","mesh history grant without clipboard grant: " .. $node) end
  end
  return {session:$config.session, instance:uuid(), max_bytes:65536,
    mesh_nodes:$mesh_nodes, mesh_history_nodes:$mesh_history,
    wayland:env("WAYLAND_DISPLAY"), runtime:env("XDG_RUNTIME_DIR"),
    copy:which("wl-copy"), paste:which("wl-paste"), opener:$opener,
    history:history_state($config.history, $config.session)}
end

fn target_ok($target)
  return type($target) == "string" and re_match($target,"^[a-z][a-z0-9-]{1,30}(\\.[a-z][a-z0-9-]{0,23}\\.bus)?$")
end

fn caller_allowed($ctx,$verb,$headers)
  if $headers.broker_origin == "local" then
    return type($headers.from) == "string" and re_match($headers.from,"^[a-z][a-z0-9-]{1,30}$")
  end
  if $headers.broker_origin != "mesh" then return false end
  -- FULL MESH ACCESS TO EVERY VERB (Mark, 2026-09-15; supersedes the
  -- 2026-09-14 clipboard-only open posture): a mesh caller reaches EVERY verb
  -- of this citizen — menu, rotate, capture, pick, clear, pause, open included
  -- — on WG membership alone. `broker_origin` is set by noded from the source
  -- IP and is not forgeable, so `broker_origin=="mesh"` already proves an
  -- admitted WG peer; the WG /24 + signed inventory is the trust boundary.
  -- What survives is correctness, not authorization: the `instance` staleness
  -- fence in prepare() still applies to mesh callers exactly as to local ones.
  if env("COSMIX_MESH_OPEN", "1") != "0" then return true end
  -- Opt-in lock-down (COSMIX_MESH_OPEN=0): transfer verbs ride the clipboard
  -- grants; history reads (previews and entry fetch for pick-remote) ride the
  -- explicit history subset; every other verb is local-only; and each grant
  -- needs the strict per-peer bridge attestation (grants + from=bridge-<peer>
  -- + broker_service).
  $grants = []
  if contains(["desktop.capabilities","desktop.clipboard.read","desktop.clipboard.write"],$verb) then
    $grants = $ctx.mesh_nodes
  elif contains(["desktop.clipboard.history","desktop.clipboard.entry"],$verb) then
    $grants = $ctx.mesh_history_nodes
  else
    return false
  end
  if type($grants) != "list" or type($headers.broker_peer) != "string" or not contains($grants,$headers.broker_peer) then return false end
  return $headers.from == "bridge-" .. $headers.broker_peer and type($headers.broker_service) == "string" and re_match($headers.broker_service,"^[a-z][a-z0-9-]{1,30}$")
end

fn history_capabilities($ctx)
  $h = $ctx.history
  $persistence = "ok"
  if $h.degraded != "" then
    $persistence = $h.degraded
  elif $h.save_failed then
    $persistence = "write-error"
  end
  return {depth:$h.depth, cap_bytes:$h.cap_bytes, budget_bytes:$h.budget_bytes,
    used_bytes:$h.used, entries:len($h.entries), skipped:$h.skipped,
    paused:$h.paused, revision:$h.revision,
    persistence:$persistence,
    topic:"desktop.clipboard.changed"}
end

fn prepare($ctx, $verb, $headers, $body, $raw_bytes)
  -- noded owns the origin/peer/service stamps. No raw claimed sender is a grant.
  if not caller_allowed($ctx,$verb,$headers) then
    return error("CALLER_NOT_AUTHORISED", 13)
  end
  if $raw_bytes > 400000 then return error("REQUEST_TOO_LARGE", 10) end
  if $verb == "desktop.capabilities" then
    if not keys_are($body, []) then return error("INVALID_REQUEST", 10) end
    $clipboard = $ctx.copy != nil and $ctx.paste != nil and $ctx.wayland != "" and $ctx.runtime != ""
    return {rc:0, body:{api_version:1, implementation_version:"0.3.6", session:$ctx.session,
      instance:$ctx.instance, access:"registered-local-with-explicit-mesh-clipboard-grants", max_text_bytes:$ctx.max_bytes,
      -- history_mesh: granted peers may read history previews and entries.
      history_mesh:{granted:len($ctx.mesh_history_nodes == nil ? [] : $ctx.mesh_history_nodes)},
      clipboard:{configured:$clipboard, mime:"text/plain;charset=utf-8", history:history_capabilities($ctx)},
      open:{configured:is_executable($ctx.opener), schemes:["http","https"]},
      verbs:["desktop.capabilities","desktop.clipboard.read","desktop.clipboard.write","desktop.clipboard.capture","desktop.clipboard.history","desktop.clipboard.entry","desktop.clipboard.pick","desktop.clipboard.rotate","desktop.clipboard.menu","desktop.clipboard.clear","desktop.clipboard.pause","desktop.open"]}}
  end
  if $verb == "desktop.clipboard.capture" then
    -- The watcher path: a registered local citizen submits observed text.
    -- No instance fence: the fence is a staleness guard for caller-held
    -- handles, not a trust boundary (any local caller can read the live
    -- instance from desktop.capabilities anyway) — and the watcher, a
    -- per-event one-shot, would have to fetch it for every selection.
    if not keys_are($body, ["text"]) then return error("INVALID_REQUEST", 10) end
    -- Empty text is refused: the watcher never emits it (a data selection
    -- always has bytes), so it can only be a direct caller's mistake.
    if type($body.text) != "string" or len($body.text) == 0 or contains($body.text, $_nul) then return error("INVALID_CLIPBOARD_TEXT", 10) end
    $outcome = history_capture($ctx, $body.text)
    $body_out = merge_maps({instance:$ctx.instance}, $outcome.body)
    if $outcome.context != nil then
      return {rc:0, body:$body_out, context:$outcome.context}
    end
    return {rc:0, body:$body_out}
  end
  $expected = ["instance"]
  if $verb == "desktop.clipboard.write" then $expected = ["instance","text"]
  elif $verb == "desktop.open" then $expected = ["instance","url"]
  elif $verb == "desktop.clipboard.entry" then $expected = ["instance","id"]
  elif $verb == "desktop.clipboard.pick" then $expected = ["instance","id"]
  elif $verb == "desktop.clipboard.pause" then $expected = ["instance","on"]
  elif $verb == "desktop.clipboard.rotate" or $verb == "desktop.clipboard.menu" then
    -- Keybind surfaces: inputd fires these from a static keymap row with an
    -- empty body, and a static row cannot carry the uuid minted at citizen
    -- start. So `instance` is OPTIONAL here — same reasoning as capture: the
    -- fence is a staleness guard for caller-held handles, not a trust
    -- boundary (any caller, local or mesh, can read the live instance from
    -- desktop.capabilities). When a
    -- caller does send `instance`, it is still checked and a stale one is
    -- refused exactly as before.
    if not keys_subset($body, [], ["instance"]) then return error("INVALID_REQUEST", 10) end
    if $body.instance != nil and $body.instance != $ctx.instance then return error("STALE_SESSION", 12) end
  elif $verb != "desktop.clipboard.read" and $verb != "desktop.clipboard.history" and $verb != "desktop.clipboard.clear" then
    return error("UNKNOWN_COMMAND", 10)
  end
  $fence_optional = $verb == "desktop.clipboard.rotate" or $verb == "desktop.clipboard.menu"
  if not $fence_optional and $verb != "desktop.clipboard.history" and $verb != "desktop.clipboard.clear" and not keys_are($body, $expected) then
    return error("INVALID_REQUEST", 10)
  end
  if $verb == "desktop.clipboard.history" and not keys_subset($body, ["instance"], ["q","offset","limit"]) then return error("INVALID_REQUEST", 10) end
  if $verb == "desktop.clipboard.clear" and not keys_subset($body, ["instance"], ["id"]) then return error("INVALID_REQUEST", 10) end
  if not $fence_optional and $body.instance != $ctx.instance then return error("STALE_SESSION", 12) end
  if $verb == "desktop.clipboard.history" then
    $q = $body.q == nil ? "" : $body.q
    $offset = $body.offset == nil ? 0 : $body.offset
    $limit = $body.limit == nil ? 20 : $body.limit
    if type($q) != "string" or byte_length($q) > 256 then return error("INVALID_REQUEST", 10) end
    if not is_int($offset) or $offset < 0 or $offset > 1000000 then return error("INVALID_REQUEST", 10) end
    if not is_int($limit) or $limit < 1 or $limit > 100 then return error("INVALID_REQUEST", 10) end
    $h = $ctx.history
    $filtered = []
    for each $entry in $h.entries
      if $q == "" or contains($entry.text, $q) then $filtered = concat($filtered, [$entry]) end
    end
    $page = []
    for each $entry in list_page($filtered, $offset, $limit)
      $page = concat($page, [{id:$entry.id, bytes:$entry.bytes, at:$entry.at, preview:history_preview($entry.text)}])
    end
    return {rc:0, body:{instance:$ctx.instance, revision:$h.revision, total:len($filtered), offset:$offset, limit:$limit, entries:$page}}
  end
  if $verb == "desktop.clipboard.entry" then
    if not is_int($body.id) or $body.id < 1 then return error("INVALID_REQUEST", 10) end
    $idx = history_find_id($ctx.history, $body.id)
    if $idx == nil then return error("ENTRY_NOT_FOUND", 14) end
    $entry = $ctx.history.entries[$idx]
    return {rc:0, body:{instance:$ctx.instance, id:$entry.id, text:$entry.text, bytes:$entry.bytes, mime:"text/plain;charset=utf-8"}}
  end
  if $verb == "desktop.clipboard.clear" then
    $h = $ctx.history
    if $body.id != nil then
      if not is_int($body.id) or $body.id < 1 then return error("INVALID_REQUEST", 10) end
      $idx = history_find_id($h, $body.id)
      if $idx == nil then return error("ENTRY_NOT_FOUND", 14) end
      $h.entries = list_remove($h.entries, $idx)
      $h.used = history_used($h.entries)
      $h.revision = $h.revision + 1
      $save = history_persist($h)
      $ctx.history = $save.h
      history_publish($ctx, "clear", $body.id)
      return {rc:0, body:{instance:$ctx.instance, removed:1, persisted:$save.persisted}, context:$ctx}
    end
    $removed = len($h.entries)
    if $removed > 0 then
      $h.entries = []
      $h.used = 0
      $h.revision = $h.revision + 1
      $save = history_persist($h)
      $ctx.history = $save.h
      history_publish($ctx, "clear", nil)
      return {rc:0, body:{instance:$ctx.instance, removed:$removed, persisted:$save.persisted}, context:$ctx}
    end
    return {rc:0, body:{instance:$ctx.instance, removed:0, persisted:($h.degraded == "" and not $h.save_failed)}}
  end
  if $verb == "desktop.clipboard.pause" then
    if type($body.on) != "bool" then return error("INVALID_REQUEST", 10) end
    $h = $ctx.history
    if $h.paused == $body.on then
      return {rc:0, body:{instance:$ctx.instance, paused:$body.on, persisted:($h.degraded == "" and not $h.save_failed)}}
    end
    $h.paused = $body.on
    $save = history_persist($h)
    $ctx.history = $save.h
    return {rc:0, body:{instance:$ctx.instance, paused:$body.on, persisted:$save.persisted}, context:$ctx}
  end
  if $verb == "desktop.clipboard.pick" then
    if not is_int($body.id) or $body.id < 1 then return error("INVALID_REQUEST", 10) end
    $idx = history_find_id($ctx.history, $body.id)
    if $idx == nil then return error("ENTRY_NOT_FOUND", 14) end
    if $ctx.copy == nil or $ctx.wayland == "" or $ctx.runtime == "" then
      return error("CLIPBOARD_UNAVAILABLE", 11)
    end
    $entry = $ctx.history.entries[$idx]
    -- The wl-copy helper runs first; the ring commit happens in finish().
    return {action:"clipboard_pick", entry_id:$entry.id, entry_index:$idx,
      argv:[$ctx.copy,"--type","text/plain;charset=utf-8"],
      options:{timeout:5, stdin:$entry.text, stdout:"null", stderr:"null"}}
  end
  if $verb == "desktop.clipboard.rotate" then
    -- The clipboard ring: front goes to the back, the next entry becomes the
    -- live selection. One keypress cycles through history with no GUI.
    $h = $ctx.history
    if len($h.entries) < 2 then
      return {rc:0, body:{instance:$ctx.instance, rotated:false, total:len($h.entries)}}
    end
    if $ctx.copy == nil or $ctx.wayland == "" or $ctx.runtime == "" then
      return error("CLIPBOARD_UNAVAILABLE", 11)
    end
    return {action:"clipboard_rotate",
      argv:[$ctx.copy,"--type","text/plain;charset=utf-8"],
      options:{timeout:5, stdin:$h.entries[1].text, stdout:"null", stderr:"null"}}
  end
  if $verb == "desktop.clipboard.menu" then
    -- Keybind surface: publish a menu event; the picker panel toggles on it.
    -- No state change, no revision bump.
    history_publish_action($ctx, "menu")
    return {rc:0, body:{instance:$ctx.instance, menu:true}}
  end
  if $verb == "desktop.open" then
    if type($body.url) != "string" or byte_length($body.url) > 8192 or not re_match($body.url, "^https?://[^/?#[:space:][:cntrl:]]+([/?#][^[:space:][:cntrl:]]*)?$") then
      return error("INVALID_HTTP_URL", 10)
    end
    if not is_executable($ctx.opener) then return error("OPENER_UNAVAILABLE", 11) end
    return {action:"open", argv:[$ctx.opener,$body.url], options:{timeout:5, stdin:{null:true}, stdout:"null", stderr:"null"}}
  end
  if $ctx.copy == nil or $ctx.paste == nil or $ctx.wayland == "" or $ctx.runtime == "" then
    return error("CLIPBOARD_UNAVAILABLE", 11)
  end
  if $verb == "desktop.clipboard.read" then
    return {action:"read", argv:[$ctx.paste,"--no-newline","--type","text"],
      options:{timeout:5, stdin:{null:true}, max_output:$ctx.max_bytes + 1, stderr:"null"}}
  end
  if type($body.text) != "string" or byte_length($body.text) > $ctx.max_bytes or contains($body.text, $_nul) then
    return error("INVALID_CLIPBOARD_TEXT", 10)
  end
  return {action:"write", bytes:byte_length($body.text), argv:[$ctx.copy,"--type","text/plain;charset=utf-8"],
    options:{timeout:5, stdin:$body.text, stdout:"null", stderr:"null"}}
end

fn is_executable($path)
  return run_argv(["test","-x",$path], {timeout:2, stdout:"null", stderr:"null"}).ok
end

fn finish($ctx, $plan, $result)
  if not $result.ok then
    if $result.timed_out then return error("ACTION_OUTCOME_UNKNOWN", 20) end
    return error("HELPER_FAILED", 11)
  end
  if $plan.action == "read" then
    if $result.stdout_truncated or $result.utf8_lossy or byte_length($result.stdout) > $ctx.max_bytes or contains($result.stdout, $_nul) then
      return error("INVALID_CLIPBOARD_TEXT", 10)
    end
    return {rc:0, body:{instance:$ctx.instance, mime:"text/plain;charset=utf-8", text:$result.stdout, bytes:byte_length($result.stdout)}}
  end
  if $plan.action == "clipboard_pick" then
    -- The helper succeeded: commit the move-to-front now. Wayland and disk
    -- are not one transaction; persisted:false reports a partial commit.
    -- The entry is re-found BY ID, never via the prepare-time index: plain
    -- handlers are serialised today, but if pick ever goes async a capture
    -- landing during the helper window would shift the ring and move the
    -- wrong entry.
    $h = $ctx.history
    $idx = history_find_id($h, $plan.entry_id)
    if $idx == nil then
      -- The entry was cleared while the helper ran. The selection IS set;
      -- there is simply nothing to move.
      return {rc:0, body:{instance:$ctx.instance, id:$plan.entry_id, accepted:true, moved:false, persisted:true}}
    end
    if $idx != 0 then
      $entry = $h.entries[$idx]
      $h.entries = concat([$entry], list_remove($h.entries, $idx))
      $h.used = history_used($h.entries)
      $h.revision = $h.revision + 1
      $save = history_persist($h)
      $ctx.history = $save.h
      history_publish($ctx, "pick", $entry.id)
      return {rc:0, body:{instance:$ctx.instance, id:$entry.id, accepted:true, moved:true, bytes:$entry.bytes, persisted:$save.persisted}, context:$ctx}
    end
    return {rc:0, body:{instance:$ctx.instance, id:$plan.entry_id, accepted:true, moved:false, bytes:$h.entries[0].bytes, persisted:($h.degraded == "" and not $h.save_failed)}}
  end
  if $plan.action == "clipboard_rotate" then
    -- Helper succeeded: front entry to the back; the new front is now live.
    $h = $ctx.history
    $front = $h.entries[0]
    $h.entries = concat(list_remove($h.entries, 0), [$front])
    $h.used = history_used($h.entries)
    $h.revision = $h.revision + 1
    $save = history_persist($h)
    $ctx.history = $save.h
    history_publish($ctx, "pick", $h.entries[0].id)
    return {rc:0, body:{instance:$ctx.instance, rotated:true, id:$h.entries[0].id, persisted:$save.persisted}, context:$ctx}
  end
  if $plan.action == "write" then
    return {rc:0, body:{instance:$ctx.instance, accepted:true, bytes:$plan.bytes}}
  end
  return {rc:0, body:{instance:$ctx.instance, accepted:true}}
end
