-- Workspace-switching library for the `desktop` citizen
-- (../desktop-workspace.mix): request validation and reply shaping as pure
-- functions (no `on` handlers, no Bus). The citizen and the unit test
-- (../tests/workspace-test.mix) both require this module.
--
-- The citizen translates desktop.workspace.* into cosmix-comp's workspace
-- verbs. prepare() turns a request into either a refusal {rc, body} or a
-- plan {kind, send: {service, verb, body}} naming exactly one comp call;
-- finish() turns comp's answer into the reply {ok, backend, desktop}.
--
-- next/prev send comp {index: "next"|"prev", wrap: true}: comp owns the
-- workspace count, so the wrap at either end happens in comp, and `wrap` is
-- sent explicitly so the citizen's behaviour does not ride comp's default.

fn comp_service()
  -- The comp Bus service the citizen forwards to (a nested comp registers
  -- under another name).
  return env("COSMIX_DESKTOP_COMP_SERVICE", "comp")
end

fn max_desktop()
  return 64
end

fn refuse($message)
  return {rc: 10, body: {ok: false, error: $message}}
end

fn request_args($body)
  -- {ok, args} for an empty body or a JSON object; {ok:false, error} else.
  if $body == nil or trim($body) == "" then
    return {ok: true, args: {}}
  end
  $v = nil
  try
    $v = json_parse($body)
  catch $err
    return {ok: false, error: "body is not JSON"}
  end
  if type($v) != "map" then
    return {ok: false, error: "body must be a JSON object"}
  end
  return {ok: true, args: $v}
end

fn only_fields($args, $allowed)
  -- The first field of $args not in $allowed, or nil.
  for each $k in keys($args)
    if not contains($allowed, $k) then
      return $k
    end
  end
  return nil
end

fn desktop_index($args)
  -- A 1-based integer <= max_desktop() from {n}, or nil.
  if not has_key($args, "n") then
    return nil
  end
  $n = $args["n"]
  if type($n) != "number" or $n < 1 or $n > max_desktop() or floor($n) != $n then
    return nil
  end
  return $n
end

fn switch_plan($index)
  return {kind: "switch", send: {service: comp_service(), verb: "comp.workspace.switch", body: {index: $index, wrap: true}}}
end

fn prepare($verb, $body)
  -- $verb is the event's command, $body its raw body string.
  $parsed = request_args($body)
  if not $parsed.ok then
    return refuse($verb .. ": " .. $parsed.error)
  end
  $args = $parsed.args
  if $verb == "desktop.workspace.next" or $verb == "desktop.workspace.prev" or $verb == "desktop.workspace.current" then
    $extra = only_fields($args, [])
    if $extra != nil then
      return refuse($verb .. " takes no fields (got " .. $extra .. ")")
    end
    if $verb == "desktop.workspace.next" then
      return switch_plan("next")
    end
    if $verb == "desktop.workspace.prev" then
      return switch_plan("prev")
    end
    return {kind: "current", send: {service: comp_service(), verb: "comp.props.get", body: {path: "workspaces.current"}}}
  end
  if $verb == "desktop.workspace.set" then
    $extra = only_fields($args, ["n"])
    $n = desktop_index($args)
    if $extra != nil or $n == nil then
      return refuse("desktop.workspace.set needs exactly {n: <1.." .. to_string(max_desktop()) .. ">}")
    end
    return switch_plan($n)
  end
  return refuse("unknown verb " .. $verb)
end

fn decoded($r)
  if type($r) == "string" and starts_with(trim($r), "{") then
    try
      return json_parse($r)
    catch $err
      return $r
    end
  end
  return $r
end

fn failed($rc, $message)
  $code = $rc
  if type($code) != "number" or $code < 1 or $code > 255 then
    $code = 1
  end
  return {rc: $code, body: {ok: false, backend: "comp", error: $message}}
end

fn finish($plan, $rc, $result)
  -- The reply for comp's answer ($rc/$result of the plan's send).
  -- Success: {rc:0, body:{ok:true, backend:"comp", desktop:N}}. A comp
  -- refusal or an unreachable comp keeps comp's rc (transport failures,
  -- which are negative, become 1) and carries its text in `error`.
  if $rc != 0 then
    return failed($rc, to_string($result))
  end
  $r = decoded($result)
  if $plan.kind == "switch" then
    if type($r) == "map" and has_key($r, "to") and type($r["to"]) == "number" then
      return {rc: 0, body: {ok: true, backend: "comp", desktop: $r["to"]}}
    end
    return failed(1, "unexpected comp.workspace.switch reply: " .. json_encode($r))
  end
  if type($r) == "number" then
    return {rc: 0, body: {ok: true, backend: "comp", desktop: $r}}
  end
  return failed(1, "unexpected workspaces.current value: " .. json_encode($r))
end
