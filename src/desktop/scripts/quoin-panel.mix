-- version: 0.2.0
-- quoin-panel -- the Quoin bottom panel and its popups, written as Mix
-- Scenes after Plasma's default panel. One citizen owns four scenes:
--
--   panel     bottom edge, pinned: launcher button, workspace pager, task
--             buttons, tray icons, status applets (notifications, volume,
--             network), the clock (big time, date beneath), peek-at-desktop
--   launcher  left edge: search + every visible .desktop application (the
--             `apps` citizen), click = launch
--   calendar  right edge: month grid, Monday first, today marked; opened by
--             clicking the clock
--   notes     right edge: live notifications (the `notify` adapter)
--
-- All four are registered sub-panels (shell refactor phase 1): mounting a
-- document registers its name (scene-<name>) on its edge, so every scene is
-- mounted at startup and again whenever a fresh host is detected (panel
-- revision 1); a refused mount is retried on the next panel render. A closed
-- popup keeps its registration and its content, which stays current (the
-- shell can reveal a registered page itself) -- only its edge is released.
-- Opening selects the page, reveals it
-- (shell.panel.show) and pins the edge (the legacy pin still reserves the
-- popup's space); phase 2 replaces that with named activation.
--
-- Run: mix --serve quoin-panel.mix --name quoin-panel
-- Env: SCENE_HOST (default shell), COMP_SERVICE (comp), APPS_SERVICE (apps),
--      TRAY_SERVICE (tray), NOTIFY_SERVICE (notify) -- a nested dev desktop
--      points these elsewhere. Manual: docs/cos/quoin-panel.md.
--
-- Event-driven: the taskbar and pager rebuild on the compositor's
-- props.changed topic, the tray and notifications on their adapters'
-- events. The one clock is the wall clock itself: an async handler kicked
-- once by init sleeps to each minute boundary, one wake per minute, never a
-- poll of anyone's state.
$p = require("lib/panel.mix")

-- Our own Bus name goes into every scene document's `citizen:` field, which
-- is where Quoin routes the document's clicks. It must be the name THIS
-- instance registered under (`mix --serve … --name`): a second instance (the
-- nested dev stack's `quoin-panel-n`) that still said "quoin-panel" had its
-- clicks delivered to the LIVE panel (found 2026-09-24 by the chunk-21 gate).
-- `serve_name()` (mix 0.91.0) is the name this citizen registered under;
-- PANEL_NAME stays as the override for a pre-0.91 mix (it returns nil there
-- only if the builtin is missing — has_builtin guards the call so an old
-- interpreter does not raise on an unknown name).
$ME = has_builtin("serve_name") ? (serve_name() ?? env("PANEL_NAME", "quoin-panel")) : env("PANEL_NAME", "quoin-panel")
$HOST = env("SCENE_HOST", "shell")
$COMP = env("COMP_SERVICE", "comp")
$APPS = env("APPS_SERVICE", "apps")
$TRAY = env("TRAY_SERVICE", "tray")
$NOTIFY = env("NOTIFY_SERVICE", "notify")
-- Status icons come from the dark variant so they read on the dark panel.
$ICON_THEME = env("PANEL_ICON_THEME", "breeze-dark")
-- PipeWire lives in the login session's runtime dir, not the desktop's.
$PW_RUNTIME = env("PIPEWIRE_RUNTIME_DIR", "/run/user/" .. to_string(uid()))
$LOG = env("XDG_RUNTIME_DIR", "/tmp") .. "/quoin-panel.log"

-- Breeze Dark, the palette Plasma's panel uses.
$C = {
  panel: "#202326f2", fg: "#fcfcfc", dim: "#a1a9b1", faint: "#6e7680",
  hover: "#ffffff1a", press: "#ffffff29", accent: "#3daee9",
  accent_bg: "#3daee940", task_bg: "#ffffff0f", card: "#2a2e32",
  today_fg: "#ffffff", weekend: "#c9cfd6"
}

$state = {
  windows: [], ws_count: 1, ws_current: 1, tray: [],
  net: {up: false, wireless: false}, vol: {ok: false, level: 0, muted: false},
  notes: [], notes_open: false, peeked: [],
  launcher_open: false, calendar_open: false,
  query: "", category: "", apps: [], apps_loaded: false,
  apps_query: nil, apps_category: nil,
  launcher_shown: false, calendar_shown: false, notes_shown: false,
  cal_offset: 0, icons: {},
  popup_gen: 0, clock_running: false, peek_busy: false, dirty: false, scheduled: false,
  -- per-page registration (a load the host accepted, revision > 0), the
  -- register pass in flight, and whether this host generation has selected
  -- and pinned the taskbar page yet
  reg_launcher: false, reg_calendar: false, reg_notes: false,
  applied_panels: {}, pending_panels: {}, live_services: [],
  panel_op_seq: 0, panel_drivers: {}, resyncing: false,
  registering: false, panel_shown: false,
  -- consecutive show_page refusals this host generation; past PANEL_SHOW_CAP
  -- we stop resubmitting refused selections on every render (a host that keeps
  -- refusing its own bottom edge is a host bug, logged once per attempt)
  panel_show_fails: 0
}
$PANEL_SHOW_CAP = 5

fn note($line)
  try
    append_file($LOG, to_string(floor(time())) .. " " .. $line .. "\n")
  catch $e
  end
end

-- ── Bus helpers ─────────────────────────────────────────────────────────
fn rc_ok($code)
  return $code >= 0 and $code < 10
end

fn rpc($target, $verb, $payload)
  send $target $verb body=json_encode($payload) timeout=3
  if not rc_ok($rc) then return nil end
  if type($result) == "string" then
    try
      return json_parse($result)
    catch $e
      return nil
    end
  end
  return $result
end

-- Load a document; returns the host's revision for it (0 = refused or no
-- host). The host counts revisions per scene NAME and restarts them at 1
-- only when the HOST restarts (a citizen restart continues mid-stream), so
-- revision 1 of the panel is how the panel notices a Quoin restart.
fn load_scene($doc)
  send $HOST shell.scene.load body=$doc timeout=5
  if not rc_ok($rc) then
    note("scene.load rc=" .. to_string($rc) .. " " .. to_string($result))
    return 0
  end
  $r = $result
  if type($r) == "string" then
    try
      $r = json_parse($r)
    catch $e
      return 0
    end
  end
  return (type($r) == "map" and $r.revision != nil) ? $r.revision : 0
end

fn panel_verb($verb, $edge, $id)
  if $verb == "shell.panel.mode" then
    send $HOST $verb edge=$edge mode="hidden" timeout=3
  elif $id == nil then
    send $HOST $verb edge=$edge timeout=3
  else
    send $HOST $verb edge=$edge id=$id timeout=3
  end
  $ok = rc_ok($rc)
  $receipt = $result
  if type($receipt) == "string" then
    try
      $receipt = json_parse($receipt)
    catch $err
      $receipt = nil
    end
  end
  if type($receipt) != "map" then $receipt = {} end
  -- Even a timeout may have applied. Replies and reads drive progress;
  -- notifications are only invalidation hints, including our own echoes.
  if not refresh_panels() and $receipt.applied == true and type($receipt.panels) == "map" then
    -- A failed read cannot discard an authoritative application receipt.
    $state.applied_panels = $receipt.panels
  end
  return $ok
end

fn refresh_panels()
  $snapshot = rpc($HOST, "shell.props.get", {})
  $state.applied_panels = ($snapshot ?? {}).panels ?? {}
  return type(($snapshot ?? {}).panels) == "map"
end

fn queue_panel($edge, $page, $flag, $gen, $phase)
  $state.panel_op_seq = $state.panel_op_seq + 1
  $state.pending_panels[$edge] = {page:$page, phase:$phase, flag:$flag,
    generation:$gen, token:$state.panel_op_seq, refused:false}
end

-- Queue page selection and consume applied replies/readback immediately.
fn select_page($edge, $page)
  if ($state.pending_panels[$edge] ?? {}).page == $page then
    drive_panel_operations()
    return true
  end
  queue_panel($edge, $page, nil, $state.popup_gen, "select")
  drive_panel_operations()
  return true
end

-- Select a scene page and pin its edge open; false when the page could not
-- be selected (so the wrong page is never pinned) OR the pin was refused, so a
-- caller that records success (panel_shown) keeps retrying until the edge is
-- actually pinned.
fn show_page($edge, $page)
  return select_page($edge, $page)
end

-- Legacy Bus unpin releases BOTH Pinned and Docked. This is also the
-- compatibility rule for bare-array popup records: a legacy saved true
-- migrates to Docked, and still needs its reservation released here.
-- Quoin replies after application and concealment. Keep the recovery record
-- unless a read confirms BOTH persistence and visibility are clear.
fn hide_edge($edge)
  queue_panel($edge, nil, nil, $state.popup_gen, "release")
  drive_panel_operations()
  return $state.applied_panels[$edge]
end

fn drive_panel_operations()
  for each $edge in keys($state.pending_panels)
    drive_panel_edge($edge)
  end
end

fn drive_panel_edge($edge)
  if $state.panel_drivers[$edge] ?? false then return end
  $state.panel_drivers[$edge] = true
  try
    refresh_panels()
    -- Drain phase transitions and operations queued during a yield. This is
    -- not a retry poll: each action is sent at most once per operation here.
    $attempted = {}
    while true
      $op = $state.pending_panels[$edge]
      if $op == nil then break end
      if ($op.phase == "release" and edge_in_use($edge)) or ($op.flag != nil and not popup_live($op.flag, $op.generation)) then
        $state.pending_panels = delete($state.pending_panels, $edge)
        continue
      end
      $applied = $state.applied_panels[$edge]
      $action = $p.panel_action($op, $applied)
      if $action == nil then break end
      if $action == "done" then
        if $op.phase == "release" then
          write_pins($p.released_popup_pins(read_pins(), $edge, $applied))
        end
        $state.pending_panels = delete($state.pending_panels, $edge)
        break
      end
      $key = to_string($op.token) .. ":" .. $action
      if $attempted[$key] ?? false then break end
      $attempted[$key] = true
      $verb = $action == "release" ? "shell.panel.mode" : ($action == "select" ? "shell.panel.page.set" : "shell.panel.pin")
      $ok = panel_verb($verb, $edge, $action == "select" ? $op.page : nil)
      if not $p.panel_operation_current($state.pending_panels, $edge, $op.token) then continue end
      $state.pending_panels[$edge].refused = not $ok
      -- An applied state can confirm success even if the reply was lost.
      if not $ok and $p.panel_action($op, $state.applied_panels[$edge]) != "done" then break end
    end
  finally
    $state.panel_drivers[$edge] = false
  end
  update_shown()
end

-- ── icons (the apps citizen resolves themes; cached here) ───────────────
fn icon_path($name, $size)
  return icon_path_t($name, $size, "")
end

-- Themed lookup; "" = the apps citizen's default (the user's theme).
fn icon_path_t($name, $size, $theme)
  if $name == nil or $name == "" then return "" end
  $key = $name .. "@" .. to_string($size) .. "@" .. $theme
  if has_key($state.icons, $key) then return $state.icons[$key] end
  $req = {name: $name, size: $size}
  if $theme != "" then $req.theme = $theme end
  $hit = rpc($APPS, "apps.icon", $req)
  $path = ($hit != nil and type($hit) == "map" and $hit.path != nil) ? $hit.path : ""
  -- Cache hits only: a miss (apps not up yet, theme mid-install) is asked
  -- again next time rather than remembered forever.
  if $path != "" then cache_icon($key, $path) end
  return $path
end

-- Bounded memo: past 512 entries start afresh (every entry is re-derivable
-- with one apps.icon call; a panel sees far fewer distinct icons than this).
fn cache_icon($key, $path)
  $icons = $state.icons
  if length(keys($icons)) >= 512 then $icons = {} end
  $icons[$key] = $path
  $state.icons = $icons
end

-- A compositor app_id to an icon: the desktop entry's Icon= when one
-- matches (the apps registry keys entries by desktop-file id without the
-- .desktop suffix; tried as-is, then lower-case), else the app_id as an
-- icon name, else a generic window icon.
fn window_icon($app_id)
  $key = "win:" .. to_string($app_id)
  if has_key($state.icons, $key) then return $state.icons[$key] end
  $icon_name = ""
  if $app_id != nil and $app_id != "" then
    for each $candidate in [$app_id, lower($app_id)]
      if $icon_name == "" then
        $entry = rpc($APPS, "apps.get", {id: $candidate})
        if $entry != nil and type($entry) == "map" and $entry.icon != nil then $icon_name = $entry.icon end
      end
    end
    if $icon_name == "" then $icon_name = $app_id end
  end
  $path = icon_path($icon_name, 48)
  if $path == "" then $path = icon_path("application-x-executable", 48) end
  if $path != "" then cache_icon($key, $path) end
  return $path
end

-- ── data ────────────────────────────────────────────────────────────────
fn fetch_windows()
  $r = rpc($COMP, "comp.windows.list", {})
  if $r == nil or type($r.windows) != "list" then return end
  $out = []
  for each $w in $r.windows
    if $w.band == "normal" then push($out, $w) end
  end
  $state.windows = $p.sort_windows($out)
  $ws = rpc($COMP, "comp.props.get", {path: "workspaces"})
  if $ws != nil and type($ws) == "map" then
    $state.ws_count = $ws.count ?? 1
    $state.ws_current = $ws.current ?? 1
  end
end

fn fetch_tray()
  $r = rpc($TRAY, "tray.list", {})
  if $r == nil or type($r.items) != "list" then
    $state.tray = []
    return
  end
  $state.tray = $r.items
end

-- Network: any non-loopback interface whose operstate is "up" (the kernel's
-- own answer, read from sysfs -- no D-Bus, per the dbusd-boundary ADR).
fn fetch_net()
  $up = false
  $wireless = false
  try
    for each $name in ls("/sys/class/net")
      if $name != "lo" then
        $dir = "/sys/class/net/" .. $name
        $oper = ""
        try
          $oper = trim(read_file($dir .. "/operstate"))
        catch $e
        end
        if $oper == "up" then
          $up = true
          if is_dir($dir .. "/wireless") then $wireless = true end
        end
      end
    end
  catch $e
  end
  $state.net = {up: $up, wireless: $wireless}
end

-- Volume: PipeWire's default sink via wpctl ("Volume: 0.40 [MUTED]"). No
-- default sink -> the applet is hidden rather than showing a false 0 %.
fn fetch_vol()
  $r = run_argv(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], {timeout: 2, env: {XDG_RUNTIME_DIR: $PW_RUNTIME}})
  if not $r.ok then
    $state.vol = {ok: false, level: 0, muted: false}
    return
  end
  $m = re_find($r.stdout, "Volume:\\s*([0-9.]+)")
  if length($m) == 0 then
    $state.vol = {ok: false, level: 0, muted: false}
    return
  end
  $state.vol = {ok: true, level: round(to_number($m[0].groups[0]) * 100), muted: index_of($r.stdout, "MUTED") >= 0}
end

-- Notifications come from the adapter's props tree (notify.props.get):
-- notify.list rows carry no body, the props subtree n<id> has every field.
fn fetch_notes()
  $r = rpc($NOTIFY, "notify.props.get", {})
  if $r == nil or type($r) != "map" then
    $state.notes = []
    return
  end
  $out = []
  for each $key, $n in $r
    if re_match($key, "^n[0-9]+$") and type($n) == "map" then
      push($out, {id: slice($key, 1, length($key)), app: $n.app ?? "", summary: $n.summary ?? "", body: $n.body ?? "", created_at: $n.created_at ?? ""})
    end
  end
  -- oldest first here; notes_doc shows newest first
  $state.notes = sort_by($out, function ($n) = $n.created_at)
end

fn fetch_status()
  fetch_net()
  fetch_vol()
  fetch_notes()
end

fn fetch_apps()
  $query = $state.query
  $category = $state.category
  $r = rpc($APPS, "apps.list", {query: $query, category: $category})
  if $query != $state.query or $category != $state.category then return false end
  $state.apps_query = $query
  $state.apps_category = $category
  if $r == nil or type($r) != "list" then
    $state.apps = []
    $state.apps_loaded = false
    return true
  end
  $state.apps = $r
  $state.apps_loaded = true
  return true
end

fn apps_current()
  return $state.apps_query == $state.query and $state.apps_category == $state.category
end

-- A 20px monochrome status icon from the dark theme, with a fallback icon
-- name, and a text glyph when neither resolves.
fn status_icon($name, $fallback)
  $path = icon_path_t($name, 22, $ICON_THEME)
  if $path == "" then $path = icon_path_t($fallback, 22, $ICON_THEME) end
  if $path == "" then return {widget: "text", text: "•", size: 14, color: $C.dim} end
  return {widget: "image", src: $path, w: 20, h: 20}
end

-- ── the panel scene ─────────────────────────────────────────────────────
fn panel_doc()
  $now = time()
  $nodes = []
  $children = ["launcher_btn", "gap1", "pager", "gap2", "tasks", "fill"]
  if length($state.tray) > 0 then push($children, "tray") end
  push($children, "status")
  push($children, "clock")
  push($children, "peek")
  push($nodes, ["root", {widget: "row", fill: true, align: "center", gap: 4, padding: 4, background: $C.panel, children: $children}])

  -- launcher button: the start-here icon, tinted while the launcher is open
  -- the dark-theme variant: the light one draws dark-on-dark here
  $start = icon_path_t("start-here-kde", 48, $ICON_THEME)
  if $start == "" then $start = icon_path_t("start-here", 48, $ICON_THEME) end
  $lb = {widget: "row", height: 40, radius: 8, padding: 6, align: "center", hover: $C.hover, on_click: "launcher", children: ["launcher_icon"]}
  if $state.launcher_open then $lb.background = $C.accent_bg end
  push($nodes, ["launcher_btn", $lb])
  if $start != "" then
    push($nodes, ["launcher_icon", {widget: "image", src: $start, w: 28, h: 28}])
  else
    push($nodes, ["launcher_icon", {widget: "text", text: "Apps", size: 14, bold: true, color: $C.fg}])
  end
  push($nodes, ["gap1", {widget: "spacer", size: 6}])

  -- pager: one button per workspace, current one filled
  $ws_ids = []
  for $i = 1 to $state.ws_count
    push($ws_ids, "ws_" .. to_string($i))
  end
  push($nodes, ["pager", {widget: "row", gap: 3, align: "center", children: $ws_ids}])
  for $i = 1 to $state.ws_count
    $id = "ws_" .. to_string($i)
    $current = $i == $state.ws_current
    $b = {widget: "row", height: 30, radius: 6, padding: 8, align: "center", justify: "center", hover: $C.hover, on_click: "ws", children: [$id .. "_t"]}
    $b.background = $current ? $C.accent : $C.task_bg
    push($nodes, [$id, $b])
    push($nodes, [$id .. "_t", {widget: "text", text: to_string($i), size: 12, bold: $current, color: $current ? "#0b1f2b" : $C.dim}])
  end
  push($nodes, ["gap2", {widget: "spacer", size: 8}])

  -- task buttons for the current workspace (Plasma's default filter),
  -- bounded like every other list the panel emits
  $tasks = []
  for each $w in $state.windows
    if length($tasks) >= $MAX_TASKS then break end
    if ($w.workspace ?? $state.ws_current) == $state.ws_current then push($tasks, $w) end
  end
  $task_ids = []
  for each $w in $tasks
    push($task_ids, "t_" .. to_string($w.id))
  end
  push($nodes, ["tasks", {widget: "row", gap: 4, align: "center", children: $task_ids}])
  for each $w in $tasks
    if true then
      $id = "t_" .. to_string($w.id)
      $b = {widget: "row", height: 40, radius: 6, padding: 8, gap: 8, align: "center", hover: $C.hover, on_click: "task", children: [$id .. "_i", $id .. "_l"]}
      if $w.focused and not $w.minimized then
        $b.background = $C.accent_bg
      elif not $w.minimized then
        $b.background = $C.task_bg
      end
      push($nodes, [$id, $b])
      $icon = window_icon($w.app_id)
      if $icon != "" then
        push($nodes, [$id .. "_i", {widget: "image", src: $icon, w: 24, h: 24}])
      else
        push($nodes, [$id .. "_i", {widget: "spacer", size: 0}])
      end
      push($nodes, [$id .. "_l", {widget: "text", text: $p.short_title($w.title, 40), size: 13, elide: true, width: 170, color: $w.minimized ? $C.faint : $C.fg}])
    end
  end
  push($nodes, ["fill", {widget: "spacer"}])

  -- tray: one icon per StatusNotifierItem, click = activate. The node id
  -- carries the adapter's store KEY ("i<n>", what tray.activate takes -- the
  -- SNI Id is the app's own name and is NOT accepted), so a click resolves to
  -- the exact item even if the tray changed after this render.
  if length($state.tray) > 0 then
    $tray_ids = []
    for each $item in $state.tray
      push($tray_ids, "tr_" .. lower(to_string($item.key)))
    end
    push($nodes, ["tray", {widget: "row", gap: 2, align: "center", children: $tray_ids}])
    for each $item in $state.tray
      $id = "tr_" .. lower(to_string($item.key))
      push($nodes, [$id, {widget: "row", height: 36, radius: 6, padding: 6, align: "center", hover: $C.hover, on_click: "tray", children: [$id .. "_i"]}])
      $path = icon_path($item.icon_name ?? "", 24)
      if $path != "" then
        push($nodes, [$id .. "_i", {widget: "image", src: $path, w: 20, h: 20}])
      else
        push($nodes, [$id .. "_i", {widget: "text", text: slice(to_string($item.title ?? "?"), 0, 1), size: 12, bold: true, color: $C.dim}])
      end
    end
  end

  -- status applets (Plasma's system-tray built-ins): notifications bell
  -- with a count, volume (hidden without a default sink), network
  $status_ids = ["st_notes"]
  if $state.vol.ok then push($status_ids, "st_vol") end
  push($status_ids, "st_net")
  push($nodes, ["status", {widget: "row", gap: 2, align: "center", children: $status_ids}])
  $n_count = length($state.notes)
  $bell_children = ["st_notes_i"]
  if $n_count > 0 then push($bell_children, "st_notes_n") end
  $bell = {widget: "row", height: 36, radius: 6, padding: 7, gap: 4, align: "center", hover: $C.hover, on_click: "notes", children: $bell_children}
  if $state.notes_open then $bell.background = $C.accent_bg end
  push($nodes, ["st_notes", $bell])
  $bell_icon = $n_count > 0 ? "notification-active" : "notification-inactive"
  push($nodes, ["st_notes_i", status_icon($bell_icon, "notifications")])
  if $n_count > 0 then push($nodes, ["st_notes_n", {widget: "text", text: to_string($n_count), size: 11, bold: true, color: $C.accent}]) end
  if $state.vol.ok then
    $vol_icon = "audio-volume-muted"
    if not $state.vol.muted then
      $vol_icon = $state.vol.level >= 67 ? "audio-volume-high" : ($state.vol.level >= 34 ? "audio-volume-medium" : ($state.vol.level > 0 ? "audio-volume-low" : "audio-volume-muted"))
    end
    push($nodes, ["st_vol", {widget: "row", height: 36, radius: 6, padding: 7, align: "center", hover: $C.hover, on_click: "vol_mute", children: ["st_vol_i"]}])
    push($nodes, ["st_vol_i", status_icon($vol_icon, "audio-card")])
  end
  $net_icon = $state.net.up ? ($state.net.wireless ? "network-wireless-signal-excellent" : "network-wired-activated") : "network-offline"
  push($nodes, ["st_net", {widget: "row", height: 36, radius: 6, padding: 7, align: "center", hover: $C.hover, children: ["st_net_i"]}])
  push($nodes, ["st_net_i", status_icon($net_icon, "network-wired")])

  -- clock: big time, the date beneath it; click opens the calendar
  $clock = {widget: "row", height: 44, radius: 8, padding: 10, align: "center", hover: $C.hover, on_click: "calendar", children: ["clock_col"]}
  if $state.calendar_open then $clock.background = $C.accent_bg end
  push($nodes, ["clock", $clock])
  push($nodes, ["clock_col", {widget: "column", gap: 0, align: "center", children: ["clock_time", "clock_date"]}])
  push($nodes, ["clock_time", {widget: "text", text: $p.clock_text($now), size: 19, bold: true, color: $C.fg}])
  push($nodes, ["clock_date", {widget: "text", text: $p.date_text($now), size: 11, color: $C.dim}])

  -- peek at desktop: minimise everything on this workspace; again restores
  $peek = {widget: "row", height: 44, radius: 6, padding: 6, align: "center", hover: $C.hover, on_click: "peek", children: ["peek_i"]}
  if length($state.peeked) > 0 then $peek.background = $C.accent_bg end
  push($nodes, ["peek", $peek])
  push($nodes, ["peek_i", status_icon("user-desktop", "desktop")])

  return $p.document({scene: "1", name: "panel", citizen: $ME, window: {kind: "edge", edge: "bottom", title: "Panel", h: 52, chrome: false}}, $nodes)
end

-- ── the launcher scene ──────────────────────────────────────────────────
-- Scene limits the host enforces: a list holds at most 500 rows and a whole
-- document at most 256 KiB, so rows are capped and their text bounded.
$MAX_LIST_ROWS = 500
$MAX_NOTES = 50
$MAX_TASKS = 50

fn launcher_doc()
  $rows = []
  for each $a in $state.apps
    if length($rows) >= $MAX_LIST_ROWS then break end
    $sub = $a.generic_name ?? ""
    if $sub == "" then $sub = $a.comment ?? "" end
    push($rows, {id: $a.id, cells: [$p.short_title($a.name ?? $a.id, 80), $p.short_title($sub, 120), icon_path($a.icon ?? "", 48)]})
  end
  $count = to_string(length($state.apps)) .. (length($state.apps) == 1 ? " application" : " applications")
  $nodes = [
    ["root", {widget: "column", gap: 10, padding: 16, fill: true, children: ["head", "search", "cats1", "cats2", "list"]}],
    ["head", {widget: "row", gap: 8, align: "center", children: ["head_t", "head_fill", "head_n"]}],
    ["head_t", {widget: "text", text: "Applications", size: 18, bold: true, color: $C.fg}],
    ["head_fill", {widget: "spacer"}],
    ["head_n", {widget: "text", text: $count, size: 11, color: $C.faint}],
    ["search", {widget: "field", value: $state.query, placeholder: "Search…", width: 380, on_change: "filter", on_submit: "launch_first"}],
    ["list", {widget: "list", row: "app_row", row_height: 46, gap: 2, fill: true, on_click: "launch", rows: $rows}],
    ["app_row", {widget: "row", height: 46, radius: 8, padding: 8, gap: 12, align: "center", hover: $C.hover, children: ["app_icon", "app_col"]}],
    ["app_icon", {widget: "image", src: "{cells[2]}", w: 32, h: 32}],
    ["app_col", {widget: "column", gap: 1, fill: true, children: ["app_name", "app_sub"]}],
    ["app_name", {widget: "text", text: "{cells[0]}", size: 14, color: $C.fg, elide: true}],
    ["app_sub", {widget: "text", text: "{cells[1]}", size: 11, color: $C.dim, elide: true}]
  ]
  -- Kickoff-style category chips (freedesktop main categories), two rows
  $rows_of = [["", "Network", "Office", "Development", "Graphics"], ["AudioVideo", "Game", "System", "Utility", "Settings"]]
  $r = 0
  for each $cats in $rows_of
    $r = $r + 1
    $ids = []
    for each $cat in $cats
      push($ids, "cat_" .. ($cat == "" ? "all" : lower($cat)))
    end
    push($nodes, ["cats" .. to_string($r), {widget: "row", gap: 6, align: "center", children: $ids}])
    for each $cat in $cats
      $id = "cat_" .. ($cat == "" ? "all" : lower($cat))
      $on = $cat == $state.category
      push($nodes, [$id, {widget: "row", height: 28, radius: 14, padding: 10, align: "center", justify: "center", hover: $C.hover, background: $on ? $C.accent : $C.task_bg, on_click: "cat", children: [$id .. "_t"]}])
      push($nodes, [$id .. "_t", {widget: "text", text: $p.category_label($cat), size: 12, bold: $on, color: $on ? "#0b1f2b" : $C.fg}])
    end
  end
  return $p.document({scene: "1", name: "launcher", citizen: $ME, window: {kind: "edge", edge: "left", title: "Applications", w: 440, chrome: false}}, $nodes)
end

-- ── the calendar scene ──────────────────────────────────────────────────
fn calendar_doc()
  $now = time()
  $today = $p.ymd($now)
  $shown = $p.shift_month($today.year, $today.month, $state.cal_offset)
  $grid = $p.month_grid($shown.year, $shown.month, $today)
  $nodes = []
  $week_ids = ["wk_h"]
  for $w = 0 to 5
    push($week_ids, "wk_" .. to_string($w))
  end
  $root_children = ["cal_day", "cal_full", "cal_gap", "cal_nav"]
  $root_children = concat($root_children, $week_ids)
  $root_children = concat($root_children, ["cal_fill", "cal_open"])
  push($nodes, ["root", {widget: "column", gap: 6, padding: 18, fill: true, children: $root_children}])
  push($nodes, ["cal_day", {widget: "text", text: date_format($now, "%A"), size: 24, bold: true, color: $C.fg}])
  push($nodes, ["cal_full", {widget: "text", text: date_format($now, "%-d ") .. $p.month_title($today.year, $today.month) .. "  ·  " .. $p.clock_text($now), size: 13, color: $C.dim}])
  push($nodes, ["cal_gap", {widget: "spacer", size: 10}])
  push($nodes, ["cal_nav", {widget: "row", gap: 6, align: "center", children: ["cal_title", "cal_prev", "cal_today", "cal_next"]}])
  -- Flat tool-buttons (hover rows), the way Plasma draws calendar nav.
  push($nodes, ["cal_title", {widget: "text", text: $p.month_title($shown.year, $shown.month), size: 16, bold: true, color: $C.fg, fill: true}])
  push($nodes, ["cal_prev", {widget: "row", height: 30, radius: 6, padding: 10, align: "center", justify: "center", hover: $C.hover, on_click: "cal_prev", children: ["cal_prev_t"]}])
  push($nodes, ["cal_prev_t", {widget: "text", text: "‹", size: 16, bold: true, color: $C.fg}])
  push($nodes, ["cal_today", {widget: "row", height: 30, radius: 6, padding: 10, align: "center", justify: "center", hover: $C.hover, background: $C.task_bg, on_click: "cal_today", children: ["cal_today_t"]}])
  push($nodes, ["cal_today_t", {widget: "text", text: "Today", size: 12, color: $C.fg}])
  push($nodes, ["cal_next", {widget: "row", height: 30, radius: 6, padding: 10, align: "center", justify: "center", hover: $C.hover, on_click: "cal_next", children: ["cal_next_t"]}])
  push($nodes, ["cal_next_t", {widget: "text", text: "›", size: 16, bold: true, color: $C.fg}])
  -- weekday header
  $hdr = []
  for $c = 0 to 6
    push($hdr, "wh_" .. to_string($c))
  end
  push($nodes, ["wk_h", {widget: "row", gap: 4, children: $hdr}])
  for $c = 0 to 6
    push($nodes, ["wh_" .. to_string($c), {widget: "text", text: $p.WEEKDAYS_SHORT[$c], size: 11, bold: true, width: 38, align: "center", color: $C.faint}])
  end
  -- six weeks
  for $w = 0 to 5
    $cells = []
    for $c = 0 to 6
      push($cells, "d_" .. to_string($w) .. "_" .. to_string($c))
    end
    push($nodes, ["wk_" .. to_string($w), {widget: "row", gap: 4, children: $cells}])
    for $c = 0 to 6
      $cell = $grid[$w][$c]
      $id = "d_" .. to_string($w) .. "_" .. to_string($c)
      $box = {widget: "row", height: 38, radius: 19, padding: 0, align: "center", hover: $C.hover, children: [$id .. "_t"]}
      if $cell.today then $box.background = $C.accent end
      push($nodes, [$id, $box])
      $fg = $cell.in_month ? ($cell.weekend ? $C.weekend : $C.fg) : $C.faint
      if $cell.today then $fg = $C.today_fg end
      push($nodes, [$id .. "_t", {widget: "text", text: to_string($cell.day), size: 13, bold: $cell.today, width: 38, align: "center", color: $fg}])
    end
  end
  push($nodes, ["cal_fill", {widget: "spacer"}])
  push($nodes, ["cal_open", {widget: "button", label: "Open calendar app", tone: "primary", on_click: "open_calendar"}])
  return $p.document({scene: "1", name: "calendar", citizen: $ME, window: {kind: "edge", edge: "right", title: "Calendar", w: 360, chrome: false}}, $nodes)
end

-- ── the notifications scene ─────────────────────────────────────────────
fn notes_doc()
  $rows = []
  -- newest first, bounded: a flood of notifications cannot outgrow the
  -- document limit (the popup shows one line of body anyway)
  $newest = reverse($state.notes)
  for each $n in $newest
    if length($rows) >= $MAX_NOTES then break end
    $app = $n.app ?? ""
    if $app == "" then $app = "Notification" end
    push($rows, {id: to_string($n.id), cells: [$p.short_title($app, 60), $p.short_title($n.summary ?? "", 120), $p.short_title($n.body ?? "", 240)]})
  end
  $children = ["nh"]
  if length($rows) == 0 then push($children, "n_empty") else push($children, "n_list") end
  $nodes = [
    ["root", {widget: "column", gap: 10, padding: 16, fill: true, children: $children}],
    ["nh", {widget: "row", gap: 8, align: "center", children: ["nh_t", "nh_fill", "nh_clear"]}],
    ["nh_t", {widget: "text", text: "Notifications", size: 18, bold: true, color: $C.fg}],
    ["nh_fill", {widget: "spacer"}],
    ["nh_clear", {widget: "row", height: 30, radius: 6, padding: 10, align: "center", justify: "center", hover: $C.hover, background: $C.task_bg, on_click: "notes_clear", children: ["nh_clear_t"]}],
    ["nh_clear_t", {widget: "text", text: "Clear all", size: 12, color: $C.fg}]
  ]
  if length($rows) == 0 then
    push($nodes, ["n_empty", {widget: "text", text: "No new notifications", size: 13, color: $C.faint}])
  else
    push($nodes, ["n_list", {widget: "list", row: "n_row", row_height: 76, gap: 6, fill: true, on_click: "note_close", rows: $rows}])
    push($nodes, ["n_row", {widget: "row", height: 76, radius: 10, padding: 12, gap: 10, align: "center", background: $C.card, hover: "#343a40", children: ["n_col"]}])
    push($nodes, ["n_col", {widget: "column", gap: 2, fill: true, children: ["n_app", "n_sum", "n_body"]}])
    push($nodes, ["n_app", {widget: "text", text: "{cells[0]}", size: 11, color: $C.faint, elide: true}])
    push($nodes, ["n_sum", {widget: "text", text: "{cells[1]}", size: 14, bold: true, color: $C.fg, elide: true}])
    push($nodes, ["n_body", {widget: "text", text: "{cells[2]}", size: 12, color: $C.dim, elide: true}])
  end
  return $p.document({scene: "1", name: "notes", citizen: $ME, window: {kind: "edge", edge: "right", title: "Notifications", w: 380, chrome: false}}, $nodes)
end

-- ── rebuilds ────────────────────────────────────────────────────────────
-- Record the outcome of a popup load: mounting is what registers a
-- sub-panel's name on its edge, so a load the host accepted (revision > 0)
-- is the registration. A refused one is logged and retried by the next
-- render_panel's register pass.
fn mark_loaded($name, $rev)
  if $rev > 0 then
    $state["reg_" .. $name] = true
  elif $state["reg_" .. $name] then
    -- a routine refresh of an already-registered page; nothing re-registers,
    -- the page simply keeps its last accepted content
    note($name .. " refresh refused; page keeps its last content")
  else
    note($name .. " registration refused; retried on the next panel render")
  end
  return $rev
end

fn all_registered()
  return $state.reg_launcher and $state.reg_calendar and $state.reg_notes
end

-- Content-only loads: while a page is registered its content is kept
-- current whether or not its popup is open, because the shell can reveal a
-- registered page on its own (corner, chevrons) and it must never show stale
-- content or dead controls. Only the reveal and pin are gated on *_open.
fn load_launcher()
  if not fetch_apps() then return 0 end
  return mark_loaded("launcher", load_scene(launcher_doc()))
end

fn load_calendar()
  return mark_loaded("calendar", load_scene(calendar_doc()))
end

-- From $state.notes as it stands; render_notes refetches first.
fn load_notes()
  $doc = ""
  try
    $doc = notes_doc()
  catch $e
    note("notes_doc failed: " .. to_string($e))
    return 0
  end
  return mark_loaded("notes", load_scene($doc))
end

-- The register pass: mount every popup page not yet registered in this host
-- generation -- at init, after a citizen restart, after a host restart wiped
-- the scene store, and again for any name a previous pass could not get
-- accepted. Loads are idempotent same-owner updates, so the in-flight guard
-- only saves duplicate work when renders overlap across a yield.
fn register_popups()
  if $state.registering then return end
  $state.registering = true
  try
    if not $state.reg_launcher then load_launcher() end
    if not $state.reg_calendar then load_calendar() end
    if not $state.reg_notes then load_notes() end
  catch $e
    note("popup registration failed: " .. to_string($e))
  end
  $state.registering = false
end

fn render_panel()
  $rev = load_scene(panel_doc())
  if $rev == 0 then return end
  if $rev == 1 then
    -- A host that has never seen us: its scene store is empty and every
    -- registration of ours went with it.
    $state.reg_launcher = false
    $state.reg_calendar = false
    $state.reg_notes = false
    $state.panel_shown = false
    $state.panel_show_fails = 0
  end
  if not all_registered() then register_popups() end
  -- First render of this citizen life or host generation: select and pin the
  -- taskbar page. Keyed on our own flag, not revision 1 -- the revision
  -- counter is per scene name and survives a citizen-only restart. Capped so
  -- a host that keeps refusing does not receive a request every render; a new
  -- host generation (revision 1) re-arms it.
  if not $state.panel_shown and $state.panel_show_fails < $PANEL_SHOW_CAP then
    if show_page("bottom", "scene-panel") then
      $state.panel_shown = page_applied("bottom", "scene-panel")
      $state.panel_show_fails = 0
    else
      $state.panel_show_fails = $state.panel_show_fails + 1
      if $state.panel_show_fails == $PANEL_SHOW_CAP then
        note("taskbar page refused " .. to_string($PANEL_SHOW_CAP) .. " times; giving up until the host restarts")
      end
    end
  end
end

-- Popups are opened and closed by click handlers while async rebuilds are in
-- flight, and every Bus call is a yield point. Each open/close bumps
-- popup_gen; a render captures it first and re-checks it (and its own open
-- flag) after every yield of the reveal, so a rebuild that started before a
-- close can never reveal or pin a popup the user has since closed. Loading
-- its content is harmless: a mount registers, it never reveals.
fn popup_live($flag, $gen)
  return $state[$flag] and $state.popup_gen == $gen
end

fn bump_popups()
  $state.popup_gen = $state.popup_gen + 1
end

-- Refresh a page's content, then reveal and pin it only if its popup is
-- still open in the generation captured before the first yield. A refused
-- load (0) reveals nothing: the edge's current page would be the one shown.
fn render_launcher()
  $gen = $state.popup_gen
  $rev = load_launcher()
  $shown = false
  if $rev > 0 and popup_live("launcher_open", $gen) then $shown = show_popup("left", "scene-launcher", "launcher_open", $gen) end
  if $state.popup_gen == $gen then $state.launcher_shown = page_applied("left", "scene-launcher") end
  return $shown
end

fn render_calendar()
  $gen = $state.popup_gen
  $rev = load_calendar()
  $shown = false
  if $rev > 0 and popup_live("calendar_open", $gen) then $shown = show_popup("right", "scene-calendar", "calendar_open", $gen) end
  if $state.popup_gen == $gen then $state.calendar_shown = page_applied("right", "scene-calendar") end
  return $shown
end

fn render_notes()
  $gen = $state.popup_gen
  fetch_notes()
  $rev = load_notes()
  $shown = false
  if $rev > 0 and popup_live("notes_open", $gen) then $shown = show_popup("right", "scene-notes", "notes_open", $gen) end
  if $state.popup_gen == $gen then $state.notes_shown = page_applied("right", "scene-notes") end
  return $shown
end

-- ── popup edge pins: ours, recorded ────────────────────────────────────
-- Quoin persists pins across restarts but not our popup scenes, so a popup
-- open when Quoin or this citizen went down would come back as a pinned
-- native page. We record every popup pin we make in a small state file and,
-- at start, release ONLY those -- a pin the user made is never touched.
-- Owner-disconnect cleanup removes our registrations but not the persisted
-- modes, so the file stays through shell refactor phase 1: without it, a
-- crash with a popup pinned would strand a docked, empty edge. Phase 2
-- (popup pins retired) deletes it.
$PIN_FILE = env("XDG_STATE_HOME", env("HOME", "/tmp") .. "/.local/state") .. "/cosmix/quoin-panel-pins.json"

fn read_pins()
  try
    $v = json_parse(read_file($PIN_FILE))
    return type($v) == "list" ? $v : []
  catch $e
    return []
  end
end

fn write_pins($pins)
  try
    mkdir(dirname($PIN_FILE))
    write_file($PIN_FILE, json_encode($pins))
  catch $e
    note("pin record not written: " .. to_string($e))
  end
end

-- Show a popup page and pin its edge. Mounting no longer reveals anything
-- (register-only mounts), so the reveal is this explicit shell.panel.show
-- and the legacy pin behind it reserves the popup's space. The
-- page.set/show/pin sends are yield points too: re-check the popup is still
-- live after each, and if a close landed meanwhile, undo the pin instead of
-- leaving a closed popup pinned open. A page the host never accepted is not
-- revealed or pinned at all: that would show whatever page the edge holds.
fn show_popup($edge, $page, $flag, $gen)
  if not popup_live($flag, $gen) then return false end
  if ($state.pending_panels[$edge] ?? {}).page == $page and ($state.pending_panels[$edge] ?? {}).generation == $gen then
    drive_panel_operations()
    return true
  end
  -- Record the pin before making it, so a crash between the two still
  -- leaves the recovery pass something to release.
  $pins = read_pins()
  if index_of($pins, $edge) < 0 then
    push($pins, $edge)
    write_pins($pins)
  end
  queue_panel($edge, $page, $flag, $gen, "select")
  drive_panel_operations()
  return true
end

-- Whether an open popup (other than a stale render) currently owns an edge:
-- a stale render must never hide a popup the user has since opened there.
fn edge_in_use($edge)
  if $edge == "left" then return $state.launcher_open end
  return $state.calendar_open or $state.notes_open
end

-- Bare arrays remain supported and written: unpin releases either persistent
-- mode, so old and new records have identical cleanup semantics. Drop an edge
-- only after props confirms application, never after just an enqueue ack.
fn hide_popup($edge)
  if edge_in_use($edge) then return false end
  -- Scene actions can dismiss shell-revealed pages with no citizen pin.
  -- Record their release too, so a refusal remains retryable by close.
  $pins = read_pins()
  if index_of($pins, $edge) < 0 then
    push($pins, $edge)
    write_pins($pins)
  end
  $confirmed = hide_edge($edge)
  if edge_in_use($edge) then return false end
  if ($state.pending_panels[$edge] ?? {}).refused == true then return false end
  if not $p.popup_release_confirmed($confirmed) then return false end
  $kept = $p.released_popup_pins(read_pins(), $edge, $confirmed)
  write_pins($kept)
  return true
end

-- Closing a popup releases its edge (unpin + confirmed hide) but NOT its
-- registration: the sub-panel and its content stay mounted, so the next
-- open only has to select, reveal and pin again.
fn close_notes()
  $was_open = $state.notes_open
  $state.notes_open = false
  $state.notes_shown = false
  if $was_open then bump_popups() end
  if edge_in_use("right") then return true end
  if not $was_open and index_of(read_pins(), "right") < 0 then return true end
  return hide_popup("right")
end

-- One popup at a time, like Plasma: opening any closes the others.
fn close_popups()
  if not close_launcher() then return "left" end
  if not close_calendar() then return "right" end
  if not close_notes() then return "right" end
  return nil
end

fn agent_close_popups()
  $edge = close_popups()
  if $edge == nil then return true end
  render_panel()
  reply(22, json_encode({error: "release_failed", open: false, edge: $edge}))
  return false
end

fn close_launcher($scene_action = false)
  $was_open = $state.launcher_open
  $state.launcher_open = false
  $state.launcher_shown = false
  if $was_open then bump_popups() end
  if edge_in_use("left") then return true end
  if not $scene_action and not $was_open and index_of(read_pins(), "left") < 0 then return true end
  return hide_popup("left")
end

fn close_calendar($scene_action = false)
  $was_open = $state.calendar_open
  $state.calendar_open = false
  $state.calendar_shown = false
  if $was_open then bump_popups() end
  if edge_in_use("right") then return true end
  if not $scene_action and not $was_open and index_of(read_pins(), "right") < 0 then return true end
  return hide_popup("right")
end

-- Coalesce inside the calling async handler. A local deadline resumes the
-- rebuild even if the Bus disconnects; no loopback message owns the flag.
fn schedule()
  $state.dirty = true
  if $state.scheduled then return end
  $state.scheduled = true
  try
    sleep(0.01)
    while $state.dirty
      $state.dirty = false
      try
        fetch_windows()
        fetch_tray()
        fetch_notes()
        render_panel()
        if $state.notes_open then render_notes() else load_notes() end
      catch $err
        note("rebuild failed: " .. to_string($err))
      end
    end
  finally
    $state.scheduled = false
  end
end

fn page_applied($edge, $page)
  $pstate = $state.applied_panels[$edge]
  return $pstate != nil and $pstate.page == $page and $pstate.visible and $pstate.pinned
end

fn update_shown()
  $state.panel_shown = page_applied("bottom", "scene-panel")
  $state.launcher_shown = $state.launcher_open and page_applied("left", "scene-launcher")
  $state.calendar_shown = $state.calendar_open and page_applied("right", "scene-calendar")
  $state.notes_shown = $state.notes_open and page_applied("right", "scene-notes")
end

fn subscription_gap()
  -- Broker delivery gaps use a header; comp's retained publisher-loss
  -- records use a JSON body. Both invalidate the subscription snapshot.
  return $event.headers.gap == "true" or (($event.args ?? {}).gap == true)
end

on "shell.panel.changed"
  if $event.headers.topic != $HOST .. ".panel.changed" then return end
  if subscription_gap() then
    resynchronise()
  else
    -- Ignore the payload: it can predate our command's applied reply.
    refresh_panels()
    drive_panel_operations()
    update_shown()
  end
end

fn recover_pins()
  for each $edge in read_pins()
    if not edge_in_use($edge) and $state.pending_panels[$edge] == nil then
      queue_panel($edge, nil, nil, $state.popup_gen, "release")
    end
  end
  drive_panel_operations()
end

fn resynchronise()
  if $state.resyncing then return end
  $state.resyncing = true
  try
    rpc($COMP, "comp.props.watch", {})
    refresh_panels()
    recover_pins()
    update_shown()
    schedule()
    -- A broker gap can hide a complete host restart while the registered
    -- names stay identical. Re-establish open intent even when its previous
    -- operation had already completed and left no pending entry.
    if $state.launcher_open and not $state.launcher_shown then render_launcher() end
    if $state.calendar_open and not $state.calendar_shown then render_calendar() end
    if $state.notes_open and not $state.notes_shown then render_notes() end
  finally
    $state.resyncing = false
  end
end

on bus.connected async
  if len(keys($event.headers)) != 0 then return end
  $state.panel_shown = false
  $state.reg_launcher = false
  $state.reg_calendar = false
  $state.reg_notes = false
  resynchronise()
  $registry = rpc("noded", "noded.props.get", {})
  reconcile_services((($registry ?? {}).services ?? {}).registered)
end

fn reconcile_services($live)
  if type($live) != "list" then return end
  $previous = $state.live_services
  if not contains($live, $HOST) then
    $state.applied_panels = {}
    update_shown()
  end
  if contains($live, $HOST) and not contains($previous, $HOST) then
    -- Do not consume the appearance if the host snapshot is unavailable.
    if not refresh_panels() then return end
    $state.panel_shown = false
    $state.reg_launcher = false
    $state.reg_calendar = false
    $state.reg_notes = false
    recover_pins()
    render_panel()
    if $state.launcher_open then render_launcher() end
    if $state.calendar_open then render_calendar() end
    if $state.notes_open then render_notes() end
  end
  if contains($live, $COMP) and not contains($previous, $COMP) then rpc($COMP, "comp.props.watch", {}) end
  $state.live_services = $live
  schedule()
end

-- ── handlers ────────────────────────────────────────────────────────────
fn node_of()
  $a = $event.args
  if $a == nil or type($a) != "map" then return "" end
  return to_string($a.node ?? "")
end

-- Agent requests use JSON objects; an absent body is the empty object.
-- Return validation results so handlers retain control of replies/state.
fn agent_args($request, $allowed)
  $a = $request.args
  if trim($request.body ?? "") == "" then $a = {} end
  if type($a) != "map" then return {error: "expected a JSON object"} end
  for each $key in keys($a)
    if not contains($allowed, $key) then return {error: "unknown argument: " .. $key} end
    if $key == "query" and type($a[$key]) == "number" then $a[$key] = to_string($a[$key]) end
    if $key != "limit" and type($a[$key]) != "string" then
      return {error: $key .. " must be a string"}
    end
  end
  if has_key($a, "limit") then
    $n = $a.limit
    if type($n) != "number" then return {error: "limit must be a non-negative integer"} end
    if $n < 0 or floor($n) != $n then return {error: "limit must be a non-negative integer"} end
  end
  return {args: $a}
end

fn agent_invalid($detail)
  reply(10, json_encode({error: "invalid_request", detail: $detail}))
end

fn launcher_items($apps, $limit)
  $items = []
  for each $app in slice($apps, 0, $limit)
    push($items, {id: $app.id, name: $app.name, generic_name: $app.generic_name ?? "",
      comment: $app.comment ?? "", icon: $app.icon ?? "", categories: $app.categories ?? []})
  end
  return $items
end

fn launcher_snapshot()
  $apps = apps_current() ? $state.apps : []
  return {open: $state.launcher_open, shown: $state.launcher_shown, query: $state.query, category: $state.category,
    count: length($apps), items: launcher_items($apps, 50)}
end

fn calendar_snapshot()
  $today = $p.ymd(time())
  $shown = $p.shift_month($today.year, $today.month, $state.cal_offset)
  return {open: $state.calendar_open, shown: $state.calendar_shown, month: $shown.month, year: $shown.year}
end

on launcher.open desc "open launcher idempotently {query?, category?}; return launcher.state"
  $v = agent_args($event, ["query", "category"])
  if $v.error != nil then agent_invalid($v.error); return end
  $a = $v.args
  if has_key($a, "category") and $p.category_from_node("cat_" .. lower($a.category)) != $a.category then
    agent_invalid("category must name a launcher chip"); return
  end
  if not $state.launcher_open then
    if not agent_close_popups() then return end
    $state.launcher_open = true
    bump_popups()
    $state.query = ""
    $state.category = ""
  end
  if has_key($a, "query") then $state.query = slice($a.query, 0, 128) end
  if has_key($a, "category") then $state.category = $a.category end
  render_launcher()
  render_panel()
  reply(0, json_encode(launcher_snapshot()))
end

on launcher.close desc "close launcher idempotently {}; return {open:false}"
  $v = agent_args($event, [])
  if $v.error != nil then agent_invalid($v.error); return end
  $released = close_launcher()
  render_panel()
  if not $released then
    reply(22, json_encode({error: "release_failed", open: false, edge: "left"}))
    return
  end
  reply(0, json_encode({open: false}))
end

on launcher.state desc "launcher {open,shown,query,category,count,items}; at most 50 items, cached when loaded"
  $v = agent_args($event, [])
  if $v.error != nil then agent_invalid($v.error); return end
  if not $state.apps_loaded or not apps_current() then
    if $state.launcher_open then render_launcher() else fetch_apps() end
  end
  reply(0, json_encode(launcher_snapshot()))
end

on launcher.search desc "search without UI changes {query,category?,limit?=50}; return {query,category,count,items}"
  $v = agent_args($event, ["query", "category", "limit"])
  if $v.error != nil then agent_invalid($v.error); return end
  $a = $v.args
  if not has_key($a, "query") then agent_invalid("query is required"); return end
  $category = $a.category ?? ""
  send $APPS apps.list body=json_encode({query: $a.query, category: $category}) timeout=3
  if not rc_ok($rc) then
    reply($rc < 0 ? 20 : 21, json_encode({error: $rc < 0 ? "apps_transport" : "apps_refused", rc: $rc, reply: $reply}))
    return
  end
  $apps = $result
  if type($apps) == "string" then
    try
      $apps = json_parse($apps)
    catch $e
      $apps = nil
    end
  end
  if type($apps) != "list" then
    reply(23, json_encode({error: "apps_invalid_reply"})); return
  end
  reply(0, json_encode({query: $a.query, category: $category, count: length($apps),
    items: launcher_items($apps, $a.limit ?? 50)}))
end

on launcher.launch desc "launch {id}; close launcher on success; return {launched:id} or wrapped apps refusal"
  $v = agent_args($event, ["id"])
  if $v.error != nil then agent_invalid($v.error); return end
  $id = $v.args.id ?? ""
  if $id == "" then agent_invalid("id must be a non-empty string"); return end
  send $APPS apps.launch body=json_encode({id: $id}) timeout=3
  if not rc_ok($rc) then
    reply($rc < 0 ? 20 : 21, json_encode({error: $rc < 0 ? "apps_transport" : "apps_refused", rc: $rc, reply: $reply}))
    return
  end
  $released = close_launcher()
  render_panel()
  if not $released then
    reply(22, json_encode({error: "release_failed", open: false, edge: "left", launched: $id}))
    return
  end
  reply(0, json_encode({launched: $id}))
end

on calendar.open desc "open calendar idempotently {}; return {open,shown,month,year}"
  $v = agent_args($event, [])
  if $v.error != nil then agent_invalid($v.error); return end
  if not $state.calendar_open then
    if not agent_close_popups() then return end
    $state.calendar_open = true
    bump_popups()
    $state.cal_offset = 0
  end
  render_calendar()
  render_panel()
  reply(0, json_encode(calendar_snapshot()))
end

on calendar.close desc "close calendar idempotently {}; return {open:false}"
  $v = agent_args($event, [])
  if $v.error != nil then agent_invalid($v.error); return end
  $released = close_calendar()
  render_panel()
  if not $released then
    reply(22, json_encode({error: "release_failed", open: false, edge: "right"}))
    return
  end
  reply(0, json_encode({open: false}))
end

on calendar.state desc "calendar snapshot {}; return {open,shown,month,year}"
  $v = agent_args($event, [])
  if $v.error != nil then agent_invalid($v.error); return end
  reply(0, json_encode(calendar_snapshot()))
end

on notes.open desc "open notifications idempotently {}; return {open,shown,count}"
  $v = agent_args($event, [])
  if $v.error != nil then agent_invalid($v.error); return end
  if not $state.notes_open then
    if not agent_close_popups() then return end
    $state.notes_open = true
    bump_popups()
  end
  render_notes()
  render_panel()
  reply(0, json_encode({open: $state.notes_open, shown: $state.notes_shown, count: length($state.notes)}))
end

on notes.close desc "close notifications idempotently {}; return {open:false}"
  $v = agent_args($event, [])
  if $v.error != nil then agent_invalid($v.error); return end
  $released = close_notes()
  render_panel()
  if not $released then
    reply(22, json_encode({error: "release_failed", open: false, edge: "right"}))
    return
  end
  reply(0, json_encode({open: false}))
end

on notes.state desc "notifications snapshot {}; return {open,shown,count}"
  $v = agent_args($event, [])
  if $v.error != nil then agent_invalid($v.error); return end
  reply(0, json_encode({open: $state.notes_open, shown: $state.notes_shown, count: length($state.notes)}))
end

on popups.state desc "popup flags {}; return {launcher,calendar,notes}"
  $v = agent_args($event, [])
  if $v.error != nil then agent_invalid($v.error); return end
  reply(0, json_encode({launcher: $state.launcher_open, calendar: $state.calendar_open, notes: $state.notes_open}))
end

on launcher desc "toggle the application launcher"
  reply(0, "")
  if $state.launcher_open then
    close_launcher()
  else
    if close_popups() != nil then return end
    $state.launcher_open = true
    bump_popups()
    $state.query = ""
    $state.category = ""
    render_launcher()
  end
  render_panel()
end

on filter desc "launcher search text changed"
  reply(0, "")
  $a = $event.args
  if $a != nil and type($a) == "map" then $state.query = slice(to_string($a.value ?? ""), 0, 128) end
  render_launcher()
end

on cat desc "launcher: filter by the clicked category chip"
  reply(0, "")
  $node = node_of()
  $node = before($node, "_t") ?? $node
  $state.category = $p.category_from_node($node)
  render_launcher()
end

on launch desc "launch the clicked application"
  reply(0, "")
  $a = $event.args
  if $a == nil or type($a) != "map" or $a.item == nil then return end
  $id = $a.item.id
  if $id != nil then
    rpc($APPS, "apps.launch", {id: $id})
    close_launcher(true)
    render_panel()
  end
end

on launch_first desc "launch the first search match (Enter in the search field)"
  reply(0, "")
  if length($state.apps) > 0 then
    rpc($APPS, "apps.launch", {id: $state.apps[0].id})
    close_launcher(true)
    render_panel()
  end
end

on ws desc "switch to the clicked workspace" async
  reply(0, "")
  $node = node_of()
  $n = to_number(replace(before($node, "_t") ?? $node, "ws_", ""))
  if $n != nil then
    rpc($COMP, "comp.workspace.switch", {index: $n})
    schedule()
  end
end

on task desc "focus, restore or minimise the clicked window (Plasma task semantics)" async
  reply(0, "")
  $node = node_of()
  $id_text = replace($node, "t_", "")
  $id_text = before($id_text, "_") ?? $id_text
  $id = to_number($id_text)
  if $id == nil then return end
  for each $w in $state.windows
    if $w.id == $id then
      if $w.minimized then
        rpc($COMP, "comp.window.restore", {id: $w.id, generation: $w.generation})
      elif $w.focused then
        rpc($COMP, "comp.window.minimize", {id: $w.id, generation: $w.generation})
      else
        -- comp.window.focus raises by default
        rpc($COMP, "comp.window.focus", {id: $w.id, generation: $w.generation})
      end
    end
  end
  schedule()
end

on tray desc "activate the clicked tray item" async
  reply(0, "")
  $node = node_of()
  -- node ids are tr_<key> (the row) and tr_<key>_i (its icon); keys are
  -- i<n>, so strip the prefix first, then the icon suffix
  $key = starts_with($node, "tr_") ? slice($node, 3, length($node)) : ""
  if ends_with($key, "_i") then $key = slice($key, 0, length($key) - 2) end
  if $key != "" then rpc($TRAY, "tray.activate", {id: $key}) end
end

on calendar desc "toggle the calendar"
  reply(0, "")
  if $state.calendar_open then
    close_calendar()
  else
    if close_popups() != nil then return end
    $state.calendar_open = true
    bump_popups()
    $state.cal_offset = 0
    render_calendar()
  end
  render_panel()
end

on cal_prev desc "calendar: previous month"
  reply(0, "")
  $state.cal_offset = $state.cal_offset - 1
  render_calendar()
end

on cal_next desc "calendar: next month"
  reply(0, "")
  $state.cal_offset = $state.cal_offset + 1
  render_calendar()
end

on cal_today desc "calendar: back to the current month"
  reply(0, "")
  $state.cal_offset = 0
  render_calendar()
end

on open_calendar desc "open the desktop's calendar application"
  reply(0, "")
  -- A .desktop entry in the Calendar category wins; Thunderbird's calendar
  -- tab is the fallback on a desktop that has no dedicated calendar app.
  $apps = rpc($APPS, "apps.list", {category: "Calendar"})
  if $apps != nil and type($apps) == "list" and length($apps) > 0 then
    rpc($APPS, "apps.launch", {id: $apps[0].id})
  elif which("thunderbird") != nil then
    spawn(["thunderbird", "-calendar"], {detach: true})
  end
  close_calendar(true)
  render_panel()
end

on notes desc "toggle the notifications popup"
  reply(0, "")
  if $state.notes_open then
    close_notes()
  else
    if close_popups() != nil then return end
    $state.notes_open = true
    bump_popups()
    render_notes()
  end
  render_panel()
end

on note_close desc "dismiss the clicked notification"
  reply(0, "")
  $a = $event.args
  if $a != nil and type($a) == "map" and $a.item != nil then
    $id = to_number($a.item.id)
    if $id != nil then rpc($NOTIFY, "notify.close", {id: $id}) end
  end
  render_notes()
  render_panel()
end

on notes_clear desc "dismiss every notification"
  reply(0, "")
  fetch_notes()
  for each $n in $state.notes
    -- ids come from the props keys as strings; notify.close takes a number
    rpc($NOTIFY, "notify.close", {id: to_number($n.id)})
  end
  render_notes()
  render_panel()
end

on vol_mute desc "toggle mute on the default audio sink" async
  reply(0, "")
  $muted = run_argv(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"], {timeout: 2, env: {XDG_RUNTIME_DIR: $PW_RUNTIME}})
  if not $muted.ok then note("wpctl set-mute failed: " .. $muted.stderr) end
  fetch_vol()
  render_panel()
end

on peek desc "peek at the desktop: minimise this workspace, click again to restore" async
  reply(0, "")
  -- async, so two quick clicks could interleave and clobber each other's
  -- restore marks: a second click while one is running is ignored
  if $state.peek_busy then return end
  $state.peek_busy = true
  try
    peek_toggle()
  catch $e
    note("peek failed: " .. to_string($e))
  end
  $state.peek_busy = false
  schedule()
end

fn peek_toggle()
  fetch_windows()
  if length($state.peeked) > 0 then
    -- Restore exactly what this peek minimised: same id AND the generation
    -- recorded then (a window that has since changed identity, or that the
    -- user restored or closed meanwhile, is left alone).
    for each $w in $state.windows
      for each $mark in $state.peeked
        if $mark.id == $w.id and $mark.generation == $w.generation and $w.minimized then
          rpc($COMP, "comp.window.restore", {id: $w.id, generation: $w.generation})
        end
      end
    end
    $state.peeked = []
  else
    $marks = []
    for each $w in $state.windows
      if ($w.workspace ?? $state.ws_current) == $state.ws_current and not $w.minimized then
        send $COMP "comp.window.minimize" body=json_encode({id: $w.id, generation: $w.generation}) timeout=3
        if $rc == 0 then push($marks, {id: $w.id, generation: $w.generation}) end
      end
    end
    $state.peeked = $marks
  end
end

on panel.refresh desc "rebuild every scene now (reveals only the open popup)"
  reply(0, "")
  fetch_windows()
  fetch_tray()
  fetch_status()
  render_panel()
  render_launcher()
  render_calendar()
  render_notes()
end

-- Compositor state (windows opening/closing/focusing/minimising, workspace
-- switches), tray items and notifications all publish property diffs with
-- the inner verb props.changed -- a handler matches the publisher's inner
-- verb, not the topic name -- so this one handler drives every rebuild.
-- The adapters' named events are wired too, in case a diff is coalesced
-- away; schedule() refetches everything either way.
on props.changed async
  if subscription_gap() then resynchronise() end
  if $event.headers.topic == "noded.props.changed" then
    if subscription_gap() then
      $registry = rpc("noded", "noded.props.get", {})
      reconcile_services((($registry ?? {}).services ?? {}).registered)
    elif ($event.args ?? {}).path == "services.registered" then
      reconcile_services($event.args.new)
    end
  else
    schedule()
  end
end

on tray.item.added async
  if subscription_gap() then resynchronise() end
  schedule()
end

on tray.item.removed async
  if subscription_gap() then resynchronise() end
  schedule()
end

on notification.created async
  if subscription_gap() then resynchronise() end
  schedule()
end

on notification.closed async
  if subscription_gap() then resynchronise() end
  schedule()
end

-- The clock: wake on each minute boundary and redraw the panel and the
-- calendar page -- one wake per minute. A second kick is
-- ignored so a stray clock.run cannot start a second loop.
on clock.run async
  if $state.clock_running then return end
  $state.clock_running = true
  while true
    sleep($p.seconds_to_next_minute(time()))
    try
      fetch_net()
      fetch_vol()
      render_panel()
      -- the calendar's "today" and header clock stay current while it is
      -- registered, open or not; it is revealed only while open
      render_calendar()
    catch $e
      note("clock tick failed: " .. to_string($e))
    end
  end
end

-- ── init ────────────────────────────────────────────────────────────────
subscribe($COMP .. ".props.changed")
subscribe($TRAY .. ".item.added")
subscribe($TRAY .. ".item.removed")
subscribe($TRAY .. ".props.changed")
subscribe($NOTIFY .. ".changed")
subscribe($NOTIFY .. ".props.changed")
subscribe($HOST .. ".panel.changed")
subscribe("noded.props.changed")
$initial_panels = rpc($HOST, "shell.props.get", {})
$state.applied_panels = ($initial_panels ?? {}).panels ?? {}
rpc($COMP, "comp.props.watch", {})
fetch_windows()
fetch_tray()
fetch_status()
-- A popup that was open when Quoin or this citizen went down comes back as
-- a pinned edge with no content (the modes persist; the scenes do not).
-- Release exactly the popup pins this panel recorded (show_popup/hide_popup
-- keep $PIN_FILE); a pin the user made is untouched.
for each $edge in read_pins()
  hide_popup($edge)
end
render_panel()
$initial_registry = rpc("noded", "noded.props.get", {})
reconcile_services((($initial_registry ?? {}).services ?? {}).registered)
note("quoin-panel up: host=" .. $HOST .. " comp=" .. $COMP)

-- The clock runs in its own async handler (below), kicked once from here, so
-- this init body returns and the runtime serves its reserved verbs (RELOAD,
-- QUIT, INFO, lifecycle props) -- an init that never returns would starve
-- them. On shutdown the runtime drains the loop like any async handler.
emit $ME clock.run
