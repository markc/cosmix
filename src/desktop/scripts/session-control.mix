-- version: 0.1.0
-- session-control -- the session-control citizen. Registers Bus service
-- `desktop-session` (run as root, from its own system unit, never PartOf the
-- desktop: it has to outlive the restart it performs):
--
--   desktop.session.restart {args?, dry_run?}
--       capture the desktop user's live agent sessions, hand the restart to
--       a detached transient unit (session-resume.mix --phase2), reply at
--       once. The worker restarts the desktop unit, waits for it and for a NEW
--       boot terminal, then types each session's resume line into its own
--       pane. Reply {accepted, action, dry_run, unit, state_file, sessions}.
--   desktop.session.leave {args?, dry_run?}
--       chvt to the leave VT; the desktop keeps running on its own VT.
--       Reply {accepted, action, dry_run, vt}.
--
-- Both are mesh-open with no confirmation: the confirm step is Quoin's
-- menu-level human affordance (shell.session.confirm), the verbs stay
-- agent-drivable. A dry run (dry_run:true, args ["--dry-run"], or
-- COSMIX_SESSION_DRY_RUN=1 for the whole citizen) replies the plan and runs
-- nothing. Refusals are rc 10 {error_code, message}.
--
-- Run: mix --serve session-control.mix --name desktop-session
-- lib/session.mix must sit beside this file in lib/, and session-resume.mix
-- beside this file. Settings (environment): COSMIX_SESSION_USER (required
-- for restart), COSMIX_DESKTOP_UNIT, COSMIX_BOOT_TERM_UNIT,
-- COSMIX_SESSION_TERM_SERVICE, COSMIX_LEAVE_VT; see docs/cos/session-control.md.
$session = require("lib/session.mix")
$here = dirname(realpath($0))

fn settings()
  $cfg = $session.config()
  if $cfg.resume_script == "" then $cfg.resume_script = $here .. "/session-resume.mix" end
  return $cfg
end

fn worker_active($unit)
  $r = run_argv(["systemctl", "is-active", $unit .. ".service"], {timeout: 10})
  return trim($r.stdout) == "active" or trim($r.stdout) == "activating"
end

fn restart($event)
  $cfg = settings()
  $req = $session.request($event.body, $cfg)
  if $req.ok != true then return $req end
  if worker_active($cfg.worker_unit) then
    return $session.refuse("RESTART_IN_PROGRESS", "a session restart is already running (" .. $cfg.worker_unit .. ")")
  end
  $sessions = $cfg.home == "" ? [] : $session.capture($cfg.home .. "/.claude/sessions", "/proc")
  $plan = $session.plan_restart($cfg, $sessions, time())
  if $plan.ok != true then return $plan end
  if $req.dry_run then return $session.restart_reply($plan, true, $cfg.worker_unit) end
  $ids = $session.user_ids($cfg.user)
  if $ids == nil then return $session.refuse("SESSION_CONFIG", "unknown user " .. $cfg.user) end
  -- The state lives in a root-owned directory outside the user's home (never
  -- written by root through a path the user controls), checked level by level
  -- for symlinks and foreign or group/world-writable directories. The user
  -- gets read access to the state and owns only its .done.
  $why = $session.prepare_state_dir($cfg.state_dir, uid())
  if $why != nil then return $session.refuse("STATE_DIR_UNSAFE", "refusing the state directory " .. $cfg.state_dir .. ": " .. $why) end
  $_pruned = $session.prune_state($cfg.state_dir, time(), 7 * 86400)
  $why = $session.write_state($cfg.state_dir, $plan.state_file, $plan.sessions, $ids, uid())
  if $why != nil then return $session.refuse("STATE_WRITE", "cannot write the state file " .. $plan.state_file .. ": " .. $why) end
  -- Detached: the worker survives this reply, and anything the restart takes
  -- down with the desktop (the terminal the caller typed into included).
  $r = run_argv($plan.argv, {timeout: 30})
  if $r.exit_code != 0 then
    $session.remove_state($plan.state_file)
    return $session.refuse("RESTART_START", "could not start the detached restart unit: " .. trim($r.stderr))
  end
  return $session.restart_reply($plan, false, $cfg.worker_unit)
end

fn leave($event)
  $cfg = settings()
  $req = $session.request($event.body, $cfg)
  if $req.ok != true then return $req end
  $plan = $session.plan_leave($cfg)
  if $plan.ok != true then return $plan end
  if $req.dry_run then return $session.leave_reply($plan, true) end
  $r = run_argv($plan.argv, {timeout: 10})
  if $r.exit_code != 0 then
    return $session.refuse("CHVT_FAILED", "chvt " .. $plan.vt .. " failed: " .. trim($r.stderr))
  end
  return $session.leave_reply($plan, false)
end

on desktop.session.restart desc "restart the desktop unit and resume the agent sessions into terminal panes"
  $r = restart($event)
  reply($r.rc, json_encode($r.body))
end
on desktop.session.leave desc "switch to the leave VT; the desktop keeps running"
  $r = leave($event)
  reply($r.rc, json_encode($r.body))
end
