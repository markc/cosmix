-- version: 0.1.1
-- term-desktop.mix — agentless desktop-workflow launcher for CosMix Term.
--
-- Drives CosMix Term over the Bus with NO AI agent in the loop: the desktop
-- "open a terminal here", "focus the running one", and "lay a project out"
-- workflows, done offline and model-independently through the live frontend's
-- verbs plus a detached launch. This is the sovereign control path — the same
-- surface an agent reaches through MCP is reachable here from a plain script.
--
-- The maintained iced frontend registers as `term` and serves `term.*`.
-- BTerm is archived. INFO is probed with a three-second cap inside the
-- caller's absolute deadline; registration alone does not establish liveness.
--
-- usage:
--   mix term-desktop.mix open [DIR]
--   mix term-desktop.mix focus [DIR]
--   mix term-desktop.mix layout split|dev [DIR]
--
-- focus reuses a live terminal by adding a tab; compositor activation is pending.
fn resolve_term_service($deadline)
  for $name in ["term"]
    $left = $deadline - time()
    if $left <= 0 then return "" end
    if $left > 3 then $left = 3 end
    $probe = send $name "INFO" body="" timeout=$left
    if $rc == 0 then return $name end
  end
  return ""
end

fn usage()
  raise("TERM_ARGS", "usage: open [DIR] | focus [DIR] | layout NAME [DIR]")
end

-- Build every verb from the service whose INFO probe answered.
fn apply_layout($name, $svc)
  -- Unreachable today (every caller either resolved a service or raised), and
  -- the guard is here so it stays that way: an empty name would build the verb
  -- `.pane.split` and send it to the empty target, surfacing as a broker
  -- "unknown service" wrapped in TERM_SEND — one indirection from its cause.
  if $svc == "" then raise("TERM_NOSVC", "internal: apply_layout called with no resolved Term service") end
  if $name == "split" then
    $verb = $svc .. ".pane.split"
    $r = send $svc $verb dir="v"
    if $rc != 0 then raise("TERM_SEND", "split failed: " .. to_string($rc) .. " " .. to_string($r)) end
    print("layout split — " .. trim("" .. $r))
  elif $name == "dev" then
    -- One tab exists at launch; two more make the edit/build/run trio.
    $verb = $svc .. ".tab.new"
    $r1 = send $svc $verb body=""
    if $rc != 0 then raise("TERM_SEND", "first new tab failed: " .. to_string($rc) .. " " .. to_string($r1)) end
    $r2 = send $svc $verb body=""
    if $rc != 0 then raise("TERM_SEND", "second new tab failed (first tab remains): " .. to_string($rc) .. " " .. to_string($r2)) end
    print("layout dev — added two tabs (" .. trim("" .. $r1) .. "; " .. trim("" .. $r2) .. ")")
  else
    raise("TERM_LAYOUT", "unknown layout: " .. $name .. " (known: split, dev)")
  end
end

$a = args()
if len($a) < 1 then usage() end
$cmd = $a[0]

-- Resolve the target directory (open/focus: arg 1; layout: arg 2) and, for
-- layout, the layout name (arg 1).
$dir = cwd()
$layout = ""
if $cmd == "open" then
  if len($a) >= 2 then $dir = $a[1] end
elif $cmd == "focus" then
  if len($a) >= 2 then $dir = $a[1] end
elif $cmd == "layout" then
  if len($a) < 2 then usage() end
  $layout = $a[1]
  if len($a) >= 3 then $dir = $a[2] end
else
  usage()
end

-- Resolved ONCE here, and again after a launch (below) because before the
-- launch there is by definition nothing to resolve. Seven seconds is enough
-- for both probes to take their full cap and still answer.
$service = resolve_term_service(time() + 7)
$running = $service != ""
if $running and (($cmd == "focus" and len($a) >= 2) or ($cmd == "layout" and len($a) >= 3)) then
  print("requested directory not applied: " .. $dir .. " — running Term's diagnostic verbs cannot carry cwd; this lands with P3a identity")
end

-- open always launches; focus/layout launch only when nothing is running.
$need_launch = false
if $cmd == "open" then $need_launch = true end
if ($cmd == "focus" or $cmd == "layout") and not $running then $need_launch = true end

if $need_launch then
  if not is_dir($dir) then raise("TERM_DIR", "not a directory: " .. $dir) end
  if env("WAYLAND_DISPLAY") == "" then
    raise("TERM_NODISPLAY", "WAYLAND_DISPLAY unset — run under a Wayland compositor")
  end
  -- TERM_CWD is inherited by the detached child (space-safe, no shell quoting);
  -- `mix --gui` resolves the Term frontend and the child shell starts in $dir.
  -- mix --gui owns binary resolution, including COSMIX_TERM_BIN.
  export TERM_CWD = $dir
  -- Resolve while this launcher is alive; another Term may answer INFO at once.
  $resolved = run_argv(["readlink", "-f", "/proc/" .. to_string(pid()) .. "/exe"])
  $mix = "/opt/cosmix/bin/mix"
  if $resolved.ok and trim($resolved.stdout) != "" then $mix = trim($resolved.stdout) end
  $pid = spawn(shell_quote($mix) .. " --gui", "/dev/null", "/dev/null")
  print("launched Term (pid " .. to_string($pid) .. ") with its shell in " .. $dir)
  -- Wait (bounded) for A frontend to be answering, and take the name to drive
  -- from that probe: which binary `mix --gui` resolved is not knowable from
  -- here until one answers.
  --
  -- Honest about what this proves and what it does not. It proves a frontend
  -- is answering; it does NOT prove the child just launched is that frontend.
  -- Where one was already running (`open` always launches, even then) the
  -- pre-existing instance satisfies the probe immediately and a failed launch
  -- goes unnoticed. Distinguishing the two needs per-instance identity, which
  -- is P0-I and not available on this lane.
  --
  -- The deadline is WALL TIME, not an iteration count: each probe can now cost
  -- up to its own timeout, so counting sleeps would have silently stretched a
  -- stated 20s into minutes. The deadline is handed DOWN to each probe, so the
  -- overrun is bounded by one sleep rather than by two probe timeouts per
  -- iteration. (Mix has no monotonic clock builtin — `time()` is Unix time, so
  -- a clock step during the wait skews this. Acceptable for a 20s desktop
  -- launch; it would not be for a lease.)
  $deadline = time() + 20
  $service = resolve_term_service($deadline)
  while $service == "" and time() < $deadline
    sleep(0.5)
    $service = resolve_term_service($deadline)
  end
  if $service == "" then raise("TERM_NOREG", "no Term answered on the Bus within 20s (looked for `term`)") end
  print("driving Bus service `" .. $service .. "`")
end

if $cmd == "focus" then
  if $running then
    $verb = $service .. ".tab.new"
    $r = send $service $verb body=""
    if $rc != 0 then raise("TERM_SEND", "new tab failed: " .. to_string($rc) .. " " .. to_string($r)) end
    print("reused running Term `" .. $service .. "` — opened a new tab (" .. trim("" .. $r) .. ")")
  else
    print("no running Term — opened a new one in " .. $dir)
  end
elif $cmd == "layout" then
  apply_layout($layout, $service)
end
