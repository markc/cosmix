-- term-desktop.mix — agentless desktop-workflow launcher for CosMix Term.
--
-- Drives CosMix Term over the Bus with NO AI agent in the loop: the desktop
-- "open a terminal here", "focus the running one", and "lay a project out"
-- workflows, done offline and model-independently through the live frontend's
-- verbs plus a detached launch. This is the sovereign control path — the same
-- surface an agent reaches through MCP is reachable here from a plain script.
--
-- WHICH frontend is resolved, never hardcoded (D1, TODO-term 2026-09-21): the
-- Bevy terminal was renamed and now registers as `bterm` / serves `bterm.*`,
-- and the global name `term` belongs to the iced+wgpu one. Both may be running
-- at once, and cosmix-term-core REFUSES a verb from the other namespace — so
-- the name is resolved once and every verb is built from it.
--
-- usage:
--   mix term-desktop.mix open [DIR]           open Term with its shell in DIR (default: cwd)
--   mix term-desktop.mix focus [DIR]          reuse a running Term (add a tab); else open in DIR
--   mix term-desktop.mix layout NAME [DIR]    ensure Term runs, then build a named project layout
--
-- Layouts: "split" (split the active pane into two side-by-side panes);
--          "dev" (three tabs for edit / build / run).
--
-- Visual window-raising for `focus` needs a compositor activate verb Comp does
-- not expose yet (comp.window.activate); until it lands, `focus` reuses the
-- running instance by adding a tab rather than spawning a second window — the
-- desktop-legible "don't proliferate windows" half of focus-existing.

-- The Bus name of a LIVE CosMix terminal: `term` (the default frontend) if it
-- answers, else `bterm` (the Bevy one), else "" when neither does.
--
-- INFO is answered by any live frontend, so this proves the instance is
-- responsive and not merely registered — this script is about to drive verbs,
-- not just report. Preference order matches `mix --gui`'s binary resolution
-- (term, then bterm) so the launcher drives the same terminal it starts.
fn resolve_term_service()
  for $name in ["term", "bterm"]
    $probe = send $name "INFO" body=""
    if $rc == 0 then return $name end
  end
  return ""
end

fn usage()
  raise("TERM_ARGS", "usage: open [DIR] | focus [DIR] | layout NAME [DIR]")
end

-- Every verb is built from the RESOLVED service. `cosmix-term-core`'s
-- canonical_verb() refuses a verb whose namespace is not the frontend's own
-- name, so a hardcoded `term.` prefix sent to bterm is a rejected call, not an
-- untidy one.
fn apply_layout($name, $svc)
  if $name == "split" then
    $verb = $svc .. ".pane.split"
    $r = send $svc $verb dir="v"
    if $rc != 0 then raise("TERM_SEND", "split failed: " .. to_string($rc) .. " " .. to_string($r)) end
    print("layout split — " .. trim("" .. $r))
  elif $name == "dev" then
    -- One tab exists at launch; two more make the edit/build/run trio.
    $verb = $svc .. ".tab.new"
    $r1 = send $svc $verb body=""
    if $rc != 0 then raise("TERM_SEND", "first new tab failed: " .. to_string($rc) .. " " .. to_string($r1)) end
    $r2 = send $svc $verb body=""
    if $rc != 0 then raise("TERM_SEND", "second new tab failed (first tab remains): " .. to_string($rc) .. " " .. to_string($r2)) end
    print("layout dev — added two tabs (" .. trim("" .. $r1) .. "; " .. trim("" .. $r2) .. ")")
  else
    raise("TERM_LAYOUT", "unknown layout: " .. $name .. " (known: split, dev)")
  end
end

$a = args()
if len($a) < 1 then usage() end
$cmd = $a[0]

-- Resolve the target directory (open/focus: arg 1; layout: arg 2) and, for
-- layout, the layout name (arg 1).
$dir = cwd()
$layout = ""
if $cmd == "open" then
  if len($a) >= 2 then $dir = $a[1] end
elif $cmd == "focus" then
  if len($a) >= 2 then $dir = $a[1] end
elif $cmd == "layout" then
  if len($a) < 2 then usage() end
  $layout = $a[1]
  if len($a) >= 3 then $dir = $a[2] end
else
  usage()
end

-- Resolved ONCE here, and again after a launch (below) because before the
-- launch there is by definition nothing to resolve.
$service = resolve_term_service()
$running = $service != ""
if $running and (($cmd == "focus" and len($a) >= 2) or ($cmd == "layout" and len($a) >= 3)) then
  print("requested directory not applied: " .. $dir .. " — running Term's diagnostic verbs cannot carry cwd; this lands with P3a identity")
end

-- open always launches; focus/layout launch only when nothing is running.
$need_launch = false
if $cmd == "open" then $need_launch = true end
if ($cmd == "focus" or $cmd == "layout") and not $running then $need_launch = true end

if $need_launch then
  if not is_dir($dir) then raise("TERM_DIR", "not a directory: " .. $dir) end
  if env("WAYLAND_DISPLAY") == "" then
    raise("TERM_NODISPLAY", "WAYLAND_DISPLAY unset — run under a Wayland compositor")
  end
  -- TERM_CWD is inherited by the detached child (space-safe, no shell quoting);
  -- `mix --gui` resolves the Term frontend and the child shell starts in $dir.
  -- The BINARY resolution lives in `mix --gui` (COSMIX_TERM_BIN, then term then
  -- bterm at each tier) and is deliberately not duplicated here: a second copy
  -- of that search would be a second thing to keep in step with the first.
  export TERM_CWD = $dir
  -- Resolve while this launcher is alive; another Term may answer INFO at once.
  $resolved = run_argv(["readlink", "-f", "/proc/" .. to_string(pid()) .. "/exe"])
  $mix = "/opt/cosmix/bin/mix"
  if $resolved.ok and trim($resolved.stdout) != "" then $mix = trim($resolved.stdout) end
  $pid = spawn(shell_quote($mix) .. " --gui", "/dev/null", "/dev/null")
  print("launched Term (pid " .. to_string($pid) .. ") with its shell in " .. $dir)
  -- Wait (bounded) for the new instance to register before driving it, and
  -- take its name from that same probe: which frontend `mix --gui` found is
  -- not knowable until it answers.
  $i = 0
  $service = resolve_term_service()
  while $i < 40 and $service == ""
    sleep(0.5)
    $i = $i + 1
    $service = resolve_term_service()
  end
  if $service == "" then raise("TERM_NOREG", "Term did not register on the Bus within 20s (looked for `term`, then `bterm`)") end
  print("driving Bus service `" .. $service .. "`")
end

if $cmd == "focus" then
  if $running then
    $verb = $service .. ".tab.new"
    $r = send $service $verb body=""
    if $rc != 0 then raise("TERM_SEND", "new tab failed: " .. to_string($rc) .. " " .. to_string($r)) end
    print("reused running Term `" .. $service .. "` — opened a new tab (" .. trim("" .. $r) .. ")")
  else
    print("no running Term — opened a new one in " .. $dir)
  end
elif $cmd == "layout" then
  apply_layout($layout, $service)
end
