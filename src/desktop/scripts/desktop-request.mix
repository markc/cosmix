-- version: 0.3.6
-- Internal one-shot worker for desktop-cli.mix; no positional arguments in serve mode.
$request = json_parse(env("DESKTOP_REQUEST"))
$desktop = require("lib/desktop.mix")
fn rpc($target, $verb, $body)
  send $target $verb body=json_encode($body) timeout=8
  if $rc != 0 then
    -- Raw replies can contain clipboard contents or URLs. Never print them.
    raise("DESKTOP_RPC", "Bus operation failed rc=" .. to_string($rc))
  end
  if type($result) == "string" then return json_parse($result) end
  return $result
end
fn target_ok($target)
  return $desktop.target_ok($target)
end
if type($request) != "map" or not target_ok($request.target) then
  raise("DESKTOP_ARGS", "target must be a local service or service.node.bus")
end
if $request.id != nil and (not $desktop.is_int($request.id) or $request.id < 1) then
  raise("DESKTOP_ARGS", "id must be a positive integer")
end
$destination = rpc($request.target, "desktop.capabilities", {})
if $destination.api_version != 1 or type($destination.instance) != "string" then raise("DESKTOP_PROTOCOL", "unsupported capability response") end
if $request.operation == "capabilities" then
  print(json_encode($destination))
elif $request.operation == "copy" then
  if not target_ok($request.source) or $request.source == $request.target then raise("DESKTOP_ARGS", "distinct source and target required") end
  $source = rpc($request.source, "desktop.capabilities", {})
  if $source.api_version != 1 or type($source.instance) != "string" then raise("DESKTOP_PROTOCOL", "unsupported source capability response") end
  $clipboard = rpc($request.source, "desktop.clipboard.read", {instance:$source.instance})
  if $clipboard.instance != $source.instance or $clipboard.mime != "text/plain;charset=utf-8" or type($clipboard.text) != "string" or byte_length($clipboard.text) > 65536 then
    raise("DESKTOP_PROTOCOL", "invalid clipboard response")
  end
  $reply = rpc($request.target, "desktop.clipboard.write", {instance:$destination.instance,text:$clipboard.text})
  if $reply.instance != $destination.instance or $reply.accepted != true then raise("DESKTOP_PROTOCOL", "write not accepted") end
  print(json_encode({operation:"copy", accepted:true, bytes:byte_length($clipboard.text)}))
elif $request.operation == "open" then
  $reply = rpc($request.target, "desktop.open", {instance:$destination.instance,url:$request.url})
  if $reply.instance != $destination.instance or $reply.accepted != true then raise("DESKTOP_PROTOCOL", "open not accepted") end
  print(json_encode({operation:"open",accepted:true}))
elif $request.operation == "history" then
  $body = {instance:$destination.instance}
  if $request.q != nil then $body.q = $request.q end
  $reply = rpc($request.target, "desktop.clipboard.history", $body)
  if $reply.instance != $destination.instance or type($reply.entries) != "list" then raise("DESKTOP_PROTOCOL", "invalid history response") end
  print(json_encode($reply))
elif $request.operation == "entry" then
  $reply = rpc($request.target, "desktop.clipboard.entry", {instance:$destination.instance, id:$request.id})
  if $reply.instance != $destination.instance or type($reply.text) != "string" then raise("DESKTOP_PROTOCOL", "invalid entry response") end
  print(json_encode({id:$reply.id, bytes:$reply.bytes, mime:$reply.mime}))
elif $request.operation == "rpick" then
  -- Pick from a (possibly remote) session's history into the local target's
  -- live selection: entry text travels Bus-to-Bus, never stdout.
  if not target_ok($request.source) or $request.source == $request.target then raise("DESKTOP_ARGS", "distinct source and target required") end
  $source = rpc($request.source, "desktop.capabilities", {})
  if $source.api_version != 1 or type($source.instance) != "string" then raise("DESKTOP_PROTOCOL", "unsupported source capability response") end
  $entry = rpc($request.source, "desktop.clipboard.entry", {instance:$source.instance, id:$request.id})
  if $entry.instance != $source.instance or $entry.id != $request.id or type($entry.text) != "string" or byte_length($entry.text) > 65536 then
    raise("DESKTOP_PROTOCOL", "invalid entry response")
  end
  $reply = rpc($request.target, "desktop.clipboard.write", {instance:$destination.instance, text:$entry.text})
  if $reply.instance != $destination.instance or $reply.accepted != true then raise("DESKTOP_PROTOCOL", "write not accepted") end
  print(json_encode({operation:"rpick", accepted:true, bytes:byte_length($entry.text)}))
elif $request.operation == "pick" then
  $reply = rpc($request.target, "desktop.clipboard.pick", {instance:$destination.instance, id:$request.id})
  if $reply.instance != $destination.instance or $reply.accepted != true then raise("DESKTOP_PROTOCOL", "pick not accepted") end
  print(json_encode({operation:"pick", accepted:true, id:$reply.id, bytes:$reply.bytes}))
elif $request.operation == "clear" then
  $body = {instance:$destination.instance}
  if $request.id != nil then $body.id = $request.id end
  $reply = rpc($request.target, "desktop.clipboard.clear", $body)
  if $reply.instance != $destination.instance or type($reply.removed) != "number" then raise("DESKTOP_PROTOCOL", "invalid clear response") end
  print(json_encode({operation:"clear", removed:$reply.removed}))
elif $request.operation == "menu" then
  $reply = rpc($request.target, "desktop.clipboard.menu", {instance:$destination.instance})
  if $reply.instance != $destination.instance or $reply.menu != true then raise("DESKTOP_PROTOCOL", "menu not accepted") end
  print(json_encode({operation:"menu", accepted:true}))
elif $request.operation == "rotate" then
  $reply = rpc($request.target, "desktop.clipboard.rotate", {instance:$destination.instance})
  if $reply.instance != $destination.instance or $reply.rotated == nil then raise("DESKTOP_PROTOCOL", "invalid rotate response") end
  print(json_encode({operation:"rotate", rotated:$reply.rotated, id:$reply.id}))
elif $request.operation == "pause" then
  $reply = rpc($request.target, "desktop.clipboard.pause", {instance:$destination.instance, on:$request.on})
  if $reply.instance != $destination.instance or type($reply.paused) != "bool" then raise("DESKTOP_PROTOCOL", "invalid pause response") end
  print(json_encode({operation:"pause", paused:$reply.paused}))
else
  raise("DESKTOP_ARGS", "unknown operation")
end
quit()
