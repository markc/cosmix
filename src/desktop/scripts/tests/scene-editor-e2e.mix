-- Scene Editor e2e (plan §7 Stages L and T, §8.2): a private noded, the real
-- loader (scenes.mix as `scenes`), fixtures/scene-editor/fake-shell.mix as the
-- scene host `fakeshell` (SCENE_HOST; it cannot be named `shell`), the
-- shipped editor template's real behaviour, and recording fakes for `apps`
-- (fake-apps.mix) and `ced` (fake-ced.mix). The loader half checks first run,
-- open/close, the safe-open toggle, a Quoin-side dismiss, the user-copy
-- fallback, a behaviour crash, scenes-cli.mix (list, editor --safe, reset, a
-- refusal) and a host without dialogs. The behaviour half drives Quoin-shaped
-- clicks at `scene-editor`: the Recommended set, Edit through apps.launch and
-- through ced.open, the scenes-source diagnostics push (broken, re-saved,
-- fixed), move with one shell.panel.order, two-step remove, and a fork /
-- promote round trip. The proof that loader and editor agree on the contract
-- without a renderer. Nothing reaches the host Bus: private TCP port, private
-- unix socket, admission off, HOME and state dirs in the temp dir.
-- Run: mix src/desktop/scripts/tests/scene-editor-e2e.mix
-- COSMIX_TEST_MIX / COSMIX_TEST_NODED point at freshly built binaries;
-- defaults are the system install. SE_E2E_KEEP=1 keeps the temp dir (logs).
$here = dirname(realpath($0))
$repo = realpath($here .. "/../../../..")
$scripts = $repo .. "/src/desktop/scripts"
$mix = env("COSMIX_TEST_MIX", "")
if $mix == "" then $mix = "/opt/cosmix/bin/mix" end
$noded = env("COSMIX_TEST_NODED", "")
if $noded == "" then $noded = "/opt/cosmix/bin/cosmix-noded" end
for each $bin in [$mix, $noded]
  if not exists($bin) then raise("TEST_CONFIG", "missing binary " .. $bin) end
end
$tmp = trim(run_argv_must(["mktemp", "-d", "/tmp/cosmix-se-e2e.XXXXXXXX"]))
$tag = slice(replace(uuid(), "-", ""), 0, 8)
$node = $tmp .. "/node.conf.mix"
$shell_log = $tmp .. "/shell-requests.jsonl"
$env = {COSMIX_NODE_CONFIG:$node, MIX_STATS:"off", PATH:"/usr/bin:/bin",
  HOME:$tmp, XDG_STATE_HOME:$tmp, XDG_RUNTIME_DIR:$tmp, XDG_CONFIG_HOME:$tmp .. "/config"}
$fx = $here .. "/fixtures/scene-editor"
$apps_log = $tmp .. "/apps-requests.jsonl"
$ced_log = $tmp .. "/ced-requests.jsonl"
$pids = {noded:nil, shell:nil, scenes:nil, apps:nil, ced:nil}
$checks = {count:0}

fn check($ok, $message)
  $checks.count = $checks.count + 1
  if not $ok then raise("SE_E2E", $message) end
end
-- One-shot anonymous client; runtime values arrive as $a from argv.
fn call($svc, $verb, $a)
  $src = "$a = json_parse($1)\n$w = json_encode($a)\nsend " .. $svc .. " " .. $verb .. " body=$w timeout=30\n" ..
    "$v = $result\nif type($v) == \"string\" then\n  try\n    $v = json_parse($v)\n  catch $ignored\n  end\nend\n" ..
    "print(json_encode({rc: $rc, reply: $v}))\n"
  write_file($tmp .. "/step.mix", $src)
  $run = run_argv([$mix, $tmp .. "/step.mix", json_encode($a)], {clear_env:true, env:$env, timeout:45})
  check($run.ok, "client step failed: " .. $svc .. " " .. $verb .. ": " .. $run.stderr .. $run.stdout)
  return json_parse($run.stdout)
end
fn ok($svc, $verb, $a)
  $r = call($svc, $verb, $a)
  check($r.rc == 0, $svc .. " " .. $verb .. " failed: " .. json_encode($r))
  return $r.reply
end
fn refused($svc, $verb, $a, $code)
  $r = call($svc, $verb, $a)
  check($r.rc == 10 and ($r.reply ?? {}).error_code == $code, $svc .. " " .. $verb .. " expected " .. $code .. ": " .. json_encode($r))
  return $r.reply
end
fn editor()
  return ok("scenes", "scenes.list", {}).editor
end
-- Harness wait (bounded) for event-driven state to settle; not a backend poll.
fn until($what, $pred_field, $want)
  for each $i in range(1, 100)
    $ed = editor()
    if deep_eq($ed[$pred_field], $want) then return $ed end
    sleep(0.1)
  end
  raise("SE_E2E", "timed out waiting for " .. $what .. ": " .. json_encode(ok("scenes", "scenes.list", {})))
end
-- Requests a recording fake appended to its log, for one verb.
fn logged($path, $verb)
  if not exists($path) then return [] end
  return filter(map(read_lines($path), fn($l) = json_parse($l)), fn($c) = $c.verb == $verb)
end
fn shell_calls($verb)
  return logged($shell_log, $verb)
end
fn start_citizen($name, $script, $extra, $log)
  $e = {}
  for each $k in keys($env)
    $e[$k] = $env[$k]
  end
  for each $k in keys($extra)
    $e[$k] = $extra[$k]
  end
  $pid = spawn([$mix, "--serve", $script, "--name", $name],
    {detach:true, clear_env:true, env:$e, cwd:dirname($script), stdout:{file:$tmp .. "/" .. $log}, stderr:"stdout"})
  for each $i in range(1, 100)
    $r = run_argv([$mix, "-c", "send noded noded.props.get body=\"{}\" timeout=5\nprint(json_encode($result))"], {clear_env:true, env:$env, timeout:10})
    if $r.ok and contains($r.stdout, "\"" .. $name .. "\"") then return $pid end
    sleep(0.1)
  end
  raise("SE_E2E", $name .. " did not register; log " .. $tmp .. "/" .. $log .. ": " .. read_file($tmp .. "/" .. $log))
end
fn stop($pid)
  if $pid != nil and process_alive($pid) then
    $_ = kill($pid, 15)
    for each $i in range(1, 50)
      if not process_alive($pid) then return end
      sleep(0.1)
    end
    $_ = kill($pid, 9)
  end
end
-- The editor behaviour is the loader's child registered as scene-editor.
fn editor_pid($loader)
  for each $d in ls("/proc")
    if not re_match($d, "^[0-9]+$") then continue end
    try
      $stat = read_file("/proc/" .. $d .. "/stat")
      $ppid = to_number(split(trim(substr($stat, index_of($stat, ")") + 2)), " ")[1])
      if $ppid == $loader and contains(read_file("/proc/" .. $d .. "/cmdline"), "scene-editor") then return to_number($d) end
    catch $ignored
    end
  end
  return nil
end
fn cli($argv)
  $e = {}
  for each $k in keys($env)
    $e[$k] = $env[$k]
  end
  $full = [$mix, $scripts .. "/scenes-cli.mix"]
  for each $a in $argv
    push($full, $a)
  end
  return run_argv($full, {clear_env:true, env:$e, timeout:90})
end

-- ── the behaviour half: Quoin-shaped clicks at scene-editor ─────────────
fn estate()
  return ok("scene-editor", "editor.state", {})
end
-- A click as Quoin directs it: {scene, node, kind, item?}.
fn click($verb, $node, $item)
  $a = {scene:"editor", node:$node, kind:"click"}
  if $item != nil then $a.item = $item end
  return ok("scene-editor", $verb, $a)
end
-- An action click is answered {queued:true} and runs as one local task; the
-- behaviour sets busy before it replies, so busy:false after the reply means
-- exactly this action finished.
fn act($verb, $node, $item)
  $r = click($verb, $node, $item)
  check($r.queued == true, $verb .. " " .. $node .. " was not queued: " .. json_encode($r))
  for each $i in range(1, 300)
    $st = estate()
    if not $st.busy then
      check($st.last != nil and $st.last.failed == nil, $verb .. " " .. $node .. " failed: " .. json_encode($st.last))
      return $st
    end
    sleep(0.1)
  end
  raise("SE_E2E", $verb .. " " .. $node .. " never finished: " .. json_encode(estate()))
end
fn scene_row($name)
  for each $row in ok("scenes", "scenes.list", {}).scenes
    if $row.name == $name then return $row end
  end
  return nil
end
fn row_until($name, $field, $want)
  for each $i in range(1, 150)
    $row = scene_row($name)
    if $row != nil and deep_eq($row[$field], $want) then return $row end
    sleep(0.1)
  end
  raise("SE_E2E", "timed out waiting for " .. $name .. "." .. $field .. " = " .. json_encode($want) .. ": " .. json_encode(scene_row($name)))
end
-- The behaviour plans against its own cached inventory: wait until its
-- published model lists (or no longer lists) the scene before clicking.
fn model_lists($name, $want)
  for each $i in range(1, 150)
    $found = false
    for each $row in (estate().model ?? {}).scenes ?? []
      if $row.name == $name then $found = true end
    end
    if $found == $want then return end
    sleep(0.1)
  end
  raise("SE_E2E", "the editor model never " .. ($want ? "listed " : "dropped ") .. $name .. ": " .. json_encode(estate().model))
end
fn pick($name)
  model_lists($name, true)
  $r = click("editor.scene.select", "scenes", {id:"s_" .. $name, name:$name})
  check($r.queued == false, "a selection is not queued: " .. json_encode($r))
  for each $i in range(1, 100)
    $sel = (estate().model ?? {}).selected ?? {}
    if $sel.shown and $sel.name == $name then return $sel end
    sleep(0.1)
  end
  raise("SE_E2E", "selecting " .. $name .. " never showed it: " .. json_encode(estate().model.selected))
end
fn services_until($name)
  for each $i in range(1, 100)
    if contains(estate().services ?? [], $name) then return end
    sleep(0.1)
  end
  raise("SE_E2E", "the editor never saw " .. $name .. " register")
end
fn show_editor()
  if not editor().visible then
    $_ = ok("scenes", "scenes.editor.open", {safe:true})
  end
  $_ = until("editor visible", "visible", true)
end
-- The first ced.diagnostics for $path at log index >= $from.
fn pushed($path, $from)
  for each $i in range(1, 150)
    $all = logged($ced_log, "ced.diagnostics")
    for each $k in range($from, len($all) - 1)
      if $all[$k].args.path == $path then return {index:$k, args:$all[$k].args} end
    end
    sleep(0.1)
  end
  raise("SE_E2E", "no ced.diagnostics for " .. $path .. " after #" .. to_string($from) .. ": " .. json_encode(logged($ced_log, "ced.diagnostics")))
end

try
  $alive = false
  for each $attempt in range(1, 5)
    $port = random(49000, 49999)
    write_file($node, json_encode({node:"se-e2e-" .. $tag, wg_ip:"", mesh:"se-e2e.invalid",
      noded:{port:$port, admission:"off", unix_socket:$tmp .. "/bus.sock"}}))
    $pids.noded = spawn([$noded, "serve", "--listen", "127.0.0.1:" .. to_string($port), "--node", "se-e2e-" .. $tag, "--no-monitor", "--no-log"],
      {detach:true, clear_env:true, env:$env, stdout:{file:$tmp .. "/noded.log"}, stderr:"stdout"})
    sleep(0.5)
    $alive = process_alive($pids.noded)
    if $alive then break end
  end
  check($alive, "broker exhausted port retries")

  $shell_script = $here .. "/fixtures/scene-editor/fake-shell.mix"
  $pids.shell = start_citizen("fakeshell", $shell_script, {FAKE_SHELL_LOG:$shell_log, FAKE_SHELL_OWNER:"scenes"}, "shell.log")
  mkdir($tmp .. "/scenes")
  $loader_env = {SCENES_DIR:$tmp .. "/scenes", SCENES_TEMPLATES:$repo .. "/share/scenes", SCENE_HOST:"fakeshell",
    SCENES_LEGACY_SERVICE:"se-e2e-none"}
  $pids.scenes = start_citizen("scenes", $scripts .. "/scenes.mix", $loader_env, "scenes.log")

  -- First run: empty scenes, the shell live -> the editor opens on the gallery.
  $ed = until("first-run editor visible", "visible", true)
  check($ed.first_run and $ed.view == "gallery" and $ed.source == "shipped" and $ed.mounted and $ed.request_seq == 1, "first run opened the gallery: " .. json_encode($ed))
  check(len(shell_calls("shell.dialog.show")) == 1 and shell_calls("shell.scene.load")[0].args.preempt_dialog == true, "one pre-empting dialog load and one show")
  $ed = until("stub behaviour running", "behaviour", "running")
  $first_pid = editor_pid($pids.scenes)
  check($first_pid != nil, "the scene-editor behaviour is the loader's child")

  -- Close, then the safe open and its toggle, then a Quoin-side dismiss.
  $r = ok("scenes", "scenes.editor.close", {})
  check($r.visible == false and $r.mounted, "close hides and keeps it mounted: " .. json_encode($r))
  $ed = until("hidden", "visible", false)
  $r = ok("scenes", "scenes.editor.open", {safe:true, view:"installed"})
  check($r.source == "shipped" and $r.safe and $r.request_seq == 2, "safe open: " .. json_encode($r))
  $ed = until("safe open visible", "visible", true)
  check($ed.view == "installed" and $ed.safe, "view carried in the record")
  $r = ok("scenes", "scenes.editor.open", {safe:true})
  check($r.visible == false, "second safe open toggles: " .. json_encode($r))
  $ed = until("toggled off", "visible", false)
  $r = ok("scenes", "scenes.editor.open", {safe:true})
  $ed = until("reopened", "visible", true)
  ok("fakeshell", "fake.dismiss", {})
  $ed = until("dismissed by Quoin", "visible", false)
  check(editor_pid($pids.scenes) == $first_pid, "hide and show never restart the behaviour")

  -- The user copy: installed, broken, and the non-safe open falls back.
  $r = ok("scenes", "scenes.install", {template:"editor"})
  check($r.name == "editor" and $r.enabled == false, "user copy installed: " .. json_encode($r))
  refused("scenes", "scenes.install", {template:"editor", name:"editor-two"}, "SCENES_RESERVED")
  $user_scene = $tmp .. "/scenes/editor/scene.mix"
  write_file($user_scene, replace(read_file($user_scene), "citizen: scene-editor", "citizen: scene-other"))
  $r = ok("scenes", "scenes.editor.open", {})
  check($r.source == "shipped" and ($r.fallback ?? {}).error_code == "SCENES_CITIZEN", "a broken user copy falls back: " .. json_encode($r))
  $ed = until("fallback visible", "visible", true)
  check($ed.fallback.error_code == "SCENES_CITIZEN" and $ed.user_copy, "fallback published in scenes.list")

  -- Crash: SIGKILL the behaviour; the restart deadline brings it back.
  $gen = $ed.generation
  check(kill($first_pid, 9), "could not SIGKILL scene-editor")
  for each $i in range(1, 100)
    $ed = editor()
    if $ed.generation > $gen and $ed.behaviour == "running" then break end
    sleep(0.1)
  end
  check($ed.generation > $gen and $ed.behaviour == "running" and $ed.mounted, "crashed editor restarted: " .. json_encode($ed))
  check(editor_pid($pids.scenes) != nil and editor_pid($pids.scenes) != $first_pid, "a new behaviour process")

  -- scenes-cli.mix: list, editor --safe, reset, and a refusal.
  $c = cli(["list"])
  check($c.ok and contains($c.stdout, "editor: source=shipped") and contains($c.stdout, "needs_setup"), "cli list: " .. $c.stdout .. $c.stderr)
  $c = cli(["list", "--json"])
  check($c.ok and json_parse($c.stdout).editor.user_copy == true, "cli list --json")
  $c = cli(["editor", "--safe"])
  check($c.ok and json_parse($c.stdout).name == "editor", "cli editor --safe: " .. $c.stdout .. $c.stderr)
  $c = cli(["reset", "editor"])
  check($c.ok and contains(read_file($user_scene), "citizen: scene-editor") and is_dir(json_parse($c.stdout).recovery), "cli reset restores the user copy: " .. $c.stdout .. $c.stderr)
  $c = cli(["enable", "editor"])
  check(not $c.ok and $c.exit_code == 1 and json_parse(trim($c.stdout)).error_code == "SCENES_RESERVED", "cli refusal exits 1 with the code: " .. $c.stdout .. $c.stderr)
  $c = cli(["templates"])
  check($c.ok and contains($c.stdout, "panel") and not contains($c.stdout, " editor "), "cli templates: " .. $c.stdout)

  -- The mesh refusal table against the real loader, both routes local here
  -- (the attested mesh route runs in the nested gate or live).
  $mt = run_argv([$mix, $here .. "/scenes-mesh-test.mix"], {clear_env:true, timeout:120,
    env:{COSMIX_NODE_CONFIG:$node, MIX_STATS:"off", PATH:"/usr/bin:/bin", HOME:$tmp, XDG_RUNTIME_DIR:$tmp,
      SCENES_LOCAL_TARGET:"scenes", SCENES_REMOTE_TARGET:"scenes"}})
  check($mt.ok and contains($mt.stdout, "PASS"), "scenes-mesh-test refusal table: " .. $mt.stdout .. $mt.stderr)

  -- ── The behaviour half (Stage T): Quoin-shaped clicks at scene-editor ──
  $pids.apps = start_citizen("apps", $fx .. "/fake-apps.mix", {FAKE_APPS_LOG:$apps_log}, "apps.log")
  services_until("apps")
  for each $i in range(1, 100)
    if len((estate().model ?? {}).templates ?? []) >= 5 then break end
    sleep(0.1)
  end
  check(len(estate().model.templates) >= 5, "the gallery lists the shipped templates: " .. json_encode(estate().model.templates))

  -- Recommended set: the five, installed and enabled in gallery order.
  $recommended = ["panel", "launcher", "calendar", "notes", "quoin-settings"]
  $loads_before = len(shell_calls("shell.scene.load"))
  $st = act("editor.recommended", "btn_recommended", nil)
  check($st.last.kind == "recommended", "recommended ran: " .. json_encode($st.last))
  for each $name in $recommended
    $row = row_until($name, "mounted", true)
    check($row.installed and $row.enabled, $name .. " installed and enabled: " .. json_encode($row))
  end
  $order = []
  $loads = shell_calls("shell.scene.load")
  for each $k in range($loads_before, len($loads) - 1)
    $m = re_find($loads[$k].args.source ?? "", "\nname: ([a-z0-9-]+)\n")
    if len($m) > 0 and not contains($order, $m[0].groups[0]) then push($order, $m[0].groups[0]) end
  end
  check(deep_eq($order, $recommended), "mounted in gallery order: " .. json_encode($order))
  $panel_scene = scene_row("panel").files.scene
  check($panel_scene == $tmp .. "/scenes/panel/scene.mix", "absolute scene path: " .. to_string($panel_scene))

  -- Edit with no ced registered: apps.launch (never a spawn), dialog hidden.
  show_editor()
  $_ = pick("panel")
  $st = act("editor.scene.edit", "btn_edit_scene", nil)
  check($st.last.kind == "edit", "edit ran: " .. json_encode($st.last))
  $launches = logged($apps_log, "apps.launch")
  check(len($launches) == 1 and $launches[0].args.id == "dev.cosmix.ced" and deep_eq($launches[0].args.uris, [$panel_scene]),
    "apps.launch of ced on the absolute path: " .. json_encode($launches))
  $_ = until("edit hides the editor", "visible", false)
  check(len(logged($ced_log, "ced.open")) == 0, "no ced.open without ced")

  -- Edit with ced registered: ced.open, dialog hidden, the verdict pushed.
  $pids.ced = start_citizen("ced", $fx .. "/fake-ced.mix", {FAKE_CED_LOG:$ced_log}, "ced.log")
  services_until("ced")
  show_editor()
  $st = act("editor.scene.edit", "btn_edit_scene", nil)
  $opens = logged($ced_log, "ced.open")
  check(len($opens) == 1 and deep_eq($opens[0].args.paths, [$panel_scene]), "ced.open on the absolute path: " .. json_encode($opens))
  check(len(logged($apps_log, "apps.launch")) == 1, "no second apps.launch while ced is registered")
  $_ = until("edit hides the editor again", "visible", false)
  $p = pushed($panel_scene, 0)
  check($p.args.source == "scenes" and deep_eq($p.args.diagnostics, []), "a clean scene pushes []: " .. json_encode($p))

  -- A broken save: source "scenes", the host's line, the attempted digest.
  $good = read_file($panel_scene)
  $broken = replace($good, "\"title\":\"Panel\"", "\"title\":\"BROKEN one\"")
  check($broken != $good, "the panel header carries its title")
  $from = len(logged($ced_log, "ced.diagnostics"))
  write_file($panel_scene, $broken)
  $p = pushed($panel_scene, $from)
  check($p.args.source == "scenes" and $p.args.digest == hash_sha256($broken), "pushed with the attempted digest: " .. json_encode($p))
  $lines = map(filter($p.args.diagnostics, fn($d) = $d.code == "mix-parse"), fn($d) = $d.line)
  check(deep_eq($lines, [7]), "the host diagnostic keeps its line: " .. json_encode($p.args.diagnostics))
  $first_diags = $p.args.diagnostics
  check(row_until("panel", "mounted", true).accepted_digest == hash_sha256($good), "the last good tree stays applied")

  -- A re-save with identical problems still re-pushes (the digest is in the key).
  $broken2 = replace($good, "\"title\":\"Panel\"", "\"title\":\"BROKEN two\"")
  write_file($panel_scene, $broken2)
  $p = pushed($panel_scene, $p.index + 1)
  check($p.args.digest == hash_sha256($broken2) and deep_eq($p.args.diagnostics, $first_diags), "identical problems re-pushed: " .. json_encode($p))

  -- Fixed: [] for that file.
  write_file($panel_scene, $good)
  $p = pushed($panel_scene, $p.index + 1)
  check(deep_eq($p.args.diagnostics, []) and $p.args.digest == hash_sha256($good), "a fix clears the scenes source: " .. json_encode($p))

  -- Move notes to the left edge: scenes.move, then exactly one shell.panel.order.
  $_ = pick("notes")
  $old_edge = scene_row("notes").edge
  $orders_before = len(shell_calls("shell.panel.order"))
  $st = act("editor.scene.move", "move_left", nil)
  $row = row_until("notes", "edge", "left")
  $row = row_until("notes", "mounted", true)
  $orders = shell_calls("shell.panel.order")
  check(len($orders) == $orders_before + 1, "exactly one shell.panel.order: " .. json_encode($orders))
  $edges = $orders[len($orders) - 1].args.edges
  check(deep_eq(sort(keys($edges)), sort(["left", $old_edge])) and contains($edges.left, $row.page) and not contains($edges[$old_edge], $row.page),
    "one order write covers both edges: " .. json_encode($edges))

  -- Remove is two-step: the first click only arms.
  $_ = pick("calendar")
  $r = click("editor.scene.remove", "btn_remove", nil)
  check($r.queued == false and estate().ui.armed == "calendar", "the first remove click arms: " .. json_encode($r))
  for each $i in range(1, 100)
    if estate().model.selected.remove_label == "Confirm remove" then break end
    sleep(0.1)
  end
  check(estate().model.selected.remove_label == "Confirm remove", "armed label shown")
  check(scene_row("calendar") != nil and is_dir($tmp .. "/scenes/calendar"), "nothing removed on the first click")
  $st = act("editor.scene.remove", "btn_remove", nil)
  check($st.last.kind == "remove", "the second click removes")
  for each $i in range(1, 100)
    if scene_row("calendar") == nil then break end
    sleep(0.1)
  end
  check(scene_row("calendar") == nil and not is_dir($tmp .. "/scenes/calendar"), "calendar removed")

  -- Fork launcher, edit the sandbox, promote it back.
  $_ = pick("launcher")
  $st = act("editor.scene.fork", "btn_fork", nil)
  $sb = row_until("launcher-sandbox", "mounted", true)
  check($sb.enabled and $sb.forked_from == "launcher" and $sb.edge == scene_row("launcher").edge, "sandbox beside the original: " .. json_encode($sb))
  $sb_scene = $sb.files.scene
  $sb_text = read_file($sb_scene)
  check(contains($sb_text, "\"title\":\"Applications\""), "the sandbox is a copy of launcher")
  $edited = replace($sb_text, "\"title\":\"Applications\"", "\"title\":\"Apps sandbox\"")
  write_file($sb_scene, $edited)
  $_ = row_until("launcher-sandbox", "accepted_digest", hash_sha256($edited))
  for each $i in range(1, 100)
    $sel = estate().model.selected
    if $sel.name == "launcher-sandbox" and $sel.is_fork then break end
    sleep(0.1)
  end
  check(estate().model.selected.is_fork, "the fork is selected with Promote offered: " .. json_encode(estate().model.selected))
  $st = act("editor.scene.promote", "btn_promote", nil)
  check($st.last.kind == "promote", "promote ran")
  model_lists("launcher-sandbox", false)
  check(scene_row("launcher-sandbox") == nil, "the sandbox is gone")
  check(contains(read_file($tmp .. "/scenes/launcher/scene.mix"), "\"title\":\"Apps sandbox\"") and contains(read_file($tmp .. "/scenes/launcher/scene.mix"), "\nname: launcher\n"),
    "launcher carries the sandbox edit under its own name")
  $_ = row_until("launcher", "accepted_digest", hash_sha256(read_file($tmp .. "/scenes/launcher/scene.mix")))
  $kept = false
  for each $d in ls($tmp .. "/scenes/.recovery")
    $f = $tmp .. "/scenes/.recovery/" .. $d .. "/scene.mix"
    if exists($f) and contains(read_file($f), "\nname: launcher\n") and contains(read_file($f), "\"title\":\"Applications\"") then $kept = true end
  end
  check($kept, "the old launcher is kept in .recovery")

  -- A host without dialogs: the shipped editor is unavailable, nothing mounts.
  stop($pids.scenes)
  stop($pids.shell)
  $pids.shell = start_citizen("fakeshell", $shell_script, {FAKE_SHELL_LOG:$shell_log, FAKE_SHELL_OWNER:"scenes", FAKE_SHELL_DIALOGS:"0"}, "shell-nodialog.log")
  mkdir($tmp .. "/scenes-nodialog")
  $loader_env.SCENES_DIR = $tmp .. "/scenes-nodialog"
  $loader_env.SCENES_FIRST_RUN = "0"
  $pids.scenes = start_citizen("scenes", $scripts .. "/scenes.mix", $loader_env, "scenes-nodialog.log")
  $r = refused("scenes", "scenes.editor.open", {safe:true}, "SCENES_EDITOR_UNAVAILABLE")
  check($r.context.shipped.error_code == "SCENES_HOST_KIND", "no-dialog host named: " .. json_encode($r))
  check(not editor().mounted and editor_pid($pids.scenes) == nil, "nothing mounted on a host without dialogs")
  print("PASS scene-editor e2e: " .. to_string($checks.count) .. " assertions over a private noded")
finally
  for each $k in ["scenes", "ced", "apps", "shell", "noded"]
    stop($pids[$k])
  end
  if env("SE_E2E_KEEP", "") == "1" then
    print("kept " .. $tmp)
  else
    remove_dir($tmp)
  end
end
