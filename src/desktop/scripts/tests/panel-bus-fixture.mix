-- Bus-only dependencies for panel-bus-test.mix. No desktop or app effects.
$edges = {left: {pinned: false, visible: false, mode:"hidden", page:nil, pages:[]}, right: {pinned: false, visible: false, mode:"hidden", page:nil, pages:[]}, bottom: {pinned: false, visible: false, mode:"hidden", page:nil, pages:[]}}
$applied_state = {revision:0}
$scene_data = require("../lib/scenes.mix")
fn applied()
  $applied_state.revision = $applied_state.revision + 1
  publish(serve_name() .. ".panel.changed", json_encode({generation:1, revision:$applied_state.revision, panels:$edges}), {command:"shell.panel.changed"})
end
$lists = 0
$loads = 0
$launches = []
$mode = {}
$pending = false
$launcher_scene = ""
$notes_loads = 0
$pins = 0

on fixture.mode
  $mode = $event.args
  applied()
  reply(0, "{}")
end

on fixture.refresh
  emit quoin-panel props.changed
  reply(0, "{}")
end

on "shell.scene.load"
  if $mode.load_refused ?? false then reply(14, "{}"); return end
  $doc = $scene_data.document($event.body)
  $edge = $doc.window.edge ?? "right"
  $page = $doc.window.panel ?? ("scene-" .. $doc.name)
  if not contains($edges[$edge].pages, $page) then $edges[$edge].pages = push($edges[$edge].pages, $page) end
  applied()
  if contains($event.body, "name: launcher\n") then $launcher_scene = $event.body end
  if contains($event.body, "name: notes\n") then $notes_loads = $notes_loads + 1 end
  if $mode.restart_once ?? false then
    $mode.restart_once = false
    reply($mode.host_rc ?? 0, json_encode({revision: 1})); return
  end
  $loads = $loads + 1
  reply($mode.host_rc ?? 0, json_encode({revision: $loads}))
end
on "shell.panel.page.set"
  if $mode.page_refused ?? false then reply(14, "{}"); return end
  $edges[$event.args.edge].page = $event.args.id
  applied()
  reply($mode.host_rc ?? 0, "{}")
end
on "shell.panel.show"
  if $mode.show_refused ?? false then reply(14, "{}"); return end
  $edges[$event.args.edge].visible = true
  applied()
  reply($mode.host_rc ?? 0, "{}")
end
on "shell.panel.pin"
  if $mode.show_refused ?? false then reply(14, "{}"); return end
  $pins = $pins + 1
  $edges[$event.args.edge].pinned = true
  $edges[$event.args.edge].mode = "docked"
  $edges[$event.args.edge].visible = true
  applied()
  reply($mode.host_rc ?? 0, "{}")
end
on "shell.panel.unpin"
  if $mode.release_refused ?? false then reply(14, "{}"); return end
  $edges[$event.args.edge].pinned = false
  $edges[$event.args.edge].mode = "hidden"
  applied()
  reply($mode.host_rc ?? 0, "{}")
end
on "shell.panel.hide"
  if $mode.hide_refused ?? false then reply(14, "{}"); return end
  $edges[$event.args.edge].visible = false
  applied()
  reply($mode.host_rc ?? 0, "{}")
end
on "shell.props.get"
  if $event.args.path == nil then
    reply($mode.host_rc ?? 0, json_encode({panels:$edges}))
  else
    reply($mode.host_rc ?? 0, json_encode($edges[after($event.args.path, "panels.")]))
  end
end
on "shell.panel.mode"
  if ($mode.release_refused ?? false) or ($mode.hide_refused ?? false) then reply(14, "{}"); return end
  $edge = $event.args.edge
  $edges[$edge].mode = $event.args.mode
  $edges[$edge].pinned = $event.args.mode != "hidden"
  $edges[$edge].visible = $event.args.mode != "hidden"
  applied()
  reply($mode.host_rc ?? 0, "{}")
end
on "comp.windows.list"
  reply(0, json_encode({windows: []}))
end
on "comp.props.get"
  reply(0, json_encode({count: 1, current: 1}))
end
on "comp.props.watch"
  reply(0, "{}")
end
on "tray.list"
  reply(0, json_encode({items: []}))
end
on "notify.props.get"
  reply(0, json_encode({n1: {app: "Fixture", summary: "Hello", body: "Test", created_at: "1"}}))
end
on "apps.icon"
  reply(0, json_encode({path: ""}))
end
on "apps.list" async
  $args = $event.args
  $lists = $lists + 1
  if has_key($mode, "delay_query") and $args.query == $mode.delay_query then
    $pending = true
    sleep($mode.delay_seconds ?? 2)
    $pending = false
  end
  if has_key($mode, "list_reply") then reply($mode.rc ?? 0, $mode.list_reply); return end
  $items = []
  for each $i in range(1, 60)
    push($items, {id: "app-" .. to_string($i), name: "Fixture " .. ($args.query ?? ""),
      generic_name: "Utility", comment: "Test app", icon: "", categories: [$args.category ?? ""]})
  end
  reply($mode.rc ?? 0, json_encode($items))
end
on "apps.launch"
  if $event.args.id != "app-1" then
    reply(14, json_encode({error: "not_found"}))
  else
    push($launches, $event.args.id)
    reply($mode.rc ?? 0, json_encode({pid: 123}))
  end
end
on fixture.state
  reply(0, json_encode({edges: $edges, lists: $lists, launches: $launches, pending: $pending, loads: $loads,
    launcher_scene: $launcher_scene, notes_loads: $notes_loads, pins: $pins}))
end
