-- Real isolated noded + two session citizens + production CLI. Synthetic helpers
-- only: never connects to a user's Wayland clipboard or opens a real browser.
$root = env("COSMIX")
if $root == "" then raise("TEST_CONFIG", "set COSMIX to the checkout root") end
$scripts = $root .. "/src/desktop/scripts"
$tmp = trim(run_argv_must(["mktemp","-d","/tmp/cosmix-desktop-test.XXXXXXXX"]))
$tag = uuid()
$broker = "desktop-bus-test-" .. $tag
$units = [$broker, $broker .. "-one", $broker .. "-two"]
$port = random(46000,46999)
$node = $tmp .. "/node.conf.mix"
$env = {COSMIX:$root,COSMIX_NODE_CONFIG:$node,MIX_STATS:"off"}
write_file($node,json_encode({node:"desktop-test",wg_ip:"",mesh:"desktop-test.invalid",noded:{port:$port,admission:"off"}}))
$_mkdir = run_argv_must(["mkdir",$tmp .. "/bin",$tmp .. "/one",$tmp .. "/two"])
write_file($tmp .. "/bin/wl-copy", "#!/opt/cosmix/bin/mix\nwrite_file(env(\"DESKTOP_TEST_DIR\") .. \"/clipboard\",read_stdin())\n")
write_file($tmp .. "/bin/wl-paste", "#!/opt/cosmix/bin/mix\n$r=run_argv([\"cat\",env(\"DESKTOP_TEST_DIR\") .. \"/clipboard\"],{stdout:\"inherit\",stderr:\"null\"})\nexit($r.ok ? 0 : 1)\n")
write_file($tmp .. "/bin/open", "#!/opt/cosmix/bin/mix\nwrite_file(env(\"DESKTOP_TEST_DIR\") .. \"/opened\",args()[0])\n")
$_chmod = run_argv_must(["chmod","0755",$tmp .. "/bin/wl-copy",$tmp .. "/bin/wl-paste",$tmp .. "/bin/open"])
fn start_broker()
  return run_argv_must(["systemd-run","--user","--quiet","--collect","--unit=" .. $broker,
    "-p","RuntimeMaxSec=180","-p","StandardOutput=null","-p","StandardError=null",
    "-p","Environment=COSMIX_NODE_CONFIG=" .. $node,
    "--","/opt/cosmix/bin/cosmix-noded","serve","--listen","127.0.0.1:" .. to_string($port),"--node","desktop-test","--no-monitor","--no-log"])
end
fn start_citizen($name)
  return run_argv_must(["systemd-run","--user","--quiet","--collect","--unit=" .. $broker .. "-" .. $name,
    "-p","RuntimeMaxSec=180","-p","KillMode=control-group","-p","StandardOutput=null","-p","StandardError=null",
    "-p","Environment=MIX_STATS=off","-p","Environment=COSMIX_NODE_CONFIG=" .. $node,
    "-p","Environment=DESKTOP_SESSION_CONFIG=" .. $tmp .. "/" .. $name .. "/session.conf.mix","-p","Environment=DESKTOP_TEST_DIR=" .. $tmp .. "/" .. $name,
    "-p","Environment=PATH=" .. $tmp .. "/bin:/opt/cosmix/bin:/usr/bin:/bin",
    "-p","Environment=WAYLAND_DISPLAY=synthetic","-p","Environment=XDG_RUNTIME_DIR=" .. $tmp,
    "--","/opt/cosmix/bin/mix","--serve",$scripts .. "/desktop-session.mix","--name","desktop-" .. $name])
end
fn cli($arguments)
  return run_argv(concat(["/opt/cosmix/bin/mix",$scripts .. "/desktop-cli.mix"],$arguments),{env:$env,timeout:40})
end
fn notify($state, $target, $text)
  -- Drive the production clip-notify watcher child against the test broker.
  return run_argv(["/opt/cosmix/bin/mix",$scripts .. "/clip-notify.mix"],
    {env:{COSMIX_NODE_CONFIG:$node, CLIPBOARD_STATE:$state, DESKTOP_WATCH_TARGET:$target, DESKTOP_WATCH_WORKER:$scripts .. "/clip-watch.mix", PATH:$tmp .. "/bin:/opt/cosmix/bin:/usr/bin:/bin"},
     stdin:$text, timeout:20, stdout:"null", stderr:"null"})
end
fn ready($target)
  for each $i in range(1,40)
    $result = cli(["capabilities",$target])
    if $result.ok then return json_parse($result.stdout) end
    sleep(0.1)
  end
  $diagnostic_env = $env
  $diagnostic_env.DESKTOP_REQUEST = json_encode({operation:"capabilities",target:$target})
  print(run_argv(["/opt/cosmix/bin/mix","--serve",$scripts .. "/desktop-request.mix","--name","desktopctl-diagnostic"],{env:$diagnostic_env,timeout:10}))
  raise("TEST_READY", "desktop citizen did not register")
end
fn check($condition,$message)
  if not $condition then raise("DESKTOP_BUS_TEST",$message) end
end
try
  $_start = start_broker()
  $up = false
  for each $i in range(1,40)
    $ping = run_argv(["/opt/cosmix/bin/mix","-c","send noded noded.ping timeout=1; print($rc)"],{env:$env,timeout:3})
    if $ping.ok and trim($ping.stdout) == "0" then $up = true; break end
    sleep(0.1)
  end
  check($up,"broker unavailable")
  for each $name in ["one","two"]
    $config = $tmp .. "/" .. $name .. "/session.conf.mix"
    write_file($config,json_encode({session:$name,opener:$tmp .. "/bin/open",history:{path:$tmp .. "/" .. $name .. "/history.json"}}))
    $_start = start_citizen($name)
  end
  $one = ready("desktop-one")
  $two = ready("desktop-two")
  print("PASS discovery")
  check($one.instance != $two.instance,"session instances collided")
  -- Anonymous senders cannot address services on the current broker pair:
  -- claimed broker_origin/from headers are refused at routing (stronger than
  -- the provider's own 13, which the lib suite covers directly).
  $denied = run_argv(["/opt/cosmix/bin/mix","-c","send \"desktop-one\" desktop.clipboard.capture body=\"{\\\"text\\\":\\\"forged\\\"}\" broker_origin=local from=forged timeout=2; print($rc)"],{env:$env,timeout:5})
  check($denied.ok and trim($denied.stdout) != "0","anonymous forged capture was not refused")
  $denied = run_argv(["/opt/cosmix/bin/mix","-c","send \"desktop-one\" desktop.capabilities body=\"{}\" broker_origin=local from=forged timeout=2; print($rc)"],{env:$env,timeout:5})
  check($denied.ok and trim($denied.stdout) != "0","anonymous forged caller was not refused")
  $sample = "  synthetic café\nsecond line\n\n"
  write_file($tmp .. "/one/clipboard",$sample)
  $copy = cli(["copy","desktop-one","desktop-two"])
  check($copy.ok,"Bus copy failed")
  check(read_file($tmp .. "/two/clipboard") == $sample,"clipboard bytes changed")
  check(not contains($copy.stdout .. $copy.stderr,"synthetic café"),"clipboard leaked in CLI output")
  $url = "https://example.org/callback?x=1&y=2"
  check(cli(["open","desktop-two",$url]).ok,"open RPC failed")
  check(read_file($tmp .. "/two/opened") == $url,"URL argv changed")
  check(not cli(["open","desktop-two","file:///tmp/forbidden"]).ok,"file URI admitted")
  write_file($tmp .. "/one/clipboard",repeat("x",65537))
  check(not cli(["copy","desktop-one","desktop-two"]).ok,"oversize transfer admitted")
  check(read_file($tmp .. "/two/clipboard") == $sample,"failed transfer replaced destination")
  $_stop = run_argv_must(["systemctl","--user","stop",$broker .. ".service"])
  $_restart = start_broker()
  $restored = ready("desktop-one")
  check($restored.instance == $one.instance,"broker bounce restarted session identity")
  $_two = ready("desktop-two")
  print("PASS real Bus discovery, forged caller denial, exact text transfer, URL routing, limit failure and broker reconnect")

  -- ── Clipboard history over the real Bus ──────────────────────────────
  $watch = notify("data","desktop-one","watched first ⏎ text")
  check($watch.ok,"clip-notify data delivery failed")
  $watch = notify("data","desktop-one","watched second text")
  check($watch.ok,"second watch delivery failed")
  $watch = notify("data","desktop-one","watched first ⏎ text")
  check($watch.ok,"duplicate watch delivery failed")
  $sensitive = notify("sensitive","desktop-one","password material")
  check($sensitive.ok,"sensitive selection handling failed")
  $oversize = notify("data","desktop-one",repeat("y",65600))
  check(not $oversize.ok,"oversize watch payload was shipped to the Bus")
  $list = json_parse(cli(["history","desktop-one"]).stdout)
  check($list.total == 2,"watcher captures missing or duplicated: " .. to_string($list.total))
  check($list.entries[0].id == 1 and $list.entries[0].preview == "watched first ⏎ text","dedupe did not keep original entry at front")
  check($list.entries[1].preview == "watched second text","second entry missing")
  $filtered = json_parse(cli(["history","desktop-one","second"]).stdout)
  check($filtered.total == 1 and $filtered.entries[0].id == 2,"CLI query filter wrong")
  check(not contains(json_encode($list),"password material"),"sensitive selection reached history")
  $entry = json_parse(cli(["entry","desktop-one",to_string($list.entries[1].id)]).stdout)
  check($entry.bytes == 19,"entry metadata wrong")
  $pick = cli(["pick","desktop-one",to_string($list.entries[1].id)])
  check($pick.ok and json_parse($pick.stdout).accepted == true,"pick failed")
  check(read_file($tmp .. "/one/clipboard") == "watched second text","pick did not reach the selection helper")
  $list_after = json_parse(cli(["history","desktop-one"]).stdout)
  check($list_after.total == 2 and $list_after.entries[0].id == 2,"pick did not move entry to front")
  $clear = cli(["clear","desktop-one",to_string($list.entries[0].id)])
  check($clear.ok and json_parse($clear.stdout).removed == 1,"clear one failed")
  check(json_parse(cli(["history","desktop-one"]).stdout).total == 1,"clear one left wrong count")
  -- A malformed id must fail the call, never degrade to clear-all.
  $typo = cli(["clear","desktop-one","oops"])
  check(not $typo.ok,"malformed clear id accepted")
  check(json_parse(cli(["history","desktop-one"]).stdout).total == 1,"malformed clear wiped history")
  -- Provider restart: new instance UUID, history survives from disk.
  $_stop = run_argv_must(["systemctl","--user","stop",$broker .. "-one.service"])
  sleep(0.3)
  $_again = start_citizen("one")
  $reborn = ready("desktop-one")
  check($reborn.instance != $one.instance,"provider restart kept stale instance")
  $survived = json_parse(cli(["history","desktop-one"]).stdout)
  check($survived.total == 1 and $survived.entries[0].id == 2,"history did not survive provider restart")
  check(not contains(read_file($tmp .. "/one/history.json"),"password material"),"sensitive material persisted to disk")
  print("PASS clipboard history: watcher chain, sensitive gating, dedupe, query, pick, clear, provider-restart persistence")
finally
  for each $unit in $units
    $_stop = run_argv(["systemctl","--user","stop",$unit .. ".service"],{timeout:15})
  end
  -- Only the unique mktemp tree created by this test is removed.
  if starts_with($tmp,"/tmp/cosmix-desktop-test.") then
    $_remove = run_argv_must(["rm","-rf","--",$tmp])
  end
end
