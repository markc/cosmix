# executor (default): local nspawn enforcement and reports to the controller.
# controller: pure placement controller; it does not connect to system D-Bus.
COSMIX_NSPAWND_MODE=executor

# Executor example. Bus bridge identities are canonical bridge-<node> names.
COSMIX_NSPAWND_OPERATORS=bridge-controller
COSMIX_NSPAWND_CONTROLLER_NODE=controller

# Controller example (replace the two lines above when mode=controller).
# COSMIX_NSPAWND_OPERATORS=operator:example
# COSMIX_NSPAWND_REPORTERS=bridge-alpha,bridge-beta

# Both roles load operation-token. Controller mode additionally requires an
# operator-token credential, normally supplied by a systemd drop-in as
# LoadCredential=operator-token:/etc/cosmix/nspawnd/operator-token.
