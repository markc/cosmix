# ~/.config/systemd/user/cosmix-editd.service
#
# The `edit` Bus citizen: shared text buffers for humans and agents (the core
# of ced). It runs as the session user because it reads and writes that user's
# files; agents drive it headless, so it is wanted by default.target rather
# than tied to a graphical session.
#
# Unsaved text survives a stop or restart (0.2.0+): dirty buffers are kept in
# recovery files under $XDG_STATE_HOME/cosmix/edit/recovery and restored at
# the next start; SIGTERM syncs them first. COSMIX_EDIT_RECOVERY=0 in the
# environment makes the daemon volatile again (docs/cos/edit.md, Recovery).
#
# Install:  cp this -> ~/.config/systemd/user/cosmix-editd.service
#           systemctl --user daemon-reload
#           systemctl --user enable --now cosmix-editd

[Unit]
Description=Cosmix edit citizen (shared text buffers for humans and agents)
Documentation=https://cosmix.dev/cos/edit

[Service]
Type=notify
ExecStart=/opt/cosmix/bin/cosmix-editd serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

[Install]
WantedBy=default.target
