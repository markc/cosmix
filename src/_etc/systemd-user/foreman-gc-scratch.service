# Install in ~/.config/systemd/user/ with foreman-gc-scratch.timer.
# FOREMAN_PROJECT is supplied by ~/.config/cosmix/foreman-gc-scratch.env.

[Unit]
Description=Foreman Cargo scratch backstop
Documentation=https://cosmix.dev/foreman.html

[Service]
Type=oneshot
EnvironmentFile=%h/.config/cosmix/foreman-gc-scratch.env
ExecStart=/opt/cosmix/bin/foreman --project ${FOREMAN_PROJECT} gc-scratch --confirm
