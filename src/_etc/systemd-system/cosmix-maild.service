# /usr/lib/systemd/system/cosmix-maild.service
# Cosmix mail daemon. Registry UID 501, BUS service "maild".
# All per-host values (binds, hostname, paths) live inside the daemon's
# config file at /etc/cosmix/maild/config.conf.mix — no per-host CLI args.

[Unit]
Description=Cosmix mail daemon (cosmix-maild)
Documentation=https://cosmix.dev/spec/10
After=network-online.target cosmix-noded.service
Wants=network-online.target
Requires=cosmix-noded.service

[Service]
Type=simple
User=cosmix-maild
Group=cosmix-maild
StateDirectory=cosmix/maild
StateDirectoryMode=0750
RuntimeDirectory=cosmix/maild
RuntimeDirectoryMode=0750
ConfigurationDirectory=cosmix/maild
ConfigurationDirectoryMode=0755
WorkingDirectory=%S/cosmix/maild
ExecStart=/opt/cosmix/bin/cosmix-maild -c %E/cosmix/maild/config.conf.mix serve
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=cosmix_maild=info
# Logging is journald-native (the cosmix_log core: journald-primary, with
# structured PRIORITY + fields). Belt-and-suspenders: route any stray
# stdout/stderr to the journal too, tag entries, and rate-limit so a
# crash-loop can't flood the journal. NO LogLevelMax — RUST_LOG above is
# the source filter; bump with one `systemctl edit` (RUST_LOG=...=debug),
# or flip it LIVE with no restart: `maild.props.set namespace=log level=debug`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cosmix-maild
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000
# HOME redirect retained but now LOGGING-IRRELEVANT: the cosmix_log daemon
# preset sets log_file=None, so no rolling file is written under $HOME
# anymore (journald is the sink). Left in place (harmless under
# ProtectSystem=strict) rather than churn it in a logging-only change.
Environment=HOME=%S/cosmix/maild
# resolve_noded_url() falls back to a hardcoded broker IP when node.conf.mix
# isn't found. Under the HOME redirect above, cosmix_config::node's XDG
# resolver looks at %S/cosmix/maild/.config/cosmix/node.conf.mix and misses
# the canonical /etc/cosmix/node.conf.mix. Pin COSMIX_NODE_CONFIG so BUS
# registration uses the local broker URL declared in node.conf.mix. Mirrors
# the cosmix-noded.service fix for the same root cause.
Environment=COSMIX_NODE_CONFIG=%E/cosmix/node.conf.mix

# Maild binds privileged SMTP ports (25, 465). CAP_NET_BIND_SERVICE keeps
# the unit non-root while allowing the privileged-port binds — the
# named-alternative form of §5.2's CapabilityBoundingSet=/AmbientCapabilities=
# rule. TLS material referenced from config.conf.mix MUST be readable by
# cosmix-maild. SPEC 10 §3.3 (v1.1.0) pins the shared-keypair pattern:
# `root:cosmix-tls 0640` on the private key, with cosmix-maild a member
# of the cosmix-tls group via the canonical sysusers fragment. Per-host
# `setfacl` workarounds are out of scope for this unit.

# §5.1 required (Level 1)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# §5.2 mandatory hardening (Level 2)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0027

PrivateDevices=yes

[Install]
WantedBy=multi-user.target
