#!/bin/sh
# CosMix bootstrap — the ONE script that runs before `mix` exists.
#
#   git clone https://github.com/markc/cosmix ~/Projects/cosmix
#   ~/Projects/cosmix/bootstrap            # add setup.mix flags after it, e.g. --desktop
#
# Clone it anywhere: the directory this file lives in becomes $COSMIX and
# everything (source, binaries, config, state) stays inside it. Removing the
# directory removes the install; running this again recreates it.
#
# It does exactly three things, then hands over to Mix:
#   1. a Rust toolchain via rustup (honours src/rust-toolchain.toml)
#   2. stage 1: build `mix` and install it to $COSMIX/bin/mix
#   3. write $COSMIX/env, then exec `mix setup.mix` for everything else
set -eu

COSMIX="$(cd "$(dirname "$0")" && pwd -P)"
export COSMIX
if [ ! -f "$COSMIX/src/Cargo.toml" ]; then
    echo "bootstrap: $COSMIX is not a CosMix checkout (no src/Cargo.toml)" >&2
    exit 2
fi

# 1. toolchain. rustup's proxies read src/rust-toolchain.toml and fetch the
#    pinned compiler on first use, so every clone builds with the same rustc.
if ! command -v cargo >/dev/null 2>&1 && [ ! -x "$HOME/.cargo/bin/cargo" ]; then
    echo ">> no cargo found — installing rustup (https://rustup.rs), minimal profile, PATH untouched"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path
fi
PATH="$HOME/.cargo/bin:$PATH"
export PATH

# 2. stage 1: mix. Only the mix crate — the rest of the workspace is built by
#    setup.mix, in Mix, once this binary exists.
echo ">> stage 1: building mix in $COSMIX/src (first build fetches the toolchain + crates; be patient)"
( cd "$COSMIX/src" && cargo build --release -p cosmix-mix )
mkdir -p "$COSMIX/bin"
install -m 755 "$COSMIX/src/target/release/mix" "$COSMIX/bin/mix"

# 3. env file: `. $COSMIX/env` (or `source`) in any shell puts mix on PATH and
#    names the root. Nothing else needs it — the binaries locate $COSMIX from
#    their own path — but it is what you `source` to *use* the install.
#    When bootstrap itself installed rustup (--no-modify-path above), nothing
#    else puts cargo on the caller's PATH — so env does, or the very next
#    `cargo test` in a fresh shell fails with "command not found".
cat > "$COSMIX/env" <<ENV
# generated by $COSMIX/bootstrap — source this: . $COSMIX/env
export COSMIX="$COSMIX"
export PATH="\$COSMIX/bin:\$PATH"
[ -d "\$HOME/.cargo/bin" ] && case ":\$PATH:" in *":\$HOME/.cargo/bin:"*) ;; *) export PATH="\$HOME/.cargo/bin:\$PATH" ;; esac
ENV

echo ">> stage 1 done: $COSMIX/bin/mix ($("$COSMIX/bin/mix" --version 2>&1 | head -n 1))"
echo ">> handing over to Mix: mix $COSMIX/setup.mix $*"
exec "$COSMIX/bin/mix" "$COSMIX/setup.mix" "$@"
