#!/usr/bin/env mix
-- gen-versions.mix — regenerate ~/.cosmix/VERSIONS.md from the Cargo manifests.
--
-- WHY THIS EXISTS. Version numbers written into prose rot, and a stale one
-- reads as authoritative. On 2026-08-19 CLAUDE.md claimed the fleet was on
-- 0.49.0 (it was 0.53.0) in a sentence three lines below a warning that this
-- exact line had been stale by fifteen releases before; a second paragraph
-- claimed 0.46.1. The nightly autodeploy trusted a stale build checkout the
-- same morning and pushed 0.51.0 over 0.53.0 on seven mesh nodes.
--
-- So: ONE derived file, never hand-edited. It is a REPORT, not a claim —
-- everything in it is read from a Cargo.toml at generation time, so it cannot
-- disagree with the tree. Docs stop stating versions; they point here.
--
--   mix _bin/gen-versions.mix           -- write ~/.cosmix/VERSIONS.md
--   mix _bin/gen-versions.mix --check   -- exit 1 if the committed file is stale
--
-- --check is the drift gate: regenerate into memory and compare. A generated
-- file nobody verifies is just a slower kind of hand-maintained file.
--
-- NOT IN SCOPE, deliberately: which node runs which version. That is
-- mesh-private (it names nodes), ~/.cosmix is the PUBLIC upstream, and a doc
-- can never be trusted for it anyway. Ask the node:
--   ssh <node> 'print(run("/opt/cosmix/bin/mix --version"))'

-- 2026-08-30: one monorepo at $COSMIX. The three groups are the former
-- repositories; membership is by crate name (bus + mix listed, cos = the rest).
$COSMIX = env("COSMIX", env("HOME") .. "/Projects/cosmix")
$GROUPS = [
  ["bus", "CosMix Agent Bus — protocol family", ["cosmix-lib-bus", "cosmix-lib-client", "cosmix-lib-buildinfo", "cosmix-lib-log", "cosmix-lib-props-core"]],
  ["mix", "Mix — the language and shell", ["cosmix-lib-mix", "cosmix-mix", "mix-bench"]],
  ["cos", "CoS — substrate libraries and daemon family", []]
]
$OUT = $COSMIX .. "/docs/VERSIONS.md"

$check = false
for each $a in args()
  if $a == "--check" then $check = true end
end

-- version = the first `version = "..."` line in a manifest's [package]
-- section. Workspace-inherited (`version.workspace = true`) resolves from the
-- root manifest, so report that rather than a blank.
function pkg_version($manifest, $ws_version)
  $v = ""
  for each $ln in split(read_file($manifest), "\n")
    $t = trim($ln)
    if $v == "" then
      if starts_with($t, "version") then
        if contains($t, "workspace") then
          $v = $ws_version
        else
          $parts = split($t, "\"")
          if len($parts) >= 2 then $v = $parts[1] end
        end
      end
    end
  end
  return $v
end

function ws_version($root)
  $p = $root .. "/src/Cargo.toml"
  if not is_file($p) then return "" end
  return pkg_version($p, "")
end

function repo_sha($root)
  $r = run_argv(["git", "-C", $root, "rev-parse", "--short", "HEAD"])
  if not $r.ok then return "unknown" end
  return trim($r.stdout)
end

function repo_dirty($root)
  $r = run_argv(["git", "-C", $root, "status", "--porcelain"])
  if not $r.ok then return false end
  return trim($r.stdout) != ""
end

$body = "# CosMix component versions\n\n"
$body = $body .. "*Generated by `_bin/gen-versions.mix` — do not edit. Every number below is\n"
$body = $body .. "read from a `Cargo.toml` at generation time, so this file cannot disagree\n"
$body = $body .. "with the source tree.*\n\n"
$body = $body .. "This is the single source of truth for CosMix component versions, online at\n"
$body = $body .. "<https://cosmix.dev/VERSIONS>. Project docs deliberately do **not** state\n"
$body = $body .. "current versions — a version in prose rots, and a stale one reads as\n"
$body = $body .. "authoritative. Docs still carry *capability floors* (\"needs mix >= 0.46.0\")\n"
$body = $body .. "and *history* (\"strict since v0.52.0\"), because those describe what happened\n"
$body = $body .. "and never go out of date.\n\n"
$body = $body .. "**What is deployed is not stated here.** Which host runs which build is\n"
$body = $body .. "answered by the host, not by a document:\n\n"
$body = $body .. "```sh\nssh <node> 'print(run(\"/opt/cosmix/bin/mix --version\"))'\n```\n\n"

$total = 0
$root = $COSMIX
if not is_dir($root .. "/src/crates") then
  eprint("no workspace at " .. $root .. "/src/crates (set COSMIX)")
  exit(2)
end
$wsv = ws_version($root)
$sha = repo_sha($root)
$dirty = repo_dirty($root)
$body = $body .. "Repository `markc/cosmix` at commit `" .. $sha .. "`"
if $dirty then
  $body = $body .. " **(working tree dirty at generation — these numbers may not be committed)**"
end
$body = $body .. "\n\n"
$crates = $root .. "/src/crates"
$all = []
for each $e in ls($crates)
  if is_file($crates .. "/" .. $e .. "/Cargo.toml") then push($all, $e) end
end
$all = sort($all)
$claimed = []
for each $g in $GROUPS
  for each $c in $g[2]
    push($claimed, $c)
  end
end
for each $g in $GROUPS
  $name = $g[0]
  $desc = $g[1]
  $members = $g[2]
  if len($members) == 0 then
    -- cos = every crate no other group claims
    for each $c in $all
      if not contains($claimed, $c) then push($members, $c) end
    end
  end
  $body = $body .. "## " .. $name .. "\n\n" .. $desc .. "\n\n"
  $body = $body .. "| crate | version |\n|---|---|\n"
  for each $c in sort($members)
    if is_file($crates .. "/" .. $c .. "/Cargo.toml") then
      $v = pkg_version($crates .. "/" .. $c .. "/Cargo.toml", $wsv)
      if $v == "" then $v = "—" end
      $body = $body .. "| `" .. $c .. "` | " .. $v .. " |\n"
      $total = $total + 1
    end
  end
  $body = $body .. "\n"
end

$body = $body .. "---\n\n"
$body = $body .. "" .. ("" .. $total) .. " crates in one workspace, `$COSMIX/src` (groups are the former repositories).\n"

if $check then
  if not is_file($OUT) then
    eprint("VERSIONS.md missing — run without --check to generate it")
    exit(1)
  end
  if trim(read_file($OUT)) == trim($body) then
    print("VERSIONS.md is current (" .. ("" .. $total) .. " crates)")
  else
    eprint("VERSIONS.md is STALE — regenerate with: mix _bin/gen-versions.mix")
    exit(1)
  end
else
  write_file($OUT, $body)
  print("wrote " .. $OUT .. " (" .. ("" .. $total) .. " crates)")
end
