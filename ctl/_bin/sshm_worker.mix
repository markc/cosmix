#!/usr/bin/env mix
-- sshm_worker.mix — the sshm job worker (P2a/P2b).
--
-- A hardened systemd unit runs this as the hub-configured drain identity with
-- only its SSH directory writable. It claims leased jobs from the webd seam,
-- executes them with ARGV-INERT commands (run_argv — no local shell,
-- so a host alias / key name / comment can never escape into a command), and
-- applies fenced results. Private key BYTES never leave this process (D6): only
-- the public key + fingerprint are ever reported.
--
-- Deployed to /opt/cosmix/share/cosmix/sshm_worker.mix by
-- _bin/deploy_sshm.mix (with sshm_worker_lib.mix beside it).

$HOME = env("HOME")
$SSH = $HOME .. "/.ssh"
$KNOWN = $SSH .. "/known_hosts.sshm"
$KEYS = $SSH .. "/keys"

-- ── opts ─────────────────────────────────────────────────────────────────────
$argv = args()
$BASE = env("SSHM_BASE_URL")
$SECRET_FILE = ""
$ONCE = false
$MAX_JOBS = 50

function arg_error($message)
  print("ERROR: " .. $message)
  print("usage: mix sshm_worker.mix [--base-url URL] [--secret-file PATH] [--once]")
  exit(2)
end

$i = 0
while $i < length($argv)
  $a = "" .. $argv[$i]
  if $a == "--base-url" then
    if $i + 1 >= length($argv) then arg_error("--base-url needs a value") end
    $i = $i + 1
    $BASE = "" .. $argv[$i]
  else if $a == "--secret-file" then
    if $i + 1 >= length($argv) then arg_error("--secret-file needs a value") end
    $i = $i + 1
    $SECRET_FILE = "" .. $argv[$i]
  else if $a == "--once" then
    $ONCE = true
  else
    arg_error("unknown argument: " .. $a)
  end
  $i = $i + 1
end
if trim($BASE) == "" then
  arg_error("SSHM_BASE_URL is required (deploy_sshm supplies it from deploy_sshm.base_url)")
end
if not starts_with($BASE, "http://") and not starts_with($BASE, "https://") then
  arg_error("base URL must start with http:// or https://")
end
if contains($BASE, "\n") or contains($BASE, "\r") then
  arg_error("base URL must be one line")
end

$lib = require(dirname(realpath($0)) .. "/sshm_worker_lib.mix")
$SECRET = $lib["load_secret"]($SECRET_FILE)
$HDRS = { "X-Sshm-Secret": $SECRET, "Content-Type": "application/json" }
$SUPPORTED = ["scan_all", "test_host", "key_create", "copy_key", "fix_perms", "uptime_host", "ping_host"]

-- ── ssh connectivity probe (argv-inert, classify by stderr) ─────────────────
function ssh_probe($alias)
  $a = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=accept-new", "-o", "UserKnownHostsFile=" .. $KNOWN, "-o", "LogLevel=ERROR", "" .. $alias, "true"]
  $r = run_argv($a, { timeout: 10 })
  $lat = to_number("" .. $r["duration_ms"])
  if $lat == nil then $lat = 0 end
  return { status: probe_classify($r), latency_ms: $lat }
end

-- Git providers refuse a shell, so `true` never runs; a completed handshake
-- (publickey-denied or a banner) = reachable. Probe WITHOUT the trailing `true`.
function ssh_probe_git($alias)
  $a = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=accept-new", "-o", "UserKnownHostsFile=" .. $KNOWN, "-o", "LogLevel=ERROR", "" .. $alias]
  $r = run_argv($a, { timeout: 10 })
  $lat = to_number("" .. $r["duration_ms"])
  if $lat == nil then $lat = 0 end
  $e = lower("" .. ssh_or($r["stderr"], ""))
  $o = lower("" .. ssh_or($r["stdout"], ""))
  if contains($e, "permission denied (publickey") or contains($e, "successfully authenticated") or contains($o, "hi ") or contains($e, "hi ") then
    return { status: "git", latency_ms: $lat }
  end
  return probe_result($r, $lat)
end

function probe_classify($r)
  return probe_result($r, 0)["status"]
end

function probe_result($r, $lat)
  if to_number("" .. ssh_or($r["exit_code"], "")) == 0 then return { status: "ok", latency_ms: $lat } end
  if $r["timed_out"] == true then return { status: "unreachable", latency_ms: $lat } end
  $e = lower("" .. ssh_or($r["stderr"], ""))
  $s = "unreachable"
  if contains($e, "permission denied (publickey") or contains($e, "too many authentication") then $s = "authfail" end
  if contains($e, "connection refused") then $s = "refused" end
  if contains($e, "could not resolve") or contains($e, "name or service not known") or contains($e, "nodename nor servname") then $s = "dnsfail" end
  if contains($e, "no route to host") or contains($e, "network is unreachable") then $s = "unreachable" end
  if contains($e, "connection reset") then $s = "reset" end
  return { status: $s, latency_ms: $lat }
end

-- nil-coalesce (worker-local; no lib.mix here)
function ssh_or($v, $def)
  if $v == nil then return $def end
  return $v
end

-- Name hygiene for a key name flowing into a filesystem path. Returns "" on
-- reject. Rejects: empty, leading dot, leading "-" (so it can't be read as an
-- ssh-keygen option), "/"/".." (traversal), and a ".pub" suffix — a key named
-- "x.pub" would make ssh-keygen write the PRIVATE key to a file the reindex/
-- filesd policy treats as a public key, leaking private bytes (Codex blocker).
function safe_name($n)
  $n = "" .. $n
  if $n == "" then return "" end
  if starts_with($n, ".") or starts_with($n, "-") then return "" end
  if contains($n, "/") or contains($n, "..") then return "" end
  if ends_with(lower($n), ".pub") then return "" end
  $ok = true
  for each $c in chars($n)
    if not (is_alnum($c) or $c == "_" or $c == "-" or $c == ".") then $ok = false end
  end
  if not $ok then return "" end
  return $n
end

-- A host alias that is safe to pass as an ssh destination argv token: non-empty
-- and NOT starting with "-" (else `ssh -oProxyCommand=... true` would run a
-- local command as the drain user — run_argv blocks shell interpolation but NOT ssh
-- option injection; ssh has no reliable `--` for the destination). Codex blocker.
function alias_ok($a)
  $a = "" .. $a
  if $a == "" then return false end
  if starts_with($a, "-") then return false end
  return true
end

-- Strict host token [A-Za-z0-9_.-] — the worker's independent re-validation of the roster
-- target (webd validates the same; defence in depth, Codex). Blocks OpenSSH destination
-- syntax (root@host, ssh://…) a hand-edited config-fragment name could carry.
$SSH_STRICT_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-"

function strict_target($s)
  $t = "" .. $s
  if $t == "" or length($t) > 255 or starts_with($t, "-") then return false end
  $i = 0
  while $i < length($t)
    if pos(substr($t, $i, 1), $SSH_STRICT_CHARS) == 0 then return false end
    $i = $i + 1
  end
  return true
end

function is_alnum($c)
  return ($c >= "a" and $c <= "z") or ($c >= "A" and $c <= "Z") or ($c >= "0" and $c <= "9")
end

-- ── seam transport ──────────────────────────────────────────────────────────
function apply_terminal($job_id, $tok, $ok, $result, $scan_id, $output)
  $p = { ok: $ok, result: $result }
  if $scan_id != nil then $p["scan_id"] = $scan_id end
  -- A one-shot tool (uptime) sends its output text; a streamed tool (ping) sends NONE, so
  -- the server preserves the accumulated stream. nil output → omit the key entirely.
  if $output != nil then $p["output"] = "" .. $output end
  $lib["post_apply"]($BASE, $SECRET, $job_id, $tok, $p)
end

function apply_progress_host($job_id, $tok, $scan_id, $host, $pr)
  $lib["post_apply"]($BASE, $SECRET, $job_id, $tok, { host_result: { scan_id: $scan_id, host_name: $host, status: $pr["status"], latency_ms: $pr["latency_ms"] } })
end

-- ── job kinds ────────────────────────────────────────────────────────────────
function do_test_host($job)
  $pl = json_parse(ssh_or($job["payload"], "{}"))
  $alias = "" .. ssh_or($pl["alias"], "")
  if not alias_ok($alias) then return { ok: false, result: { error: "invalid alias" } } end
  $scan_id = to_number("" .. ssh_or($pl["scan_id"], ""))
  $pr = ssh_probe($alias)
  if ssh_or($pl["git"], false) then $pr = ssh_probe_git($alias) end
  if $scan_id != nil then
    apply_progress_host($job["job_id"], $job["lease_token"], $scan_id, $alias, $pr)
  end
  return { ok: true, result: { host: $alias, status: $pr["status"], latency_ms: $pr["latency_ms"] }, scan_id: $scan_id }
end

function do_scan_all($job)
  $pl = json_parse(ssh_or($job["payload"], "{}"))
  $scan_id = to_number("" .. ssh_or($pl["scan_id"], ""))
  $hosts = ssh_or($pl["hosts"], [])
  $done = 0
  for each $h in $hosts
    $alias = "" .. ssh_or($h["alias"], "")
    $git = ssh_or($h["git"], false)
    if alias_ok($alias) then
      $pr = ssh_probe($alias)
      if $git then $pr = ssh_probe_git($alias) end
      -- retry-once on reset BEFORE the ephemeral reclassification, with the same
      -- probe type (D7).
      if $pr["status"] == "reset" then
        $pr = ssh_probe($alias)
        if $git then $pr = ssh_probe_git($alias) end
      end
      -- an expected-down (ephemeral) host that fails is "offline", not a failure
      if ssh_or($h["ephemeral"], false) and $pr["status"] != "ok" and $pr["status"] != "git" then
        $pr["status"] = "offline"
      end
      -- each host_result post also renews the lease (heartbeat)
      apply_progress_host($job["job_id"], $job["lease_token"], $scan_id, $alias, $pr)
    else
      -- An unsafe alias is still one of the scan's `total`; record it as a
      -- failure so the counts reach total (scan never stalls short of done). Use
      -- a nonempty sentinel host_name (an empty alias would be dropped by the
      -- seam's empty-host_name guard and go uncounted).
      $label = $alias
      if $label == "" then $label = "(unnamed)" end
      apply_progress_host($job["job_id"], $job["lease_token"], $scan_id, $label, { status: "unreachable", latency_ms: 0 })
    end
    $done = $done + 1
  end
  return { ok: true, result: { scanned: $done }, scan_id: $scan_id }
end

function do_key_create($job)
  $pl = json_parse(ssh_or($job["payload"], "{}"))
  $name = safe_name(ssh_or($pl["name"], ""))
  if $name == "" then return { ok: false, result: { error: "invalid key name" } } end
  $comment = "" .. ssh_or($pl["comment"], "")
  $path = $KEYS .. "/" .. $name
  if exists($path) then return { ok: false, result: { error: "key already exists" } } end
  -- passphrase-less (D6); argv-inert; -o -a 100 = new format, 100 KDF rounds
  $r = run_argv(["ssh-keygen", "-o", "-a", "100", "-t", "ed25519", "-f", $path, "-C", $comment, "-N", ""], { timeout: 30 })
  if $r["exit_code"] != 0 then return { ok: false, result: { error: "keygen failed" } } end
  $private_mode = run_argv(["chmod", "600", $path], { timeout: 5 })
  if $private_mode["exit_code"] != 0 then return { ok: false, result: { error: "private-key chmod failed" } } end
  $public_mode = run_argv(["chmod", "644", $path .. ".pub"], { timeout: 5 })
  if $public_mode["exit_code"] != 0 then return { ok: false, result: { error: "public-key chmod failed" } } end
  -- report ONLY the public fingerprint (private bytes never leave)
  $fp = run_argv(["ssh-keygen", "-lf", $path .. ".pub"], { timeout: 5 })
  if $fp["exit_code"] != 0 then return { ok: false, result: { error: "fingerprint failed" } } end
  $fpline = trim(ssh_or($fp["stdout"], ""))
  return { ok: true, result: { name: $name, fingerprint: $fpline } }
end

function do_fix_perms($job)
  $dirs = run_argv(["chmod", "700", $SSH, $KEYS, $SSH .. "/hosts"], { timeout: 5 })
  if $dirs["exit_code"] != 0 then return { ok: false, result: { error: "SSH directory chmod failed" } } end
  $fixed = 0
  for each $f in glob($KEYS .. "/*")
    $mode = nil
    if ends_with($f, ".pub") then
      $mode = run_argv(["chmod", "644", $f], { timeout: 5 })
    else
      $mode = run_argv(["chmod", "600", $f], { timeout: 5 })
    end
    if $mode["exit_code"] != 0 then return { ok: false, result: { error: "key chmod failed", path: $f } } end
    $fixed = $fixed + 1
  end
  -- config + known_hosts + authorized_keys → 600
  for each $f in ["config", "authorized_keys", "known_hosts", "known_hosts.sshm"]
    $path = $SSH .. "/" .. $f
    if exists($path) then
      $mode = run_argv(["chmod", "600", $path], { timeout: 5 })
      if $mode["exit_code"] != 0 then return { ok: false, result: { error: "SSH file chmod failed", path: $path } } end
    end
  end
  return { ok: true, result: { fixed: $fixed } }
end

function do_copy_key($job)
  $pl = json_parse(ssh_or($job["payload"], "{}"))
  $keyname = safe_name(ssh_or($pl["key"], ""))
  $target = "" .. ssh_or($pl["host"], "")
  if $keyname == "" then return { ok: false, result: { error: "invalid key name" } } end
  if not alias_ok($target) then return { ok: false, result: { error: "invalid host" } } end
  $pubpath = $KEYS .. "/" .. $keyname .. ".pub"
  if not exists($pubpath) then return { ok: false, result: { error: "no such public key" } } end
  $pub = trim(read_file($pubpath))
  -- Validate it is exactly ONE public-key record (no embedded newline) so a
  -- malformed .pub can't inject extra authorized_keys lines/options.
  if $pub == "" or contains($pub, "\n") then return { ok: false, result: { error: "malformed public key" } } end
  $vfy = run_argv(["ssh-keygen", "-lf", $pubpath], { timeout: 5 })
  if $vfy["exit_code"] != 0 then return { ok: false, result: { error: "not a valid public key" } } end
  -- Append the operator's PUBLIC key to the remote authorized_keys, idempotent
  -- (append-if-absent), STDIN-fed (argv carries no key bytes; the key is quoted
  -- and read from stdin so it can never be string-interpolated into the command).
  -- printf (not echo) for portable exact output; grep -qxF -- for a literal
  -- whole-line match.
  $remote = "umask 077; mkdir -p ~/.ssh && chmod 700 ~/.ssh; k=$(cat); if ! grep -qxF -- \"$k\" ~/.ssh/authorized_keys 2>/dev/null; then printf '%s\\n' \"$k\" >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && echo APPENDED; else echo PRESENT; fi"
  $r = run_argv(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "-o", "StrictHostKeyChecking=accept-new", "-o", "UserKnownHostsFile=" .. $KNOWN, "" .. $target, $remote], { timeout: 20, stdin: $pub })
  if $r["exit_code"] != 0 then return { ok: false, result: { error: "copy failed", host: $target } } end
  $out = trim(ssh_or($r["stdout"], ""))
  return { ok: true, result: { host: $target, key: $keyname, outcome: $out } }
end

-- ── claim → dispatch → apply loop ───────────────────────────────────────────
function claim_next()
  $r = http_post($BASE .. "/ssh/job-claim-next", json_encode({ supported_kinds: $SUPPORTED }), $HDRS, { timeout: 15 })
  $st = to_number("" .. $r["status"])
  if $st == 204 then return { kind: "empty" } end
  if $st != 200 then return { kind: "infra", detail: ("status " .. ("" .. $st)) } end
  return { kind: "job", job: json_parse($r["body"]) }
end

-- ── operator tools (uptime one-shot, ping streaming) ────────────────────────
--
-- Both take a roster-resolved payload {alias, address} put there by webd from the
-- sshm.ssh_hosts ROW (never a caller-supplied hostname). The worker re-validates alias_ok.

-- uptime_host: ssh a FIXED read-only command (no interpolated caller data) with a locked-
-- down client (BatchMode, StrictHostKeyChecking=yes against the pinned known_hosts, no PTY,
-- no forwarding). Sends the output on the terminal apply.
function do_uptime_host($job)
  $pl = json_parse(ssh_or($job["payload"], "{}"))
  $alias = "" .. ssh_or($pl["alias"], "")
  if not strict_target($alias) then
    return { ok: false, result: { error: "invalid host" }, output: "invalid host" }
  end
  -- FIXED command string — sh -c a small read-only readout. No caller data is interpolated.
  $remote = "LC_ALL=C sh -c 'uptime; echo; uname -sr; echo; (command -v free >/dev/null && free -h | head -3); echo; (who 2>/dev/null | head -10)'"
  $a = ["ssh", "-n", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
        "-o", "StrictHostKeyChecking=yes", "-o", "UserKnownHostsFile=" .. $KNOWN,
        "-o", "ForwardAgent=no", "-o", "ClearAllForwardings=yes", "-o", "LogLevel=ERROR",
        "" .. $alias, $remote]
  $r = run_argv($a, { timeout: 15, max_output: 8192 })
  $out = trim("" .. ssh_or($r["stdout"], ""))
  $err = trim("" .. ssh_or($r["stderr"], ""))
  -- Success requires ssh's OWN exit 0 (Codex): partial stdout followed by exit 255
  -- (connection dropped mid-command) must NOT report `done` with truncated output.
  if $r["exit_code"] != 0 then
    $hint = $err
    if $hint == "" then $hint = $out end
    if pos("Host key verification failed", $err) > 0 then
      $hint = $err .. "\n(run Test on this host first to pin its key)"
    end
    return { ok: false, result: { host: $alias }, output: $hint }
  end
  return { ok: true, result: { host: $alias }, output: $out }
end

-- ping_host: run ping LOCALLY (from this node) against the roster address, one probe per
-- loop, streaming each reply as a progress append (like Trace's hop-loop). No ssh. Bounds
-- (count, per-probe wait, total) are FIXED in argv, never caller values.
function do_ping_host($job)
  $pl = json_parse(ssh_or($job["payload"], "{}"))
  $addr = "" .. ssh_or($pl["address"], "")
  if not strict_target($addr) then
    return { ok: false, result: { error: "invalid address" }, output: "invalid address" }
  end
  -- Budget every blocking call against the SERVER's ABSOLUTE deadline (Codex): webd and
  -- this worker share a clock (same node), so `stream_deadline_epoch` from the claim is a
  -- fixed instant, immune to claim→entry latency. We stop SAFETY seconds before it, and
  -- before any blocking op reserve that op's worst duration — a probe is ~4s, a progress
  -- post is ~12s (timeout 6s x 2). EVERY post return is honored: a false (fenced/gap/lost
  -- lease) stops immediately with a preserve terminal, never a false success.
  $dl = to_number("" .. ssh_or($job["stream_deadline_epoch"], "0"))
  if $dl == nil or $dl <= 0 then
    $dl = time() + 30
  end
  $stop = $dl - 3
  $probe_r = 4
  $post_r = 12
  $count = 10
  $recv = 0
  $seq = 1
  if time() + $post_r < $stop then
    if not $lib["post_progress"]($BASE, $SECRET, $job["job_id"], $job["lease_token"], $seq, "PING " .. $addr .. "\n") then
      return { ok: true, result: { host: $addr, received: 0, sent: 0 }, stream: true }
    end
  end
  $i = 1
  $bailed = false
  while $i <= $count and not $bailed
    -- Reserve one probe + one post before starting the probe.
    if time() + $probe_r + $post_r > $stop then
      $bailed = true
    else
      $r = run_argv(["/usr/bin/ping", "-n", "-c", "1", "-W", "2", "" .. $addr], { timeout: 4, max_output: 2048 })
      $line = "" .. ("" .. $i) .. ": no reply"
      for each $ln in split("" .. ssh_or($r["stdout"], ""), "\n")
        if pos("bytes from", $ln) > 0 then
          $line = "" .. ("" .. $i) .. ": " .. trim($ln)
          $recv = $recv + 1
        end
      end
      $seq = $seq + 1
      if not $lib["post_progress"]($BASE, $SECRET, $job["job_id"], $job["lease_token"], $seq, $line .. "\n") then
        return { ok: true, result: { host: $addr, received: $recv, sent: $i }, stream: true }
      end
      $i = $i + 1
    end
  end
  -- Final line (deadline-reached vs summary), only if there's budget AND its return honored.
  $tail = "--- " .. ("" .. $recv) .. "/" .. ("" .. $count) .. " received\n"
  if $bailed then
    $tail = "… ping deadline reached (" .. ("" .. $recv) .. "/" .. ("" .. ($i - 1)) .. " received)\n"
  end
  if time() + $post_r < $stop then
    $seq = $seq + 1
    -- Return HONORED (not ignored): a false here means the append was fenced (past the
    -- stream-deadline, or the lease died). Either way the run is over; the terminal apply
    -- below is itself lease-fenced, so a dead lease fails closed there (post_apply exits on
    -- 409), while a past-stream-deadline run keeps the bounded output it did stream.
    if not $lib["post_progress"]($BASE, $SECRET, $job["job_id"], $job["lease_token"], $seq, $tail) then
      return { ok: true, result: { host: $addr, received: $recv, sent: $i - 1 }, stream: true }
    end
  end
  -- No output field → the terminal apply PRESERVES the streamed accumulator.
  return { ok: true, result: { host: $addr, received: $recv, sent: $i - 1 }, stream: true }
end

function run_one($job)
  $k = "" .. $job["kind"]
  if $k == "test_host" then return do_test_host($job) end
  if $k == "scan_all" then return do_scan_all($job) end
  if $k == "key_create" then return do_key_create($job) end
  if $k == "fix_perms" then return do_fix_perms($job) end
  if $k == "copy_key" then return do_copy_key($job) end
  if $k == "uptime_host" then return do_uptime_host($job) end
  if $k == "ping_host" then return do_ping_host($job) end
  return { ok: false, result: { error: "unknown kind: " .. $k } }
end

$processed = 0
while $processed < $MAX_JOBS
  $c = claim_next()
  if $c["kind"] == "empty" then
    print("queue drained (" .. ("" .. $processed) .. " processed)")
    exit(0)
  end
  if $c["kind"] == "infra" then
    print("claim infra error: " .. ssh_or($c["detail"], ""))
    exit(1)
  end
  $job = $c["job"]
  print("job " .. ("" .. $job["job_id"]) .. " kind=" .. ("" .. $job["kind"]) .. " claimed")
  $out = run_one($job)
  apply_terminal($job["job_id"], $job["lease_token"], $out["ok"], ssh_or($out["result"], {}), ssh_or($out["scan_id"], nil), ssh_or($out["output"], nil))
  $processed = $processed + 1
  if $ONCE then exit(0) end
end
print("max jobs reached (" .. ("" .. $processed) .. ")")
exit(0)
