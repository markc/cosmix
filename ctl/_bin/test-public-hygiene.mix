#!/opt/cosmix/bin/mix
-- test-public-hygiene.mix — the test suite for the public-repo hygiene gate.
--
--   mix _bin/test-public-hygiene.mix        (exit 0 = every probe passed)
--
-- Builds disposable git repos under /tmp and asserts the gate behaves, one
-- probe per way it has been WRONG. Every case here is a real defect found in
-- cold review of the 2026-07-25 implementation, so a regression in any of
-- them is a regression to a shipped bug — do not delete a probe because it
-- looks obvious.
--
-- Mesh-private strings are read from _etc/mesh/inventory.mix at run time, so
-- this file contains none and can be read by anyone who can read the gate.
--
-- Exercises the gate, installer and hook body beside this suite.

$d = require("../_lib/deploy_lib.mix")
$MIX = $d.mix_bin()

-- Match the production scripts' hub locator. A suite copied with the starter
-- uses that starter; a worktree copy can be pointed at its hub with CMCTL.
fn locate_hub()
  $here = dirname(dirname(realpath($0)))
  if is_file($here .. "/_etc/public-hygiene.conf.mix") then
    return $here
  end
  $e = env("CMCTL")
  if $e != "" then
    return $e
  end
  return env("HOME") .. "/.ctl"
end

$CMCTL = locate_hub()
-- 2026-08-30: the gate, installer and hook now locate their hub themselves
-- (script dir if it is a hub, else the CMCTL environment variable, else the
-- default ~/.ctl). Every neutral or patched COPY this suite writes into the
-- fixture root cannot self-locate, so without CMCTL it would read the DEFAULT
-- hub — and this suite asserts against $CMCTL. Mix cannot set its own
-- environment, so the suite re-executes itself once with CMCTL exported and
-- every child it spawns inherits it.
if env("CMCTL") != $CMCTL then
  $rerun = run_argv(concat([$MIX, realpath($0)], args()),
    {timeout: 1800, max_output: 67108864, env: {CMCTL: $CMCTL}})
  print($rerun["stdout"])
  eprint($rerun["stderr"])
  if $rerun["stdout_truncated"] or $rerun["stderr_truncated"] then
    eprint("self-reexec output was truncated — refusing an incomplete result")
    exit(2)
  end
  exit($rerun["exit_code"])
end
-- The gate beside THIS suite. Resolving through $0 is load-bearing in a git
-- worktree: the old $CMCTL path silently tested the canonical checkout's gate,
-- so a changed worktree gate could be completely broken while this mandated
-- suite stayed green against yesterday's file. Every row still runs a NEUTRAL
-- COPY of it instead ($GATE, built once the fixture root exists) — see the note
-- there for why the suite must not read the operator's allowlist.
$BIN_DIR = dirname(realpath($0))
$GATE_REAL = $BIN_DIR .. "/check-public-hygiene.mix"
$HOOK = $BIN_DIR .. "/hygiene-hook.mix"
$INSTALL = $BIN_DIR .. "/install-hygiene-hooks.mix"
$ZERO = "0000000000000000000000000000000000000000"

-- Round forty made --status exit 2 whenever any hook state came back
-- UNVERIFIED, so the nine rows below that used to assert `exit_code == 0` now
-- have to assert 2. On its own that is a weaker row than the one it replaces:
-- exit 2 is also what round twenty-one's regression produced, where --status
-- died partway and reported nothing at all, and an exit-code-only assertion
-- cannot tell the two apart. This marker is printed by the ONE line at the very
-- end of a --status run that completed its report, so asserting it alongside
-- the 2 says what the row actually means — the full report was produced, and
-- THEN the run refused because something in it was unverified. Kept as a shared
-- constant so a wording change breaks all nine loudly in one place rather than
-- silently softening each of them.
$DONE = "status only — no hook was written"

-- A group this account belongs to that has ANOTHER member, so `chgrp` to it
-- needs no privilege and the "does this group contain anyone but the owner"
-- question has a real answer to find. Round forty hoisted this out of T133,
-- which used to own it privately, because T72 now needs it too: once the
-- installer's path-chain arm narrows group-write the way round thirty-eight
-- narrowed the executability arm, a directory that is group-writable to a
-- USER-PRIVATE group is no longer a finding, and T72's fixture was exactly
-- that. A row asserting a refusal has to create something genuinely worth
-- refusing, or it measures the bug rather than the property.
$FGRP = "sudo"
$FGRP_OK = false
$gent = run_argv(["getent", "group", $FGRP], {timeout: 60})
if $gent["exit_code"] == 0 then
  $gflds = split(trim($gent["stdout"]), ":")
  if len($gflds) > 3 then
    -- A comma is a second member: `getent group` lists the secondary members
    -- of the group, and one name with no comma is one member.
    $FGRP_OK = contains($gflds[3], ",")
  end
end

-- pid alone was not this run's to claim. Round twenty-four: after PID reuse
-- another user can already own /tmp/cosmix-hygiene-probe-<pid>, and the
-- startup `rm -rf` then deleted THEIR contents (sticky /tmp stops the
-- top-level removal, not the recursion into it) — as root it removed the lot.
-- The same window let a foreign directory be adopted as this run's fixture
-- root. A uuid makes the name this run's alone, and the root is claimed with
-- mkdir({parents: false}) — which fails if anything is already there — instead
-- of being cleared and then created.
--
-- 2026-08-30: the probe root honours TMPDIR. /tmp became a ZFS dataset with
-- utf8only=on on 2026-08-23, and T52 must create a pathname holding a raw \200
-- byte — impossible there (mkdir: EILSEQ). Run as `TMPDIR=/dev/shm mix …`.
$ROOT = env("TMPDIR", "/tmp") .. "/cosmix-hygiene-probe-" .. ("" .. pid()) .. "-" .. uuid()

-- Read the exclusion list from the gate's own config rather than repeating it:
-- a name added to generic_node_names would otherwise make every probe here
-- assert on a string the gate deliberately ignores, and they would all "fail"
-- for the wrong reason.
$REAL_CFG = load_data($CMCTL .. "/_etc/public-hygiene.conf.mix")["public_hygiene"]
$cfg_generic = $REAL_CFG["generic_node_names"]

-- Turn the first branch of a configured static rule into fixture text. Both
-- the starter and a private hub use the portable `(...)`, `|` and `[.]`
-- shapes documented by public-hygiene.conf.mix. Refuse if that contract is
-- absent: a clean-looking suite with no planted match proves nothing.
fn static_fixture($cfg, $wanted, $branch)
  for each $rule in $cfg["static_rules"]
    if $rule["id"] != $wanted then
      continue
    end
    $pattern = $rule["pattern"]
    if starts_with($pattern, "(") and ends_with($pattern, ")") then
      $pattern = substr($pattern, 1, len($pattern) - 2)
    end
    $branches = split($pattern, "|")
    $pick = $branch < len($branches) ? $branch : 0
    $sample = $branches[$pick]
    $sample = replace($sample, "[.]", ".")
    if $sample != "" and regex_match($rule["pattern"], $sample) then
      return {id: $rule["id"], pattern: $rule["pattern"], sample: $sample}
    end
  end
  print("no static hygiene rule can supply fixture content from "
    .. $CMCTL .. "/_etc/public-hygiene.conf.mix")
  exit(2)
end

$STATIC = static_fixture($REAL_CFG, "private_domain", 0)
$HOME_STATIC = static_fixture($REAL_CFG, "operator_home", 1)
$INV_PATH = $CMCTL .. "/_etc/mesh/inventory.mix"
$SIGNED_PATH = $CMCTL .. "/_etc/mesh/inventory.signed"
$HAS_INVENTORY = is_file($INV_PATH) and is_file($SIGNED_PATH)
$FIXTURE_RULES = "[]"
if not $HAS_INVENTORY then
  $FIXTURE_RULES = "[{id: \"" .. $STATIC["id"] .. "\", pattern: \"" \
    .. $STATIC["pattern"] .. "\", note: \"runtime fixture rule\"}]"
end
$inv = {subnet: "", members: []}
$NAMES = []
$NODE = $STATIC["sample"]
$IP = $STATIC["sample"]
$INV_NODE = "alpha"
$NODE_LABEL = "[" .. $STATIC["id"] .. "]"
$IP_LABEL = $NODE_LABEL
$oct = []
$INV_SUBNET = "198.51.100.0/24"
if $HAS_INVENTORY then
  $inv = load_data($INV_PATH)["inventory"]
  $INV_SUBNET = $inv["subnet"]
  for each $member in $inv["members"]
    if contains($cfg_generic, $member["name"]) == false then
      push($NAMES, $member["name"])
      if $NODE == $STATIC["sample"] then
        $NODE = $member["name"]
        $INV_NODE = $member["name"]
      end
    end
  end
  $oct = split(split($inv["subnet"], "/")[0], ".")
  $IP = $oct[0] .. "." .. $oct[1] .. "." .. $oct[2] .. ".231"
  $NODE_LABEL = "[mesh_node]"
  $IP_LABEL = "[mesh_ipv4]"
end

fn must($dir, $argv)
  $r = run_argv($argv, {cwd: $dir, timeout: 300})
  if $r["ok"] != true then
    print("SETUP FAILED in " .. $dir .. ": " .. join($argv, " "))
    print($r["stderr"])
    exit(2)
  end
  return $r["stdout"]
end

fn gate($argv)
  $r = run_argv(concat([$MIX, $GATE], $argv),
    {timeout: 600, max_output: 33554432, env: {TMPDIR: $ROOT, CMCTL: $CMCTL}})
  return {code: $r["exit_code"], out: $r["stdout"] .. $r["stderr"]}
end

-- Round twenty-nine's external-state sweep found that every installer fixture
-- made its interpreter probes as siblings under ambient /tmp. They were normally
-- removed, but interruption left state outside this run's root. Every installer
-- execution goes through this helper now: ordinary rows get ROOT as TMPDIR, while
-- the three rows that deliberately supply a different TMPDIR retain it. Keeping
-- this at the process boundary makes a new direct installer call conspicuous in
-- review, instead of asking every row to remember another environment field.
fn run_installer($argv, $opts)
  $child_env = $opts["env"]
  if $child_env == nil then
    $child_env = {}
  end
  if $child_env["TMPDIR"] == nil or $child_env["TMPDIR"] == "" then
    $child_env["TMPDIR"] = $ROOT
  end
  -- 2026-08-30: patched copies of the installer are written into $ROOT, where
  -- self-location cannot find a hub; without CMCTL they would fall back to the
  -- DEFAULT hub (~/.ctl), and every stub they write would name it. The suite
  -- asserts against $CMCTL, so hand it to the child explicitly.
  if $child_env["CMCTL"] == nil or $child_env["CMCTL"] == "" then
    $child_env["CMCTL"] = $CMCTL
  end
  $opts["env"] = $child_env
  return run_argv($argv, $opts)
end

fn newrepo($name)
  $p = $ROOT .. "/" .. $name
  $rm = run_argv(["rm", "-rf", $p], {timeout: 60})
  if $rm["ok"] == false and is_dir($p) then
    print("cannot clear " .. $p)
    exit(2)
  end
  mkdir($p)
  must($p, ["git", "init", "-q", "-b", "main"])
  must($p, ["git", "config", "user.email", "probe@example.com"])
  must($p, ["git", "config", "user.name", "probe"])
  return $p
end

-- A real destination. The hook asks the remote what it actually holds, so a
-- probe needs a remote that can answer — and a local bare repo answers
-- instantly and offline, which a URL cannot.
fn bare($name)
  $p = $ROOT .. "/" .. $name .. ".git"
  $rm = run_argv(["rm", "-rf", $p], {timeout: 60})
  if $rm["ok"] == false and is_dir($p) then
    print("cannot clear " .. $p)
    exit(2)
  end
  mkdir($p)
  must($p, ["git", "init", "-q", "--bare"])
  return $p
end

-- git hands pre-push $1 = remote NAME and $2 = the location it is actually
-- pushing to. They are the same string only for an anonymous push
-- (`git push /path/to/repo main`); with a named remote they differ, and with
-- `remote.<n>.pushurl` set they differ in the way that matters — $1 resolves
-- to the FETCH url. Asking $1 bounded the range by the wrong destination and
-- published a leaking commit (round ten, F1).
--
-- So the two are separate parameters here. `push_ref` keeps the anonymous
-- shape, which is what most rows want; `push_ref_named` is the shape that
-- caught the bug, and T49 exercises it.
fn push_ref_named($p, $name, $url, $ref, $sha)
  return run_argv([$MIX, $HOOK, "pre-push", $name, $url],
    {cwd: $p, stdin: $ref .. " " .. $sha .. " " .. $ref .. " " .. $ZERO .. "\n",
     timeout: 900})
end

fn push_ref($p, $remote, $ref, $sha)
  return push_ref_named($p, $remote, $remote, $ref, $sha)
end

fn commit($p, $msg)
  must($p, ["git", "add", "-A"])
  must($p, ["git", "commit", "-q", "-m", $msg])
  return trim(must($p, ["git", "rev-parse", "HEAD"]))
end

-- The suite needs the same distinction the scripts do: "is there an entry at
-- this name", which the plain exists() does not answer for a dangling link —
-- `exists($p, {follow_symlinks: false})`, mix 0.39.0.

-- Every symlink assertion in this file is made about a path the DEFECT under
-- test may have renamed away or replaced with a regular file — so `stat()` and
-- `read_link()` on it raise, and an uncaught raise takes the whole suite down
-- instead of failing one row. That has now cost this suite four aborted mutant
-- runs (T1c, T56b, T62b/T63b, T64a). These two never raise: a row that wants
-- "is it still the link I made" gets an answer, not an exception.
fn is_link($p)
  if exists($p, {follow_symlinks: false}) == false then
    return false
  end
  return stat($p, {follow_symlinks: false})["is_symlink"]
end

fn link_target($p)
  try
    return read_link($p)
  catch $re
    return "<not a symlink: " .. $re .. ">"
  end
end

fn ok($name, $cond, $detail)
  if $cond then
    print("PASS  " .. $name)
    return 0
  end
  print("FAIL  " .. $name .. "   [" .. $detail .. "]")
  return 1
end

-- A generated gate, hook or installer is executable test code, so a no-op
-- source rewrite is not a harmless bad fixture. Round twenty-eight: T112c's
-- exact `$CMCTL` anchor stopped matching and the unchanged installer ran twice
-- against the live fleet before the row noticed its fixture hook was absent.
-- Every production-source mutation goes through this helper now. It proves the
-- old content was present, is gone, and the requested replacement is present
-- before the generated file can be written, let alone executed. Abort as setup
-- failure rather than continuing: after this point the safe scope of the
-- generated program has not been established.
-- Round thirty-eight. `contains` answers "at least one", and `replace` rewrites
-- ALL of them, so an anchor that matched two sites passed every check here and
-- quietly mutated both. It happened: a guard added to the installer this round
-- was textually identical to the line row (h) uses as its anchor, so row (h)'s
-- mutant deleted a second, unrelated refusal as well — the two arms then
-- covered for each other and the row could not go green no matter which build
-- it ran against. An ambiguous anchor is the harness lying about what it
-- injected, which is worse than an anchor that has drifted, because a drifted
-- one at least stops the run.
fn occurrences($hay, $needle)
  return len(split($hay, $needle)) - 1
end

fn must_replace($src, $old, $new)
  $out = replace($src, $old, $new)
  $n = occurrences($src, $old)
  if $old == $new or $n != 1 \
      or contains($out, $old) or contains($out, $new) == false then
    print("SETUP FAILED: generated-source rewrite was not proved before execute"
      .. " (anchor=" .. sanitize($old) .. " sites=" .. "" .. $n
      .. " replacement=" .. sanitize($new) .. ")")
    exit(2)
  end
  return $out
end

-- Every fixture that exercises the group-writability predicate read the HOST's
-- /etc/nsswitch.conf until round forty-one, so whether it answered or refused
-- depended on the identity configuration of whichever machine ran the suite.
-- Taking `systemd` off the enumerating-sources allowlist made that dependency
-- visible all at once: six rows resting on the premise "a 0775 directory answers
-- cleanly" went red on a host whose switch reads `passwd: files systemd`, and
-- not one of those six rows is about NSS. They point at a switch of their own
-- now. Two sources rather than one so the rows still traverse a multi-source
-- line, and `db` because it is the only other member of the allowlist that is
-- unambiguously a database walk.
$NSS_ENUMERABLE = $ROOT .. "/nsswitch-enumerable.conf"

fn pin_nsswitch($src, $switch)
  return must_replace($src,
    "$NSSWITCH = \"/etc/nsswitch.conf\"", "$NSSWITCH = \"" .. $switch .. "\"")
end

-- must_replace's sibling, for the one mutant that MOVES code rather than
-- rewriting it in place (T134's "the probe came after the chain"). Insertion
-- cannot go through must_replace: its proof is `contains($out, $old) == false`,
-- and an insertion by definition keeps the anchor, so every insertion would be
-- reported as an unproved rewrite. The proof that fits an insertion is a
-- different one — the added text was absent before and appears exactly once
-- after, and the anchor is still there exactly once — and it is just as strict.
fn must_insert($src, $anchor, $add)
  $na = occurrences($src, $anchor)
  $nb = occurrences($src, $add)
  $out = replace($src, $anchor, $add .. $anchor)
  if $na != 1 or $nb != 0 or occurrences($out, $add) != 1 \
      or occurrences($out, $anchor) != 1 then
    print("SETUP FAILED: generated-source insertion was not proved before"
      .. " execute (anchor=" .. sanitize(substr($anchor, 0, 60))
      .. " anchor_sites=" .. "" .. $na .. " added_sites_before=" .. "" .. $nb
      .. " added_sites_after=" .. "" .. occurrences($out, $add) .. ")")
    exit(2)
  end
  return $out
end

-- T129 support. The /etc/gitconfig body is staged in the fixture tree and
-- copied into place with sudo, rather than piped through a shell, so the
-- content never passes through a quoting layer.
fn sdbody($entry)
  return "[safe]\n\tdirectory = " .. $entry .. "\n"
end

-- A /etc/gitconfig larger than run_argv's 8 MiB per-stream cap, whose LAST
-- entry is the broadest opt-out git has. Measured on this interpreter:
-- run_argv discards the excess and reports ok:true with exit_code 0, so the
-- `*` past the cap is simply not in the parsed list and the truncated read
-- looks like a complete one that found nothing. The padding entry is long
-- rather than the lines being numerous on purpose — 512-byte entries reach the
-- cap in ~16k of them instead of ~130k, and every entry costs the matcher a
-- realpath.
fn trunc129()
  $pad = "pppppppppppppppp"
  $i = 0
  while $i < 5
    $pad = $pad .. $pad
    $i = $i + 1
  end
  $line = "\tdirectory = /nowhere/" .. $pad .. "\n"
  $block = $line
  $j = 0
  while $j < 15
    $block = $block .. $block
    $j = $j + 1
  end
  return "[safe]\n" .. $block .. "\tdirectory = *\n"
end

-- A /etc/gitconfig whose bytes are not valid UTF-8. Measured on git 2.55.0: a
-- `safe.directory` value holding a raw 0xff comes back verbatim from
-- `git config -z --get-all`, and run_argv hands it to the matcher as U+FFFD
-- with utf8_lossy:true, exit_code 0 and neither stream truncated — so the
-- comparison is against a string git never saw. The body has to be BYTES:
-- bytes_to_string RAISES on invalid UTF-8 (measured, RUNTIME_ERROR), and so
-- does read_file, which is why the teardown below reads bytes too.
--
-- The value deliberately names nothing. Proving that git honours an entry
-- whose bytes this process cannot represent needs a directory whose NAME
-- carries the bad byte, and every Mix path argument is a UTF-8 string, so this
-- suite cannot create one. That half is a recorded measurement — a symlink
-- named `link\xffx` pointing at the repository was ADMITTED, rc 0 — not a
-- fixture. What this row pins is the code's half: a config this run cannot
-- read is refused, not parsed into a confident "no widening".
fn lossy129()
  return freeze(buffer(["[safe]\n\tdirectory = /nowhere/", 0xff, "x\n"]))
end

-- `cp` onto /etc/gitconfig in place is not atomic: it truncates and then
-- rewrites, so a suite killed between the two leaves a half-written system
-- config, and git answers a malformed one by failing every command on the host
-- — including the ones an operator would reach for to find out what happened.
-- Stage beside it and rename. rename(2) within a directory is all-or-nothing,
-- so that path holds either the previous content or this row's, never a prefix
-- of either.
fn putetc129($src, $dst, $tmp)
  $c = run_argv(["sudo", "-n", "cp", $src, $tmp], {timeout: 60})
  if $c["exit_code"] != 0 then
    return $c
  end
  return run_argv(["sudo", "-n", "mv", "-f", $tmp, $dst], {timeout: 60})
end

-- The one row whose expectations run the other way. Rows here normally assert
-- "the fixed build refuses, and the defect restored does not"; row (r) pins a
-- refusal that round thirty-eight DELETED, so it is the FIXED build that must
-- answer and the pre-fix text that must refuse. It is an inversion rather than
-- a control row on purpose: a control has no mutant, and the entire claim here
-- is that the old behaviour was wrong on this exact input.
fn t129inv($tag)
  return $tag == "r"
end

-- "Is the file at this path one this run wrote?", answered on bytes. Not
-- read_file: one fixture body is deliberately invalid UTF-8 and read_file
-- RAISES on it, and this is called from a `finally`, where a raise walks past
-- every remaining cleanup line. Not `==` either — byte strings compare by
-- identity the same way lists do; constant_time_eq is the byte-exact one, and
-- it accepts a string on either side, so a table of mixed string and bytes
-- bodies needs no coercion at the call site.
fn mine129($path, $bodies)
  $got = read_file_bytes($path)
  for each $b in $bodies
    if constant_time_eq($got, $b) then
      return true
    end
  end
  return false
end

-- The control rows' assertion text. Row (a) and row (l) both expect "installed"
-- and expect it for entirely different reasons, and a shared sentence would
-- have described only one of them.
fn t129ctl($tag)
  if $tag == "a" then
    return join(["a system safe.directory naming an unrelated path does not",
      " suppress the verified verdict"], "")
  end
  return join(["an ordinary conditional include does not suppress the verified",
    " verdict. Round thirty-six refused on any includeIf; round thirty-seven",
    " measured git 2.55.0 and found it cannot widen anything — every includeIf",
    " condition is evaluated against an OPEN repository and the ownership check",
    " runs first, so the same included file admits a foreign-owned repo through",
    " `[include]` and does NOT through `[includeIf \"gitdir:<repo>/\"]`. The",
    " refusal cost every repository on such a host a permanent UNVERIFIED"], "")
end

fn write_tmp129($root, $tag, $body)
  $p = $root .. "/gitconfig-" .. $tag
  write_file($p, $body)
  return $p
end

fn statusline129($r)
  for each $l in split($r["stdout"] .. "\n" .. $r["stderr"], "\n")
    if contains($l, "pre-commit:") then
      return trim($l)
    end
  end
  return "NO pre-commit LINE (rc=" .. $r["exit_code"] .. ")"
end

fn t129why($tag)
  if $tag == "b" then
    return join(["a `/*` suffix admits everything beneath it (git-config(1)),",
      " which the first implementation did not match at all"], "")
  end
  if $tag == "c" then
    return join(["a `~/…` entry names a different directory per identity and",
      " so cannot be resolved to one answer — and the fixture for it must be",
      " BUILT, since a leading ~ in a Mix string literal expands to $HOME and",
      " the written form expanded to the current user's home in the config instead"], "")
  end
  if $tag == "i" then
    return join(["the reader splits on NUL, so the argv must ASK for NUL —",
      " without `-z` every value arrives with a trailing newline attached and",
      " matches nothing, which is a confident \"no widening\" over a config that",
      " widens. Shipped and caught here in the same round"], "")
  end
  if $tag == "j" then
    return join(["`/*` is `*` by another spelling — the base is the filesystem",
      " root, above every repository on the host, and git was measured",
      " ADMITTING a root-owned repo for `/*`, `//*` and `///*`. The `$base !=",
      " \"\"` guard was written to stop an empty base matching everything and",
      " did the exact opposite: it skipped the one entry shape that SHOULD",
      " match everything, and answered \"no widening\" for the broadest opt-out",
      " git has"], "")
  end
  if $tag == "k" then
    return join(["a system-scope `include.path = ~/…` is IDENTITY-DEPENDENT:",
      " it reads as a silent \"no entries, verified\" for whoever lacks the",
      " file and can carry `safe.directory = *` for whoever has it, so the",
      " premise that system scope is one stack shared by every identity is",
      " false and the only honest answer is that it cannot be determined"], "")
  end
  if $tag == "m" then
    return join(["`//*` and `///*` are `*` by a third and fourth spelling, and",
      " unlike `/*` they are NOT handled by the guard removal: their bases are",
      " `/` and `//`, the prefix becomes `//` or `///`, and no absolute path",
      " begins with that. Only the realpath-is-root test catches them, so this",
      " row exists because row (j) cannot fail if that test is deleted"], "")
  end
  if $tag == "n" then
    return join(["run_argv caps each stream at 8 MiB, discards the excess and",
      " reports success — the truncation flag is the only evidence. A",
      " `safe.directory = *` past the cap is absent from the parsed list, and",
      " the read looks like a complete one that found nothing: a confident",
      " \"no widening\" over a config that opts out entirely"], "")
  end
  if $tag == "o" then
    return join(["a /proc magic link is absolute and fixed-looking and is",
      " neither: `/proc/self/fd/9` names whatever THAT process has on fd 9.",
      " Measured on git 2.55.0 — with the descriptor open on the repository,",
      " git ADMITTED it (rc 0). In this process there is no fd 9, so realpath",
      " answers nil, the entry matches nothing and the pre-fix build reported a",
      " confident \"no widening\" over a config that opted this repository in.",
      " Only the magic-path arm catches it: resolution is the same from every",
      " working directory, so the cwd test sees no difference"], "")
  end
  if $tag == "p" then
    return join(["and the magic-path arm is not enough on its own, because the",
      " entry does not have to BE under /proc — a symlink anywhere can point",
      " there. `<fixture>/viacwd -> /proc/self/cwd` was measured ADMITTED (rc",
      " 0) through `git -C <repo>`, which is also the state a hook runs in:",
      " git chdirs before the ownership check, so the link resolves to the",
      " repository for git and to this installer's own directory here. Only the",
      " cwd-dependence test catches it, and it catches it by resolving the",
      " entry from two different working directories and finding two answers"],
      "")
  end
  if $tag == "q" then
    return join(["a config whose bytes are not valid UTF-8 arrives as U+FFFD",
      " with utf8_lossy set, exit_code 0 and nothing truncated — the flag is",
      " the only evidence that what the matcher is comparing is not what git",
      " matched on. Unread, the substituted value falls past every arm to",
      " `return false`, which is the fail-open direction; and repair is not",
      " available, because by the time the value is a Mix string the original",
      " bytes are gone. Refusing is the only honest answer"], "")
  end
  if $tag == "r" then
    return join(["INVERTED. A RELATIVE `include.path` is resolved by git",
      " against the directory of the file that names it — measured:",
      " /etc/gitconfig carrying `path = gitconfig.d/shared` loads",
      " /etc/gitconfig.d/shared and admits the repository named there. It is",
      " therefore identity-INDEPENDENT and perfectly answerable, and refusing",
      " on it (the pre-fix test was \"not absolute\") bought a permanent",
      " UNVERIFIED for nothing. The refusal is now `~/…` and `%(prefix)/…`",
      " only: the forms that genuinely name a different file per identity"], "")
  end
  if $tag == "s" then
    return join(["the same magic-path family one level up: the INCLUDE PATH,",
      " not the value in it. `include.path = /proc/self/fd/9` names whatever",
      " that reader has on fd 9, so the installer and git can be handed two",
      " different files from one system scope. Rows (k) and (r) cover the",
      " identity-dependent include forms; nothing covered the process-dependent",
      " ones, and the matcher never sees a value to misclassify — it is handed",
      " an empty entry list and answers a confident \"no widening\". Only the",
      " lexical arm catches this one: resolution does not vary with cwd, so the",
      " cwd test sees no difference (the same split as rows (o)/(p))"], "")
  end
  if $tag == "t" then
    return join(["and the include-path arm needs the cwd test too, for the same",
      " reason the value arm does — the path need not be lexically under /proc.",
      " This is the round-thirty-nine measurement, and it is the sharpest",
      " fail-open of the twenty: with `inc` inside the repository and",
      " `<fixture>/viacwd -> /proc/self/cwd`, `git -C <repo> status` chdirs into",
      " the repository first and ADMITTED it (rc 0), while the installer's own",
      " `git config -z --includes --system --get-all safe.directory`, run from",
      " its own directory, resolved the same include to a file that is not there",
      " and exited 1 with NOTHING — no entries at all. A config that widens to",
      " `*` read as a clean verified gate"], "")
  end
  if $tag == "e" then
    return join(["git canonicalises the entry, so a trailing slash still names",
      " the repository — measured HONOURED, while a raw string compare says no"],
      "")
  end
  if $tag == "f" then
    return join(["git resolves symlinks in the entry (measured HONOURED, and a",
      " nonexistent component measured ignored — a real resolve, not a lexical",
      " one), so a symlink to the repository names the repository"], "")
  end
  if $tag == "g" then
    return join(["the config git loads at ownership-check time honours",
      " `include.path`, so the entry can live in a file /etc/gitconfig merely",
      " points at — invisible without `--includes`, which defaults OFF for a",
      " named scope"], "")
  end
  if $tag == "h" then
    return join(["`.` is honoured (measured), and it is the worktree top for",
      " every hook git runs — close to `*` in effect while looking like a typo;",
      " a non-absolute entry names a different directory per invocation, so no",
      " single answer exists"], "")
  end
  return join(["a single entry must not be erased by the trailing terminator",
    " git emits after it, which an empty element makes look like a reset"], "")
end

-- Round twenty-seven: a fixture read that can legitimately find nothing must
-- fail its ROW, not abort the suite. T112c read an installed hook with a bare
-- read_file(); when the fixture mis-installed, the uncaught RUNTIME_ERROR
-- terminated the run at that line and T112d through T117 never executed — and
-- the truncated output looked exactly like "those rows had nothing to say".
-- Measured 2026-07-26 while reconstructing five pre-fix versions: all five
-- reported no rows red, and all five had simply stopped before the rows they
-- were built to kill. An absent file yields "" here, which no assertion below
-- accepts, so the row goes red and the remaining rows still run.
fn read_or_empty($p)
  if exists($p, {follow_symlinks: false}) == false then
    return ""
  end
  return read_file($p)
end

-- A content-and-mode snapshot for the fleet-atomicity fixtures. Directory
-- mtimes are deliberately excluded: "byte-untouched" means every hook entry,
-- target and executable bit is identical, not that the filesystem clock stood
-- still. Paths are sorted because walk order is not part of its contract.
fn hooks_digest($dir)
  $rows = []
  for each $p in sort(walk($dir, {follow_symlinks: false}))
    $st = stat($p, {follow_symlinks: false})
    $body = ""
    if $st["is_symlink"] then
      $body = "link:" .. read_link($p)
    else
      $body = "file:" .. hash_file($p)
    end
    push($rows, substr($p, len($dir)) .. ":" .. ("" .. $st["perm"])
      .. ":" .. $body)
  end
  return hash_sha256(join($rows, "\n"))
end

fn exact_mtime($path)
  -- Mix stat() exposes whole seconds. That caught the measured rewrite, but an
  -- installer added immediately before the terminal guard could replace equal
  -- bytes inside one second and look unchanged. GNU stat supplies the nanosecond
  -- field the live Mix builtin does not yet expose; failure is an unproved
  -- baseline, never permission to weaken the guard.
  $r = run_argv(["stat", "--printf=%y", $path],
    {timeout: 60, env: {LC_ALL: "C"}})
  if $r["ok"] != true or $r["utf8_lossy"] then
    return nil
  end
  return $r["stdout"]
end

-- This is deliberately the installer's own hooks-path question, including its
-- measured GIT_CONFIG_PARAMETERS neutralisation. Hard-coding `.git/hooks`
-- would make the guard look at the wrong nine paths as soon as a legitimate
-- core.hooksPath appeared in file-backed config — the same false assurance
-- T52 exists to prevent.
fn fleet_hooks_snapshot($repos)
  $rows = []
  for each $repo in $repos
    $r = run_argv(["git", "--no-replace-objects", "-C", $repo,
      "rev-parse", "--git-path", "hooks"],
      {timeout: 60, env: {GIT_CONFIG_PARAMETERS: "", LC_ALL: "C"}})
    if $r["ok"] != true or $r["utf8_lossy"] then
      push($rows, {repo: $repo, path: $repo .. "/<unresolved hooks path>",
        present: false, body: nil, mtime: "", perm: 0, ino: "", dev: "",
        is_file: false, is_symlink: false, link: "",
        error: "git could not name the hooks path"})
      continue
    end
    $dir = $r["stdout"]
    if ends_with($dir, "\n") then
      $dir = substr($dir, 0, len($dir) - 1)
    end
    if starts_with($dir, "/") == false then
      $dir = $repo .. "/" .. $dir
    end
    $real = realpath($dir)
    if $real == nil then
      push($rows, {repo: $repo, path: $dir, present: false, body: nil,
        mtime: "", perm: 0, ino: "", dev: "", is_file: false,
        is_symlink: false, link: "",
        error: "hooks directory could not be resolved"})
      continue
    end
    for each $name in ["pre-commit", "commit-msg", "pre-push"]
      $path = $real .. "/" .. $name
      if exists($path, {follow_symlinks: false}) == false then
        push($rows, {repo: $repo, path: $path, present: false, body: nil,
          mtime: "", perm: 0, ino: "", dev: "", is_file: false,
          is_symlink: false, link: "", error: ""})
        continue
      end
      try
        $st = stat($path, {follow_symlinks: false})
        $mtime = exact_mtime($path)
        if $mtime == nil then
          push($rows, {repo: $repo, path: $path, present: false, body: nil,
            mtime: "", perm: 0, ino: "", dev: "", is_file: false,
            is_symlink: false, link: "",
            error: "nanosecond mtime could not be read"})
          continue
        end
        $target = ""
        if $st["is_symlink"] then
          $target = read_link($path)
        end
        push($rows, {repo: $repo, path: $path, present: true,
          body: read_file_bytes($path), mtime: $mtime, perm: $st["perm"],
          ino: $st["ino"], dev: $st["dev"], is_file: $st["is_file"],
          is_symlink: $st["is_symlink"], link: $target, error: ""})
      catch $snaperr
        push($rows, {repo: $repo, path: $path, present: false, body: nil,
          mtime: "", perm: 0, ino: "", dev: "", is_file: false,
          is_symlink: false, link: "",
          error: "hook could not be read: " .. $snaperr})
      end
    end
  end
  return $rows
end

fn fleet_hooks_changed($repos, $before)
  $changed = []
  $after = fleet_hooks_snapshot($repos)
  if len($after) != len($before) then
    push($changed, "fleet hook set changed from " .. len($before) .. " to "
      .. len($after) .. " entries")
    return $changed
  end
  for $idx = 0 to len($before) - 1
    $old = $before[$idx]
    $now = $after[$idx]
    if $old["error"] != "" then
      push($changed, $old["path"] .. " (" .. $old["error"] .. " at startup)")
      continue
    end
    if $old["present"] == false then
      push($changed, $old["path"] .. " (absent at startup)")
      continue
    end
    if $now["path"] != $old["path"] then
      push($changed, $old["path"] .. " (resolved hook path changed to "
        .. $now["path"] .. ")")
      continue
    end
    if $now["error"] != "" then
      push($changed, $old["path"] .. " (" .. $now["error"] .. " at finish)")
      continue
    end
    if $now["present"] == false then
      push($changed, $old["path"] .. " (removed during suite)")
      continue
    end
    $why = []
    if $now["body"] != $old["body"] then
      push($why, "content changed")
    end
    if $now["mtime"] != $old["mtime"] then
      push($why, "mtime " .. $old["mtime"] .. " -> " .. $now["mtime"])
    end
    if $now["perm"] != $old["perm"] then
      push($why, "mode " .. ("" .. $old["perm"]) .. " -> "
        .. ("" .. $now["perm"]))
    end
    if $now["ino"] != $old["ino"] or $now["dev"] != $old["dev"] then
      push($why, "file identity changed")
    end
    if $now["is_file"] != $old["is_file"] \
        or $now["is_symlink"] != $old["is_symlink"] \
        or $now["link"] != $old["link"] then
      push($why, "file type or link target changed")
    end
    if len($why) > 0 then
      push($changed, $old["path"] .. " (" .. join($why, ", ") .. ")")
    end
  end
  return $changed
end

fn fingerprints($out)
  $fps = []
  for each $l in split($out, "\n")
    if contains($l, "fingerprint: ") then
      $fp = trim(split($l, "fingerprint: ")[1])
      if starts_with($fp, "(binary") == false then
        push($fps, $fp)
      end
    end
  end
  return $fps
end

-- O_EXCL-shaped: the uuid means nothing should exist here, and if something
-- does, this run has collided with something it did not create and must not
-- remove. {parents: false} is what makes that a refusal rather than a no-op —
-- plain mkdir() is create_dir_all and succeeds on an existing directory.
-- Round twenty-nine adds the identity held through cleanup: chmod closes the
-- permissive-umask case before fixtures exist, and the final rm is reachable
-- only if owner, mode, device and inode are still the directory claimed here.
try
  mkdir($ROOT, {parents: false})
  chmod($ROOT, 0o700)
catch $rooterr
  print("cannot claim " .. $ROOT .. " (" .. $rooterr .. ") — refusing to run"
    .. " fixtures in a directory this run did not create")
  exit(2)
end
$ROOT_STATE = stat($ROOT, {follow_symlinks: false})
if $ROOT_STATE["is_dir"] == false or $ROOT_STATE["is_symlink"] \
    or $ROOT_STATE["uid"] != uid() or $ROOT_STATE["perm"] != 0o700 then
  print("cannot prove private ownership of " .. $ROOT .. " — refusing to run")
  exit(2)
end

-- Every row from here on runs a NEUTRAL COPY of the gate: the shipped source
-- with its allowlist path repointed at an empty fixture file. This is not
-- tidiness. Until 2026-07-27 the real allowlist was empty, so reading it cost
-- nothing and nobody noticed the coupling; the first real entries landed and
-- eight rows went red at once, because an --all row scans the real repos, finds
-- none of the fixture-irrelevant exceptions used, reconciles all of them as
-- STALE, and exits 1 — a failure about the operator's data, reported as a
-- failure of the gate. Worse than the noise: five of those eight are MUTANT
-- rows that assert a pre-fix gate reports CLEAN, and a stale-allowlist exit 1
-- masks exactly that assertion, so the suite would keep passing the day the
-- mutants stopped being able to fail. A suite whose result depends on operator
-- data is not a suite. The copy also keeps the shipped gate honest in the other
-- direction: no row can pardon itself green off an operator-added entry.
$ALLOW_EMPTY = $ROOT .. "/empty.allow.conf.mix"
write_file($ALLOW_EMPTY, "public_hygiene_allow: { schema_version: 1, exceptions: [] }\n")
$GATE = $ROOT .. "/gate-neutral.mix"
write_file($GATE, must_replace(read_file($GATE_REAL),
  "$CMCTL .. \"/_etc/public-hygiene.allow.conf.mix\"", "\"" .. $ALLOW_EMPTY .. "\""))
-- Rows that need their OWN allowlist re-patch this literal, not the original
-- expression, which the copy no longer contains.
$ALLOW_ANCHOR = "\"" .. $ALLOW_EMPTY .. "\""

write_file($NSS_ENUMERABLE, "# a comment line\npasswd: files db\ngroup: files\n")

$FLEET_HOOKS_BEFORE = fleet_hooks_snapshot($REAL_CFG["repos"])
print("probing with node=" .. $NODE .. " ip=" .. $IP)
print("")
$f = 0

-- T1 — node names adjacent to - and _ (the boundary-class finding), run over
-- EVERY non-generic inventory member rather than one. A starter with no mesh
-- cannot stage this rule and says so; static-rule probes continue below.
if not $HAS_INVENTORY or len($NAMES) == 0 then
  print("SKIP  T1a/b/c (no non-generic member in " .. $INV_PATH
    .. " — cannot stage mesh-node boundary cases)")
else
  $r = newrepo("t1")
-- Fixture files are named by INDEX, not by node. Since round ten the gate
-- also scans tracked pathnames (T50), so a file called `miss-<node>.txt` is
-- itself a hit — the miss rows would report a false positive that is really a
-- correct catch in the filename, and the hit rows would pass without the body
-- ever being read. The index keeps each row measuring the BODY, which is what
-- the boundary rule is about.
  $idx1 = 0
  for each $n in $NAMES
    write_file($r .. "/hit-" .. ("" .. $idx1) .. ".txt",
      "unit noded-" .. $n .. ".service\nlet " .. $n .. "_addr = 1\n")
    -- Alphanumeric neighbours must not fire, or ordinary identifiers make the
    -- rule noisy enough to bypass.
    write_file($r .. "/miss-" .. ("" .. $idx1) .. ".txt",
      "zz" .. $n .. "zz\n" .. $n .. "0x\nprefix" .. $n .. "\n")
    $idx1 = $idx1 + 1
  end
  $dev_fixture = "/dev/" .. $NAMES[0] .. "blk0p1"
  write_file($r .. "/miss-devnode.txt", "mounted " .. $dev_fixture .. " ok\n")
  commit($r, "t1")
  $g = gate(["--tree", $r])
  $f = $f + ok("T1a  noded-<node> and <node>_addr are caught", $g["code"] == 1, "" .. $g["code"])
  $missing = []
  $idx1 = 0
  for each $n in $NAMES
    if contains($g["out"], "hit-" .. ("" .. $idx1) .. ".txt") == false then
      push($missing, $n)
    end
    $idx1 = $idx1 + 1
  end
  $f = $f + ok("T1b  every non-generic member is caught at a -/_ boundary",
    len($NAMES) > 0 and len($missing) == 0, "not caught: " .. join($missing, " "))
  $fp_pos = []
  $idx1 = 0
  for each $n in $NAMES
    if contains($g["out"], "miss-" .. ("" .. $idx1) .. ".txt") then
      push($fp_pos, $n)
    end
    $idx1 = $idx1 + 1
  end
  if contains($g["out"], "miss-devnode.txt") then
    push($fp_pos, $dev_fixture)
  end
  $f = $f + ok("T1c  no member fires with an alphanumeric beside it",
    len($fp_pos) == 0, "false positives: " .. join($fp_pos, " "))
end

-- T2 — annotated tag message (invisible to any commit scan).
$r = newrepo("t2")
write_file($r .. "/clean.txt", "nothing to see\n")
$c = commit($r, "t2 clean")
must($r, ["git", "tag", "-a", "v1", "-m", "cut for " .. $NODE .. " at " .. $IP])
$g = gate(["--range", $r, "refs/tags/v1"])
$f = $f + ok("T2a  the commit range is genuinely clean", $g["code"] == 0, $g["out"])
$g = gate(["--object", $r, "refs/tags/v1"])
$f = $f + ok("T2b  --object catches the tag message", $g["code"] == 1, $g["out"])
$g = gate(["--object", $r, $c])
$f = $f + ok("T2c  --object on a clean commit object passes", $g["code"] == 0, $g["out"])

-- T3 — two identical violating lines must NOT share one fingerprint.
$r = newrepo("t3")
write_file($r .. "/dup.txt", "peer " .. $NODE .. "\npeer " .. $NODE .. "\n")
commit($r, "t3")
$g = gate(["--tree", $r, "--print-fingerprints"])
$fps = fingerprints($g["out"])
$f = $f + ok("T3a  two violations reported", len($fps) == 2, "" .. len($fps))
$f = $f + ok("T3b  their fingerprints differ (line number is bound in)",
  len($fps) == 2 and $fps[0] != $fps[1], join($fps, " "))

-- T4 — the same line must fingerprint identically in every mode.
$r = newrepo("t4")
write_file($r .. "/base.txt", "base\n")
commit($r, "t4 base")
write_file($r .. "/leak.txt", "addr = " .. $IP .. "\n")
must($r, ["git", "add", "-A"])
$g = gate(["--index", $r, "--print-fingerprints"])
$fp_index = fingerprints($g["out"])
must($r, ["git", "commit", "-q", "-m", "t4 leak"])
$g = gate(["--tree", $r, "--print-fingerprints"])
$fp_tree = fingerprints($g["out"])
$g = gate(["--range", $r, "HEAD~1..HEAD", "--print-fingerprints"])
$fp_range = fingerprints($g["out"])
$f = $f + ok("T4  --index / --tree / --range agree on the fingerprint",
  len($fp_index) == 1 and len($fp_tree) == 1 and len($fp_range) == 1 \
  and $fp_index[0] == $fp_tree[0] and $fp_tree[0] == $fp_range[0],
  join(concat(concat($fp_index, $fp_tree), $fp_range), " "))

-- T5 — a binary pardon names the complete immutable blob, not its path or the
-- working file. One changed byte must re-arm the gate; that is the load-bearing
-- safety property, so the expected digest is computed independently from the
-- fixture and the changed object is scanned with the old pardon still present.
$r = newrepo("t5")
$blob5 = $r .. "/blob.bin"
$bytes5 = "\u{0}\u{1}host " .. $NODE .. "\u{0}\n"
write_file($blob5, $bytes5)
$sha5 = hash_file($blob5, "sha256")
$tree5 = commit($r, "t5")
$g = gate(["--tree", $r, "--print-fingerprints"])
$f = $f + ok("T5a  binary content is a violation", $g["code"] == 1, $g["out"])
$fps5 = fingerprints($g["out"])
$f = $f + ok("T5b  --print-fingerprints gives the fixture's independent sha256",
  len($fps5) == 1 and regex_match("^[0-9a-f]{64}$", $fps5[0])
    and $fps5[0] == $sha5
    and contains($g["out"],
      "sha256 of full contents (verify: sha256sum " .. $blob5 .. ")"),
  $g["out"] .. " expected=" .. $sha5)

$allow5 = $ROOT .. "/t5.allow.conf.mix"
$gate5 = $ROOT .. "/gate-t5.mix"
write_file($allow5, join([
  "public_hygiene_allow: { schema_version: 1, exceptions: [],\n",
  "  binary_exceptions: [{ sha256: \"" .. $sha5
    .. "\", reason: \"inspected fixture\" }] }\n"
], ""))
write_file($gate5, must_replace(read_file($GATE),
  $ALLOW_ANCHOR, "\"" .. $allow5 .. "\""))
$g5 = run_argv([$MIX, $gate5, "--tree", $r, $tree5],
  {timeout: 600, env: {TMPDIR: $ROOT, CMCTL: $CMCTL}})
$f = $f + ok("T5c  a matching binary_exceptions entry pardons the blob",
  $g5["exit_code"] == 0 and contains($g5["stdout"], "[binary_exceptions]"),
  "" .. $g5["exit_code"] .. " " .. $g5["stdout"] .. $g5["stderr"])

-- Change exactly the second byte (0x01 -> 0x02), leaving the matching bytes,
-- path and length untouched. A path-based or partial-content pardon stays
-- green here; only a full-content digest goes red.
write_file($blob5, "\u{0}\u{2}host " .. $NODE .. "\u{0}\n")
$changed5 = commit($r, "t5 one byte changed")
$g5 = run_argv([$MIX, $gate5, "--tree", $r, $changed5],
  {timeout: 600, env: {TMPDIR: $ROOT, CMCTL: $CMCTL}})
$f = $f + ok("T5d  flipping one byte re-arms the gate under the same pardon",
  $g5["exit_code"] == 1 and contains($g5["stdout"], "blob.bin"),
  "" .. $g5["exit_code"] .. " " .. $g5["stdout"] .. $g5["stderr"])

-- The two allowlist namespaces must never cross-pardon, even though both keys
-- happen to be 64 lowercase hex strings.
write_file($allow5, join([
  "public_hygiene_allow: { schema_version: 1, exceptions: [\n",
  "  { fingerprint: \"" .. $sha5 .. "\", reason: \"wrong namespace\" }\n",
  "], binary_exceptions: [] }\n"
], ""))
$g5 = run_argv([$MIX, $gate5, "--tree", $r, $tree5],
  {timeout: 600, env: {TMPDIR: $ROOT, CMCTL: $CMCTL}})
$f = $f + ok("T5e  a binary sha256 in exceptions does NOT pardon binary",
  $g5["exit_code"] == 1, "" .. $g5["exit_code"] .. " " .. $g5["stdout"])
$text5 = newrepo("t5-text")
write_file($text5 .. "/text.txt", "host " .. $NODE .. "\n")
commit($text5, "t5 text")
$text5out = gate(["--tree", $text5, "--print-fingerprints"])
$text5fps = fingerprints($text5out["out"])
$text5fp = ""
if len($text5fps) == 1 then
  $text5fp = $text5fps[0]
end
write_file($allow5, join([
  "public_hygiene_allow: { schema_version: 1, exceptions: [],\n",
  "  binary_exceptions: [{ sha256: \"" .. $text5fp
    .. "\", reason: \"wrong namespace\" }] }\n"
], ""))
$g5 = run_argv([$MIX, $gate5, "--tree", $text5],
  {timeout: 600, env: {TMPDIR: $ROOT, CMCTL: $CMCTL}})
$f = $f + ok("T5f  a text fingerprint in binary_exceptions does NOT pardon text",
  len($text5fps) == 1 and $g5["exit_code"] == 1,
  "fp=" .. $text5fp .. " code=" .. $g5["exit_code"] .. " " .. $g5["stdout"])

-- Staleness needs a complete scope, so point a dedicated --all gate at one
-- clean fixture repo. The label is part of the assertion: otherwise an unused
-- text exception could make the row green while binary reconciliation vanished.
$clean5 = newrepo("t5-clean")
write_file($clean5 .. "/clean.txt", "nothing to see\n")
commit($clean5, "t5 clean")
$conf5 = $ROOT .. "/t5.conf.mix"
write_file($conf5, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $clean5 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$unused5 = repeat("0", 64)
write_file($allow5, "public_hygiene_allow: { schema_version: 1, exceptions: [], "
  .. "binary_exceptions: [{ sha256: \"" .. $unused5
  .. "\", reason: \"unused fixture\" }] }\n")
$gate5all = $ROOT .. "/gate-t5-all.mix"
write_file($gate5all, must_replace(read_file($gate5),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf5 .. "\""))
$g5 = run_argv([$MIX, $gate5all, "--all"],
  {timeout: 600, env: {TMPDIR: $ROOT, CMCTL: $CMCTL}})
$f = $f + ok("T5g  --all reports an unused binary exception as labelled STALE",
  $g5["exit_code"] == 1 and contains($g5["stdout"], "STALE")
    and contains($g5["stdout"], "[binary_exceptions] " .. $unused5),
  "" .. $g5["exit_code"] .. " " .. $g5["stdout"])

write_file($allow5, "public_hygiene_allow: { schema_version: 1, exceptions: [], "
  .. "binary_exceptions: [{ sha256: \"" .. upper($sha5)
  .. "\", reason: \"bad uppercase\" }] }\n")
$g5upper = run_argv([$MIX, $gate5, "--tree", $clean5], {timeout: 600})
$f = $f + ok("T5h  uppercase binary sha256 is an exit-2 config refusal",
  $g5upper["exit_code"] == 2 and contains($g5upper["stdout"], upper($sha5)),
  "" .. $g5upper["exit_code"] .. " " .. $g5upper["stdout"])
$oid5 = substr($sha5, 0, 40)
write_file($allow5, "public_hygiene_allow: { schema_version: 1, exceptions: [], "
  .. "binary_exceptions: [{ sha256: \"" .. $oid5
  .. "\", reason: \"git oid pasted\" }] }\n")
$g5oid = run_argv([$MIX, $gate5, "--tree", $clean5], {timeout: 600})
$f = $f + ok("T5i  a 40-hex git oid is an exit-2 config refusal",
  $g5oid["exit_code"] == 2 and contains($g5oid["stdout"], $oid5),
  "" .. $g5oid["exit_code"] .. " " .. $g5oid["stdout"])
write_file($allow5, "public_hygiene_allow: { schema_version: 1, exceptions: [], "
  .. "binary_exceptions: [{ sha256: \"" .. $sha5
  .. "\", reason: \"   \" }] }\n")
$g5reason = run_argv([$MIX, $gate5, "--tree", $clean5], {timeout: 600})
$f = $f + ok("T5j  a blank binary reason is an exit-2 config refusal",
  $g5reason["exit_code"] == 2 and contains($g5reason["stdout"], "reason"),
  "" .. $g5reason["exit_code"] .. " " .. $g5reason["stdout"])

-- Backwards compatibility is explicit rather than incidental: the old config
-- shape must still produce both kinds of verdict, never a schema refusal.
write_file($allow5, "public_hygiene_allow: { schema_version: 1, exceptions: [] }\n")
$g5clean = run_argv([$MIX, $gate5, "--tree", $clean5], {timeout: 600})
$g5binary = run_argv([$MIX, $gate5, "--tree", $r, $tree5],
  {timeout: 600, env: {TMPDIR: $ROOT, CMCTL: $CMCTL}})
$f = $f + ok("T5k  an allowlist with no binary_exceptions key works as before",
  $g5clean["exit_code"] == 0 and $g5binary["exit_code"] == 1,
  "clean=" .. $g5clean["exit_code"] .. " binary=" .. $g5binary["exit_code"])

-- T6 — scanning nothing is exit 2, and an unreadable config is exit 2 (not 1).
$conf_empty = $ROOT .. "/empty.conf.mix"
write_file($conf_empty, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$src = read_file($GATE)
$patched = $ROOT .. "/gate-empty.mix"
write_file($patched, must_replace($src, "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"",
  "\"" .. $conf_empty .. "\""))
$r2 = run_argv([$MIX, $patched, "--all"], {timeout: 300})
$f = $f + ok("T6a  zero revision-units exits 2, not clean",
  $r2["exit_code"] == 2 and contains($r2["stdout"], "scanned 0"), $r2["stdout"])
$patched2 = $ROOT .. "/gate-noconf.mix"
write_file($patched2, must_replace($src, "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"",
  "\"" .. $ROOT .. "/does-not-exist.mix\""))
$r2 = run_argv([$MIX, $patched2, "--all"], {timeout: 300})
$f = $f + ok("T6b  an unreadable config exits 2, not 1",
  $r2["exit_code"] == 2, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

-- T7 — the installer must follow core.hooksPath, not write into the void.
$r = newrepo("t7")
write_file($r .. "/x.txt", "x\n")
commit($r, "t7")
-- OUTSIDE the working tree, which is where a core.hooksPath normally points.
-- In-tree is a different situation and gets its own row (T7h): the stubs are
-- then tracked content carrying an absolute operator path, and the gate is
-- right to refuse them.
$alt = $ROOT .. "/t7-hooks"
mkdir($alt)
must($r, ["git", "config", "core.hooksPath", $alt])
$conf7 = $ROOT .. "/t7.conf.mix"
write_file($conf7, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $r .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$ipatched = $ROOT .. "/install-t7.mix"
write_file($ipatched, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf7 .. "\""))
$r2 = run_installer([$MIX, $ipatched], {timeout: 300})
$f = $f + ok("T7a  stub lands in core.hooksPath", exists($alt .. "/pre-commit"),
  $r2["stdout"] .. $r2["stderr"])
$f = $f + ok("T7b  and NOT in .git/hooks", exists($r .. "/.git/hooks/pre-commit") == false, "")
$f = $f + ok("T7c  the non-default hooks dir is reported",
  contains($r2["stdout"], "hooks dir:"), $r2["stdout"])
chmod($alt .. "/pre-commit", 0o644)
$r2 = run_installer([$MIX, $ipatched, "--status"], {timeout: 300})
$f = $f + ok("T7d  --status flags a non-executable stub",
  contains($r2["stdout"], "NOT EXECUTABLE"), $r2["stdout"])
-- Everything above inspects the stub. Nothing above RUNS it, and round nine
-- was exactly that mistake at a larger scale: ninety probes passed while every
-- commit in all three repos was blocked, because each probe called the gate
-- directly instead of committing through it. So: repair what T7d broke, then
-- commit through what the INSTALLER wrote — the fleet's path, not a hook this
-- suite hand-wrote.
$r2 = run_installer([$MIX, $ipatched], {timeout: 300})
$f = $f + ok("T7e  reinstall repairs the non-executable stub",
  contains($r2["stdout"], "installed pre-commit")
    and (floor(stat($alt .. "/pre-commit")["perm"] / 64) % 2) == 1,
  $r2["stdout"] .. $r2["stderr"])
write_file($r .. "/clean7.txt", "nothing to see\n")
must($r, ["git", "add", "-A"])
$c7 = run_argv(["git", "-C", $r, "commit", "-q", "-m", "clean, through the stub"],
  {timeout: 1800})
$f = $f + ok("T7f  a clean commit passes through the installed stub",
  $c7["exit_code"] == 0,
  "" .. $c7["exit_code"] .. " " .. sanitize($c7["stdout"] .. $c7["stderr"]))
write_file($r .. "/leak7.txt", "peer " .. $IP .. "\n")
must($r, ["git", "add", "-A"])
$l7 = run_argv(["git", "-C", $r, "commit", "-q", "-m", "leaking, through the stub"],
  {timeout: 1800})
$f = $f + ok("T7g  and a leaking one is blocked by it",
  $l7["exit_code"] != 0
    and contains($l7["stdout"] .. $l7["stderr"], "BLOCKED")
    and contains($l7["stdout"] .. $l7["stderr"], $IP_LABEL),
  "" .. $l7["exit_code"] .. " " .. sanitize($l7["stdout"] .. $l7["stderr"]))
-- An IN-TREE core.hooksPath makes the stubs tracked content, and a stub is
-- three absolute paths under the operator's home. Refusing is correct — but
-- the failure reads as "the gate is broken", not "your hooks are committed",
-- so pin it: found while writing T7f, which pointed core.hooksPath into the
-- working tree and then could not commit anything at all.
$rm7 = run_argv(["rm", "-f", $r .. "/leak7.txt"], {timeout: 60})
$f = $f + ok("T7 premise: the leak fixture is gone", $rm7["ok"] == true,
  sanitize($rm7["stderr"]))
must($r, ["git", "rm", "-q", "-f", "--cached", "leak7.txt"])
-- The situation has to be built the way it actually arises: core.hooksPath
-- POINTED at a directory inside the working tree, and the installer run so the
-- stubs there are the ones it wrote. Copying a stub into a tracked directory
-- while hooksPath still pointed outside proved tracked-stub content is blocked
-- but said nothing about the installer or about which hook runs — the
-- re-review was right that the row did not reach its own claim.
$intree7 = $r .. "/myhooks"
mkdir($intree7)
must($r, ["git", "config", "core.hooksPath", $intree7])
-- Build a disposable self-locating hub whose path matches the configured
-- operator-home rule. The starter's placeholder rule deliberately does not
-- match this checkout's real path, so using the live hub here would make the
-- probe depend on whether its template had been personalised.
$hub7 = $ROOT .. "/" .. $HOME_STATIC["sample"] .. "-hub"
mkdir($hub7 .. "/_bin")
mkdir($hub7 .. "/_etc")
mkdir($hub7 .. "/_lib")
copy($GATE_REAL, $hub7 .. "/_bin/check-public-hygiene.mix")
copy($HOOK, $hub7 .. "/_bin/hygiene-hook.mix")
copy($INSTALL, $hub7 .. "/_bin/install-hygiene-hooks.mix")
copy($BIN_DIR .. "/../_lib/mesh_lib.mix", $hub7 .. "/_lib/mesh_lib.mix")
for each $program in ["check-public-hygiene.mix", "hygiene-hook.mix",
    "install-hygiene-hooks.mix"]
  chmod($hub7 .. "/_bin/" .. $program, 0o755)
end
write_file($hub7 .. "/_etc/public-hygiene.conf.mix", join([
  "public_hygiene: {",
  "  schema_version: 1,",
  "  repos: [\"" .. $r .. "\"],",
  "  static_rules: [{id: \"operator_home\", pattern: \""
    .. $HOME_STATIC["pattern"] .. "\", note: \"fixture rule\"}],",
  "  generic_node_names: [],",
  "  guidance: {ipv4: \"x\", domain: \"x\", node: \"x\", home: \"x\"}",
  "}",
  ""
], "\n"))
write_file($hub7 .. "/_etc/public-hygiene.allow.conf.mix",
  "public_hygiene_allow: { schema_version: 1, exceptions: [], binary_exceptions: [] }\n")
$in7 = run_installer([$MIX, $hub7 .. "/_bin/install-hygiene-hooks.mix"],
  {timeout: 300})
$f = $f + ok("T7h  the installer follows an IN-TREE core.hooksPath",
  $in7["exit_code"] == 0 and exists($intree7 .. "/pre-commit"),
  "" .. $in7["exit_code"] .. " " .. sanitize($in7["stdout"] .. $in7["stderr"]))
must($r, ["git", "add", "-A"])
$i7 = run_argv(["git", "-C", $r, "commit", "-q", "-m", "stubs as tracked content"],
  {timeout: 1800})
$f = $f + ok("T7i  and its own stubs are then caught as tracked content",
  $i7["exit_code"] != 0
    and contains($i7["stdout"] .. $i7["stderr"], "[operator_home]"),
  "" .. $i7["exit_code"] .. " " .. sanitize($i7["stdout"] .. $i7["stderr"]))

-- T8 — the new-ref range must be bounded by what the DESTINATION holds, not by
-- local remote-tracking refs, and git's argv must reach a chained hook.
--
-- Local `refs/remotes/origin/main` deliberately claims the violating tip is
-- already published while the real destination has only the base — a remote
-- repointed from a private repo to a public one leaves exactly that state, and
-- reading the tracking namespace turned it into a licence to skip the commit.
-- `refs/remotes/private/main` is the unrelated-mirror version of the same trap.
$r = newrepo("t8")
$dest = bare("t8dest")
write_file($r .. "/base.txt", "base\n")
$base = commit($r, "t8 base")
must($r, ["git", "push", "-q", $dest, $base .. ":refs/heads/main"])
write_file($r .. "/leak.txt", "gateway " .. $IP .. "\n")
$tip = commit($r, "t8 leak")
must($r, ["git", "update-ref", "refs/remotes/origin/main", $tip])
must($r, ["git", "update-ref", "refs/remotes/private/main", $tip])
$hooks = trim(must($r, ["git", "rev-parse", "--git-path", "hooks"]))
if starts_with($hooks, "/") == false then
  $hooks = $r .. "/" .. $hooks
end
$seen = $ROOT .. "/t8-prior-args.txt"
write_file($hooks .. "/pre-push.pre-hygiene", join([
  "#!" .. $MIX .. "\n",
  "write_file(\"" .. $seen .. "\", join(args(), \" \"))\n",
  "exit(0)\n"
], ""))
chmod($hooks .. "/pre-push.pre-hygiene", 0o755)
$r2 = push_ref($r, $dest, "refs/heads/feature", $tip)
$f = $f + ok("T8a  a stale tracking ref does NOT excuse a commit the destination lacks",
  $r2["exit_code"] == 1, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
$f = $f + ok("T8b  git's remote name/url reach a chained pre-push hook",
  exists($seen) and read_file($seen) == $dest .. " " .. $dest,
  "" .. exists($seen))
-- The other direction: what the destination really has must still be excluded,
-- or every push rescans all history and the gate becomes unusable.
$r2 = push_ref($r, $dest, "refs/heads/samebase", $base)
$f = $f + ok("T8c  a commit the destination already holds is not rescanned",
  $r2["exit_code"] == 0 and contains($r2["stdout"], "scanning 0 commit(s)"),
  "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

-- T9 — a re-tag of an already-published commit is caught via the tag body.
$r = newrepo("t9")
$dest = bare("t9dest")
write_file($r .. "/clean.txt", "fine\n")
$c = commit($r, "t9")
must($r, ["git", "push", "-q", $dest, $c .. ":refs/heads/main"])
must($r, ["git", "tag", "-a", "v9", "-m", "ship to " .. $NODE])
$tagsha = trim(must($r, ["git", "rev-parse", "refs/tags/v9"]))
$r2 = push_ref($r, $dest, "refs/tags/v9", $tagsha)
$f = $f + ok("T9  pre-push blocks a tag whose only leak is its message",
  $r2["exit_code"] == 1, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

-- T10 — the allowlist must actually pardon, and an exception belonging to
-- another repo must not make an unrelated scoped scan fail as "stale".
$r = newrepo("t10")
write_file($r .. "/leak.txt", "peer " .. $NODE .. "\n")
commit($r, "t10")
$allow_path = $ROOT .. "/t10.allow.conf.mix"
write_file($allow_path, "public_hygiene_allow: { schema_version: 1, exceptions: [] }\n")
$gpatched = $ROOT .. "/gate-allow.mix"
write_file($gpatched, must_replace(read_file($GATE),
  $ALLOW_ANCHOR, "\"" .. $allow_path .. "\""))
$r2 = run_argv([$MIX, $gpatched, "--tree", $r, "--print-fingerprints"], {timeout: 300})
$fp = fingerprints($r2["stdout"])[0]
write_file($allow_path, join([
  "public_hygiene_allow: { schema_version: 1, exceptions: [\n",
  "  { fingerprint: \"" .. $fp .. "\", reason: \"probe\" }\n",
  "] }\n"
], ""))
$r2 = run_argv([$MIX, $gpatched, "--tree", $r], {timeout: 300})
$f = $f + ok("T10a an exception pardons the line it fingerprints",
  $r2["exit_code"] == 0, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
$r3 = newrepo("t10b")
write_file($r3 .. "/fine.txt", "nothing\n")
must($r3, ["git", "add", "-A"])
$r2 = run_argv([$MIX, $gpatched, "--index", $r3], {timeout: 300})
$f = $f + ok("T10b a scoped scan does NOT fail on another repo's exception",
  $r2["exit_code"] == 0, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
$r2 = run_argv([$MIX, $gpatched, "--all"], {timeout: 600})
$f = $f + ok("T10c --all still reports it stale",
  $r2["exit_code"] == 1 and contains($r2["stdout"], "STALE"), $r2["stdout"])

-- T11 — commit MESSAGES are published and `git grep` cannot see them.
$r = newrepo("t11")
write_file($r .. "/clean.txt", "fine\n")
$base = commit($r, "t11 base")
write_file($r .. "/still-clean.txt", "fine\n")
must($r, ["git", "add", "-A"])
must($r, ["git", "commit", "-q", "-m", "deploy to " .. $NODE .. " at " .. $IP])
$g = gate(["--tree", $r])
$f = $f + ok("T11a a tree scan is clean (the message is not in the tree)",
  $g["code"] == 0, $g["out"])
$g = gate(["--range", $r, $base .. "..HEAD"])
$f = $f + ok("T11b --range catches the commit message", $g["code"] == 1, $g["out"])
$msgfile = $ROOT .. "/t11.msg"
write_file($msgfile, "ship it to " .. $NODE .. "\n")
$g = gate(["--message", $r, $msgfile])
$f = $f + ok("T11c --message catches a pending message", $g["code"] == 1, $g["out"])
write_file($msgfile, "ship it to alpha\n")
$g = gate(["--message", $r, $msgfile])
$f = $f + ok("T11d --message passes a sanitized one", $g["code"] == 0, $g["out"])
$r2 = run_argv([$MIX, $HOOK, "commit-msg"], {cwd: $r, timeout: 300})
$f = $f + ok("T11e commit-msg with no message file refuses (exit 2)",
  $r2["exit_code"] == 2, "" .. $r2["exit_code"])

-- T12 — a tag pointing at a BLOB: `git rev-list` exits 0 with no commits, so
-- the range is empty and clean while the push publishes the blob.
$r = newrepo("t12")
$dest = bare("t12dest")
write_file($r .. "/clean.txt", "fine\n")
$c = commit($r, "t12")
must($r, ["git", "push", "-q", $dest, $c .. ":refs/heads/main"])
write_file($r .. "/secret.txt", "host " .. $NODE .. " " .. $IP .. "\n")
$blob = trim(must($r, ["git", "hash-object", "-w", $r .. "/secret.txt"]))
must($r, ["git", "tag", "-a", "blobtag", "-m", "harmless message", $blob])
$tagsha = trim(must($r, ["git", "rev-parse", "refs/tags/blobtag"]))
$g = gate(["--range", $r, $tagsha])
$f = $f + ok("T12a the range really is empty and clean (the hole)",
  $g["code"] == 0, $g["out"])
$r2 = push_ref($r, $dest, "refs/tags/blobtag", $tagsha)
$f = $f + ok("T12b pre-push still blocks it (the blob is scanned)",
  $r2["exit_code"] == 1, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

-- T14 — nested tag chains (tag-of-a-tag is legal git).
--
-- Only the outermost object is on the wire, so a leak one level in is still
-- published; and the walk's depth bound must refuse a chain it could not
-- finish WITHOUT refusing one it did finish on the last allowed step.
fn tag_chain($p, $n)
  must($p, ["git", "tag", "-a", "c1", "-m", "clean"])
  $s = trim(must($p, ["git", "rev-parse", "refs/tags/c1"]))
  $i = 1
  while $i < $n
    $i = $i + 1
    -- Passing the TAG's sha (not the name) is what makes git nest rather than
    -- peel to the commit.
    must($p, ["git", "tag", "-a", "c" .. $i, "-m", "clean", $s])
    $s = trim(must($p, ["git", "rev-parse", "refs/tags/c" .. $i]))
  end
  return $s
end

$r = newrepo("t14")
$dest = bare("t14dest")
write_file($r .. "/clean.txt", "fine\n")
$c = commit($r, "t14")
must($r, ["git", "push", "-q", $dest, $c .. ":refs/heads/main"])
must($r, ["git", "tag", "-a", "inner", "-m", "cut for " .. $NODE])
$s = trim(must($r, ["git", "rev-parse", "refs/tags/inner"]))
must($r, ["git", "tag", "-a", "outer", "-m", "harmless", $s])
$s = trim(must($r, ["git", "rev-parse", "refs/tags/outer"]))
$r2 = push_ref($r, $dest, "refs/tags/outer", $s)
$f = $f + ok("T14a a leak in an INNER tag body is caught through the chain",
  $r2["exit_code"] == 1, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

$r = newrepo("t14-deep")
$dest = bare("t14deepdest")
write_file($r .. "/clean.txt", "fine\n")
$c = commit($r, "t14 deep")
must($r, ["git", "push", "-q", $dest, $c .. ":refs/heads/main"])
$s = tag_chain($r, 16)
$r2 = push_ref($r, $dest, "refs/tags/c16", $s)
$f = $f + ok("T14b a chain of exactly 16 is scanned, not refused",
  $r2["exit_code"] == 0, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

$r = newrepo("t14-toodeep")
$dest = bare("t14toodeepdest")
write_file($r .. "/clean.txt", "fine\n")
$c = commit($r, "t14 too deep")
must($r, ["git", "push", "-q", $dest, $c .. ":refs/heads/main"])
$s = tag_chain($r, 17)
$r2 = push_ref($r, $dest, "refs/tags/c17", $s)
$f = $f + ok("T14c a chain past the bound is refused (exit 2), never passed",
  $r2["exit_code"] == 2, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

-- T13 — the two engines must agree on every live rule.
--
-- The gate matches with `git grep -E -i` for anything in a tree and with the
-- in-process regex engine for everything a tree cannot hold. Two engines, one
-- rule set: a pattern that compiles in both but MATCHES in only one means a
-- string caught in a file walks straight through in a commit message. So feed
-- byte-identical text down both paths and demand the same set of rule ids.
--
-- Coverage is asserted against the rule COUNT the gate itself reports, not a
-- list repeated here. Add a rule without adding a sample and this fails with
-- the count mismatch rather than passing on the rules it does cover.
--
-- What this does NOT prove: it is ONE positive sample per rule, so it shows
-- the engines agree on text the rule was written for — not that they agree on
-- every string in the language. They are known to diverge on non-ASCII
-- boundaries (see the note in _etc/public-hygiene.conf.mix); that divergence
-- is false-positive-only, which is why it is documented rather than probed.
fn sample_from_pattern($pat)
  $p = $pat
  if starts_with($p, "(") and ends_with($p, ")") then
    $p = substr($p, 1, len($p) - 2)
  end
  return replace(split($p, "|")[0], "[.]", ".")
end

fn rule_ids($out)
  $ids = []
  for each $l in split($out, "\n")
    $t = trim($l)
    if starts_with($t, "[") and contains($t, "] ") then
      $id = split(substr($t, 1), "]")[0]
      if contains($ids, $id) == false then
        push($ids, $id)
      end
    end
  end
  return $ids
end

$corpus = []
if $HAS_INVENTORY then
  push($corpus,
    "addr " .. $oct[0] .. "." .. $oct[1] .. "." .. $oct[2] .. ".77 here")
  push($corpus,
    "ptr 77." .. $oct[2] .. "." .. $oct[1] .. "." .. $oct[0] .. ".in-addr.arpa here")
  push($corpus, "unit noded-" .. $NODE .. ".service here")
end
$statics = load_data($CMCTL .. "/_etc/public-hygiene.conf.mix")["public_hygiene"]["static_rules"]
$badsample = []
for each $s in $statics
  $line = "x " .. sample_from_pattern($s["pattern"]) .. " x"
  -- Self-check the extractor: a sample that does not match the rule it was
  -- derived from would make this probe assert nothing at all.
  if regex_match("(?i)" .. $s["pattern"], $line) == false then
    push($badsample, $s["id"])
  end
  push($corpus, $line)
end
$f = $f + ok("T13a a sample could be derived for every static rule",
  len($badsample) == 0, "no usable sample for: " .. join($badsample, " "))

$text = join($corpus, "\n") .. "\n"
$r = newrepo("t13")
write_file($r .. "/corpus.txt", $text)
commit($r, "t13")
$g = gate(["--tree", $r])
$tree_ids = rule_ids($g["out"])
$declared = 0
for each $l in split($g["out"], "\n")
  if contains($l, " rules") and contains($l, "scanned ") then
    $declared = 0 + trim(replace(split($l, ", ")[1], " rules", ""))
  end
end
$f = $f + ok("T13b the corpus exercises every rule the gate loaded",
  $declared > 0 and len($tree_ids) == $declared,
  "gate loaded " .. $declared .. ", corpus fired " .. len($tree_ids) .. ": " .. join($tree_ids, " "))

$msgfile = $ROOT .. "/t13.msg"
write_file($msgfile, $text)
$g = gate(["--message", $r, $msgfile])
$msg_ids = rule_ids($g["out"])
$only_tree = []
for each $id in $tree_ids
  if contains($msg_ids, $id) == false then
    push($only_tree, $id)
  end
end
$only_msg = []
for each $id in $msg_ids
  if contains($tree_ids, $id) == false then
    push($only_msg, $id)
  end
end
$f = $f + ok("T13c both engines match the sample text for every rule",
  len($only_tree) == 0 and len($only_msg) == 0,
  "git-grep-only: " .. join($only_tree, " ") .. " / in-process-only: " .. join($only_msg, " "))

-- T15 — a colon in a path must not collide two violations onto one fingerprint.
--
-- `git grep -n` emits `path:lineno:text`. Split on ":", these two are the SAME
-- record and so hashed identically, and one allowlist entry pardoned both:
--   path `a:12`, line 3,  text `hit <node>`
--   path `a`,    line 12, text `3:hit <node>`
$r = newrepo("t15")
write_file($r .. "/a:12", "x\nx\nhit " .. $NODE .. "\n")
write_file($r .. "/a", "x\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\n3:hit " .. $NODE .. "\n")
commit($r, "t15")
$g = gate(["--tree", $r, "--print-fingerprints"])
$fps = fingerprints($g["out"])
$f = $f + ok("T15a both colon-shaped violations are reported", len($fps) == 2,
  "" .. len($fps) .. " " .. $g["out"])
$f = $f + ok("T15b they do NOT share a fingerprint",
  len($fps) == 2 and $fps[0] != $fps[1], join($fps, " "))
$f = $f + ok("T15c the colon-bearing path is reported intact",
  contains($g["out"], "a:12:3 ") or contains($g["out"], "/a:12:3"), $g["out"])

-- T16 — an object hit must be pardonable only for the object it was granted
-- for. The key used to be the constant "<object-body>", so one exception
-- pardoned every future tag carrying the same text on the same line.
$r = newrepo("t16")
write_file($r .. "/clean.txt", "fine\n")
commit($r, "t16")
must($r, ["git", "tag", "-a", "one", "-m", "ship to " .. $NODE])
must($r, ["git", "tag", "-a", "two", "-m", "ship to " .. $NODE])
$allow16 = $ROOT .. "/t16.allow.conf.mix"
write_file($allow16, "public_hygiene_allow: { schema_version: 1, exceptions: [] }\n")
$gate16 = $ROOT .. "/gate-t16.mix"
write_file($gate16, must_replace(read_file($GATE),
  $ALLOW_ANCHOR, "\"" .. $allow16 .. "\""))
$one = run_argv([$MIX, $gate16, "--object", $r, "refs/tags/one", "--print-fingerprints"],
  {timeout: 300})
$two = run_argv([$MIX, $gate16, "--object", $r, "refs/tags/two", "--print-fingerprints"],
  {timeout: 300})
$fp1 = fingerprints($one["stdout"])
$fp2 = fingerprints($two["stdout"])
$f = $f + ok("T16a two tags with identical text get DIFFERENT fingerprints",
  len($fp1) == 1 and len($fp2) == 1 and $fp1[0] != $fp2[0],
  join(concat($fp1, $fp2), " "))
write_file($allow16, join([
  "public_hygiene_allow: { schema_version: 1, exceptions: [\n",
  "  { fingerprint: \"" .. $fp1[0] .. "\", reason: \"probe\" }\n",
  "] }\n"
], ""))
$one = run_argv([$MIX, $gate16, "--object", $r, "refs/tags/one"], {timeout: 300})
$two = run_argv([$MIX, $gate16, "--object", $r, "refs/tags/two"], {timeout: 300})
$f = $f + ok("T16b the pardon applies to the tag it names",
  $one["exit_code"] == 0, "" .. $one["exit_code"] .. " " .. $one["stdout"])
$f = $f + ok("T16c and NOT to the other tag",
  $two["exit_code"] == 1, "" .. $two["exit_code"] .. " " .. $two["stdout"])
$msg16 = $ROOT .. "/t16.msg"
write_file($msg16, "ship to " .. $NODE .. "\n")
$g = gate(["--message", $r, $msg16, "--print-fingerprints"])
$f = $f + ok("T16d a PENDING commit message is unpardonable (nothing stable to pin)",
  $g["code"] == 1 and contains($g["out"], "cannot be pardoned"), $g["out"])

-- T17 — --all is the audit mode and the only one that reconciles the
-- allowlist, so it must see tag bodies; and a parseable-but-wrong config must
-- exit 2 ("could not check"), never 1 ("found a violation").
$r = newrepo("t17")
write_file($r .. "/clean.txt", "fine\n")
commit($r, "t17")
must($r, ["git", "tag", "-a", "leaky", "-m", "cut for " .. $NODE])
fn conf_for($path, $repo, $extra)
  write_file($path, join([
    "public_hygiene: {\n",
    "  schema_version: 1,\n",
    "  repos: [\"" .. $repo .. "\"],\n",
    "  static_rules: " .. $FIXTURE_RULES .. ",\n",
    "  generic_node_names: [],\n",
    $extra,
    "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
    "}\n"
  ], ""))
end
$conf17 = $ROOT .. "/t17.conf.mix"
conf_for($conf17, $r, "")
$gate17 = $ROOT .. "/gate-t17.mix"
write_file($gate17, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf17 .. "\""))
$r2 = run_argv([$MIX, $gate17, "--all"], {timeout: 600})
$f = $f + ok("T17a --all sees a leak that lives only in a tag body",
  $r2["exit_code"] == 1 and contains($r2["stdout"], "tag-body"),
  "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
$bad17 = $ROOT .. "/t17-bad.conf.mix"
write_file($bad17, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: \"" .. $r .. "\",\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate17b = $ROOT .. "/gate-t17b.mix"
write_file($gate17b, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $bad17 .. "\""))
$r2 = run_argv([$MIX, $gate17b, "--all"], {timeout: 300})
$f = $f + ok("T17b a mistyped config exits 2, not 1",
  $r2["exit_code"] == 2, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
$bad17c = $ROOT .. "/t17-ver.conf.mix"
write_file($bad17c, replace(read_file($conf17), "schema_version: 1", "schema_version: 2"))
$gate17c = $ROOT .. "/gate-t17c.mix"
write_file($gate17c, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $bad17c .. "\""))
$r2 = run_argv([$MIX, $gate17c, "--all"], {timeout: 300})
$f = $f + ok("T17c an unknown schema_version stops rather than being misread",
  $r2["exit_code"] == 2, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

-- T18 — --all and pre-push share one object-chain walk. The old audit scanned
-- only the object named directly by refs/tags, missing an inner tag and every
-- lightweight tag of a blob or tree.
$r = newrepo("t18")
write_file($r .. "/clean.txt", "fine\n")
commit($r, "t18")
$conf18 = $ROOT .. "/t18.conf.mix"
conf_for($conf18, $r, "")
$gate18 = $ROOT .. "/gate-t18.mix"
write_file($gate18, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf18 .. "\""))
must($r, ["git", "tag", "-a", "inner", "-m", "cut for " .. $NODE])
$inner = trim(must($r, ["git", "rev-parse", "refs/tags/inner"]))
must($r, ["git", "tag", "-a", "outer", "-m", "clean", $inner])
must($r, ["git", "tag", "-d", "inner"])
$r2 = run_argv([$MIX, $gate18, "--all"], {timeout: 600})
$f = $f + ok("T18a --all walks through an outer tag to a leaky inner body",
  $r2["exit_code"] == 1 and contains($r2["stdout"], "tag-body"),
  "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
must($r, ["git", "tag", "-d", "outer"])
write_file($r .. "/leaky-blob.txt", "host " .. $NODE .. "\n")
$blob = trim(must($r, ["git", "hash-object", "-w", $r .. "/leaky-blob.txt"]))
must($r, ["git", "update-ref", "refs/tags/blob", $blob])
$r2 = run_argv([$MIX, $gate18, "--all"], {timeout: 600})
$f = $f + ok("T18b --all scans the blob behind a lightweight tag",
  $r2["exit_code"] == 1 and contains($r2["stdout"], "blob-body"),
  "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
must($r, ["git", "update-ref", "-d", "refs/tags/blob"])
$tree = trim(must($r, ["git", "rev-parse", "HEAD^{tree}"]))
must($r, ["git", "update-ref", "refs/tags/tree", $tree])
$r2 = run_argv([$MIX, $gate18, "--all"], {timeout: 600})
$f = $f + ok("T18c --all refuses a terminal tree instead of reporting clean",
  $r2["exit_code"] == 2 and contains($r2["stdout"], "tree object"),
  "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

-- T19 — all three configuration files are trust boundaries. A parseable
-- allowlist or inventory with the wrong shape/version is "could not check".
$r = newrepo("t19")
write_file($r .. "/clean.txt", "fine\n")
commit($r, "t19")
$badallow = $ROOT .. "/t19-bad.allow.conf.mix"
write_file($badallow,
  "public_hygiene_allow: { schema_version: 1, exceptions: \"oops\" }\n")
$gate19 = $ROOT .. "/gate-t19.mix"
write_file($gate19, must_replace(read_file($GATE),
  $ALLOW_ANCHOR, "\"" .. $badallow .. "\""))
$r2 = run_argv([$MIX, $gate19, "--tree", $r], {timeout: 300})
$f = $f + ok("T19a a mistyped allowlist exits 2, not an uncaught exit 1",
  $r2["exit_code"] == 2, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
write_file($badallow,
  "public_hygiene_allow: { schema_version: 2, exceptions: [] }\n")
$r2 = run_argv([$MIX, $gate19, "--tree", $r], {timeout: 300})
$f = $f + ok("T19b an unknown allowlist schema_version stops",
  $r2["exit_code"] == 2, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
$badinv = $ROOT .. "/t19-bad.inventory.mix"
write_file($badinv, join([
  "inventory: {\n",
  "  schema_version: 2,\n",
  "  subnet: \"" .. $INV_SUBNET .. "\",\n",
  "  members: [{ name: \"" .. $INV_NODE .. "\" }]\n",
  "}\n"
], ""))
$gate19i = $ROOT .. "/gate-t19-inv.mix"
write_file($gate19i, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/mesh/inventory.mix\"", "\"" .. $badinv .. "\""))
$r2 = run_argv([$MIX, $gate19i, "--tree", $r], {timeout: 300})
$f = $f + ok("T19c an unknown inventory schema_version stops",
  $r2["exit_code"] == 2, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])
write_file($badinv, join([
  "inventory: {\n",
  "  schema_version: 1,\n",
  "  subnet: \"" .. $INV_SUBNET .. "\",\n",
  "  members: \"oops\"\n",
  "}\n"
], ""))
$r2 = run_argv([$MIX, $gate19i, "--tree", $r], {timeout: 300})
$f = $f + ok("T19d a mistyped inventory exits 2, not an uncaught exit 1",
  $r2["exit_code"] == 2, "" .. $r2["exit_code"] .. " " .. $r2["stdout"])

-- T20 — -z terminates fields, not records. A newline in the next path follows
-- the text record's newline and must survive intact; binary matches can be
-- interleaved on either side. Their new content hashes are counted separately
-- so they cannot make the original text-path assertion pass by accident.
$r = newrepo("t20")
write_file($r .. "/base.txt", "fine\n")
$base = commit($r, "t20 base")
write_file($r .. "/aa.bin", "\u{0}host " .. $NODE .. "\u{0}")
write_file($r .. "/bad\nname.txt", "peer " .. $NODE .. "\n")
write_file($r .. "/cc\nbin.bin", "\u{0}host " .. $NODE .. "\u{0}")
write_file($r .. "/zz.bin", "\u{0}host " .. $NODE .. "\u{0}")
$binary20 = hash_file($r .. "/aa.bin", "sha256")
must($r, ["git", "add", "-A"])
$g = gate(["--index", $r, "--print-fingerprints"])
$fps = fingerprints($g["out"])
$binary20n = count($fps, fn($x) = $x == $binary20)
$f = $f + ok("T20a --index parses a newline path among binary diagnostics",
  $g["code"] == 1 and len($fps) == 4 and $binary20n == 3 \
  and contains($g["out"], "bad\nname.txt") \
  and contains($g["out"], "cc\nbin.bin"),
  "" .. $g["code"] .. " fps=" .. len($fps) .. " binary=" .. $binary20n
    .. " " .. $g["out"])
$tip = commit($r, "t20 paths")
$g = gate(["--range", $r, $base .. ".." .. $tip, "--print-fingerprints"])
$fps = fingerprints($g["out"])
$binary20n = count($fps, fn($x) = $x == $binary20)
$f = $f + ok("T20b --range preserves the same legal newline-bearing path",
  $g["code"] == 1 and len($fps) == 4 and $binary20n == 3 \
  and contains($g["out"], "bad\nname.txt") \
  and contains($g["out"], "cc\nbin.bin"),
  "" .. $g["code"] .. " fps=" .. len($fps) .. " binary=" .. $binary20n
    .. " " .. $g["out"])

-- T21 — remote ref count must not become process count or argv size. Duplicate
-- refs make the expected batch cardinality deterministic while a wrapper logs
-- the actual git subprocess shape.
$r = newrepo("t21")
$dest = bare("t21dest")
write_file($r .. "/base.txt", "fine\n")
$base = commit($r, "t21 base")
must($r, ["git", "push", "-q", $dest, $base .. ":refs/heads/main"])
$updates = []
$i = 0
while $i < 80
  $i = $i + 1
  push($updates, "update refs/tags/r" .. $i .. " " .. $base)
end
$ur = run_argv(["git", "-C", $dest, "update-ref", "--stdin"],
  {stdin: join($updates, "\n") .. "\n", timeout: 300})
if $ur["ok"] != true then
  print("SETUP FAILED creating t21 remote refs")
  exit(2)
end
write_file($r .. "/tip.txt", "still fine\n")
$tip = commit($r, "t21 tip")
$wrapdir = $ROOT .. "/t21-bin"
mkdir($wrapdir)
$gitlog = $ROOT .. "/t21-git.log"
write_file($gitlog, "")
$realgit = which("git")
write_file($wrapdir .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"cat-file\") then\n",
  "  append_file(\"" .. $gitlog .. "\", \"CAT \" .. join($a, \"\\u{1f}\") .. \"\\n\")\n",
  "end\n",
  "if contains($a, \"rev-list\") then\n",
  "  append_file(\"" .. $gitlog .. "\", \"REV \" .. join($a, \"\\u{1f}\") .. \"\\n\")\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit .. "\"], $a)))\n"
], ""))
chmod($wrapdir .. "/git", 0o755)
$r2 = run_argv([$MIX, $HOOK, "pre-push", $dest, $dest], {
  cwd: $r,
  stdin: "refs/heads/feature " .. $tip .. " refs/heads/feature " .. $ZERO .. "\n",
  timeout: 900,
  env: {PATH: $wrapdir .. ":" .. env("PATH")}
})
$batch_count = 0
$type_count = 0
$rev_stdin = false
$rev_caret = false
for each $line in split(read_file($gitlog), "\n")
  if starts_with($line, "CAT ") and contains($line, "--batch-check") then
    $batch_count = $batch_count + 1
  end
  if starts_with($line, "CAT ") and contains($line, "\u{1f}-t\u{1f}") then
    $type_count = $type_count + 1
  end
  if starts_with($line, "REV ") then
    if contains($line, "\u{1f}--stdin") then
      $rev_stdin = true
    end
    if contains($line, "\u{1f}^") then
      $rev_caret = true
    end
  end
end
$f = $f + ok("T21 remote refs use one batch and stdin rev exclusions",
  $r2["exit_code"] == 0 and $batch_count == 1 and $type_count == 1 \
  and $rev_stdin and $rev_caret == false,
  "rc=" .. $r2["exit_code"] .. " batch=" .. $batch_count
    .. " type=" .. $type_count .. " stdin=" .. $rev_stdin
    .. " caret=" .. $rev_caret .. "\n" .. read_file($gitlog))

-- T22 — the -z parser's fail-closed backstop must actually be reachable.
--
-- `index_of` returns -1, NOT nil, when the needle is absent, and Mix slice()
-- reads a negative index FROM THE END. So the guard written as `== nil` never
-- fired: a record whose text was not newline-terminated silently lost its last
-- character, and the NEXT record's path was fabricated from the leftover. The
-- pre-fix parser reported exit 1 against a path (`unterminatedb.txt`) that does
-- not exist, with a fingerprint to match — a violation invented by the parser.
--
-- Real git always newline-terminates, so a stub git is the only way in. That is
-- the point: this guard exists for the case the tool cannot otherwise survive.
$r = newrepo("t22")
write_file($r .. "/f.txt", "anything\n")
$unused = commit($r, "t22")
$w22 = $ROOT .. "/t22-bin"
mkdir($w22)
$realgit22 = which("git")
write_file($w22 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"grep\") then\n",
  -- One unterminated record followed by a well-formed one: the leftover of the
  -- first becomes the second's path unless the guard refuses.
  "  write_file(\"/dev/stdout\",\n",
  "    \"a.txt\\u{0}1\\u{0}unterminated\" .. \"b.txt\\u{0}2\\u{0}second\\n\")\n",
  "  exit(0)\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit22 .. "\"], $a)))\n"
], ""))
chmod($w22 .. "/git", 0o755)
$env22 = {PATH: $w22 .. ":" .. env("PATH")}
$r22 = run_argv([$MIX, $GATE, "--tree", $r], {timeout: 300, env: $env22})
$f = $f + ok("T22a a malformed grep record exits 2, never a fabricated hit",
  $r22["exit_code"] == 2 and contains($r22["stdout"] .. $r22["stderr"], "unparseable"),
  "" .. $r22["exit_code"] .. " " .. $r22["stdout"] .. $r22["stderr"])
$f = $f + ok("T22b and does not invent a path out of the leftover",
  contains($r22["stdout"] .. $r22["stderr"], "unterminatedb.txt") == false,
  $r22["stdout"] .. $r22["stderr"])

-- T23 — one allowlist entry must never pardon two different violations.
--
-- The fingerprint joined its fields with U+001F, which is only unambiguous if
-- no field can contain it. A path may hold any byte but NUL and `/`, and line
-- text any control character, so `path "a<US>1", line 2, text T` hashed
-- identically to `path "a", line 1, text "2<US>T"` — a single exception
-- pardoned both and the gate exited clean. Length-prefixed fields make the
-- encoding injective; this is the same defect as the earlier `:` collision,
-- which is why a fresh separator was not the fix.
$r = newrepo("t23")
write_file($r .. "/a\u{1f}1", "harmless\npeer " .. $NODE .. "\n")
write_file($r .. "/a", "2\u{1f}peer " .. $NODE .. "\n")
$unused = commit($r, "t23")
$r23 = gate(["--tree", $r, "--print-fingerprints"])
$fps23 = fingerprints($r23["out"])
$f = $f + ok("T23a both colliding-shape violations are reported",
  $r23["code"] == 1 and len($fps23) == 2, "" .. $r23["code"] .. " " .. $r23["out"])
$f = $f + ok("T23b and they carry DIFFERENT fingerprints",
  len($fps23) == 2 and $fps23[0] != $fps23[1], join($fps23, " == "))

-- T24 — git grep exit 0 asserts a match exists, so an empty stream is a lie.
--
-- Read as "no matches" it turned every scan into a silent clean: a wrapper or
-- shim on PATH that swallowed output disabled the gate without failing it.
-- Real git cannot produce this, so a stub is the only way to reach the guard.
$r = newrepo("t24")
write_file($r .. "/f.txt", "peer " .. $NODE .. "\n")
$unused = commit($r, "t24")
$w24 = $ROOT .. "/t24-bin"
mkdir($w24)
$realgit24 = which("git")
write_file($w24 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"grep\") then\n",
  "  exit(0)\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit24 .. "\"], $a)))\n"
], ""))
chmod($w24 .. "/git", 0o755)
$r24 = run_argv([$MIX, $GATE, "--tree", $r],
  {timeout: 300, env: {PATH: $w24 .. ":" .. env("PATH")}})
$f = $f + ok("T24 exit 0 with no output is refused, not read as clean",
  $r24["exit_code"] == 2
    and contains($r24["stdout"] .. $r24["stderr"], "reported matches"),
  "" .. $r24["exit_code"] .. " " .. $r24["stdout"] .. $r24["stderr"])

-- T25 — a hit at a path that does not exist is a parse failure, not a leak.
--
-- git's -z stream cannot distinguish a binary diagnostic from a PATH shaped
-- like one: `Binary file decoy matches\nreal.txt` parsed as a binary hit at
-- `decoy` plus a text hit at `real.txt`, neither of which exists. Reporting
-- exit 1 was bad enough; the fabricated hit landed on the BINARY branch, which
-- is deliberately unpardonable, so the gate refused forever with no way to
-- disposition it. Checking every path against the scanned scope converted it
-- to an honest exit 2.
--
-- The two-pass scan (T29) later removed the ambiguity at source, so real git
-- can no longer emit this stream. The probe stays, and the stub is the point:
-- the scope check is the backstop for a git that lies — a wrapper, a shim on
-- PATH, a future format change — and a backstop nothing exercises is a
-- backstop nobody knows is broken.
$r = newrepo("t25")
write_file($r .. "/f.txt", "harmless\n")
$unused = commit($r, "t25")
$w25 = $ROOT .. "/t25-bin"
mkdir($w25)
$realgit25 = which("git")
write_file($w25 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"grep\") then\n",
  "  write_file(\"/dev/stdout\",\n",
  "    \"Binary file decoy matches\\nreal.txt\\u{0}1\\u{0}peer x\\n\")\n",
  "  exit(0)\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit25 .. "\"], $a)))\n"
], ""))
chmod($w25 .. "/git", 0o755)
-- --print-fingerprints is load-bearing here, not decoration: the unpardonable
-- marker is only printed in that mode, so without it T25b asserts nothing and
-- passes against the pre-fix gate too.
$r25 = run_argv([$MIX, $GATE, "--index", $r, "--print-fingerprints"],
  {timeout: 300, env: {PATH: $w25 .. ":" .. env("PATH")}})
$out25 = $r25["stdout"] .. $r25["stderr"]
$f = $f + ok("T25a a hit at a nonexistent path exits 2, not 1",
  $r25["exit_code"] == 2 and contains($out25, "does not exist in the scanned scope"),
  "" .. $r25["exit_code"] .. " " .. $out25)
$f = $f + ok("T25b and never becomes an unpardonable binary violation",
  contains($out25, "cannot be pardoned") == false, $out25)

-- T26 — git's "no such ref" sentinel is 64 zeroes in a SHA-256 repository.
--
-- Against a hardcoded 40-zero literal a SHA-256 branch DELETION read as a real
-- published object; the hook fed it to rev-list, git said "bad object", and
-- the gate blocked a push that published nothing. The same literal gated the
-- unknown-destination fallback, so the bug was not confined to deletions.
$p26 = $ROOT .. "/t26"
mkdir($p26)
must($p26, ["git", "init", "-q", "-b", "main", "--object-format=sha256"])
must($p26, ["git", "config", "user.email", "probe@example.com"])
must($p26, ["git", "config", "user.name", "probe"])
write_file($p26 .. "/f.txt", "harmless\n")
$unused = commit($p26, "t26")
$b26 = bare("t26-remote")
$zero256 = ""
while len($zero256) < 64
  $zero256 = $zero256 .. "0"
end
$r26 = run_argv([$MIX, $HOOK, "pre-push", $b26, $b26],
  {cwd: $p26,
   stdin: "(delete) " .. $zero256 .. " refs/heads/main " .. $zero256 .. "\n",
   timeout: 900})
$f = $f + ok("T26 a SHA-256 branch deletion is recognised and allowed",
  $r26["exit_code"] == 0, "" .. $r26["exit_code"] .. " "
    .. $r26["stdout"] .. $r26["stderr"])

-- T27 — a SYMLINK's target path is published content that git grep cannot see.
--
-- git grep reads regular-file blobs only, in every mode, with or without a
-- revision — so a link at `/srv/<node>/data`, or one pointing into the
-- operator's home, sat in the tree and the gate reported clean. Same class as
-- tag bodies and commit messages: git grep sees part of what is published, and
-- every part it cannot see needs its own path. Found by probing whether the
-- new scope check could turn a real violation into an error; it turned up a
-- violation the gate had never been able to find at all.
$r = newrepo("t27")
write_file($r .. "/plain.txt", "harmless\n")
$y = must($r, ["ln", "-s", "/srv/" .. $NODE .. "/data", "link"])
$unused = commit($r, "t27")
$r27t = gate(["--tree", $r, "--print-fingerprints"])
$r27i = gate(["--index", $r])
$f = $f + ok("T27a a leaking symlink target is caught in a tree scan",
  $r27t["code"] == 1 and contains($r27t["out"], "link"),
  "" .. $r27t["code"] .. " " .. $r27t["out"])
$f = $f + ok("T27b and in an index scan",
  $r27i["code"] == 1, "" .. $r27i["code"] .. " " .. $r27i["out"])
$f = $f + ok("T27c and it is pardonable — the target is stable content",
  len(fingerprints($r27t["out"])) == 1, $r27t["out"])

-- T28 — a file git calls TEXT can still hold bytes that are not UTF-8.
--
-- git speaks bytes; Mix strings are UTF-8. A line with a stray 0x80 (and no
-- NUL, so git treats the file as text and prints the line) came back through
-- `run_argv` lossily decoded, every undecodable byte replaced by U+FFFD. The
-- gate then hashed the REPLACED text: two different leaking lines collapse to
-- one fingerprint, so pardoning one silently pardons the other. No amount of
-- care downstream can undo it — the distinguishing bytes are already gone —
-- so the only honest answer is to refuse at the point of decode.
$r = newrepo("t28")
write_file($r .. "/lossy.txt",
  freeze(buffer(["peer ", $IP, " ", 0x80, "\n"])))
$unused = commit($r, "t28")
$g = gate(["--tree", $r])
$f = $f + ok("T28 lossily-decoded git output is refused, not fingerprinted",
  $g["code"] == 2 and contains($g["out"], "not valid UTF-8"),
  "" .. $g["code"] .. " " .. $g["out"])

-- T29 — a binary file whose PATH contains git's own diagnostic wording.
--
-- `git grep -z` prints binary matches as the bare prose line
-- `Binary file <path> matches`, with none of the NUL framing that makes text
-- records parseable. Reading the path back out of that prose is guesswork: a
-- file named `x matches\nb.bin` produced `Binary file x matches\nb.bin
-- matches\n`, the parser cut at the FIRST " matches\n", and the leftovers made
-- the whole stream unparseable — a real leak reported as exit 2.
--
-- The fix is not a better parser; the bytes are genuinely ambiguous. Two
-- passes per rule remove the ambiguity at source: `-I` suppresses binary
-- diagnostics entirely (so the text stream is strictly path\0line\0text\n),
-- and `-l -z` names every matching path NUL-separated. Binary matches are the
-- set difference, and their paths come from git's machine format, not prose.
$r = newrepo("t29")
write_file($r .. "/x matches\nb.bin", "\u{0}\u{1}peer " .. $IP .. "\u{0}\n")
$unused = commit($r, "t29")
$g = gate(["--tree", $r, "--print-fingerprints"])
$f = $f + ok("T29a a binary path shaped like a diagnostic is still a violation",
  $g["code"] == 1, "" .. $g["code"] .. " " .. $g["out"])
$f = $f + ok("T29b reported at its true path, not the prose-parsed prefix",
  contains($g["out"], "x matches\nb.bin"), $g["out"])

-- T30 — a superproject carrying a submodule, with `submodule.recurse = true`.
--
-- This probe asserted exit 0 until round thirty, and the expectation was
-- retired deliberately rather than repaired. Its original subject: the config
-- is a user-level preference (it exists to make checkout/pull/grep recurse by
-- default), so a repo the gate scans can acquire it without the gate changing
-- at all; git grep then reported hits at `sub/<path>`, which is not in the
-- superproject's tree, and the scope check called that a parse failure and
-- exited 2 on an otherwise clean repo. The flag is still pinned off in the
-- gate for that reason.
--
-- What changed is the verdict, not the order of work. A gitlink is a pointer
-- to a repository whose content this scan never reads, so "clean" over a
-- superproject was a verdict about a hole — the loudest kind of false
-- assurance this gate can give. Gitlink-bearing trees are now refused at 2
-- (T124).
--
-- Be precise about where that refusal happens, because round thirty-one's
-- review caught this comment overstating it: scan() runs every rule's grep
-- FIRST and only then calls scan_symlinks(), which is where gitlinks are
-- collected and the refusal is raised. So `--no-recurse-submodules` is still
-- load-bearing — remove it and the grep still recurses, exactly as it used to
-- — but its effect is no longer observable in the exit code, because the
-- refusal that follows returns 2 whatever the grep found. The pin is therefore
-- REACHABLE BUT UNTESTED: this probe would pass with it deleted. That is the
-- coverage loss, stated as what it actually is rather than as unreachability.
-- The alternative — scanning through the parent — double-reports the submodule
-- and mislabels its paths, which is what the per-repository config entry
-- exists to avoid.
--
-- So what is asserted here now is the refusal, and that it names the gitlink
-- by its path in the superproject.
$p30a = newrepo("t30-inner")
write_file($p30a .. "/inner.txt", "peer " .. $IP .. "\n")
$unused = commit($p30a, "t30 inner")
$r = newrepo("t30")
write_file($r .. "/ok.txt", "harmless\n")
$unused = commit($r, "t30")
$y = must($r, ["git", "-c", "protocol.file.allow=always", "submodule", "add",
  "-q", $p30a, "sub"])
$unused = commit($r, "t30 add sub")
$y = must($r, ["git", "config", "submodule.recurse", "true"])
$g = gate(["--tree", $r])
$gi = gate(["--index", $r])
$f = $f + ok("T30a a superproject is refused at its gitlink, not scanned around it",
  $g["code"] == 2 and contains($g["out"], "sub"),
  "" .. $g["code"] .. " " .. $g["out"])
$f = $f + ok("T30b same for an index scan",
  $gi["code"] == 2 and contains($gi["out"], "sub"),
  "" .. $gi["code"] .. " " .. $gi["out"])

-- T31 — --all stops at the first exit 2, and must say so.
--
-- The stop is deliberate: exit 2 means "could not check", and most of its
-- causes are not repo-local, so carrying on and printing "scanned 3 repo(s)"
-- would dress a partial audit as coverage. But a bare refusal naming neither
-- the repo it happened in nor the repos it never reached is unactionable —
-- and worse, a leak sitting in a later repo (here, repo B) goes unmentioned
-- while the run still looks like it examined everything.
$p31a = newrepo("t31-a")
write_file($p31a .. "/ok.txt", "harmless\n")
$unused = commit($p31a, "t31 a")
$tree31 = trim(must($p31a, ["git", "rev-parse", "HEAD^{tree}"]))
$y = must($p31a, ["git", "tag", "treetag", $tree31])
$p31b = newrepo("t31-b")
write_file($p31b .. "/leak.txt", "peer " .. $IP .. "\n")
$unused = commit($p31b, "t31 b")
$conf31 = $ROOT .. "/t31.conf.mix"
write_file($conf31, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $p31a .. "\", \"" .. $p31b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate31 = $ROOT .. "/gate-t31.mix"
write_file($gate31, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf31 .. "\""))
$r31 = run_argv([$MIX, $gate31, "--all"], {timeout: 600})
$out31 = $r31["stdout"] .. $r31["stderr"]
$f = $f + ok("T31a --all refuses rather than reporting a partial audit",
  $r31["exit_code"] == 2, "" .. $r31["exit_code"] .. " " .. $out31)
$f = $f + ok("T31b naming the repo it stopped in",
  contains($out31, $p31a), $out31)
$f = $f + ok("T31c and saying the rest went unscanned",
  contains($out31, "NOT scanned"), $out31)

-- T32 — a commit message that is not valid UTF-8 is a refusal, not a verdict.
--
-- `read_file` raises on undecodable bytes and an uncaught Mix error exits 1 —
-- the code this tool reserves for "found a violation". The commit-msg hook
-- would have blocked the commit with a traceback and the wrong verdict, which
-- is the same exit-1-vs-exit-2 confusion the config loader already guards
-- against. Found by asking where else bytes reach the gate after T28 fixed the
-- git path.
$r = newrepo("t32")
write_file($r .. "/ok.txt", "harmless\n")
$unused = commit($r, "t32")
$msg32 = $ROOT .. "/t32.msg"
write_file($msg32, freeze(buffer(["ship it ", 0x80, "\n"])))
$g = gate(["--message", $r, $msg32])
$f = $f + ok("T32 an undecodable commit message exits 2, not 1",
  $g["code"] == 2 and contains($g["out"], "cannot read message file"),
  "" .. $g["code"] .. " " .. $g["out"])

-- T33 — `grep.column` is the operator's, the record shape is not.
--
-- With grep.column=true git emits `path\0line\0col\0text\n` and the -z parser,
-- which knows three fields, refused the whole stream: a real leak reported as
-- exit 2 "unparseable" instead of exit 1 "violation". Safe-failing, and still
-- wrong — the operator gets an infrastructure error for a leak they could have
-- fixed. Pinned with --no-column; --no-full-name and --no-recurse-submodules
-- are the same class of config and pinned alongside it.
$r = newrepo("t33")
must($r, ["git", "config", "grep.column", "true"])
write_file($r .. "/leak.txt", "peer " .. $IP .. "\n")
$unused = commit($r, "t33 leak")
$g = gate(["--tree", $r])
$f = $f + ok("T33 grep.column cannot turn a leak into an unparseable stream",
  $g["code"] == 1 and contains($g["out"], "leak.txt"),
  "" .. $g["code"] .. " " .. $g["out"])

-- T34 — the scan reads a frozen object, never a moving one.
--
-- The index used to be scanned live (`git grep --cached`), and the two passes
-- per rule are two separate invocations. A BINARY leak is invisible to the -I
-- text pass by design, so swapping the staged blob for a clean one between the
-- passes left both empty: the gate reported clean and the leak was still in the
-- index when it finished. Git lets a pre-commit hook mutate the index, so this
-- is reachable, not theoretical.
--
-- The probe shims `git` onto PATH ahead of the real one, swaps the staged blob
-- the moment the gate's first grep returns, and puts the leak BACK before the
-- closing write-tree. The restore is the point: swap-and-restore is the attack
-- the freeze exists to defeat, and it is also what keeps this probe testing the
-- freeze rather than the index-moved refusal T37 covers — the two snapshots
-- match, so nothing bails, and the only thing that can still catch the leak is
-- the frozen tree the -l pass read. Verified to exit 0 "clean" against the
-- pre-fix gate, and 1 against this one.
$r = newrepo("t34")
$root34 = $ROOT .. "/t34-aux"
mkdir($root34)
write_file($r .. "/leak.bin", "\u{0}\u{0}peer " .. $IP .. "\n\u{0}")
must($r, ["git", "add", "leak.bin"])
$leak34 = trim(must($r, ["git", "rev-parse", ":leak.bin"]))
write_file($root34 .. "/clean.bin", "\u{0}\u{0}nothing to see\n\u{0}")
$clean34 = trim(must($r, ["git", "hash-object", "-w", $root34 .. "/clean.bin"]))
$shim34 = $root34 .. "/shim"
mkdir($shim34)
$mark34 = $root34 .. "/fired"
$back34 = $root34 .. "/restored"
write_file($shim34 .. "/git", join([
  "#!/opt/cosmix/bin/mix",
  "$a = args()",
  "-- Restore BEFORE running, so the gate's closing write-tree freezes the",
  "-- original index and the two snapshots agree.",
  "if contains($a, \"write-tree\") and exists(\"" .. $mark34
    .. "\") and exists(\"" .. $back34 .. "\") == false then",
  "  write_file(\"" .. $back34 .. "\", \"1\")",
  "  $b = run_argv([\"/usr/bin/git\", \"-C\", \"" .. $r .. "\", \"update-index\",",
  "    \"--cacheinfo\", \"100644," .. $leak34 .. ",leak.bin\"], {timeout: 60})",
  "  if $b[\"ok\"] != true then",
  "    eprint(\"shim: could not restore the staged blob\")",
  "    exit(96)",
  "  end",
  "end",
  "$o = {timeout: 600, max_output: 67108864}",
  "-- A wrapper that drops stdin is not a faithful wrapper. The gate feeds",
  "-- `check-attr --stdin -z` its path list that way, and an empty list comes",
  "-- back as an empty answer — which the gate correctly refuses as truncated,",
  "-- turning this probe into a test of the shim rather than of the freeze.",
  "-- run_argv closes stdin by default, so the read only happens for the one",
  "-- command that asked for it.",
  "if contains($a, \"--stdin\") then",
  "  $o[\"stdin\"] = read_stdin()",
  "end",
  "$r = run_argv(concat([\"/usr/bin/git\"], $a), $o)",
  "if $r[\"utf8_lossy\"] then",
  "  eprint(\"shim: lossy git output — the probe cannot be trusted\")",
  "  exit(99)",
  "end",
  "printf(\"%s\", $r[\"stdout\"])",
  "eprintf(\"%s\", $r[\"stderr\"])",
  "if contains($a, \"grep\") and exists(\"" .. $mark34 .. "\") == false then",
  "  write_file(\"" .. $mark34 .. "\", \"1\")",
  "  $m = run_argv([\"/usr/bin/git\", \"-C\", \"" .. $r .. "\", \"update-index\",",
  "    \"--cacheinfo\", \"100644," .. $clean34 .. ",leak.bin\"], {timeout: 60})",
  "  if $m[\"ok\"] != true then",
  "    eprint(\"shim: could not swap the staged blob\")",
  "    exit(98)",
  "  end",
  "end",
  "$c = $r[\"exit_code\"]",
  "if $c == nil then",
  "  $c = 97",
  "end",
  "exit($c)",
  ""
], "\n"))
chmod($shim34 .. "/git", 0o755)
$r34 = run_argv([$MIX, $GATE, "--index", $r],
  {timeout: 900, max_output: 33554432, env: {PATH: $shim34 .. ":" .. env("PATH")}})
$out34 = $r34["stdout"] .. $r34["stderr"]
must($r, ["git", "update-index", "--cacheinfo", "100644," .. $leak34 .. ",leak.bin"])
$f = $f + ok("T34a the shim really did move the index mid-scan and put it back",
  exists($mark34) and exists($back34),
  "shim never fired or never restored — the probe proved nothing")
$f = $f + ok("T34b an index edit between the two passes cannot hide a leak",
  $r34["exit_code"] == 1 and contains($out34, "leak.bin"),
  "" .. $r34["exit_code"] .. " " .. $out34)

-- T35 — a ref name that is not UTF-8 must not disarm pre-push.
--
-- Git ref names are bytes; everything outside a short forbidden set is legal.
-- Mix's read_stdin() used to swallow the decode error and return "", which is
-- indistinguishable from "nothing was pushed", so the hook iterated zero refs
-- and exited 0 WITHOUT RUNNING THE GATE. Fixed in the binary (mix 0.33.0
-- raises) plus a catch in the hook so the refusal is exit 2, not the exit 1
-- that means "found a leak". Verified rc=0 against the pre-fix binary.
$r = newrepo("t35")
$dest35 = bare("t35-dest")
write_file($r .. "/leak.txt", "peer " .. $IP .. "\n")
$sha35 = commit($r, "t35 leak")
$bad35 = $ROOT .. "/t35.stdin"
$bad35_bytes = freeze(buffer(["refs/heads/b", 0x80, " ", $sha35,
  " refs/heads/b", 0x80, " ", $ZERO, "\n"]))
write_file($bad35, $bad35_bytes)
$r35 = run_argv([$MIX, $HOOK, "pre-push", $dest35, $dest35],
  {cwd: $r, stdin: $bad35_bytes, timeout: 900})
$f = $f + ok("T35 an undecodable pre-push ref list refuses instead of passing",
  $r35["exit_code"] == 2 and contains($r35["stdout"] .. $r35["stderr"], "ref list"),
  "" .. $r35["exit_code"] .. " " .. $r35["stdout"] .. $r35["stderr"])

-- T36 — an object id names an object, not the bytes in it.
--
-- `git replace` is enabled by default for grep, ls-tree, cat-file and rev-list.
-- Point refs/replace/<leaking-tree> at a clean tree and every read the gate
-- makes returns the clean content, while a push sends the real object and
-- leaves the replacement ref at home. Freezing the id (round six) did nothing
-- about this: the id was stable and wrong. Verified exit 0 against the pre-fix
-- gate, 1 against this one.
$r = newrepo("t36")
write_file($r .. "/leak.txt", "peer " .. $IP .. "\n")
must($r, ["git", "add", "leak.txt"])
$leaktree36 = trim(must($r, ["git", "write-tree"]))
must($r, ["git", "rm", "-q", "--cached", "leak.txt"])
write_file($r .. "/clean.txt", "nothing to see\n")
must($r, ["git", "add", "clean.txt"])
$cleantree36 = trim(must($r, ["git", "write-tree"]))
must($r, ["git", "update-ref", "refs/replace/" .. $leaktree36, $cleantree36])
must($r, ["git", "rm", "-q", "--cached", "clean.txt"])
must($r, ["git", "add", "leak.txt"])
-- The premise, asserted rather than assumed: an UNPINNED git really does hand
-- back the clean tree for the leaking id here. Without this the probe passes
-- whenever replacement happens to be inactive — an ambient
-- GIT_NO_REPLACE_OBJECTS in the runner's environment, say — and would keep
-- passing if git_argv() dropped the flag tomorrow.
$laundered36 = run_argv(["git", "-C", $r, "ls-tree", "--name-only", $leaktree36],
  {timeout: 60})
$f = $f + ok("T36pre an unpinned git really is laundering the leaking tree",
  contains($laundered36["stdout"], "clean.txt")
    and contains($laundered36["stdout"], "leak.txt") == false,
  "replacement was not active, so T36a/b prove nothing: "
    .. $laundered36["stdout"])
$g36 = gate(["--index", $r])
$f = $f + ok("T36a a replaced tree cannot launder the staged index",
  $g36["code"] == 1 and contains($g36["out"], "leak.txt"),
  "" .. $g36["code"] .. " " .. $g36["out"])
-- Same trick against a named ref, so the --tree path is covered too.
$sha36 = commit($r, "t36 leak")
$ctree36 = trim(must($r, ["git", "rev-parse", "HEAD^{tree}"]))
must($r, ["git", "update-ref", "refs/replace/" .. $ctree36, $cleantree36])
$g36b = gate(["--tree", $r, "HEAD"])
$f = $f + ok("T36b nor a replaced tree behind a named revision",
  $g36b["code"] == 1 and contains($g36b["out"], "leak.txt"),
  "" .. $g36b["code"] .. " " .. $g36b["out"])

-- T37 — the frozen snapshot must be the index that is still staged at the end.
--
-- T34 covers leak-then-clean: the snapshot holds the leak, so the swap cannot
-- hide it. This is the other direction, and it is the one that commits: stage
-- CLEAN, let write-tree freeze that, then stage the leak while the scan runs.
-- Every pass reads the stale clean tree, the gate says clean, and git commits
-- the leak. Reproduced against the pre-fix gate at exit 0 followed by a
-- successful commit; now the post-scan re-freeze catches the move and exits 2.
$r = newrepo("t37")
$root37 = $ROOT .. "/t37-aux"
mkdir($root37)
write_file($r .. "/f.txt", "nothing to see\n")
must($r, ["git", "add", "f.txt"])
write_file($root37 .. "/leak", "peer " .. $IP .. "\n")
$leakblob37 = trim(must($r, ["git", "hash-object", "-w", $root37 .. "/leak"]))
$shim37 = $root37 .. "/shim"
mkdir($shim37)
$mark37 = $root37 .. "/fired"
write_file($shim37 .. "/git", join([
  "#!/opt/cosmix/bin/mix",
  "$a = args()",
  "$o = {timeout: 600, max_output: 67108864}",
  "-- A wrapper that drops stdin is not a faithful wrapper. The gate feeds",
  "-- `check-attr --stdin -z` its path list that way, and an empty list comes",
  "-- back as an empty answer — which the gate correctly refuses as truncated,",
  "-- turning this probe into a test of the shim rather than of the freeze.",
  "-- run_argv closes stdin by default, so the read only happens for the one",
  "-- command that asked for it.",
  "if contains($a, \"--stdin\") then",
  "  $o[\"stdin\"] = read_stdin()",
  "end",
  "$r = run_argv(concat([\"/usr/bin/git\"], $a), $o)",
  "if $r[\"utf8_lossy\"] then",
  "  eprint(\"shim: lossy git output — the probe cannot be trusted\")",
  "  exit(99)",
  "end",
  "printf(\"%s\", $r[\"stdout\"])",
  "eprintf(\"%s\", $r[\"stderr\"])",
  "if contains($a, \"grep\") and exists(\"" .. $mark37 .. "\") == false then",
  "  write_file(\"" .. $mark37 .. "\", \"1\")",
  "  $m = run_argv([\"/usr/bin/git\", \"-C\", \"" .. $r .. "\", \"update-index\",",
  "    \"--cacheinfo\", \"100644," .. $leakblob37 .. ",f.txt\"], {timeout: 60})",
  "  if $m[\"ok\"] != true then",
  "    eprint(\"shim: could not stage the leak\")",
  "    exit(98)",
  "  end",
  "end",
  "$c = $r[\"exit_code\"]",
  "if $c == nil then",
  "  $c = 97",
  "end",
  "exit($c)",
  ""
], "\n"))
chmod($shim37 .. "/git", 0o755)
$r37 = run_argv([$MIX, $GATE, "--index", $r],
  {timeout: 900, max_output: 33554432, env: {PATH: $shim37 .. ":" .. env("PATH")}})
$out37 = $r37["stdout"] .. $r37["stderr"]
$staged37 = trim(must($r, ["git", "rev-parse", ":f.txt"]))
$f = $f + ok("T37a the shim really did stage the leak mid-scan",
  exists($mark37) and $staged37 == $leakblob37,
  "shim never fired or did not stick — the probe proved nothing")
$f = $f + ok("T37b an index that moves under the scan is refused, not passed",
  $r37["exit_code"] == 2 and contains($out37, "changed while it was being scanned"),
  "" .. $r37["exit_code"] .. " " .. $out37)

-- T38 — GIT_DIR beats `git -C`, so an ambient one must stop the scan.
--
-- `GIT_DIR=other git -C repo grep …` reads *other*. Left inherited, a
-- three-repo --all becomes three scans of one foreign repo, reported under
-- bus/cos/mix paths: clean if that repo is clean, misattributed if it is not.
-- Reachable from `git rebase --exec`, `git bisect run`, `git filter-branch`,
-- `git submodule foreach` — all of which export it. Git does NOT set it for
-- pre-commit/commit-msg/pre-push (checked), so refusing costs the hooks
-- nothing. Verified: the pre-fix gate reported the decoy's content.
$r = newrepo("t38")
$decoy38 = newrepo("t38-decoy")
write_file($r .. "/leak.txt", "peer " .. $IP .. "\n")
must($r, ["git", "add", "leak.txt"])
write_file($decoy38 .. "/ok.txt", "nothing to see\n")
must($decoy38, ["git", "add", "ok.txt"])
$r38 = run_argv([$MIX, $GATE, "--index", $r],
  {timeout: 600, max_output: 33554432, env: {GIT_DIR: $decoy38 .. "/.git"}})
$f = $f + ok("T38a an inherited GIT_DIR is refused, not silently obeyed",
  $r38["exit_code"] == 2
    and contains($r38["stdout"] .. $r38["stderr"], "GIT_DIR is set"),
  "" .. $r38["exit_code"] .. " " .. $r38["stdout"] .. $r38["stderr"])
-- Every name in the list, not a sample of two: deleting one from the gate left
-- the old probe green while that variable still redirected the scan.
$missed38 = []
-- The GIT_CONFIG_* three joined the list in round nine: process-local config
-- reaches core.hooksPath and much else without touching a config file.
-- GIT_CONFIG_PARAMETERS is deliberately NOT here — git sets it itself whenever
-- anyone runs `git -c foo=bar commit`, so refusing it would refuse a legitimate
-- commit. (Measured 2026-07-25: `-c` sets PARAMETERS, never COUNT.)
for each $var38 in ["GIT_DIR", "GIT_COMMON_DIR", "GIT_WORK_TREE",
  "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES",
  "GIT_SHALLOW_FILE", "GIT_GRAFT_FILE",
  "GIT_CONFIG_COUNT", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM"]
  -- Map-literal keys are identifiers, not expressions, so the one-variable
  -- environment has to be built by assignment.
  $env38 = {}
  $env38[$var38] = $decoy38 .. "/.git"
  $one38 = run_argv([$MIX, $GATE, "--index", $r],
    {timeout: 600, max_output: 33554432, env: $env38})
  $said38 = contains($one38["stdout"] .. $one38["stderr"], $var38 .. " is set")
  if $one38["exit_code"] != 2 or $said38 == false then
    push($missed38, $var38 .. "(" .. $one38["exit_code"] .. ")")
  end
end
$f = $f + ok("T38b every name in the refusal list is actually refused",
  len($missed38) == 0, join($missed38, " "))

-- T38c — GIT_SHALLOW_FILE and GIT_GRAFT_FILE do not redirect the repo; they
-- rewrite what history IS. Either one can declare the clean tip parentless, so
-- rev-list never reaches the leaking ancestor and --range reports clean over
-- content the push publishes. Measured against the pre-fix gate: plain exit 1,
-- grafted exit 0, same repo, same range.
$r38c = newrepo("t38c")
write_file($r38c .. "/leak.txt", "peer " .. $IP .. "\n")
$base38 = commit($r38c, "leaking base")
must($r38c, ["git", "rm", "-q", "leak.txt"])
write_file($r38c .. "/clean.txt", "nothing to see\n")
$tip38 = commit($r38c, "clean tip")
$graft38 = $ROOT .. "/t38c-grafts"
write_file($graft38, $tip38 .. "\n")
$plain38 = gate(["--range", $r38c, $tip38])
$g38c = run_argv([$MIX, $GATE, "--range", $r38c, $tip38],
  {timeout: 600, max_output: 33554432, env: {GIT_GRAFT_FILE: $graft38}})
$f = $f + ok("T38c a graft file cannot amputate the leaking ancestor",
  $plain38["code"] == 1 and $g38c["exit_code"] == 2
    and contains($g38c["stdout"] .. $g38c["stderr"], "GIT_GRAFT_FILE is set"),
  "plain=" .. $plain38["code"] .. " grafted=" .. $g38c["exit_code"] .. " "
    .. $g38c["stdout"] .. $g38c["stderr"])

-- T38d — GIT_INDEX_FILE is the one that cannot simply be banned: git sets it
-- for pre-commit, and for a partial commit it names a temporary index that is
-- the only correct thing to scan. So it is refused for a hand-run --index and
-- honoured under --from-hook. Both halves are load-bearing: refuse it always
-- and every partial commit goes unscanned; allow it always and an ambient one
-- points the scan at an index nobody is committing.
--
-- Including the empty case. `GIT_INDEX_FILE=` makes git read an EMPTY index —
-- the gate scans nothing and says clean — and env() reports it identically to
-- unset, which is why the check reads /proc/self/environ.
$r38d = newrepo("t38d")
write_file($r38d .. "/clean.txt", "nothing to see\n")
must($r38d, ["git", "add", "clean.txt"])
-- A real index file holding only clean content, saved before the leak is
-- staged: exactly what an ambient GIT_INDEX_FILE would point the scan at.
$clean38 = $ROOT .. "/t38d-clean-index"
$cp38 = run_argv(["cp", $r38d .. "/.git/index", $clean38], {timeout: 60})
write_file($r38d .. "/leak.txt", "peer " .. $IP .. "\n")
must($r38d, ["git", "add", "leak.txt"])
$hand38 = run_argv([$MIX, $GATE, "--index", $r38d],
  {timeout: 600, max_output: 33554432, env: {GIT_INDEX_FILE: $clean38}})
$empty38 = run_argv([$MIX, $GATE, "--index", $r38d],
  {timeout: 600, max_output: 33554432, env: {GIT_INDEX_FILE: ""}})
$hook38 = run_argv([$MIX, $GATE, "--index", $r38d, "--from-hook"],
  {timeout: 600, max_output: 33554432})
$f = $f + ok("T38d a hand-run --index refuses an inherited GIT_INDEX_FILE",
  $cp38["ok"] and $hand38["exit_code"] == 2
    and contains($hand38["stdout"] .. $hand38["stderr"], "GIT_INDEX_FILE is set"),
  "" .. $hand38["exit_code"] .. " " .. $hand38["stdout"] .. $hand38["stderr"])
$f = $f + ok("T38e including an empty one, which git reads as an empty index",
  $empty38["exit_code"] == 2
    and contains($empty38["stdout"] .. $empty38["stderr"], "GIT_INDEX_FILE is set"),
  "" .. $empty38["exit_code"] .. " " .. $empty38["stdout"] .. $empty38["stderr"])
$f = $f + ok("T38f but --from-hook still scans the index git chose",
  $hook38["exit_code"] == 1 and contains($hook38["stdout"], "leak.txt"),
  "" .. $hook38["exit_code"] .. " " .. $hook38["stdout"] .. $hook38["stderr"])

-- T38g — the installer obeys GIT_DIR too, and its failure is quieter than the
-- gate's: it writes every hook into the ambient repo, prints the configured
-- repos beside "installed pre-commit", exits 0, and leaves them unguarded.
-- Run against the REAL configured repos on purpose, and safely: with GIT_DIR
-- set, hooks_dir() resolves to the decoy for every one of them, so neither the
-- fixed installer (which bails first) nor a regressed one can touch bus/cos/mix
-- — a regression writes into the decoy, which is exactly what this asserts did
-- not happen.
$d38g = newrepo("t38g-decoy")
$i38 = run_installer([$MIX, $INSTALL],
  {timeout: 300, max_output: 33554432, env: {GIT_DIR: $d38g .. "/.git"}})
$f = $f + ok("T38g the installer refuses an ambient GIT_DIR instead of misinstalling",
  $i38["exit_code"] == 2
    and exists($d38g .. "/.git/hooks/pre-commit") == false,
  "" .. $i38["exit_code"] .. " decoy_written="
    .. exists($d38g .. "/.git/hooks/pre-commit") .. " " .. $i38["stdout"] .. $i38["stderr"])

-- T39 — pre-push's stdin refusal is only real on a Mix that raises.
--
-- Before 0.33.0 read_stdin() returned "" on invalid UTF-8 and the hook read
-- that as "nothing pushed" — exit 0, gate never invoked. That is fixed in the
-- binary, so the hook now checks the binary rather than assuming it, and a
-- downgrade of /opt/cosmix/bin/mix has to break the hook loudly. The probe
-- rewrites $MIX in a copy of the hook to a stub that reports an old version,
-- which exercises the real comparison in the real file.
$r = newrepo("t39")
$root39 = $ROOT .. "/t39-aux"
mkdir($root39)
$dest39 = bare("t39-dest")
write_file($r .. "/f.txt", "nothing to see\n")
$sha39 = commit($r, "t39")
-- The check is a BEHAVIOUR probe, not a version comparison, and the stub is
-- built to tell the two apart: it reports a CURRENT version while behaving like
-- an old one (read_stdin() returns instead of raising). A version comparison
-- waves that through — which is the point, because a version string is a claim
-- ABOUT behaviour and this is the behaviour. The same rewrite also stops
-- refusing a real Mix built as 0.34.0-rc.1, which the comparison rejected.
$fakemix39 = $root39 .. "/mix-no-raise"
write_file($fakemix39, join([
  "#!/opt/cosmix/bin/mix",
  "$a = args()",
  "if len($a) == 2 and $a[0] == \"-c\" and contains($a[1], \"read_stdin\") then",
  "  print(\"RETURNED 0\")",
  "  exit(0)",
  "end",
  "if len($a) == 1 and $a[0] == \"--version\" then",
  "  print(\"mix 9.99.0\")",
  "  exit(0)",
  "end",
  "exit(run_stream(concat([\"/opt/cosmix/bin/mix\"], $a)))",
  ""
], "\n"))
chmod($fakemix39, 0o755)
$hook39 = $root39 .. "/hygiene-hook.mix"
write_file($hook39, must_replace(read_file($HOOK),
  "$MIX = \"/opt/cosmix/bin/mix\"", "$MIX = \"" .. $fakemix39 .. "\""))
$r39 = run_argv([$MIX, $hook39, "pre-push", $dest39, $dest39],
  {cwd: $r, timeout: 900,
   stdin: "refs/heads/main " .. $sha39 .. " refs/heads/main " .. $ZERO .. "\n"})
$f = $f + ok("T39a a Mix that returns instead of raising disarms nothing — it refuses",
  $r39["exit_code"] == 2
    and contains($r39["stdout"] .. $r39["stderr"], "returns instead of raising"),
  "" .. $r39["exit_code"] .. " " .. $r39["stdout"] .. $r39["stderr"])
-- The other half: the real binary must PASS its own probe, or the check is a
-- blanket refusal that would pass this suite while blocking every push.
$r39b = push_ref($r, $dest39, "refs/heads/main", $sha39)
$f = $f + ok("T39b and the real interpreter passes the same probe",
  $r39b["exit_code"] == 0,
  "" .. $r39b["exit_code"] .. " " .. $r39b["stdout"] .. $r39b["stderr"])

-- T39c — a pushed-ref record that is not git's four fields is refused, not
-- skipped. Skipping is the same failure shape as the undecodable-stdin one: the
-- ref goes unscanned and the hook still exits 0.
$r39c = run_argv([$MIX, $HOOK, "pre-push", $dest39, $dest39],
  {cwd: $r, timeout: 900,
   stdin: "refs/heads/main " .. $sha39 .. " refs/heads/main\n"})
$f = $f + ok("T39c a truncated pushed-ref record refuses instead of skipping it",
  $r39c["exit_code"] == 2
    and contains($r39c["stdout"] .. $r39c["stderr"], "cannot parse a pushed-ref record"),
  "" .. $r39c["exit_code"] .. " " .. $r39c["stdout"] .. $r39c["stderr"])

-- T40 — the hook's presence probe and the gate's scan must agree about which
-- objects this clone actually has.
--
-- `remote_haves` asks `cat-file --batch-check` whether the clone holds each sha
-- the destination advertises, and every "yes" becomes a `^sha` exclusion for the
-- gate's rev-list. A replace ref for an ABSENT sha makes --batch-check answer
-- "blob 2" (git resolves the replacement and never notices the original is
-- gone), so the hook hands the gate an exclusion the gate cannot honour — its
-- rev-list runs --no-replace-objects and dies on the bad object. A clean push is
-- refused as infrastructure. Fails closed, so this was never a hole; the probe
-- exists because a presence probe that disagrees with the scan it bounds is a
-- bug either way, and the next such disagreement may not fail closed.
$r = newrepo("t40")
$dest40 = bare("t40-dest")
-- Give the destination a commit this clone has never seen, so it advertises a
-- sha that is genuinely absent here.
$other40 = newrepo("t40-other")
write_file($other40 .. "/o.txt", "unrelated\n")
$osha40 = commit($other40, "t40 other")
must($other40, ["git", "push", "-q", $dest40, "HEAD:refs/heads/other"])
write_file($r .. "/f.txt", "nothing to see\n")
$sha40 = commit($r, "t40")
$blob40 = trim(must($r, ["git", "hash-object", "-w", $r .. "/f.txt"]))
must($r, ["git", "update-ref", "refs/replace/" .. $osha40, $blob40])
$absent40 = run_argv(["git", "-C", $r, "--no-replace-objects", "cat-file", "-e",
  $osha40], {timeout: 60})
$f = $f + ok("T40a the destination really does advertise a sha this clone lacks",
  contains(must($r, ["git", "ls-remote", "--heads", $dest40]), $osha40)
    and $absent40["exit_code"] != 0,
  "the probe's premise did not hold")
$r40 = push_ref($r, $dest40, "refs/heads/main", $sha40)
$f = $f + ok("T40b a replace ref for an absent object does not break a clean push",
  $r40["exit_code"] == 0,
  "" .. $r40["exit_code"] .. " " .. $r40["stdout"] .. $r40["stderr"])

-- T41 — REAL commits through the installed hooks, in a plain checkout and in a
-- linked `git worktree`.
--
-- This is the probe the whole round-eight environment hardening needed and did
-- not have, and its absence cost the most: with the hooks installed, round
-- eight blocked EVERY commit in EVERY guarded repo. pre-commit passed (it was
-- the one call carrying --from-hook), and commit-msg then refused git's own
-- GIT_INDEX_FILE one moment later. The refusal was correct about the danger and
-- wrong about the caller.
--
-- The worktree half is the same mistake one layer down. Round eight refused
-- GIT_DIR unconditionally on the stated grounds that "git does not set it for
-- the hooks this gate runs under" — true in a plain checkout (measured: git
-- 2.55 sets GIT_INDEX_FILE and GIT_PREFIX, not GIT_DIR, with or without -C) and
-- false in a linked worktree, where git sets both. Parallel sessions here work
-- in worktrees.
--
-- Nothing short of a real commit finds either. Every round-eight probe called
-- the gate directly, so every one of them passed.
$r = newrepo("t41")
write_file($r .. "/seed.txt", "nothing to see\n")
$seed41 = commit($r, "seed")
for each $hn in ["pre-commit", "commit-msg", "pre-push"]
  $hp = $r .. "/.git/hooks/" .. $hn
  write_file($hp, join([
    "#!" .. $MIX,
    "exit(run_stream(concat([\"" .. $MIX .. "\", \"" .. $HOOK .. "\", \"" .. $hn
      .. "\"], args())))",
    ""
  ], "\n"))
  chmod($hp, 0o755)
end
-- Hooks are installed AFTER the seed commit on purpose: the probes below must
-- each fail on their own terms rather than starve a later one of a repo.
write_file($r .. "/main.txt", "clean\n")
must($r, ["git", "add", "-A"])
$c41 = run_argv(["git", "-C", $r, "commit", "-q", "-m", "from the main checkout"],
  {timeout: 1800})
$f = $f + ok("T41a a clean commit in a guarded repo is not blocked at all",
  $c41["exit_code"] == 0,
  "" .. $c41["exit_code"] .. " " .. sanitize($c41["stdout"] .. $c41["stderr"]))
$w41 = $ROOT .. "/t41-wt"
must($r, ["git", "worktree", "add", "-q", "-b", "wt", $w41, $seed41])
write_file($w41 .. "/a.txt", "clean\n")
must($w41, ["git", "add", "-A"])
$wc41 = run_argv(["git", "-C", $w41, "commit", "-q", "-m", "from the worktree"],
  {timeout: 1800})
$f = $f + ok("T41b nor one from a linked worktree, where git does set GIT_DIR",
  $wc41["exit_code"] == 0,
  "" .. $wc41["exit_code"] .. " " .. sanitize($wc41["stdout"] .. $wc41["stderr"]))
-- Both halves, always: an over-refusal and an under-refusal look identical from
-- one side.
write_file($w41 .. "/leak.txt", "peer " .. $IP .. "\n")
must($w41, ["git", "add", "leak.txt"])
$wl41 = run_argv(["git", "-C", $w41, "commit", "-q", "-m", "leaky"], {timeout: 1800})
$tip41 = trim(must($w41, ["git", "log", "--oneline", "-1"]))
-- "Non-zero" is not the property under test. A broken hook, a missing gate, a
-- Mix syntax error and an unreadable config all block the commit too, and any
-- of them would let this row pass while proving nothing about detection. So
-- the assertion names the gate's own verdict AND the rule that produced it
-- (round ten, finding 7).
$out41 = $wl41["stdout"] .. $wl41["stderr"]
$f = $f + ok("T41c but a leaking commit from that worktree still is",
  $wl41["exit_code"] != 0 and contains($tip41, "leaky") == false
    and contains($out41, "BLOCKED") and contains($out41, $IP_LABEL),
  "" .. $wl41["exit_code"] .. " tip=" .. sanitize($tip41)
    .. " out=" .. sanitize($out41))
must($w41, ["git", "rm", "-q", "-f", "--cached", "leak.txt"])
$rml41 = run_argv(["rm", "-f", $w41 .. "/leak.txt"], {timeout: 60})
$f = $f + ok("T41d premise: the leak is unstaged before the push probe",
  $rml41["ok"] == true, sanitize($rml41["stderr"]))
$dest41 = bare("t41-dest")
$wp41 = run_argv(["git", "-C", $w41, "push", "-q", $dest41, "HEAD:refs/heads/wt"],
  {timeout: 1800})
$f = $f + ok("T41e and pre-push from a worktree still completes",
  $wp41["exit_code"] == 0,
  "" .. $wp41["exit_code"] .. " " .. sanitize($wp41["stdout"] .. $wp41["stderr"]))

-- T42 — --from-hook must be a provenance CHECK, not a bypass flag. Anyone can
-- pass it; what they cannot do is make a foreign path look like this repo's
-- gitdir.
$foreign42 = $ROOT .. "/t42-clean.index"
write_file($foreign42, "")
$idx42 = run_argv([$MIX, $GATE, "--index", $w41, "--from-hook"],
  {timeout: 600, max_output: 33554432, env: {GIT_INDEX_FILE: $foreign42}})
$f = $f + ok("T42a --from-hook does not let a foreign index in",
  $idx42["exit_code"] == 2
    and contains($idx42["stdout"] .. $idx42["stderr"], "not inside the gitdir"),
  "" .. $idx42["exit_code"] .. " " .. sanitize($idx42["stdout"] .. $idx42["stderr"]))
$dir42 = run_argv([$MIX, $GATE, "--index", $w41, "--from-hook"],
  {timeout: 600, max_output: 33554432, env: {GIT_DIR: $r .. "/.git"}})
$f = $f + ok("T42b nor a foreign GIT_DIR, even the parent repo's own",
  $dir42["exit_code"] == 2
    and contains($dir42["stdout"] .. $dir42["stderr"], "is not the gitdir of"),
  "" .. $dir42["exit_code"] .. " " .. sanitize($dir42["stdout"] .. $dir42["stderr"]))
-- The false-alarm side: modes that never read an index must not care about one.
$tree42 = run_argv([$MIX, $GATE, "--tree", $r, "HEAD"],
  {timeout: 600, max_output: 33554432, env: {GIT_INDEX_FILE: $foreign42}})
$f = $f + ok("T42c and a mode that reads no index is unaffected by GIT_INDEX_FILE",
  $tree42["exit_code"] == 0,
  "" .. $tree42["exit_code"] .. " " .. sanitize($tree42["stdout"] .. $tree42["stderr"]))

-- T43 — the answer to "is this variable set?" comes from /proc/self/environ,
-- because env() cannot tell set-empty from unset. Where /proc is not readable
-- there is no honest answer, and an earlier version fell back to env() — which
-- reinstated the empty-index false clean on exactly the hosts that lack /proc.
-- Skipped rather than faked where bwrap is unavailable; a probe that cannot set
-- up its own premise must say so, not pass.
$r43 = newrepo("t43")
write_file($r43 .. "/leak.txt", "peer " .. $IP .. "\n")
must($r43, ["git", "add", "leak.txt"])
$bw43 = run_argv(["which", "bwrap"], {timeout: 60})
if $bw43["exit_code"] != 0 then
  print("SKIP  T43 (bwrap not installed — cannot mask /proc)")
else
  $m43 = run_argv(["bwrap", "--dev-bind", "/", "/", "--tmpfs", "/proc",
    $MIX, $GATE, "--index", $r43],
    {timeout: 600, max_output: 33554432, env: {GIT_INDEX_FILE: ""}})
  $f = $f + ok("T43 an unreadable /proc refuses rather than guessing from env()",
    $m43["exit_code"] == 2
      and contains($m43["stdout"] .. $m43["stderr"], "unknowable"),
    "" .. $m43["exit_code"] .. " " .. sanitize($m43["stdout"] .. $m43["stderr"]))
end

-- T44 — the environment is not required to be UTF-8. One raw 0x80 in an
-- unrelated variable made read_file raise, uncaught, exit 1 — which in this
-- gate's contract means "found a leak", reported over a clean tree.
--
-- The launcher is bash on purpose and it is not a workaround: Mix strings are
-- UTF-8 by construction, so a Mix parent CANNOT put a raw 0x80 in a child's
-- environment. Setting one is the probe's whole premise.
$sh44 = $ROOT .. "/t44-launch.sh"
write_file($sh44, join([
  "#!/bin/bash",
  "export T44_BAD=$(printf \"\\200\")",
  "exec " .. $MIX .. " \"$@\"",
  ""
], "\n"))
chmod($sh44, 0o755)
$pre44 = run_argv([$sh44, "-c", "print(\"ok\")"], {timeout: 60})
$f = $f + ok("T44a the launcher really does set a non-UTF-8 variable",
  $pre44["exit_code"] == 0,
  "launcher broken: " .. sanitize($pre44["stdout"] .. $pre44["stderr"]))
$r44 = run_argv([$sh44, $GATE, "--tree", $r, "HEAD"],
  {timeout: 900, max_output: 33554432})
$f = $f + ok("T44b a non-UTF-8 environment does not become an exit-1 violation",
  $r44["exit_code"] == 0,
  "" .. $r44["exit_code"] .. " " .. sanitize($r44["stdout"] .. $r44["stderr"]))

-- T45 — process-local git config sets core.hooksPath without touching a config
-- file, and the installer's target comes from `rev-parse --git-path hooks`.
-- Measured before the fix: exit 0, "hooks written: 9", all nine into one decoy,
-- the three real repos untouched and still reported as installed. Safe to run
-- against the real config for the same reason T38g is: every write is
-- redirected into the decoy either way.
$d45 = $ROOT .. "/t45-decoy"
mkdir($d45)
$i45 = run_installer([$MIX, $INSTALL],
  {timeout: 300, max_output: 33554432,
   env: {GIT_CONFIG_COUNT: "1", GIT_CONFIG_KEY_0: "core.hooksPath",
         GIT_CONFIG_VALUE_0: $d45}})
$f = $f + ok("T45 the installer refuses injected git config, not just GIT_DIR",
  $i45["exit_code"] == 2 and exists($d45 .. "/pre-commit") == false,
  "" .. $i45["exit_code"] .. " decoy_written="
    .. exists($d45 .. "/pre-commit") .. " " .. sanitize($i45["stdout"] .. $i45["stderr"]))

-- T46 — the ordinary shapes, each committed for real through installed hooks.
--
-- T41 proves the plain shape in a plain checkout and in a worktree. This is the
-- rest of what a contributor actually does, and it is here because round nine
-- established that the shape nobody commits through is the shape that breaks:
-- ninety probes calling the gate directly all passed over a gate that blocked
-- every commit in every guarded repo.
--
-- Each shape hands the hook a DIFFERENT GIT_INDEX_FILE — measured in a linked
-- worktree: plain gives <gitdir>/index, `-- path` gives next-index-<pid>.lock,
-- `-a` gives index.lock, and in a worktree <gitdir> is
-- <main>/.git/worktrees/<name>. The provenance check sees a new path for every
-- row, so a table it does not cover is a row that can silently start refusing.
fn hook_repo($name)
  $p = newrepo($name)
  write_file($p .. "/base.txt", "nothing to see\n")
  $sha = commit($p, "base")
  for each $hn in ["pre-commit", "commit-msg", "pre-push"]
    $hp = $p .. "/.git/hooks/" .. $hn
    write_file($hp, join([
      "#!" .. $MIX,
      "exit(run_stream(concat([\"" .. $MIX .. "\", \"" .. $HOOK .. "\", \""
        .. $hn .. "\"], args())))",
      ""
    ], "\n"))
    chmod($hp, 0o755)
  end
  return {path: $p, base: $sha}
end

fn shape($label, $want, $dir, $argv)
  $r = run_argv($argv, {cwd: $dir, timeout: 1800, max_output: 8388608})
  return ok($label, $r["exit_code"] == $want,
    "want=" .. $want .. " got=" .. $r["exit_code"] .. " "
      .. sanitize($r["stdout"] .. $r["stderr"]))
end

$h46 = hook_repo("t46")
$p46 = $h46["path"]
$w46 = $ROOT .. "/t46-wt"
must($p46, ["git", "worktree", "add", "-q", "-b", "wt", $w46, $h46["base"]])
-- Both checkouts, because only the worktree sets GIT_DIR and only the main one
-- gets the relative ".git/index" that has to be resolved against cwd.
for each $where46 in [{tag: "main checkout", dir: $p46}, {tag: "worktree", dir: $w46}]
  $d46 = $where46["dir"]
  $t46 = $where46["tag"]
  write_file($d46 .. "/one.txt", "clean\n")
  must($d46, ["git", "add", "one.txt"])
  $f = $f + shape("T46 plain commit (" .. $t46 .. ")", 0, $d46,
    ["git", "commit", "-q", "-m", "plain"])
  -- A partial commit with something else left staged: git builds a temporary
  -- index holding only the selected path, and scanning the wrong one is where
  -- this whole family of bugs began.
  write_file($d46 .. "/two.txt", "clean\n")
  write_file($d46 .. "/three.txt", "clean\n")
  must($d46, ["git", "add", "-A"])
  $f = $f + shape("T46 partial commit (" .. $t46 .. ")", 0, $d46,
    ["git", "commit", "-q", "-m", "partial", "--", "two.txt"])
  write_file($d46 .. "/base.txt", "still nothing to see\n")
  $f = $f + shape("T46 commit -a (" .. $t46 .. ")", 0, $d46,
    ["git", "commit", "-q", "-a", "-m", "dash-a"])
  $f = $f + shape("T46 amend (" .. $t46 .. ")", 0, $d46,
    ["git", "commit", "-q", "--amend", "--no-edit"])
  -- The leaking half of each shape, so an over-refusal and an under-detection
  -- cannot be mistaken for each other.
  write_file($d46 .. "/leak.txt", "peer " .. $IP .. "\n")
  write_file($d46 .. "/beside.txt", "clean\n")
  must($d46, ["git", "add", "-A"])
  $f = $f + shape("T46 a partial commit OF the leak is refused (" .. $t46 .. ")",
    1, $d46, ["git", "commit", "-q", "-m", "leak", "--", "leak.txt"])
  $f = $f + shape("T46 a clean partial commit beside it is not (" .. $t46 .. ")",
    0, $d46, ["git", "commit", "-q", "-m", "beside", "--", "beside.txt"])
  must($d46, ["git", "rm", "-q", "-f", "leak.txt"])
  -- From a subdirectory: git sets GIT_PREFIX and still runs the hook with cwd
  -- at the checkout root, which is what the relative index path resolves
  -- against.
  mkdir($d46 .. "/sub")
  write_file($d46 .. "/sub/deep.txt", "clean\n")
  must($d46 .. "/sub", ["git", "add", "deep.txt"])
  $f = $f + shape("T46 commit from a subdirectory (" .. $t46 .. ")", 0,
    $d46 .. "/sub", ["git", "commit", "-q", "-m", "from a subdir"])
  write_file($d46 .. "/sub/deepleak.txt", "peer " .. $IP .. "\n")
  must($d46 .. "/sub", ["git", "add", "deepleak.txt"])
  $f = $f + shape("T46 and a leak there is caught (" .. $t46 .. ")", 1,
    $d46 .. "/sub", ["git", "commit", "-q", "-m", "subdir leak"])
  must($d46 .. "/sub", ["git", "rm", "-q", "-f", "deepleak.txt"])
end
-- A merge commit reaches commit-msg with a message git wrote, not the user.
must($p46, ["git", "checkout", "-q", "-b", "side", $h46["base"]])
write_file($p46 .. "/side.txt", "clean\n")
$f = $f + ok("T46 premise: the side branch exists",
  commit($p46, "side work") != "", "")
must($p46, ["git", "checkout", "-q", "main"])
$f = $f + shape("T46 merge --no-ff", 0, $p46,
  ["git", "merge", "-q", "--no-ff", "-m", "merge side", "side"])
-- A separate branch for the cherry-pick: picking `side` after merging it is
-- an empty pick, which git refuses on its own account and which would measure
-- git rather than the gate.
must($p46, ["git", "checkout", "-q", "-b", "pick", $h46["base"]])
write_file($p46 .. "/pick.txt", "clean\n")
$f = $f + ok("T46 premise: the cherry-pick source exists",
  commit($p46, "work to pick") != "", "")
must($p46, ["git", "checkout", "-q", "main"])
$f = $f + shape("T46 cherry-pick", 0, $p46,
  ["git", "cherry-pick", "--no-edit", "pick"])
-- HEAD is now that cherry-pick, not the merge: reverting a merge needs -m and
-- would again be a probe of git's argument handling.
$f = $f + shape("T46 revert", 0, $p46, ["git", "revert", "--no-edit", "HEAD"])

-- T47 — push shapes. pre-push is the backstop for anything a local
-- --no-verify let through, so its shapes matter as much as pre-commit's; a
-- deletion in particular publishes no objects at all and must not be scanned
-- as though it did.
$d47 = bare("t47-dest")
$f = $f + shape("T47 push a new branch", 0, $p46,
  ["git", "push", "-q", $d47, "main:refs/heads/main"])
$f = $f + shape("T47 push again with nothing to do", 0, $p46,
  ["git", "push", "-q", $d47, "main:refs/heads/main"])
must($p46, ["git", "tag", "-a", "t47", "-m", "an annotated tag"])
$f = $f + shape("T47 push an annotated tag", 0, $p46,
  ["git", "push", "-q", $d47, "refs/tags/t47"])
$f = $f + shape("T47 push a second branch", 0, $p46,
  ["git", "push", "-q", $d47, "side:refs/heads/side"])
$f = $f + shape("T47 push a branch DELETION", 0, $p46,
  ["git", "push", "-q", $d47, ":refs/heads/side"])
$f = $f + shape("T47 push a tag DELETION", 0, $p46,
  ["git", "push", "-q", $d47, ":refs/tags/t47"])
-- Over a file:// URL and via a named remote: the hook is handed $1 as the
-- user spelled it, and a URL is not a remote name.
must($p46, ["git", "remote", "add", "origin", $d47])
$f = $f + shape("T47 push to a named remote", 0, $p46,
  ["git", "push", "-q", "origin", "main"])
$f = $f + shape("T47 push over a file:// URL", 0, $p46,
  ["git", "push", "-q", "file://" .. $d47, "main:refs/heads/main"])
-- And the backstop actually catching something, both spellings.
write_file($p46 .. "/sneak.txt", "peer " .. $IP .. "\n")
must($p46, ["git", "add", "sneak.txt"])
must($p46, ["git", "commit", "-q", "--no-verify", "-m", "bypassed locally"])
$f = $f + shape("T47 pre-push catches what --no-verify let in (named remote)",
  1, $p46, ["git", "push", "-q", "origin", "main"])
$f = $f + shape("T47 and over a file:// URL", 1, $p46,
  ["git", "push", "-q", "file://" .. $d47, "main:refs/heads/main"])

-- T48 — repo layouts that change where the hook lives or what history it can
-- see. Each of these was a plausible way for the gate to be absent, wrong, or
-- over-refusing without anything saying so.
$h48 = newrepo("t48-empty")
for each $hn48 in ["pre-commit", "commit-msg"]
  $hp48 = $h48 .. "/.git/hooks/" .. $hn48
  write_file($hp48, join([
    "#!" .. $MIX,
    "exit(run_stream(concat([\"" .. $MIX .. "\", \"" .. $HOOK .. "\", \""
      .. $hn48 .. "\"], args())))",
    ""
  ], "\n"))
  chmod($hp48, 0o755)
end
write_file($h48 .. "/first.txt", "clean\n")
must($h48, ["git", "add", "-A"])
$f = $f + shape("T48a the first-ever commit, with no HEAD to diff against", 0,
  $h48, ["git", "commit", "-q", "-m", "first"])
$h48b = newrepo("t48-empty-leak")
for each $hn48b in ["pre-commit", "commit-msg"]
  $hp48b = $h48b .. "/.git/hooks/" .. $hn48b
  write_file($hp48b, join([
    "#!" .. $MIX,
    "exit(run_stream(concat([\"" .. $MIX .. "\", \"" .. $HOOK .. "\", \""
      .. $hn48b .. "\"], args())))",
    ""
  ], "\n"))
  chmod($hp48b, 0o755)
end
write_file($h48b .. "/first.txt", "peer " .. $IP .. "\n")
must($h48b, ["git", "add", "-A"])
$f = $f + shape("T48b and a leaking first-ever commit is still caught", 1,
  $h48b, ["git", "commit", "-q", "-m", "first"])

-- A pre-existing foreign hook, chained by the installer as <hook>.pre-hygiene.
-- Preserving it is the reason the installer does not set core.hooksPath at all
-- (cos carries an indexd post-commit), so "preserved" has to mean "still runs
-- AND can still veto", not merely "still on disk".
$h48c = hook_repo("t48-chain")["path"]
$fh48 = $h48c .. "/.git/hooks/pre-commit.pre-hygiene"
write_file($fh48, "#!" .. $MIX .. "\nprint(\"foreign hook ran\")\nexit(0)\n")
chmod($fh48, 0o755)
write_file($h48c .. "/a.txt", "clean\n")
must($h48c, ["git", "add", "-A"])
$c48 = run_argv(["git", "commit", "-m", "with a chained hook"],
  {cwd: $h48c, timeout: 1800, max_output: 8388608})
$f = $f + ok("T48c a chained foreign hook runs and does not block a clean commit",
  $c48["exit_code"] == 0
    and contains($c48["stdout"] .. $c48["stderr"], "foreign hook ran"),
  "" .. $c48["exit_code"] .. " " .. sanitize($c48["stdout"] .. $c48["stderr"]))
write_file($fh48, "#!" .. $MIX .. "\nprint(\"foreign hook says no\")\nexit(7)\n")
chmod($fh48, 0o755)
write_file($h48c .. "/b.txt", "clean\n")
must($h48c, ["git", "add", "-A"])
$v48 = run_argv(["git", "commit", "-m", "foreign veto"],
  {cwd: $h48c, timeout: 1800, max_output: 8388608})
$tip48 = trim(must($h48c, ["git", "log", "--oneline", "-1"]))
$f = $f + ok("T48d and its veto still stops the commit",
  $v48["exit_code"] != 0 and contains($tip48, "foreign veto") == false,
  "" .. $v48["exit_code"] .. " tip=" .. sanitize($tip48))

-- core.hooksPath already set: git ignores .git/hooks entirely, so the gate has
-- to work from wherever the setting points. T38g/T45 prove the installer
-- refuses an INJECTED one; this proves a legitimately configured one works.
$h48e = newrepo("t48-hookspath")
$hd48 = $ROOT .. "/t48-hooksdir"
mkdir($hd48)
must($h48e, ["git", "config", "core.hooksPath", $hd48])
for each $hn48e in ["pre-commit", "commit-msg"]
  $hp48e = $hd48 .. "/" .. $hn48e
  write_file($hp48e, join([
    "#!" .. $MIX,
    "exit(run_stream(concat([\"" .. $MIX .. "\", \"" .. $HOOK .. "\", \""
      .. $hn48e .. "\"], args())))",
    ""
  ], "\n"))
  chmod($hp48e, 0o755)
end
write_file($h48e .. "/a.txt", "clean\n")
must($h48e, ["git", "add", "-A"])
$f = $f + shape("T48e a clean commit under a configured core.hooksPath", 0,
  $h48e, ["git", "commit", "-q", "-m", "hooked elsewhere"])
write_file($h48e .. "/leak.txt", "peer " .. $IP .. "\n")
must($h48e, ["git", "add", "-A"])
$f = $f + shape("T48f and a leaking one is caught there too", 1, $h48e,
  ["git", "commit", "-q", "-m", "leak"])

-- A SHALLOW clone has no ancestry to walk. --range must not mistake "history I
-- do not have" for either a clean bill of health or a reason to refuse.
$src48 = newrepo("t48-shallow-src")
write_file($src48 .. "/a.txt", "clean one\n")
$one48 = commit($src48, "one")
write_file($src48 .. "/b.txt", "clean two\n")
$two48 = commit($src48, "two")
$f = $f + ok("T48 premise: the shallow source has depth to truncate",
  $one48 != "" and $two48 != "" and $one48 != $two48, "")
$sh48 = $ROOT .. "/t48-shallow"
$cl48 = run_argv(["git", "clone", "-q", "--depth", "1", "file://" .. $src48, $sh48],
  {timeout: 900})
if $cl48["exit_code"] != 0 then
  print("SKIP  T48g/h (shallow clone unavailable: "
    .. sanitize($cl48["stderr"]) .. ")")
else
  must($sh48, ["git", "config", "user.email", "probe@example.com"])
  must($sh48, ["git", "config", "user.name", "probe"])
  for each $hn48g in ["pre-commit", "commit-msg", "pre-push"]
    $hp48g = $sh48 .. "/.git/hooks/" .. $hn48g
    write_file($hp48g, join([
      "#!" .. $MIX,
      "exit(run_stream(concat([\"" .. $MIX .. "\", \"" .. $HOOK .. "\", \""
        .. $hn48g .. "\"], args())))",
      ""
    ], "\n"))
    chmod($hp48g, 0o755)
  end
  write_file($sh48 .. "/c.txt", "clean\n")
  must($sh48, ["git", "add", "-A"])
  $f = $f + shape("T48g a commit in a shallow clone", 0, $sh48,
    ["git", "commit", "-q", "-m", "three"])
  $sd48 = bare("t48-shallow-dest")
  -- Without this git rejects the push itself ("shallow update not allowed")
  -- and the probe would be measuring git rather than the gate.
  must($sd48, ["git", "config", "receive.shallowUpdate", "true"])
  $f = $f + shape("T48h and pushing from it does not refuse on absent ancestry",
    0, $sh48, ["git", "push", "-q", $sd48, "HEAD:refs/heads/main"])
end

-- T49..T53 — round ten. Five findings, each reproduced against the running
-- code before it was fixed; these are the probes that keep them fixed.

-- T49 — pre-push must bound the range by where the push is GOING, not by what
-- the remote NAME resolves to. `git ls-remote <name>` answers for the FETCH
-- url, so with `remote.<n>.pushurl` set the two are different repositories.
-- The fetch side already holding a commit is then read as "already published"
-- and the commit is excluded from the scan — while the push url, which has
-- never seen it, receives it. Found round ten (F1): a leaking commit reached
-- the push destination with the hook reporting success.
$r49 = newrepo("t49")
$fetch49 = bare("t49-fetch")
$push49 = bare("t49-push")
write_file($r49 .. "/base.txt", "clean\n")
$base49 = commit($r49, "base")
write_file($r49 .. "/leak.txt", "peer " .. $IP .. "\n")
$tip49 = commit($r49, "the leaking commit")
-- However it got there — a colleague, an older clone, a bypassed hook.
must($r49, ["git", "push", "-q", $fetch49, "main:refs/heads/main"])
$has49 = run_argv(["git", "-C", $fetch49, "rev-parse", "refs/heads/main"],
  {timeout: 300})
$f = $f + ok("T49a premise: the FETCH remote already holds the leaking commit",
  trim($has49["stdout"]) == $tip49,
  sanitize(trim($has49["stdout"]) .. " vs " .. $tip49))
$f = $f + ok("T49b premise: the PUSH remote has never seen it",
  run_argv(["git", "-C", $push49, "rev-parse", "--verify", "-q",
    "refs/heads/main"], {timeout: 300})["exit_code"] != 0, "")
-- $1 resolves to the fetch url; $2 is where the objects are actually going.
$n49 = push_ref_named($r49, $fetch49, $push49, "refs/heads/main", $tip49)
$f = $f + ok("T49c pre-push scans against the push destination, not the name",
  $n49["exit_code"] == 1
    and contains($n49["stdout"] .. $n49["stderr"], $IP_LABEL),
  "" .. $n49["exit_code"] .. " "
    .. sanitize($n49["stdout"] .. $n49["stderr"]))
-- And end-to-end, the way git actually invokes it: a real named remote with a
-- real pushurl, so nothing about the two-argument shape is being simulated.
must($r49, ["git", "remote", "add", "origin", $fetch49])
must($r49, ["git", "remote", "set-url", "--push", "origin", $push49])
for each $hn49 in ["pre-commit", "commit-msg", "pre-push"]
  $hp49 = $r49 .. "/.git/hooks/" .. $hn49
  write_file($hp49, join([
    "#!" .. $MIX,
    "exit(run_stream(concat([\"" .. $MIX .. "\", \"" .. $HOOK .. "\", \""
      .. $hn49 .. "\"], args())))",
    ""
  ], "\n"))
  chmod($hp49, 0o755)
end
$e49 = run_argv(["git", "-C", $r49, "push", "origin", "main"], {timeout: 1800})
$f = $f + ok("T49d and the same through real git with remote.origin.pushurl",
  $e49["exit_code"] != 0
    and contains($e49["stdout"] .. $e49["stderr"], "BLOCKED"),
  "" .. $e49["exit_code"] .. " "
    .. sanitize($e49["stdout"] .. $e49["stderr"]))
$land49 = run_argv(["git", "-C", $push49, "rev-parse", "--verify", "-q",
  "refs/heads/main"], {timeout: 300})
$f = $f + ok("T49e nothing reached the push url",
  $land49["exit_code"] != 0, sanitize(trim($land49["stdout"])))
-- The first fix for F1 trimmed $2, which is a normalisation that can change
-- WHICH REPOSITORY is consulted: a git location is an opaque string and a path
-- may end in a space. `…/dest ` trimmed to `…/dest` asked a sibling repo that
-- already held the leaking tip, so the range came back empty and the push
-- landed. Found by the round-ten re-review; git really does pass the trailing
-- space through (verified against real `git push` before this row was written).
-- Built by hand, not via bare(): that helper appends ".git", which would put
-- the space in the middle and defeat the whole point.
$sp49 = $ROOT .. "/t49-trail "
$nosp49 = $ROOT .. "/t49-trail"
for each $b49 in [$sp49, $nosp49]
  mkdir($b49)
  must($b49, ["git", "init", "-q", "--bare"])
end
-- --no-verify: T49d installed the real hooks in this repo and its tip leaks by
-- construction, so seeding the sibling is exactly the "however it got there"
-- of T49a, one probe later.
must($r49, ["git", "push", "-q", "--no-verify", $nosp49, "main:refs/heads/main"])
$t49 = push_ref_named($r49, "origin", $sp49, "refs/heads/main", $tip49)
$f = $f + ok("T49f a destination path is used verbatim, never trimmed",
  $t49["exit_code"] == 1
    and contains($t49["stdout"] .. $t49["stderr"], $IP_LABEL),
  "" .. $t49["exit_code"] .. " "
    .. sanitize($t49["stdout"] .. $t49["stderr"]))
-- And with no $2 at all — a chained wrapper that dropped it, or a git too old
-- to pass it — the destination is UNKNOWN. Unknown must widen to everything
-- reachable, not quietly re-ask the name: falling back to $1 is the F1 bug
-- reinstated for the case nobody can observe.
$m49 = run_argv([$MIX, $HOOK, "pre-push", $fetch49],
  {cwd: $r49, timeout: 900,
   stdin: "refs/heads/main " .. $tip49 .. " refs/heads/main " .. $ZERO .. "\n"})
$f = $f + ok("T49g an absent $2 widens the scan, it does not fall back to $1",
  $m49["exit_code"] == 1
    and contains($m49["stdout"] .. $m49["stderr"], $IP_LABEL),
  "" .. $m49["exit_code"] .. " "
    .. sanitize($m49["stdout"] .. $m49["stderr"]))

-- T50 — a forbidden identifier in a tracked PATHNAME. `git grep` matches
-- inside blob bodies and never against the path, so a file whose NAME is the
-- leak — or a directory named after a real domain — published clean with
-- every body empty. Found round ten (F2). Pathnames are published content;
-- they get their own pass, like symlink targets and commit messages.
$r50 = hook_repo("t50")
write_file($r50["path"] .. "/notes-" .. $NODE .. ".txt", "")
mkdir($r50["path"] .. "/sub")
write_file($r50["path"] .. "/sub/keep.txt", "nothing to see\n")
must($r50["path"], ["git", "add", "-A"])
$f = $f + shape("T50a a leak in the FILENAME is caught", 1, $r50["path"],
  ["git", "commit", "-q", "-m", "clean bodies, leaking name"])
-- T50b asserted `code == 2 or the output does not say PATHNAME`, which a
-- scanner that detects nothing at all satisfies perfectly — it never looked at
-- HEAD. Caught by the round-ten re-review. The premise it was reaching for is
-- that T50a's commit did not land, and the way to assert that is to ask the
-- tree what is in it.
$ls50 = run_argv(["git", "-C", $r50["path"], "ls-tree", "-r", "--name-only",
  "HEAD"], {timeout: 300})
$f = $f + ok("T50b premise: the leaking name is not in HEAD's tree",
  $ls50["exit_code"] == 0
    and contains($ls50["stdout"], "notes-" .. $NODE) == false
    and trim($ls50["stdout"]) != "",
  "" .. $ls50["exit_code"] .. " " .. sanitize($ls50["stdout"]))
-- Clear it and prove the same tree passes once only the name changes, so the
-- row above is detection and not a repo that could never commit anything.
$rm50 = run_argv(["rm", "-f", $r50["path"] .. "/notes-" .. $NODE .. ".txt"],
  {timeout: 60})
$f = $f + ok("T50c premise: the leaking filename is gone", $rm50["ok"] == true,
  sanitize($rm50["stderr"]))
must($r50["path"], ["git", "add", "-A"])
$f = $f + shape("T50d and the same tree without it commits clean", 0,
  $r50["path"], ["git", "commit", "-q", "-m", "clean names"])
-- --tree is the reviewable form of the same pass, and must agree.
$dir50 = $r50["path"] .. "/" .. $NODE .. ".example.org"
mkdir($dir50)
write_file($dir50 .. "/x.txt", "nothing to see\n")
must($r50["path"], ["git", "add", "-A"])
$f = $f + shape("T50e a leak in a DIRECTORY name is caught too", 1,
  $r50["path"], ["git", "commit", "-q", "-m", "leaking directory"])
-- T50a/e both go through pre-commit, i.e. `--index`. `--tree` is the reviewable
-- form of the same pass and the one `--all` uses, so it needs its own positive
-- row — the re-review pointed out that without it a pathname already IN a tree
-- (which is the state `--all` audits) had no assertion at all. --no-verify to
-- get the leak into a tree, which is the same way one gets there in real life.
must($r50["path"], ["git", "commit", "-q", "--no-verify", "-m",
  "leaking directory, hook bypassed"])
$t50 = gate(["--tree", $r50["path"], "HEAD"])
$f = $f + ok("T50f --tree finds a pathname leak already in a tree",
  $t50["code"] == 1 and contains($t50["out"], "in the PATHNAME itself")
    and contains($t50["out"], $NODE .. ".example.org"),
  "" .. $t50["code"] .. " " .. sanitize($t50["out"]))
-- And the body pass is not what found it: every file in that tree is clean.
-- Without this the row above could be passing on an ordinary content hit.
$g50 = run_argv(["git", "-C", $r50["path"], "grep", "-I", "-i", "-l", "-e",
  $NODE, "HEAD"], {timeout: 300})
$f = $f + ok("T50g premise: no file BODY in that tree carries the leak",
  $g50["exit_code"] == 1 and trim($g50["stdout"]) == "",
  "" .. $g50["exit_code"] .. " " .. sanitize($g50["stdout"]))

-- T51 — /proc/self/environ present but unreadable. exists() passing and the
-- open failing is one `chmod 000` apart; the raise was uncaught, and an
-- uncaught Mix error exits 1 — the code this gate reserves for "a violation
-- was found". Found round ten (F3). Absent and unreadable are the same
-- answer — unknowable — so both must fail closed with 2, never 1.
$bw51 = which("bwrap")
if $bw51 == nil or $bw51 == "" then
  print("SKIP  T51 (bwrap not installed)")
else
  $r51 = newrepo("t51")
  write_file($r51 .. "/a.txt", "clean\n")
  $sha51 = commit($r51, "base")
  $blind51 = $ROOT .. "/t51-environ"
  write_file($blind51, "")
  chmod($blind51, 0o000)
  $o51 = run_argv(["bwrap", "--dev-bind", "/", "/",
    "--ro-bind", $blind51, "/proc/self/environ",
    $MIX, $GATE, "--tree", $r51, "HEAD"], {timeout: 900})
  $f = $f + ok("T51 an unreadable /proc/self/environ is 2, never 1",
    $o51["exit_code"] == 2
      and contains($o51["stdout"] .. $o51["stderr"], "unknowable"),
    "" .. $o51["exit_code"] .. " "
      .. sanitize($o51["stdout"] .. $o51["stderr"]))
end

-- T52 — GIT_CONFIG_PARAMETERS was exempt from the installer's refusal list,
-- because git sets it itself to propagate `git -c` and refusing it would break
-- a legitimate invocation. It carries core.hooksPath perfectly well, so the
-- exemption was a redirect: exit 0, "hooks written: 9", all nine into one
-- decoy, the three real repos untouched. Found round ten (F4). The refusal
-- list cannot close this one; blanking the variable for the question does.
--
-- The assertion has to name all three outcomes, and it took two goes to get
-- there. "The decoy is empty" alone is passed by an installer that REFUSES the
-- invocation — which is the one thing it must not do, since git sets this
-- variable itself for `git -c`. Adding "exit 0" is passed by an installer that
-- silently does NOTHING when it sees the variable (demonstrated by mutant
-- against the previous version of this row). So the row runs against a fresh
-- disposable repo and requires the stubs to actually be there.
$decoy52 = $ROOT .. "/t52-decoy"
mkdir($decoy52)
$rp52 = newrepo("t52-inject")
$cp52 = $ROOT .. "/t52-inject.conf.mix"
write_file($cp52, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp52 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$ip52 = $ROOT .. "/install-t52-inject.mix"
write_file($ip52, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $cp52 .. "\""))
$o52 = run_installer([$MIX, $ip52], {timeout: 900,
  env: {GIT_CONFIG_PARAMETERS: "'core.hooksPath'='" .. $decoy52 .. "'"}})
$got52 = 0
for each $hn52 in ["pre-commit", "commit-msg", "pre-push"]
  if exists($rp52 .. "/.git/hooks/" .. $hn52) then
    $got52 = $got52 + 1
  end
end
$f = $f + ok("T52a an injected core.hooksPath is ignored and the install works",
  len(walk($decoy52)) == 0 and $o52["exit_code"] == 0 and $got52 == 3,
  "" .. len(walk($decoy52)) .. " decoy file(s), " .. $got52 .. "/3 stubs, exit "
    .. $o52["exit_code"] .. " " .. sanitize($o52["stdout"] .. $o52["stderr"]))
-- Round twenty-nine measured what "changes nothing" had concealed: the bare
-- installer rewrote all nine real hooks on every suite run. Their bytes matched,
-- so before==after stayed green while mtimes moved. A mutant copy could therefore
-- write mutant stubs into the live fleet, and an ordinary run could race git
-- reading a half-written hook. The marginal REAL-config coverage stays, but it
-- is read-only: every configured repo must be reported and the injected path
-- must not be. This row no longer proves that an INSTALL against the real config
-- leaves the hooks unchanged; no suite row is allowed to attempt that. T52a
-- proves the write path on a disposable repo, and T123 below proves the whole
-- suite left every real hook's content and mtime untouched.
$b52 = run_installer([$MIX, $INSTALL, "--status"], {timeout: 900,
  env: {GIT_CONFIG_PARAMETERS: "'core.hooksPath'='" .. $decoy52 .. "'"}})
$bt52 = $b52["stdout"] .. $b52["stderr"]
$seen52 = 0
$headings_ok52 = true
$states52 = 0
$states_ok52 = true
$active_repo52 = ""
$state_keys52 = []
for each $repo52 in $REAL_CFG["repos"]
  $repo_seen52 = 0
  for each $line52 in split($bt52, "\n")
    if $line52 == $repo52 then
      $seen52 = $seen52 + 1
      $repo_seen52 = $repo_seen52 + 1
    end
  end
  if $repo_seen52 != 1 then
    $headings_ok52 = false
  end
end
for each $line52 in split($bt52, "\n")
  $trimmed52 = trim($line52)
  if $trimmed52 != "" and starts_with($line52, " ") == false \
      and starts_with($line52, "\t") == false then
    $active_repo52 = ""
  end
  for each $repo52 in $REAL_CFG["repos"]
    if $line52 == $repo52 then
      $active_repo52 = $repo52
    end
  end
  for each $hn52b in ["pre-commit", "commit-msg", "pre-push"]
    if $trimmed52 == $hn52b .. ": installed" then
      $states52 = $states52 + 1
      if $active_repo52 == "" then
        $states_ok52 = false
      else
        push($state_keys52, $active_repo52 .. "\u{1f}" .. $hn52b)
      end
    end
  end
end
for each $repo52 in $REAL_CFG["repos"]
  for each $hn52b in ["pre-commit", "commit-msg", "pre-push"]
    $key_count52 = 0
    for each $key52 in $state_keys52
      if $key52 == $repo52 .. "\u{1f}" .. $hn52b then
        $key_count52 = $key_count52 + 1
      end
    end
    if $key_count52 != 1 then
      $states_ok52 = false
    end
  end
end
$f = $f + ok("T52b the injection is ignored while the real config is queried read-only",
  $b52["exit_code"] == 0 and $seen52 == len($REAL_CFG["repos"])
    and $headings_ok52
    and $states_ok52
    and $states52 == len($REAL_CFG["repos"]) * 3
    and contains($bt52, "WARNING") == false
    and contains($bt52, "NOT REPORTED") == false
    and contains($bt52, "UNKNOWN") == false
    and contains($bt52, $decoy52) == false and len(walk($decoy52)) == 0,
  "" .. $b52["exit_code"] .. " " .. $seen52 .. "/"
    .. len($REAL_CFG["repos"]) .. " repos, " .. $states52 .. "/"
    .. (len($REAL_CFG["repos"]) * 3) .. " determinate states, "
    .. len(walk($decoy52)) .. " decoy file(s) "
    .. sanitize(substr($bt52, 0, 500)))
-- T52d — a hooks path is a PATHNAME. `trim()` on git's answer looked like
-- stripping the newline and was the pre-push destination bug one file over:
-- `core.hooksPath = "…/hooks "` is legal, git returns the space, and the
-- installer wrote nine hooks into the SIBLING directory and exited 0.
-- Reproduced by the round-ten re-review.
$sp52 = $ROOT .. "/t52-sp/hooks "
$sib52 = $ROOT .. "/t52-sp/hooks"
mkdir($sp52)
mkdir($sib52)
$rs52 = newrepo("t52-space")
write_file($rs52 .. "/.git/config",
  read_file($rs52 .. "/.git/config")
    .. "[core]\n\thooksPath = \"" .. $sp52 .. "\"\n")
$cs52 = $ROOT .. "/t52-space.conf.mix"
write_file($cs52, replace(read_file($cp52), $rp52, $rs52))
$is52 = $ROOT .. "/install-t52-space.mix"
write_file($is52, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $cs52 .. "\""))
$s52 = run_installer([$MIX, $is52], {timeout: 900})
$f = $f + ok("T52d a hooks path with a trailing space is used, not trimmed",
  $s52["exit_code"] == 0 and exists($sp52 .. "/pre-commit")
    and exists($sib52 .. "/pre-commit") == false,
  "" .. $s52["exit_code"] .. " spaced="
    .. "" .. exists($sp52 .. "/pre-commit") .. " sibling="
    .. "" .. exists($sib52 .. "/pre-commit") .. " "
    .. sanitize($s52["stdout"] .. $s52["stderr"]))
-- T52e — and a path git can NAME is not necessarily one Mix can HOLD. A
-- pathname is bytes; run_argv replaces the non-UTF-8 ones with U+FFFD, and the
-- result names a different directory that may well exist. Both are created
-- here so the failure is the interesting one: without the utf8_lossy refusal
-- the installer writes into the replacement-character directory and exits 0,
-- while git goes on running hooks from the \200 one — installed and never run,
-- the same false success by a different route.
-- A filesystem with utf8only=on refuses the \200 name with EILSEQ,
-- so the case cannot be STAGED there. That is a fact about the filesystem, not
-- about the installer: skip loudly rather than die, and rather than hide it.
$lo52 = $ROOT .. "/t52-lossy"
$fffd52 = $lo52 .. "/h\u{FFFD}"
mkdir($lo52)
mkdir($fffd52)
$mk52 = run_argv(["xargs", "-0", "mkdir", "--"],
  {timeout: 60, stdin: freeze(buffer([$lo52 .. "/h", 0x80, 0x00]))})
if $mk52["exit_code"] != 0 then
  print("SKIP  T52e (filesystem refuses a non-UTF-8 pathname — utf8only? — cannot stage the case)")
else
  $rl52 = newrepo("t52-lossy-repo")
  $cfg52_bytes = freeze(buffer(["[core]\n\thooksPath = ", $lo52,
    "/h", 0x80, "\n"]))
  $y52 = run_argv(["dd", "of=" .. $rl52 .. "/.git/config", "oflag=append",
    "conv=notrunc", "status=none"], {timeout: 60, stdin: $cfg52_bytes})
  if $y52["exit_code"] != 0 then
    print("SETUP FAILED: cannot append undecodable core.hooksPath fixture")
    exit(2)
  end
  $cl52 = $ROOT .. "/t52-lossy.conf.mix"
  write_file($cl52, replace(read_file($cp52), $rp52, $rl52))
  $il52 = $ROOT .. "/install-t52-lossy.mix"
  write_file($il52, must_replace(read_file($INSTALL),
    "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $cl52 .. "\""))
  $l52 = run_installer([$MIX, $il52], {timeout: 900})
  $f = $f + ok("T52e a hooks path that is not UTF-8 is refused, not approximated",
    $l52["exit_code"] == 2
      and contains($l52["stdout"] .. $l52["stderr"], "not valid UTF-8")
      and len(walk($fffd52)) == 0,
    "" .. $l52["exit_code"] .. " " .. len(walk($fffd52)) .. " file(s) "
      .. sanitize($l52["stdout"] .. $l52["stderr"]))
end

-- T52c — the other direction, and the reason the first fix for F4 was wrong.
-- `clear_env: true` neutralised the injection by asking git a question with a
-- DIFFERENT config stack than the one git will have when it runs the hook. A
-- global core.hooksPath reached through XDG_CONFIG_HOME is legitimate config
-- in a file, and under clear_env the installer resolved `.git/hooks`, wrote
-- nine hooks there, exited 0 — and git would look somewhere else forever.
-- Reported installed, never runs: the exact failure hooks_dir() exists to
-- prevent, reintroduced by the fix for it.
$xdg52 = $ROOT .. "/t52-xdg"
$xh52 = $ROOT .. "/t52-xdg-hooks"
mkdir($xdg52 .. "/git")
mkdir($xh52)
write_file($xdg52 .. "/git/config",
  "[core]\n\thooksPath = " .. $xh52 .. "\n")
$rx52 = newrepo("t52-repo")
$cx52 = $ROOT .. "/t52.conf.mix"
write_file($cx52, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rx52 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$ix52 = $ROOT .. "/install-t52.mix"
write_file($ix52, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $cx52 .. "\""))
$x52 = run_installer([$MIX, $ix52], {timeout: 900,
  env: {XDG_CONFIG_HOME: $xdg52}})
$f = $f + ok("T52c a global core.hooksPath in a config FILE is still honoured",
  $x52["exit_code"] == 0 and exists($xh52 .. "/pre-commit")
    and exists($rx52 .. "/.git/hooks/pre-commit") == false,
  "" .. $x52["exit_code"] .. " " .. sanitize($x52["stdout"] .. $x52["stderr"]))

-- T53 — an unparseable config. Both the gate and the installer wrap
-- load_data() in try/catch to turn this into exit 2, and until mix 0.36.1
-- neither catch could fire: load_data leaked a raw parse error, which
-- try/catch refuses by design, and the interpreter exited 1 — a violation,
-- said the exit code, of a policy it had just failed to read. Found round ten
-- (F5); the fix is in the Mix binary (0.36.1), so this probe also pins the
-- interpreter's behaviour from outside.
if $bw51 == nil or $bw51 == "" then
  print("SKIP  T53 (bwrap not installed)")
else
  $r53 = newrepo("t53")
  write_file($r53 .. "/a.txt", "clean\n")
  $sha53 = commit($r53, "base")
  $bad53 = $ROOT .. "/t53-bad.conf.mix"
  write_file($bad53, "this is not conf.mix\n")
  $conf53 = $CMCTL .. "/_etc/public-hygiene.conf.mix"
  $g53 = run_argv(["bwrap", "--dev-bind", "/", "/",
    "--ro-bind", $bad53, $conf53,
    $MIX, $GATE, "--tree", $r53, "HEAD"], {timeout: 900})
  $f = $f + ok("T53a the gate answers an unparseable config with 2",
    $g53["exit_code"] == 2
      and contains($g53["stdout"] .. $g53["stderr"], "cannot read"),
    "" .. $g53["exit_code"] .. " "
      .. sanitize($g53["stdout"] .. $g53["stderr"]))
  $i53 = run_argv(["bwrap", "--dev-bind", "/", "/",
    "--ro-bind", $bad53, $conf53,
    $MIX, $INSTALL, "--status"], {timeout: 900, env: {TMPDIR: $ROOT, CMCTL: $CMCTL}})
  $f = $f + ok("T53b and so does the installer",
    $i53["exit_code"] == 2
      and contains($i53["stdout"] .. $i53["stderr"], "refusing to install"),
    "" .. $i53["exit_code"] .. " "
      .. sanitize($i53["stdout"] .. $i53["stderr"]))
  -- The interpreter property both of the above depend on. Asserted directly
  -- so a Mix regression names itself here instead of surfacing as two
  -- confusing exit-code failures.
  $probe53 = $ROOT .. "/t53-probe.mix"
  write_file($probe53, join([
    "try",
    "  $d = load_data(\"" .. $bad53 .. "\")",
    "catch $e",
    "  print(\"CAUGHT\")",
    "  exit(2)",
    "end",
    "print(\"NOT RAISED\")",
    ""
  ], "\n"))
  $m53 = run_argv([$MIX, $probe53], {timeout: 300})
  $f = $f + ok("T53c premise: load_data parse failure is catchable (mix 0.36.1+)",
    $m53["exit_code"] == 2 and contains($m53["stdout"], "CAUGHT"),
    "" .. $m53["exit_code"] .. " "
      .. sanitize($m53["stdout"] .. $m53["stderr"]))
end

-- T54 — the trailing-space pathname bug, hunted everywhere rather than fixed
-- where it was found. Round twelve's review made the point that closing it in
-- `hooks_dir()` closed one of FOUR sites: the hook resolves the hooks directory
-- and the working tree independently, and the gate resolves the gitdir. Each of
-- the three surviving `trim()`s was reproduced as a live failure before being
-- changed, and each row below is the reproduction.

-- T54a — the chained foreign veto. This one is silent by construction: get the
-- hooks directory wrong and `exists()` simply says there is no prior hook, so a
-- veto that exists never runs and the commit sails through. The installer saved
-- it into the spaced directory correctly; the hook looked in the sibling.
$hd54 = $ROOT .. "/t54-hooks "
$sib54 = $ROOT .. "/t54-hooks"
mkdir($hd54)
mkdir($sib54)
$r54 = newrepo("t54-chain")
must($r54, ["git", "config", "core.hooksPath", $hd54])
$fh54 = $hd54 .. "/pre-commit"
write_file($fh54, "#!" .. $MIX .. "\nprint(\"foreign veto ran\")\nexit(7)\n")
chmod($fh54, 0o755)
$c54 = $ROOT .. "/t54.conf.mix"
write_file($c54, replace(read_file($cp52), $rp52, $r54))
$i54 = $ROOT .. "/install-t54.mix"
write_file($i54, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c54 .. "\""))
$o54 = run_installer([$MIX, $i54], {timeout: 900})
write_file($r54 .. "/a.txt", "clean\n")
must($r54, ["git", "add", "-A"])
$v54 = run_argv(["git", "commit", "-m", "chained under a spaced hooks path"],
  {cwd: $r54, timeout: 1800, max_output: 8388608})
$f = $f + ok("T54a a chained veto under a spaced hooks path still runs",
  $o54["exit_code"] == 0 and $v54["exit_code"] != 0
    and contains($v54["stdout"] .. $v54["stderr"], "foreign veto ran"),
  "install=" .. $o54["exit_code"] .. " commit=" .. $v54["exit_code"] .. " "
    .. sanitize($v54["stdout"] .. $v54["stderr"]))

-- T54b — the working tree itself. `--show-toplevel` is what the hook hands the
-- gate as `-C <repo>`, and trimmed it named the sibling: the gate then found
-- git's own GIT_INDEX_FILE outside that repo's gitdir and refused a clean
-- commit with an environment-contamination error. Loud, but wrong.
$rt54 = hook_repo("t54-tree ")["path"]
write_file($rt54 .. "/a.txt", "clean\n")
must($rt54, ["git", "add", "-A"])
$f = $f + shape("T54b a clean commit in a working tree whose name ends in a space",
  0, $rt54, ["git", "commit", "-q", "-m", "spaced tree"])
-- The detection half names the verdict and the rule, not just "git said no":
-- `git commit` exits 1 for ANY failed hook, so a hook that refuses everything
-- for an infrastructure reason passes an exit-code-only assertion perfectly.
-- That is exactly the hole round ten found in T41c.
write_file($rt54 .. "/leak.txt", "peer " .. $IP .. "\n")
must($rt54, ["git", "add", "-A"])
$l54 = run_argv(["git", "commit", "-m", "spaced leak"],
  {cwd: $rt54, timeout: 1800, max_output: 8388608})
$f = $f + ok("T54c and a leaking one there is caught as a leak, not an error",
  $l54["exit_code"] != 0
    and contains($l54["stdout"] .. $l54["stderr"], "BLOCKED")
    and contains($l54["stdout"] .. $l54["stderr"], $IP_LABEL),
  "" .. $l54["exit_code"] .. " " .. sanitize($l54["stdout"] .. $l54["stderr"]))

-- T54d — the gitdir, which `git init --separate-git-dir` lets you name freely.
-- Same failure as T54b, one layer down: the gate compared git's GIT_DIR against
-- the unspaced sibling and refused every commit in the repo.
$sg54 = $ROOT .. "/t54-sep "
$sgs54 = $ROOT .. "/t54-sep"
mkdir($sgs54)
$rs54 = $ROOT .. "/t54-sepwork"
mkdir($rs54)
must($rs54, ["git", "init", "-q", "-b", "main", "--separate-git-dir", $sg54])
must($rs54, ["git", "config", "user.email", "probe@example.com"])
must($rs54, ["git", "config", "user.name", "probe"])
for each $hn54 in ["pre-commit", "commit-msg"]
  $hp54 = $sg54 .. "/hooks/" .. $hn54
  write_file($hp54, join([
    "#!" .. $MIX,
    "exit(run_stream(concat([\"" .. $MIX .. "\", \"" .. $HOOK .. "\", \""
      .. $hn54 .. "\"], args())))",
    ""
  ], "\n"))
  chmod($hp54, 0o755)
end
write_file($rs54 .. "/a.txt", "clean\n")
must($rs54, ["git", "add", "-A"])
$f = $f + shape("T54d a clean commit with a separate gitdir whose name ends in a space",
  0, $rs54, ["git", "commit", "-q", "-m", "separate gitdir"])
write_file($rs54 .. "/leak.txt", "peer " .. $IP .. "\n")
must($rs54, ["git", "add", "-A"])
$e54 = run_argv(["git", "commit", "-m", "separate leak"],
  {cwd: $rs54, timeout: 1800, max_output: 8388608})
$f = $f + ok("T54e and a leaking one there is caught as a leak, not an error",
  $e54["exit_code"] != 0
    and contains($e54["stdout"] .. $e54["stderr"], "BLOCKED")
    and contains($e54["stdout"] .. $e54["stderr"], $IP_LABEL),
  "" .. $e54["exit_code"] .. " " .. sanitize($e54["stdout"] .. $e54["stderr"]))

-- T55 — a git hook is an EXECUTABLE, not a text file. The installer read every
-- pre-existing hook with read_file() to ask "is this ours"; a compiled binary
-- or a Latin-1 script made that raise uncaught, and an uncaught Mix error exits
-- 1 — the code reserved for "a leak was found". The installer answered a
-- foreign binary hook by reporting a policy violation. Chaining is a byte copy
-- now, so the answer is to preserve it, not to refuse.
$rb55 = newrepo("t55-binary")
$hook55 = freeze(buffer(["#!/bin/sh\n# ", 0x80,
  "\necho T55-CHAIN-RAN\nexit 9\n"]))
write_file($rb55 .. "/.git/hooks/pre-commit", $hook55)
chmod($rb55 .. "/.git/hooks/pre-commit", 0o755)
$c55 = $ROOT .. "/t55.conf.mix"
write_file($c55, replace(read_file($cp52), $rp52, $rb55))
$i55 = $ROOT .. "/install-t55.mix"
write_file($i55, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c55 .. "\""))
$o55 = run_installer([$MIX, $i55], {timeout: 900})
$f = $f + ok("T55a a non-UTF-8 pre-existing hook is chained, not called a leak",
  $o55["exit_code"] == 0
    and exists($rb55 .. "/.git/hooks/pre-commit.pre-hygiene"),
  "" .. $o55["exit_code"] .. " " .. sanitize($o55["stdout"] .. $o55["stderr"]))
-- Byte-identical, which read_file+write_file could not have been.
$same55 = constant_time_eq(
  read_file_bytes($rb55 .. "/.git/hooks/pre-commit.pre-hygiene"), $hook55)
$f = $f + ok("T55b and it was preserved byte for byte", $same55,
  "byte comparison=" .. $same55)
write_file($rb55 .. "/a.txt", "clean\n")
must($rb55, ["git", "add", "-A"])
$v55 = run_argv(["git", "commit", "-m", "binary chain"],
  {cwd: $rb55, timeout: 1800, max_output: 8388608})
-- "from the chain" has to be asserted, not implied. `$v55["exit_code"] != 0`
-- alone is satisfied by an installer that DIED before chaining anything — git
-- then runs the original foreign hook directly, in place, and the row passes
-- while proving the opposite (demonstrated by M18). It is also satisfied by
-- run_prior() refusing with an infrastructure error. So: the live pre-commit
-- must be our stub, the saved hook must be there, and the marker must come
-- from the copy that only the chain can reach.
-- read_file, wrapped, for the same reason the installer wraps its own: the live
-- pre-commit here is a NON-UTF-8 executable whenever the chain did not happen,
-- which is exactly the state this row exists to catch. Unwrapped it raised and
-- took the whole suite down mid-run under M18 — the harness repeating the class
-- of bug it was written to pin. Unreadable ⇒ certainly not our stub.
$live55 = ""
try
  $live55 = read_file($rb55 .. "/.git/hooks/pre-commit")
catch $lr55
  $live55 = ""
end
$f = $f + ok("T55c and its veto still runs from the chain",
  $v55["exit_code"] != 0
    and contains($v55["stdout"] .. $v55["stderr"], "T55-CHAIN-RAN")
    and contains($live55, "cosmix-hygiene-gate")
    and exists($rb55 .. "/.git/hooks/pre-commit.pre-hygiene"),
  "" .. $v55["exit_code"] .. " live_is_stub="
    .. contains($live55, "cosmix-hygiene-gate") .. " "
    .. sanitize($v55["stdout"] .. $v55["stderr"]))

-- T56 — an unreadable existing hook. Classifying it as foreign was only half
-- the fix: copy() then raised uncaught and the installer exited 1, reporting a
-- policy violation over a permission error. Found round thirteen.
$ru56 = newrepo("t56-unreadable")
$hk56 = $ru56 .. "/.git/hooks/pre-commit"
write_file($hk56, "#!/bin/sh\nexit 0\n")
chmod($hk56, 0o000)
-- Recorded BEFORE the run. "Left in place" is a claim about bytes and mode, not
-- about a path still existing: a truncated or re-created file at the same path
-- passes an exists() check and is exactly the damage this row exists to catch.
$st56 = stat($hk56)
$c56 = $ROOT .. "/t56.conf.mix"
write_file($c56, replace(read_file($cp52), $rp52, $ru56))
$i56 = $ROOT .. "/install-t56.mix"
write_file($i56, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c56 .. "\""))
$o56 = run_installer([$MIX, $i56], {timeout: 900})
$f = $f + ok("T56a an unpreservable existing hook is 2, never 1",
  $o56["exit_code"] == 2
    and contains($o56["stdout"] .. $o56["stderr"], "cannot preserve"),
  "" .. $o56["exit_code"] .. " " .. sanitize($o56["stdout"] .. $o56["stderr"]))
-- And nothing was half-done. Same inode, same size, same mode, same bytes —
-- the mode is dropped only afterwards, so the content can be read back and
-- compared rather than inferred from the file still being there.
$sa56 = stat($hk56)
chmod($hk56, 0o600)
$body56 = read_file($hk56)
$f = $f + ok("T56b and the original hook was left in place, byte for byte",
  $body56 == "#!/bin/sh\nexit 0\n"
    and $sa56["ino"] == $st56["ino"]
    and $sa56["size"] == $st56["size"]
    and $sa56["perm"] == $st56["perm"]
    and exists($hk56 .. ".pre-hygiene") == false
    and exists($hk56 .. ".pre-hygiene.tmp") == false,
  join(["body=", sanitize($body56), " same_ino=", $sa56["ino"] == $st56["ino"],
    " perm=", $sa56["perm"], " size=", $sa56["size"], " pre-hygiene=",
    exists($hk56 .. ".pre-hygiene"), " tmp=",
    exists($hk56 .. ".pre-hygiene.tmp")], ""))

-- T57 — the hook resolves the hooks directory itself, to find the chained
-- foreign hook. When that git call fails it used to fall back to
-- `$repo/.git/hooks`, and a wrong guess here does not fail: exists() says
-- there is no chained hook and a veto that DOES exist is silently dropped.
-- Under core.hooksPath the guess is wrong by construction. Found round
-- thirteen by fault injection, which is what this row does: a git shim that
-- fails only `rev-parse --git-path hooks` and is otherwise the real git.
$rg57 = newrepo("t57-hookdir")
$hd57 = $ROOT .. "/t57-hooks"
mkdir($hd57)
must($rg57, ["git", "config", "core.hooksPath", $hd57])
write_file($hd57 .. "/pre-commit.pre-hygiene",
  "#!" .. $MIX .. "\nprint(\"T57-VETO\")\nexit(7)\n")
chmod($hd57 .. "/pre-commit.pre-hygiene", 0o755)
$shim57 = $ROOT .. "/t57-bin"
mkdir($shim57)
$realgit57 = which("git")
write_file($shim57 .. "/git", join([
  "#!" .. $MIX,
  "$a = args()",
  "if contains($a, \"--git-path\") then",
  "  eprint(\"shim: rev-parse --git-path is unavailable\")",
  "  exit(128)",
  "end",
  "exit(run_stream(concat([\"" .. $realgit57 .. "\"], $a)))",
  ""
], "\n"))
chmod($shim57 .. "/git", 0o755)
write_file($rg57 .. "/a.txt", "clean\n")
must($rg57, ["git", "add", "-A"])
$g57 = run_argv([$MIX, $HOOK, "pre-commit"],
  {cwd: $rg57, timeout: 900,
   env: {PATH: $shim57 .. ":" .. env("PATH")}})
$f = $f + ok("T57a a failed hooks-dir lookup refuses, it does not drop the chain",
  $g57["exit_code"] == 2
    and contains($g57["stdout"] .. $g57["stderr"], "hooks directory"),
  "" .. $g57["exit_code"] .. " " .. sanitize($g57["stdout"] .. $g57["stderr"]))
-- Premise: without the shim the same invocation finds the chained veto, so the
-- row above is about the lookup failing and not about the repo being odd.
$p57 = run_argv([$MIX, $HOOK, "pre-commit"], {cwd: $rg57, timeout: 900})
-- The chained hook's own status (7) is named but not worn: this hook exits 2,
-- because the scan did not run. T81 is where that contract is probed directly;
-- here it is the evidence that the chained hook was found and executed.
$f = $f + ok("T57b premise: the chained veto is found when the lookup works",
  $p57["exit_code"] == 2
    and contains($p57["stdout"] .. $p57["stderr"], "T57-VETO")
    and contains($p57["stdout"] .. $p57["stderr"], "exited 7"),
  "" .. $p57["exit_code"] .. " " .. sanitize($p57["stdout"] .. $p57["stderr"]))

-- T57c — the same drop, arriving through a SUCCESS. `--git-path` exiting 0 with
-- nothing on stdout passes the ok-check, and an empty path made the relative
-- branch return "$repo/", where no `.pre-hygiene` is ever found: a foreign veto
-- silently skipped by a git call that reported no error at all. Round fourteen.
-- The shim is T57's, minus the failure — it prints nothing and exits 0.
$sh57c = $ROOT .. "/t57c-bin"
mkdir($sh57c)
write_file($sh57c .. "/git", join([
  "#!" .. $MIX,
  "$a = args()",
  "if contains($a, \"--git-path\") then",
  "  exit(0)",
  "end",
  "exit(run_stream(concat([\"" .. $realgit57 .. "\"], $a)))",
  ""
], "\n"))
chmod($sh57c .. "/git", 0o755)
$e57 = run_argv([$MIX, $HOOK, "pre-commit"],
  {cwd: $rg57, timeout: 900,
   env: {PATH: $sh57c .. ":" .. env("PATH")}})
$f = $f + ok("T57c an empty hooks-dir answer refuses too, it is not a path",
  $e57["exit_code"] == 2
    and contains($e57["stdout"] .. $e57["stderr"], "returned nothing"),
  "" .. $e57["exit_code"] .. " " .. sanitize($e57["stdout"] .. $e57["stderr"]))

-- T58/T59 — guarding the two hook-writing steps was only half of round
-- thirteen's fix: neither `copy` nor `write_file` is atomic, so a failure PART
-- WAY THROUGH left a truncated file behind a message describing an untouched
-- one. Both steps stage into a temp beside the target and rename(2) it into
-- place. Round fifteen then claimed each fixed name with O_EXCL.
--
-- Round twenty-seven moves an ALREADY occupied staging name into the read-only
-- fleet preflight. The safety invariant is stronger but the fixtures stay the
-- same: the occupied name survives, no byte moves, and now even the
-- `.pre-hygiene` preservation step is unreachable. Removing the new preflight
-- checks sends these rows back through claim(); T58 still refuses safely, while
-- T59 creates a preservation copy first and its new no-copy assertion goes red.
-- T66 covers the other half, a write that dies mid-copy.
--
-- T58 — the chain half. A partial `.pre-hygiene` would contradict the message's
-- "nothing was created", and would be a truncated copy of a hook someone might
-- later restore from.
$rb58 = newrepo("t58-chain-tmp")
$hk58 = $rb58 .. "/.git/hooks/pre-commit"
write_file($hk58, "#!/bin/sh\necho T58-FOREIGN\nexit 3\n")
chmod($hk58, 0o755)
mkdir($hk58 .. ".pre-hygiene.tmp")
$st58 = stat($hk58)
$c58 = $ROOT .. "/t58.conf.mix"
write_file($c58, replace(read_file($cp52), $rp52, $rb58))
$i58 = $ROOT .. "/install-t58.mix"
write_file($i58, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c58 .. "\""))
$o58 = run_installer([$MIX, $i58], {timeout: 900})
$f = $f + ok("T58a an occupied chain staging path is 2, never 1",
  $o58["exit_code"] == 2
    and contains($o58["stdout"] .. $o58["stderr"],
      "occupies the staging name"),
  "" .. $o58["exit_code"] .. " " .. sanitize($o58["stdout"] .. $o58["stderr"]))
$sa58 = stat($hk58)
-- The staging path is checked for survival, not just absence of damage: the
-- installer refuses before opening anything, so whatever was already there —
-- a crashed run's evidence, or a file that has nothing to do with us — is
-- still there afterwards.
$f = $f + ok("T58b and no partial .pre-hygiene was left beside the original",
  read_file($hk58) == "#!/bin/sh\necho T58-FOREIGN\nexit 3\n"
    and $sa58["ino"] == $st58["ino"]
    and exists($hk58 .. ".pre-hygiene") == false
    and is_dir($hk58 .. ".pre-hygiene.tmp"),
  join(["same_ino=", $sa58["ino"] == $st58["ino"], " pre-hygiene=",
    exists($hk58 .. ".pre-hygiene"), " staging_survived=",
    is_dir($hk58 .. ".pre-hygiene.tmp"), " body=",
    sanitize(read_file($hk58))], ""))

-- T59 — the stub half, and the dangerous one. Before round twenty-seven the
-- chain step succeeded before the occupied stub staging name refused, so this
-- shipped assertion required a `.pre-hygiene` copy. That mutation is precisely
-- what complete preflight now forbids. The live hook and staging directory must
-- remain intact and NO preservation copy may appear.
$rb59 = newrepo("t59-stub-tmp")
$hk59 = $rb59 .. "/.git/hooks/pre-commit"
$body59 = "#!/bin/sh\necho T59-FOREIGN\nexit 4\n"
write_file($hk59, $body59)
chmod($hk59, 0o755)
mkdir($hk59 .. ".hygiene-tmp")
$st59 = stat($hk59)
$c59 = $ROOT .. "/t59.conf.mix"
write_file($c59, replace(read_file($cp52), $rp52, $rb59))
$i59 = $ROOT .. "/install-t59.mix"
write_file($i59, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c59 .. "\""))
$o59 = run_installer([$MIX, $i59], {timeout: 900})
$f = $f + ok("T59a an occupied stub staging path is 2, never 1",
  $o59["exit_code"] == 2
    and contains($o59["stdout"] .. $o59["stderr"],
      "occupies the gate-stub staging name"),
  "" .. $o59["exit_code"] .. " " .. sanitize($o59["stdout"] .. $o59["stderr"]))
$sa59 = stat($hk59)
$f = $f + ok("T59b and the live hook is intact, as the message promises",
  read_file($hk59) == $body59
    and $sa59["ino"] == $st59["ino"]
    and exists($hk59 .. ".pre-hygiene", {follow_symlinks: false}) == false
    and is_dir($hk59 .. ".hygiene-tmp"),
  join(["same_ino=", $sa59["ino"] == $st59["ino"], " staging_survived=",
    is_dir($hk59 .. ".hygiene-tmp"), " live=",
    sanitize(read_file($hk59))], ""))

-- T61 — cleaning up after yourself must not mean cleaning up after someone
-- else. `copy` opens the SOURCE first, so a copy that fails on an unreadable
-- source never touched the destination; an unconditional "remove the temp on
-- the failure path" would then delete whatever was already at the staging
-- path — a crashed run's evidence, or a file that has nothing to do with us.
-- The repo shape is T56's (mode-000 hook) plus a pre-existing staging FILE,
-- which is the case a directory collision cannot reach: remove() refuses a
-- directory anyway. Round fifteen moved the refusal into claim(); round
-- twenty-seven moves an already-visible collision earlier again, into fleet
-- preflight. The invariant is unchanged: a pre-existing file survives byte for
-- byte.
$rp61 = newrepo("t61-staging")
$hk61 = $rp61 .. "/.git/hooks/pre-commit"
write_file($hk61, "#!/bin/sh\nexit 0\n")
chmod($hk61, 0o000)
$tp61 = $hk61 .. ".pre-hygiene.tmp"
write_file($tp61, "T61-PREEXISTING\n")
$c61 = $ROOT .. "/t61.conf.mix"
write_file($c61, replace(read_file($cp52), $rp52, $rp61))
$i61 = $ROOT .. "/install-t61.mix"
write_file($i61, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c61 .. "\""))
$o61 = run_installer([$MIX, $i61], {timeout: 900})
$f = $f + ok("T61a a staging path someone else owns is refused, not reused",
  $o61["exit_code"] == 2
    and contains($o61["stdout"] .. $o61["stderr"], "staging name")
    and contains($o61["stdout"] .. $o61["stderr"], "already exists"),
  "" .. $o61["exit_code"] .. " " .. sanitize($o61["stdout"] .. $o61["stderr"]))
$f = $f + ok("T61b and it is still there, byte for byte",
  exists($tp61) and read_file($tp61) == "T61-PREEXISTING\n",
  join(["exists=", exists($tp61)], ""))

-- T60 — the installer's config is a boundary too. Presence was checked, shape
-- was not: `repos` as a string sailed past the nil test into `len()`, which
-- counted its CHARACTERS. Same wrapper and same exit-2 contract as the gate.
$c60 = $ROOT .. "/t60-repos-string.conf.mix"
write_file($c60, "public_hygiene: {\n  schema_version: 1,\n  repos: \""
  .. $ROOT .. "/t60-never-repo\"\n}\n")
$i60 = $ROOT .. "/install-t60.mix"
write_file($i60, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c60 .. "\""))
$o60 = run_installer([$MIX, $i60], {timeout: 900})
$f = $f + ok("T60a a repos field of the wrong type is 2, never 1 and never run",
  $o60["exit_code"] == 2
    and contains($o60["stdout"] .. $o60["stderr"], "not a usable repo list"),
  "" .. $o60["exit_code"] .. " " .. sanitize($o60["stdout"] .. $o60["stderr"]))
$c60b = $ROOT .. "/t60-schema-bump.conf.mix"
write_file($c60b,
  "public_hygiene: {\n  schema_version: 2,\n  repos: [\""
    .. $ROOT .. "/t60b-never-repo\"]\n}\n")
$i60b = $ROOT .. "/install-t60b.mix"
write_file($i60b, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c60b .. "\""))
$o60b = run_installer([$MIX, $i60b], {timeout: 900})
$f = $f + ok("T60b and a schema_version this installer cannot read stops it",
  $o60b["exit_code"] == 2
    and contains($o60b["stdout"] .. $o60b["stderr"], "not a usable repo list"),
  "" .. $o60b["exit_code"] .. " " .. sanitize($o60b["stdout"] .. $o60b["stderr"]))

-- T60c — and the shape check has to be reachable on the input it guards
-- against. `public_hygiene` as a STRING was indexed (`$cfg["repos"]`) before
-- validate() ever saw it: "cannot index string with string", uncaught, exit 1.
-- A malformed config announced as a policy violation, by the very check added
-- to stop exactly that. Third time this arc — a guard placed one statement too
-- late is the recurring shape, not a one-off.
$c60c = $ROOT .. "/t60-not-a-map.conf.mix"
write_file($c60c, "public_hygiene: \"not a map\"\n")
$i60c = $ROOT .. "/install-t60c.mix"
write_file($i60c, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c60c .. "\""))
$o60c = run_installer([$MIX, $i60c], {timeout: 900})
$f = $f + ok("T60c a public_hygiene that is not a section is 2, never 1",
  $o60c["exit_code"] == 2
    and contains($o60c["stdout"] .. $o60c["stderr"], "not a section"),
  "" .. $o60c["exit_code"] .. " " .. sanitize($o60c["stdout"] .. $o60c["stderr"]))

-- T60d — the same defect in the gate, fixed as a class rather than at the site
-- it was found. load_conf() indexed the parsed document before proving it was a
-- map; load_data() will happily return a LIST for a document whose top level is
-- one, and `$d["public_hygiene"]` then raises "cannot index list with string".
-- Exit 1 out of the gate is the worst version of this bug: it is the code that
-- means "this repo is leaking".
$c60d = $ROOT .. "/t60-toplevel-list.conf.mix"
write_file($c60d, "[1, 2]\n")
$g60d = $ROOT .. "/gate-t60d.mix"
write_file($g60d, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c60d .. "\""))
$o60d = run_argv([$MIX, $g60d, "--all"], {timeout: 900})
$f = $f + ok("T60d a config whose top level is not a map is 2, never 1",
  $o60d["exit_code"] == 2
    and contains($o60d["stdout"] .. $o60d["stderr"], "not a config section map"),
  "" .. $o60d["exit_code"] .. " " .. sanitize($o60d["stdout"] .. $o60d["stderr"]))

-- T62/T63/T64 — the staging name is a PATHNAME, and until round fifteen the
-- installer wrote into it without ever establishing that it owned it. Both
-- writes followed a symlink. Round twenty-seven's preflight now catches an
-- occupied name before claim(), but these rows still pin the reproduced
-- consequences: every symlink survives and no target is touched.
--
-- T62 — chain staging aimed at the live hook. `copy($hook, $ctmp)` with
-- `$ctmp -> $hook` copies the hook onto itself, the rename then MOVES the live
-- hook to `.pre-hygiene`, and the stub lands on a now-absent target: the
-- installer exits 0 reporting success while the foreign hook it promised to
-- preserve has been shuffled out from under the operator.
$rp62 = newrepo("t62-chain-symlink")
$hk62 = $rp62 .. "/.git/hooks/pre-commit"
$body62 = "#!/bin/sh\necho T62-FOREIGN\nexit 5\n"
write_file($hk62, $body62)
chmod($hk62, 0o755)
symlink($hk62, $hk62 .. ".pre-hygiene.tmp")
$st62 = stat($hk62, {follow_symlinks: false})
$c62 = $ROOT .. "/t62.conf.mix"
write_file($c62, replace(read_file($cp52), $rp52, $rp62))
$i62 = $ROOT .. "/install-t62.mix"
write_file($i62, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c62 .. "\""))
$o62 = run_installer([$MIX, $i62], {timeout: 900})
$f = $f + ok("T62a a chain staging path that is a symlink is refused, not followed",
  $o62["exit_code"] == 2
    and contains($o62["stdout"] .. $o62["stderr"], "staging name"),
  "" .. $o62["exit_code"] .. " " .. sanitize($o62["stdout"] .. $o62["stderr"]))
$sa62 = stat($hk62, {follow_symlinks: false})
$live62 = "<the hook is a symlink — not read>"
if $sa62["is_symlink"] == false then
  $live62 = read_file($hk62)
end
$f = $f + ok("T62b and the hook it aimed at is untouched, same inode",
  $sa62["is_symlink"] == false
    and $live62 == $body62
    and $sa62["ino"] == $st62["ino"]
    and exists($hk62 .. ".pre-hygiene") == false
    and link_target($hk62 .. ".pre-hygiene.tmp") == $hk62,
  join(["same_ino=", $sa62["ino"] == $st62["ino"], " pre-hygiene=",
    exists($hk62 .. ".pre-hygiene"), " body=", sanitize($live62)], ""))

-- T63 — stub staging aimed at the live hook, and the worse of the two: the
-- stub is written straight through the link into the live hook, and the rename
-- then replaces the hook with a symlink to ITSELF. git exec's a loop, the
-- installer says "hooks written: 3", and nothing is guarding anything.
$rp63 = newrepo("t63-stub-symlink")
$hk63 = $rp63 .. "/.git/hooks/pre-commit"
$body63 = "#!/bin/sh\necho T63-FOREIGN\nexit 6\n"
write_file($hk63, $body63)
chmod($hk63, 0o755)
symlink($hk63, $hk63 .. ".hygiene-tmp")
-- lstat, and the reads below are guarded, because the damage this row exists to
-- detect makes the hook a symlink to ITSELF: `stat` and `read_file` both follow,
-- both raise ELOOP, and an uncaught raise takes the whole suite down instead of
-- failing this row. A probe that cannot survive the defect it is hunting reports
-- nothing about it.
$st63 = stat($hk63, {follow_symlinks: false})
$c63 = $ROOT .. "/t63.conf.mix"
write_file($c63, replace(read_file($cp52), $rp52, $rp63))
$i63 = $ROOT .. "/install-t63.mix"
write_file($i63, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c63 .. "\""))
$o63 = run_installer([$MIX, $i63], {timeout: 900})
$f = $f + ok("T63a a stub staging path that is a symlink is refused too",
  $o63["exit_code"] == 2
    and contains($o63["stdout"] .. $o63["stderr"], "staging name"),
  "" .. $o63["exit_code"] .. " " .. sanitize($o63["stdout"] .. $o63["stderr"]))
$sa63 = stat($hk63, {follow_symlinks: false})
$live63 = "<the hook is a symlink — not read>"
if $sa63["is_symlink"] == false then
  $live63 = read_file($hk63)
end
$f = $f + ok("T63b and the live hook is still a regular file, not a loop",
  $sa63["is_symlink"] == false
    and $live63 == $body63
    and $sa63["ino"] == $st63["ino"]
    and link_target($hk63 .. ".hygiene-tmp") == $hk63,
  join(["same_ino=", $sa63["ino"] == $st63["ino"], " is_symlink=",
    $sa63["is_symlink"], " body=", sanitize($live63)], ""))

-- T64 — a DANGLING staging symlink, which is the case an exists() pre-check
-- cannot see: exists() follows the link, so it answers false and the old
-- "only clean up what we created" logic deleted somebody's link. O_EXCL does
-- not follow and does not care whether the target resolves, which is exactly
-- why the claim has to be the check rather than something inferred around it.
$rp64 = newrepo("t64-dangling")
$hk64 = $rp64 .. "/.git/hooks/pre-commit"
$lk64 = $hk64 .. ".hygiene-tmp"
symlink("./nowhere-T64", $lk64)
-- The premise is asserted BEFORE the installer runs. Asserted after, it is a
-- statement about whatever the defect left behind — and against M28 the defect
-- renames this link away, so the bare `stat()` that used to be here raised and
-- took the run down at T64a with T64b and everything after it unreported.
$f = $f + ok("T64a premise: exists() cannot see a dangling staging link",
  exists($lk64) == false and is_link($lk64),
  join(["exists=", exists($lk64), " is_link=", is_link($lk64)], ""))
$c64 = $ROOT .. "/t64.conf.mix"
write_file($c64, replace(read_file($cp52), $rp52, $rp64))
$i64 = $ROOT .. "/install-t64.mix"
write_file($i64, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c64 .. "\""))
$o64 = run_installer([$MIX, $i64], {timeout: 900})
$f = $f + ok("T64b it is refused, and not deleted on the way out",
  $o64["exit_code"] == 2
    and contains($o64["stdout"] .. $o64["stderr"], "staging name")
    and is_link($lk64)
    and link_target($lk64) == "./nowhere-T64",
  join(["", $o64["exit_code"], " still_a_link=", is_link($lk64), " target=",
    link_target($lk64), " ", sanitize($o64["stdout"] .. $o64["stderr"])], ""))

-- T66 — the atomicity guarantee itself, which the claim does not cover: a
-- write that dies PART WAY THROUGH. RLIMIT_FSIZE is the deterministic
-- injection — SIGXFSZ kills the process outright at 1024 bytes, so there is no
-- catch block, no message, and no cleanup, which is the strongest form of the
-- test. Written directly to `.pre-hygiene` (the pre-round-fourteen shape) this
-- leaves a truncated copy of a hook someone may later restore from; staged and
-- renamed, the partial file is a temp nobody will mistake for a backup and
-- `.pre-hygiene` never comes into existence at all.
$rp66 = newrepo("t66-partial-copy")
$hk66 = $rp66 .. "/.git/hooks/pre-commit"
$big66 = "#!/bin/sh\n# " .. repeat("A", 40000) .. "\nexit 7\n"
write_file($hk66, $big66)
chmod($hk66, 0o755)
$st66 = stat($hk66)
$c66 = $ROOT .. "/t66.conf.mix"
write_file($c66, replace(read_file($cp52), $rp52, $rp66))
$i66 = $ROOT .. "/install-t66.mix"
write_file($i66, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c66 .. "\""))
$o66 = run_argv(["prlimit", "--fsize=1024:1024", "--", $MIX, $i66],
  {timeout: 900, env: {TMPDIR: $ROOT}})
$f = $f + ok("T66a premise: the copy is killed mid-write, with no cleanup path",
  $o66["exit_code"] != 0 and $o66["exit_code"] != 1,
  join(["rc=", $o66["exit_code"], " ",
    sanitize($o66["stdout"] .. $o66["stderr"])], ""))
$sa66 = stat($hk66)
$f = $f + ok("T66b no truncated .pre-hygiene exists, and the hook is intact",
  exists($hk66 .. ".pre-hygiene") == false
    and read_file($hk66) == $big66
    and $sa66["ino"] == $st66["ino"],
  join(["pre-hygiene=", exists($hk66 .. ".pre-hygiene"), " same_ino=",
    $sa66["ino"] == $st66["ino"], " size=", len(read_file($hk66))], ""))

-- T67/T68/T69 — the same lie as T64, but at the three OTHER places the code
-- asked exists() a question exists() does not answer. exists() follows the
-- link, so a dangling symlink reads as absent; every guard that means "there
-- is an entry here" needs lstat. Round sixteen fixed it as a class, so it is
-- pinned as a class.

-- T67 — a dangling `.pre-hygiene`. The refusal it bypasses is the one that
-- protects the only saved copy of somebody's original hook, and the rename it
-- fell through to removed the link without a word.
$rp67 = newrepo("t67-dangling-saved")
$hk67 = $rp67 .. "/.git/hooks/pre-commit"
write_file($hk67, "#!/bin/sh\necho T67-FOREIGN\nexit 5\n")
chmod($hk67, 0o755)
$st67 = stat($hk67)
symlink("./nowhere-T67", $hk67 .. ".pre-hygiene")
-- Premise before the run, and every later assertion through is_link/link_target
-- — same reason as T64a. Against M33 the installer renames a regular file over
-- this link, so a bare read_link() would raise EINVAL rather than fail the row.
$f = $f + ok("T67a premise: exists() cannot see a dangling .pre-hygiene",
  exists($hk67 .. ".pre-hygiene") == false
    and is_link($hk67 .. ".pre-hygiene"),
  join(["exists=", exists($hk67 .. ".pre-hygiene"), " is_link=",
    is_link($hk67 .. ".pre-hygiene")], ""))
$c67 = $ROOT .. "/t67.conf.mix"
write_file($c67, replace(read_file($cp52), $rp52, $rp67))
$i67 = $ROOT .. "/install-t67.mix"
write_file($i67, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c67 .. "\""))
$o67 = run_installer([$MIX, $i67], {timeout: 900})
$sa67 = stat($hk67)
$f = $f + ok("T67b it is refused by hand, and the link is still there",
  $o67["exit_code"] == 2
    and contains($o67["stdout"] .. $o67["stderr"], "resolve by hand")
    and link_target($hk67 .. ".pre-hygiene") == "./nowhere-T67"
    and $sa67["ino"] == $st67["ino"],
  join(["", $o67["exit_code"], " same_ino=", $sa67["ino"] == $st67["ino"], " ",
    sanitize($o67["stdout"] .. $o67["stderr"])], ""))

-- T68 — the HOOK ITSELF is a dangling symlink. exists() called the slot empty,
-- so the installer skipped the chain entirely and its rename replaced the link
-- with the stub: somebody's hook reference gone, exit 0, "installed pre-commit".
-- With lstat the entry is seen, it is not ours, and preserving it fails the way
-- it should — copy() cannot follow a link to nowhere — so the run refuses and
-- touches nothing.
$rp68 = newrepo("t68-dangling-hook")
$hk68 = $rp68 .. "/.git/hooks/pre-commit"
symlink("./nowhere-T68", $hk68)
$c68 = $ROOT .. "/t68.conf.mix"
write_file($c68, replace(read_file($cp52), $rp52, $rp68))
$i68 = $ROOT .. "/install-t68.mix"
write_file($i68, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c68 .. "\""))
$o68 = run_installer([$MIX, $i68], {timeout: 900})
$sy68 = is_link($hk68)
$f = $f + ok("T68a a hook that is a dangling link is chained, not written over",
  $o68["exit_code"] == 2
    and contains($o68["stdout"] .. $o68["stderr"], "cannot preserve"),
  join(["", $o68["exit_code"], " ",
    sanitize($o68["stdout"] .. $o68["stderr"])], ""))
$f = $f + ok("T68b and the link survived, still pointing where it did",
  $sy68 and link_target($hk68) == "./nowhere-T68"
    and exists($hk68 .. ".pre-hygiene", {follow_symlinks: false}) == false,
  join(["is_symlink=", $sy68, " target=", link_target($hk68), " saved=",
    exists($hk68 .. ".pre-hygiene", {follow_symlinks: false})], ""))

-- T69 — the same lie in the HOOK BODY, where it costs a veto rather than a
-- file. run_prior() asked exists() whether there was a chained hook to run; a
-- dangling `.pre-hygiene` answered no and the prior hook's veto was dropped in
-- silence — the exact failure round twelve closed on the hooks-directory
-- lookup, reintroduced one line later. Fails closed now: the entry is there,
-- the spawn fails, and a chain that could not run is not a chain that passed.
$rp69 = newrepo("t69-dangling-prior")
$c69 = $ROOT .. "/t69.conf.mix"
write_file($c69, replace(read_file($cp52), $rp52, $rp69))
$i69 = $ROOT .. "/install-t69.mix"
write_file($i69, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c69 .. "\""))
$o69 = run_installer([$MIX, $i69], {timeout: 900})
symlink("./nowhere-T69", $rp69 .. "/.git/hooks/pre-commit.pre-hygiene")
write_file($rp69 .. "/clean.txt", "nothing private here\n")
must($rp69, ["git", "add", "-A"])
$v69 = run_argv(["git", "commit", "-m", "dangling prior"],
  {cwd: $rp69, timeout: 1800, max_output: 8388608})
$f = $f + ok("T69a premise: the gate installed cleanly before the link appeared",
  $o69["exit_code"] == 0
    and contains($o69["stdout"] .. $o69["stderr"], "installed pre-commit"),
  join(["", $o69["exit_code"], " ",
    sanitize($o69["stdout"] .. $o69["stderr"])], ""))
$f = $f + ok("T69b a chained hook that cannot run blocks, it does not pass",
  $v69["exit_code"] != 0
    and contains($v69["stdout"] .. $v69["stderr"], "did not run"),
  join(["", $v69["exit_code"], " ",
    sanitize($v69["stdout"] .. $v69["stderr"])], ""))

-- T70 — the two paths the stub will hand to Mix were checked with exists(), so
-- a DIRECTORY at either one passed the preflight. The install then reported
-- success and every commit afterwards exited 1, because Mix exits 1 on a path
-- it cannot run — an infrastructure mistake wearing the code reserved for "a
-- violation was found", on every commit, forever. is_file() plus an actual read
-- now refuses up front, and it has to refuse BEFORE anything is written: a
-- guard placed one statement too late is this arc's most repeated defect.
$rp70 = newrepo("t70-gate-is-a-dir")
$gd70 = $ROOT .. "/t70-gate-dir"
mkdir($gd70)
$c70 = $ROOT .. "/t70.conf.mix"
write_file($c70, replace(read_file($cp52), $rp52, $rp70))
$i70 = $ROOT .. "/install-t70.mix"
write_file($i70, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c70 .. "\""),
  "$CMCTL .. \"/_bin/check-public-hygiene.mix\"", "\"" .. $gd70 .. "\""))
$o70 = run_installer([$MIX, $i70], {timeout: 900})
$f = $f + ok("T70a a gate path that is a directory is refused, not installed",
  $o70["exit_code"] == 2
    and contains($o70["stdout"] .. $o70["stderr"], "not a regular file"),
  join(["", $o70["exit_code"], " ",
    sanitize($o70["stdout"] .. $o70["stderr"])], ""))
$f = $f + ok("T70b and it refused before writing a stub, not after",
  exists($rp70 .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  join(["stub_present=",
    exists($rp70 .. "/.git/hooks/pre-commit", {follow_symlinks: false})], ""))

-- T71 — round seventeen's re-review: the directory case was closed and its
-- sibling was not. A readable REGULAR FILE that is not Mix passed both the
-- is_file test and the read, the install reported success, and every commit
-- afterwards died on a parse error at exit 1 — again the code reserved for "a
-- mesh-private literal was found", again forever. The question is now put to
-- $MIX itself, because $MIX is what the stub's shebang names.
$rp71 = newrepo("t71-gate-is-not-mix")
$g71 = $ROOT .. "/t71-gate.txt"
write_file($g71, "this is not mix ((( \n")
$c71 = $ROOT .. "/t71.conf.mix"
write_file($c71, replace(read_file($cp52), $rp52, $rp71))
$i71 = $ROOT .. "/install-t71.mix"
write_file($i71, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c71 .. "\""),
  "$CMCTL .. \"/_bin/check-public-hygiene.mix\"", "\"" .. $g71 .. "\""))
$o71 = run_installer([$MIX, $i71], {timeout: 900})
$f = $f + ok("T71a a gate path that is readable but not Mix is refused",
  $o71["exit_code"] == 2
    and contains($o71["stdout"] .. $o71["stderr"], "is not valid Mix"),
  join(["", $o71["exit_code"], " ",
    sanitize($o71["stdout"] .. $o71["stderr"])], ""))
$f = $f + ok("T71b and it refused before writing a stub, not after",
  exists($rp71 .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  join(["stub_present=",
    exists($rp71 .. "/.git/hooks/pre-commit", {follow_symlinks: false})], ""))

-- T72 — the staging-name races are DEFERRED, and the reason given is that
-- anyone who can create a name in .git/hooks could already replace the hook.
-- That is only true of a directory its owner alone can write: make it group- or
-- world-writable and a different uid can swap the claimed name for a symlink
-- mid-install and have this installer write through it, outside the directory.
-- Cold review round seventeen called the deferral unsound without that property
-- ENFORCED, so it is enforced: refused on the write path, stated on --status.
-- Round forty rebuilt this fixture. It used to `chmod 0o775` and stop there,
-- which on this host leaves the directory group-writable to the OWNER'S OWN
-- private group — a group with exactly one member, whose write bit grants
-- nobody any access they did not already have. The installer refused on it
-- anyway, and this row asserted that refusal, so the row was pinning a false
-- positive in place: the naive mode-bit arm the installer used here never got
-- round thirty-eight's narrowing, and refusing every umask-002 repository was
-- the cost. Unifying the two arms removed the refusal and correctly took this
-- row red. The property T72 exists to prove is real and unchanged — a hooks
-- directory another identity can write must not be installed into — so the
-- fixture now creates a directory that genuinely is one, by chgrp'ing it to a
-- group with a second member. Nothing here is weakened; the fixture stopped
-- lying about what it built.
if $FGRP_OK == false then
  print(join(["SKIP  T72a/T72b/T72c (group ", $FGRP, " has no second member on",
    " this host, so no genuinely shared hooks directory can be built)"], ""))
else
  $rp72 = newrepo("t72-shared-hooks-dir")
  $cg72 = run_argv(["chgrp", $FGRP, $rp72 .. "/.git/hooks"], {timeout: 60})
  chmod($rp72 .. "/.git/hooks", 0o775)
  $c72 = $ROOT .. "/t72.conf.mix"
  write_file($c72, replace(read_file($cp52), $rp52, $rp72))
  $i72 = $ROOT .. "/install-t72.mix"
  write_file($i72, must_replace(read_file($INSTALL),
    "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c72 .. "\""))
  $o72 = run_installer([$MIX, $i72], {timeout: 900})
  -- The chgrp is asserted, not assumed. Without it the directory is writable
  -- only to a single-member group, the installer is right not to refuse, and
  -- every clause below would be measuring an unbuilt fixture.
  $f = $f + ok("T72a a group-writable hooks directory is refused, not installed",
    $cg72["exit_code"] == 0
      and $o72["exit_code"] == 2
      and contains($o72["stdout"] .. $o72["stderr"], "group-writable"),
    join(["chgrp=", "" .. $cg72["exit_code"], " ", "" .. $o72["exit_code"], " ",
      sanitize($o72["stdout"] .. $o72["stderr"])], ""))
  $f = $f + ok("T72b and nothing was written there",
    exists($rp72 .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
    join(["stub_present=",
      exists($rp72 .. "/.git/hooks/pre-commit", {follow_symlinks: false})], ""))
  $s72 = run_installer([$MIX, $i72, "--status"], {timeout: 900})
  -- The name of this row used to say "because reading changes nothing", which is
  -- a claim about the whole run; what it measures is narrower and is all it now
  -- says: a hooks directory that stops an install only produces a warning here.
  -- --status is not write-free — it still creates and removes one probe directory
  -- under TMPDIR to measure the interpreter — and what it does when it cannot even
  -- do that is T85's business, not this row's.
  --
  -- Round forty: the warning is still a warning rather than the install path's
  -- refusal, which is the whole subject of the row; what changed is that the
  -- run now also ends at 2 for having reported unverified state. $DONE is what
  -- separates "reported it all, then refused" from "refused instead".
  $f = $f + ok("T72c a refusing hooks directory is only a warning under --status",
    $s72["exit_code"] == 2
      and contains($s72["stdout"] .. $s72["stderr"], $DONE)
      and contains($s72["stdout"] .. $s72["stderr"], "WARNING")
      and contains($s72["stdout"] .. $s72["stderr"], "group-writable"),
    join(["", $s72["exit_code"], " ",
      sanitize($s72["stdout"] .. $s72["stderr"])], ""))
end

-- T73 — the claim() refusal once said "nothing was changed" unconditionally,
-- although its second call site had already preserved the foreign hook as
-- .pre-hygiene. Round twenty-seven legitimately removes that intermediate
-- state: an occupied stub staging name is visible during fleet preflight, so
-- the preservation step must never run. This shipped assertion therefore
-- changes from "the message names the copy it created" to "the message says
-- preflight found it before mutation, and no copy exists". Removing only the
-- preflight staging check reconstructs the old sequence and turns both state
-- assertions red.
$rp73 = newrepo("t73-staging-name-taken-after-chain")
write_file($rp73 .. "/.git/hooks/pre-commit", "#!/bin/sh\nexit 0\n")
chmod($rp73 .. "/.git/hooks/pre-commit", 0o755)
write_file($rp73 .. "/.git/hooks/pre-commit.hygiene-tmp", "occupied\n")
$c73 = $ROOT .. "/t73.conf.mix"
write_file($c73, replace(read_file($cp52), $rp52, $rp73))
$i73 = $ROOT .. "/install-t73.mix"
write_file($i73, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c73 .. "\""))
$o73 = run_installer([$MIX, $i73], {timeout: 900})
$f = $f + ok("T73a an occupied stub staging path after a chain still refuses at 2",
  $o73["exit_code"] == 2,
  join(["", $o73["exit_code"], " ",
    sanitize($o73["stdout"] .. $o73["stderr"])], ""))
$f = $f + ok("T73b and the refusal says preflight found it before mutation",
  contains($o73["stdout"] .. $o73["stderr"],
    "Fleet preflight found it before any repository was changed")
    and contains($o73["stdout"] .. $o73["stderr"],
      ".pre-hygiene by this run") == false,
  sanitize($o73["stdout"] .. $o73["stderr"]))
$f = $f + ok("T73c and no .pre-hygiene copy was created",
  exists($rp73 .. "/.git/hooks/pre-commit.pre-hygiene",
    {follow_symlinks: false}) == false
    and read_file($rp73 .. "/.git/hooks/pre-commit") == "#!/bin/sh\nexit 0\n",
  join(["saved_present=",
    exists($rp73 .. "/.git/hooks/pre-commit.pre-hygiene",
      {follow_symlinks: false})], ""))

-- T74 — git hands pre-push the remote NAME for a configured remote but the URL
-- itself for `git push <url> …`, and a URL may carry credentials. The
-- "cannot read X's refs" and "did not name a push destination" lines are
-- ORDINARY paths, so the password went to the terminal and to anything
-- capturing hook output. sanitize() makes bytes printable; it does not make a
-- secret printable.
$rp74 = newrepo("t74-credential-in-remote")
write_file($rp74 .. "/clean.txt", "nothing private here\n")
must($rp74, ["git", "add", "-A"])
must($rp74, ["git", "commit", "-q", "-m", "base"])
$r74 = run_argv([$MIX, $HOOK, "pre-push",
  "https://probe:s3cr3t-token@example.invalid/repo.git"],
  {cwd: $rp74, timeout: 900, stdin: "", max_output: 8388608})
$f = $f + ok("T74a a credential in the remote URL is not printed",
  contains($r74["stdout"] .. $r74["stderr"], "s3cr3t-token") == false,
  sanitize($r74["stdout"] .. $r74["stderr"]))
$f = $f + ok("T74b the host is still named, so the line is still actionable",
  contains($r74["stdout"] .. $r74["stderr"], "***@example.invalid"),
  sanitize($r74["stdout"] .. $r74["stderr"]))

-- T75 — a chained hook's veto must block the commit, and must say whose refusal
-- it is: 1 is this arc's code for "a mesh-private literal was found", so a
-- foreign hook failing on its own missing dependency looked, from outside,
-- exactly like this gate finding a leak. The attribution line is the difference
-- between "your tree is dirty" and "someone else's hook said no and this gate
-- never ran". T81 covers the exit code the veto now carries.
$rp75 = newrepo("t75-chained-veto-attributed")
write_file($rp75 .. "/.git/hooks/pre-commit", "#!/bin/sh\nexit 1\n")
chmod($rp75 .. "/.git/hooks/pre-commit", 0o755)
$c75 = $ROOT .. "/t75.conf.mix"
write_file($c75, replace(read_file($cp52), $rp52, $rp75))
$i75 = $ROOT .. "/install-t75.mix"
write_file($i75, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c75 .. "\""))
$o75 = run_installer([$MIX, $i75], {timeout: 900})
write_file($rp75 .. "/clean.txt", "nothing private here\n")
must($rp75, ["git", "add", "-A"])
$v75 = run_argv(["git", "commit", "-m", "chained veto"],
  {cwd: $rp75, timeout: 1800, max_output: 8388608})
$f = $f + ok("T75a premise: the foreign hook was chained and the gate installed",
  $o75["exit_code"] == 0
    and contains($o75["stdout"] .. $o75["stderr"], "chained existing pre-commit"),
  join(["", $o75["exit_code"], " ",
    sanitize($o75["stdout"] .. $o75["stderr"])], ""))
$f = $f + ok("T75b a chained veto blocks, and says whose refusal it is",
  $v75["exit_code"] != 0
    and contains($v75["stdout"] .. $v75["stderr"], "ITS decision")
    and contains($v75["stdout"] .. $v75["stderr"], "has NOT run"),
  join(["", $v75["exit_code"], " ",
    sanitize($v75["stdout"] .. $v75["stderr"])], ""))

-- T76 — the usage line omitted commit-msg, which is one of the three modes the
-- installer writes. The only operator who reads it is one already confused.
$r76 = run_argv([$MIX, $HOOK], {cwd: $ROOT, timeout: 300})
$f = $f + ok("T76 the usage line lists every mode the installer installs",
  $r76["exit_code"] == 2
    and contains($r76["stdout"] .. $r76["stderr"], "commit-msg"),
  join(["", $r76["exit_code"], " ",
    sanitize($r76["stdout"] .. $r76["stderr"])], ""))

-- T77 — the installer's own lstat probe asks the interpreter RUNNING it, and
-- that is not the interpreter the hooks will use: the stub's shebang names
-- $MIX. Install with a current mix while $MIX is an older one and every guard
-- in the hook silently reverts to the follow-the-symlink question, on a gate
-- whose install said nothing. The probe is put to $MIX out of process, and it
-- MEASURES: $MIX is asked to lstat a dangling symlink and report what it saw.
-- The two cases are different failures and get different refusals — an
-- interpreter that says nothing has not answered the question (a), and one that
-- answers "lstat=no follow=no" has answered it wrongly (d). The earlier form
-- inferred capability from an error instead, which counted a spawn failure as a
-- pass and let an interpreter that type-checks the option while ignoring it
-- through; round eighteen's cold review.
$rp77 = newrepo("t77-stub-interpreter-is-old")
$m77 = $ROOT .. "/t77-fake-mix"
write_file($m77, "#!/bin/sh\nexit 0\n")
chmod($m77, 0o755)
$c77 = $ROOT .. "/t77.conf.mix"
write_file($c77, replace(read_file($cp52), $rp52, $rp77))
$i77 = $ROOT .. "/install-t77.mix"
write_file($i77, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c77 .. "\""),
  "$MIX = \"/opt/cosmix/bin/mix\"", "$MIX = \"" .. $m77 .. "\""))
$o77 = run_installer([$MIX, $i77], {timeout: 900})
$f = $f + ok("T77a an interpreter at $MIX that answers nothing is refused",
  $o77["exit_code"] == 2
    and contains($o77["stdout"] .. $o77["stderr"], "could not be asked"),
  join(["", $o77["exit_code"], " ",
    sanitize($o77["stdout"] .. $o77["stderr"])], ""))
$f = $f + ok("T77b and the refusal names that binary, not the one being run",
  contains($o77["stdout"] .. $o77["stderr"], $m77),
  sanitize($o77["stdout"] .. $o77["stderr"]))
$f = $f + ok("T77c and no stub was written naming it",
  exists($rp77 .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  join(["stub_present=",
    exists($rp77 .. "/.git/hooks/pre-commit", {follow_symlinks: false})], ""))
-- The interpreter that is the real hazard: it accepts the option, looks at it
-- enough to type-check, and answers the follow-the-symlink question anyway.
-- Exit status alone cannot see that — this one exits 0 — so the probe requires
-- the measurement itself on stdout.
$rp77b = newrepo("t77-interpreter-ignores-option")
$m77b = $ROOT .. "/t77-blind-mix"
write_file($m77b, "#!/bin/sh\necho 'lstat=no follow=no'\nexit 0\n")
chmod($m77b, 0o755)
$c77b = $ROOT .. "/t77b.conf.mix"
write_file($c77b, replace(read_file($cp52), $rp52, $rp77b))
$i77b = $ROOT .. "/install-t77b.mix"
write_file($i77b, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c77b .. "\""),
  "$MIX = \"/opt/cosmix/bin/mix\"", "$MIX = \"" .. $m77b .. "\""))
$o77b = run_installer([$MIX, $i77b], {timeout: 900})
$f = $f + ok("T77d an interpreter that answers the option wrongly is refused",
  $o77b["exit_code"] == 2
    and contains($o77b["stdout"] .. $o77b["stderr"], "does not honour it"),
  join(["", $o77b["exit_code"], " ",
    sanitize($o77b["stdout"] .. $o77b["stderr"])], ""))
$f = $f + ok("T77e and it too wrote nothing",
  exists($rp77b .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  join(["stub_present=",
    exists($rp77b .. "/.git/hooks/pre-commit", {follow_symlinks: false})], ""))

-- T78 — round eighteen: `mix --check` is a PARSE check, and a gate that parses
-- is not a gate that runs. A file calling a function defined nowhere passed it,
-- the install reported success, and every commit thereafter died on an uncaught
-- runtime error at exit 1 — the false violation the parse check was added to
-- prevent, one indirection later. `mix lint` resolves names, so it catches it
-- at install time instead.
$rp78 = newrepo("t78-gate-parses-but-cannot-run")
$g78 = $ROOT .. "/t78-gate.mix"
write_file($g78, "fn main()\n  return no_such_builtin_anywhere()\nend\nmain()\n")
chmod($g78, 0o755)
$c78 = $ROOT .. "/t78.conf.mix"
write_file($c78, replace(read_file($cp52), $rp52, $rp78))
$i78 = $ROOT .. "/install-t78.mix"
write_file($i78, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c78 .. "\""),
  "$GATE = $CMCTL .. \"/_bin/check-public-hygiene.mix\"",
  "$GATE = \"" .. $g78 .. "\""))
$o78 = run_installer([$MIX, $i78], {timeout: 900})
$f = $f + ok("T78a a gate that parses but calls an undefined name is refused",
  $o78["exit_code"] == 2
    and contains($o78["stdout"] .. $o78["stderr"], "not valid Mix")
    and contains($o78["stdout"] .. $o78["stderr"], "no_such_builtin_anywhere"),
  join(["", $o78["exit_code"], " ",
    sanitize($o78["stdout"] .. $o78["stderr"])], ""))
$f = $f + ok("T78b and it refused before writing a stub, not after",
  exists($rp78 .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  join(["stub_present=",
    exists($rp78 .. "/.git/hooks/pre-commit", {follow_symlinks: false})], ""))

-- T79 — the owner-only property has to hold over the whole PATH, not just the
-- last component. With a world-writable ancestor, another uid swaps the
-- ancestor and the installer writes a gate stub somewhere it never checked;
-- checking only .git/hooks' own bits reports a guarantee it does not have.
-- Round eighteen. The fixture is a direct path under a world-writable ancestor
-- and creates no symlink, so this row is about the ANCESTOR chain only — the
-- symlink-reached hooks directory is T86, and neither stages the swap itself.
-- The sticky case is the positive control and it is everywhere already: every
-- probe repo in this suite lives under /tmp, which is world-writable AND
-- sticky, so an exemption that did not exist would fail the whole file.
$open79 = $ROOT .. "/t79-open-ancestor"
mkdir($open79)
chmod($open79, 0o777)
$rp79 = $open79 .. "/repo"
mkdir($rp79)
must($rp79, ["git", "init", "-q", "-b", "main"])
must($rp79, ["git", "config", "user.email", "probe@example.com"])
must($rp79, ["git", "config", "user.name", "probe"])
$c79 = $ROOT .. "/t79.conf.mix"
write_file($c79, replace(read_file($cp52), $rp52, $rp79))
$i79 = $ROOT .. "/install-t79.mix"
write_file($i79, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c79 .. "\""))
$o79 = run_installer([$MIX, $i79], {timeout: 900})
$f = $f + ok("T79a a world-writable ANCESTOR is refused, not just the dir",
  $o79["exit_code"] == 2
    and contains($o79["stdout"] .. $o79["stderr"], "ancestor")
    and contains($o79["stdout"] .. $o79["stderr"], $open79),
  join(["", $o79["exit_code"], " ",
    sanitize($o79["stdout"] .. $o79["stderr"])], ""))
$f = $f + ok("T79b and nothing was written below it",
  exists($rp79 .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  join(["stub_present=",
    exists($rp79 .. "/.git/hooks/pre-commit", {follow_symlinks: false})], ""))
$s79 = run_installer([$MIX, $i79, "--status"], {timeout: 900})
-- Round forty: the warning still replaces the refusal — the report is produced
-- in full, which is what this row is about — but an unverified ancestor now
-- also makes the run exit 2 rather than 0. $DONE is what keeps that a report
-- rather than a collapse; see its definition.
$f = $f + ok("T79c --status warns about the ancestor instead of refusing",
  $s79["exit_code"] == 2
    and contains($s79["stdout"] .. $s79["stderr"], $DONE)
    and contains($s79["stdout"] .. $s79["stderr"], "WARNING")
    and contains($s79["stdout"] .. $s79["stderr"], "ancestor"),
  join(["", $s79["exit_code"], " ",
    sanitize($s79["stdout"] .. $s79["stderr"])], ""))

-- T80 — a credential does not have to sit in the userinfo. `?access_token=…`
-- has no "@" at all, so the first cut at redact() returned the URL unchanged
-- and printed the secret; and an "@" inside a query parameter was being read as
-- userinfo, which replaced the real host in the diagnostic with the one in the
-- parameter. Round eighteen's cold review, both halves.
$rp80 = newrepo("t80-credential-in-query")
write_file($rp80 .. "/clean.txt", "nothing private here\n")
must($rp80, ["git", "add", "-A"])
must($rp80, ["git", "commit", "-q", "-m", "base"])
$r80 = run_argv([$MIX, $HOOK, "pre-push",
  "https://example.invalid/repo.git?access_token=s3cr3t-query"],
  {cwd: $rp80, timeout: 900, stdin: "", max_output: 8388608})
$f = $f + ok("T80a a credential in the QUERY is not printed either",
  contains($r80["stdout"] .. $r80["stderr"], "s3cr3t-query") == false
    and $r80["exit_code"] != nil,
  join(["", $r80["exit_code"], " ",
    sanitize($r80["stdout"] .. $r80["stderr"])], ""))
$f = $f + ok("T80b and the real host is still named",
  contains($r80["stdout"] .. $r80["stderr"], "example.invalid/repo.git"),
  sanitize($r80["stdout"] .. $r80["stderr"]))
$r80b = run_argv([$MIX, $HOOK, "pre-push",
  "https://example.invalid?next=user@elsewhere.invalid"],
  {cwd: $rp80, timeout: 900, stdin: "", max_output: 8388608})
$f = $f + ok("T80c an @ in the query is not mistaken for userinfo",
  contains($r80b["stdout"] .. $r80b["stderr"], "https://example.invalid")
    and contains($r80b["stdout"] .. $r80b["stderr"], "***@elsewhere") == false,
  sanitize($r80b["stdout"] .. $r80b["stderr"]))

-- T81 — a chained hook's veto stands, but it does not get to wear this gate's
-- exit code. 1 means "a mesh-private literal was found"; a foreign hook exiting
-- 1 for its own reasons means the scan never ran, which is what 2 is for. Git
-- only distinguishes zero from non-zero, so preserving the foreign code bought
-- nothing and cost the one distinction this arc is built on — and an arbitrary
-- foreign status escaped the 0/1/2 contract altogether. Round eighteen.
$rp81 = newrepo("t81-chained-veto-is-not-a-violation")
write_file($rp81 .. "/.git/hooks/pre-commit", "#!/bin/sh\nexit 42\n")
chmod($rp81 .. "/.git/hooks/pre-commit", 0o755)
$c81 = $ROOT .. "/t81.conf.mix"
write_file($c81, replace(read_file($cp52), $rp52, $rp81))
$i81 = $ROOT .. "/install-t81.mix"
write_file($i81, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c81 .. "\""))
$o81 = run_installer([$MIX, $i81], {timeout: 900})
$v81 = run_argv([$MIX, $HOOK, "pre-commit"],
  {cwd: $rp81, timeout: 900, stdin: "", max_output: 8388608})
$f = $f + ok("T81a premise: the foreign hook exiting 42 was chained",
  $o81["exit_code"] == 0
    and contains($o81["stdout"] .. $o81["stderr"], "chained existing pre-commit"),
  join(["", $o81["exit_code"], " ",
    sanitize($o81["stdout"] .. $o81["stderr"])], ""))
$f = $f + ok("T81b its veto blocks at 2, not at the code for a violation",
  $v81["exit_code"] == 2,
  join(["", $v81["exit_code"], " ",
    sanitize($v81["stdout"] .. $v81["stderr"])], ""))
$f = $f + ok("T81c and the original status is still named",
  contains($v81["stdout"] .. $v81["stderr"], "exited 42"),
  sanitize($v81["stdout"] .. $v81["stderr"]))

-- T82 — exit 1 is a CLAIM ABOUT THE TREE ("mesh-private data is in here"), and
-- until round twenty anything that made the gate die produced it too: a gate
-- moved, made unreadable, or raising exits 1 from the interpreter itself. Every
-- commit in all three repos would then be blocked by a violation that had never
-- been looked for, with the operator sent hunting for a leak that is not there.
-- The gate now says on its last line that it reached its end; the hook will not
-- read a verdict without it. T82c is the over-refusal control: a marked 1 is a
-- real finding and must still block AT 1.
$rp82 = newrepo("t82-gate-died-without-scanning")
write_file($rp82 .. "/clean.txt", "nothing private here\n")
must($rp82, ["git", "add", "-A"])
must($rp82, ["git", "commit", "-q", "-m", "base"])
fn hook_with_gate($tag, $body)
  $g = $ROOT .. "/" .. $tag .. "-gate.mix"
  write_file($g, $body)
  chmod($g, 0o755)
  $h = $ROOT .. "/" .. $tag .. "-hook.mix"
  write_file($h, must_replace(read_file($HOOK),
    "$GATE = $CMCTL .. \"/_bin/check-public-hygiene.mix\"",
    "$GATE = \"" .. $g .. "\""))
  chmod($h, 0o755)
  return $h
end
$h82a = hook_with_gate("t82a", "print(\"scanning...\")\nexit(1)\n")
$v82a = run_argv([$MIX, $h82a, "pre-commit"],
  {cwd: $rp82, timeout: 900, stdin: "", max_output: 8388608})
$f = $f + ok("T82a a gate that exits 1 without finishing is not a verdict",
  $v82a["exit_code"] == 2
    and contains($v82a["stdout"] .. $v82a["stderr"],
      "without reporting that it finished"),
  join(["", $v82a["exit_code"], " ",
    sanitize($v82a["stdout"] .. $v82a["stderr"])], ""))
$f = $f + ok("T82b and it does not print the BLOCKED leak advice for it",
  contains($v82a["stdout"] .. $v82a["stderr"], "BLOCKED") == false,
  sanitize($v82a["stdout"] .. $v82a["stderr"]))
$h82c = hook_with_gate("t82c",
  "print(\"a match\")\nprint(\"hygiene-scan-complete: 1\")\nexit(1)\n")
$v82c = run_argv([$MIX, $h82c, "pre-commit"],
  {cwd: $rp82, timeout: 900, stdin: "", max_output: 8388608})
$f = $f + ok("T82c a MARKED 1 is a real finding and still blocks at 1",
  $v82c["exit_code"] == 1
    and contains($v82c["stdout"] .. $v82c["stderr"], "BLOCKED"),
  join(["", $v82c["exit_code"], " ",
    sanitize($v82c["stdout"] .. $v82c["stderr"])], ""))
$f = $f + ok("T82d and the marker itself is never shown to the operator",
  contains($v82c["stdout"] .. $v82c["stderr"], "hygiene-scan-complete") == false,
  sanitize($v82c["stdout"] .. $v82c["stderr"]))
-- The two files carry the same literal in two places, which is the price of the
-- gate being a separate process. If they ever drift, every commit starts
-- exiting 2 — fail-closed, but only if someone notices why.
$f = $f + ok("T82e the gate and the hook agree on what the marker string is",
  contains(read_file($GATE), "$COMPLETE = \"hygiene-scan-complete:\"")
    and contains(read_file($HOOK), "$COMPLETE = \"hygiene-scan-complete:\""),
  "marker literals compared in both sources")

-- T83 — round twenty: the query was being dropped but the FRAGMENT was not, so
-- `…/repo.git#access_token=…` printed the token in full. Everything from the
-- first `?` or `#` is a tail this code has not parsed, so it does not get
-- printed; the host stays, because a diagnostic nobody can act on is its own
-- kind of failure.
$rp83 = newrepo("t83-credential-in-fragment")
write_file($rp83 .. "/clean.txt", "nothing private here\n")
must($rp83, ["git", "add", "-A"])
must($rp83, ["git", "commit", "-q", "-m", "base"])
$r83 = run_argv([$MIX, $HOOK, "pre-push",
  "https://example.invalid/repo.git#access_token=s3cr3t-fragment"],
  {cwd: $rp83, timeout: 900, stdin: "", max_output: 8388608})
$f = $f + ok("T83a a credential in the FRAGMENT is not printed either",
  contains($r83["stdout"] .. $r83["stderr"], "s3cr3t-fragment") == false
    and $r83["exit_code"] != nil,
  join(["", $r83["exit_code"], " ",
    sanitize($r83["stdout"] .. $r83["stderr"])], ""))
$f = $f + ok("T83b and the real host is still named",
  contains($r83["stdout"] .. $r83["stderr"], "example.invalid/repo.git"),
  sanitize($r83["stdout"] .. $r83["stderr"]))

-- T84 — the behavioural probe of $MIX prints its answer, and round nineteen
-- accepted that answer however the process ended. A wrapper that echoes the
-- expected line and then dies has not measured anything; the status is part of
-- the answer. T77d covers the interpreter that answers WRONGLY — this is the
-- one that answers RIGHT and fails.
$rp84 = newrepo("t84-probe-answers-then-dies")
$m84 = $ROOT .. "/t84-mix-answers-then-dies"
write_file($m84, "#!/bin/sh\necho 'lstat=yes follow=no'\nexit 7\n")
chmod($m84, 0o755)
$c84 = $ROOT .. "/t84.conf.mix"
write_file($c84, replace(read_file($cp52), $rp52, $rp84))
$i84 = $ROOT .. "/install-t84.mix"
write_file($i84, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c84 .. "\""),
  "$MIX = \"/opt/cosmix/bin/mix\"", "$MIX = \"" .. $m84 .. "\""))
$o84 = run_installer([$MIX, $i84], {timeout: 900})
$f = $f + ok("T84a an interpreter that answers right and then dies is refused",
  $o84["exit_code"] == 2
    and contains($o84["stdout"] .. $o84["stderr"], "could not be asked"),
  join(["", $o84["exit_code"], " ",
    sanitize($o84["stdout"] .. $o84["stderr"])], ""))
$f = $f + ok("T84b and it wrote nothing",
  exists($rp84 .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  join(["stub_present=",
    exists($rp84 .. "/.git/hooks/pre-commit", {follow_symlinks: false})], ""))

-- T85 — --status is a QUERY. Round twenty caught it hard-refusing when it could
-- not write a temp directory: the interpreter measurement was added as a gate
-- and applied to the read-only mode too, so `TMPDIR=/proc … --status` exited 2
-- without reporting a single hook. A query that cannot run is not safer than
-- one that qualifies its answer, so it now warns and reports anyway.
$rp85 = newrepo("t85-status-with-no-writable-tmp")
$c85 = $ROOT .. "/t85.conf.mix"
write_file($c85, replace(read_file($cp52), $rp52, $rp85))
$i85 = $ROOT .. "/install-t85.mix"
write_file($i85, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c85 .. "\""))
-- The first cut pointed at an absent name, and mkdir() built it. The second cut
-- pointed at /proc and proved the refusal by TRYING a write outside ROOT — the
-- boundary this round is removing. A private bwrap mount now makes a directory
-- under ROOT read-only only for each child. The premise still calls mkdir for
-- real, but the kernel refusal and every possible artefact stay inside the
-- process namespace and this run's claimed tree.
$TMP85 = $ROOT .. "/t85-read-only-tmp"
mkdir($TMP85)
$probe85 = $ROOT .. "/t85-unwritable-probe.mix"
write_file($probe85, join([
  "try\n",
  "  mkdir(\"" .. $TMP85 .. "/premise\", {parents: false})\n",
  "  print(\"WRITABLE\")\n",
  "catch $e\n",
  "  print(\"UNWRITABLE\")\n",
  "end\n"
], ""))
$p85 = run_argv(["bwrap", "--dev-bind", "/", "/",
  "--ro-bind", $TMP85, $TMP85, $MIX, $probe85], {timeout: 300})
$f = $f + ok("T85p premise: the TMPDIR this probe uses really cannot be written",
  $p85["exit_code"] == 0 and trim($p85["stdout"]) == "UNWRITABLE",
  join(["", $p85["exit_code"], " ",
    sanitize($p85["stdout"] .. $p85["stderr"])], ""))
$s85 = run_argv(["bwrap", "--dev-bind", "/", "/",
  "--ro-bind", $TMP85, $TMP85, $MIX, $i85, "--status"],
  {timeout: 900, env: {TMPDIR: $TMP85}})
-- Round forty: an interpreter it could not check is unverified state, so the
-- run now ends at 2. The point of the row is unchanged and is what the other
-- two clauses measure — it still ANSWERS, naming the hook and finishing the
-- report, rather than dying at the first thing it could not do.
--
-- The token moved from ABSENT to ABSENCE UNVERIFIED, and on THIS fixture that
-- is the whole point rather than a rename to absorb: the warning this run
-- prints says in as many words that "a hook that is a dangling symlink may be
-- reported below as ABSENT". A bare ABSENT here would be the false verified
-- answer. Asserting the qualified token is therefore stricter than the row it
-- replaces — it demands the caveat be carried on the state token an operator
-- skims, not only in the prose above it. Note ABSENT is NOT a substring of
-- ABSENCE, so this assertion cannot be satisfied by the old wording.
$f = $f + ok("T85a --status still answers when it cannot write a temp dir",
  $s85["exit_code"] == 2
    and contains($s85["stdout"] .. $s85["stderr"], $DONE)
    and contains($s85["stdout"] .. $s85["stderr"],
      "pre-commit: ABSENCE UNVERIFIED"),
  join(["", $s85["exit_code"], " ",
    sanitize($s85["stdout"] .. $s85["stderr"])], ""))
$f = $f + ok("T85b and it says what it could not check, rather than implying it did",
  contains($s85["stdout"] .. $s85["stderr"], "WARNING")
    and contains($s85["stdout"] .. $s85["stderr"], "could not check the interpreter"),
  sanitize($s85["stdout"] .. $s85["stderr"]))
-- The install path must NOT have been softened by the same change: there the
-- measurement is load-bearing, because it decides whether a dangling symlink is
-- visible before anything is written over it.
$o85 = run_argv(["bwrap", "--dev-bind", "/", "/",
  "--ro-bind", $TMP85, $TMP85, $MIX, $i85],
  {timeout: 900, env: {TMPDIR: $TMP85}})
$f = $f + ok("T85c but installing with no writable temp still refuses at 2",
  $o85["exit_code"] == 2
    and contains($o85["stdout"] .. $o85["stderr"], "nothing was changed"),
  join(["", $o85["exit_code"], " ",
    sanitize($o85["stdout"] .. $o85["stderr"])], ""))

-- T86 — realpath()'s own contract says canonicalise-then-use is not an
-- authorisation primitive: the check must be made against the path that is then
-- OPENED. Round twenty found the walk proving one path safe while install()
-- kept building its targets from the name git returned, so with
-- core.hooksPath pointing at a symlink the checked directory and the written
-- directory were different objects and the link could be repointed in between.
--
-- Honest about what this probe is, and round twenty-one's cold review pushed it
-- further than the previous wording: T86a asserts on the REPORT ("resolves
-- to: …"), and T86b asserts the stub is in the resolved directory — which it
-- would be either way, because writing through the link and writing through its
-- target land on the same inode when nobody repoints it in between. So neither
-- row can tell the fixed installer from the one that built its targets from
-- git's name; the write-through property is argued from the resolved path
-- having no swappable component, and is listed as unprobed in the journal.
-- What these two DO catch is the installer writing somewhere else entirely, or
-- reporting a path it did not use, which is worth keeping.
$rp86 = newrepo("t86-hooks-dir-reached-by-symlink")
$real86 = $ROOT .. "/t86-real-hooks"
mkdir($real86)
symlink($real86, $ROOT .. "/t86-hooks-link")
must($rp86, ["git", "config", "core.hooksPath", $ROOT .. "/t86-hooks-link"])
$c86 = $ROOT .. "/t86.conf.mix"
write_file($c86, replace(read_file($cp52), $rp52, $rp86))
$i86 = $ROOT .. "/install-t86.mix"
write_file($i86, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c86 .. "\""))
$o86 = run_installer([$MIX, $i86], {timeout: 900})
$f = $f + ok("T86a a hooks dir reached by a symlink installs through the real path",
  $o86["exit_code"] == 0
    and contains($o86["stdout"] .. $o86["stderr"], "resolves to: " .. $real86),
  join(["", $o86["exit_code"], " ",
    sanitize($o86["stdout"] .. $o86["stderr"])], ""))
$f = $f + ok("T86b and the stub really is in the resolved directory",
  exists($real86 .. "/pre-commit", {follow_symlinks: false}),
  join(["stub_present=",
    exists($real86 .. "/pre-commit", {follow_symlinks: false})], ""))
-- The negative control for T87 below: this hooks directory is ALSO reached by a
-- symlink, and every component of that alias is private, so the alias walk must
-- stay silent here. Without this row, "refuse a symlinked hooks path" would pass
-- T87 by refusing all of them.
$f = $f + ok("T86c a symlink alias whose own path is private is NOT refused",
  $o86["exit_code"] == 0
    and contains($o86["stdout"] .. $o86["stderr"], "re-traverses") == false,
  join(["", $o86["exit_code"], " ",
    sanitize($o86["stdout"] .. $o86["stderr"])], ""))

-- T87 — the resolved walk protects THIS INSTALLER's writes. git does not use the
-- resolved path: it re-reads core.hooksPath and re-traverses the alias on every
-- hook it runs, so a spotless resolved chain says nothing about a world-writable
-- directory sitting in the middle of the alias. Round twenty-one's cold review.
-- The fixture is the concrete shape it named: a private real hooks directory
-- reached through a link in a world-writable, non-sticky directory. Whoever owns
-- that directory replaces the link the moment the install finishes and every
-- hook afterwards runs whatever they point it at — or nothing at all.
$rp87 = newrepo("t87-alias-through-open-dir")
$real87 = $ROOT .. "/t87-real-hooks"
mkdir($real87)
$open87 = $ROOT .. "/t87-open-alias"
mkdir($open87)
chmod($open87, 0o777)
$link87 = $open87 .. "/hooks-link"
symlink($real87, $link87)
must($rp87, ["git", "config", "core.hooksPath", $link87])
$c87 = $ROOT .. "/t87.conf.mix"
write_file($c87, replace(read_file($cp52), $rp52, $rp87))
$i87 = $ROOT .. "/install-t87.mix"
write_file($i87, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c87 .. "\""))
$o87 = run_installer([$MIX, $i87], {timeout: 900})
$f = $f + ok("T87a a world-writable dir in the ALIAS chain is refused",
  $o87["exit_code"] == 2
    and contains($o87["stdout"] .. $o87["stderr"], $open87)
    and contains($o87["stdout"] .. $o87["stderr"], "re-traverses"),
  join(["", $o87["exit_code"], " ",
    sanitize($o87["stdout"] .. $o87["stderr"])], ""))
$f = $f + ok("T87b and no stub was written into the private real directory",
  exists($real87 .. "/pre-commit", {follow_symlinks: false}) == false,
  join(["stub_present=",
    exists($real87 .. "/pre-commit", {follow_symlinks: false})], ""))
$s87 = run_installer([$MIX, $i87, "--status"], {timeout: 900})
-- Round forty: as T79c, for the alias chain rather than the resolved one.
$f = $f + ok("T87c --status warns about the alias instead of refusing",
  $s87["exit_code"] == 2
    and contains($s87["stdout"] .. $s87["stderr"], $DONE)
    and contains($s87["stdout"] .. $s87["stderr"], "WARNING")
    and contains($s87["stdout"] .. $s87["stderr"], "re-traverses")
    and contains($s87["stdout"] .. $s87["stderr"],
      "pre-commit: ABSENCE UNVERIFIED"),
  join(["", $s87["exit_code"], " ",
    sanitize($s87["stdout"] .. $s87["stderr"])], ""))

-- T88 — `contains($argv, "--status")` answered one question and ignored every
-- other argument, so the typo one key away — `--stats` — was not a status run at
-- all: the hooks were installed by a command that had asked only to look. Round
-- twenty-one's cold review. An argument this installer does not understand is a
-- request it cannot honour, and the refusal has to come before anything is
-- written.
$rp88 = newrepo("t88-unknown-argument")
$c88 = $ROOT .. "/t88.conf.mix"
write_file($c88, replace(read_file($cp52), $rp52, $rp88))
$i88 = $ROOT .. "/install-t88.mix"
write_file($i88, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c88 .. "\""))
$o88 = run_installer([$MIX, $i88, "--stats"], {timeout: 900})
$f = $f + ok("T88a a near-miss argument is refused, not silently ignored",
  $o88["exit_code"] == 2
    and contains($o88["stdout"] .. $o88["stderr"], "unknown argument"),
  join(["", $o88["exit_code"], " ",
    sanitize($o88["stdout"] .. $o88["stderr"])], ""))
$f = $f + ok("T88b and above all it did not INSTALL on a look-only command",
  exists($rp88 .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  join(["stub_present=",
    exists($rp88 .. "/.git/hooks/pre-commit", {follow_symlinks: false})], ""))
-- The control: the one argument it does take must still work after the
-- validation, or this fix trades a silent install for a broken status.
$s88 = run_installer([$MIX, $i88, "--status"], {timeout: 900})
$f = $f + ok("T88c and --status itself still works",
  $s88["exit_code"] == 0
    and contains($s88["stdout"] .. $s88["stderr"], "pre-commit: ABSENT"),
  join(["", $s88["exit_code"], " ",
    sanitize($s88["stdout"] .. $s88["stderr"])], ""))

-- T89 — run_argv TRUNCATES a stream past max_output rather than failing, and the
-- gate prints its completion marker LAST, so a capture that hits the cap loses
-- exactly the thing the marker exists to prove. The hook then read a perfectly
-- healthy gate as one that had been "moved, made unreadable, or that raised" and
-- sent the operator to check a file that was fine. Round twenty-one's cold
-- review. The verdict is still 2 — that part was already right — so this row is
-- about the DIAGNOSIS, which is the whole value of the marker mechanism.
--
-- The fixture shrinks the cap rather than producing 32 MiB: the branch is the
-- same one either way, and a probe that writes 32 MiB to prove a comparison is a
-- probe nobody will keep running. What it therefore does not measure is the
-- size of the real cap.
$g89 = $ROOT .. "/t89-gate.mix"
write_file($g89, join([
  "$n = 0\n",
  "while $n < 200\n",
  "  print(repeat(\"noise \", 40))\n",
  "  $n = $n + 1\n",
  "end\n",
  "print(\"hygiene-scan-complete: 1\")\n",
  "exit(1)\n"], ""))
chmod($g89, 0o755)
$h89 = $ROOT .. "/t89-hook.mix"
write_file($h89, must_replace(must_replace(read_file($HOOK),
  "$GATE = $CMCTL .. \"/_bin/check-public-hygiene.mix\"",
  "$GATE = \"" .. $g89 .. "\""),
  "$CAP = 33554432", "$CAP = 4096"))
chmod($h89, 0o755)
$v89 = run_argv([$MIX, $h89, "pre-commit"],
  {cwd: $rp82, timeout: 900, stdin: "", max_output: 8388608})
$f = $f + ok("T89a a truncated capture is not a verdict, and says why",
  $v89["exit_code"] == 2
    and contains($v89["stdout"] .. $v89["stderr"], "CUT OFF"),
  join(["", $v89["exit_code"], " ",
    sanitize(substr($v89["stdout"] .. $v89["stderr"], 0, 400))], ""))
$f = $f + ok("T89b and it does not blame the gate for a capture limit",
  contains($v89["stdout"] .. $v89["stderr"],
    "without reporting that it finished") == false,
  sanitize(substr($v89["stdout"] .. $v89["stderr"], 0, 400)))

-- T90 — the third helper that hard-bailed under --status: the gate's runnability
-- is checked before the first hook state is printed, so a $GATE that is not
-- valid Mix turned the read-only query into an exit 2 that said nothing at all
-- about the hooks. It is the opposite of what that run is for — a gate that
-- cannot run is the single most important thing a status has to report, because
-- every hook it lists as "installed" would fail. Round twenty-one.
$rp90 = newrepo("t90-status-with-a-broken-gate")
$g90 = $ROOT .. "/t90-gate.mix"
write_file($g90, "fn main()\n  return no_such_builtin_anywhere()\nend\nmain()\n")
chmod($g90, 0o755)
$c90 = $ROOT .. "/t90.conf.mix"
write_file($c90, replace(read_file($cp52), $rp52, $rp90))
$i90 = $ROOT .. "/install-t90.mix"
write_file($i90, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c90 .. "\""),
  "$GATE = $CMCTL .. \"/_bin/check-public-hygiene.mix\"",
  "$GATE = \"" .. $g90 .. "\""))
$s90 = run_installer([$MIX, $i90, "--status"], {timeout: 900})
-- Round forty: a gate binary it could not validate is unverified state, so the
-- run ends at 2. What the row measures — that it still reports the hooks
-- instead of going silent — is the other two clauses.
--
-- This row tracks as-built behaviour that is BROADER than it needs to be, and
-- says so rather than blessing it. status_unverified() merges every run-level
-- reason into every hook state, so "the gate is not valid Mix" makes even an
-- ABSENT hook read ABSENCE UNVERIFIED. On T85a and T98a that coupling is exact
-- — the thing that went unmeasured is the very probe that decides whether
-- ABSENT can be trusted. Here it is not: the hook file is missing, and a broken
-- gate does not make it any less missing. What a broken gate genuinely taints
-- is `installed` (round thirty-three's reasoning: the hook would run THIS), not
-- absence.
--
-- Left as-is deliberately. The error is in the safe direction — the contract
-- this arc enforces is that the gate must never say verified when it could not
-- tell, and over-reporting UNVERIFIED never violates that. Narrowing it means
-- tagging each reason with whether it taints presence-detection as distinct
-- from executability, which is a round of its own. The cost of not doing it is
-- real but different in kind: exit 2 becomes routine enough to stop being read.
$f = $f + ok("T90a --status reports the hooks even when the gate is broken",
  $s90["exit_code"] == 2
    and contains($s90["stdout"] .. $s90["stderr"], $DONE)
    and contains($s90["stdout"] .. $s90["stderr"],
      "pre-commit: ABSENCE UNVERIFIED"),
  join(["", $s90["exit_code"], " ",
    sanitize($s90["stdout"] .. $s90["stderr"])], ""))
$f = $f + ok("T90b and it says the gate is broken rather than staying quiet",
  contains($s90["stdout"] .. $s90["stderr"], "WARNING")
    and contains($s90["stdout"] .. $s90["stderr"], "not valid Mix"),
  sanitize($s90["stdout"] .. $s90["stderr"]))
-- T78a is the control on the other side (installing with that gate refuses at
-- 2); this asserts the softening did not reach it, on this fixture.
$o90 = run_installer([$MIX, $i90], {timeout: 900})
$f = $f + ok("T90c but installing with a broken gate still refuses at 2",
  $o90["exit_code"] == 2
    and contains($o90["stdout"] .. $o90["stderr"], "not valid Mix"),
  join(["", $o90["exit_code"], " ",
    sanitize($o90["stdout"] .. $o90["stderr"])], ""))

-- T91 — mkdir() is create_dir_all, so pointing TMPDIR at a name that does not
-- exist made the installer CREATE it, parents and all, and the cleanup then took
-- back only the probe directory inside it. A tool that quietly builds directory
-- trees outside its own remit is doing something nobody asked for; it also made
-- "unwritable" and "missing" the same measurement, which is what made round
-- twenty's first version of T85 prove nothing. Round twenty-one.
$rp91 = newrepo("t91-tmpdir-that-does-not-exist")
$c91 = $ROOT .. "/t91.conf.mix"
write_file($c91, replace(read_file($cp52), $rp52, $rp91))
$i91 = $ROOT .. "/install-t91.mix"
write_file($i91, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c91 .. "\""))
$tmp91 = $ROOT .. "/t91-absent-tmp/deeper"
$o91 = run_installer([$MIX, $i91], {timeout: 900, env: {TMPDIR: $tmp91}})
$f = $f + ok("T91a a TMPDIR that does not exist is refused, not created",
  $o91["exit_code"] == 2
    and contains($o91["stdout"] .. $o91["stderr"], "is not a directory"),
  join(["", $o91["exit_code"], " ",
    sanitize($o91["stdout"] .. $o91["stderr"])], ""))
$f = $f + ok("T91b and the directory tree really was not created",
  exists($ROOT .. "/t91-absent-tmp", {follow_symlinks: false}) == false,
  join(["created=",
    exists($ROOT .. "/t91-absent-tmp", {follow_symlinks: false})], ""))

-- T92 — the symlink pass indexed `git ls-tree`'s fields on the strength of git
-- exiting 0, and Mix indexes past the end of a list without raising. So an entry
-- with a missing field produced a nil object id, which travelled on into
-- run_argv's argument list — where it DOES raise, uncaught, at exit 1: the code
-- reserved for "a mesh-private literal was found", printed against content that
-- was never read, with no completion marker for the hook to notice. Round
-- twenty-two's cold review. Real git does not emit this, which is exactly why a
-- stub git is the only way in — the same reasoning as T22.
$r92 = newrepo("t92-malformed-ls-tree")
write_file($r92 .. "/f.txt", "anything\n")
$unused92 = commit($r92, "t92")
$w92 = $ROOT .. "/t92-bin"
mkdir($w92)
$realgit92 = which("git")
-- --name-only is the OTHER ls-tree call (the pathname pass); leaving it alone
-- keeps this fixture aimed at the one parser it is about.
write_file($w92 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"ls-tree\") and contains($a, \"--name-only\") == false then\n",
  "  print(\"120000 \")\n",
  "  exit(0)\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit92 .. "\"], $a)))\n"
], ""))
chmod($w92 .. "/git", 0o755)
$o92 = run_argv([$MIX, $GATE, "--tree", $r92],
  {timeout: 300, env: {PATH: $w92 .. ":" .. env("PATH")}})
$f = $f + ok("T92a an ls-tree entry that cannot be parsed exits 2, never 1",
  $o92["exit_code"] == 2
    and contains($o92["stdout"] .. $o92["stderr"], "cannot parse"),
  join(["", $o92["exit_code"], " ",
    sanitize($o92["stdout"] .. $o92["stderr"])], ""))
$f = $f + ok("T92b and it names the entry instead of raising on a nil argument",
  contains($o92["stdout"] .. $o92["stderr"], "120000")
    and contains($o92["stdout"] .. $o92["stderr"], "not looked at"),
  sanitize($o92["stdout"] .. $o92["stderr"]))
-- The control that makes the two rows above mean something: the SAME repo,
-- scanned with the real git, is clean. Without it, a fixture that broke the
-- scan some other way would look identical.
$c92 = run_argv([$MIX, $GATE, "--tree", $r92], {timeout: 300})
$f = $f + ok("T92c and that same repo scans clean through a real git",
  $c92["exit_code"] == 0,
  join(["", $c92["exit_code"], " ",
    sanitize($c92["stdout"] .. $c92["stderr"])], ""))

-- T93 IS DELIBERATELY ABSENT. Round twenty-two also fixed is_executable(),
-- which tested the OWNER execute bit whoever was asking: a root-owned mode-0744
-- stub in a root-owned hooks directory — a directory this installer trusts,
-- because root ownership is not foreign ownership — was reported "installed" to
-- a non-root operator whose git silently skips it. Staging that needs a file
-- owned by a SECOND uid, which needs root, and this suite runs unprivileged.
-- Every mode a probe can stage here is one this run owns, where old and new
-- code both consult the owner bit and agree — so a probe would pass against the
-- defect it was written for, which is worth less than nothing. It is recorded
-- as unprobed in the journal rather than dressed up in a row that proves
-- something adjacent.

-- T94 — "ours" was any hook whose text CONTAINED the marker anywhere, so a
-- foreign pre-commit hook that merely mentioned the gate in a comment was
-- classified as a stale stub of ours: it skipped the .pre-hygiene preservation
-- branch and was atomically replaced. The installer exited 0 having deleted the
-- veto it promises to chain. Round twenty-two's cold review.
$rp94 = newrepo("t94-foreign-hook-that-mentions-the-marker")
$c94 = $ROOT .. "/t94.conf.mix"
write_file($c94, replace(read_file($cp52), $rp52, $rp94))
$i94 = $ROOT .. "/install-t94.mix"
write_file($i94, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c94 .. "\""))
$foreign94 = join([
  "#!/bin/sh\n",
  "# our own veto — runs long before cosmix-hygiene-gate was ever installed\n",
  "exit 1\n"
], "")
write_file($rp94 .. "/.git/hooks/pre-commit", $foreign94)
chmod($rp94 .. "/.git/hooks/pre-commit", 0o755)
$s94 = run_installer([$MIX, $i94, "--status"], {timeout: 900})
$f = $f + ok("T94a a foreign hook that mentions the marker is FOREIGN, not ours",
  $s94["exit_code"] == 0
    and contains($s94["stdout"] .. $s94["stderr"], "pre-commit: FOREIGN"),
  join(["", $s94["exit_code"], " ",
    sanitize($s94["stdout"] .. $s94["stderr"])], ""))
$o94 = run_installer([$MIX, $i94], {timeout: 900})
$f = $f + ok("T94b and installing preserves it byte for byte",
  $o94["exit_code"] == 0
    and exists($rp94 .. "/.git/hooks/pre-commit.pre-hygiene")
    and read_file($rp94 .. "/.git/hooks/pre-commit.pre-hygiene") == $foreign94,
  join(["", $o94["exit_code"], " ",
    sanitize($o94["stdout"] .. $o94["stderr"])], ""))
-- The control on the other side, and the one that stops this fix from becoming
-- its own bug: a stub of OURS from an older layout must still be replaced in
-- place. Preserving it chains our own dead stub as if it were someone else's
-- hook — and since that stub re-invokes hygiene-hook.mix, the chain has no
-- bottom (see T99).
--
-- Round twenty-three rewrote this row, which had been the arc's FIFTH hollow
-- probe. Its fixture carried `-- cosmix-hygiene-gate — installed by /gone/away/…`
-- — the current provenance line with a different PATH — and the predicate under
-- test deliberately does not compare the path, so the fixture passed before the
-- fix and after it, measuring nothing. "An older layout" has to mean an older
-- LINE. This one is the shape a previous version of stub() actually emitted:
-- the marker, then wording this installer no longer writes, then the one line
-- that makes a stub a stub.
--
-- Round twenty-seven corrects another hollow detail in that fixture. It claimed
-- `/gone/away` on line 2 but invoked this checkout's $HOOK in the body, a
-- combination no installer ever emitted. Under the three-state classifier that
-- is correctly UNKNOWN, not historical. The body below is now the real no-argv
-- template from git history, with EVERY embedded path parameterised by the
-- claimed root. Replacing that template set with current-body-only makes this
-- control refuse and turns both rows red.
$rp94b = newrepo("t94-stale-stub-of-ours")
$c94b = $ROOT .. "/t94b.conf.mix"
write_file($c94b, replace(read_file($cp52), $rp52, $rp94b))
$i94b = $ROOT .. "/install-t94b.mix"
write_file($i94b, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c94b .. "\""))
$oldroot94 = "/gone/away"
write_file($rp94b .. "/.git/hooks/pre-commit", join([
  "#!" .. $MIX .. "\n",
  "-- cosmix-hygiene-gate — installed by " .. $oldroot94,
  "/_bin/install-hygiene-hooks.mix\n",
  "-- Logic lives in " .. $oldroot94,
  "/_bin/hygiene-hook.mix (edit there; no reinstall needed).\n",
  "exit(run_stream([\"" .. $MIX .. "\", \"" .. $oldroot94,
  "/_bin/hygiene-hook.mix\", \"pre-commit\"]))\n"
], ""))
chmod($rp94b .. "/.git/hooks/pre-commit", 0o755)
$o94b = run_installer([$MIX, $i94b], {timeout: 900})
$f = $f + ok("T94c but a stale stub of ours is replaced, not saved as foreign",
  $o94b["exit_code"] == 0
    and exists($rp94b .. "/.git/hooks/pre-commit.pre-hygiene",
      {follow_symlinks: false}) == false,
  join(["", $o94b["exit_code"], " ",
    sanitize($o94b["stdout"] .. $o94b["stderr"])], ""))
-- Round twenty-five, and the reason "not saved as foreign" was never the whole
-- assertion: an installer that recognised the file as ours and then returned
-- success WITHOUT writing it passes both tests above with the stale stub still
-- live. --status is the only thing that reads the file back and compares it to
-- what stub() emits today, so it is the only thing that can say `installed`
-- rather than `STALE`.
$s94b = run_installer([$MIX, $i94b, "--status"], {timeout: 900})
$f = $f + ok("T94d and the replacement really is the current stub, not the old one",
  $s94b["exit_code"] == 0
    and contains($s94b["stdout"] .. $s94b["stderr"], "pre-commit: installed"),
  join(["", $s94b["exit_code"], " ",
    sanitize($s94b["stdout"] .. $s94b["stderr"])], ""))

-- T95 — the completion marker is built from whatever the gate exited with, so a
-- gate that printed "hygiene-scan-complete: 3" and exited 3 was read as a
-- completed scan and its 3 handed straight out — by the one component whose
-- entire job is to speak the 0/1/2 contract. git only asks whether the code is
-- zero, so this was never unsafe; it was the contract quietly not being true,
-- which is how the next reader of it gets caught. Round twenty-two.
$g95 = $ROOT .. "/t95-gate.mix"
write_file($g95, join([
  "print(\"hygiene-scan-complete: 3\")\n",
  "exit(3)\n"
], ""))
chmod($g95, 0o755)
$h95 = $ROOT .. "/t95-hook.mix"
write_file($h95, must_replace(read_file($HOOK),
  "$GATE = $CMCTL .. \"/_bin/check-public-hygiene.mix\"",
  "$GATE = \"" .. $g95 .. "\""))
chmod($h95, 0o755)
$v95 = run_argv([$MIX, $h95, "pre-commit"],
  {cwd: $rp82, timeout: 900, stdin: ""})
$f = $f + ok("T95a a gate ending outside the contract is not passed through",
  $v95["exit_code"] == 2
    and contains($v95["stdout"] .. $v95["stderr"], "not one of the three codes"),
  join(["", $v95["exit_code"], " ",
    sanitize($v95["stdout"] .. $v95["stderr"])], ""))

-- T96 — the truncation disclosure sat BELOW the exit-2 early return, so the one
-- path that prints nothing except a diagnostic was the one path that never said
-- the diagnostic was cut off. The verdict is 2 either way, which is precisely
-- why the ordering looked harmless: fail-closed is not the same as honest, and
-- the part cut off is the part that names what could not be scanned. Round
-- twenty-two. Same fixture technique as T89 — shrink the cap, do not emit
-- 32 MiB — and the same thing therefore unmeasured: the size of the real cap.
$g96 = $ROOT .. "/t96-gate.mix"
write_file($g96, join([
  "$n = 0\n",
  "while $n < 200\n",
  "  print(repeat(\"noise \", 40))\n",
  "  $n = $n + 1\n",
  "end\n",
  "exit(2)\n"
], ""))
chmod($g96, 0o755)
$h96 = $ROOT .. "/t96-hook.mix"
write_file($h96, must_replace(must_replace(read_file($HOOK),
  "$GATE = $CMCTL .. \"/_bin/check-public-hygiene.mix\"",
  "$GATE = \"" .. $g96 .. "\""),
  "$CAP = 33554432", "$CAP = 4096"))
chmod($h96, 0o755)
$v96 = run_argv([$MIX, $h96, "pre-commit"],
  {cwd: $rp82, timeout: 900, stdin: "", max_output: 8388608})
$f = $f + ok("T96a a truncated exit-2 refusal says that it is truncated",
  $v96["exit_code"] == 2
    and contains($v96["stdout"] .. $v96["stderr"], "CUT OFF"),
  join(["", $v96["exit_code"], " ",
    sanitize(substr($v96["stdout"] .. $v96["stderr"], 0, 400))], ""))
$f = $f + ok("T96b and it says the gate refused rather than blaming the gate",
  contains($v96["stdout"] .. $v96["stderr"], "refused to give a verdict")
    and contains($v96["stdout"] .. $v96["stderr"],
      "without reporting that it finished") == false,
  sanitize(substr($v96["stdout"] .. $v96["stderr"], 0, 400)))

-- T97 — the fourth helper on the --status path that refused a question it could
-- answer perfectly well. "There is no hooks directory" IS the answer: nothing is
-- installed there. Bailing on it also took every LATER repository down with it,
-- which is the part that makes this more than a wording problem — so the second
-- repo here is the row that matters. Round twenty-two.
$rp97 = newrepo("t97-no-hooks-dir")
$rp97b = newrepo("t97-second-repo-still-reported")
$rmh97 = run_argv(["rm", "-rf", $rp97 .. "/.git/hooks"], {timeout: 60})
$c97 = $ROOT .. "/t97.conf.mix"
write_file($c97, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp97 .. "\", \"" .. $rp97b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$i97 = $ROOT .. "/install-t97.mix"
write_file($i97, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c97 .. "\""))
$s97 = run_installer([$MIX, $i97, "--status"], {timeout: 900})
$f = $f + ok("T97a --status answers a repo with no hooks directory at all",
  $s97["exit_code"] == 0
    and contains($s97["stdout"] .. $s97["stderr"],
      "hooks directory does not exist")
    and contains($s97["stdout"] .. $s97["stderr"], "ABSENT (no hooks directory)"),
  join(["", $s97["exit_code"], " ", $rmh97["exit_code"], " ",
    sanitize($s97["stdout"] .. $s97["stderr"])], ""))
$f = $f + ok("T97b and the repo AFTER it is still reported",
  contains($s97["stdout"] .. $s97["stderr"], $rp97b),
  sanitize($s97["stdout"] .. $s97["stderr"]))
$o97 = run_installer([$MIX, $i97], {timeout: 900})
$f = $f + ok("T97c but installing into a missing hooks directory still refuses",
  $o97["exit_code"] == 2
    and contains($o97["stdout"] .. $o97["stderr"],
      "hooks directory does not exist"),
  join(["", $o97["exit_code"], " ",
    sanitize($o97["stdout"] .. $o97["stderr"])], ""))

-- T98 — round twenty-one required TMPDIR to exist in probe_dir() and left the
-- SAME recursive mkdir() one indirection away, in the source of the probe that
-- is handed to the interpreter the stubs name. Under --status the first probe
-- warned and returned, and then the second one created the missing TMPDIR,
-- parents and all, and took back only its own leaf. That is the defect shape
-- this arc keeps finding: a principle applied to one helper and not to the
-- other on the same path. Round twenty-two.
$rp98 = newrepo("t98-tmpdir-and-the-child-probe")
$c98 = $ROOT .. "/t98.conf.mix"
write_file($c98, replace(read_file($cp52), $rp52, $rp98))
$i98 = $ROOT .. "/install-t98.mix"
write_file($i98, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c98 .. "\""))
$tmp98 = $ROOT .. "/t98-absent-tmp/deeper"
$s98 = run_installer([$MIX, $i98, "--status"],
  {timeout: 900, env: {TMPDIR: $tmp98}})
-- Round forty: as T85a — the interpreter went unchecked, so the run ends at 2
-- while still reporting.
$f = $f + ok("T98a --status with a missing TMPDIR still reports the hooks",
  $s98["exit_code"] == 2
    and contains($s98["stdout"] .. $s98["stderr"], $DONE)
    and contains($s98["stdout"] .. $s98["stderr"],
      "pre-commit: ABSENCE UNVERIFIED")
    and contains($s98["stdout"] .. $s98["stderr"], "WARNING"),
  join(["", $s98["exit_code"], " ",
    sanitize($s98["stdout"] .. $s98["stderr"])], ""))
$f = $f + ok("T98b and the child probe did not build the TMPDIR either",
  exists($ROOT .. "/t98-absent-tmp", {follow_symlinks: false}) == false,
  join(["created=",
    exists($ROOT .. "/t98-absent-tmp", {follow_symlinks: false})], ""))

-- T99 — the backstop for the worst thing this arc has produced. Round
-- twenty-two tightened "is this stub ours" to an exact line, so a stub written
-- by an EARLIER version became foreign: preserved as `<hook>.pre-hygiene` and
-- chained — and a preserved stub re-invokes hygiene-hook.mix, which chains to
-- it again. One `git commit` reached ~5,400 processes and a load average of 604
-- on this machine. is_our_stub is fixed (T94c), but a misclassification is one
-- predicate away from returning, so the CHAIN now refuses to recurse: run_prior
-- marks the environment and a marked environment is this hook below itself.
--
-- The fixture bounds itself rather than trusting the fix. Its .pre-hygiene is a
-- counting wrapper that stops at five, so a regression here fails this row
-- instead of taking the machine down — the suite has to be safe to run on the
-- defect it is testing for.
$rp99 = newrepo("t99-chained-below-itself")
write_file($rp99 .. "/f.txt", "clean\n")
$unused99 = commit($rp99, "t99")
$n99 = $ROOT .. "/t99-depth"
$hk99 = $rp99 .. "/.git/hooks/pre-commit.pre-hygiene"
write_file($hk99, join([
  "#!" .. $MIX .. "\n",
  "-- cosmix-hygiene-gate — a stub of ours, chained as if it were foreign\n",
  "$c = \"" .. $n99 .. "\"\n",
  "$s = \"\"\n",
  "if exists($c) then\n",
  "  $s = read_file($c)\n",
  "end\n",
  "write_file($c, $s .. \"x\")\n",
  "if len($s) >= 5 then\n",
  "  exit(0)\n",
  "end\n",
  "exit(run_stream([\"" .. $MIX .. "\", \"" .. $HOOK .. "\", \"pre-commit\"]))\n"
], ""))
chmod($hk99, 0o755)
$v99 = run_argv([$MIX, $HOOK, "pre-commit"],
  {cwd: $rp99, timeout: 900, stdin: ""})
$f = $f + ok("T99a a hook chained below itself refuses instead of recursing",
  $v99["exit_code"] == 2
    and contains($v99["stdout"] .. $v99["stderr"], "chained below itself")
    and contains($v99["stdout"] .. $v99["stderr"], "Nothing was scanned"),
  join(["", $v99["exit_code"], " ",
    sanitize(substr($v99["stdout"] .. $v99["stderr"], 0, 400))], ""))
-- The row that measures the recursion rather than the message: the chained hook
-- ran ONCE. Without the mark it runs until the fixture's own cap stops it.
$d99 = ""
if exists($n99) then
  $d99 = read_file($n99)
end
$f = $f + ok("T99b and the chained hook ran exactly once, not until a cap",
  len($d99) == 1,
  join(["depth=", "" .. len($d99)], ""))

-- T100 — round twenty-two validated the ls-tree entries it had already decided
-- were symlinks, and decided that by whether the record opened with "120000 ".
-- Everything else was SKIPPED, silently, at exit 0. So a git whose -z stream
-- loses its NULs collapses the tree into one record: the first entry still
-- parses, every symlink after it vanishes from the scan, and the gate certifies
-- a tree it read one line of. This fixture's symlink target is a real node name
-- — the leak that goes unreported. Round twenty-three.
$r100 = newrepo("t100-mangled-ls-tree-stream")
write_file($r100 .. "/a-first.txt", "clean\n")
symlink("/srv/" .. $NODE .. "/data", $r100 .. "/z-link")
$unused100 = commit($r100, "t100")
$w100 = $ROOT .. "/t100-bin"
mkdir($w100)
$realgit100 = which("git")
-- Only the -z pass is mangled, and only by its DELIMITER: the bytes are git's
-- own, which is what makes this a stream a naive parser accepts.
write_file($w100 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"ls-tree\") and contains($a, \"--name-only\") == false then\n",
  "  $r = run_argv(concat([\"" .. $realgit100 .. "\"], $a), {timeout: 300})\n",
  "  print(replace($r[\"stdout\"], \"\\u{0}\", \"\\n\"))\n",
  "  exit($r[\"exit_code\"])\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit100 .. "\"], $a)))\n"
], ""))
chmod($w100 .. "/git", 0o755)
$o100 = run_argv([$MIX, $GATE, "--tree", $r100],
  {timeout: 300, env: {PATH: $w100 .. ":" .. env("PATH")}})
$f = $f + ok("T100a a tree the two ls-tree passes disagree about exits 2",
  $o100["exit_code"] == 2
    and contains($o100["stdout"] .. $o100["stderr"], "disagree about what is in the tree"),
  join(["", $o100["exit_code"], " ",
    sanitize(substr($o100["stdout"] .. $o100["stderr"], 0, 400))], ""))
-- The control that gives the row above its meaning, and it is the stronger of
-- the two: through a real git this repo is a LEAK, so the skipped-entry defect
-- turned a 1 into a 0 — the gate certifying the exact content it exists to stop.
$c100 = run_argv([$MIX, $GATE, "--tree", $r100], {timeout: 300})
-- The completion marker is part of the assertion, not decoration. Round
-- twenty-four: exit 1 plus the pathname is also what an INFRASTRUCTURE failure
-- looks like — replace the symlink scan with `bail(1, "z-link")` before it
-- reads the target and this row still passed while nothing was scanned at all.
-- Only the marker distinguishes "scanned, and found this" from "died holding
-- this string", and the whole exit contract turns on that distinction.
$f = $f + ok("T100b and through a real git that same symlink is a leak, not clean",
  $c100["exit_code"] == 1
    and contains($c100["stdout"] .. $c100["stderr"], "z-link")
    and contains($c100["stdout"] .. $c100["stderr"], "hygiene-scan-complete: 1"),
  join(["", $c100["exit_code"], " ",
    sanitize(substr($c100["stdout"] .. $c100["stderr"], 0, 400))], ""))

-- T101 — the fifth helper on the --status path to be taught that a read-only
-- query answers what it can. hooks_dir() bailed on every failure regardless of
-- mode, so ONE unreadable repository in the config took the whole multi-repo
-- report down with it and the repositories after it were never mentioned —
-- exactly what T97 fixed one helper away. Round twenty-three.
$rp101 = $ROOT .. "/t101-not-a-repo-at-all"
$rm101 = run_argv(["rm", "-rf", $rp101], {timeout: 60})
mkdir($rp101)
$rp101b = newrepo("t101-second-repo-still-reported")
$c101 = $ROOT .. "/t101.conf.mix"
write_file($c101, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp101 .. "\", \"" .. $rp101b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$i101 = $ROOT .. "/install-t101.mix"
write_file($i101, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c101 .. "\""))
$s101 = run_installer([$MIX, $i101, "--status"], {timeout: 900})
-- Round forty: a repository it could not report on is exactly the state the
-- run now refuses over — NOT REPORTED is one of the reasons the final bail
-- names. It still gets through the whole list first, which is T101b.
$f = $f + ok("T101a --status answers a configured path that is not a git repo",
  $s101["exit_code"] == 2
    and contains($s101["stdout"] .. $s101["stderr"], $DONE)
    and contains($s101["stdout"] .. $s101["stderr"], "NOT REPORTED"),
  join(["", $s101["exit_code"], " ", $rm101["exit_code"], " ",
    sanitize($s101["stdout"] .. $s101["stderr"])], ""))
$f = $f + ok("T101b and the repo AFTER it is still reported",
  contains($s101["stdout"] .. $s101["stderr"], "pre-commit: ABSENT"),
  sanitize($s101["stdout"] .. $s101["stderr"]))
-- Round twenty-four: the other half of round twenty-three's fix — printing the
-- repository name BEFORE the hooks_dir call, so its diagnostic is not orphaned
-- — was claimed and unprobed. Move `print($repo)` back below the call and the
-- first repo's "NOT REPORTED" line appears under no heading at all, yet T101a
-- and T101b both still pass. The sixth hollow probe in this arc, so the
-- ordering itself is pinned: the heading has to come first in the stream.
$t101out = $s101["stdout"] .. $s101["stderr"]
$f = $f + ok("T101d and its diagnostic appears UNDER that repo's heading",
  pos($rp101, $t101out) > 0
    and pos("NOT REPORTED", $t101out) > 0
    and pos($rp101, $t101out) < pos("NOT REPORTED", $t101out),
  join(["heading@", "" .. pos($rp101, $t101out), " diag@",
    "" .. pos("NOT REPORTED", $t101out)], ""))
$o101 = run_installer([$MIX, $i101], {timeout: 900})
$f = $f + ok("T101c but installing against a path that is not a repo refuses",
  $o101["exit_code"] == 2
    and contains($o101["stdout"] .. $o101["stderr"], "not a git repo"),
  join(["", $o101["exit_code"], " ",
    sanitize($o101["stdout"] .. $o101["stderr"])], ""))

-- ---------------------------------------------------------------------------
-- Round twenty-four's findings. Every one of them is the same shape — a safety
-- check that FAILS OPEN: an option silently ignored, a mode never validated, a
-- name interpolated unescaped, a capability assumed rather than probed.
-- ---------------------------------------------------------------------------

-- T102 — the path cross-check (T100) compares two ls-tree passes that agree on
-- WHICH paths exist. Neither says what KIND of entry each one is, and mode
-- 120000 is the only thing that makes this scan read a symlink's target, so a
-- git that relabels one leaking symlink `100644 blob` in the detailed pass —
-- a legal mode/type pairing, an identical path set, an untouched --name-only
-- pass — makes the gate skip that target. `git grep` never reads a symlink
-- either, so nothing else covers for it: exit 0 on a published leak. The fix
-- reads the same frozen object through git's DIFF machinery and compares the
-- modes; this fixture is the relabelling git.
$r102 = newrepo("t102-relabelled-symlink")
write_file($r102 .. "/a-first.txt", "clean\n")
symlink("/srv/" .. $NODE .. "/data", $r102 .. "/z-link")
$unused102 = commit($r102, "t102")
$w102 = $ROOT .. "/t102-bin"
mkdir($w102)
$realgit102 = which("git")
-- Only the detailed ls-tree pass, and only its MODE field. printf, not print:
-- the -z stream must come back byte-for-byte, and an added trailing newline
-- would be refused as an unparseable record — the wrong refusal, from the
-- wrong check, proving nothing about this one.
write_file($w102 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"ls-tree\") and contains($a, \"--name-only\") == false then\n",
  "  $r = run_argv(concat([\"" .. $realgit102 .. "\"], $a),\n",
  "    {timeout: 300, max_output: 0})\n",
  "  printf(\"%s\", replace($r[\"stdout\"], \"120000 blob\", \"100644 blob\"))\n",
  "  exit($r[\"exit_code\"])\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit102 .. "\"], $a)))\n"
], ""))
chmod($w102 .. "/git", 0o755)
$env102 = {PATH: $w102 .. ":" .. env("PATH")}
$o102 = run_argv([$MIX, $GATE, "--tree", $r102], {timeout: 300, env: $env102})
$t102 = $o102["stdout"] .. $o102["stderr"]
$f = $f + ok("T102a a tree whose ls-tree modes disagree with git's diff machinery exits 2",
  $o102["exit_code"] == 2
    and contains($t102, "as mode 100644")
    and contains($t102, "over the same object reports 120000"),
  join(["", $o102["exit_code"], " ", sanitize(substr($t102, 0, 500))], ""))
-- The row that proves the fixture is the fixture, not a lucky failure
-- somewhere else: through the shim there is no 120000 left to see.
$sh102 = run_argv([$w102 .. "/git", "ls-tree", "-r", "HEAD"],
  {timeout: 300, cwd: $r102, env: $env102})
$f = $f + ok("T102b the shim really did relabel the symlink's mode",
  contains($sh102["stdout"], "z-link")
    and contains($sh102["stdout"], "120000") == false,
  sanitize(substr($sh102["stdout"] .. $sh102["stderr"], 0, 300)))
-- And the control that gives T102a its weight: through a real git this repo is
-- a LEAK, so the missing mode check turned a 1 into a 0 — the gate certifying
-- the exact content it exists to stop. The completion marker is asserted for
-- the reason T100b states: exit 1 plus the pathname is also what a gate that
-- DIED holding that string looks like.
$c102 = run_argv([$MIX, $GATE, "--tree", $r102], {timeout: 300})
$f = $f + ok("T102c and through a real git that same symlink is a leak, not clean",
  $c102["exit_code"] == 1
    and contains($c102["stdout"] .. $c102["stderr"], "z-link")
    and contains($c102["stdout"] .. $c102["stderr"], "hygiene-scan-complete: 1"),
  join(["", $c102["exit_code"], " ",
    sanitize(substr($c102["stdout"] .. $c102["stderr"], 0, 400))], ""))

-- Round twenty-five. T102a kills removal of tree_modes(), and nothing kills
-- removal of the mode/type validator that was added in the same breath: T102's
-- shim emits the LEGAL pair `100644 blob`, so parse_ls_tree_entry has nothing
-- to object to and the disagreement is caught one layer down, by the diff
-- machinery. Delete the two lines that reject an impossible pairing and every
-- probe in this file stays green.
--
-- So this shim tells a DIFFERENT lie, and tells it consistently: the detailed
-- pass calls the leaking symlink `100644 commit` — a mode and a type that
-- cannot occur together in any tree git writes — while diff-tree is rewritten
-- to agree on 100644, so tree_modes() sees two passes in perfect agreement and
-- says nothing. The pairing is then the only thing left standing between the
-- gate and a published leak: with the validator this is an unparseable record
-- and a 2; without it the entry is an ordinary file, its target is never read,
-- and the run exits 0 over a symlink pointing at the mesh.
$w102d = $ROOT .. "/t102d-bin"
mkdir($w102d)
write_file($w102d .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"ls-tree\") and contains($a, \"--name-only\") == false then\n",
  "  $r = run_argv(concat([\"" .. $realgit102 .. "\"], $a),\n",
  "    {timeout: 300, max_output: 0})\n",
  "  printf(\"%s\", replace($r[\"stdout\"], \"120000 blob\", \"100644 commit\"))\n",
  "  exit($r[\"exit_code\"])\n",
  "end\n",
  "if contains($a, \"diff-tree\") then\n",
  "  $r = run_argv(concat([\"" .. $realgit102 .. "\"], $a),\n",
  "    {timeout: 300, max_output: 0})\n",
  "  printf(\"%s\", replace($r[\"stdout\"], \" 120000 \", \" 100644 \"))\n",
  "  exit($r[\"exit_code\"])\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit102 .. "\"], $a)))\n"
], ""))
chmod($w102d .. "/git", 0o755)
$env102d = {PATH: $w102d .. ":" .. env("PATH")}
$o102d = run_argv([$MIX, $GATE, "--tree", $r102], {timeout: 300, env: $env102d})
$t102d = $o102d["stdout"] .. $o102d["stderr"]
$f = $f + ok("T102d a mode and a type that cannot occur together exits 2",
  $o102d["exit_code"] == 2
    and contains($t102d, "cannot parse")
    and contains($t102d, "z-link"),
  join(["", $o102d["exit_code"], " ", sanitize(substr($t102d, 0, 500))], ""))
-- The premise, in two halves, because this shim has to lie in two places at
-- once for the row above to mean what it claims: the detailed pass must carry
-- the impossible pairing, and the diff pass must NOT contradict it — otherwise
-- T102d is just T102a again, passing on the mode cross-check.
$sh102d = run_argv([$w102d .. "/git", "ls-tree", "-r", "HEAD"],
  {timeout: 300, cwd: $r102, env: $env102d})
$empty102d = run_argv([$w102d .. "/git", "hash-object", "-t", "tree", "/dev/null"],
  {timeout: 300, cwd: $r102, env: $env102d})
$dt102d = run_argv([$w102d .. "/git", "diff-tree", "-r", "--no-renames",
  trim($empty102d["stdout"]), "HEAD"], {timeout: 300, cwd: $r102, env: $env102d})
$f = $f + ok("T102e the shim relabels the detailed pass AND keeps diff-tree agreeing",
  contains($sh102d["stdout"], "100644 commit")
    and contains($dt102d["stdout"], "120000") == false
    and contains($dt102d["stdout"], "z-link"),
  join([sanitize(substr($sh102d["stdout"], 0, 200)), " || ",
    sanitize(substr($dt102d["stdout"] .. $dt102d["stderr"], 0, 200))], ""))

-- T103 — the inventory is a trust boundary whose SHAPE was checked (T19c/T19d)
-- and whose CONTENT was not. Every member name and every subnet octet is
-- pasted unescaped into the regular expressions the whole gate is built from,
-- so a name holding a regex metacharacter — or an octet that is not a plain
-- 0-255 — silently builds a DIFFERENT rule: one that does not match the node
-- it names, on a gate that then reports the repository clean. Round
-- twenty-four. Both halves are probed, because they are two validators.
if not $HAS_INVENTORY then
  print("SKIP  T103a/b/c (no authored and signed mesh inventory — cannot stage inventory validation after signature verification)")
else
  $r103 = newrepo("t103-unescapable-inventory")
write_file($r103 .. "/clean.txt", "fine\n")
$unused103 = commit($r103, "t103")
$inv103 = $ROOT .. "/t103-bad.inventory.mix"
$gate103 = $ROOT .. "/gate-t103.mix"
write_file($gate103, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/mesh/inventory.mix\"", "\"" .. $inv103 .. "\""))
-- A name that is legal Mix data, legal in the file, and NOT a DNS label: as a
-- regex alternative `a.*` matches everything up to a boundary, so the rule it
-- builds is not about a node at all.
write_file($inv103, join([
  "inventory: {\n",
  "  schema_version: 1,\n",
  "  subnet: \"" .. $INV_SUBNET .. "\",\n",
  "  members: [{ name: \"a.*\" }]\n",
  "}\n"
], ""))
$o103 = run_argv([$MIX, $gate103, "--tree", $r103], {timeout: 300})
$f = $f + ok("T103a a member name that is not a DNS label exits 2",
  $o103["exit_code"] == 2
    and contains($o103["stdout"] .. $o103["stderr"], "is not a DNS label"),
  join(["", $o103["exit_code"], " ",
    sanitize(substr($o103["stdout"] .. $o103["stderr"], 0, 400))], ""))
write_file($inv103, join([
  "inventory: {\n",
  "  schema_version: 1,\n",
  "  subnet: \"198.51+.100.0/24\",\n",
  "  members: [{ name: \"" .. $INV_NODE .. "\" }]\n",
  "}\n"
], ""))
$o103b = run_argv([$MIX, $gate103, "--tree", $r103], {timeout: 300})
$f = $f + ok("T103b and a subnet octet that is not a plain 0-255 exits 2",
  $o103b["exit_code"] == 2
    and contains($o103b["stdout"] .. $o103b["stderr"], "non-numeric octet"),
  join(["", $o103b["exit_code"], " ",
    sanitize(substr($o103b["stdout"] .. $o103b["stderr"], 0, 400))], ""))
-- Round twenty-five: "a plain 0-255" was checked as a RANGE, and `016` is in
-- range. It is also not how anything writes the address, and the octet goes
-- into the pattern verbatim — so a rule built from a leading-zero TEST-NET
-- octet never meets the canonical address actually in the file.
-- actually in the file. This row is a true kill: with only the range check the
-- gate exits 0 over the address below and calls the repository clean.
$r103c = newrepo("t103-noncanonical-octet")
write_file($r103c .. "/leak.txt", "peer endpoint 198.51.100.9:12345\n")
$unused103c = commit($r103c, "t103c")
write_file($inv103, join([
  "inventory: {\n",
  "  schema_version: 1,\n",
  "  subnet: \"198.051.100.0/24\",\n",
  "  members: [{ name: \"" .. $INV_NODE .. "\" }]\n",
  "}\n"
], ""))
$o103c = run_argv([$MIX, $gate103, "--tree", $r103c], {timeout: 300})
$f = $f + ok("T103c and an octet that is in range but not canonical exits 2, not 0",
  $o103c["exit_code"] == 2
    and contains($o103c["stdout"] .. $o103c["stderr"], "non-numeric octet"),
  join(["", $o103c["exit_code"], " ",
    sanitize(substr($o103c["stdout"] .. $o103c["stderr"], 0, 400))], ""))
end

-- T104 — "is this stub ours" was the marker at line two and nothing else, and
-- the marker string is not a namespace anyone else agreed to. A foreign hook
-- whose second line happens to open with it was classified as ours: overwritten
-- with no `.pre-hygiene` copy, its veto gone for good. Round twenty-two lost a
-- hook this way in the other direction (T99); this is the same predicate read
-- from the other side. The fix asks for the marker AND a reference to one of
-- our three scripts — a file that calls none of them cannot chain to us, so
-- treating it as foreign is safe by construction. Round twenty-four.
$rp104 = newrepo("t104-foreign-hook-wearing-our-marker")
$hooks104 = $rp104 .. "/.git/hooks"
$foreign104 = join([
  "#!" .. $MIX .. "\n",
  "-- cosmix-hygiene-gate compatibility note, written by somebody else\n",
  "-- (deliberately calls none of our scripts — that is the whole point)\n",
  "write_file(\"" .. $ROOT .. "/t104-ran\", \"yes\")\n",
  "exit(0)\n"
], "")
write_file($hooks104 .. "/pre-commit", $foreign104)
chmod($hooks104 .. "/pre-commit", 0o755)
$c104 = $ROOT .. "/t104.conf.mix"
write_file($c104, replace(read_file($cp52), $rp52, $rp104))
$i104 = $ROOT .. "/install-t104.mix"
write_file($i104, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c104 .. "\""))
$o104 = run_installer([$MIX, $i104], {timeout: 900})
$saved104 = $hooks104 .. "/pre-commit.pre-hygiene"
$f = $f + ok("T104a a foreign hook carrying our marker is chained, not eaten",
  $o104["exit_code"] == 0
    and exists($saved104, {follow_symlinks: false})
    and read_file($saved104) == $foreign104,
  join(["", $o104["exit_code"], " saved=",
    "" .. exists($saved104, {follow_symlinks: false}), " ",
    sanitize(substr($o104["stdout"] .. $o104["stderr"], 0, 400))], ""))
-- The other side of the same predicate, unchanged and re-pinned here because
-- the fix narrowed it: a stub of OURS must still be recognised and overwritten
-- in place, never chained — chaining one is the fork bomb T99 exists for.
$o104b = run_installer([$MIX, $i104], {timeout: 900})
$f = $f + ok("T104b and a second run does not chain the stub it just wrote",
  $o104b["exit_code"] == 0
    and exists($hooks104 .. "/pre-commit.pre-hygiene.pre-hygiene",
      {follow_symlinks: false}) == false,
  join(["", $o104b["exit_code"], " ",
    sanitize(substr($o104b["stdout"] .. $o104b["stderr"], 0, 400))], ""))

-- Round twenty-five, and the kill for it. Round twenty-four's predicate was the
-- marker plus a REFERENCE to one of our three scripts anywhere in the file, and
-- a substring test cannot tell a reference from an invocation. This hook's only
-- mentions of us are prose — it says, in a comment, that it is independent of
-- hygiene-hook.mix — so round twenty-four classified it as ours, overwrote it
-- with no `.pre-hygiene` copy, and destroyed a foreign veto for good. It is
-- also incapable of the fork bomb the predicate exists to prevent: it calls
-- nothing.
--
-- Against the current predicate the file is foreign, chained, and byte-identical
-- afterwards. Against round twenty-four's it is eaten, so this row fails there.
$rp104c = newrepo("t104-marker-plus-comment-mention")
$hooks104c = $rp104c .. "/.git/hooks"
$foreign104c = join([
  "#!" .. $MIX .. "\n",
  "-- cosmix-hygiene-gate compatibility helper\n",
  "-- independent of hygiene-hook.mix; it enforces another policy entirely,\n",
  "-- and does NOT run check-public-hygiene.mix or install-hygiene-hooks.mix\n",
  "exit(0)\n"
], "")
write_file($hooks104c .. "/pre-commit", $foreign104c)
chmod($hooks104c .. "/pre-commit", 0o755)
$c104c = $ROOT .. "/t104c.conf.mix"
write_file($c104c, replace(read_file($cp52), $rp52, $rp104c))
$i104c = $ROOT .. "/install-t104c.mix"
write_file($i104c, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c104c .. "\""))
$o104c = run_installer([$MIX, $i104c], {timeout: 900})
$saved104c = $hooks104c .. "/pre-commit.pre-hygiene"
$f = $f + ok("T104c a foreign hook that only MENTIONS our scripts is chained, not eaten",
  $o104c["exit_code"] == 0
    and exists($saved104c, {follow_symlinks: false})
    and read_file($saved104c) == $foreign104c,
  join(["", $o104c["exit_code"], " saved=",
    "" .. exists($saved104c, {follow_symlinks: false}), " ",
    sanitize(substr($o104c["stdout"] .. $o104c["stderr"], 0, 400))], ""))

-- T105 — Mix does not enforce builtin arity unless run with --strict-arity, so
-- an interpreter too old for an option does not reject it, it DISCARDS it and
-- answers anyway. Round twenty-three built every TMPDIR guard in the installer
-- on mkdir({parents: false}) and checked only that the call did not raise —
-- which is exactly what the old binary does. On the fleet's interpreter the
-- whole guard is a no-op and the installer says nothing. The fix is behavioural:
-- ask for a leaf whose parent does not exist, and if BOTH appear the option is
-- being ignored. This fixture is an interpreter that ignores it — a shim that
-- strips the option out of the probe source before delegating to the real mix.
$rp105 = newrepo("t105-interpreter-ignores-parents-option")
$shim105 = $ROOT .. "/t105-mix"
write_file($shim105, join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if len($a) >= 2 and $a[0] == \"-c\" then\n",
  "  $a[1] = replace($a[1], \", {parents: false}\", \"\")\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $MIX .. "\"], $a)))\n"
], ""))
chmod($shim105, 0o755)
$c105 = $ROOT .. "/t105.conf.mix"
write_file($c105, replace(read_file($cp52), $rp52, $rp105))
$i105 = $ROOT .. "/install-t105.mix"
-- Both substitutions matter. $MIX is what the probe measures; the conf keeps a
-- REGRESSION off the real repositories — if the refusal ever stops firing this
-- installer must have nothing but a fixture to write into.
write_file($i105, must_replace(must_replace(read_file($INSTALL),
  "$MIX = \"/opt/cosmix/bin/mix\"", "$MIX = \"" .. $shim105 .. "\""),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c105 .. "\""))
$o105 = run_installer([$MIX, $i105], {timeout: 900})
$f = $f + ok("T105a an interpreter that ignores mkdir({parents: false}) is refused",
  $o105["exit_code"] == 2
    and contains($o105["stdout"] .. $o105["stderr"], "ignores mkdir({parents: false})"),
  join(["", $o105["exit_code"], " ",
    sanitize(substr($o105["stdout"] .. $o105["stderr"], 0, 500))], ""))
$f = $f + ok("T105b and it wrote no hook before refusing",
  exists($rp105 .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  "a stub was installed against an interpreter the installer had just rejected")
-- The control: the same installer copy against the real interpreter installs.
-- Without it T105a passes on any refusal at all, including one that would make
-- the installer useless everywhere.
$i105c = $ROOT .. "/install-t105-control.mix"
write_file($i105c, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c105 .. "\""))
$o105c = run_installer([$MIX, $i105c], {timeout: 900})
$f = $f + ok("T105c and through the real interpreter that same install succeeds",
  $o105c["exit_code"] == 0
    and exists($rp105 .. "/.git/hooks/pre-commit", {follow_symlinks: false}),
  join(["", $o105c["exit_code"], " ",
    sanitize(substr($o105c["stdout"] .. $o105c["stderr"], 0, 400))], ""))

-- Round twenty-five. The rows above substitute the lenient interpreter into
-- $MIX only — the value the installer hands to a CHILD probe — while the
-- installer itself keeps running on the real binary. So they kill the child
-- probe and nothing else: delete the installer's own in-process refusal, the
-- one guarding the TMPDIR mkdirs it performs itself, and T105a is still green
-- because the separate lstat probe child still catches the shim. That
-- in-process half is the half that matters on the fleet, where the binary
-- running the installer IS the old one.
--
-- The mutant is a source substitution rather than an old binary, because the
-- behaviour under test is "this interpreter discards the option", and asking
-- the 0.42.0 binary on this machine to discard it is not something a flag can
-- do. Dropping the option from the probe's own call reproduces exactly what a
-- pre-0.42.0 evaluator does with it — creates the leaf and its missing parent,
-- raises nothing — inside the installer's own process. Against the current
-- code that is an exit 2; with the in-process refusal removed the run installs
-- and this row fails, which is the kill the reviewer found missing.
$rp105d = newrepo("t105-parent-interpreter-ignores-parents-option")
$c105d = $ROOT .. "/t105d.conf.mix"
write_file($c105d, replace(read_file($cp52), $rp52, $rp105d))
$i105d = $ROOT .. "/install-t105d.mix"
$src105d = must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c105d .. "\"")
$f = $f + ok("T105d the in-process probe call is where the substitution lands",
  contains($src105d, "mkdir($leaf, {parents: false})"),
  "mkdir_option_honoured no longer calls mkdir($leaf, {parents: false})")
write_file($i105d, must_replace($src105d,
  "mkdir($leaf, {parents: false})", "mkdir($leaf)"))
$o105d = run_installer([$MIX, $i105d], {timeout: 900})
$f = $f + ok("T105e an installer whose OWN interpreter ignores the option is refused",
  $o105d["exit_code"] == 2
    and contains($o105d["stdout"] .. $o105d["stderr"],
      "ignores mkdir({parents: false})"),
  join(["", $o105d["exit_code"], " ",
    sanitize(substr($o105d["stdout"] .. $o105d["stderr"], 0, 500))], ""))
$f = $f + ok("T105f and it wrote no hook before refusing",
  exists($rp105d .. "/.git/hooks/pre-commit", {follow_symlinks: false}) == false,
  "a stub was installed by an interpreter the installer had just rejected")
-- The control, same shape as T105c: without the substitution this identical
-- installer copy installs, so T105e is measuring the option and not some other
-- objection to the fixture.
$i105g = $ROOT .. "/install-t105d-control.mix"
write_file($i105g, $src105d)
$o105g = run_installer([$MIX, $i105g], {timeout: 900})
$f = $f + ok("T105g and unsubstituted that same install succeeds",
  $o105g["exit_code"] == 0
    and exists($rp105d .. "/.git/hooks/pre-commit", {follow_symlinks: false}),
  join(["", $o105g["exit_code"], " ",
    sanitize(substr($o105g["stdout"] .. $o105g["stderr"], 0, 400))], ""))

-- T106 — git skips a hook it cannot execute WITHOUT WARNING, so --status
-- answering "installed" for a hook that will never run is the quietest way for
-- this gate to die. Round twenty-three checked the mode bits; a noexec mount
-- makes the kernel refuse whatever the mode bits say, and 0755 on a noexec
-- filesystem reported "installed". Worse than a wrong verdict, the fix for a
-- mode-bit problem is "re-run without --status" and that is the wrong
-- instruction here — it sends an operator round the loop believing the gate is
-- now live. Round twenty-four.
--
-- The mount is real, and unprivileged: a user namespace, so nothing outside
-- this process tree sees it and the suite needs no root. The install happens
-- OUTSIDE the namespace (ordinary uid, ordinary /tmp) and only the read-only
-- --status runs inside it, so the one thing that differs between the two rows
-- below is the mount.
$rp106 = newrepo("t106-hooks-on-a-noexec-mount")
$c106 = $ROOT .. "/t106.conf.mix"
write_file($c106, replace(read_file($cp52), $rp52, $rp106))
$i106 = $ROOT .. "/install-t106.mix"
write_file($i106, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c106 .. "\""))
$ins106 = run_installer([$MIX, $i106], {timeout: 900})
$before106 = run_installer([$MIX, $i106, "--status"], {timeout: 900})
$f = $f + ok("T106a on an ordinary mount the installed hook reports installed",
  $ins106["exit_code"] == 0
    and $before106["exit_code"] == 0
    and contains($before106["stdout"] .. $before106["stderr"], "pre-commit: installed"),
  join(["", $ins106["exit_code"], " ", $before106["exit_code"], " ",
    sanitize(substr($before106["stdout"] .. $before106["stderr"], 0, 400))], ""))
$hooks106 = $rp106 .. "/.git/hooks"
$inner106 = $ROOT .. "/t106-inside-ns.mix"
write_file($inner106, join([
  "$m1 = run_argv([\"mount\", \"--bind\", \"" .. $hooks106 .. "\",\n",
  "  \"" .. $hooks106 .. "\"], {timeout: 60})\n",
  "$m2 = run_argv([\"mount\", \"-o\", \"remount,bind,noexec\",\n",
  "  \"" .. $hooks106 .. "\"], {timeout: 60})\n",
  "if $m1[\"exit_code\"] != 0 or $m2[\"exit_code\"] != 0 then\n",
  "  print(\"MOUNT-FAILED \" .. $m1[\"stderr\"] .. \" \" .. $m2[\"stderr\"])\n",
  "  exit(3)\n",
  "end\n",
  "$s = run_argv([\"" .. $MIX .. "\", \"" .. $i106 .. "\", \"--status\"],\n",
  "  {timeout: 900})\n",
  "print($s[\"stdout\"] .. $s[\"stderr\"])\n",
  "exit($s[\"exit_code\"])\n"
], ""))
-- -r maps this uid to 0 inside the namespace, which is both what lets mount(8)
-- run and what keeps the fixture looking like its own — files this suite
-- created outside show as root-owned inside, so the installer's
-- foreign-ownership walk sees nothing new to complain about.
$o106 = run_argv(["unshare", "-Umr", "--propagation", "private",
  $MIX, $inner106], {timeout: 900, env: {TMPDIR: $ROOT, CMCTL: $CMCTL}})
$t106 = $o106["stdout"] .. $o106["stderr"]
-- Round forty, and this row does NOT take the `== 2` the other status rows
-- take. Its exit code moved for a reason that has nothing to do with what it
-- measures: inside `unshare -Umr` the uids outside the mapped range show as
-- 65534, so / and /tmp read as foreign-owned, the ownership walk warns, and the
-- run refuses. Pinning 2 here would assert a property of the namespace harness
-- and would go green again if the noexec detection broke. What the exit code is
-- actually load-bearing for in this row is the fixture: 3 is the inner script's
-- MOUNT-FAILED sentinel, and a row that measured nothing because the bind mount
-- never happened must not pass. So: not 3, the report ran to the end, and the
-- two content clauses that are the actual subject.
$f = $f + ok("T106b and on a noexec mount it says NOT EXECUTABLE, naming the mount",
  $o106["exit_code"] != 3
    and contains($t106, $DONE)
    and contains($t106, "pre-commit: NOT EXECUTABLE")
    and contains($t106, "mounted noexec"),
  join(["", $o106["exit_code"], " ", sanitize(substr($t106, 0, 600))], ""))
-- The instruction, pinned separately: "re-run without --status" repairs a mode
-- bit and repairs nothing here, and printing it would be the actively harmful
-- half of the defect.
$f = $f + ok("T106c and does NOT tell the operator to re-run without --status",
  contains($t106, "pre-commit: NOT EXECUTABLE") and (
    contains($t106, "NOT EXECUTABLE — git silently skips it; re-run") == false),
  sanitize(substr($t106, 0, 600)))

-- Round twenty-five, and the half round twenty-four left undone. Teaching
-- --status to SAY "noexec" is worth nothing if INSTALLING into such a directory
-- still reports success: write and chmod both succeed on a noexec mount, so the
-- installer printed three `installed` lines, exited 0, and handed the operator a
-- gate that git will skip in silence at every commit and push. A false clean
-- bill for the guarding mechanism itself is worse than no gate, because nobody
-- goes looking.
--
-- A FRESH repository, so the run being measured is a real first install rather
-- than a re-run over hooks that already exist.
--
-- The mount is presented through the mount TABLE here, not through the kernel,
-- and that is deliberate. A real noexec mount needs a user namespace, and
-- `unshare -r` maps exactly one uid: every ancestor above the fixture — /tmp,
-- / — is root-owned outside and therefore shows as nobody (65534) inside, so
-- the installer refuses on the foreign-ownership walk before it ever reaches
-- the mount question. Measured 2026-07-26; that refusal is also an exit 2
-- naming a different cause, which would have passed this row for entirely the
-- wrong reason. T106b already drives path_is_noexec's parser against a real
-- kernel mount; what is under test HERE is that install mode consults it at
-- all, so the honest fixture is the one that isolates that.
$rp106d = newrepo("t106-install-onto-a-noexec-mount")
$hooks106d = $rp106d .. "/.git/hooks"
$c106d = $ROOT .. "/t106d.conf.mix"
write_file($c106d, replace(read_file($cp52), $rp52, $rp106d))
$mounts106d = $ROOT .. "/t106d-noexec-mounts"
write_file($mounts106d, join([
  "/dev/probe0 / ext4 rw,relatime 0 0\n",
  "tmpfs ", realpath($hooks106d), " tmpfs rw,nosuid,nodev,noexec,relatime 0 0\n"
], ""))
$i106d = $ROOT .. "/install-t106d.mix"
write_file($i106d, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c106d .. "\""),
  "read_file(\"/proc/mounts\")", "read_file(\"" .. $mounts106d .. "\")"))
$o106d = run_installer([$MIX, $i106d], {timeout: 900})
$t106d = $o106d["stdout"] .. $o106d["stderr"]
$f = $f + ok("T106d and INSTALLING into a noexec hooks directory refuses at 2",
  $o106d["exit_code"] == 2
    and contains($t106d, "mounted noexec"),
  join(["", $o106d["exit_code"], " ", sanitize(substr($t106d, 0, 600))], ""))
-- The refusal has to come before anything is written, or "refused" is just a
-- noisier way of having installed. Checked from OUTSIDE the namespace, where
-- the bind mount does not exist and the directory is plainly readable.
$f = $f + ok("T106e and it wrote no hook before refusing",
  exists($hooks106d .. "/pre-commit", {follow_symlinks: false}) == false,
  "pre-commit present after a refusal")

-- The third answer, which is neither "noexec" nor "fine". path_is_noexec's own
-- doc-comment promises true/false/nil and says an unanswerable mount question
-- must become the caller's unknown branch — and round twenty-four's caller
-- tested `== true`, so nil fell straight through to the mode bits and printed a
-- flat `installed`. The unanswerable case is reached here by pointing the
-- reader at an EMPTY mounts table rather than by breaking /proc: masking /proc
-- inside a namespace also takes /proc/self/environ with it, and the installer
-- would then refuse for an unrelated reason, which is a probe measuring the
-- wrong thing. This substitution is the same one every other row in this suite
-- makes to redirect a hardcoded path, and it exercises the real
-- path_is_noexec/is_executable pair.
$rp106f = newrepo("t106-mount-table-unreadable")
$c106f = $ROOT .. "/t106f.conf.mix"
write_file($c106f, replace(read_file($cp52), $rp52, $rp106f))
$mounts106f = $ROOT .. "/t106f-empty-mounts"
write_file($mounts106f, "")
$i106f = $ROOT .. "/install-t106f.mix"
write_file($i106f, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c106f .. "\""),
  "read_file(\"/proc/mounts\")", "read_file(\"" .. $mounts106f .. "\")"))
$o106f = run_installer([$MIX, $i106f], {timeout: 900})
$f = $f + ok("T106f installing when the mount table answers nothing refuses at 2",
  $o106f["exit_code"] == 2
    and contains($o106f["stdout"] .. $o106f["stderr"], "cannot tell whether hooks directory"),
  join(["", $o106f["exit_code"], " ",
    sanitize(substr($o106f["stdout"] .. $o106f["stderr"], 0, 400))], ""))
-- ...and --status, which is read-only, keeps answering. Until round thirty it
-- answered "could NOT tell" here, because the mount table WAS the answer: with
-- no access() builtin, is_executable reasoned from mode bits plus
-- path_is_noexec, so an unreadable mount table left a hole and the honest reply
-- was an admission. It is not a hole any more — the kernel is asked directly,
-- and faccessat's answer already accounts for the mount, so an empty mount
-- table costs nothing but the WORDING of a failure.
--
-- That makes the interesting assertion the other one, and it is asserted here
-- rather than just noted: with the same empty mount table, a hook whose execute
-- bits are gone is still reported NOT EXECUTABLE. Only access() can produce
-- that line under these conditions, so this row now pins "the kernel answered"
-- instead of "we admitted we could not". Verified to fail against the pre-fix
-- installer, which printed `installed` for the 0644 hook once its mount lookup
-- came back nil.
$i106g = $ROOT .. "/install-t106g.mix"
write_file($i106g, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c106f .. "\""))
$ins106g = run_installer([$MIX, $i106g], {timeout: 900})
$s106f = run_installer([$MIX, $i106f, "--status"], {timeout: 900})
$t106f = $s106f["stdout"] .. $s106f["stderr"]
$f = $f + ok("T106g --status still answers definitively with no mount table to read",
  $ins106g["exit_code"] == 0
    and $s106f["exit_code"] == 0
    and contains($t106f, "pre-commit: installed")
    and contains($t106f, "could NOT tell") == false,
  join(["", $ins106g["exit_code"], " ", $s106f["exit_code"], " ",
    sanitize(substr($t106f, 0, 600))], ""))
chmod($rp106f .. "/.git/hooks/pre-commit", 0o644)
$s106g = run_installer([$MIX, $i106f, "--status"], {timeout: 900})
$t106g = $s106g["stdout"] .. $s106g["stderr"]
$f = $f + ok("T106h and a hook it cannot execute is NOT EXECUTABLE, mount table or no",
  $s106g["exit_code"] == 0
    and contains($t106g, "pre-commit: NOT EXECUTABLE")
    and contains($t106g, "could not be narrowed down"),
  join(["", $s106g["exit_code"], " ", sanitize(substr($t106g, 0, 600))], ""))
chmod($rp106f .. "/.git/hooks/pre-commit", 0o755)

-- T107 — the sixth helper on the --status path to be taught that a read-only
-- query answers what it can. require_private_hooks_dir bailed whenever
-- realpath() came back nil, so ONE repository whose hooks directory cannot be
-- named took the whole multi-repo report down with it — the exact defect T97
-- and T101 fixed two helpers away. A non-UTF-8 path component is the honest
-- way to produce it: the directory exists, git will happily traverse it, and
-- Mix cannot name it. Round twenty-four.
$rp107 = newrepo("t107-unnameable-hooks-dir")
$d107 = $ROOT .. "/t107-alias"
mkdir($d107)
-- Mix has no way to create a name that is not valid UTF-8, so the fixture is
-- built by the one tool that can. The hooks path git is given is pure ASCII —
-- it is the symlink's TARGET that cannot be named.
$mk107 = run_argv(["/bin/sh", "-c",
  "mkdir \"$1/$(printf 'hooks\\377')\" && ln -s \"$1/$(printf 'hooks\\377')\" \"$1/hooks\"",
  "sh", $d107], {timeout: 60})
-- 2026-08-30: same class as T52e — the \377 name cannot be created on a
-- utf8only filesystem (mkdir: EILSEQ); skip loudly rather than fail three rows.
if $mk107["exit_code"] != 0 then
  print("SKIP  T107a/b/c (filesystem refuses a non-UTF-8 pathname — utf8only? — cannot stage the case)")
else
  must($rp107, ["git", "config", "core.hooksPath", $d107 .. "/hooks"])
  $rp107b = newrepo("t107-second-repo-still-reported")
  $c107 = $ROOT .. "/t107.conf.mix"
  write_file($c107, join([
    "public_hygiene: {\n",
    "  schema_version: 1,\n",
    "  repos: [\"" .. $rp107 .. "\", \"" .. $rp107b .. "\"],\n",
    "  static_rules: " .. $FIXTURE_RULES .. ",\n",
    "  generic_node_names: [],\n",
    "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
    "}\n"
  ], ""))
  $i107 = $ROOT .. "/install-t107.mix"
  write_file($i107, must_replace(read_file($INSTALL),
    "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c107 .. "\""))
  $s107 = run_installer([$MIX, $i107, "--status"], {timeout: 900})
  $t107 = $s107["stdout"] .. $s107["stderr"]
  $f = $f + ok("T107a --status names every hook UNKNOWN when the dir cannot be resolved",
    $mk107["exit_code"] == 0
      and $s107["exit_code"] == 2
      and contains($t107, $DONE)
      and contains($t107, "UNKNOWN (hooks directory could not be resolved)"),
    join(["mk=", "" .. $mk107["exit_code"], " ", "" .. $s107["exit_code"], " ",
      sanitize(substr($t107, 0, 600))], ""))
  $f = $f + ok("T107b and the repo AFTER it is still reported",
    contains($t107, "pre-commit: ABSENT"),
    sanitize(substr($t107, 0, 600)))
  -- Installing is the other half of the contract, and it is the opposite answer:
  -- a path this run cannot even name is not one to write a gate stub through.
  $o107 = run_installer([$MIX, $i107], {timeout: 900})
  $f = $f + ok("T107c but installing into a path that cannot be named refuses",
    $o107["exit_code"] == 2
      and contains($o107["stdout"] .. $o107["stderr"], "cannot resolve the hooks directory"),
    join(["", $o107["exit_code"], " ",
      sanitize(substr($o107["stdout"] .. $o107["stderr"], 0, 400))], ""))
end

-- T108 — T99's anti-recursion mark was a bare "is this variable set", and the
-- variable is inherited by every process below the hook. Anything already in
-- the environment — an operator's export, a mark left by a hook in ANOTHER
-- repository higher up the same process tree — made a clean commit refuse with
-- "chained below itself": a gate that blocks the work it exists to permit, for
-- a recursion that is not happening. The fix marks with the resolved PATH of
-- the hook being chained and refuses only on exact membership, with a depth cap
-- as the backstop. Round twenty-four.
$rp108 = newrepo("t108-ambient-chain-mark")
write_file($rp108 .. "/f.txt", "clean\n")
$unused108 = commit($rp108, "t108")
$ran108 = $ROOT .. "/t108-prior-ran"
$hk108 = $rp108 .. "/.git/hooks/pre-commit.pre-hygiene"
write_file($hk108, join([
  "#!" .. $MIX .. "\n",
  "-- a foreign pre-commit hook, chained by the gate\n",
  "write_file(\"" .. $ran108 .. "\", \"yes\")\n",
  "exit(0)\n"
], ""))
chmod($hk108, 0o755)
$v108 = run_argv([$MIX, $HOOK, "pre-commit"],
  {cwd: $rp108, timeout: 900, stdin: "",
   env: {COSMIX_HYGIENE_CHAIN: "1", PATH: env("PATH"), HOME: env("HOME")}})
$f = $f + ok("T108a a non-path value in the chain mark does not block a clean commit",
  $v108["exit_code"] == 0 and exists($ran108),
  join(["", $v108["exit_code"], " prior=", "" .. exists($ran108), " ",
    sanitize(substr($v108["stdout"] .. $v108["stderr"], 0, 400))], ""))
$rm108 = run_argv(["rm", "-f", $ran108], {timeout: 60})
$v108b = run_argv([$MIX, $HOOK, "pre-commit"],
  {cwd: $rp108, timeout: 900, stdin: "",
   env: {COSMIX_HYGIENE_CHAIN: "/some/other/repo/.git/hooks/pre-commit.pre-hygiene",
     PATH: env("PATH"), HOME: env("HOME")}})
$f = $f + ok("T108b nor does another repository's hook already on the stack",
  $rm108["exit_code"] == 0 and $v108b["exit_code"] == 0 and exists($ran108),
  join(["", $v108b["exit_code"], " prior=", "" .. exists($ran108), " ",
    sanitize(substr($v108b["stdout"] .. $v108b["stderr"], 0, 400))], ""))
-- And the refusal it must NOT have lost: this hook's own resolved path in the
-- mark is still the recursion T99 found, and still a 2.
$self108 = realpath($hk108)
$v108c = run_argv([$MIX, $HOOK, "pre-commit"],
  {cwd: $rp108, timeout: 900, stdin: "",
   env: {COSMIX_HYGIENE_CHAIN: $self108, PATH: env("PATH"), HOME: env("HOME")}})
$f = $f + ok("T108c but its own path in the mark still refuses to recurse",
  $v108c["exit_code"] == 2
    and contains($v108c["stdout"] .. $v108c["stderr"], "chained below itself"),
  join(["", $v108c["exit_code"], " ",
    sanitize(substr($v108c["stdout"] .. $v108c["stderr"], 0, 400))], ""))
-- The depth cap, the backstop for a recursion the identity test cannot see
-- (two hooks chaining to each other, neither of them this one). Eight distinct
-- paths on the stack and the ninth invocation refuses.
$stack108 = []
$k108 = 0
while $k108 < 8
  push($stack108, "/nowhere/hook-" .. ("" .. $k108))
  $k108 = $k108 + 1
end
$v108d = run_argv([$MIX, $HOOK, "pre-commit"],
  {cwd: $rp108, timeout: 900, stdin: "",
   env: {COSMIX_HYGIENE_CHAIN: join($stack108, "\n"),
     PATH: env("PATH"), HOME: env("HOME")}})
$f = $f + ok("T108d and a chain eight hooks deep refuses on the depth cap",
  $v108d["exit_code"] == 2,
  join(["", $v108d["exit_code"], " ",
    sanitize(substr($v108d["stdout"] .. $v108d["stderr"], 0, 400))], ""))

-- T109 — the argument is documented as `<repo>`, and a repository is a thing
-- you are usually standing INSIDE. Round twenty-five: hand it a subdirectory —
-- `--tree ~/.mix/src` — and the two halves of the scan stop talking about the
-- same paths, because `ls-tree` and `git grep --no-full-name` are cwd-relative
-- while `diff-tree` is repository-root-relative. The mode cross-check then sees
-- a path in one map and not the other and refuses at 2: the right instinct,
-- the wrong cause, and a gate that refuses whenever it is invoked from
-- anywhere but the top is a gate that gets bypassed.
--
-- The quieter half is worse than the refusal. Had the paths merely been made
-- to agree — `--relative`, say — the scan would have covered the SUBTREE while
-- calling itself the repository, and a leak one directory up would have been
-- certified clean. So the fix canonicalises through `rev-parse --show-toplevel`
-- before anything is read, and this row asserts the whole repository was
-- scanned: the leak it must find is at the root, above the directory named on
-- the command line.
$rp109 = newrepo("t109-scan-named-by-a-subdirectory")
write_file($rp109 .. "/.gitignore", "*.tmp\n")
write_file($rp109 .. "/leak-at-the-root.txt",
  "peer endpoint " .. $NODE .. ".example is here\n")
mkdir($rp109 .. "/sub")
write_file($rp109 .. "/sub/clean.txt", "nothing to see\n")
$unused109 = commit($rp109, "t109")
$o109 = run_argv([$MIX, $GATE, "--tree", $rp109 .. "/sub"], {timeout: 300})
$t109 = $o109["stdout"] .. $o109["stderr"]
$f = $f + ok("T109a naming a subdirectory scans the whole repository, root included",
  $o109["exit_code"] == 1
    and contains($t109, "leak-at-the-root.txt")
    and contains($t109, "hygiene-scan-complete: 1"),
  join(["", $o109["exit_code"], " ", sanitize(substr($t109, 0, 500))], ""))
-- The control: named at the top it is the same verdict over the same commit,
-- so T109a is about the argument and not about the fixture.
$c109 = run_argv([$MIX, $GATE, "--tree", $rp109], {timeout: 300})
$f = $f + ok("T109b and the same repository named at its top gives the same verdict",
  $c109["exit_code"] == 1
    and contains($c109["stdout"] .. $c109["stderr"], "leak-at-the-root.txt")
    and contains($c109["stdout"] .. $c109["stderr"], "hygiene-scan-complete: 1"),
  join(["", $c109["exit_code"], " ",
    sanitize(substr($c109["stdout"] .. $c109["stderr"], 0, 500))], ""))
-- And a clean repository named by a subdirectory still exits 0 — the
-- canonicalisation must not turn every subdirectory invocation into a refusal
-- in the other direction.
$rp109c = newrepo("t109-clean-named-by-a-subdirectory")
write_file($rp109c .. "/.gitignore", "*.tmp\n")
write_file($rp109c .. "/root.txt", "nothing here either\n")
mkdir($rp109c .. "/sub")
write_file($rp109c .. "/sub/clean.txt", "nothing to see\n")
$unused109c = commit($rp109c, "t109c")
$o109c = run_argv([$MIX, $GATE, "--tree", $rp109c .. "/sub"], {timeout: 300})
$f = $f + ok("T109c and a clean repository named by a subdirectory exits 0",
  $o109c["exit_code"] == 0
    and contains($o109c["stdout"] .. $o109c["stderr"], "hygiene-scan-complete: 0"),
  join(["", $o109c["exit_code"], " ",
    sanitize(substr($o109c["stdout"] .. $o109c["stderr"], 0, 500))], ""))

-- ---------------------------------------------------------------------------
-- Round twenty-six's findings. Each row below is a kill, including the control
-- beside the provenance tightening: the attack must become foreign without
-- making an unfamiliar genuine stub foreign and re-arming the measured fork
-- bomb. The exact source reconstructions are recorded beside the rows and in
-- the round report; none is an exit-code-only substitute.
-- ---------------------------------------------------------------------------

-- T110 — install-mode validation and mutation shared one fleet loop. Repo A on
-- an ordinary mount was fully installed before repo B's noexec mount refused at
-- 2, leaving a half-mutated fleet under an answer that says the run could not be
-- trusted. T106e did not catch it because its one-repository fixture refused
-- before the first write. This fixture therefore needs TWO repositories and a
-- foreign sentinel hook in A: if install() is reachable before B is validated,
-- the sentinel is preserved and overwritten and the row goes red.
--
-- The mount table is synthetic for the same measured reason T106d records:
-- user-namespace ownership changes make a kernel noexec mount refuse earlier
-- on the ancestor walk. path_is_noexec's real parser is still used; only its
-- input path is redirected so this row isolates fleet ordering.
$rp110a = newrepo("t110-first-repo-must-stay-untouched")
$rp110b = newrepo("t110-second-repo-refuses-noexec")
$hooks110a = $rp110a .. "/.git/hooks"
$hooks110b = $rp110b .. "/.git/hooks"
$sentinel110 = join([
  "#!" .. $MIX .. "\n",
  "-- foreign sentinel: any rewrite means validation and mutation interleaved\n",
  "exit(0)\n"
], "")
write_file($hooks110a .. "/pre-commit", $sentinel110)
chmod($hooks110a .. "/pre-commit", 0o755)
$c110 = $ROOT .. "/t110.conf.mix"
write_file($c110, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp110a .. "\", \"" .. $rp110b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$mounts110 = $ROOT .. "/t110-noexec-mounts"
write_file($mounts110, join([
  "/dev/probe0 / ext4 rw,relatime 0 0\n",
  "tmpfs ", realpath($hooks110b),
  " tmpfs rw,nosuid,nodev,noexec,relatime 0 0\n"
], ""))
$i110 = $ROOT .. "/install-t110.mix"
write_file($i110, must_replace(must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c110 .. "\""),
  "read_file(\"/proc/mounts\")", "read_file(\"" .. $mounts110 .. "\")"))
$o110 = run_installer([$MIX, $i110], {timeout: 900})
$t110 = $o110["stdout"] .. $o110["stderr"]
$untouched110 = exists($hooks110a .. "/pre-commit", {follow_symlinks: false}) \
  and read_file($hooks110a .. "/pre-commit") == $sentinel110 \
  and exists($hooks110a .. "/pre-commit.pre-hygiene",
    {follow_symlinks: false}) == false \
  and exists($hooks110a .. "/commit-msg", {follow_symlinks: false}) == false \
  and exists($hooks110a .. "/pre-push", {follow_symlinks: false}) == false
$f = $f + ok("T110 a later repo's refusal leaves every earlier hooks directory untouched",
  $o110["exit_code"] == 2
    and contains($t110, "mounted noexec")
    and $untouched110,
  join(["", $o110["exit_code"], " untouched=", "" .. $untouched110, " ",
    sanitize(substr($t110, 0, 700))], ""))

-- T111 — round twenty-five treated every failed `rev-parse --show-toplevel` as
-- a bare repository and silently kept the supplied subdirectory. This is a real
-- non-bare repository; the git shim delegates every operation except the one
-- discovery question, which genuinely exits nonzero. Against the old fallback
-- the scan continues from `sub/` and later refuses on its path/mode cross-check.
-- The row asks for the new discovery diagnostic itself, so that downstream 2
-- cannot make it green for the wrong reason.
$rp111 = newrepo("t111-non-bare-top-level-discovery-fails")
write_file($rp111 .. "/root.txt", "clean root content\n")
mkdir($rp111 .. "/sub")
write_file($rp111 .. "/sub/inside.txt", "clean subtree content\n")
$unused111 = commit($rp111, "t111")
$w111 = $ROOT .. "/t111-bin"
mkdir($w111)
$log111 = $ROOT .. "/t111-discovery.log"
write_file($log111, "")
$realgit111 = which("git")
write_file($w111 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"--show-toplevel\") then\n",
  "  append_file(\"" .. $log111 .. "\", \"show-toplevel failed\\n\")\n",
  "  eprint(\"probe: top-level discovery unavailable\")\n",
  "  exit(7)\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit111 .. "\"], $a)))\n"
], ""))
chmod($w111 .. "/git", 0o755)
$bare111 = run_argv([$realgit111, "-C", $rp111,
  "rev-parse", "--is-bare-repository"], {timeout: 60})
$o111 = run_argv([$MIX, $GATE, "--tree", $rp111 .. "/sub"],
  {timeout: 300, env: {PATH: $w111 .. ":" .. env("PATH")}})
$t111 = $o111["stdout"] .. $o111["stderr"]
$f = $f + ok("T111 failed top-level discovery in a non-bare repo refuses at its trust boundary",
  $bare111["exit_code"] == 0
    and trim($bare111["stdout"]) == "false"
    and read_file($log111) == "show-toplevel failed\n"
    and $o111["exit_code"] == 2
    and contains($t111, "top-level discovery failed")
    and contains($t111, "scan's paths cannot be trusted")
    and contains($t111, "disagree about") == false,
  join(["bare=", trim($bare111["stdout"]), " rc=", "" .. $o111["exit_code"],
    " log=", sanitize(read_file($log111)), " ",
    sanitize(substr($t111, 0, 700))], ""))

-- T112 — stub ownership has three states, not a permissive marker predicate.
-- Round twenty-six tried to make the claimed checkout a whitespace-free token.
-- That rejects legal POSIX paths and is removed here; provenance is instead a
-- valid line-2 claim PLUS an exact body from the historical template set.
--
-- T112a is the no-claim/FOREIGN state. It deliberately mentions the marker and
-- hygiene-hook.mix in prose, the two guesses rounds twenty-two through
-- twenty-five used to destroy foreign policy hooks. Removing the line-2 claim
-- check or reverting to either substring test skips preservation and turns this
-- row red.
$rp112 = newrepo("t112-foreign-with-prose-mentions")
$hooks112 = $rp112 .. "/.git/hooks"
$foreign112 = join([
  "#!" .. $MIX .. "\n",
  "-- cosmix-hygiene-gate compatibility helper\n",
  "-- independent of hygiene-hook.mix; this foreign veto must survive\n",
  "exit(1)\n"
], "")
write_file($hooks112 .. "/pre-commit", $foreign112)
chmod($hooks112 .. "/pre-commit", 0o755)
$c112 = $ROOT .. "/t112.conf.mix"
write_file($c112, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp112 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$i112 = $ROOT .. "/install-t112.mix"
write_file($i112, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c112 .. "\""))
$o112 = run_installer([$MIX, $i112], {timeout: 900})
$saved112 = $hooks112 .. "/pre-commit.pre-hygiene"
$f = $f + ok("T112a a hook with no valid provenance claim is foreign and preserved",
  $o112["exit_code"] == 0
    and exists($saved112, {follow_symlinks: false})
    and read_file($saved112) == $foreign112
    and read_or_empty($hooks112 .. "/pre-commit") != $foreign112,
  join(["", $o112["exit_code"], " saved=",
    "" .. exists($saved112, {follow_symlinks: false}), " ",
    sanitize(substr($o112["stdout"] .. $o112["stderr"], 0, 500))], ""))

-- T112b is the valid-claim/UNKNOWN-body state, and deliberately replaces a
-- shipped round-twenty-six assertion. That assertion said this unfamiliar body
-- from another checkout was ours and must be overwritten silently. It encoded
-- the now-stale belief that accepting every claimed body was the only defence
-- against the measured fork bomb. The recursion check has since made a
-- self-chain refuse at 2, and accepting arbitrary bodies loses foreign data.
-- The safe answer is now refusal before ANY repository mutates.
--
-- Repo A is the fleet-order witness. Removing the unknown-body preflight while
-- leaving the refusal inside install() writes A's three hooks before B refuses;
-- changing UNKNOWN back to OURS overwrites B and exits 0. Either minimal
-- reconstruction turns this row red for its own reason.
$rp112a = newrepo("t112-unknown-claim-first-repo")
$hooks112a = $rp112a .. "/.git/hooks"
$sentinel112a = join([
  "#!" .. $MIX .. "\n",
  "-- first-repository sentinel\n",
  "exit(0)\n"
], "")
write_file($hooks112a .. "/pre-commit", $sentinel112a)
chmod($hooks112a .. "/pre-commit", 0o755)
$rp112b = newrepo("t112-unknown-claim-second-repo")
$hooks112b = $rp112b .. "/.git/hooks"
$unknown112b = join([
  "#!" .. $MIX .. "\n",
  "-- cosmix-hygiene-gate — installed by ",
  "/srv/another-cmctl/_bin/install-hygiene-hooks.mix\n",
  "-- valid claim, deliberately no known historical body\n",
  "print(\"unfamiliar claimed stub\")\n",
  "exit(0)\n"
], "")
write_file($hooks112b .. "/pre-commit", $unknown112b)
chmod($hooks112b .. "/pre-commit", 0o755)
$c112b = $ROOT .. "/t112b.conf.mix"
write_file($c112b, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp112a .. "\", \"" .. $rp112b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$i112b = $ROOT .. "/install-t112b.mix"
write_file($i112b, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c112b .. "\""))
$o112b = run_installer([$MIX, $i112b], {timeout: 900})
$saved112b = $hooks112b .. "/pre-commit.pre-hygiene"
$untouched112a = read_or_empty($hooks112a .. "/pre-commit") == $sentinel112a \
  and exists($hooks112a .. "/pre-commit.pre-hygiene",
    {follow_symlinks: false}) == false \
  and exists($hooks112a .. "/commit-msg", {follow_symlinks: false}) == false \
  and exists($hooks112a .. "/pre-push", {follow_symlinks: false}) == false
$f = $f + ok("T112b a valid claim with an unknown body refuses before any repo changes",
  $o112b["exit_code"] == 2
    and contains($o112b["stdout"] .. $o112b["stderr"],
      "matches no stub template known")
    and contains($o112b["stdout"] .. $o112b["stderr"],
      "Inspect and remove")
    and $untouched112a
    and exists($saved112b, {follow_symlinks: false}) == false
    and read_or_empty($hooks112b .. "/pre-commit") == $unknown112b,
  join(["", $o112b["exit_code"], " first_untouched=", "" .. $untouched112a,
    " saved=",
    "" .. exists($saved112b, {follow_symlinks: false}), " ",
    sanitize(substr($o112b["stdout"] .. $o112b["stderr"], 0, 500))], ""))

-- T112c is the valid-claim/OURS state under the pathname grammar round
-- twenty-six got wrong. The checkout root contains an internal space, a TAB and
-- trailing whitespace. Its installer emits a genuine stub, then recognises and
-- replaces that same stub on a second silent/idempotent run. Restoring
-- trim($middle)==$middle or words($middle)==1 makes the second run preserve the
-- stub below itself (or, with the new classifier, refuse), so the row goes red.
$rp112c = newrepo("t112-whitespace-checkout-repo")
$hooks112c = $rp112c .. "/.git/hooks"
$cmctl112c = $ROOT .. "/control plane\t "
mkdir($cmctl112c .. "/_bin")
mkdir($cmctl112c .. "/_etc")
copy($GATE, $cmctl112c .. "/_bin/check-public-hygiene.mix")
copy($HOOK, $cmctl112c .. "/_bin/hygiene-hook.mix")
chmod($cmctl112c .. "/_bin/check-public-hygiene.mix", 0o755)
chmod($cmctl112c .. "/_bin/hygiene-hook.mix", 0o755)
write_file($cmctl112c .. "/_etc/public-hygiene.conf.mix", join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp112c .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$install112c = $cmctl112c .. "/_bin/install-hygiene-hooks.mix"
-- must_replace, not replace: round thirty-nine's NIT six. This was the last
-- production-source rewrite in the suite still going through the bare builtin,
-- which is the one round twenty-eight's helper was written for in the first
-- place. The T112c0 row below stays — it proves the generated program's SCOPE,
-- which is a different question from whether the anchor matched exactly once,
-- and neither subsumes the other.
$src112c = must_replace(read_file($INSTALL),
  "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cmctl112c .. "\"")
$safe112c = contains($src112c, $CMCTL) == false \
  and contains($src112c, $cmctl112c)
$f = $f + ok("T112c0 generated installer cannot address the live cmctl checkout",
  $safe112c,
  join(["live_root_present=", "" .. contains($src112c, $CMCTL),
    " fixture_root_present=", "" .. contains($src112c, $cmctl112c)], ""))
if $safe112c == false then
  print("T112c0 refused to execute an installer whose fixture scope was not proved")
  exit(2)
end
write_file($install112c, $src112c)
chmod($install112c, 0o755)
$first112c = run_installer([$MIX, $install112c], {timeout: 900})
$body112c = read_or_empty($hooks112c .. "/pre-commit")
$second112c = run_installer([$MIX, $install112c], {timeout: 900})
$saved112c = $hooks112c .. "/pre-commit.pre-hygiene"
$f = $f + ok("T112c a whitespace-bearing checkout recognises its own emitted stub",
  $first112c["exit_code"] == 0
    and $second112c["exit_code"] == 0
    and contains($body112c,
      $cmctl112c .. "/_bin/install-hygiene-hooks.mix")
    and read_or_empty($hooks112c .. "/pre-commit") == $body112c
    and exists($saved112c, {follow_symlinks: false}) == false,
  join(["first=", "" .. $first112c["exit_code"], " second=",
    "" .. $second112c["exit_code"], " saved=",
    "" .. exists($saved112c, {follow_symlinks: false}), " ",
    sanitize(substr($second112c["stdout"] .. $second112c["stderr"], 0, 500))], ""))

-- T112d keeps the cross-checkout compatibility T112b used to stand for, but
-- with a body this installer actually emitted. The embedded root is different;
-- the exact current template under that root is nevertheless OURS and is
-- replaced silently. Comparing the claim to $CMCTL instead of using it to
-- parameterise the template creates a preservation copy and turns this row red.
$rp112d = newrepo("t112-known-stub-from-a-different-cmctl")
$hooks112d = $rp112d .. "/.git/hooks"
$other112d = "/srv/another-cmctl"
$known112d = join([
  "#!" .. $MIX .. "\n",
  "-- cosmix-hygiene-gate — installed by " .. $other112d,
  "/_bin/install-hygiene-hooks.mix\n",
  "-- Logic lives in " .. $other112d,
  "/_bin/hygiene-hook.mix (edit there; no reinstall needed).\n",
  "exit(run_stream(concat([\"" .. $MIX .. "\", \"" .. $other112d,
  "/_bin/hygiene-hook.mix\", \"pre-commit\"], args())))\n"
], "")
write_file($hooks112d .. "/pre-commit", $known112d)
chmod($hooks112d .. "/pre-commit", 0o755)
$c112d = $ROOT .. "/t112d.conf.mix"
write_file($c112d, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp112d .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$i112d = $ROOT .. "/install-t112d.mix"
write_file($i112d, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c112d .. "\""))
$o112d = run_installer([$MIX, $i112d], {timeout: 900})
$saved112d = $hooks112d .. "/pre-commit.pre-hygiene"
$f = $f + ok("T112d a known stub from another checkout is replaced silently",
  $o112d["exit_code"] == 0
    and exists($saved112d, {follow_symlinks: false}) == false
    and read_or_empty($hooks112d .. "/pre-commit") != $known112d
    and contains(read_or_empty($hooks112d .. "/pre-commit"),
      $CMCTL .. "/_bin/install-hygiene-hooks.mix"),
  join(["", $o112d["exit_code"], " saved=",
    "" .. exists($saved112d, {follow_symlinks: false}), " ",
    sanitize(substr($o112d["stdout"] .. $o112d["stderr"], 0, 500))], ""))

-- T113 — naming one repository by two DIFFERENT configured strings is harmless
-- but wasteful: `repo` and `repo/sub` canonicalise to the same (top, gitdir)
-- identity. Round twenty-six's fixture repeated the exact same string, so a
-- regression that deduped raw entries instead of canonical identities stayed
-- green. This widened fixture kills that hollow implementation. Since
-- 2026-07-28 scan() issues exactly ONE `ls-tree --name-only` per scanned tree
-- (the shared, cross-validated path set), so ONE logged command means one
-- complete scan; deduping before canonicalisation, or restoring the
-- unconditional identity append, writes two log rows and turns this
-- assertion red.
$rp113 = newrepo("t113-duplicate-configured-top-level")
write_file($rp113 .. "/clean.txt", "nothing private here\n")
mkdir($rp113 .. "/sub")
write_file($rp113 .. "/sub/also-clean.txt", "still nothing private\n")
$unused113 = commit($rp113, "t113")
$c113 = $ROOT .. "/t113.conf.mix"
write_file($c113, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp113 .. "\", \"" .. $rp113 .. "/sub\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate113 = $ROOT .. "/gate-t113.mix"
write_file($gate113, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c113 .. "\""))
$w113 = $ROOT .. "/t113-bin"
mkdir($w113)
$log113 = $ROOT .. "/t113-scans.log"
write_file($log113, "")
$realgit113 = which("git")
write_file($w113 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"ls-tree\") and contains($a, \"--name-only\") then\n",
  "  append_file(\"" .. $log113 .. "\", \"scan\\n\")\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit113 .. "\"], $a)))\n"
], ""))
chmod($w113 .. "/git", 0o755)
$o113 = run_argv([$MIX, $gate113, "--all"],
  {timeout: 600, env: {PATH: $w113 .. ":" .. env("PATH")}})
$scans113 = 0
for each $line113 in split(read_file($log113), "\n")
  if $line113 == "scan" then
    $scans113 = $scans113 + 1
  end
end
-- == 1 since 2026-07-28: scan() reads `--name-only` ONCE per scanned tree and
-- shares the set (the second, unvalidated read was itself a reviewed defect —
-- a shim answering only that call with empty success silently emptied the
-- pathname pass). A failed dedupe doubles this to 2, which is what the row
-- still guards.
$f = $f + ok("T113 repo and repo/sub are canonicalised and scanned exactly once",
  $o113["exit_code"] == 0
    and contains($o113["stdout"] .. $o113["stderr"], "hygiene-scan-complete: 0")
    and $scans113 == 1,
  join(["", $o113["exit_code"], " scans=", "" .. $scans113, " ",
    sanitize(substr($o113["stdout"] .. $o113["stderr"], 0, 500))], ""))

-- T114 — a top-level pathname is not a repository identity. B owns its own
-- gitdir and leaking HEAD but core.worktree points at A, so Git reports A as
-- B's top level. Round twenty-five replaced both configured entries with A and
-- scanned A twice; round twenty-six then deduped those strings and scanned A
-- once. Both exited 0 over B's unread leaking content.
--
-- The premise reads B's object directly and proves the private content and
-- leak.txt are genuinely in B's HEAD, while A's HEAD lacks that path. The gate
-- must then refuse specifically because entry and top resolve to different
-- gitdirs. Removing only the top-gitdir equality check reconstructs the defect:
-- the pair dedupe keeps two identities but the scan paths are A/A, so this row
-- gets exit 0 and loses the diagnostic rather than passing on an unrelated 2.
$rp114a = newrepo("t114-top-level-repository")
write_file($rp114a .. "/clean.txt", "clean A content\n")
$sha114a = commit($rp114a, "t114a")
$rp114b = newrepo("t114-separate-gitdir-repository")
write_file($rp114b .. "/leak.txt",
  "private endpoint " .. $IP .. " for " .. $NODE .. "\n")
$sha114b = commit($rp114b, "t114b")
must($rp114b, ["git", "config", "core.worktree", $rp114a])
$top114b = trim(must($rp114b, ["git", "rev-parse", "--show-toplevel"]))
$gitdir114a = trim(must($rp114a,
  ["git", "rev-parse", "--absolute-git-dir"]))
$gitdir114b = trim(must($rp114b,
  ["git", "rev-parse", "--absolute-git-dir"]))
$content114b = must($rp114b, ["git", "show", $sha114b .. ":leak.txt"])
$tree114a = must($rp114a, ["git", "ls-tree", "--name-only", $sha114a])
$c114 = $ROOT .. "/t114.conf.mix"
write_file($c114, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp114a .. "\", \"" .. $rp114b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate114 = $ROOT .. "/gate-t114.mix"
write_file($gate114, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c114 .. "\""))
$o114 = run_argv([$MIX, $gate114, "--all"], {timeout: 600})
$t114 = $o114["stdout"] .. $o114["stderr"]
$f = $f + ok("T114 core.worktree cannot substitute another repository's objects",
  $top114b == realpath($rp114a)
    and $gitdir114a != $gitdir114b
    and contains($content114b, $IP)
    and contains($content114b, $NODE)
    and contains($tree114a, "leak.txt") == false
    and $o114["exit_code"] != 0
    and contains($t114, "resolve to different repositories")
    and contains($t114, $gitdir114a)
    and contains($t114, $gitdir114b)
    and contains($t114, "hygiene-scan-complete:") == false,
  join(["rc=", "" .. $o114["exit_code"], " top=",
    sanitize($top114b), " content=", sanitize($content114b), " ",
    sanitize(substr($t114, 0, 700))], ""))

-- T115 — discovery and scanning must ask Git under one environment. This
-- repository is root-owned, so the invoking user's Git refuses it unless safe.directory is
-- supplied through XDG_CONFIG_HOME. The ordinary scan inherits that config;
-- round twenty-six's git_uncontaminated discovery stripped it and refused
-- before reading a byte. Replacing discovery_git() with
-- git_uncontaminated() reconstructs that exact false refusal: this row sees
-- exit 2 instead of the leaking file and verdict marker.
$rp115 = newrepo("t115-safe-directory-through-xdg")
write_file($rp115 .. "/leak.txt",
  "root-owned private endpoint " .. $IP .. " for " .. $NODE .. "\n")
$unused115 = commit($rp115, "t115")
$xdg115 = $ROOT .. "/t115-xdg"
mkdir($xdg115 .. "/git")
write_file($xdg115 .. "/git/config",
  "[safe]\n\tdirectory = " .. $rp115 .. "\n")
$c115 = $ROOT .. "/t115.conf.mix"
write_file($c115, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp115 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate115 = $ROOT .. "/gate-t115.mix"
write_file($gate115, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c115 .. "\""))
$own115 = run_argv(["sudo", "-n", "chown", "-R", "0:0", $rp115],
  {timeout: 120})
$o115 = run_argv([$MIX, $gate115, "--tree", $rp115],
  {timeout: 600, env: {XDG_CONFIG_HOME: $xdg115}})
$t115 = $o115["stdout"] .. $o115["stderr"]
$restore115 = run_argv(["sudo", "-n", "chown", "-R",
  ("" .. uid()) .. ":" .. ("" .. gid()), $rp115], {timeout: 120})
$f = $f + ok("T115 inherited safe.directory authorisation is shared by discovery and scan",
  $own115["exit_code"] == 0
    and $restore115["exit_code"] == 0
    and $o115["exit_code"] == 1
    and contains($t115, "leak.txt")
    and contains($t115, "hygiene-scan-complete: 1")
    and contains($t115, "top-level discovery failed") == false,
  join(["chown=", "" .. $own115["exit_code"], " rc=",
    "" .. $o115["exit_code"], " restore=", "" .. $restore115["exit_code"], " ",
    sanitize(substr($t115, 0, 700))], ""))

-- T116 — --message reads one pending message file and no repository object.
-- Round twenty-six nevertheless called repo_toplevel(), so an invalid or
-- unauthorised repo path blocked commit-message inspection before the string
-- was scanned. A PATH shim records and rejects every Git call; the fixed mode
-- must find the private message with an empty log. Removing only the
-- `$kind != "message"` discovery guard makes the shim fire and this row turn
-- red at exit 2, so a downstream refusal cannot satisfy it.
$msg116 = $ROOT .. "/t116-message"
write_file($msg116, "pending message mentions " .. $NODE .. " at " .. $IP .. "\n")
$w116 = $ROOT .. "/t116-bin"
mkdir($w116)
$log116 = $ROOT .. "/t116-git.log"
write_file($log116, "")
write_file($w116 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "append_file(\"" .. $log116 .. "\", join(args(), \" \") .. \"\\n\")\n",
  "eprint(\"T116: repository discovery must not run\")\n",
  "exit(73)\n"
], ""))
chmod($w116 .. "/git", 0o755)
$o116 = run_argv([$MIX, $GATE, "--message",
  "/not/a/repository-and-deliberately-so", $msg116],
  {timeout: 600, env: {PATH: $w116 .. ":" .. env("PATH")}})
$t116 = $o116["stdout"] .. $o116["stderr"]
$f = $f + ok("T116 --message scans its string without consulting repository discovery",
  $o116["exit_code"] == 1
    and read_file($log116) == ""
    and contains($t116, "<pending-commit-message>")
    and contains($t116, "hygiene-scan-complete: 1"),
  join(["", $o116["exit_code"], " git_log=", sanitize(read_file($log116)), " ",
    sanitize(substr($t116, 0, 700))], ""))

-- T117 — round twenty-six's fleet preflight stopped at directory/mount checks.
-- Repo B's foreign hook plus an occupied `.pre-hygiene` destination reaches a
-- deterministic refusal inside install(); the old two-pass shape gets there
-- only after repo A is fully installed. A content-and-mode digest proves A's
-- entire hooks directory is byte-untouched, including git's sample hooks.
-- Removing only the preflight_install() fleet loop reconstructs the defect:
-- install() still refuses B for the right reason, but A's digest changes and
-- this row goes red.
$rp117a = newrepo("t117-first-repo-must-be-byte-untouched")
$rp117b = newrepo("t117-second-repo-has-occupied-preservation")
$hooks117a = $rp117a .. "/.git/hooks"
$hooks117b = $rp117b .. "/.git/hooks"
$foreign117a = join([
  "#!" .. $MIX .. "\n",
  "-- first repo foreign sentinel\n",
  "exit(0)\n"
], "")
$foreign117b = join([
  "#!" .. $MIX .. "\n",
  "-- second repo foreign hook\n",
  "exit(0)\n"
], "")
$occupied117b = join([
  "#!" .. $MIX .. "\n",
  "-- existing preservation copy; never overwrite\n",
  "exit(1)\n"
], "")
write_file($hooks117a .. "/pre-commit", $foreign117a)
chmod($hooks117a .. "/pre-commit", 0o755)
write_file($hooks117b .. "/pre-commit", $foreign117b)
chmod($hooks117b .. "/pre-commit", 0o755)
write_file($hooks117b .. "/pre-commit.pre-hygiene", $occupied117b)
chmod($hooks117b .. "/pre-commit.pre-hygiene", 0o755)
$before117a = hooks_digest($hooks117a)
$c117 = $ROOT .. "/t117.conf.mix"
write_file($c117, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp117a .. "\", \"" .. $rp117b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$i117 = $ROOT .. "/install-t117.mix"
write_file($i117, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c117 .. "\""))
$o117 = run_installer([$MIX, $i117], {timeout: 900})
$t117 = $o117["stdout"] .. $o117["stderr"]
$after117a = hooks_digest($hooks117a)
$f = $f + ok("T117 a later occupied preservation path leaves repo A byte-untouched",
  $o117["exit_code"] == 2
    and contains($t117, "pre-commit.pre-hygiene already exists")
    and contains($t117, "before any repository was changed")
    and $before117a == $after117a
    and read_or_empty($hooks117b .. "/pre-commit") == $foreign117b
    and read_or_empty($hooks117b .. "/pre-commit.pre-hygiene") == $occupied117b,
  join(["", $o117["exit_code"], " before=", $before117a,
    " after=", $after117a, " ", sanitize(substr($t117, 0, 700))], ""))

-- ---------------------------------------------------------------------------
-- Round twenty-eight's findings. Each row asserts the changed state or content,
-- not merely the refusal code: message mode's git log stays empty, bare
-- identities collapse to one scan and print a real path, fleet preflight leaves
-- repo A byte-identical, and the staged-race diagnostic is checked against the
-- mutations the same run actually left behind.
-- ---------------------------------------------------------------------------

-- T118 — --message does not read GIT_DIR any more than it reads an index.
-- Without --from-hook the old early guard refused before scanning; with it the
-- guard launched git_uncontaminated() to validate a repository the mode never
-- touches. A rejecting shim and byte-empty log kill both paths independently.
$msg118a = $ROOT .. "/t118-leaking-message"
$msg118b = $ROOT .. "/t118-clean-message"
write_file($msg118a, "pending message names " .. $NODE .. " at " .. $IP .. "\n")
write_file($msg118b, "ordinary pending message\n")
$w118 = $ROOT .. "/t118-bin"
mkdir($w118)
$log118 = $ROOT .. "/t118-git.log"
write_file($log118, "")
write_file($w118 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "append_file(\"" .. $log118 .. "\", join(args(), \" \") .. \"\\n\")\n",
  "eprint(\"T118: message mode must not run git\")\n",
  "exit(74)\n"
], ""))
chmod($w118 .. "/git", 0o755)
$gd118 = $ROOT .. "/irrelevant-gitdir"
$o118a = run_argv([$MIX, $GATE, "--message",
  "/not/a/repository", $msg118a],
  {timeout: 600, env: {
    PATH: $w118 .. ":" .. env("PATH"), GIT_DIR: $gd118
  }})
$t118a = $o118a["stdout"] .. $o118a["stderr"]
$f = $f + ok("T118a ambient GIT_DIR does not hide a real message violation",
  $o118a["exit_code"] == 1
    and read_file($log118) == ""
    and contains($t118a, "<pending-commit-message>")
    and contains($t118a, "hygiene-scan-complete: 1"),
  join(["", $o118a["exit_code"], " git_log=", sanitize(read_file($log118)),
    " ", sanitize(substr($t118a, 0, 600))], ""))
$o118b = run_argv([$MIX, $GATE, "--message",
  "/still/not/a/repository", $msg118b, "--from-hook"],
  {timeout: 600, env: {
    PATH: $w118 .. ":" .. env("PATH"), GIT_DIR: $gd118
  }})
$t118b = $o118b["stdout"] .. $o118b["stderr"]
$f = $f + ok("T118b --from-hook message mode also reaches its clean verdict without git",
  $o118b["exit_code"] == 0
    and read_file($log118) == ""
    and contains($t118b, "hygiene-scan-complete: 0"),
  join(["", $o118b["exit_code"], " git_log=", sanitize(read_file($log118)),
    " ", sanitize(substr($t118b, 0, 600))], ""))

-- T119 — for a bare repository `rev-parse --absolute-git-dir` names the
-- repository itself, including when discovery starts at `repo/.` or
-- `repo/objects` (measured against the installed Git before relying on it).
-- The pair alias must therefore scan once, and a subdirectory invocation must
-- report the canonical repository path rather than invent `objects/leak.txt`.
$src119 = newrepo("t119-bare-source")
write_file($src119 .. "/clean.txt", "ordinary bare content\n")
$unused119a = commit($src119, "t119 clean")
$bare119 = bare("t119-canonical")
must($src119, ["git", "push", "-q", $bare119, "HEAD:refs/heads/main"])
must($bare119, ["git", "symbolic-ref", "HEAD", "refs/heads/main"])
$c119 = $ROOT .. "/t119.conf.mix"
write_file($c119, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $bare119 .. "\", \"" .. $bare119 .. "/.\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate119 = $ROOT .. "/gate-t119.mix"
write_file($gate119, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c119 .. "\""))
$w119 = $ROOT .. "/t119-bin"
mkdir($w119)
$log119 = $ROOT .. "/t119-scans.log"
write_file($log119, "")
$realgit119 = which("git")
write_file($w119 .. "/git", join([
  "#!" .. $MIX .. "\n",
  "$a = args()\n",
  "if contains($a, \"ls-tree\") and contains($a, \"--name-only\") then\n",
  "  append_file(\"" .. $log119 .. "\", \"scan\\n\")\n",
  "end\n",
  "exit(run_stream(concat([\"" .. $realgit119 .. "\"], $a)))\n"
], ""))
chmod($w119 .. "/git", 0o755)
$o119a = run_argv([$MIX, $gate119, "--all"],
  {timeout: 600, env: {PATH: $w119 .. ":" .. env("PATH")}})
$scans119 = 0
for each $line119 in split(read_file($log119), "\n")
  if $line119 == "scan" then
    $scans119 = $scans119 + 1
  end
end
-- == 1 for the same reason as T113: one `--name-only` read per scanned tree
-- since 2026-07-28; a failed alias dedupe doubles it.
$f = $f + ok("T119a bare repo and bare repo dot alias are scanned exactly once",
  $o119a["exit_code"] == 0
    and $scans119 == 1
    and contains($o119a["stdout"] .. $o119a["stderr"],
      "hygiene-scan-complete: 0"),
  join(["", $o119a["exit_code"], " scans=", "" .. $scans119, " ",
    sanitize(substr($o119a["stdout"] .. $o119a["stderr"], 0, 500))], ""))
write_file($src119 .. "/leak.txt",
  "private bare content " .. $NODE .. " at " .. $IP .. "\n")
$unused119b = commit($src119, "t119 leak")
must($src119, ["git", "push", "-q", $bare119, "HEAD:refs/heads/main"])
$o119b = run_argv([$MIX, $GATE, "--tree", $bare119 .. "/objects"],
  {timeout: 600})
$t119b = $o119b["stdout"] .. $o119b["stderr"]
$f = $f + ok("T119b bare subdirectory diagnostics use the canonical repository top",
  $o119b["exit_code"] == 1
    and contains($t119b, $bare119 .. "/leak.txt")
    and contains($t119b, $bare119 .. "/objects/leak.txt") == false
    and contains($t119b, "hygiene-scan-complete: 1"),
  join(["", $o119b["exit_code"], " ",
    sanitize(substr($t119b, 0, 700))], ""))

-- T120 — text readability is not preservation readability. The mode-000
-- foreign hook in repo B has a deterministic source-side failure before the
-- run starts; fleet preflight must find it by attempting a binary read, while
-- repo A's complete hooks directory remains byte-identical.
$rp120a = newrepo("t120-first-repo-must-stay-untouched")
$rp120b = newrepo("t120-second-repo-unreadable-source")
$hooks120a = $rp120a .. "/.git/hooks"
$hooks120b = $rp120b .. "/.git/hooks"
$foreign120a = "#!" .. $MIX .. "\n-- t120 repo A sentinel\nexit(0)\n"
$foreign120b = "#!" .. $MIX .. "\n-- t120 unreadable hook\nexit(0)\n"
write_file($hooks120a .. "/pre-commit", $foreign120a)
chmod($hooks120a .. "/pre-commit", 0o755)
write_file($hooks120b .. "/pre-commit", $foreign120b)
chmod($hooks120b .. "/pre-commit", 0o000)
$before120a = hooks_digest($hooks120a)
$c120 = $ROOT .. "/t120.conf.mix"
write_file($c120, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp120a .. "\", \"" .. $rp120b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$i120 = $ROOT .. "/install-t120.mix"
write_file($i120, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c120 .. "\""))
$o120 = run_installer([$MIX, $i120], {timeout: 900})
$t120 = $o120["stdout"] .. $o120["stderr"]
$after120a = hooks_digest($hooks120a)
$st120b = stat($hooks120b .. "/pre-commit", {follow_symlinks: false})
$f = $f + ok("T120 unreadable foreign source refuses before repo A changes",
  $o120["exit_code"] == 2
    and contains($t120, "bytes cannot be read")
    and contains($t120, "before any repository was changed")
    and $before120a == $after120a
    and $st120b["perm"] == 0
    and exists($hooks120b .. "/pre-commit.pre-hygiene",
      {follow_symlinks: false}) == false,
  join(["", $o120["exit_code"], " before=", $before120a,
    " after=", $after120a, " perm=", "" .. $st120b["perm"], " ",
    sanitize(substr($t120, 0, 700))], ""))

-- T121 — a dangling foreign hook is the other deterministic source refusal.
-- lstat says the entry exists, but the binary read cannot follow it to bytes.
-- The link itself and every byte in repo A must survive the fleet refusal.
$rp121a = newrepo("t121-first-repo-must-stay-untouched")
$rp121b = newrepo("t121-second-repo-dangling-source")
$hooks121a = $rp121a .. "/.git/hooks"
$hooks121b = $rp121b .. "/.git/hooks"
$foreign121a = "#!" .. $MIX .. "\n-- t121 repo A sentinel\nexit(0)\n"
write_file($hooks121a .. "/pre-commit", $foreign121a)
chmod($hooks121a .. "/pre-commit", 0o755)
$dangling121 = $ROOT .. "/t121-missing-hook-target"
symlink($dangling121, $hooks121b .. "/pre-commit")
$before121a = hooks_digest($hooks121a)
$c121 = $ROOT .. "/t121.conf.mix"
write_file($c121, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp121a .. "\", \"" .. $rp121b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$i121 = $ROOT .. "/install-t121.mix"
write_file($i121, must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c121 .. "\""))
$o121 = run_installer([$MIX, $i121], {timeout: 900})
$t121 = $o121["stdout"] .. $o121["stderr"]
$after121a = hooks_digest($hooks121a)
$f = $f + ok("T121 dangling foreign source refuses before repo A changes",
  $o121["exit_code"] == 2
    and contains($t121, "bytes cannot be read")
    and contains($t121, "dangling symlink")
    and contains($t121, "before any repository was changed")
    and $before121a == $after121a
    and is_link($hooks121b .. "/pre-commit")
    and link_target($hooks121b .. "/pre-commit") == $dangling121
    and exists($hooks121b .. "/pre-commit.pre-hygiene",
      {follow_symlinks: false}) == false,
  join(["", $o121["exit_code"], " before=", $before121a,
    " after=", $after121a, " link=",
    sanitize(link_target($hooks121b .. "/pre-commit")), " ",
    sanitize(substr($t121, 0, 700))], ""))

-- T122 — inject the exact post-preflight race deterministically: repo B's
-- preservation staging file appears after the read-only pass but before repo A
-- installs. Repo A then changes, B's claim correctly refuses, and the only
-- honest diagnostic says earlier writes may already exist. The old
-- "nothing was changed" text fails while all filesystem state is held constant.
$rp122a = newrepo("t122-first-repo-installs-before-race")
$rp122b = newrepo("t122-second-repo-staging-race")
$hooks122a = $rp122a .. "/.git/hooks"
$hooks122b = $rp122b .. "/.git/hooks"
$foreign122a = "#!" .. $MIX .. "\n-- t122 repo A sentinel\nexit(0)\n"
$foreign122b = "#!" .. $MIX .. "\n-- t122 repo B sentinel\nexit(0)\n"
write_file($hooks122a .. "/pre-commit", $foreign122a)
chmod($hooks122a .. "/pre-commit", 0o755)
write_file($hooks122b .. "/pre-commit", $foreign122b)
chmod($hooks122b .. "/pre-commit", 0o755)
$race122 = $hooks122b .. "/pre-commit.pre-hygiene.tmp"
$race_body122 = "T122 post-preflight staging race\n"
$c122 = $ROOT .. "/t122.conf.mix"
write_file($c122, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp122a .. "\", \"" .. $rp122b .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$src122 = must_replace(read_file($INSTALL),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $c122 .. "\"")
$loop122 = join([
  "  for each $ready in $ready_repos\n",
  "    print($ready[\"repo\"])\n"
], "")
$injected122 = join([
  "  write_file(\"" .. $race122 \
    .. "\", \"T122 post-preflight staging race\\n\")\n",
  "  for each $ready in $ready_repos\n",
  "    -- T122 fixture injection separates this from the production anchor.\n",
  "    print($ready[\"repo\"])\n"
], "")
$i122 = $ROOT .. "/install-t122.mix"
write_file($i122, must_replace($src122, $loop122, $injected122))
$o122 = run_installer([$MIX, $i122], {timeout: 900})
$t122 = $o122["stdout"] .. $o122["stderr"]
$saved122a = $hooks122a .. "/pre-commit.pre-hygiene"
$f = $f + ok("T122 staging-race refusal admits earlier repository changes",
  $o122["exit_code"] == 2
    and read_or_empty($saved122a) == $foreign122a
    and read_or_empty($hooks122a .. "/pre-commit") != $foreign122a
    and contains(read_or_empty($hooks122a .. "/pre-commit"),
      "cosmix-hygiene-gate")
    and read_or_empty($hooks122b .. "/pre-commit") == $foreign122b
    and read_or_empty($race122) == $race_body122
    and contains($t122, "earlier hooks or repositories in this run may already")
    and contains($t122, "nothing was changed") == false
    and exists($hooks122b .. "/pre-commit.pre-hygiene",
      {follow_symlinks: false}) == false,
  join(["", $o122["exit_code"], " repo_a_saved=",
    "" .. (read_or_empty($saved122a) == $foreign122a), " race=",
    sanitize(read_or_empty($race122)), " ",
    sanitize(substr($t122, 0, 800))], ""))

-- T124/T125 — the two ways a tree can contain content this gate never reads.
-- Both were LATENT when they were found: all three public repos have zero
-- submodules and zero .gitattributes, so neither had ever leaked anything. They
-- are probed anyway, because the failure mode of both is a clean bill of health
-- over content that was never scanned, and the day one of them stops being
-- latent is not the day to discover the gate says "clean" about a file it
-- cannot see.
--
-- Both refuse with exit 2, not 1. The content may well be fine — the gate
-- simply cannot answer, and "could not answer" is the code this arc reserves
-- for exactly that. Calling it a violation would be a different lie.
--
-- The negative rows are not padding. Each guard's cheap wrong implementation
-- refuses too much rather than too little: "refuse whenever .gitattributes
-- exists" would pass the positive row and quietly stop three repositories from
-- ever committing again, which is how a safety check becomes the thing that
-- gets disabled. T125e is the other direction — proof the guards did not blunt
-- the gate's actual job.
$r124 = newrepo("t124")
write_file($r124 .. "/README.md", "nothing private here\n")
must($r124, ["git", "add", "README.md"])
-- update-index --cacheinfo, so no second real repository has to be built and
-- the entry is unambiguously mode 160000 whatever git's submodule tooling
-- would have done with it.
must($r124, ["git", "update-index", "--add", "--cacheinfo",
  "160000," .. substr($ZERO, 0, 39) .. "1,vendor/leaking-crate"])
-- Deliberately NOT commit(): that helper runs `git add -A` first, and with no
-- such directory on disk that stages the gitlink's own removal and the fixture
-- commits without the thing under test.
must($r124, ["git", "commit", "-q", "-m", "t124"])
$g124 = gate(["--tree", $r124])
$f = $f + ok("T124a a gitlink refuses (exit 2) rather than reporting clean",
  $g124["code"] == 2 and contains($g124["out"], "vendor/leaking-crate"),
  "" .. $g124["code"] .. " " .. $g124["out"])

$r124b = newrepo("t124b")
write_file($r124b .. "/README.md", "nothing private here\n")
commit($r124b, "t124b")
$g124b = gate(["--tree", $r124b])
$f = $f + ok("T124b the same tree without the gitlink still scans clean",
  $g124b["code"] == 0, "" .. $g124b["code"] .. " " .. $g124b["out"])

$r125 = newrepo("t125")
write_file($r125 .. "/.gitattributes", "*.bin filter=lfs -text\n")
write_file($r125 .. "/archive.bin", "version https://git-lfs.github.com/spec/v1\n")
commit($r125, "t125")
$g125 = gate(["--tree", $r125])
$f = $f + ok("T125a a content-filtered path refuses (exit 2): the stored object is not the published content",
  $g125["code"] == 2 and contains($g125["out"], "filter=lfs"),
  "" .. $g125["code"] .. " " .. $g125["out"])

$r125b = newrepo("t125b")
write_file($r125b .. "/.gitattributes", "* text eol=lf\n*.md diff=markdown\n")
write_file($r125b .. "/README.md", "nothing private here\n")
commit($r125b, "t125b")
$g125b = gate(["--tree", $r125b])
$f = $f + ok("T125b .gitattributes carrying no filter does not refuse",
  $g125b["code"] == 0, "" .. $g125b["code"] .. " " .. $g125b["out"])

-- `-filter` is git SAYING there is no filter here. Reading the attribute's
-- value ("unset") as the name of a filter would refuse on the one spelling
-- that explicitly promises the object is the content.
$r125c = newrepo("t125c")
write_file($r125c .. "/.gitattributes", "*.bin -filter\n")
write_file($r125c .. "/archive.bin", "plain bytes\n")
commit($r125c, "t125c")
$g125c = gate(["--tree", $r125c])
$f = $f + ok("T125c an explicitly unset filter is not treated as a filter",
  $g125c["code"] == 0, "" .. $g125c["code"] .. " " .. $g125c["out"])

$r125d = newrepo("t125d")
write_file($r125d .. "/.gitattributes", "*.psd filter=lfs\n")
write_file($r125d .. "/README.md", "nothing private here\n")
commit($r125d, "t125d")
$g125d = gate(["--tree", $r125d])
$f = $f + ok("T125d a filter matching no path in the tree is not this tree's problem",
  $g125d["code"] == 0, "" .. $g125d["code"] .. " " .. $g125d["out"])

$r125e = newrepo("t125e")
write_file($r125e .. "/.gitattributes", "* text eol=lf\n")
write_file($r125e .. "/leak.txt", $corpus[0] .. "\n")
commit($r125e, "t125e")
$g125e = gate(["--tree", $r125e])
$f = $f + ok("T125e a real leak beside a harmless .gitattributes is still a violation (exit 1)",
  $g125e["code"] == 1, "" .. $g125e["code"] .. " " .. $g125e["out"])

-- T126 — the round-thirty-two inversion, and the one that survived rounds
-- twenty-two through thirty-one untouched, because every one of them argued
-- about WHICH permission question to ask and none about WHOSE.
--
-- The installer runs as root on the mesh; the repositories are owned by, and
-- committed to by, an ordinary user. Root's access() is nearly vacuous
-- (CAP_DAC_OVERRIDE), and a named-user ACL aimed at that ordinary user is
-- invisible to it. Measured before the fix: perm 0o755, band(perm,0o111)=73,
-- access() as root = true — three green signals — and `git commit` as the
-- owner sailed through with "hook was ignored because it's not set as
-- executable".
--
-- Two rows, because one would not be evidence. T126a is the fix; T126b is the
-- mutant that restores the pre-fix question, and it must LIE. A green T126a
-- beside a green-instead-of-lying T126b would mean the fixture never created
-- the denial in the first place, which is precisely how this probe's own first
-- draft passed while measuring nothing: it put the ACL on a hook owned by the
-- same user it denied, where a named entry is subsumed by ACL_USER_OBJ and has
-- no effect. Hence the chown.
$sudo126 = run_argv(["sudo", "-n", "true"], {timeout: 30})
$setfacl126 = run_argv(["which", "setfacl"], {timeout: 30})
$ent126 = run_argv(["getent", "passwd", "" .. uid()], {timeout: 30})
$me126 = ""
if $ent126["exit_code"] == 0 then
  $me126 = split(trim($ent126["stdout"]), ":")[0]
end
if $sudo126["exit_code"] != 0 or $setfacl126["exit_code"] != 0 \
    or $me126 == "" or uid() == 0 then
  -- Never silently: a skipped identity probe reads exactly like a passed one.
  print("SKIP  T126a/b (needs passwordless sudo, setfacl, and a non-root"
    .. " invoking user with a passwd entry — sudo_rc="
    .. $sudo126["exit_code"] .. " setfacl_rc=" .. $setfacl126["exit_code"]
    .. " user=" .. $me126 .. " uid=" .. uid() .. ")")
else
  for each $case126 in [["a", false], ["b", true]]
    $tag126 = "T126" .. $case126[0]
    $rp126 = newrepo("t126-runner-identity-" .. $case126[0])
    $cmctl126 = $ROOT .. "/cmctl126" .. $case126[0]
    mkdir($cmctl126 .. "/_bin")
    mkdir($cmctl126 .. "/_etc")
    copy($GATE, $cmctl126 .. "/_bin/check-public-hygiene.mix")
    copy($HOOK, $cmctl126 .. "/_bin/hygiene-hook.mix")
    chmod($cmctl126 .. "/_bin/check-public-hygiene.mix", 0o755)
    chmod($cmctl126 .. "/_bin/hygiene-hook.mix", 0o755)
    write_file($cmctl126 .. "/_etc/public-hygiene.conf.mix", join([
      "public_hygiene: {\n",
      "  schema_version: 1,\n",
      "  repos: [\"" .. $rp126 .. "\"],\n",
      "  static_rules: " .. $FIXTURE_RULES .. ",\n",
      "  generic_node_names: [],\n",
      "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
      "}\n"
    ], ""))
    -- must_replace, not replace: round twenty-eight's lesson is that a
    -- silently-unmatched anchor runs the LIVE installer against the LIVE fleet.
    $src126 = must_replace(read_file($INSTALL),
      "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cmctl126 .. "\"")
    if $case126[1] then
      -- The mutant: ask the permission question as the installer's own
      -- identity, which is what the code did before round thirty-two.
      $src126 = must_replace($src126,
        "$a = access_x_as($who[\"uid\"], $path)",
        "$a = {ok: access($path, \"x\"), why: \"\"}")
    end
    $safe126 = contains($src126, $CMCTL) == false and contains($src126, $cmctl126)
    if $safe126 == false then
      print($tag126 .. " refused to execute an installer whose fixture scope"
        .. " was not proved")
      exit(2)
    end
    $install126 = $cmctl126 .. "/_bin/install-hygiene-hooks.mix"
    write_file($install126, $src126)
    chmod($install126, 0o755)
    -- Install as the repository owner, so the hooks genuinely start out live.
    $i126 = run_installer([$MIX, $install126], {timeout: 900})
    $hook126 = $rp126 .. "/.git/hooks/pre-commit"
    -- Root-owned so the named-user entry is a NAMED entry, then denied.
    $c126 = run_argv(["sudo", "-n", "chown", "root:root", $hook126],
      {timeout: 60})
    $a126 = run_argv(["sudo", "-n", "setfacl", "-m", $me126 .. ":---",
      $hook126], {timeout: 60})
    -- Belt and braces: prove the denial exists before believing either verdict.
    -- This suite runs AS the repository owner, so the question can be asked
    -- directly — no privilege to drop, and it is the same kernel call the
    -- installer makes on the owner's behalf.
    $denied126 = false
    try
      $denied126 = access($hook126, "x")
    catch $de126
      $denied126 = "raised: " .. $de126
    end
    $s126 = run_argv(["sudo", "-n", $MIX, $install126, "--status"],
      {timeout: 900})
    $out126 = $s126["stdout"] .. $s126["stderr"]
    $line126 = ""
    for each $l126 in split($out126, "\n")
      if contains($l126, "pre-commit:") and $line126 == "" then
        $line126 = trim($l126)
      end
    end
    -- Hand the tree back before cleanup: the suite's rm runs as the invoking
    -- user, and a root-owned file it cannot even stat is a bad way to end.
    $z126 = run_argv(["sudo", "-n", "chown", "" .. uid() .. ":" .. gid(),
      $hook126], {timeout: 60})
    $z126 = run_argv(["sudo", "-n", "setfacl", "-b", $hook126], {timeout: 60})
    $detail126 = join(["install_rc=", "" .. $i126["exit_code"],
      " chown_rc=", "" .. $c126["exit_code"],
      " setfacl_rc=", "" .. $a126["exit_code"],
      " owner_access=", "" .. $denied126,
      " status_rc=", "" .. $s126["exit_code"],
      " line=", sanitize(substr($line126, 0, 320))], "")
    if $case126[1] == false then
      $f = $f + ok($tag126 .. " a hook root can execute but the repository's"
        .. " owner cannot is NOT reported installed",
        $i126["exit_code"] == 0 and $denied126 == false
          and contains($line126, "NOT EXECUTABLE")
          and contains($line126, "uid " .. uid()),
        $detail126)
    else
      -- Round forty, and the same subsumption T133 hit. This --status runs as
      -- root over a repository owned by uid 1002, so round forty's hooks-path
      -- ownership walk has something real to say about it and now says it into
      -- the verdict: the mutant no longer reaches `installed`, it reports
      -- `installation UNVERIFIED` instead. The mutant is still caught — by the
      -- other guard — so the row is subsumed, not broken, and the fix is to
      -- move it onto what still differs rather than to weaken it.
      --
      -- What still differs is round thirty-two's own token. The repaired build
      -- says NOT EXECUTABLE because it asked the permission question as the
      -- identity that will RUN the hook; the mutant asks it as root, gets
      -- CAP_DAC_OVERRIDE's vacuous yes, and cannot say NOT EXECUTABLE at all.
      -- So its ABSENCE from the mutant line is the assertion, and the positive
      -- clause only establishes that the run produced a verdict to read.
      $f = $f + ok($tag126 .. " the pre-fix question (asked as the installer,"
        .. " not the runner) cannot see the denial — the row discriminates",
        $i126["exit_code"] == 0 and $denied126 == false
          and contains($line126, "installation UNVERIFIED")
          and contains($line126, "NOT EXECUTABLE") == false,
        $detail126)
    end
  end
end

-- T128 — round thirty-three's second MAJOR. The runner probe used to build the
-- text `access("<path>", "x")` and hand it to `mix -c`, guarded by refusing a
-- quote, a backslash or a newline in the path. It missed `${...}`, which mix
-- expands inside a double-quoted string, so a hooks path containing one asked
-- about a DIFFERENT FILE — and answered `true` about a hook git will skip if
-- that other file happened to be executable.
--
-- T128a reproduces the hazard rather than describing it: the same path, asked
-- both ways, must give DIFFERENT answers, with the embedded form wrong. If mix
-- ever stopped expanding there this row goes red, which is the correct outcome
-- — it would mean the reasoning behind the design had changed and should be
-- re-read, not that the danger had quietly gone away.
-- The `\$` is escaped so THIS suite does not expand it; the path on disk
-- genuinely contains the four characters `${SEG}`, which is the whole point.
$dir128 = $ROOT .. "/t128/\${SEG}"
mkdir($dir128, {parents: true})
-- The real hook: present, NOT executable. git skips it.
write_file($dir128 .. "/pre-commit", "#!/bin/sh\nexit 0\n")
chmod($dir128 .. "/pre-commit", 0o644)
-- The decoy at the path `${SEG}` expands to when SEG is empty: executable.
write_file($ROOT .. "/t128/pre-commit", "#!/bin/sh\nexit 0\n")
chmod($ROOT .. "/t128/pre-commit", 0o755)
$path128 = $dir128 .. "/pre-commit"
$embedded128 = run_argv([$MIX, "-c",
  "print(access(\"" .. $path128 .. "\", \"x\"))"], {env: {SEG: ""}, timeout: 60})
$positional128 = run_argv([$MIX, "-c", "print(access($1, \"x\"))", $path128],
  {env: {SEG: ""}, timeout: 60})
$f = $f + ok("T128a a hooks path containing \${...} answers TRUE embedded in"
  .. " `mix -c` source and FALSE as an argument — the hazard is real",
  trim($embedded128["stdout"]) == "true"
    and trim($positional128["stdout"]) == "false",
  join(["embedded=", sanitize(trim($embedded128["stdout"] .. " "
    .. $embedded128["stderr"])), " positional=",
    sanitize(trim($positional128["stdout"] .. " "
      .. $positional128["stderr"]))], ""))

-- T128b — and the installer must be on the safe side of that difference. A
-- structural row, deliberately: the behaviour it guards only appears on a host
-- where the installer runs as root for another uid over a path containing an
-- expansion, which is not a state this suite can conjure. What it CAN do is
-- refuse to let the dangerous form come back unnoticed.
--
-- Round thirty-four: yes, this is evadable — build the source with
-- `"access(\"" .. $p .. "\""` and neither needle fires, so the row goes green
-- over a genuinely dangerous file. Wontfix, and the reason is that the
-- alternative is worse: a row that tried to recognise every spelling of the
-- hazard would be a parser, and a wrong parser here reports safety it has not
-- established. This row is a tripwire against the ONE regression that has
-- actually happened (someone reinstates the embedded form as it was written),
-- not a proof of absence. T128a is the row that measures behaviour.
$src128 = read_file($INSTALL)
$f = $f + ok("T128b the installer passes the hook path to the sub-interpreter"
  .. " as an argument, never embedded in `mix -c` source",
  contains($src128, "access($1") and contains($src128, "access(\\\"") == false,
  join(["positional=", "" .. contains($src128, "access($1"),
    " embedded=", "" .. contains($src128, "access(\\\"")], ""))

-- T129 — round thirty-four. `identity_divergence` decides whether the
-- repository owner's executability answer is the whole answer, by asking
-- whether git's system-scope `safe.directory` admits anybody else. Three
-- separate fail-open defects were measured in that path while it was being
-- written, none of which a unit probe caught, so each gets a row and each row
-- gets a mutant restoring exactly the defect it was written for.
--
-- The fixture is the REAL /etc/gitconfig, because the installer refuses to run
-- at all with GIT_CONFIG_SYSTEM set (an earlier round's guard: that variable
-- also decides which repository `git -C` reads). So there is no way to exercise
-- the production scope without controlling the production file. It is written
-- only when absent — an operator's own /etc/gitconfig is never touched — every
-- entry used is inert (a path under this run's /tmp fixture, or a name that
-- matches nothing), `*` is never written, and the restore is in a `finally`.
-- lstat, not stat. Round thirty-five: a DANGLING symlink at /etc/gitconfig
-- reads absent to a following exists(), so this suite would have decided the
-- name was free, `cp`'d through the link (creating the operator's target file),
-- and then deleted their symlink in its `finally`. The question here is "is this
-- name taken", which is the lstat question.
$etc129 = "/etc/gitconfig"
$etctmp129 = $etc129 .. ".hygiene-suite-tmp"
$incdir129 = "/etc/gitconfig.d"
$incfile129 = $incdir129 .. "/shared"
-- The staging name is checked for the same reason the two real names are:
-- putetc129 `mv -f`s over it, and this run must not be the one that discovers
-- somebody else was using it.
$skip129 = ($sudo126["exit_code"] != 0
  or exists($etc129, {follow_symlinks: false})
  or exists($etctmp129, {follow_symlinks: false})
  or exists($incdir129, {follow_symlinks: false}))
if $skip129 then
  print("SKIP  T129a-i (needs passwordless sudo and none of /etc/gitconfig,"
    .. " /etc/gitconfig.hygiene-suite-tmp or /etc/gitconfig.d present —"
    .. " refusing to overwrite an operator's own)")
else
  $rp129 = newrepo("t129-safedir")
  -- Row (f)'s entry. A symlink to the repository, so the entry and the
  -- repository are the same directory by two different names.
  $link129 = $ROOT .. "/t129-link"
  symlink($rp129, $link129)
  -- Row (p)'s entry. An ordinary symlink, in an ordinary directory, whose
  -- target happens to be a magic link — which is why the /proc prefix test
  -- cannot be the whole answer.
  $viacwd129 = $ROOT .. "/t129-viacwd"
  symlink("/proc/self/cwd", $viacwd129)
  -- Row (t)'s include TARGET, and it lives inside the repository on purpose:
  -- git chdirs there before the ownership check, so `<viacwd>/inc` is this file
  -- for git and a name that does not exist for the installer, which is the
  -- whole defect. This is the one `*` this suite writes, and it is written into
  -- the fixture tree under /tmp — never into /etc, where every entry stays a
  -- path under this run's fixture or a name that matches nothing.
  write_file($rp129 .. "/inc", sdbody("*"))
  $cmctl129 = $ROOT .. "/cmctl129"
  mkdir($cmctl129 .. "/_bin")
  mkdir($cmctl129 .. "/_etc")
  copy($GATE, $cmctl129 .. "/_bin/check-public-hygiene.mix")
  copy($HOOK, $cmctl129 .. "/_bin/hygiene-hook.mix")
  chmod($cmctl129 .. "/_bin/check-public-hygiene.mix", 0o755)
  chmod($cmctl129 .. "/_bin/hygiene-hook.mix", 0o755)
  write_file($cmctl129 .. "/_etc/public-hygiene.conf.mix", join([
    "public_hygiene: {\n",
    "  schema_version: 1,\n",
    "  repos: [\"" .. $rp129 .. "\"],\n",
    "  static_rules: " .. $FIXTURE_RULES .. ",\n",
    "  generic_node_names: [],\n",
    "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
    "}\n"
  ], ""))
  $base129 = must_replace(read_file($INSTALL),
    "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cmctl129 .. "\"")
  $fixed129 = $cmctl129 .. "/_bin/install-hygiene-hooks.mix"
  write_file($fixed129, $base129)
  chmod($fixed129, 0o755)
  -- Install with no system config present, so the hooks land cleanly and every
  -- row below varies only the safe.directory question.
  $i129 = run_installer([$MIX, $fixed129], {timeout: 900})
  if $i129["exit_code"] != 0 then
    print("SETUP FAILED: T129 fixture install exited "
      .. $i129["exit_code"] .. " " .. sanitize(trim($i129["stdout"]
        .. " " .. $i129["stderr"])))
    exit(2)
  end
  -- tag, /etc/gitconfig body, mutation anchor, mutation replacement.
  -- An empty anchor means "no mutant" — the control row, which exists to
  -- prove the others are not simply always-unknown.
  --
  -- Row (c)'s entry is BUILT, not written. `"~/x"` is a Mix string literal, so
  -- writing it literally expands to the current user's home and the row measures
  -- something else entirely — which is what it did on its first run, inverted:
  -- the fixed build answered "installed" and the mutant answered UNVERIFIED.
  -- Third instance of the same trap in this arc, after the installer's needle
  -- and the probe that hid it. git itself does not expand: `git config
  -- --get-all safe.directory` was measured returning `~/x`, `~root/y` and
  -- `%(prefix)/z` verbatim, which is why the code under test has to.
  --
  -- Row (g)'s body is an INCLUDE, not a `[safe]` section: the entry it reaches
  -- is staged separately in /etc/gitconfig.d/shared, written once below and
  -- inert for every other row, since a file nothing points at is never read.
  $cases129 = [
    ["a", sdbody("/nowhere/else"), "", ""],
    ["b", sdbody($ROOT .. "/*"), "if ends_with($t, \"/*\") then",
      "if false then"],
    ["c", sdbody(substr("!~/x", 1)), "if starts_with($t, \"/\") == false then",
      "if false then"],
    ["d", sdbody($rp129), "if ends_with($out, $NUL) then", "if false then"],
    ["e", sdbody($rp129 .. "/"), "$rt = abs_realpath($t)", "$rt = nil"],
    ["f", sdbody($link129), "$rt = abs_realpath($t)", "$rt = nil"],
    -- Rows (g) and (i) carry the CONTINUATION line into their anchors, and it
    -- is not decoration. `safe_directory_widens` makes two `safe_dir_values`
    -- calls whose argv prefixes are character-for-character identical — the
    -- `^include` scan and the `safe.directory` read — so the short anchors
    -- these rows used matched both and each mutant silently broke a second,
    -- unrelated call. Both rows still discriminated, which is exactly why it
    -- went unnoticed for five rounds; `must_replace` now refuses an anchor with
    -- more than one site, and `"--get-all"` is what makes these name the read.
    ["g", "[include]\n\tpath = " .. $incfile129 .. "\n",
      "\"-z\", \"--includes\", \"--system\",\n    \"--get-all\"",
      "\"-z\", \"--system\",\n    \"--get-all\""],
    ["h", sdbody("."), "if starts_with($t, \"/\") == false then",
      "if false then"],
    ["i", sdbody($rp129),
      "\"git\", \"config\", \"-z\", \"--includes\", \"--system\",\n"
        .. "    \"--get-all\"",
      "\"git\", \"config\", \"--includes\", \"--system\",\n"
        .. "    \"--get-all\""],
    -- Row (j)'s mutant is the only multi-line one, and it has to be. The first
    -- attempt removed the root-wildcard early return and the row went GREEN on
    -- both builds: with the guard already gone, `$base .. "/"` is "/" and the
    -- prefix test matches every absolute path on its own. That is worth
    -- recording, because it means the defect was never a missing special case —
    -- it was the `$base != ""` guard, and a mutant that does not put the guard
    -- back is not restoring the bug. So this replaces the whole repaired region
    -- with the pre-fix text verbatim.
    ["j", sdbody("/*"),
      join(["if $rb == \"/\" then\n        return true\n      end\n",
        "      if (starts_with($repo, $base .. \"/\")"], ""),
      "if $base != \"\" and (starts_with($repo, $base .. \"/\")"],
    -- Row (k)'s anchor moved in round thirty-eight, and this is what the
    -- must_replace check is for: the include refusal narrowed from "the value
    -- is not absolute" to "the value is identity-dependent", so the old line
    -- no longer exists and a mutant generated from it would have aborted the
    -- suite rather than testing anything. The row itself is unchanged — `~/…`
    -- is still refused, and for the same reason.
    ["k", "[include]\n\tpath = " .. substr("!~/nope", 1) .. "\n",
      "if starts_with($ip, $TILDE) or starts_with($ip, \"%(prefix)\") then",
      "if false then"],
    -- Row (l) was a REFUSAL row in round thirty-six and is a CONTROL row now.
    -- Round thirty-seven measured what thirty-six reasoned about: an includeIf
    -- cannot widen the admitted set, so refusing on one was a permanent
    -- host-wide UNVERIFIED bought for nothing. It keeps its fixture and swaps
    -- its expectation, which is the honest way to record a reversal — deleting
    -- it would leave nothing pinning the behaviour that replaced it.
    ["l", "[includeIf \"gitdir:/srv/\"]\n\tpath = /srv/nope\n", "", ""],
    ["m", sdbody("//*"), "if $rb == \"/\" then", "if false then"],
    ["n", trunc129(), join(["if $c[\"stdout_truncated\"] == true or",
      " $c[\"stderr_truncated\"] == true then"], ""), "if false then"],
    -- Rows (o) and (p) are the same defect reached two ways, and each kills
    -- exactly one of the two arms that fix it — measured, both directions:
    -- with the magic-path test removed, (o) reports installed and (p) still
    -- refuses; with the cwd test stubbed to false, (p) reports installed and
    -- (o) still refuses. Neither arm subsumes the other, so neither row can
    -- stand in for the missing one.
    ["o", sdbody("/proc/self/fd/9"), "if magic_path($t) then", "if false then"],
    -- Round thirty-nine moved this anchor's second argument from $repo to
    -- $real (MINOR five: with `repos: [".control"]` the chdir into a relative
    -- $repo fails after cwd_dependent has already chdir'ed to "/", so the
    -- comparison the function exists to make never happened). must_replace
    -- refused the stale anchor rather than silently rewriting nothing, which is
    -- the whole reason it counts sites — the row would otherwise have run the
    -- UNMUTATED installer and reported a green diagonal.
    ["p", sdbody($viacwd129), "$cd = cwd_dependent($t, $real)", "$cd = false"],
    ["q", lossy129(), "if $c[\"utf8_lossy\"] == true then", "if false then"],
    -- Row (r) is INVERTED — see t129inv. Its "mutant" is not a defect injected
    -- into a repaired build; it is the pre-fix line put back, and the row
    -- asserts that the pre-fix line is the one that gets this wrong.
    ["r", "[include]\n\tpath = gitconfig.d/absent\n",
      "if starts_with($ip, $TILDE) or starts_with($ip, \"%(prefix)\") then",
      "if starts_with($ip, \"/\") == false then"],
    -- Rows (s) and (t) are rows (o) and (p) applied to the include PATH, and
    -- they are two rows for the same reason those are: neither arm subsumes the
    -- other. (s)'s path is lexically magic and resolves identically from every
    -- working directory, so only the magic-path test can catch it; (t)'s is an
    -- ordinary symlink outside /proc whose target is a magic link, so only the
    -- cwd test can. Row (t)'s include target is written INSIDE the repository
    -- on purpose — that is what makes the two readers disagree, and what makes
    -- the mutant answer "installed" while git admits the repository.
    ["s", "[include]\n\tpath = /proc/self/fd/9\n",
      "if magic_path($ip) then", "if false then"],
    ["t", "[include]\n\tpath = " .. $viacwd129 .. "/inc\n",
      "$icd = cwd_dependent($ip, $real)", "$icd = false"]
  ]
  -- Every mutant is generated BEFORE the try. `must_replace` calls exit(2) when
  -- an anchor has drifted, and exit() does NOT run `finally` — measured on mix
  -- 0.46.1: a script that exits inside a try prints nothing from its finally and
  -- returns the exit code. Generating inside the loop therefore left the suite's
  -- /etc/gitconfig fixture installed on the operator's host whenever a refactor
  -- moved one of these anchors, which is precisely the case the anchor check
  -- exists to catch.
  for each $g129 in $cases129
    if $g129[2] != "" then
      $mp129 = $cmctl129 .. "/_bin/mutant-" .. $g129[0] .. ".mix"
      write_file($mp129, must_replace($base129, $g129[2], $g129[3]))
      chmod($mp129, 0o755)
    end
  end
  $d129 = {exit_code: 0}
  try
    $d129 = run_argv(["sudo", "-n", "mkdir", "-m", "0755", $incdir129],
      {timeout: 60})
    $wi129 = putetc129(write_tmp129($ROOT, "inc", sdbody($rp129)), $incfile129,
      $incfile129 .. ".hygiene-suite-tmp")
    for each $c129 in $cases129
      $tag129 = "T129" .. $c129[0]
      $w129 = putetc129(write_tmp129($ROOT, $c129[0], $c129[1]), $etc129,
        $etctmp129)
      -- The fixture install is part of the assertion, not a precondition to it.
      -- A `cp` that silently failed would leave the PREVIOUS row's config in
      -- place, and for rows whose predecessor also answers UNVERIFIED that is
      -- green on a fixture that was never written.
      $setup129 = ($w129["exit_code"] == 0 and $d129["exit_code"] == 0
        and $wi129["exit_code"] == 0)
      $sf129 = run_installer([$MIX, $fixed129, "--status"], {timeout: 300})
      $fixedline129 = statusline129($sf129)
      if $c129[2] == "" then
        -- Control: a config that must NOT be read as widening. Without these
        -- rows, rows that always answered "unknown" would look exactly like
        -- rows that work.
        --
        -- The exit code is ASSERTED here, not merely reported. Round
        -- thirty-six added `fixed_rc=` to the detail string and stopped there,
        -- which puts the number in front of whoever is already reading a
        -- failure and in front of nobody else: a --status that started exiting
        -- 2 while still printing the expected line would have stayed green.
        $f = $f + ok($tag129 .. " " .. t129ctl($c129[0]),
          $setup129 and contains($fixedline129, "installed")
            and $sf129["exit_code"] == 0,
          join(["cp_rc=", "" .. $w129["exit_code"], " mkdir_rc=",
            "" .. $d129["exit_code"], " inc_rc=", "" .. $wi129["exit_code"],
            " fixed_rc=", "" .. $sf129["exit_code"],
            " line=", sanitize($fixedline129)], ""))
      else
        $mut129 = $cmctl129 .. "/_bin/mutant-" .. $c129[0] .. ".mix"
        $sm129 = run_installer([$MIX, $mut129, "--status"], {timeout: 300})
        $mutline129 = statusline129($sm129)
        -- Which line must say what. Every row but (r) asserts "the repaired
        -- build refuses and the defect restored does not"; (r) asserts the
        -- reverse, because the thing round thirty-eight changed there was the
        -- DELETION of a refusal. Written as two named strings rather than two
        -- branches so the assertion below stays one expression and cannot drift
        -- between the fixed and inverted forms.
        --
        -- Round forty made the exit code a FUNCTION of the token rather than a
        -- constant: a --status run that reported any unverified hook state now
        -- ends at 2, and one that reported none ends at 0. So the pair moves
        -- together, and pinning `== 0` on both arms — which is what round
        -- thirty-six's comment below argued for, correctly, against the code of
        -- its day — now contradicts the product. Asserting the DERIVED code
        -- instead keeps everything that comment wanted and adds to it: the row
        -- fails both if the line is wrong and if the exit code disagrees with
        -- the line it printed, which is the round-forty contract itself. These
        -- fixtures are one repository whose three hooks share one state, so the
        -- whole-run code and the single line are answering the same question.
        $wantfix129 = "UNVERIFIED"
        $wantmut129 = "installed"
        $wantfixrc129 = 2
        $wantmutrc129 = 0
        $sense129 = join([" — reported UNVERIFIED, and the defect restored",
          " reports it installed, so the row discriminates"], "")
        if t129inv($c129[0]) then
          $wantfix129 = "installed"
          $wantmut129 = "UNVERIFIED"
          $wantfixrc129 = 0
          $wantmutrc129 = 2
          $sense129 = join([" — the repaired build ANSWERS, and the pre-fix",
            " line put back refuses, so the row discriminates"], "")
        end
        $f = $f + ok($tag129 .. " " .. t129why($c129[0]) .. $sense129,
          $setup129 and contains($fixedline129, $wantfix129)
            and contains($mutline129, $wantmut129)
            and $sf129["exit_code"] == $wantfixrc129
            and $sm129["exit_code"] == $wantmutrc129,
          join(["cp_rc=", "" .. $w129["exit_code"],
            " fixed_rc=", "" .. $sf129["exit_code"],
            " mutant_rc=", "" .. $sm129["exit_code"], " fixed=",
            sanitize($fixedline129), " mutant=", sanitize($mutline129)], ""))
      end
    end
  finally
    -- Round thirty-six, two defects in five lines of teardown.
    --
    -- First: it deleted whatever was at those names. This suite only ever
    -- reaches here because BOTH names were absent when it started, but between
    -- then and now is a whole test run, and "absent when I looked" is not
    -- "still mine when I delete". So the fixture is identified before it is
    -- removed — the content must be one of the bodies this run wrote. Anything
    -- else belongs to somebody, and the honest move is to leave it and say so
    -- loudly rather than tidy up a stranger's /etc. This does not close the
    -- race (nothing short of an fd held across the run does, and the file is
    -- root-owned while this process is not); it bounds the damage to the exact
    -- window between the check and the `rm`, where before it was the whole run.
    --
    -- Second: a failed privileged cleanup only PRINTED. The suite could leave a
    -- /etc/gitconfig on the host and still exit 0, and an exit code nobody can
    -- distinguish from success is how a warning goes unread. Cleanup is now an
    -- assertion like everything else here.
    --
    -- Third, round thirty-eight: the comparison is on BYTES. One row's fixture
    -- is deliberately not valid UTF-8, and `read_file` RAISES on that — from
    -- inside a `finally`, which would have taken the raise straight past every
    -- remaining cleanup line and left both /etc fixtures on the host. `contains`
    -- over a list went with it: constant_time_eq is the only byte-exact
    -- comparison here that does not care whether a body is a string or bytes,
    -- and `==` between two byte strings is the list trap in another costume.
    $bodies129 = [string_to_bytes(sdbody($rp129))]
    for each $cc129 in $cases129
      if type($cc129[1]) == "bytes" then
        push($bodies129, $cc129[1])
      else
        push($bodies129, string_to_bytes($cc129[1]))
      end
    end
    $etcmine129 = true
    if exists($etc129, {follow_symlinks: false}) then
      $etcmine129 = mine129($etc129, $bodies129)
    end
    $z129 = {exit_code: 0}
    if $etcmine129 then
      $z129 = run_argv(["sudo", "-n", "rm", "-f", $etc129], {timeout: 60})
    end
    -- The staging name putetc129 renames THROUGH. A run killed between the
    -- `cp` and the `mv` leaves it behind, holding one of this run's bodies, and
    -- it is the reason the skip check at the top refuses to start when it is
    -- already present — so leaving one for the next run to trip over would turn
    -- an interrupted round into a permanently skipped T129.
    $tmpmine129 = true
    if exists($etctmp129, {follow_symlinks: false}) then
      $tmpmine129 = mine129($etctmp129, $bodies129)
    end
    $x129 = {exit_code: 0}
    if $tmpmine129 and exists($etctmp129, {follow_symlinks: false}) then
      $x129 = run_argv(["sudo", "-n", "rm", "-f", $etctmp129], {timeout: 60})
    end
    -- Round thirty-seven. The care above stopped at the file: the DIRECTORY
    -- beside it went to `rm -rf` unconditionally, and `rm -rf` on a path in
    -- /etc is the more destructive of the two by a wide margin. The check is
    -- the same shape — this run knows exactly what it created there, one file
    -- named `shared` holding one body — so anything else in that directory
    -- means it is not this suite's, and it is left alone and reported.
    --
    -- Same bound as above, and stated as plainly: this is a check-then-act
    -- race, narrowed to the window between the two, not closed. A directory
    -- this process cannot hold open cannot be made safe from here.
    --
    -- The entry comparison is written element-by-element on purpose, and the
    -- first attempt at it was not: `ls($incdir129) == ["shared"]` is ALWAYS
    -- false in Mix — `List == List` has no deep comparison and neither does
    -- `Map == Map` (`mix man operators`, "Comparison"). It is documented, it
    -- is not a bug, and `mix lint` says nothing about it because a
    -- constant-false comparison is still a well-typed one. The cost here was
    -- exactly the fail-safe direction — the directory was judged not ours and
    -- left on the host — which is why the run that introduced it went red on
    -- its own teardown row instead of quietly deleting something. Compare
    -- lengths and elements, or `eq` for the rendered forms; never `==` on a
    -- list.
    --
    -- The permitted entries are `shared` and the staging name putetc129 renames
    -- through, for the reason given at the /etc/gitconfig staging name above: a
    -- run killed mid-copy leaves it, and a leftover this run recognises must not
    -- make the directory unrecognisable to its own teardown.
    $ents129 = []
    if exists($incdir129, {follow_symlinks: false}) then
      $ents129 = ls($incdir129)
    end
    $dirmine129 = true
    if exists($incdir129, {follow_symlinks: false}) then
      $dirmine129 = (len($ents129) > 0 and exists($incfile129)
        and read_file($incfile129) == sdbody($rp129))
      for each $e129 in $ents129
        if $e129 != "shared" and $e129 != "shared.hygiene-suite-tmp" then
          $dirmine129 = false
        end
      end
    end
    $y129 = {exit_code: 0}
    if $dirmine129 then
      $y129 = run_argv(["sudo", "-n", "rm", "-rf", $incdir129], {timeout: 60})
    end
    $f = $f + ok("T129z the suite removed every /etc fixture it installed —"
      .. " the config, the include directory and the staging name it renames"
      .. " through — and removed each only after identifying it by content as"
      .. " one it wrote",
      $etcmine129 and $dirmine129 and $tmpmine129
        and exists($etc129, {follow_symlinks: false}) == false
        and exists($etctmp129, {follow_symlinks: false}) == false
        and exists($incdir129, {follow_symlinks: false}) == false,
      join(["etc_is_ours=", "" .. $etcmine129, " dir_is_ours=",
        "" .. $dirmine129, " tmp_is_ours=", "" .. $tmpmine129, " rm_rc=",
        "" .. $z129["exit_code"], " rmdir_rc=", "" .. $y129["exit_code"],
        " rmtmp_rc=", "" .. $x129["exit_code"],
        " etc_left=", "" .. exists($etc129, {follow_symlinks: false}),
        " tmp_left=", "" .. exists($etctmp129, {follow_symlinks: false}),
        " dir_left=", "" .. exists($incdir129, {follow_symlinks: false})], ""))
  end
end

-- T131 — round thirty-six. GIT_CEILING_DIRECTORIES joins the installer's
-- environment refusal list, and it is a different KIND of channel from every
-- name already there: those redirect which repository git reads or where
-- core.hooksPath points, this one stops git DISCOVERING a repository from a
-- subdirectory at all. Measured on git 2.55.0 — with it set at the worktree
-- root, `rev-parse --show-toplevel` from a subdirectory fails rc 128, and the
-- gate accepts a subdirectory as a configured repo. The safe.directory subject
-- is then undeterminable.
--
-- The correctness bound is elsewhere: that path now answers nil rather than
-- falling back to a guess, so an unrefused ceiling costs an UNVERIFIED and
-- never a wrong "no widening". This row guards the DIAGNOSTIC — the difference
-- between an operator who is told the cause and one who reads "UNVERIFIED"
-- with no way to find out why. That is worth a row precisely because it is the
-- kind of thing a later refactor drops as redundant.
$rp131 = newrepo("t131-ceiling")
$cmctl131 = $ROOT .. "/cmctl131"
mkdir($cmctl131 .. "/_bin")
mkdir($cmctl131 .. "/_etc")
copy($GATE, $cmctl131 .. "/_bin/check-public-hygiene.mix")
copy($HOOK, $cmctl131 .. "/_bin/hygiene-hook.mix")
chmod($cmctl131 .. "/_bin/check-public-hygiene.mix", 0o755)
chmod($cmctl131 .. "/_bin/hygiene-hook.mix", 0o755)
write_file($cmctl131 .. "/_etc/public-hygiene.conf.mix", join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp131 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$base131 = must_replace(read_file($INSTALL),
  "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cmctl131 .. "\"")
$fixed131 = $cmctl131 .. "/_bin/install-hygiene-hooks.mix"
write_file($fixed131, $base131)
chmod($fixed131, 0o755)
$mut131 = $cmctl131 .. "/_bin/mutant-ceiling.mix"
write_file($mut131, must_replace($base131,
  "if env(\"GIT_CEILING_DIRECTORIES\") != \"\" then", "if false then"))
chmod($mut131, 0o755)
-- Round thirty-seven, two weaknesses in this row's own construction.
--
-- It called run_argv directly while every other row goes through
-- run_installer, so it was the one row whose child inherited the AMBIENT
-- TMPDIR — the installer probes TMPDIR at startup and refuses on several of
-- its properties, which would have failed this row for a reason that has
-- nothing to do with ceilings.
--
-- And the mutant was asserted `!= 2`, which is satisfied by any of the exit
-- codes a broken build produces — 1 from an uncaught error, 127 from a
-- mangled interpreter line. A mutant that dies for an unrelated reason passed
-- the row and reported that the refusal was load-bearing. It must now exit 0
-- AND print a real per-hook status line: proceeding is the claim, so
-- proceeding is what gets asserted.
$env131 = {GIT_CEILING_DIRECTORIES: $rp131}
$sf131 = run_installer([$MIX, $fixed131, "--status"],
  {timeout: 300, env: $env131})
$sm131 = run_installer([$MIX, $mut131, "--status"],
  {timeout: 300, env: $env131})
$f = $f + ok("T131 an inherited GIT_CEILING_DIRECTORIES is refused with a named"
  .. " cause, and the refusal is what does it — removed, the run proceeds to a"
  .. " normal per-hook report",
  $sf131["exit_code"] == 2
    and contains($sf131["stdout"] .. $sf131["stderr"],
      "GIT_CEILING_DIRECTORIES is set")
    and $sm131["exit_code"] == 0
    and contains($sm131["stdout"], "pre-commit:"),
  join(["fixed_rc=", "" .. $sf131["exit_code"], " mutant_rc=",
    "" .. $sm131["exit_code"], " mutant=", sanitize(statusline129($sm131)),
    " fixed=",
    sanitize(trim($sf131["stdout"] .. " " .. $sf131["stderr"]))], ""))

-- T132 — round thirty-seven. Round thirty-six repaired the SUBJECT of the
-- safe.directory comparison twice — chomp_path() instead of trim() on a
-- pathname, and the bare-repository gitdir — and shipped both with no mutant.
-- Nothing in the suite could then say whether either repair was load-bearing or
-- decorative, which is round thirty-six's own lesson turned back on it: a
-- mutant that cannot fail is a fix that has not been located.
--
-- Both rows discriminate on the REASON rather than the state token, and that is
-- forced rather than chosen. Each defect converts a determinable subject into
-- an undeterminable one, and "this widens" and "this cannot be determined" both
-- print UNVERIFIED — correctly, since both are refusals, and refusing is the
-- direction seven rounds have established as right. Only the sentence after the
-- token separates a matcher that answered from one that gave up, so that is
-- what these rows read.
$skip132 = ($sudo126["exit_code"] != 0
  or exists($etc129, {follow_symlinks: false})
  or exists($etctmp129, {follow_symlinks: false}))
if $skip132 then
  print("SKIP  T132a-b (needs passwordless sudo and neither /etc/gitconfig nor"
    .. " its staging name present — refusing to overwrite an operator's own)")
else
  $rp132s = newrepo("t132 space ")
  $rp132b = bare("t132-bare")
  $cases132 = [
    ["space", $rp132s, "[safe]\n\tdirectory = \"" .. $rp132s .. "\"\n",
      "$real = realpath(chomp_path($tl[\"stdout\"]))",
      "$real = realpath(trim($tl[\"stdout\"]))",
      join(["a trailing space is legal in a directory name and git honours an",
        " entry carrying one (measured round thirty-six). trim() on the",
        " worktree root deletes it, the subject stops naming the repository,",
        " and a config that widens reads as one that cannot be read"], "")],
    ["bare", $rp132b, sdbody($rp132b),
      "if $b[\"exit_code\"] == 0 and trim($b[\"stdout\"]) == \"true\" then",
      "if false then",
      join(["a bare repository has no worktree root: `--show-toplevel` fails",
        " even where git ADMITS the repo, and git compares the gitdir — which",
        " for a bare repository is the repository path itself"], "")]
  ]
  -- Fixtures and mutants BEFORE the try, for the reason T129 records:
  -- must_replace exits on a drifted anchor and exit() does not run finally, so
  -- generating inside would leave this suite's /etc/gitconfig on the host.
  $cm132 = {}
  $inst132 = {}
  for each $g132 in $cases132
    $c = $ROOT .. "/cmctl132-" .. $g132[0]
    mkdir($c .. "/_bin")
    mkdir($c .. "/_etc")
    copy($GATE, $c .. "/_bin/check-public-hygiene.mix")
    copy($HOOK, $c .. "/_bin/hygiene-hook.mix")
    chmod($c .. "/_bin/check-public-hygiene.mix", 0o755)
    chmod($c .. "/_bin/hygiene-hook.mix", 0o755)
    write_file($c .. "/_etc/public-hygiene.conf.mix", join([
      "public_hygiene: {\n",
      "  schema_version: 1,\n",
      "  repos: [\"" .. $g132[1] .. "\"],\n",
      "  static_rules: " .. $FIXTURE_RULES .. ",\n",
      "  generic_node_names: [],\n",
      "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
      "}\n"
    ], ""))
    $b132 = must_replace(read_file($INSTALL),
      "$CMCTL = locate_hub()", "$CMCTL = \"" .. $c .. "\"")
    write_file($c .. "/_bin/install-hygiene-hooks.mix", $b132)
    chmod($c .. "/_bin/install-hygiene-hooks.mix", 0o755)
    write_file($c .. "/_bin/mutant.mix",
      must_replace($b132, $g132[3], $g132[4]))
    chmod($c .. "/_bin/mutant.mix", 0o755)
    -- Installed with no system config present, so each row below varies only
    -- the safe.directory question.
    $inst132[$g132[0]] = run_installer(
      [$MIX, $c .. "/_bin/install-hygiene-hooks.mix"], {timeout: 900})
    $cm132[$g132[0]] = $c
  end
  try
    for each $c132 in $cases132
      $cd132 = $cm132[$c132[0]]
      $w132 = putetc129(write_tmp129($ROOT, "132" .. $c132[0], $c132[2]),
        $etc129, $etctmp129)
      $sf132 = run_installer(
        [$MIX, $cd132 .. "/_bin/install-hygiene-hooks.mix", "--status"],
        {timeout: 300})
      $sm132 = run_installer([$MIX, $cd132 .. "/_bin/mutant.mix", "--status"],
        {timeout: 300})
      $lf132 = statusline129($sf132)
      $lm132 = statusline129($sm132)
      $f = $f + ok("T132" .. $c132[0] .. " " .. $c132[5]
        .. " — the repaired build names the widening; the defect restored can"
        .. " only say it could not tell, so the row discriminates",
        $w132["exit_code"] == 0 and $inst132[$c132[0]]["exit_code"] == 0
          -- Round forty: BOTH arms report executability UNVERIFIED here — that
          -- was already true of the lines, and is the whole point of the row,
          -- which discriminates on the REASON each gives and not on whether
          -- either answered. What changed is only that reporting unverified
          -- state now ends the run at 2, so both codes moved from 0 to 2
          -- together. The two content clauses above are, as before, the entire
          -- discriminating power of this row.
          and contains($lf132, "lets identities other than")
          and contains($lm132, "could not be determined")
          and $sf132["exit_code"] == 2 and $sm132["exit_code"] == 2,
        join(["install_rc=", "" .. $inst132[$c132[0]]["exit_code"],
          " cp_rc=", "" .. $w132["exit_code"],
          " fixed_rc=", "" .. $sf132["exit_code"],
          " mutant_rc=", "" .. $sm132["exit_code"],
          " fixed=", sanitize($lf132), " mutant=", sanitize($lm132)], ""))
    end
  finally
    $bodies132 = []
    for each $cc132 in $cases132
      push($bodies132, string_to_bytes($cc132[2]))
    end
    $mine132 = true
    if exists($etc129, {follow_symlinks: false}) then
      $mine132 = mine129($etc129, $bodies132)
    end
    $z132 = {exit_code: 0}
    if $mine132 then
      $z132 = run_argv(["sudo", "-n", "rm", "-f", $etc129], {timeout: 60})
    end
    -- The same staging name T129z clears, and for the same reason: putetc129
    -- renames through it, and a leftover makes the next run skip this block
    -- entirely rather than fail it.
    $t132 = true
    if exists($etctmp129, {follow_symlinks: false}) then
      $t132 = mine129($etctmp129, $bodies132)
    end
    $x132 = {exit_code: 0}
    if $t132 and exists($etctmp129, {follow_symlinks: false}) then
      $x132 = run_argv(["sudo", "-n", "rm", "-f", $etctmp129], {timeout: 60})
    end
    $f = $f + ok("T132z the suite removed the /etc/gitconfig it installed and"
      .. " the staging name it renamed through, each only after identifying it"
      .. " by content as one it wrote",
      $mine132 and $t132 and exists($etc129, {follow_symlinks: false}) == false
        and exists($etctmp129, {follow_symlinks: false}) == false,
      join(["etc_is_ours=", "" .. $mine132, " tmp_is_ours=", "" .. $t132,
        " rm_rc=", "" .. $z132["exit_code"],
        " rmtmp_rc=", "" .. $x132["exit_code"],
        " etc_left=", "" .. exists($etc129, {follow_symlinks: false}),
        " tmp_left=", "" .. exists($etctmp129, {follow_symlinks: false})], ""))
  end
end

-- T133 — round thirty-eight. Every round from thirty-two on has read the
-- identity question as "does a safe.directory entry let somebody else in", and
-- that is only one of the two doors. The other is the filesystem: a worktree
-- root or a git directory writable by group or other lets any identity in that
-- group commit here without any config at all — and remove the hook, or point
-- core.hooksPath somewhere else, first. Whether git will then RUN a hook for
-- them depends on configuration this run cannot read for identities it cannot
-- name, so the honest answer is that it cannot tell, and the wrong one — the
-- one shipped up to round thirty-seven — was a confident "installed".
--
-- Two rows because the check walks two paths, and a fix that only looked at the
-- worktree root would pass a row that only tested the worktree root.
$rp133 = newrepo("t133-fw")
$cm133 = $ROOT .. "/cmctl133"
mkdir($cm133 .. "/_bin")
mkdir($cm133 .. "/_etc")
copy($GATE, $cm133 .. "/_bin/check-public-hygiene.mix")
copy($HOOK, $cm133 .. "/_bin/hygiene-hook.mix")
chmod($cm133 .. "/_bin/check-public-hygiene.mix", 0o755)
chmod($cm133 .. "/_bin/hygiene-hook.mix", 0o755)
write_file($cm133 .. "/_etc/public-hygiene.conf.mix", join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp133 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$base133 = pin_nsswitch(must_replace(read_file($INSTALL),
  "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cm133 .. "\""),
  $NSS_ENUMERABLE)
$fixed133 = $cm133 .. "/_bin/install-hygiene-hooks.mix"
write_file($fixed133, $base133)
chmod($fixed133, 0o755)
-- Three mutants, because round thirty-nine split one mode test into three
-- independent decisions and a single mutant can only kill one of them.
--
--   other   the unconditional arm: other-write needs no corroboration at all
--   group   the narrowed arm, in the REFUSING direction — with the membership
--           question stubbed to "not foreign", a group that genuinely has
--           another member reads as harmless
--   ungrp   the same anchor in the OTHER direction, and this one is inverted:
--           it restores round thirty-eight's shipped behaviour, `$gw = true`,
--           the unconditional refusal on the bit alone. The row it fails is the
--           one proving a user-private group at 0775 is no longer a permanent
--           whole-host UNVERIFIED
--   acl     the ACL scan, which is what keeps the narrowing honest: with the
--           group bits acting as the mask, a named-user entry hides underneath
--           a group that is single-member on paper
$mut133 = $cm133 .. "/_bin/mutant-other.mix"
write_file($mut133, must_replace($base133,
  "if band($st[\"perm\"], 0o002) != 0 then", "if false then"))
chmod($mut133, 0o755)
$mgrp133 = $cm133 .. "/_bin/mutant-group.mix"
write_file($mgrp133, must_replace($base133,
  "$gw = group_write_is_foreign($p, $st[\"uid\"], $st[\"gid\"])", "$gw = false"))
chmod($mgrp133, 0o755)
$mungrp133 = $cm133 .. "/_bin/mutant-ungrp.mix"
write_file($mungrp133, must_replace($base133,
  "$gw = group_write_is_foreign($p, $st[\"uid\"], $st[\"gid\"])", "$gw = true"))
chmod($mungrp133, 0o755)
$macl133 = $cm133 .. "/_bin/mutant-acl.mix"
write_file($macl133, must_replace($base133,
  "$acl = has_extended_acl($path)", "$acl = false"))
chmod($macl133, 0o755)
$i133 = run_installer([$MIX, $fixed133], {timeout: 900})
-- The clean baseline is asserted, not assumed. Both rows below read a status
-- line, and a repository where the install never landed prints a line that
-- contains neither token — which would satisfy neither expectation and blame
-- the check rather than the fixture.
$s133 = run_installer([$MIX, $fixed133, "--status"], {timeout: 300})
$f = $f + ok("T133base a repository whose own directories are writable only by"
  .. " their owner reports installed — the widening check does not fire on the"
  .. " ordinary case",
  $i133["exit_code"] == 0 and contains(statusline129($s133), "installed"),
  join(["install_rc=", "" .. $i133["exit_code"], " line=",
    sanitize(statusline129($s133))], ""))
$gd133 = trim(must($rp133, ["git", "rev-parse", "--absolute-git-dir"]))
-- The two group names are chosen from the host's real passwd/group maps and
-- both are asserted below rather than assumed, because the whole point of the
-- round-thirty-nine narrowing is that it reads those maps:
--
--   FOREIGN   a group this account belongs to that has ANOTHER member, so
--             `chgrp` needs no privilege and the membership question has a
--             real answer to find. On this host that is `sudo` (sysadm,
--             markc); the row asserts the second member exists before it
--             believes the result.
--   OWN       the account's own private group, whose only member is the owner
--             — the case round thirty-eight refused on and this one must not.
--
-- ROUND FORTY rebuilt what these rows discriminate ON, and the reason is worth
-- stating because it is the second time this suite has hit it. Round forty gave
-- the installer an INDEPENDENT guard — the hooks-path ownership walk now poisons
-- the verdict instead of printing a cosmetic warning — and that guard catches
-- the very fixtures these rows build. So the mutant, which disarms round
-- thirty-eight's executability narrowing, no longer reports `installed`: it gets
-- caught by the other guard and reports UNVERIFIED too. Both arms landed on the
-- same token and the rows stopped discriminating, which is subsumption, not a
-- product defect — the mutant is still detected, just by a different guard.
--
-- The recovery rule is the one this suite already carries: move the row onto
-- state that still differs, never weaken the assertion. WHICH guard fired still
-- differs, and differs exactly along the line the mutant cuts — the repaired
-- build answers `executability UNVERIFIED` because round thirty-eight's arm is
-- doing its job, and the mutant answers `installation UNVERIFIED` because that
-- arm is gone and only the path walk is left. So both directions are asserted:
-- the mutant must show the other guard's token AND must NOT show the one round
-- thirty-eight owns. Without that negative clause a mutant that kept round
-- thirty-eight's behaviour would still pass on the positive clause alone.
--
-- (q) That describes `other`, `group` and `gitdir`, whose mutants each disarm
-- ONE arm and are then caught by the other. `acl` is not one of them and must
-- not be read as one: it stubs the ACL scan, which after the unification is the
-- shared first question BOTH arms ask, so nothing is left to catch it and its
-- mutant reports the bare `installed` at exit 0. Its row therefore expects a
-- clean token from the mutant, not a relocated one — the per-row [7] column
-- carries this, and the exit codes derive from it, so neither is stated twice.
--
-- (r) `ungrp` is untouched by any of this and keeps the plain installed /
-- UNVERIFIED pair, because after the two arms were unified the repaired build
-- emits no warning there at all — which is the whole thing that row exists to
-- prove.
--
-- tag, path, group to chgrp to ("" = leave), bits to OR in, setfacl?, mutant,
-- token the FIXED line must carry, token the MUTANT line must carry, substring
-- the fixed line must carry ("" = only the token is asserted), why, token the
-- mutant line must NOT carry ("" = no negative clause).
--
-- The expected exit codes are DERIVED from those tokens rather than written
-- out: round forty ends a --status run at 2 when it reported unverified state
-- and 0 when it did not, so a token naming an UNVERIFIED state and an exit code
-- of 0 is a contradiction the row should catch rather than a pair to maintain
-- by hand.
-- Round forty hoisted the foreign-group probe to $FGRP/$FGRP_OK at the top of
-- this file; T72 needs the same fixture now, and two copies of "which group
-- here has a second member" is one copy too many.
$fgrp133 = $FGRP
$ogrp133 = "" .. gid()
$facl133 = run_argv(["getfacl", "--version"], {timeout: 60})
$nobody133 = run_argv(["getent", "passwd", "nobody"], {timeout: 60})
$foreign_ok133 = $FGRP_OK
$acl_ok133 = ($facl133["exit_code"] == 0 and $nobody133["exit_code"] == 0)
$cases133 = [
  ["other", $rp133, "", 0o002, false, $mut133, "executability UNVERIFIED",
    "installation UNVERIFIED", "writable by other",
    join(["other-write needs no corroboration: every",
      " identity on the host has it, so the arm is unconditional and stays",
      " so"], ""), "executability UNVERIFIED"],
  ["group", $rp133, $fgrp133, 0o020, false, $mgrp133, "executability UNVERIFIED",
    "installation UNVERIFIED", "writable by group",
    join(["the WORKTREE ROOT is group-writable and the group has a member",
      " other than the owner, so another uid can commit here — and can delete",
      " the hook first"], ""), "executability UNVERIFIED"],
  ["gitdir", $gd133, $fgrp133, 0o020, false, $mgrp133, "executability UNVERIFIED",
    "installation UNVERIFIED", "writable by group",
    join(["the GIT DIRECTORY is group-writable, which the worktree root's mode",
      " says nothing about: the hooks live under it, and so does the config",
      " that decides where they live"], ""), "executability UNVERIFIED"],
  ["ungrp", $rp133, $ogrp133, 0o020, false, $mungrp133, "installed",
    "UNVERIFIED", "",
    join(["INVERTED. A user-private group at 0775 grants write to a group whose",
      " only member is the owner, and round thirty-eight refused on it — a",
      " permanent UNVERIFIED whose stated remedy, `chmod g-w` on a group",
      " containing only you, fixes nothing an operator cares about. The",
      " repaired build ANSWERS here; round thirty-eight's line put back",
      " refuses, so the row discriminates. Secondary members come from the",
      " group entry and PRIMARY members only from the passwd map, and this row",
      " is green only if both were consulted. Round forty widened what it",
      " proves: the two arms that answer 'can another uid write this' were",
      " unified, so the repaired build no longer warns about the path chain",
      " here either, and this row is the one that would go red if the naive",
      " mode-bit reading came back to EITHER of them"], ""), ""],
  ["acl", $rp133, $ogrp133, 0o000, true, $macl133, "executability UNVERIFIED",
    "installed",
    "writable by group",
    join(["and this is what keeps that narrowing honest. With an ACL present",
      " the group bits are the MASK, not the group's own permission: `setfacl",
      " -m u:nobody:rwx` on an 0755 directory reports 0775 while the group is",
      " still single-member, so a check that only counted members would hand",
      " a named user write and call it clean. Trading a false UNVERIFIED for a",
      " fail-open is not a narrowing, it is the defect this arc keeps finding.",
      " ROUND FORTY made this the sharpest row in the table rather than a",
      " subsumption casualty, and the reason is the unification itself. The ACL",
      " scan is the FIRST question group_write_is_foreign asks, and after round",
      " forty that one predicate answers for BOTH arms — so stubbing it blinds",
      " the executability arm and the hooks-path walk together. The mutant is",
      " left with no way at all to see the named user and reports the bare word",
      " `installed`, measured, at exit 0. That is a fail-open on a directory a",
      " named user can write, which is precisely the defect the row names above",
      " — where the other mutants merely relocate which guard fires, this one",
      " removes the last guard there is"], ""), "executability UNVERIFIED"]
]
for each $c133 in $cases133
  $skiprow133 = ""
  if $c133[2] == $fgrp133 and $foreign_ok133 == false then
    $skiprow133 = join(["group ", $fgrp133, " does not have a second member on",
      " this host, so there is no foreign identity to detect"], "")
  end
  if $c133[4] and $acl_ok133 == false then
    $skiprow133 = "getfacl/setfacl or the nobody account is unavailable"
  end
  if $skiprow133 != "" then
    print("SKIP  T133" .. $c133[0] .. " (" .. $skiprow133 .. ")")
  else
    $mode133 = stat($c133[1])["perm"]
    $grp133 = stat($c133[1])["gid"]
    $cg133 = {exit_code: 0}
    if $c133[2] != "" then
      $cg133 = run_argv(["chgrp", $c133[2], $c133[1]], {timeout: 60})
    end
    $sa133 = {exit_code: 0}
    if $c133[4] then
      $sa133 = run_argv(["setfacl", "-m", "u:nobody:rwx", $c133[1]],
        {timeout: 60})
    end
    if $c133[3] != 0 then
      chmod($c133[1], bor($mode133, $c133[3]))
    end
    $sf133 = run_installer([$MIX, $fixed133, "--status"], {timeout: 300})
    $sm133 = run_installer([$MIX, $c133[5], "--status"], {timeout: 300})
    -- Restore, and assert the restore: every row here mutates the SAME two
    -- paths, so a chgrp or setfacl that failed silently is inherited by the
    -- next row as fixture state it never asked for — which is how a row ends
    -- up green over a directory in some other row's condition.
    $ub133 = {exit_code: 0}
    if $c133[4] then
      $ub133 = run_argv(["setfacl", "-b", $c133[1]], {timeout: 60})
    end
    $ug133 = run_argv(["chgrp", "" .. $grp133, $c133[1]], {timeout: 60})
    chmod($c133[1], $mode133)
    $lf133 = statusline129($sf133)
    $lm133 = statusline129($sm133)
    -- The fixture's own steps are asserted. A chgrp or setfacl that silently
    -- failed leaves the directory in the ordinary state, where "installed" is
    -- the correct answer for the wrong reason — and for the inverted row that
    -- is indistinguishable from a pass.
    $sub133 = ($c133[8] == "" or (contains($lf133, $c133[8])
      and contains($lf133, $c133[1])))
    -- The negative half of the discrimination, and the half that carries it.
    -- The mutant showing the OTHER guard's token proves only that something
    -- refused; what the row has to prove is that round thirty-eight's arm is
    -- the thing that went missing, and only its ABSENCE from the mutant line
    -- says that. A mutant that somehow kept the behaviour would satisfy every
    -- positive clause here.
    $neg133 = ($c133[10] == "" or contains($lm133, $c133[10]) == false)
    -- Derived, not written down; see the table header.
    $frc133 = 0
    if contains($c133[6], "UNVERIFIED") then
      $frc133 = 2
    end
    $mrc133 = 0
    if contains($c133[7], "UNVERIFIED") then
      $mrc133 = 2
    end
    $f = $f + ok("T133" .. $c133[0] .. " " .. $c133[9]
      .. " — fixed reports " .. $c133[6] .. ", mutant reports " .. $c133[7]
      .. ", so the row discriminates",
      $cg133["exit_code"] == 0 and $sa133["exit_code"] == 0 and $sub133
        and contains($lf133, $c133[6]) and contains($lm133, $c133[7])
        and $neg133
        and $sf133["exit_code"] == $frc133 and $sm133["exit_code"] == $mrc133,
      join(["chgrp_rc=", "" .. $cg133["exit_code"], " setfacl_rc=",
        "" .. $sa133["exit_code"], " fixed_rc=", "" .. $sf133["exit_code"],
        " want_fixed_rc=", "" .. $frc133,
        " mutant_rc=", "" .. $sm133["exit_code"],
        " want_mutant_rc=", "" .. $mrc133,
        " neg_ok=", "" .. $neg133, " fixed=", sanitize($lf133),
        " mutant=", sanitize($lm133)], ""))
    $f = $f + ok("T133" .. $c133[0] .. "-restore put the fixture path back the"
      .. " way it found it, so the next row starts from the ordinary case",
      $ub133["exit_code"] == 0 and $ug133["exit_code"] == 0
        and stat($c133[1])["perm"] == $mode133
        and stat($c133[1])["gid"] == $grp133,
      join(["setfacl_b_rc=", "" .. $ub133["exit_code"], " chgrp_back_rc=",
        "" .. $ug133["exit_code"], " perm=", "" .. stat($c133[1])["perm"],
        " want_perm=", "" .. $mode133, " gid=", "" .. stat($c133[1])["gid"],
        " want_gid=", "" .. $grp133], ""))
  end
end

-- T134 — round thirty-eight, rebuilt in round thirty-nine. The gate stub used
-- to be rename()d into place and only THEN asked whether the kernel would
-- execute it, which is round thirty-three's and round thirty-seven's defect a
-- third time: a refusal that arrives after the write has replaced a live hook
-- with one git may skip. The probe now runs against the staging file, where
-- refusing costs one remove() and leaves the previous hook exactly where it was
-- — and, since round thirty-nine, it runs BEFORE the chain step too.
--
-- Round thirty-eight asserted this on the SOURCE (`pos(probe) < pos(rename)`)
-- and said a fixture was unreachable, on the grounds that a POSIX ACL cannot
-- deny a file's own owner: the mask does not bound ACL_USER_OBJ. That is true
-- and it was the wrong conclusion. The installer supports root installing into
-- another account's repository, and is_executable asks on behalf of the
-- REPOSITORY OWNER, not the writer — so a DEFAULT ACL on the hooks directory
-- gives every file root creates there a named-user entry for that owner, and a
-- named-user entry most certainly can deny someone who is not the file's owner.
-- Measured before this was written, with the hooks directory root-owned 0755
-- and `setfacl -d -m u:<owner>:rw-`:
--
--   ls -l   ->  -rwxr-xr-x+ 1 root root   (mode bits say executable)
--   getfacl ->  user:<owner>:rw-  #effective:r--   mask::r-x
--   access(stub, "x") as <owner>  ->  false
--
-- which is exactly the shape the whole access() line exists for: a file whose
-- mode bits read executable and which the kernel will not execute for the
-- identity git will use. The directory itself keeps its 0755 access ACL, so the
-- owner can still SEARCH it and the preflight passes — this fixture reaches the
-- staging probe, where T127's (which denies search) refuses much earlier.
--
-- So the row is now behavioural, and the source-order check is gone rather than
-- kept alongside: it could not see the CHAIN rename at all (round thirty-nine's
-- MAJOR three lived entirely in front of it) and it stays green if the probe is
-- wrapped in dead code. Three builds, one fixture shape, and it is the FILES
-- that separate them — all three exit 2:
--
--   fixed     refuses first: nothing chained, live hook byte-intact
--   mut-order the probe MOVED back after the chain (round thirty-eight's
--             order): `.pre-hygiene` is left on disk by a run that exits 2, and
--             every retry then dies on `already exists — resolve by hand`
--   mut-noprobe the staging probe stubbed out entirely: the chain runs AND the
--             live hook is replaced by a stub git will skip, caught only by the
--             post-rename probe
--
-- The two mutants are independently killable: mut-order leaves the live hook
-- intact (so a live-hook assertion alone cannot see it) and mut-noprobe chains
-- as well (so a `.pre-hygiene` assertion alone cannot tell it from mut-order).
-- Each row asserts the pair.
if $sudo126["exit_code"] != 0 or $setfacl126["exit_code"] != 0 \
    or $me126 == "" or uid() == 0 then
  print("SKIP  T134a/b/c (same requirements as T126a/b)")
else
  $base134 = read_file($INSTALL)
  -- The probe block is SLICED out of the real source rather than restated as a
  -- literal here. Restating it would mean carrying a copy of a sixteen-line
  -- bail message in the suite, where it would drift out of step with the
  -- installer silently; slicing means the mutant is always the shipped code,
  -- moved. Both ends are short anchors and both are proved unique below.
  $head134 = "    $xt = is_executable($wtmp, $repo)\n"
  $hi134 = pos($head134, $base134)
  $blk134 = ""
  if $hi134 > 0 then
    $tl134 = substr($base134, $hi134 - 1)
    $eo134 = pos("\n    end\n", $tl134)
    if $eo134 > 0 then
      -- 1-based pos, 0-based substr, and the terminator is nine codepoints.
      $blk134 = substr($tl134, 0, $eo134 + 8)
    end
  end
  if $blk134 == "" or occurrences($base134, $blk134) != 1 then
    print("SETUP FAILED: T134 could not slice exactly one staging-probe block"
      .. " out of " .. $INSTALL .. " (head_at=" .. "" .. $hi134 .. ")")
    exit(2)
  end
  for each $case134 in [["a", "fixed"], ["b", "order"], ["c", "noprobe"]]
    $tag134 = "T134" .. $case134[0]
    $rp134 = newrepo("t134-order-" .. $case134[0])
    $cmctl134 = $ROOT .. "/cmctl134" .. $case134[0]
    mkdir($cmctl134 .. "/_bin")
    mkdir($cmctl134 .. "/_etc")
    copy($GATE, $cmctl134 .. "/_bin/check-public-hygiene.mix")
    copy($HOOK, $cmctl134 .. "/_bin/hygiene-hook.mix")
    chmod($cmctl134 .. "/_bin/check-public-hygiene.mix", 0o755)
    chmod($cmctl134 .. "/_bin/hygiene-hook.mix", 0o755)
    write_file($cmctl134 .. "/_etc/public-hygiene.conf.mix", join([
      "public_hygiene: {\n",
      "  schema_version: 1,\n",
      "  repos: [\"" .. $rp134 .. "\"],\n",
      "  static_rules: " .. $FIXTURE_RULES .. ",\n",
      "  generic_node_names: [],\n",
      "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
      "}\n"
    ], ""))
    $src134 = must_replace($base134,
      "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cmctl134 .. "\"")
    if $case134[1] == "order" then
      -- Round thirty-eight's order, reconstructed: delete the probe from the
      -- staging step and put it back after the chain block, immediately before
      -- the rename. Anchoring the reinsertion on the comment that opens the
      -- rename step rather than on the chain's print() matters — the print is
      -- inside `if $present and $ours == false then`, so a probe placed there
      -- would vanish entirely for a repository with no existing hook, which is
      -- a second defect this row is not about.
      $src134 = replace($src134, $blk134, "")
      if contains($src134, $blk134) then
        print("SETUP FAILED: " .. $tag134 .. " could not delete the probe block")
        exit(2)
      end
      $src134 = must_insert($src134,
        "  -- The last irreversible step, and by now the only one that can still"
          .. " fail is\n",
        $blk134)
    end
    if $case134[1] == "noprobe" then
      $src134 = must_replace($src134, "$xt = is_executable($wtmp, $repo)",
        "$xt = {run: true, why: \"\"}")
    end
    $safe134 = contains($src134, $CMCTL) == false and contains($src134, $cmctl134)
    if $safe134 == false then
      print($tag134 .. " refused to execute an installer whose fixture scope"
        .. " was not proved")
      exit(2)
    end
    $install134 = $cmctl134 .. "/_bin/install-hygiene-hooks.mix"
    write_file($install134, $src134)
    chmod($install134, 0o755)
    -- Root-owned and outside $ROOT, for T127's reasons: a hooks directory
    -- inside the markc-owned fixture tree is refused by the ancestor-ownership
    -- walk before any of this is reached, and root-owned is the only shape in
    -- which the writer and the repository's owner genuinely differ.
    $hdir134 = "/tmp/cosmix-t134-hooks-" .. uuid()
    $c134 = run_argv(["sudo", "-n", "mkdir", "-m", "0755", $hdir134],
      {timeout: 60})
    try
    $z134 = run_argv(["git", "-C", $rp134, "config", "core.hooksPath", $hdir134],
      {timeout: 60})
    -- The default ACL. `-d` touches only the default set, so the directory's
    -- own permissions stay 0755 and the owner can still search it.
    $a134 = run_argv(["sudo", "-n", "setfacl", "-d", "-m", $me126 .. ":rw-",
      $hdir134], {timeout: 60})
    $foreign134 = "#!/bin/sh\n# t134 pre-existing foreign hook\nexit 0\n"
    $fsrc134 = $ROOT .. "/t134-foreign-" .. $case134[0]
    write_file($fsrc134, $foreign134)
    $p134 = run_argv(["sudo", "-n", "cp", $fsrc134, $hdir134 .. "/pre-commit"],
      {timeout: 60})
    $q134 = run_argv(["sudo", "-n", "chmod", "0755", $hdir134 .. "/pre-commit"],
      {timeout: 60})
    $r134 = run_argv(["sudo", "-n", $MIX, $install134], {timeout: 900})
    -- Listed and read back as root: the files are root-owned, and a fixture
    -- whose denial reached further than intended must not be able to answer
    -- "absent" for the wrong reason.
    $ls134 = run_argv(["sudo", "-n", "ls", "-1", $hdir134], {timeout: 60})
    $chained134 = false
    $stray134 = false
    for each $ln134 in split($ls134["stdout"], "\n")
      if trim($ln134) == "pre-commit.pre-hygiene" then
        $chained134 = true
      end
      if ends_with(trim($ln134), ".hygiene-tmp") then
        $stray134 = true
      end
    end
    $cat134 = run_argv(["sudo", "-n", "cat", $hdir134 .. "/pre-commit"],
      {timeout: 60})
    $intact134 = ($cat134["exit_code"] == 0 and $cat134["stdout"] == $foreign134)
    -- Prove the fixture actually denies what it claims to, as the repository's
    -- owner and on a file created the same way the staging file is. Without
    -- this a setfacl that silently did nothing would make all three builds
    -- succeed identically and the row would report a green diagonal over a
    -- fixture that tested nothing.
    $probe134 = $hdir134 .. "/acl-probe"
    $pc134 = run_argv(["sudo", "-n", "cp", $fsrc134, $probe134], {timeout: 60})
    $pm134 = run_argv(["sudo", "-n", "chmod", "0755", $probe134], {timeout: 60})
    $denied134 = "unknown"
    try
      $denied134 = access($probe134, "x")
    catch $pe134
      $denied134 = "raised: " .. $pe134
    end
    $detail134 = join(["mkdir_rc=", "" .. $c134["exit_code"],
      " hookspath_rc=", "" .. $z134["exit_code"],
      " setfacl_rc=", "" .. $a134["exit_code"],
      " seed_rc=", "" .. $p134["exit_code"],
      " chmod_rc=", "" .. $q134["exit_code"],
      " owner_can_exec=", "" .. $denied134,
      " install_rc=", "" .. $r134["exit_code"],
      " chained=", "" .. $chained134,
      " live_hook_intact=", "" .. $intact134,
      " staging_left=", "" .. $stray134,
      " out=", sanitize(substr(trim($r134["stdout"] .. " " .. $r134["stderr"]),
        0, 320))], "")
    $fixture134 = ($c134["exit_code"] == 0 and $a134["exit_code"] == 0
      and $p134["exit_code"] == 0 and $q134["exit_code"] == 0
      and $pc134["exit_code"] == 0 and $pm134["exit_code"] == 0
      and $denied134 == false)
    if $case134[1] == "fixed" then
      $f = $f + ok($tag134 .. " a staging file the kernel will not execute for"
        .. " the repository's owner refuses with 2 BEFORE anything is touched —"
        .. " no .pre-hygiene, the live hook byte-intact, no staging file left",
        $fixture134 and $r134["exit_code"] == 2 and $chained134 == false
          and $intact134 and $stray134 == false,
        $detail134)
    end
    if $case134[1] == "order" then
      -- The finding, as state: exit 2 over a repository the run has already
      -- modified. `chained134` is the whole point; `intact134` is asserted with
      -- it so this row cannot be satisfied by the mut-noprobe damage instead.
      $f = $f + ok($tag134 .. " with the probe moved back behind the chain step"
        .. " the run exits 2 having ALREADY created .pre-hygiene, which wedges"
        .. " every retry on `already exists — resolve by hand` — the row"
        .. " discriminates on that file",
        $fixture134 and $r134["exit_code"] == 2 and $chained134
          and $intact134 and $stray134 == false,
        $detail134)
    end
    if $case134[1] == "noprobe" then
      -- And with no staging probe at all, the post-rename one is the only guard
      -- left: it still refuses with 2, but over a repository whose live hook is
      -- now the stub. `intact134 == false` is what separates this from
      -- mut-order.
      $f = $f + ok($tag134 .. " without the staging probe the live hook is"
        .. " REPLACED by a stub git will skip and the refusal arrives after —"
        .. " chained, not intact, and still 2",
        $fixture134 and $r134["exit_code"] == 2 and $chained134
          and $intact134 == false and $stray134 == false,
        $detail134)
    end
    finally
      -- Root-owned and outside $ROOT, so the suite's own cleanup cannot reach
      -- it; asserted rather than warned, for T127's reason.
      $rm134 = run_argv(["sudo", "-n", "rm", "-rf", $hdir134], {timeout: 60})
      $f = $f + ok($tag134 .. "-teardown removed its root-owned hooks fixture",
        exists($hdir134, {follow_symlinks: false}) == false,
        join(["rm_rc=", "" .. $rm134["exit_code"], " path=", $hdir134], ""))
      if exists($hdir134) then
        print("WARNING: " .. $tag134 .. " could not remove its root-owned hooks"
          .. " fixture " .. $hdir134 .. " — remove it by hand (rc="
          .. $rm134["exit_code"] .. ")")
      end
    end
  end
end

-- T127 — round thirty-three. T126 proves the runner-identity question is asked
-- correctly, but only ever calls --status, so both its rows stay green if the
-- POST-WRITE call site regresses while the status one stays fixed. This pair
-- exercises the writing path, and it discriminates on the thing that path is
-- uniquely able to get wrong: writing first and discovering afterwards that the
-- answer was never obtainable.
--
-- The fixture denies the repository's owner SEARCH on the hooks directory, and
-- seeds it with an existing foreign pre-commit. Both builds must refuse — a
-- file inside an unsearchable directory cannot be access()ed by that owner at
-- all, so whichever guard gets there first catches it. What separates them is
-- WHICH ONE does: the fixed build answers the question once for the whole run
-- and stops before any repository is touched; the mutant has that answer
-- stubbed out and gets as far as the per-hook staging probe, a guard that is
-- reached once per hook per repository. An exit-code row alone would pass
-- against both and prove nothing, which is the same shape of blind spot T126
-- had; the discriminating clause is the refusal message, asserted in both
-- directions. See the long note further down for why this is the row's second
-- rebuild and why it is no longer the FILES that separate the builds.
if $sudo126["exit_code"] != 0 or $setfacl126["exit_code"] != 0 \
    or $me126 == "" or uid() == 0 then
  print("SKIP  T127a/b (same requirements as T126a/b)")
else
  for each $case127 in [["a", false], ["b", true]]
    $tag127 = "T127" .. $case127[0]
    $rp127 = newrepo("t127-prewrite-" .. $case127[0])
    $cmctl127 = $ROOT .. "/cmctl127" .. $case127[0]
    mkdir($cmctl127 .. "/_bin")
    mkdir($cmctl127 .. "/_etc")
    copy($GATE, $cmctl127 .. "/_bin/check-public-hygiene.mix")
    copy($HOOK, $cmctl127 .. "/_bin/hygiene-hook.mix")
    chmod($cmctl127 .. "/_bin/check-public-hygiene.mix", 0o755)
    chmod($cmctl127 .. "/_bin/hygiene-hook.mix", 0o755)
    write_file($cmctl127 .. "/_etc/public-hygiene.conf.mix", join([
      "public_hygiene: {\n",
      "  schema_version: 1,\n",
      "  repos: [\"" .. $rp127 .. "\"],\n",
      "  static_rules: " .. $FIXTURE_RULES .. ",\n",
      "  generic_node_names: [],\n",
      "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
      "}\n"
    ], ""))
    $src127 = must_replace(read_file($INSTALL),
      "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cmctl127 .. "\"")
    if $case127[1] then
      -- The mutant: neuter the pre-write probe, restoring "write first, find
      -- out afterwards".
      $src127 = must_replace($src127,
        "$pre = access_x_as($who_pre[\"uid\"], $real)",
        "$pre = {ok: true, why: \"\"}")
    end
    $safe127 = contains($src127, $CMCTL) == false and contains($src127, $cmctl127)
    if $safe127 == false then
      print($tag127 .. " refused to execute an installer whose fixture scope"
        .. " was not proved")
      exit(2)
    end
    $install127 = $cmctl127 .. "/_bin/install-hygiene-hooks.mix"
    write_file($install127, $src127)
    chmod($install127, 0o755)
    -- The hooks directory must sit OUTSIDE the suite's fixture root and be
    -- root-owned. The first draft of this pair put it at `$rp127/.git/hooks`
    -- and measured nothing at all: with the hooks directory inside a
    -- markc-owned tree and the installer running as root, the
    -- ancestor-ownership walk (unsafe_component) refuses the entire run before
    -- the pre-write probe is ever reached, so BOTH builds bailed identically
    -- and neither wrote a byte. A root-owned `core.hooksPath` is also the only
    -- shape in which the writer (root) and the runner (the repository's owner)
    -- genuinely differ on the WRITING path, which is the thing under test.
    $hdir127 = "/tmp/cosmix-t127-hooks-" .. uuid()
    $c127 = run_argv(["sudo", "-n", "mkdir", "-m", "0755", $hdir127],
      {timeout: 60})
    -- Everything from here to the assertions runs under `finally`, because the
    -- directory is ROOT-owned and lives outside $ROOT: the suite's own cleanup
    -- cannot remove it, and an abort between here and the rm would leak it into
    -- /tmp permanently (round thirty-four MINOR nine). The removal is reported
    -- if it fails rather than assumed to have worked.
    try
    $z127 = run_argv(["git", "-C", $rp127, "config", "core.hooksPath",
      $hdir127], {timeout: 60})
    -- Already root-owned, so the named entry is a NAMED entry (ACL_USER_OBJ
    -- would otherwise subsume it and deny nothing — T126's lesson). Deny the
    -- repository's owner SEARCH on the directory itself.
    $a127 = run_argv(["sudo", "-n", "setfacl", "-m", $me126 .. ":---", $hdir127],
      {timeout: 60})
    -- This pair has now been rebuilt TWICE by fixes to the thing it tests, both
    -- times because the product got stronger and the row got weaker — the
    -- subsumption class, arriving from the product side rather than from anchor
    -- drift.
    --
    -- Round thirty-eight: the mutant used to be separated by nine written
    -- hooks; the pre-RENAME probe removed the staging file and left the target
    -- untouched, so against an EMPTY hooks directory both builds ended with
    -- nothing written. The row moved onto an existing foreign hook, because the
    -- chain step still ran before the staging probe: the mutant copied it to
    -- `.pre-hygiene` and only then refused, while the fixed build refused first.
    --
    -- Round thirty-nine reordered that to stage-and-prove → chain → rename, so
    -- the staging probe now refuses BEFORE the chain and `chained` is false on
    -- both builds. The row went red rather than quietly passing — the count of
    -- times this arc's own site-and-diagonal discipline has caught its own diff
    -- is now two in this round alone.
    --
    -- What still differs is WHICH GUARD refuses, and that is not a cosmetic
    -- difference: the fixed build refuses in the whole-run PREFLIGHT, before any
    -- repository in the run is touched, so a multi-repository run stops at zero
    -- writes; the mutant falls through to the per-hook staging probe, which is
    -- reached once per hook per repository and only after earlier repositories
    -- may already carry an installed gate. Both messages are distinctive and
    -- each belongs to exactly one bail() site, so the rows assert both arms of
    -- the diagonal — the expected message present and the other one absent —
    -- rather than one arm and a shrug.
    --
    -- The pre-existing foreign hook stays: it is what lets both rows assert the
    -- stronger thing the probes promise — the live hook is byte-intact, nothing
    -- was chained aside, and no staging file is left.
    $foreign127 = "#!/bin/sh\n# t127 pre-existing foreign hook\nexit 0\n"
    $fsrc127 = $ROOT .. "/t127-foreign-" .. $case127[0]
    write_file($fsrc127, $foreign127)
    $p127 = run_argv(["sudo", "-n", "cp", $fsrc127, $hdir127 .. "/pre-commit"],
      {timeout: 60})
    $q127 = run_argv(["sudo", "-n", "chmod", "0755", $hdir127 .. "/pre-commit"],
      {timeout: 60})
    -- Prove the denial before believing either verdict.
    $blocked127 = false
    try
      $blocked127 = access($hdir127, "x")
    catch $be127
      $blocked127 = "raised: " .. $be127
    end
    $r127 = run_argv(["sudo", "-n", $MIX, $install127], {timeout: 900})
    -- Did anything get written? Ask as root: the directory is unsearchable for
    -- us, so our own exists() would answer "no" for the wrong reason.
    $ls127 = run_argv(["sudo", "-n", "ls", "-1", $hdir127], {timeout: 60})
    -- An EXACT line, not a substring. The first draft asked
    -- `contains($stdout, "pre-commit")` against a `.git/hooks` git had just
    -- populated with its own samples, so `pre-commit.sample` answered yes for
    -- both builds — the fixed one failed and the mutant PASSED, which is the
    -- same false-discrimination T126b exists to catch, arriving by substring
    -- instead of by exit code.
    $chained127 = false
    $stray127 = false
    for each $ln127 in split($ls127["stdout"], "\n")
      if trim($ln127) == "pre-commit.pre-hygiene" then
        $chained127 = true
      end
      if ends_with(trim($ln127), ".hygiene-tmp") then
        $stray127 = true
      end
    end
    -- Read it back as root for the same reason the listing is taken as root.
    $cat127 = run_argv(["sudo", "-n", "cat", $hdir127 .. "/pre-commit"],
      {timeout: 60})
    $intact127 = ($cat127["exit_code"] == 0
      and $cat127["stdout"] == $foreign127)
    -- Which guard refused. Each of these substrings belongs to exactly one
    -- bail() in the installer — checked by hand this round, and the reason the
    -- second one carries "was" and the chmod clause: two other messages mention
    -- a staging file, and one of them ("had been written to a staging file")
    -- would otherwise match on a prefix. bail() is a single print(), so nothing
    -- wraps and a substring test is safe.
    $out127 = $r127["stdout"] .. " " .. $r127["stderr"]
    $preflight127 = contains($out127, "cannot search the hooks directory")
    $staged127 = contains($out127,
      "was written to a staging file and chmod'ed 0755")
    $detail127 = join(["mkdir_rc=", "" .. $c127["exit_code"],
      " setfacl_rc=", "" .. $a127["exit_code"],
      " seed_rc=", "" .. $p127["exit_code"],
      " owner_can_search=", "" .. $blocked127,
      " install_rc=", "" .. $r127["exit_code"],
      " chained=", "" .. $chained127,
      " live_hook_intact=", "" .. $intact127,
      " staging_left=", "" .. $stray127,
      " preflight_refused=", "" .. $preflight127,
      " staging_probe_refused=", "" .. $staged127,
      " out=", sanitize(substr(trim($out127), 0, 320))], "")
    if $case127[1] == false then
      -- Round thirty-eight: `!= 0` here, and on the mutant row below, was the
      -- same weakness round thirty-seven took out of T131. This installer has
      -- exactly two failure codes — 1 is "a leak was found", 2 is "cannot
      -- answer" — and everything this row is about is the second. `!= 0`
      -- accepts the first, and accepts an interpreter that dies on a syntax
      -- error at line one just as readily.
      $f = $f + ok($tag127 .. " an unanswerable runner question refuses in the"
        .. " whole-run PREFLIGHT, before any repository is touched — the"
        .. " existing hook is not chained aside, it is byte-intact, no staging"
        .. " file is left, nothing was even staged, and it refuses with 2"
        .. " (cannot answer), not 1 (found a leak)",
        $blocked127 == false and $r127["exit_code"] == 2
          and $chained127 == false and $intact127 and $stray127 == false
          and $preflight127 and $staged127 == false,
        $detail127)
    else
      -- The exit code is asserted HERE as well as on the fixed row, and round
      -- thirty-four is why: once the preflight is gone, the per-hook probes are
      -- the only guards left, and asserting the on-disk state alone left both
      -- rows green when one of those was deleted outright. The on-disk clauses
      -- are kept for the same reason in reverse — they are what says the
      -- fallback guard, having refused late, still refused CLEANLY: round
      -- thirty-nine's reorder is the reason `chained` is false here too, and if
      -- that reorder is ever undone this clause is what notices.
      $f = $f + ok($tag127 .. " without the preflight the run gets as far as the"
        .. " per-hook staging probe and refuses THERE instead — a guard that is"
        .. " reached once per hook per repository rather than once per run, with"
        .. " the same 2, and still leaving the existing hook unchained,"
        .. " byte-intact and no staging file behind",
        $blocked127 == false and $r127["exit_code"] == 2
          and $chained127 == false and $intact127 and $stray127 == false
          and $staged127 and $preflight127 == false,
        $detail127)
    end
    finally
      -- An assertion, not a warning, for the reason round thirty-seven gave for
      -- T129z: this fixture is root-owned and unwritable by the account running
      -- the suite, so a failed cleanup leaves a directory the next round cannot
      -- clear either — and a suite that exits 0 having done that has told
      -- nobody. The print stays for the remedy; the row is what makes it read.
      $z127 = run_argv(["sudo", "-n", "rm", "-rf", $hdir127], {timeout: 60})
      $f = $f + ok($tag127 .. "-teardown removed its root-owned hooks fixture",
        exists($hdir127, {follow_symlinks: false}) == false,
        join(["rm_rc=", "" .. $z127["exit_code"], " path=", $hdir127], ""))
      if exists($hdir127) then
        print("WARNING: " .. $tag127 .. " could not remove its root-owned hooks"
          .. " fixture " .. $hdir127 .. " — remove it by hand (rc="
          .. $z127["exit_code"] .. ")")
      end
    end
  end
end

-- T135 — round forty, and this one came out of the review rather than the
-- code. Round forty replaced the path-safety predicate's return value with a
-- structured decision map, `{state, category, reason}`, specifically so that
-- the security branch stopped being a substring test against diagnostic prose.
-- That was the right move and it introduced its own hazard, which the reviewer
-- named as an unenforced assumption: Mix has no sum type, so `state` is only
-- conventionally one of safe/unsafe/unknown. Every consumer handled `unknown`,
-- then `unsafe`, and let anything else fall off the end — as SAFE. A single
-- character wrong at a producer, `"unkown"`, and a world-writable ancestor is
-- waved through. Fail-open, from a change made to make the code safer, which is
-- how this arc has produced most of its defects.
--
-- The fix is a normaliser every consumer passes the producer's value through
-- before reading either field: an unrecognised state is a cannot-answer and
-- becomes `unknown`, so status warns and install refuses. This row proves it is
-- real, and proves it the only way that means anything — by putting the typo IN
-- and showing the run still refuses.
--
-- TWO mutants, because one cannot carry this. M1 alone shows the typo'd build
-- refusing, which is consistent with the enforcement working AND with some
-- unrelated guard having caught the same fixture — the subsumption this suite
-- has now hit twice. M2 is M1 with the normaliser's recognised-state test
-- shorted to `if true`, so the raw typo reaches the consumers untouched. M2
-- must report the bare `installed` at exit 0. That is the diagonal: the two
-- mutants differ by the enforcement and by nothing else, so the difference
-- between their verdicts IS the enforcement's contribution, and no other guard
-- can account for it.
--
-- The fixture is a world-writable non-sticky ANCESTOR rather than the repo
-- itself, because nothing else inspects that ancestor — the row must not be
-- able to pass on a second opinion.
$anc135 = $ROOT .. "/t135-open-ancestor"
mkdir($anc135)
$rp135 = newrepo("t135-open-ancestor/inner")
$cm135 = $ROOT .. "/cmctl135"
mkdir($cm135 .. "/_bin")
mkdir($cm135 .. "/_etc")
copy($GATE, $cm135 .. "/_bin/check-public-hygiene.mix")
copy($HOOK, $cm135 .. "/_bin/hygiene-hook.mix")
chmod($cm135 .. "/_bin/check-public-hygiene.mix", 0o755)
chmod($cm135 .. "/_bin/hygiene-hook.mix", 0o755)
write_file($cm135 .. "/_etc/public-hygiene.conf.mix", join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp135 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$base135 = must_replace(read_file($INSTALL),
  "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cm135 .. "\"")
$fixed135 = $cm135 .. "/_bin/install-hygiene-hooks.mix"
write_file($fixed135, $base135)
chmod($fixed135, 0o755)
-- The producer typo. Anchored on all three fields of the world-write return so
-- the substitution cannot land on one of the other decision maps: `state:
-- "unsafe"` on its own appears at every unsafe producer in the file.
$typo135 = join(["      state: \"unsafe\",\n",
  "      category: \"writability\",\n",
  "      reason: \"is world-writable\""], "")
$m1_135 = $cm135 .. "/_bin/mutant-typo.mix"
write_file($m1_135, must_replace($base135, $typo135,
  replace($typo135, "\"unsafe\"", "\"unkown\"")))
chmod($m1_135, 0o755)
-- M2 = M1 plus the enforcement shorted out. Built FROM M1's text, not from the
-- base, so the two differ by exactly the one clause under test.
$m2_135 = $cm135 .. "/_bin/mutant-typo-unenforced.mix"
write_file($m2_135, must_replace(read_file($m1_135),
  "if $state == \"safe\" or $state == \"unsafe\" or $state == \"unknown\" then",
  "if true then"))
chmod($m2_135, 0o755)
$s135base = run_installer([$MIX, $fixed135, "--status"], {timeout: 300})
chmod($anc135, 0o777)
$s135m1 = run_installer([$MIX, $m1_135, "--status"], {timeout: 300})
$s135m2 = run_installer([$MIX, $m2_135, "--status"], {timeout: 300})
$l135m1 = statusline129($s135m1)
$l135m2 = statusline129($s135m2)
-- The premise. Before the ancestor is opened up this fixture is ordinary, and a
-- row whose "refuses" clause is satisfied by a repository that was never
-- installable in the first place measures nothing.
$f = $f + ok("T135p premise: the fixture answers cleanly before its ancestor is"
  .. " opened up, so the refusals below are caused by the world-writable"
  .. " ancestor and not by the fixture",
  $s135base["exit_code"] == 0
    and contains(statusline129($s135base), "ABSENT"),
  join(["rc=", "" .. $s135base["exit_code"], " line=",
    sanitize(statusline129($s135base))], ""))
$f = $f + ok("T135a a producer state one character wrong is normalised to a"
  .. " cannot-answer, so the typo'd build still refuses instead of waving the"
  .. " world-writable ancestor through",
  $s135m1["exit_code"] == 2
    and contains($s135m1["stdout"] .. $s135m1["stderr"], $DONE)
    and contains($s135m1["stdout"] .. $s135m1["stderr"], "unrecognised state")
    and contains($l135m1, "UNVERIFIED"),
  join(["rc=", "" .. $s135m1["exit_code"], " line=", sanitize($l135m1)], ""))
$f = $f + ok("T135b and with the normaliser shorted the SAME typo reports the"
  .. " bare `installed` at exit 0 — so T135a's refusal is the enforcement's"
  .. " doing and no other guard can account for it",
  $s135m2["exit_code"] == 0
    and contains($l135m2, "ABSENT")
    and contains($s135m2["stdout"] .. $s135m2["stderr"], "world-writable")
      == false,
  join(["rc=", "" .. $s135m2["exit_code"], " line=", sanitize($l135m2)], ""))
$rst135 = run_argv(["chmod", "0755", $anc135], {timeout: 60})
$f = $f + ok("T135-restore closed the world-writable ancestor again",
  $rst135["exit_code"] == 0 and band(stat($anc135)["perm"], 0o002) == 0,
  join(["rc=", "" .. $rst135["exit_code"], " perm=",
    "" .. stat($anc135)["perm"]], ""))

-- T136 — round forty's other fix, and the only one in the arc whose bug is
-- about TIME rather than about state. The unified predicate memoises group
-- membership on "<uid>:<gid>", which is sound: the answer is a property of
-- that pair. The first cut cached the cannot-answer too, and a cannot-answer
-- is not a property of the pair — it is a property of the instant. `getent`
-- failing once, an NSS backend blinking, a nscd restart mid-run, and the whole
-- run inherits one transient outage as a permanent verdict: every later
-- group-writable component is refused on evidence nobody ever gathered.
--
-- The predicate is asked twice about the hooks directory on purpose. The path
-- walk asks first and DEFERS a writability answer about the final component
-- (`continue`), because the dedicated block below it words the refusal in
-- terms of the fix. So the deferral is only honest if the second ask can
-- actually reach a different answer than the first. Cache the nil and it
-- cannot: the deferral becomes a way of losing the question. That coupling is
-- what this row measures, and no other row in the suite touches it.
--
-- Making a transient failure happen on demand needs a `getent` that fails once
-- and then works. A shim first on PATH does it: it fails the FIRST
-- `getent group <gid>` for this fixture's gid, records that it did so in a
-- sentinel file, and delegates everything else — including its own second
-- call — to the real /usr/bin/getent. The sentinel is what stops the row from
-- passing vacuously: a run in which the shim never fired proves nothing about
-- recovery, so T136s asserts the firing rather than assuming it.
--
-- Fixture shape is deliberate. ONLY the hooks directory is group-writable, at
-- 0775 under the owner's own private group — every ancestor is group-write
-- clear, so the 0o020 gate opens exactly once and the shim's single failure
-- lands on the one lookup under test. The group being user-private is what
-- makes the recovered answer `false` (safe) rather than merely "different".
--
-- Four rows, because the diagonal needs all four corners. Shim absent: both
-- builds must answer cleanly (T136p1, T136p2) — that is what rules out "the
-- mutant is simply broken". Shim armed: the fixed build still answers
-- (T136a) and the mutant refuses (T136b). The two builds differ by the
-- caching of nil and by nothing else, and they agree everywhere the shim does
-- not fire, so the disagreement IS the cached cannot-answer.
fn shim136($tag, $gid)
  $d = $ROOT .. "/t136-shim-" .. $tag
  mkdir($d)
  $s = $ROOT .. "/t136-fired-" .. $tag
  write_file($d .. "/getent", join([
    "#!/opt/cosmix/bin/mix\n",
    "$SENT = \"", $s, "\"\n",
    "$a = args()\n",
    "if len($a) >= 2 and $a[0] == \"group\" and $a[1] == \"", $gid,
      "\" and exists($SENT) == false then\n",
    "  write_file($SENT, \"fired\\n\")\n",
    "  exit(1)\n",
    "end\n",
    "$r = run_argv(concat([\"/usr/bin/getent\"], $a),",
      " {timeout: 60, max_output: 33554432})\n",
    "printf(\"%s\", $r[\"stdout\"])\n",
    "eprintf(\"%s\", $r[\"stderr\"])\n",
    "$rc = $r[\"exit_code\"]\n",
    "if $rc == nil then\n",
    "  $rc = 127\n",
    "end\n",
    "exit($rc)\n"], ""))
  chmod($d .. "/getent", 0o755)
  return {dir: $d, sentinel: $s}
end
$rp136 = newrepo("t136-nil-cache")
$hd136 = $rp136 .. "/.git/hooks"
chmod($hd136, 0o775)
-- Rendered exactly the way the installer renders it for its own argv, so the
-- shim compares against the same token the predicate will pass.
$gid136 = "" .. stat($hd136)["gid"]
$cm136 = $ROOT .. "/cmctl136"
mkdir($cm136 .. "/_bin")
mkdir($cm136 .. "/_etc")
copy($GATE, $cm136 .. "/_bin/check-public-hygiene.mix")
copy($HOOK, $cm136 .. "/_bin/hygiene-hook.mix")
chmod($cm136 .. "/_bin/check-public-hygiene.mix", 0o755)
chmod($cm136 .. "/_bin/hygiene-hook.mix", 0o755)
write_file($cm136 .. "/_etc/public-hygiene.conf.mix", join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp136 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$base136 = pin_nsswitch(must_replace(read_file($INSTALL),
  "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cm136 .. "\""),
  $NSS_ENUMERABLE)
$fixed136 = $cm136 .. "/_bin/install-hygiene-hooks.mix"
write_file($fixed136, $base136)
chmod($fixed136, 0o755)
-- The mutant restores the caching this round removed. Anchored on the whole
-- `getent group` failure block: the three-line truncation/lossy guard shape
-- repeats for the passwd calls too, so only the $gr variable makes it unique.
$anchor136 = join([
  "  $gr = run_argv([\"getent\", \"group\", \"\" .. $gid],",
    " {timeout: 60, env: $env})\n",
  "  if ($gr[\"exit_code\"] != 0 or $gr[\"utf8_lossy\"] == true\n",
  "      or $gr[\"stdout_truncated\"] == true) then\n",
  "    return nil\n",
  "  end"], "")
-- Two different proofs, because these are two different operations and the
-- suite refuses to conflate them. Restoring the caching ADDS a line above the
-- `return nil` and keeps it, so inside the block it is an insertion —
-- must_replace's proof is `the anchor is gone afterwards`, which an insertion
-- can never satisfy. Substituting the mutated block back into the file IS a
-- rewrite: the original block is not a substring of the mutated one, because
-- the inserted line splits it.
$mutated136 = must_insert($anchor136, "    return nil\n  end",
  "    $GROUP_MEMBERSHIP_CACHE[$key] = nil\n")
$m136 = $cm136 .. "/_bin/mutant-cache-nil.mix"
write_file($m136, must_replace($base136, $anchor136, $mutated136))
chmod($m136, 0o755)
$sh136a = shim136("fixed", $gid136)
$sh136b = shim136("mutant", $gid136)
$s136p1 = run_installer([$MIX, $fixed136, "--status"], {timeout: 300})
$s136p2 = run_installer([$MIX, $m136, "--status"], {timeout: 300})
$s136a = run_installer([$MIX, $fixed136, "--status"],
  {timeout: 300, env: {PATH: $sh136a["dir"] .. ":" .. env("PATH")}})
$s136b = run_installer([$MIX, $m136, "--status"],
  {timeout: 300, env: {PATH: $sh136b["dir"] .. ":" .. env("PATH")}})
$l136p1 = statusline129($s136p1)
$l136p2 = statusline129($s136p2)
$l136a = statusline129($s136a)
$l136b = statusline129($s136b)
$f = $f + ok("T136p1 premise: with no shim on PATH the fixed build answers the"
  .. " 0775 hooks directory cleanly, so the fixture is ordinary and any refusal"
  .. " below is caused by the injected getent failure",
  $s136p1["exit_code"] == 0 and contains($l136p1, "ABSENT")
    and contains($l136p1, "UNVERIFIED") == false,
  join(["rc=", "" .. $s136p1["exit_code"], " line=", sanitize($l136p1)], ""))
$f = $f + ok("T136p2 premise: and so does the mutant — caching a cannot-answer"
  .. " is invisible until one is produced, which is what makes T136b's refusal"
  .. " attributable to the caching and not to a generally broken build",
  $s136p2["exit_code"] == 0 and contains($l136p2, "ABSENT")
    and contains($l136p2, "UNVERIFIED") == false,
  join(["rc=", "" .. $s136p2["exit_code"], " line=", sanitize($l136p2)], ""))
$f = $f + ok("T136s the shim really did fire during both armed runs — without"
  .. " this the pair below measures two ordinary runs and passes for the wrong"
  .. " reason",
  exists($sh136a["sentinel"]) and exists($sh136b["sentinel"]),
  join(["fixed=", "" .. exists($sh136a["sentinel"]), " mutant=",
    "" .. exists($sh136b["sentinel"])], ""))
$f = $f + ok("T136a one getent failure does not become the run's verdict: the"
  .. " path walk's deferral of the final component is honest because the"
  .. " dedicated hooks-directory check asks again and gets a real answer",
  $s136a["exit_code"] == 0 and contains($l136a, "ABSENT")
    and contains($l136a, "UNVERIFIED") == false,
  join(["rc=", "" .. $s136a["exit_code"], " line=", sanitize($l136a)], ""))
$f = $f + ok("T136b and with the cannot-answer cached the SAME single failure"
  .. " refuses the whole run — the second ask reads back the first ask's"
  .. " outage instead of the identity source, so the deferral loses the"
  .. " question rather than re-posing it",
  $s136b["exit_code"] == 2
    and contains($s136b["stdout"] .. $s136b["stderr"], $DONE)
    and contains($s136b["stdout"] .. $s136b["stderr"], "did not answer")
    and contains($l136b, "UNVERIFIED"),
  join(["rc=", "" .. $s136b["exit_code"], " line=", sanitize($l136b)], ""))

-- T137..T140 — round forty's COLD REVIEW findings. Four defects, each of the
-- same species the arc exists to kill: a confident answer standing on evidence
-- that was never gathered. Two were the round's own doing (T137 widened the
-- predicate's blast radius to both arms, T139 was the new argument parser);
-- two were older and simply had not been looked at from this angle.
--
-- Every one gets the same treatment: a premise row where the fixture answers
-- ordinarily, the fixed build refusing, and a RECONSTRUCTED pre-fix build that
-- does not refuse. The third row is the load-bearing one — without it the pair
-- cannot tell "the fix works" from "some other guard caught the fixture", which
-- is the subsumption this suite has now hit three times.

-- T137 — `getent passwd` enumeration is not proof of anything unless it is
-- COMPLETE. A passwd source with enumeration disabled (sss and winbind ship
-- that way) answers with a short list rather than an error, so an account it
-- declines to enumerate is indistinguishable from one that does not exist. The
-- primary-member scan then finds nobody and returns `false` — "no other uid
-- holds this gid" — on a database it never fully read.
--
-- The switch file is redirected by REWRITING the build, not with a namespace:
-- under an unprivileged user namespace root-owned / and /tmp appear as the
-- unmapped overflow uid, which makes the path walk refuse for a reason that
-- has nothing to do with this fix and leaves both builds at exit 2. It is also
-- deliberately not an environment override in the product — a path that decides
-- whether an incomplete enumeration counts as proof is a path an attacker must
-- not be able to redirect.
--
-- `files` stays FIRST in the non-enumerable fixture so the enumeration is still
-- non-empty and the owner still resolves. Without that the run refuses on the
-- pre-existing empty-enumeration guard and the row passes for the wrong reason;
-- T137p is what proves it did not.
$rp137 = newrepo("t137-nss")
chmod($rp137 .. "/.git/hooks", 0o775)
$cm137 = $ROOT .. "/cmctl137"
mkdir($cm137 .. "/_bin")
mkdir($cm137 .. "/_etc")
copy($GATE, $cm137 .. "/_bin/check-public-hygiene.mix")
copy($HOOK, $cm137 .. "/_bin/hygiene-hook.mix")
chmod($cm137 .. "/_bin/check-public-hygiene.mix", 0o755)
chmod($cm137 .. "/_bin/hygiene-hook.mix", 0o755)
write_file($cm137 .. "/_etc/public-hygiene.conf.mix", join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp137 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$base137 = must_replace(read_file($INSTALL),
  "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cm137 .. "\"")
$nss137ok = $ROOT .. "/t137-nsswitch-enumerable.conf"
write_file($nss137ok, "# a comment line\npasswd: files db\ngroup: files\n")
$nss137no = $ROOT .. "/t137-nsswitch-partial.conf"
write_file($nss137no, "passwd: files sss\ngroup: files\n")
fn nssbuild137($src, $switch, $tag, $dir)
  $p = $dir .. "/_bin/install-" .. $tag .. ".mix"
  write_file($p, pin_nsswitch($src, $switch))
  chmod($p, 0o755)
  return $p
end
-- The pre-fix build is the file as it stood before this fix: scan, find
-- nobody, cache false, never ask whether the list was complete.
$pre137 = must_replace($base137,
  "  if passwd_enumerable() != true then\n    return nil\n  end\n", "")
$s137p = run_installer(
  [$MIX, nssbuild137($base137, $nss137ok, "nss-ok", $cm137), "--status"],
  {timeout: 300})
$s137a = run_installer(
  [$MIX, nssbuild137($base137, $nss137no, "nss-no", $cm137), "--status"],
  {timeout: 300})
$s137b = run_installer(
  [$MIX, nssbuild137($pre137, $nss137no, "nss-pre", $cm137), "--status"],
  {timeout: 300})
$l137p = statusline129($s137p)
$l137a = statusline129($s137a)
$l137b = statusline129($s137b)
$f = $f + ok("T137p premise: with a switch whose every passwd source enumerates,"
  .. " the 0775 hooks directory answers cleanly — so the fixture is ordinary,"
  .. " the enumeration is non-empty, and the refusal below is caused by the"
  .. " switch and not by the pre-existing empty-enumeration guard",
  $s137p["exit_code"] == 0 and contains($l137p, "ABSENT")
    and contains($l137p, "UNVERIFIED") == false,
  join(["rc=", "" .. $s137p["exit_code"], " line=", sanitize($l137p)], ""))
$f = $f + ok("T137a a passwd source that need not enumerate makes `nobody else"
  .. " holds this gid` unprovable, and the run says so instead of installing",
  $s137a["exit_code"] == 2 and contains($l137a, "UNVERIFIED")
    and contains($l137a, "hooks directory group writability"),
  join(["rc=", "" .. $s137a["exit_code"], " line=", sanitize($l137a)], ""))
$f = $f + ok("T137b and the pre-fix build reports the SAME directory ABSENT at"
  .. " exit 0 on the SAME switch — so T137a's refusal is the completeness check"
  .. " and nothing else in the path walk can account for it",
  $s137b["exit_code"] == 0 and contains($l137b, "ABSENT")
    and contains($l137b, "UNVERIFIED") == false,
  join(["rc=", "" .. $s137b["exit_code"], " line=", sanitize($l137b)], ""))

-- T138 — the commit OBJECT, not just the tree it selects. `--message` exists
-- precisely so a commit-msg hook can reject a leak in a commit message, which
-- makes a commit message an admitted policy surface; the ref audit scanned tag
-- bodies and trees and skipped commit bodies entirely. A value the commit-msg
-- hook would have refused therefore sailed through the audit of the very same
-- repository the moment it was already committed.
$rp138 = newrepo("t138-commit-body")
write_file($rp138 .. "/clean.txt", "nothing of interest here\n")
commit($rp138, "leak in the subject: " .. $NODE)
$g138a = run_argv([$MIX, $GATE, "--object-chain", $rp138, "refs/heads/main"],
  {timeout: 300})
$pre138 = $ROOT .. "/t138-gate-pre.mix"
write_file($pre138, must_replace(read_file($GATE), join([
  "    if contains($seen_bodies, $obj) == false then\n",
  "      push($seen_bodies, $obj)\n",
  "      $hits = concat($hits, scan_object($repo, $rules, $obj, $type))\n",
  "      $units = $units + 1\n",
  "    end\n",
  "    $tree_scan = scan_tip_tree("], ""), "    $tree_scan = scan_tip_tree("))
$g138b = run_argv([$MIX, $pre138, "--object-chain", $rp138, "refs/heads/main"],
  {timeout: 300})
$f = $f + ok("T138a a leak that exists ONLY in the commit message is found, and"
  .. " attributed to the commit body rather than to a file that does not"
  .. " contain it",
  $g138a["exit_code"] == 1
    and contains($g138a["stdout"] .. $g138a["stderr"], "commit-message"),
  join(["rc=", "" .. $g138a["exit_code"], " ",
    sanitize(substr($g138a["stdout"] .. $g138a["stderr"], 0, 200))], ""))
$f = $f + ok("T138b and without the commit-body scan the same repository is"
  .. " reported clean at exit 0 — the tree really is clean, which is exactly"
  .. " why scanning only the tree answered the wrong question",
  $g138b["exit_code"] == 0
    and contains($g138b["stdout"] .. $g138b["stderr"], "clean"),
  join(["rc=", "" .. $g138b["exit_code"], " ",
    sanitize(substr($g138b["stdout"] .. $g138b["stderr"], 0, 200))], ""))

-- T139 — round forty's own argument parser. It strips this program's two flags
-- from anywhere in the `--range` tail, but git defines everything after a bare
-- `--` as pathspecs, so a tracked file may legitimately be named `--from-hook`.
-- Eating it forwards a NARROWER rev-list selection than the operator asked for
-- and then reports the smaller answer as clean.
$rp139 = newrepo("t139-pathspec-tail")
write_file($rp139 .. "/safe.txt", "harmless\n")
$b139 = commit($rp139, "base")
write_file($rp139 .. "/--from-hook", "node is " .. $NODE .. "\n")
commit($rp139, "adds the awkwardly named file")
$g139a = run_argv([$MIX, $GATE, "--range", $rp139, $b139 .. "..HEAD", "--",
  "safe.txt", "--from-hook"], {timeout: 300})
$pre139 = $ROOT .. "/t139-gate-pre.mix"
write_file($pre139, must_replace(read_file($GATE),
  "  if $pathspec_tail == false and contains($KNOWN_FLAGS, $a) then",
  "  if contains($KNOWN_FLAGS, $a) then"))
$g139b = run_argv([$MIX, $pre139, "--range", $rp139, $b139 .. "..HEAD", "--",
  "safe.txt", "--from-hook"], {timeout: 300})
$f = $f + ok("T139a a pathspec after `--` that happens to spell one of this"
  .. " program's flags is forwarded to git, so the commit it selects is scanned"
  .. " and its leak found",
  $g139a["exit_code"] == 1
    and contains($g139a["stdout"] .. $g139a["stderr"], "scanning 1 commit"),
  join(["rc=", "" .. $g139a["exit_code"], " ",
    sanitize(substr($g139a["stdout"] .. $g139a["stderr"], 0, 200))], ""))
$f = $f + ok("T139b and with the separator ignored the same argv selects ZERO"
  .. " commits and reports clean — a smaller question answered confidently,"
  .. " which is the one thing this gate must never do",
  $g139b["exit_code"] == 0
    and contains($g139b["stdout"] .. $g139b["stderr"], "scanning 0 commit"),
  join(["rc=", "" .. $g139b["exit_code"], " ",
    sanitize(substr($g139b["stdout"] .. $g139b["stderr"], 0, 200))], ""))

-- T140 — `for-each-ref` reports a ref it cannot read as a WARNING on stderr,
-- exits 0, and omits that ref. Every other check in git_must() reads the exit
-- code, so the enumeration silently shrinks and the audit goes on to report
-- every tip it did see as clean: an answer about a smaller repository than the
-- operator asked about. Measured against git 2.55.0 with an empty ref file.
$rp140 = newrepo("t140-broken-ref")
write_file($rp140 .. "/a.txt", "hello\n")
commit($rp140, "one")
$conf140 = $ROOT .. "/t140.conf.mix"
write_file($conf140, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp140 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate140 = $ROOT .. "/t140-gate.mix"
write_file($gate140, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf140 .. "\""))
$g140p = run_argv([$MIX, $gate140, "--all"], {timeout: 600})
write_file($rp140 .. "/.git/refs/heads/bogus", "")
$g140a = run_argv([$MIX, $gate140, "--all"], {timeout: 600})
$pre140 = $ROOT .. "/t140-gate-pre.mix"
write_file($pre140, must_replace(read_file($gate140),
  "  $raw = git_quiet($repo, [\"for-each-ref\",",
  "  $raw = git($repo, [\"for-each-ref\","))
$g140b = run_argv([$MIX, $pre140, "--all"], {timeout: 600})
$f = $f + ok("T140p premise: with every ref readable the audit answers, so the"
  .. " refusal below is the broken ref and not the fixture",
  $g140p["exit_code"] == 0,
  join(["rc=", "" .. $g140p["exit_code"], " ",
    sanitize(substr($g140p["stdout"] .. $g140p["stderr"], 0, 200))], ""))
$f = $f + ok("T140a a ref git could not read makes the ref set unknowable, and"
  .. " the audit refuses instead of reporting the tips it happened to enumerate",
  $g140a["exit_code"] == 2
    and contains($g140a["stdout"] .. $g140a["stderr"], "could not fully"),
  join(["rc=", "" .. $g140a["exit_code"], " ",
    sanitize(substr($g140a["stdout"] .. $g140a["stderr"], 0, 240))], ""))
$f = $f + ok("T140b and reading that enumeration through the exit code alone"
  .. " reports the shrunken ref set clean at 0 — git said so on stderr and"
  .. " succeeded anyway, which is why the exit code is not the whole story",
  $g140b["exit_code"] == 0
    and contains($g140b["stdout"] .. $g140b["stderr"], "clean"),
  join(["rc=", "" .. $g140b["exit_code"], " ",
    sanitize(substr($g140b["stdout"] .. $g140b["stderr"], 0, 200))], ""))

-- T141..T143 — the RE-REVIEW of those four fixes came back with three
-- residuals, and all three were the same shape: the fix was real, and the
-- evidence it stood on had a second door. An action clause that stops an
-- enumeration the source list says is complete; a commit-body scan wired onto
-- the one code path most repositories never take; a stderr guard that an
-- inherited environment variable switches off. Round-two catches are the norm,
-- which is why the re-review is the load-bearing step and not a formality.

-- T141 — glibc consults the NSS action when a source is EXHAUSTED, enumeration
-- included, so `passwd: files [NOTFOUND=return] db` lists two enumerating
-- sources and still walks only the first. Deciding which of the action verbs
-- can halt an enumeration is precisely the guessing passwd_enumerable() already
-- declines to do about two `passwd:` lines, so any action clause is now a
-- refusal.
$rp141 = newrepo("t141-nss-action")
chmod($rp141 .. "/.git/hooks", 0o775)
$cm141 = $ROOT .. "/cmctl141"
mkdir($cm141 .. "/_bin")
mkdir($cm141 .. "/_etc")
copy($GATE, $cm141 .. "/_bin/check-public-hygiene.mix")
copy($HOOK, $cm141 .. "/_bin/hygiene-hook.mix")
chmod($cm141 .. "/_bin/check-public-hygiene.mix", 0o755)
chmod($cm141 .. "/_bin/hygiene-hook.mix", 0o755)
write_file($cm141 .. "/_etc/public-hygiene.conf.mix", join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp141 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$base141 = must_replace(read_file($INSTALL),
  "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cm141 .. "\"")
$nss141 = $ROOT .. "/t141-nsswitch-action.conf"
write_file($nss141, "passwd: files [NOTFOUND=return] db\ngroup: files\n")
-- The pre-fix build is the token loop as the FIRST fix left it: a bracketed
-- word waved through as decoration.
$pre141 = must_replace($base141,
  "    if contains($PASSWD_ENUMERATING_SOURCES, $w) == false then",
  "    if starts_with($w, \"[\") == false \\\n"
    .. "        and contains($PASSWD_ENUMERATING_SOURCES, $w) == false then")
$s141a = run_installer(
  [$MIX, nssbuild137($base141, $nss141, "action", $cm141), "--status"],
  {timeout: 300})
$s141b = run_installer(
  [$MIX, nssbuild137($pre141, $nss141, "action-pre", $cm141), "--status"],
  {timeout: 300})
$l141a = statusline129($s141a)
$l141b = statusline129($s141b)
$f = $f + ok("T141a an action clause between two enumerating sources is a"
  .. " refusal: both words are on the allowlist, and the enumeration still"
  .. " stops at the first one",
  $s141a["exit_code"] == 2 and contains($l141a, "UNVERIFIED")
    and contains($l141a, "hooks directory group writability"),
  join(["rc=", "" .. $s141a["exit_code"], " line=", sanitize($l141a)], ""))
$f = $f + ok("T141b and treating a bracketed word as decoration answers ABSENT"
  .. " at exit 0 on the same switch — the allowlist alone was never the whole"
  .. " question",
  $s141b["exit_code"] == 0 and contains($l141b, "ABSENT")
    and contains($l141b, "UNVERIFIED") == false,
  join(["rc=", "" .. $s141b["exit_code"], " line=", sanitize($l141b)], ""))

-- T142 — the commit-body scan lived in scan_object_chain(), and under `--all`
-- only TAGS went through it: HEAD and every refs/heads tip were handed straight
-- to the tree. So the audit read the commit message of a commit reached through
-- an annotated tag and skipped the commit message of main. A repository with no
-- tags at all — which is most of them — got the old answer.
$rp142 = newrepo("t142-branch-tip-body")
write_file($rp142 .. "/clean.txt", "the tree really is clean\n")
commit($rp142, "subject carries " .. $NODE)
$conf142 = $ROOT .. "/t142.conf.mix"
write_file($conf142, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp142 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate142 = $ROOT .. "/t142-gate.mix"
write_file($gate142, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf142 .. "\""))
$g142a = run_argv([$MIX, $gate142, "--all"], {timeout: 600})
$pre142 = $ROOT .. "/t142-gate-pre.mix"
$src142 = must_replace(read_file($gate142), join([
  "      $head_scan = scan_object_chain($repo, $RULES, $TEXT_FLAGS,",
    " $LIST_FLAGS,\n",
  "        $head_obj, $seen_trees, $seen_bodies, $repo .. \"/\")\n",
  "      $seen_trees = $head_scan[\"seen_trees\"]\n",
  "      $seen_bodies = $head_scan[\"seen_bodies\"]\n"], ""), join([
  "      $head_scan = scan_tip_tree($repo, $RULES, $TEXT_FLAGS, $LIST_FLAGS,\n",
  "        $head_obj, \"\", $seen_trees, $repo .. \"/\")\n",
  "      $seen_trees = $head_scan[\"seen_trees\"]\n"], ""))
write_file($pre142, must_replace($src142, join([
  "          $tip = scan_object_chain($repo, $RULES, $TEXT_FLAGS,",
    " $LIST_FLAGS,\n",
  "            $ref[\"object\"], $seen_trees, $seen_bodies, $repo .. \"/\")\n",
  "          $seen_trees = $tip[\"seen_trees\"]\n",
  "          $seen_bodies = $tip[\"seen_bodies\"]\n"], ""), join([
  "          $tip = scan_tip_tree($repo, $RULES, $TEXT_FLAGS, $LIST_FLAGS,\n",
  "            $ref[\"object\"], $ref[\"kind\"], $seen_trees, $repo .. \"/\")\n",
  "          $seen_trees = $tip[\"seen_trees\"]\n"], "")))
$g142b = run_argv([$MIX, $pre142, "--all"], {timeout: 600})
$f = $f + ok("T142a a leak in the tip commit's MESSAGE is found by --all in a"
  .. " repository with no tags — the path a repository without an annotated"
  .. " tag actually takes",
  $g142a["exit_code"] == 1
    and contains($g142a["stdout"] .. $g142a["stderr"], "commit-message"),
  join(["rc=", "" .. $g142a["exit_code"], " ",
    sanitize(substr($g142a["stdout"] .. $g142a["stderr"], 0, 240))], ""))
$f = $f + ok("T142b and sending HEAD and the branch tips straight to the tree"
  .. " prints clean at 0 — the body scan existed, and --all never reached it",
  $g142b["exit_code"] == 0
    and contains($g142b["stdout"] .. $g142b["stderr"], "clean"),
  join(["rc=", "" .. $g142b["exit_code"], " ",
    sanitize(substr($g142b["stdout"] .. $g142b["stderr"], 0, 240))], ""))

-- T143 — and the guard T140 installed is switched off by an environment
-- variable the caller supplies. Measured on git 2.55.0: with GIT_REF_PARANOIA=0
-- the same empty ref file is omitted from `for-each-ref` with NO warning at
-- all, so a guard that watches stderr sees a clean run over a shortened ref
-- set. GIT_REF_PARANOIA has no config equivalent, so it is pinned in the child
-- environment of every git this program runs.
$rp143 = newrepo("t143-ref-paranoia")
write_file($rp143 .. "/a.txt", "hello\n")
commit($rp143, "one")
write_file($rp143 .. "/.git/refs/heads/bogus", "")
$conf143 = $ROOT .. "/t143.conf.mix"
write_file($conf143, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp143 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate143 = $ROOT .. "/t143-gate.mix"
write_file($gate143, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf143 .. "\""))
$hostile143 = {GIT_REF_PARANOIA: "0"}
$g143a = run_argv([$MIX, $gate143, "--all"],
  {timeout: 600, env: $hostile143})
$pre143 = $ROOT .. "/t143-gate-pre.mix"
write_file($pre143, must_replace(read_file($gate143),
  "    {timeout: 600, max_output: 67108864, env: $GIT_ENV})\n  $out = git_must(",
  "    {timeout: 600, max_output: 67108864})\n  $out = git_must("))
$g143b = run_argv([$MIX, $pre143, "--all"],
  {timeout: 600, env: $hostile143})
$f = $f + ok("T143a a caller who sets GIT_REF_PARANOIA=0 does not get a shorter"
  .. " audit: the pinned child environment restores the warning and the run"
  .. " refuses",
  $g143a["exit_code"] == 2
    and contains($g143a["stdout"] .. $g143a["stderr"], "could not fully"),
  join(["rc=", "" .. $g143a["exit_code"], " ",
    sanitize(substr($g143a["stdout"] .. $g143a["stderr"], 0, 240))], ""))
$f = $f + ok("T143b and inheriting that variable makes git drop the ref in"
  .. " silence — stderr is empty, the guard never fires, and the shortened ref"
  .. " set is reported clean at 0",
  $g143b["exit_code"] == 0
    and contains($g143b["stdout"] .. $g143b["stderr"], "clean"),
  join(["rc=", "" .. $g143b["exit_code"], " ",
    sanitize(substr($g143b["stdout"] .. $g143b["stderr"], 0, 240))], ""))

-- T144..T148 — the THIRD review round. Two of the three fixes above came back
-- PARTIALLY FIXED again, and one row came back sound but under-pinned. The
-- pattern by now is stable: a fix closes the door it was aimed at, and the
-- review asks what else opens the same way. T144/T145 answer a criticism of the
-- SUITE rather than the gate — T142's mutation removed both --all paths at once,
-- so it proved the pair and neither member. T146/T147 are two more variables in
-- GIT_REF_PARANOIA's class. T148 removes a source from the enumeration
-- allowlist that was never entitled to be on it.

-- T144 — the branch-tip half of the --all body scan, on its own. HEAD sits on a
-- clean main; the leak is in the tip commit message of a SECOND branch. Only the
-- refs/heads walk can find it, so reverting that one call is enough to lose it
-- while the HEAD call stays fixed.
$rp144 = newrepo("t144-second-branch-body")
write_file($rp144 .. "/clean.txt", "clean\n")
commit($rp144, "main subject says nothing")
must($rp144, ["git", "checkout", "-q", "-b", "side"])
write_file($rp144 .. "/other.txt", "also clean\n")
commit($rp144, "side subject carries " .. $NODE)
must($rp144, ["git", "checkout", "-q", "main"])
$conf144 = $ROOT .. "/t144.conf.mix"
write_file($conf144, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp144 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate144 = $ROOT .. "/t144-gate.mix"
write_file($gate144, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf144 .. "\""))
$g144a = run_argv([$MIX, $gate144, "--all"], {timeout: 600})
$pre144 = $ROOT .. "/t144-gate-pre.mix"
write_file($pre144, must_replace(read_file($gate144), join([
  "          $tip = scan_object_chain($repo, $RULES, $TEXT_FLAGS,",
    " $LIST_FLAGS,\n",
  "            $ref[\"object\"], $seen_trees, $seen_bodies, $repo .. \"/\")\n",
  "          $seen_trees = $tip[\"seen_trees\"]\n",
  "          $seen_bodies = $tip[\"seen_bodies\"]\n"], ""), join([
  "          $tip = scan_tip_tree($repo, $RULES, $TEXT_FLAGS, $LIST_FLAGS,\n",
  "            $ref[\"object\"], $ref[\"kind\"], $seen_trees, $repo .. \"/\")\n",
  "          $seen_trees = $tip[\"seen_trees\"]\n"], "")))
$g144b = run_argv([$MIX, $pre144, "--all"], {timeout: 600})
$f = $f + ok("T144a a leak in the tip message of a branch that is NOT HEAD is"
  .. " found — the refs/heads walk reads bodies too, not just HEAD's",
  $g144a["exit_code"] == 1
    and contains($g144a["stdout"] .. $g144a["stderr"], "commit-message"),
  join(["rc=", "" .. $g144a["exit_code"], " ",
    sanitize(substr($g144a["stdout"] .. $g144a["stderr"], 0, 240))], ""))
$f = $f + ok("T144b and reverting the branch call ALONE loses it at exit 0,"
  .. " with the HEAD call still fixed — T142 removed both together and so"
  .. " proved neither",
  $g144b["exit_code"] == 0
    and contains($g144b["stdout"] .. $g144b["stderr"], "clean"),
  join(["rc=", "" .. $g144b["exit_code"], " ",
    sanitize(substr($g144b["stdout"] .. $g144b["stderr"], 0, 240))], ""))

-- T145 — and the HEAD half on its own, which needs a commit no local ref names:
-- a detached HEAD. The refs/heads walk cannot reach it, so this is the row the
-- comment about HEAD "even when detached" was always asserting without proof.
$rp145 = newrepo("t145-detached-head-body")
write_file($rp145 .. "/clean.txt", "clean\n")
commit($rp145, "main subject says nothing")
must($rp145, ["git", "checkout", "-q", "--detach"])
write_file($rp145 .. "/other.txt", "also clean\n")
commit($rp145, "detached subject carries " .. $NODE)
$conf145 = $ROOT .. "/t145.conf.mix"
write_file($conf145, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp145 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate145 = $ROOT .. "/t145-gate.mix"
write_file($gate145, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf145 .. "\""))
$g145a = run_argv([$MIX, $gate145, "--all"], {timeout: 600})
$pre145 = $ROOT .. "/t145-gate-pre.mix"
write_file($pre145, must_replace(read_file($gate145), join([
  "      $head_scan = scan_object_chain($repo, $RULES, $TEXT_FLAGS,",
    " $LIST_FLAGS,\n",
  "        $head_obj, $seen_trees, $seen_bodies, $repo .. \"/\")\n",
  "      $seen_trees = $head_scan[\"seen_trees\"]\n",
  "      $seen_bodies = $head_scan[\"seen_bodies\"]\n"], ""), join([
  "      $head_scan = scan_tip_tree($repo, $RULES, $TEXT_FLAGS, $LIST_FLAGS,\n",
  "        $head_obj, \"\", $seen_trees, $repo .. \"/\")\n",
  "      $seen_trees = $head_scan[\"seen_trees\"]\n"], "")))
$g145b = run_argv([$MIX, $pre145, "--all"], {timeout: 600})
$f = $f + ok("T145a a leak in the message of a DETACHED HEAD is found — no local"
  .. " ref names that commit, so the HEAD walk is the only path to it",
  $g145a["exit_code"] == 1
    and contains($g145a["stdout"] .. $g145a["stderr"], "commit-message"),
  join(["rc=", "" .. $g145a["exit_code"], " ",
    sanitize(substr($g145a["stdout"] .. $g145a["stderr"], 0, 240))], ""))
$f = $f + ok("T145b and reverting the HEAD call ALONE loses it at exit 0, with"
  .. " the branch call still fixed — the other half of T142's diagonal",
  $g145b["exit_code"] == 0
    and contains($g145b["stdout"] .. $g145b["stderr"], "clean"),
  join(["rc=", "" .. $g145b["exit_code"], " ",
    sanitize(substr($g145b["stdout"] .. $g145b["stderr"], 0, 240))], ""))

-- T146 — GIT_REFERENCE_BACKEND overrides extensions.refStorage, and a
-- files-format repository read as `reftable` has no refs at all: measured on git
-- 2.55.0, `for-each-ref` printed nothing, wrote ZERO bytes to stderr and exited
-- 0. What this row actually proves is narrower than the review claimed, and the
-- b arm is why: without the entry the run still refuses, because resolve_object
-- cannot resolve HEAD either. The silent-clean scenario does not reproduce. The
-- entry earns its place on the message rather than the exit code — a named
-- refusal an operator can act on, instead of an incidental one that happens to
-- fire first and would stop firing the moment a mode read refs before HEAD.
$rp146 = newrepo("t146-reference-backend")
write_file($rp146 .. "/a.txt", "leak " .. $IP .. "\n")
commit($rp146, "one")
$conf146 = $ROOT .. "/t146.conf.mix"
write_file($conf146, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp146 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate146 = $ROOT .. "/t146-gate.mix"
write_file($gate146, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf146 .. "\""))
$hostile146 = {GIT_REFERENCE_BACKEND: "reftable"}
$g146a = run_argv([$MIX, $gate146, "--all"], {timeout: 600, env: $hostile146})
$pre146 = $ROOT .. "/t146-gate-pre.mix"
write_file($pre146, must_replace(read_file($gate146),
  "\"GIT_SHALLOW_FILE\", \"GIT_GRAFT_FILE\", \"GIT_REFERENCE_BACKEND\",",
  "\"GIT_SHALLOW_FILE\", \"GIT_GRAFT_FILE\","))
$g146b = run_argv([$MIX, $pre146, "--all"], {timeout: 600, env: $hostile146})
$f = $f + ok("T146a an inherited GIT_REFERENCE_BACKEND is refused BY NAME: it"
  .. " redirects the ref store, and a files repo read as reftable enumerates no"
  .. " refs at all, silently and at exit 0",
  $g146a["exit_code"] == 2
    and contains($g146a["stdout"] .. $g146a["stderr"],
      "GIT_REFERENCE_BACKEND is set in the environment"),
  join(["rc=", "" .. $g146a["exit_code"], " ",
    sanitize(substr($g146a["stdout"] .. $g146a["stderr"], 0, 240))], ""))
$f = $f + ok("T146b and without the entry the same run refuses for an unrelated"
  .. " reason — HEAD stops resolving. Still a cannot-answer, so the claimed"
  .. " false clean does NOT reproduce; the fix buys a nameable refusal, and the"
  .. " row says only that",
  $g146b["exit_code"] == 2
    and contains($g146b["stdout"] .. $g146b["stderr"], "cannot resolve HEAD")
    and contains($g146b["stdout"] .. $g146b["stderr"],
      "GIT_REFERENCE_BACKEND is set in the environment") == false,
  join(["rc=", "" .. $g146b["exit_code"], " ",
    sanitize(substr($g146b["stdout"] .. $g146b["stderr"], 0, 240))], ""))

-- T147 — the pathspec variables ARE the silent-clean the previous row is not.
-- Measured in cmctl: `rev-list HEAD -- '_bin/*.mix'` selects 200 commits, and
-- with GIT_LITERAL_PATHSPECS=1 inherited it selects zero. An empty --range is
-- expressly accepted as legitimate, so the gate answers clean about a range it
-- never opened. These have a neutral value, so they are pinned off rather than
-- refused.
$rp147 = newrepo("t147-literal-pathspecs")
write_file($rp147 .. "/README", "nothing here\n")
$base147 = commit($rp147, "base")
mkdir($rp147 .. "/_bin")
write_file($rp147 .. "/_bin/x.mix", "$ADDR = \"" .. $IP .. "\"\n")
commit($rp147, "add a script")
$conf147 = $ROOT .. "/t147.conf.mix"
write_file($conf147, join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp147 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$gate147 = $ROOT .. "/t147-gate.mix"
write_file($gate147, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf147 .. "\""))
$hostile147 = {GIT_LITERAL_PATHSPECS: "1"}
$argv147 = [$MIX, $gate147, "--range", $rp147, $base147 .. "..HEAD",
  "--", "_bin/*.mix"]
$g147a = run_argv($argv147, {timeout: 600, env: $hostile147})
$pre147 = $ROOT .. "/t147-gate-pre.mix"
write_file($pre147, must_replace(read_file($gate147), join([
  "$GIT_ENV = {GIT_REF_PARANOIA: \"1\",\n",
  "            GIT_LITERAL_PATHSPECS: \"0\", GIT_NOGLOB_PATHSPECS: \"0\"}"], ""),
  "$GIT_ENV = {GIT_REF_PARANOIA: \"1\"}"))
$g147b = run_argv(concat([$MIX, $pre147], slice($argv147, 2, len($argv147))),
  {timeout: 600, env: $hostile147})
$f = $f + ok("T147a a glob pathspec still selects the leaking commit when the"
  .. " caller has set GIT_LITERAL_PATHSPECS=1 — the pin makes git answer the"
  .. " question git answers by default",
  $g147a["exit_code"] == 1,
  join(["rc=", "" .. $g147a["exit_code"], " ",
    sanitize(substr($g147a["stdout"] .. $g147a["stderr"], 0, 240))], ""))
$f = $f + ok("T147b and inheriting it selects ZERO commits, which the gate is"
  .. " right to treat as a legitimate empty range and wrong to have been asked"
  .. " — clean at 0 over a range it never opened",
  $g147b["exit_code"] == 0
    and contains($g147b["stdout"] .. $g147b["stderr"], "clean"),
  join(["rc=", "" .. $g147b["exit_code"], " ",
    sanitize(substr($g147b["stdout"] .. $g147b["stderr"], 0, 240))], ""))

-- T148 — `systemd` was on the enumerating-sources allowlist, and is not a member
-- of it. nss-systemd keeps no database; it forwards to userdb Varlink providers,
-- and systemd's User/Group API makes enumeration OPTIONAL for a provider while
-- lookup stays mandatory. So an account can be resolvable by uid and absent from
-- `getent passwd` — the exact short-list-at-exit-0 shape the predicate exists to
-- refuse. That `getent passwd` and `userdbctl user` happen to agree on all 87
-- names on this host is a fact about this host, not about the source.
$rp148 = newrepo("t148-nss-systemd")
chmod($rp148 .. "/.git/hooks", 0o775)
$cm148 = $ROOT .. "/cmctl148"
mkdir($cm148 .. "/_bin")
mkdir($cm148 .. "/_etc")
copy($GATE, $cm148 .. "/_bin/check-public-hygiene.mix")
copy($HOOK, $cm148 .. "/_bin/hygiene-hook.mix")
chmod($cm148 .. "/_bin/check-public-hygiene.mix", 0o755)
chmod($cm148 .. "/_bin/hygiene-hook.mix", 0o755)
write_file($cm148 .. "/_etc/public-hygiene.conf.mix", join([
  "public_hygiene: {\n",
  "  schema_version: 1,\n",
  "  repos: [\"" .. $rp148 .. "\"],\n",
  "  static_rules: " .. $FIXTURE_RULES .. ",\n",
  "  generic_node_names: [],\n",
  "  guidance: { ipv4: \"a\", domain: \"b\", node: \"c\", home: \"d\" }\n",
  "}\n"
], ""))
$base148 = must_replace(read_file($INSTALL),
  "$CMCTL = locate_hub()", "$CMCTL = \"" .. $cm148 .. "\"")
$nss148 = $ROOT .. "/t148-nsswitch-systemd.conf"
write_file($nss148, "passwd: files systemd\ngroup: files\n")
$pre148 = must_replace($base148,
  "$PASSWD_ENUMERATING_SOURCES = [\"files\", \"altfiles\", \"db\"]",
  "$PASSWD_ENUMERATING_SOURCES = [\"files\", \"altfiles\", \"systemd\", \"db\"]")
$s148a = run_installer(
  [$MIX, nssbuild137($base148, $nss148, "nss-systemd", $cm148), "--status"],
  {timeout: 300})
$s148b = run_installer(
  [$MIX, nssbuild137($pre148, $nss148, "nss-systemd-pre", $cm148), "--status"],
  {timeout: 300})
$l148a = statusline129($s148a)
$l148b = statusline129($s148b)
$f = $f + ok("T148a `passwd: files systemd` is a refusal — nss-systemd forwards"
  .. " to providers that may decline to enumerate while still resolving by uid,"
  .. " so a short list is indistinguishable from a complete one",
  $s148a["exit_code"] == 2 and contains($l148a, "UNVERIFIED")
    and contains($l148a, "hooks directory group writability"),
  join(["rc=", "" .. $s148a["exit_code"], " line=", sanitize($l148a)], ""))
$f = $f + ok("T148b and leaving systemd on the allowlist answers ABSENT at exit"
  .. " 0 on the same switch — a confident 'no other uid holds this gid' from an"
  .. " enumeration nobody promised was whole",
  $s148b["exit_code"] == 0 and contains($l148b, "ABSENT")
    and contains($l148b, "UNVERIFIED") == false,
  join(["rc=", "" .. $s148b["exit_code"], " line=", sanitize($l148b)], ""))

-- T149..T151 — round forty-one. --all's violation count was one undifferentiated
-- number: a leak carried only by a throwaway branch tip and a leak carried by a
-- release tag printed identically, so the first thing an operator would sort on
-- — which ref do I have to deal with? — could not be read off the output. (Which
-- of those refs is PUSHED is a separate question the gate never asks; it reports
-- the tips it scanned, not a remote's contents.)
-- T149 pins that the attribution exists, T150 that it is complete rather than
-- first-past-the-post, T151 that the object kinds are now named apart.

-- T149 — a violation names the ref tips that reach it, and the run ends with a
-- per-ref tally.
$rp149 = newrepo("t149-ref-attribution")
write_file($rp149 .. "/clean.txt", "nothing of interest here\n")
commit($rp149, "subject carries " .. $NODE)
$conf149 = $ROOT .. "/t149.conf.mix"
conf_for($conf149, $rp149, "")
$gate149 = $ROOT .. "/t149-gate.mix"
write_file($gate149, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf149 .. "\""))
$g149a = run_argv([$MIX, $gate149, "--all"], {timeout: 600})
-- The single-point revert: the walks still report what they reached, nothing
-- records it. That is the state the gate was in before this round — the hit had
-- no ref, not a wrong one.
$pre149 = $ROOT .. "/t149-gate-pre.mix"
write_file($pre149, must_replace(read_file($gate149), join([
  "fn note_refs($unit_refs, $repo, $reached, $name)\n",
  "  for each $u in $reached\n"], ""), join([
  "fn note_refs($unit_refs, $repo, $reached, $name)\n",
  "  return $unit_refs\n",
  "  for each $u in $reached\n"], "")))
$g149b = run_argv([$MIX, $pre149, "--all"], {timeout: 600})
$f = $f + ok("T149a a violation is attributed to the refs that reach it, and a"
  .. " BY REF tally closes the run",
  $g149a["exit_code"] == 1
    and contains($g149a["stdout"], "via tip(s): HEAD, refs/heads/main")
    and contains($g149a["stdout"], "BY REF")
    and contains($g149a["stdout"], "refs/heads/main: 1"),
  join(["rc=", "" .. $g149a["exit_code"], " ",
    sanitize(substr($g149a["stdout"], 0, 400))], ""))
$f = $f + ok("T149b and with nothing recording what each ref reached the SAME"
  .. " violation is still reported at exit 1 with no ref at all — the finding"
  .. " was never the missing part, the attribution was",
  $g149b["exit_code"] == 1
    and contains($g149b["stdout"], "VIOLATIONS")
    and contains($g149b["stdout"], "      via tip(s): ") == false
    and contains($g149b["stdout"], "BY REF") == false,
  join(["rc=", "" .. $g149b["exit_code"], " ",
    sanitize(substr($g149b["stdout"], 0, 400))], ""))

-- T150 — attribution must survive dedupe. The commit body is scanned ONCE, but
-- three tips reach it; naming only the tip that happened to arrive first would
-- report a tag's content as a branch's problem alone.
$rp150 = newrepo("t150-aliased-unit")
write_file($rp150 .. "/clean.txt", "nothing of interest here\n")
commit($rp150, "subject carries " .. $NODE)
must($rp150, ["git", "tag", "-a", "v1", "-m", "release v1"])
$conf150 = $ROOT .. "/t150.conf.mix"
conf_for($conf150, $rp150, "")
$gate150 = $ROOT .. "/t150-gate.mix"
write_file($gate150, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf150 .. "\""))
$g150a = run_argv([$MIX, $gate150, "--all"], {timeout: 600})
$pre150 = $ROOT .. "/t150-gate-pre.mix"
-- The comment line is part of the anchor: all three arms of the chain walk now
-- carry the identical four lines, so without it the rewrite has three sites and
-- must_replace refuses. Anchoring on the commit arm is also the honest scope —
-- the leak under test is a commit message.
write_file($pre150, must_replace(read_file($gate150), join([
  "    -- bodies were the omission.\n",
  "    push($reached, $obj)\n",
  "    if contains($seen_bodies, $obj) == false then\n",
  "      push($seen_bodies, $obj)\n",
  "      $hits = concat($hits, scan_object($repo, $rules, $obj, $type))\n"], ""),
  join([
  "    -- bodies were the omission.\n",
  "    if contains($seen_bodies, $obj) == false then\n",
  "      push($seen_bodies, $obj)\n",
  "      push($reached, $obj)\n",
  "      $hits = concat($hits, scan_object($repo, $rules, $obj, $type))\n"], "")))
$g150b = run_argv([$MIX, $pre150, "--all"], {timeout: 600})
$f = $f + ok("T150a one commit body reached by HEAD, a branch and a tag names"
  .. " all three, though it was scanned once",
  $g150a["exit_code"] == 1
    and contains($g150a["stdout"], "via tip(s): HEAD, refs/heads/main, refs/tags/v1"),
  join(["rc=", "" .. $g150a["exit_code"], " ",
    sanitize(substr($g150a["stdout"], 0, 400))], ""))
$f = $f + ok("T150b and recording only the first arrival credits HEAD alone —"
  .. " the tag disappears from a report whose whole purpose is to say which"
  .. " tips carry the finding",
  $g150b["exit_code"] == 1
    and contains($g150b["stdout"], "via tip(s): HEAD\n")
    and contains($g150b["stdout"], "refs/tags/v1") == false,
  join(["rc=", "" .. $g150b["exit_code"], " ",
    sanitize(substr($g150b["stdout"], 0, 400))], ""))

-- T151 — the object kind is a function of the object, not of the call site.
-- Every body the ref walk scanned was labelled "object-body" — tag, commit and
-- blob alike — while --range called the identical commit object a
-- "commit-message", so the audit and the push hook described one finding by two
-- names and the audit's name said nothing about what it had read.
$rp151 = newrepo("t151-body-kinds")
write_file($rp151 .. "/clean.txt", "nothing of interest here\n")
commit($rp151, "subject carries " .. $NODE)
must($rp151, ["git", "tag", "-a", "v1", "-m", "cut for " .. $NODE])
$conf151 = $ROOT .. "/t151.conf.mix"
conf_for($conf151, $rp151, "")
$gate151 = $ROOT .. "/t151-gate.mix"
write_file($gate151, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf151 .. "\""))
$g151a = run_argv([$MIX, $gate151, "--all"], {timeout: 600})
$pre151 = $ROOT .. "/t151-gate-pre.mix"
write_file($pre151, must_replace(read_file($gate151), join([
  "fn body_kind($type)\n",
  "  if $type == \"tag\" then\n"], ""), join([
  "fn body_kind($type)\n",
  "  return \"object-body\"\n",
  "  if $type == \"tag\" then\n"], "")))
$g151b = run_argv([$MIX, $pre151, "--all"], {timeout: 600})
$f = $f + ok("T151a a tag body and a commit message in the same run are named"
  .. " apart",
  $g151a["exit_code"] == 1
    and contains($g151a["stdout"], "tag-body")
    and contains($g151a["stdout"], "commit-message"),
  join(["rc=", "" .. $g151a["exit_code"], " ",
    sanitize(substr($g151a["stdout"], 0, 400))], ""))
-- The mutant collapses body_kind for EVERY caller, which is the ref walk's
-- pre-fix state and is NOT --range's: --range always said "commit-message", and
-- post-fix it still does, so that path's output never moved and there is
-- nothing there for a mutant to fail on. The claim is therefore scoped to the
-- --all run this row actually makes. Round forty-one's review was right that an
-- unscoped claim would have been asserting cross-mode stability it never
-- exercised; the answer is a narrower sentence, not a row whose diagonal cannot
-- exist ([[2026-07-27-mutant-anchors-and-subsumed-fixes]]).
$f = $f + ok("T151b and one constant for every object type reports both of"
  .. " THESE as \"object-body\" — the state of the ref walk before this round,"
  .. " which is the only path this row runs",
  $g151b["exit_code"] == 1
    and contains($g151b["stdout"], "object-body")
    and contains($g151b["stdout"], "tag-body") == false
    and contains($g151b["stdout"], "commit-message") == false,
  join(["rc=", "" .. $g151b["exit_code"], " ",
    sanitize(substr($g151b["stdout"], 0, 400))], ""))

-- T152 — a pardon must not be silent. For forty-one rounds the allowlist was
-- empty, so "pardoned" meant "hypothetically waived" and printing nothing cost
-- nothing. The first real entries are node names frozen in two published .mix
-- tags, waived because the history rewrite was declined — not because they are
-- false positives. A gate that quietly subtracts those from its count turns a
-- recorded decision into an omission: the operator reads a smaller number with
-- no way to learn what stopped being counted. The pardon still has to keep the
-- run CLEAN, which is why the mutant here is not "stop pardoning" (T10a already
-- pins that) but "pardon and say nothing", the state this round replaced.
$r152 = newrepo("t152-pardon-is-announced")
write_file($r152 .. "/leak.txt", "peer " .. $NODE .. "\n")
commit($r152, "t152")
$allow152 = $ROOT .. "/t152.allow.conf.mix"
write_file($allow152, "public_hygiene_allow: { schema_version: 1, exceptions: [] }\n")
$g152src = must_replace(read_file($GATE),
  $ALLOW_ANCHOR, "\"" .. $allow152 .. "\"")
$gate152 = $ROOT .. "/gate-t152.mix"
write_file($gate152, $g152src)
$fp152 = fingerprints(run_argv([$MIX, $gate152, "--tree", $r152,
  "--print-fingerprints"], {timeout: 300})["stdout"])[0]
write_file($allow152, join([
  "public_hygiene_allow: { schema_version: 1, exceptions: [\n",
  "  { fingerprint: \"" .. $fp152 .. "\", reason: \"t152 decided, not absent\" }\n",
  "] }\n"
], ""))
$g152a = run_argv([$MIX, $gate152, "--tree", $r152], {timeout: 300})
$f = $f + ok("T152a a pardoned violation is reported as pardoned — count,"
  .. " exception count and the reason — while the run still exits clean",
  $g152a["exit_code"] == 0
    and contains($g152a["stdout"], "PARDONED (1 violation(s) by 1 standing"
      .. " exception(s))")
    and contains($g152a["stdout"],
      "1x  [exceptions] t152 decided, not absent"),
  join(["rc=", "" .. $g152a["exit_code"], " ",
    sanitize(substr($g152a["stdout"], 0, 400))], ""))
$gate152b = $ROOT .. "/gate-t152b.mix"
write_file($gate152b, must_replace($g152src,
  "if $pardoned_n > 0 then\n", "if false then\n"))
$g152b = run_argv([$MIX, $gate152b, "--tree", $r152], {timeout: 300})
$f = $f + ok("T152b and a gate that waives it in silence still exits 0 — the"
  .. " leak is gone from the output with nothing saying it was ever there",
  $g152b["exit_code"] == 0
    and contains($g152b["stdout"], "PARDONED") == false
    and contains($g152b["stdout"], "clean"),
  join(["rc=", "" .. $g152b["exit_code"], " ",
    sanitize(substr($g152b["stdout"], 0, 400))], ""))

-- T153 — operational docs (_doc/_plan-style .md) are refused as PUBLISHED
-- PATHS, with docs/_man/ — the live manual `mix man` reads — as the one
-- sanctioned exception. Added 2026-07-28, the day six of them were found
-- already published in a guarded repo: prose in CLAUDE.md had banned this
-- since the repo split, and prose alone failed exactly the way it failed for
-- mesh identity in 2026-05-29.
$r153 = hook_repo("t153")
$p153 = $r153["path"]
mkdir($p153 .. "/_doc")
write_file($p153 .. "/_doc/2026-07-28-note.md", "nothing mesh-private here\n")
must($p153, ["git", "add", "-A"])
$f = $f + shape("T153a a _doc/*.md commit is blocked", 1, $p153,
  ["git", "commit", "-q", "-m", "operational doc"])
$ls153 = run_argv(["git", "-C", $p153, "ls-tree", "-r", "--name-only", "HEAD"],
  {timeout: 300})
$f = $f + ok("T153b premise: the doc is not in HEAD's tree",
  $ls153["exit_code"] == 0
    and contains($ls153["stdout"], "_doc/") == false
    and trim($ls153["stdout"]) != "",
  "" .. $ls153["exit_code"] .. " " .. sanitize($ls153["stdout"]))
$rm153 = run_argv(["rm", "-rf", $p153 .. "/_doc"], {timeout: 60})
$f = $f + ok("T153c premise: the fixture doc is gone", $rm153["ok"] == true,
  sanitize($rm153["stderr"]))
must($p153, ["git", "add", "-A"])
-- The sanctioned exception, and a non-markdown underscore-dir file that is
-- none of this rule's business (src/_etc/ ships systemd units today).
mkdir($p153 .. "/docs/_man")
write_file($p153 .. "/docs/_man/overview.md", "reference manual page\n")
mkdir($p153 .. "/src/_etc")
write_file($p153 .. "/src/_etc/probe.conf", "key=value\n")
must($p153, ["git", "add", "-A"])
$f = $f + shape("T153d docs/_man/*.md and a non-md _*/ file commit clean", 0,
  $p153, ["git", "commit", "-q", "-m", "manual page and unit file"])
-- The exemption must be judged per segment, or `_plan/docs/_man/` smuggles
-- any doc past it.
mkdir($p153 .. "/_plan/docs/_man")
write_file($p153 .. "/_plan/docs/_man/smuggle.md", "still an operational doc\n")
must($p153, ["git", "add", "-A"])
$f = $f + shape("T153e the docs/_man exemption cannot be smuggled under _plan/",
  1, $p153, ["git", "commit", "-q", "-m", "smuggled"])
$rm153b = run_argv(["rm", "-rf", $p153 .. "/_plan"], {timeout: 60})
$f = $f + ok("T153f premise: the smuggle fixture is gone", $rm153b["ok"] == true,
  sanitize($rm153b["stderr"]))
must($p153, ["git", "add", "-A"])
-- A NESTED underscore dir already IN a tree — the --tree/--all form, entered
-- the same way real ones entered cos: --no-verify.
mkdir($p153 .. "/desktop/_plan")
write_file($p153 .. "/desktop/_plan/runsheet.md", "phased plan\n")
must($p153, ["git", "add", "-A"])
must($p153, ["git", "commit", "-q", "--no-verify", "-m", "hook bypassed"])
$t153 = gate(["--tree", $p153, "HEAD"])
$f = $f + ok("T153g --tree finds a nested _plan doc already in a tree",
  $t153["code"] == 1 and contains($t153["out"], "underscore_dir_doc")
    and contains($t153["out"], "desktop/_plan/runsheet.md"),
  "" .. $t153["code"] .. " " .. sanitize(substr($t153["out"], 0, 400)))
-- And the content rules are not what found it: the same tree minus the one
-- offending PATH scans clean, so T153g cannot be passing on a body hit.
$rm153c = run_argv(["rm", "-rf", $p153 .. "/desktop"], {timeout: 60})
$f = $f + ok("T153h premise: the nested fixture is gone", $rm153c["ok"] == true,
  sanitize($rm153c["stderr"]))
must($p153, ["git", "add", "-A"])
must($p153, ["git", "commit", "-q", "--no-verify", "-m", "offender removed"])
$t153h = gate(["--tree", $p153, "HEAD"])
$f = $f + ok("T153i the same tree without it is clean", $t153h["code"] == 0,
  "" .. $t153h["code"] .. " " .. sanitize(substr($t153h["out"], 0, 400)))
-- T153d proved a combined commit exits 0, which a scanner that never SAW the
-- manual page also satisfies. Two rows close that: the page is genuinely in
-- the tree the clean verdicts were issued over, and an _man dir NOT under
-- docs/ is caught — so the pathname pass demonstrably reads _man-shaped
-- paths, and the exemption is a judgement about docs/_man specifically, not
-- an omission.
$ls153j = run_argv(["git", "-C", $p153, "ls-tree", "-r", "--name-only",
  "HEAD"], {timeout: 300})
$f = $f + ok("T153j premise: docs/_man/overview.md is in the clean tree",
  $ls153j["exit_code"] == 0
    and contains($ls153j["stdout"], "docs/_man/overview.md"),
  "" .. $ls153j["exit_code"] .. " " .. sanitize($ls153j["stdout"]))
mkdir($p153 .. "/docsx/_man")
write_file($p153 .. "/docsx/_man/manual.md", "not the sanctioned location\n")
must($p153, ["git", "add", "-A"])
$f = $f + shape("T153k an _man dir NOT under docs/ is still caught", 1, $p153,
  ["git", "commit", "-q", "-m", "wrong parent"])
$rm153d = run_argv(["rm", "-rf", $p153 .. "/docsx"], {timeout: 60})
$f = $f + ok("T153l premise: the wrong-parent fixture is gone",
  $rm153d["ok"] == true, sanitize($rm153d["stderr"]))
must($p153, ["git", "add", "-A"])
-- A trailing newline is LEGAL in a git filename, and `$` in the in-process
-- engine is absolute end-of-text — so `_doc/plan.md\n` dodged a bare
-- `[.]md$` entirely (cold review, 2026-07-28). The rule now eats trailing
-- whitespace before the anchor.
mkdir($p153 .. "/_doc")
write_file($p153 .. "/_doc/plan.md\n", "dodging by filename costume\n")
must($p153, ["git", "add", "-A"])
$f = $f + shape("T153m a trailing-newline filename cannot dodge the"
  .. " extension test", 1, $p153, ["git", "commit", "-q", "-m", "costume"])
-- The path policy's rule id lives outside $RULES, so config validation alone
-- cannot see a configured rule reusing it — and a shared id makes two
-- different rules' hits share fingerprints, so one pardon covers both.
-- Refused at startup, exit 2.
$conf153 = $ROOT .. "/t153-dup.conf.mix"
write_file($conf153, join([
  "public_hygiene: {",
  "  schema_version: 1,",
  "  repos: [],",
  "  static_rules: [",
  "    {id: \"underscore_dir_doc\", pattern: \"zzz\", note: \"collides\"}",
  "  ],",
  "  generic_node_names: [],",
  "  guidance: {ipv4: \"x\", domain: \"x\", node: \"x\", home: \"x\"}",
  "}",
  ""
], "\n"))
$g153n = $ROOT .. "/gate-t153n.mix"
write_file($g153n, must_replace(read_file($GATE),
  "$CMCTL .. \"/_etc/public-hygiene.conf.mix\"", "\"" .. $conf153 .. "\""))
$r153n = run_argv([$MIX, $g153n, "--tree", $p153], {timeout: 300})
$f = $f + ok("T153n a configured rule reusing the reserved id is refused at 2",
  $r153n["exit_code"] == 2
    and contains($r153n["stdout"] .. $r153n["stderr"], "underscore_dir_doc"),
  "" .. $r153n["exit_code"] .. " "
    .. sanitize(substr($r153n["stdout"] .. $r153n["stderr"], 0, 400)))
-- T153j+T153k together still tolerate one mutant: an implementation that
-- skips the whole docs/ SUBTREE passes both (the exempt page is under docs/,
-- and docsx/ is not). An underscore dir under docs/ that is not _man pins the
-- exemption to docs/_man specifically.
$rm153e = run_argv(["rm", "-rf", $p153 .. "/_doc"], {timeout: 60})
$f = $f + ok("T153o premise: the costume fixture is gone",
  $rm153e["ok"] == true, sanitize($rm153e["stderr"]))
must($p153, ["git", "add", "-A"])
mkdir($p153 .. "/docs/_plan")
write_file($p153 .. "/docs/_plan/leak.md", "underscore dir under docs\n")
must($p153, ["git", "add", "-A"])
$f = $f + shape("T153p the exemption is docs/_man, not the docs/ subtree", 1,
  $p153, ["git", "commit", "-q", "-m", "docs subtree is not a pardon"])

-- T123 — round twenty-nine measured all nine live hook mtimes moving while the
-- old T52b compared bytes only and stayed green. This is the suite-wide
-- interlock, not another instance check: every real repo comes from the real
-- config, its actual hooks path is resolved the same way as the installer, and
-- every hook must retain content, mode, file identity, type and mtime. An
-- absent hook is not a legitimate state to tolerate: there is then no baseline
-- against which this suite can prove non-mutation, and the missing path is
-- itself operator state that needs fixing before this harness can honestly
-- pass. Each failure names the offending path.
--
-- WHICH clause does the work was measured, not assumed, because the first
-- attempt to state it here was wrong. The installer replaces a hook by writing
-- a new file and renaming it over the old one, so a rewrite moves BOTH the
-- inode and the mtime, and the two clauses are independently sufficient:
-- deleting the mtime comparison still reds (r29b, via "file identity changed")
-- and deleting the ino/dev comparison still reds (r29f, via mtime). Only with
-- both gone does the guard go green while the hooks are rewritten underneath
-- it (r29g) — that green is the blind spot the old content-only T52b sat in
-- for twenty-eight rounds. Neither clause is redundant: identity is what sees
-- a replace-by-rename, mtime is what sees an in-place rewrite that keeps the
-- inode. Do not "simplify" this by dropping either one.
$changed123 = fleet_hooks_changed($REAL_CFG["repos"], $FLEET_HOOKS_BEFORE)
$f = $f + ok("T123 the suite leaves every real fleet hook byte-, identity- and mtime-untouched",
  len($changed123) == 0, join($changed123, "; "))

print("")
if $f > 0 then
  -- The tree STAYS on a failure: every repo, hook and fixture that produced
  -- the failing row is in it, and that is the whole of the evidence.
  print($f .. " FAILURE(S) — fixtures kept at " .. $ROOT)
  exit(1)
end
-- ...and goes on a pass. Each run builds ~100 git repositories under a
-- pid-named root and, until round twenty-three, left every one of them behind:
-- 274 abandoned trees had accumulated by then and they exhausted /tmp's INODES
-- (1,048,576 of them, 100% used, 42 GB still free) — which surfaced as "no
-- space left on device" in the middle of a mutant run, on a filesystem with
-- plenty of space. A suite that has to be run repeatedly, and is, cannot leave
-- a mess proportional to how often it is run. Best-effort and noisy about it:
-- a cleanup that failed and said nothing is how the mess started.
$root_now = nil
try
  $root_now = stat($ROOT, {follow_symlinks: false})
catch $root_gone
end
$root_same = $root_now != nil and $root_now["is_dir"] \
  and $root_now["is_symlink"] == false and $root_now["uid"] == uid() \
  and $root_now["perm"] == 0o700 and $root_now["dev"] == $ROOT_STATE["dev"] \
  and $root_now["ino"] == $ROOT_STATE["ino"]
$rm = {ok: false}
if $root_same then
  $rm = run_argv(["rm", "-rf", $ROOT], {timeout: 300})
end
if $root_same == false or $rm["ok"] != true or is_dir($ROOT) then
  print("WARNING: could not remove this run's fixtures at " .. $ROOT
    .. " — ownership/identity was not proved at cleanup or rm failed; inspect"
    .. " before deleting by hand. It is worth doing: each run makes about a"
    .. " hundred git repositories and /tmp runs out of inodes long before it"
    .. " runs out of space")
end
print("all probes passed")
exit(0)
