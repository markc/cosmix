-- ---------------------------------------------------------------- helpers

function stop_gate($msg)
    print("check-web-palette: " .. $msg)
    exit(2)
end

function num($s)
    $n = to_number($s)
    if $n == nil then
        return nil
    end
    return round($n, 4)
end

function colour_str($v)
    if $v == nil then
        return "(absent)"
    end
    $s = "L" .. ("" .. $v[0]) .. " C" .. ("" .. $v[1]) .. " H" .. ("" .. $v[2])
    if length($v) == 4 then
        $s = $s .. " A" .. ("" .. $v[3])
    end
    return $s
end

function same3($a, $b)
    return $a != nil and $b != nil and $a[0] == $b[0] and $a[1] == $b[1] and $a[2] == $b[2]
end

function same4($a, $b)
    return $a != nil and $b != nil and length($a) == 4 and length($b) == 4 and same3($a, $b) and $a[3] == $b[3]
end

function exact_set($got, $want)
    if length($got) != length($want) then
        return false
    end
    for each $set_item in $want
        if not contains($got, $set_item) then
            return false
        end
    end
    return true
end

function norm_selector($s)
    return trim(re_replace($s, "\\s+", " "))
end

-- Opaque OKLCH means exactly three components and a closing parenthesis. Alpha,
-- a fourth component, or any trailing text makes this parser return nil.
function parse_oklch($value)
    $m = re_find(trim($value), "^oklch\\(\\s*([0-9.]+)%\\s+([0-9.]+)\\s+([0-9.]+)\\s*\\)$")
    if length($m) != 1 then
        return nil
    end
    $g = $m[0].groups
    $l = num($g[0])
    $c = num($g[1])
    $h = num($g[2])
    if $l == nil or $c == nil or $h == nil then
        return nil
    end
    return [$l, $c, $h]
end

-- Glow is the one explicitly alpha-bearing family. It has its own fully anchored
-- grammar rather than weakening parse_oklch's opaque contract.
function parse_oklch_alpha($value)
    $m = re_find(trim($value), "^oklch\\(\\s*([0-9.]+)%\\s+([0-9.]+)\\s+([0-9.]+)\\s*/\\s*([0-9.]+)\\s*\\)$")
    if length($m) != 1 then
        return nil
    end
    $g = $m[0].groups
    $l = num($g[0])
    $c = num($g[1])
    $h = num($g[2])
    $a = num($g[3])
    if $l == nil or $c == nil or $h == nil or $a == nil then
        return nil
    end
    return [$l, $c, $h, $a]
end

function mapped_role_fields()
    $out = []
    for each $mapped_role in $ROLES
        push($out, $mapped_role[0])
    end
    return $out
end

function delivery_of($sel, $dark_media)
    for each $delivery_candidate in $DELIVERIES
        if $delivery_candidate.sel == $sel and $delivery_candidate.dark_media == $dark_media then
            return $delivery_candidate
        end
    end
    return nil
end

function is_watched($name)
    for each $watched_role in $ROLES
        if $name == $watched_role[1] then return true end
    end
    for each $watched_status in $STATUS
        if $name == $watched_status[1] then return true end
    end
    if $name == "--accent-fg" or $name == "--accent-glow" then return true end
    if $name == $ONIMAGE_FG or $name == $ONIMAGE_GLOW then return true end
    for each $watched_image in $ONIMAGE_OPAQUE
        if $name == $watched_image[1] then return true end
    end
    for each $pinned_name in keys($PINNED["ocean/light"])
        if $name == $pinned_name then return true end
    end
    if $name == "--sw-bg" or $name == "--sw-fg" or $name == "--sw-ac" then return true end
    return false
end

function has_watched($decls)
    for each $decl_name in keys($decls)
        if is_watched($decl_name) then return true end
    end
    return false
end

function count_text($text, $needle)
    if $needle == "" then return 0 end
    return length(split($text, $needle)) - 1
end

function characters($text)
    -- split(text, "") deliberately returns empty sentinels at both ends.
    $parts = split($text, "")
    return slice($parts, 1, length($parts) - 1)
end

function strip_comments($src, $line_comments)
    $chars = characters($src)
    $out = []
    $quote = ""
    $escaped = false
    $block_comment = false
    $line_comment = false
    $i = 0
    while $i < length($chars)
        $ch = $chars[$i]
        $next = $i + 1 < length($chars) ? $chars[$i + 1] : ""
        if $block_comment then
            if $ch == "*" and $next == "/" then
                $block_comment = false
                $i = $i + 2
            else
                if $ch == "\n" then push($out, "\n") end
                $i = $i + 1
            end
        else
            if $line_comment then
                if $ch == "\n" then
                    $line_comment = false
                    push($out, $ch)
                end
                $i = $i + 1
            else
                if $quote != "" then
                    push($out, $ch)
                    if $escaped then
                        $escaped = false
                    else
                        if $ch == "\\" then
                            $escaped = true
                        else
                            if $ch == $quote then $quote = "" end
                        end
                    end
                    $i = $i + 1
                else
                    if $ch == "\"" or $ch == "'" then
                        $quote = $ch
                        push($out, $ch)
                        $i = $i + 1
                    else
                        if $ch == "/" and $next == "*" then
                            $block_comment = true
                            $i = $i + 2
                        else
                            if $line_comments and $ch == "/" and $next == "/" then
                                $line_comment = true
                                $i = $i + 2
                            else
                                push($out, $ch)
                                $i = $i + 1
                            end
                        end
                    end
                end
            end
        end
    end
    $text = join($out, "")
    if $block_comment then return { text: $text, fatal: "unterminated block comment" } end
    if $quote != "" then return { text: $text, fatal: "unterminated quoted string" } end
    return { text: $text, fatal: "" }
end

function split_top_level($text, $separator)
    $chars = characters($text)
    $out = []
    $start = 0
    $round = 0
    $square = 0
    $quote = ""
    $escaped = false
    $i = 0
    while $i < length($chars)
        $ch = $chars[$i]
        if $quote != "" then
            if $escaped then
                $escaped = false
            else
                if $ch == "\\" then
                    $escaped = true
                else
                    if $ch == $quote then $quote = "" end
                end
            end
        else
            if $ch == "\"" or $ch == "'" then
                $quote = $ch
            else
                if $ch == "(" then $round = $round + 1 end
                if $ch == ")" then $round = $round - 1 end
                if $ch == "[" then $square = $square + 1 end
                if $ch == "]" then $square = $square - 1 end
                if $ch == $separator and $round == 0 and $square == 0 then
                    push($out, trim(join(slice($chars, $start, $i), "")))
                    $start = $i + 1
                end
            end
        end
        $i = $i + 1
    end
    push($out, trim(join(slice($chars, $start), "")))
    return $out
end

function first_top_colon($text)
    $parts = split_top_level($text, ":")
    if length($parts) < 2 then return 0 end
    return length($parts[0]) + 1
end

function context_copy($stack)
    $out = []
    for each $context_item in $stack
        push($out, $context_item)
    end
    return $out
end

-- ------------------------------------------------- ctk side (the oracle)

function enum_variants($src, $name)
    $blocks = re_find($src, "pub enum " .. $name .. "\\s*\\{([^}]*)\\}")
    if length($blocks) != 1 then
        return nil
    end
    $out = []
    $hits = re_find($blocks[0].groups[0], "(?m)^\\s*([A-Z][A-Za-z0-9_]*)\\s*,\\s*$")
    for each $variant_hit in $hits
        push($out, $variant_hit.groups[0])
    end
    return $out
end

function parse_ctk($path)
    $src = ""
    try
        $src = read_file($path)
    catch $oracle_read_error
        stop_gate("cannot read ctk theme source " .. $path)
    end

    $stripped_oracle = strip_comments($src, true)
    if $stripped_oracle.fatal != "" then stop_gate("unparseable ctk comments: " .. $stripped_oracle.fatal) end
    $src = $stripped_oracle.text

    $ok_helper = "const fn ok(l: f32, c: f32, h: f32) -> Oklch {\n    Oklch::new(l, c, h)\n}"
    if count_text($src, $ok_helper) != 1 then
        stop_gate("ok() helper changed or is unparseable; literal Oklch passthrough is required")
    end
    $ok_functions = re_find($src, "(?m)^\\s*(?:const\\s+)?fn\\s+ok\\s*\\(")
    $ok_bindings = re_find($src, "(?m)^\\s*(?:(?:let|static|const)\\s+(?:mut\\s+)?ok\\b|use\\s+[^;\\n]*\\bok\\b)")
    if length($ok_functions) != 1 or length($ok_bindings) != 0 then
        stop_gate("ok() is shadowed or redefined; oracle calls cannot be proven to use the pinned helper")
    end

    $scheme_variants = enum_variants($src, "Scheme")
    $mode_variants = enum_variants($src, "Mode")
    if $scheme_variants == nil or not exact_set($scheme_variants, $SCHEME_RUST) then
        stop_gate("Scheme enum changed or is unparseable; expected " .. join($SCHEME_RUST, ", "))
    end
    if $mode_variants == nil or not exact_set($mode_variants, $MODE_RUST) then
        stop_gate("Mode enum changed or is unparseable; expected " .. join($MODE_RUST, ", "))
    end

    $role_blocks = re_find($src, "struct Roles\\s*\\{([^}]*)\\}")
    if length($role_blocks) != 1 then
        stop_gate("expected exactly one struct Roles field list")
    end
    $role_fields = []
    for each $role_line_raw in split($role_blocks[0].groups[0], "\n")
        $role_line = trim($role_line_raw)
        if $role_line != "" then
            $role_line_hit = re_find($role_line, "^(?:pub(?:\\([^)]*\\))?\\s+)?(\\w+)\\s*:\\s*Oklch\\s*,\\s*$")
            if length($role_line_hit) != 1 then
                stop_gate("unparseable struct Roles field line '" .. $role_line .. "'")
            end
            push($role_fields, $role_line_hit[0].groups[0])
        end
    end
    $mapped_fields = mapped_role_fields()
    if not exact_set($mapped_fields, $EXPECTED_ROLE_FIELDS) then
        stop_gate("gate role map changed; expected " .. join($EXPECTED_ROLE_FIELDS, ", "))
    end
    for each $schema_field in $role_fields
        if not contains($mapped_fields, $schema_field) and not contains($ROLE_EXCLUDE, $schema_field) then
            stop_gate("Roles field '" .. $schema_field .. "' is neither mapped nor explicitly excluded")
        end
    end
    for each $mapped_field in $mapped_fields
        if not contains($role_fields, $mapped_field) then
            stop_gate("mapped Roles field '" .. $mapped_field .. "' is absent from struct Roles")
        end
    end
    for each $excluded_field in $ROLE_EXCLUDE
        if not contains($role_fields, $excluded_field) then
            stop_gate("excluded Roles field '" .. $excluded_field .. "' is absent from struct Roles")
        end
    end
    if length($role_fields) != length($mapped_fields) + length($ROLE_EXCLUDE) then
        stop_gate("struct Roles field list is not fully accounted for")
    end

    $web_start = pos("fn web_roles(", $src)
    $status_start = pos("fn status(", $src)
    if count_text($src, "fn web_roles(scheme: Scheme, mode: Mode) -> Roles {") != 1 or count_text($src, "fn status(mode: Mode) -> (Oklch, Oklch, Oklch) {") != 1 then
        stop_gate("web_roles/status signatures changed or are unparseable")
    end
    if $web_start == 0 or $status_start == 0 or $status_start <= $web_start then
        stop_gate("web_roles/status function boundaries are unparseable")
    end
    $web_src = substr($src, $web_start - 1, $status_start - $web_start)

    $all_role_arms = re_find($web_src, "=>\\s*Roles\\s*\\{")
    $all_web_arms = re_find($web_src, "=>")
    $all_role_constructors = re_find($web_src, "\\bRoles\\s*\\{")
    $web_ok_calls = re_find($web_src, "\\bok\\b")
    $guarded_role_arms = re_find($web_src, "(?m)^\\s*\\([^\\n]*\\)\\s+if\\s+[^\\n]*=>\\s*Roles\\s*\\{")
    if length($guarded_role_arms) > 0 then
        stop_gate("web_roles contains a guarded Roles arm; executable precedence cannot be inferred")
    end
    if length($all_web_arms) > 12 or length($all_role_constructors) > 13 or length($web_ok_calls) > $EXPECTED_WEB_OK_CALLS then
        stop_gate("web_roles contains executable structure outside the twelve literal Roles arms")
    end

    $out = {}
    $arms = re_find($web_src, "\\((\\w+), (\\w+)\\) => Roles \\{([^}]*)\\}")
    for each $role_arm in $arms
        $arm_groups = $role_arm.groups
        if not contains($SCHEME_RUST, $arm_groups[0]) then
            stop_gate("web_roles contains unknown scheme arm '" .. $arm_groups[0] .. "'")
        end
        if not contains($MODE_RUST, $arm_groups[1]) then
            stop_gate("web_roles contains unknown mode arm '" .. $arm_groups[1] .. "'")
        end
        $key = lower($arm_groups[0]) .. "/" .. lower($arm_groups[1])
        if contains(keys($out), $key) then
            stop_gate("web_roles contains duplicate arm " .. $key)
        end
        $fields = {}
        $field_hits = re_find($arm_groups[2], "(\\w+)\\s*:\\s*ok\\(\\s*([0-9.]+),\\s*([0-9.]+),\\s*([0-9.]+)\\s*\\)")
        for each $field_hit in $field_hits
            $field_groups = $field_hit.groups
            if not contains($role_fields, $field_groups[0]) then
                stop_gate("web_roles arm " .. $key .. " contains unknown field '" .. $field_groups[0] .. "'")
            end
            $field_l = num($field_groups[1])
            $field_c = num($field_groups[2])
            $field_h = num($field_groups[3])
            if $field_l == nil or $field_c == nil or $field_h == nil then
                stop_gate("web_roles arm " .. $key .. " has an invalid number in field '" .. $field_groups[0] .. "'")
            end
            $fields[$field_groups[0]] = [$field_l, $field_c, $field_h]
        end
        for each $required_field in $role_fields
            if not contains(keys($fields), $required_field) then
                stop_gate("web_roles arm " .. $key .. " did not parse field '" .. $required_field .. "'")
            end
        end
        $out[$key] = $fields
    end
    if length($arms) != 12 or length($out) != 12 then
        stop_gate("expected exactly 12 web_roles arms, parsed " .. ("" .. length($arms)))
    end
    if length($all_role_arms) != length($arms) then
        stop_gate("web_roles contains a Roles arm outside the twelve exact (Scheme, Mode) arms")
    end
    for each $expected_scheme in $SCHEMES
        for each $expected_mode in $MODES
            $expected_key = $expected_scheme .. "/" .. $expected_mode
            if not contains(keys($out), $expected_key) then
                stop_gate("web_roles is missing arm " .. $expected_key)
            end
        end
    end

    $after_status = pos("pub struct ThemeSpec", $src)
    if $after_status == 0 or $after_status <= $status_start then
        stop_gate("status() function boundary is unparseable")
    end
    $status_src = substr($src, $status_start - 1, $after_status - $status_start)
    if length(re_find($status_src, "=>")) > 2 or length(re_find($status_src, "\\bok\\b")) > $EXPECTED_STATUS_OK_CALLS then
        stop_gate("status() contains executable structure outside the two literal tuple arms")
    end
    $st = {}
    $status_arms = re_find($status_src, "Mode::(\\w+) => \\(ok\\(\\s*([0-9.]+),\\s*([0-9.]+),\\s*([0-9.]+)\\s*\\), ok\\(\\s*([0-9.]+),\\s*([0-9.]+),\\s*([0-9.]+)\\s*\\), ok\\(\\s*([0-9.]+),\\s*([0-9.]+),\\s*([0-9.]+)\\s*\\)\\)")
    for each $status_arm in $status_arms
        $status_groups = $status_arm.groups
        if not contains($MODE_RUST, $status_groups[0]) then
            stop_gate("status() contains unknown mode arm '" .. $status_groups[0] .. "'")
        end
        $status_key = lower($status_groups[0])
        if contains(keys($st), $status_key) then
            stop_gate("status() contains duplicate arm " .. $status_key)
        end
        $status_values = []
        $status_number = 1
        while $status_number <= 9
            $parsed_status_number = num($status_groups[$status_number])
            if $parsed_status_number == nil then
                stop_gate("status() arm " .. $status_key .. " contains an invalid number")
            end
            push($status_values, $parsed_status_number)
            $status_number = $status_number + 1
        end
        $st[$status_key] = {
            green: [$status_values[0], $status_values[1], $status_values[2]],
            amber: [$status_values[3], $status_values[4], $status_values[5]],
            red:   [$status_values[6], $status_values[7], $status_values[8]]
        }
    end
    if length($status_arms) != 2 or length($st) != 2 then
        stop_gate("expected exactly 2 status() arms, parsed " .. ("" .. length($status_arms)))
    end
    for each $expected_status_mode in $MODES
        if not contains(keys($st), $expected_status_mode) then
            stop_gate("status() is missing arm " .. $expected_status_mode)
        end
    end

    return { roles: $out, status: $st, role_fields: $role_fields }
end

-- ------------------------------------------------------ site.css side

-- Character-stream CSS reader. Comments are removed before braces are interpreted;
-- every declaration retains its complete enclosing context, selector-arm set,
-- importance and source order. It is deliberately limited to the CSS constructs
-- used by site.css, but any watched declaration outside those constructs fails closed.
function parse_site($path)
    $src = ""
    try
        $src = read_file($path)
    catch $site_read_error
        return nil
    end

    $stripped = strip_comments($src, false)
    if $stripped.fatal != "" then return { declarations: [], blocks: [], fatal: $stripped.fatal } end
    $src = $stripped.text
    $chars = characters($src)
    $declarations = []
    $selector_blocks = []
    $stack = []
    $segment_start = 0
    $quote = ""
    $escaped = false
    $round = 0
    $square = 0
    $block_id = 0
    $order = 0
    $i = 0
    while $i < length($chars)
        $ch = $chars[$i]
        if $quote != "" then
            if $escaped then
                $escaped = false
            else
                if $ch == "\\" then
                    $escaped = true
                else
                    if $ch == $quote then $quote = "" end
                end
            end
        else
            if $ch == "\"" or $ch == "'" then
                $quote = $ch
            else
                if $ch == "(" then $round = $round + 1 end
                if $ch == ")" then $round = $round - 1 end
                if $ch == "[" then $square = $square + 1 end
                if $ch == "]" then $square = $square - 1 end
                if $round < 0 or $square < 0 then return { declarations: $declarations, fatal: "unbalanced CSS grouping" } end
                if $round == 0 and $square == 0 and $ch == "{" then
                    $prelude = norm_selector(join(slice($chars, $segment_start, $i), ""))
                    if $prelude == "" then return { declarations: $declarations, fatal: "empty CSS block prelude" } end
                    $block_id = $block_id + 1
                    push($stack, { prelude: $prelude, block_id: $block_id })
                    if not starts_with($prelude, "@") then
                        $block_arms = split_top_level($prelude, ",")
                        for each $block_arm in $block_arms
                            push($selector_blocks, { sel: norm_selector($block_arm), arms: $block_arms, block_id: $block_id, context: context_copy($stack) })
                        end
                    end
                    $segment_start = $i + 1
                end
                if $round == 0 and $square == 0 and ($ch == ";" or $ch == "}") then
                    $piece = trim(join(slice($chars, $segment_start, $i), ""))
                    if $piece != "" then
                        $colon = first_top_colon($piece)
                        if $colon > 1 then
                            $property = trim(substr($piece, 0, $colon - 1))
                            $value = trim(substr($piece, $colon))
                            if starts_with($property, "--") then
                                $important_hit = re_find($value, "(?i)\\s*!important\\s*$")
                                $important = length($important_hit) == 1
                                if $important then $value = trim(re_replace($value, "(?i)\\s*!important\\s*$", "")) end
                                if length($stack) == 0 then
                                    if is_watched($property) then return { declarations: $declarations, fatal: "watched declaration outside any CSS block" } end
                                else
                                    $selector_frame = nil
                                    for each $frame_candidate in $stack
                                        if not starts_with($frame_candidate.prelude, "@") then $selector_frame = $frame_candidate end
                                    end
                                    if $selector_frame == nil then
                                        if is_watched($property) then return { declarations: $declarations, fatal: "watched declaration has no selector context" } end
                                    else
                                        $arms = split_top_level($selector_frame.prelude, ",")
                                        $order = $order + 1
                                        for each $selector_arm in $arms
                                            push($declarations, {
                                                property: $property, value: $value, important: $important,
                                                order: $order, sel: norm_selector($selector_arm), arms: $arms,
                                                block_id: $selector_frame.block_id, context: context_copy($stack)
                                            })
                                        end
                                    end
                                end
                            end
                        else
                            if starts_with($piece, "--") then return { declarations: $declarations, fatal: "unparseable custom-property declaration '" .. $piece .. "'" } end
                        end
                    end
                    $segment_start = $i + 1
                    if $ch == "}" then
                        if length($stack) == 0 then return { declarations: $declarations, fatal: "unmatched closing brace" } end
                        pop($stack)
                    end
                end
            end
        end
        $i = $i + 1
    end
    if length($stack) != 0 then return { declarations: $declarations, fatal: "unterminated CSS block" } end
    if $round != 0 or $square != 0 then return { declarations: $declarations, fatal: "unterminated CSS grouping" } end
    $tail = trim(join(slice($chars, $segment_start), ""))
    if starts_with($tail, "--") then return { declarations: $declarations, fatal: "custom-property declaration outside any CSS block" } end
    return { declarations: $declarations, blocks: $selector_blocks, fatal: "" }
end

function media_condition($declaration)
    $condition = ""
    for each $context_frame in $declaration.context
        if starts_with($context_frame.prelude, "@media") then
            if $condition != "" then return "<nested-media>" end
            $condition = trim(re_replace(substr($context_frame.prelude, 6), "\\s+", " "))
        end
    end
    return $condition
end

function has_unknown_at_context($declaration)
    for each $at_frame in $declaration.context
        if starts_with($at_frame.prelude, "@") then
            $is_layer = $at_frame.prelude == "@layer" or starts_with($at_frame.prelude, "@layer ")
            $is_media = starts_with($at_frame.prelude, "@media ")
            if not $is_layer and not $is_media then return true end
        end
    end
    return false
end

function layer_of($declaration)
    $layer = ""
    for each $layer_frame in $declaration.context
        if $layer_frame.prelude == "@layer" or starts_with($layer_frame.prelude, "@layer ") then
            if $layer != "" then return "<nested-layer>" end
            $layer = $layer_frame.prelude == "@layer" ? "<anonymous:" .. ("" .. $layer_frame.block_id) .. ">" : trim(substr($layer_frame.prelude, 7))
        end
    end
    return $layer
end

function selector_context_count($declaration)
    $count = 0
    for each $selector_context in $declaration.context
        if not starts_with($selector_context.prelude, "@") then $count = $count + 1 end
    end
    return $count
end

function winner($declarations, $property)
    $ordinary = nil
    $ordinary_unlayered = nil
    $important = nil
    for each $winner_candidate in $declarations
        if $winner_candidate.property == $property then
            if $winner_candidate.important then $important = $winner_candidate else $ordinary = $winner_candidate end
            if not $winner_candidate.important and layer_of($winner_candidate) == "" then $ordinary_unlayered = $winner_candidate end
        end
    end
    if $important != nil then return $important end
    -- Normal declarations outside a layer outrank every layered declaration,
    -- regardless of source order. Distinct named-layer precedence is rejected
    -- before resolution because it depends on the stylesheet's layer order.
    return $ordinary_unlayered != nil ? $ordinary_unlayered : $ordinary
end

function declarations_for_block($declarations, $block_id)
    $out = []
    for each $block_decl in $declarations
        if $block_decl.block_id == $block_id then push($out, $block_decl) end
    end
    return $out
end

function data_scheme_values($text)
    $out = []
    $attribute_hits = re_find($text, "(?i)\\bdata-scheme\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))")
    for each $attribute_hit in $attribute_hits
        $attribute_value = $attribute_hit.groups[0]
        if $attribute_value == "" then $attribute_value = $attribute_hit.groups[1] end
        if $attribute_value == "" then $attribute_value = $attribute_hit.groups[2] end
        push($out, $attribute_value)
    end
    return $out
end

-- --------------------------------------------------------------- checking

function check_site($name, $path, $ctk)
    $parsed = parse_site($path)
    if $parsed == nil then
        return { kind: "site", name: $name, path: $path, fatal: "unreadable", problems: [], compared: 0, invariants: 0, consumers: 0, service_cards: 0, blocks: 0 }
    end
    if $parsed.fatal != "" then
        return { kind: "site", name: $name, path: $path, fatal: $parsed.fatal, problems: [], compared: 0, invariants: 0, consumers: 0, service_cards: 0, blocks: 0 }
    end
    $problems = []
    $compared = 0
    $invariants = 0
    $consumer_count = 0
    $service_count = 0
    $block_count = 0
    $delivery_decls = {}
    $consumer_blocks = []
    $service_rows = {}
    $important_seen = {}
    $known_service_consumer = []
    $service_surface_seen = false
    $layer_groups = {}

    for each $selector_block in $parsed.blocks
        if length(re_find($selector_block.sel, "data-card-scheme\\s*=")) > 0 then
            $service_surface_seen = true
            $known_light_row = re_find($selector_block.sel, "^\\.service-card\\[data-card-scheme=\"([a-z]+)\"\\]$")
            $known_dark_row = re_find($selector_block.sel, "^html\\.dark \\.service-card\\[data-card-scheme=\"([a-z]+)\"\\]$")
            if length($known_light_row) != 1 and length($known_dark_row) != 1 then
                push($problems, { kind: "service-card-selector", ctx: "-", sel: $selector_block.sel, detail: "unrecognised service-card palette row" })
            else
                $block_scheme = length($known_light_row) == 1 ? $known_light_row[0].groups[0] : $known_dark_row[0].groups[0]
                if not contains($SCHEMES, $block_scheme) then
                    push($problems, { kind: "service-card-selector", ctx: "-", sel: $selector_block.sel, detail: "unknown service-card scheme '" .. $block_scheme .. "'" })
                end
            end
        end
    end

    for each $site_decl in $parsed.declarations
        if is_watched($site_decl.property) then
            if $site_decl.important and not contains(keys($important_seen), "" .. $site_decl.order) then
                $important_seen["" .. $site_decl.order] = true
                push($problems, { kind: "palette-important", ctx: "-", sel: $site_decl.sel, detail: $site_decl.property .. " must not use !important" })
            end
            if has_unknown_at_context($site_decl) then
                return { kind: "site", name: $name, path: $path, fatal: "unrecognised at-rule context carrying " .. $site_decl.property, problems: [], compared: 0, invariants: 0, consumers: 0, service_cards: 0, blocks: 0 }
            end
            if selector_context_count($site_decl) != 1 then
                return { kind: "site", name: $name, path: $path, fatal: "nested selector context carrying " .. $site_decl.property, problems: [], compared: 0, invariants: 0, consumers: 0, service_cards: 0, blocks: 0 }
            end
            $media = media_condition($site_decl)
            $decl_layer = layer_of($site_decl)
            if $decl_layer == "<nested-layer>" then
                return { kind: "site", name: $name, path: $path, fatal: "nested layer context carrying " .. $site_decl.property, problems: [], compared: 0, invariants: 0, consumers: 0, service_cards: 0, blocks: 0 }
            end
            if $decl_layer != "" then
                $layer_key = $site_decl.sel .. "|" .. $media .. "|" .. $site_decl.property
                $named_layers = get_or($layer_groups, $layer_key, [])
                if not contains($named_layers, $decl_layer) then push($named_layers, $decl_layer) end
                $layer_groups[$layer_key] = $named_layers
                if length($named_layers) > 1 then
                    return { kind: "site", name: $name, path: $path, fatal: "multiple layer contexts carry " .. $site_decl.property .. " for " .. $site_decl.sel, problems: [], compared: 0, invariants: 0, consumers: 0, service_cards: 0, blocks: 0 }
                end
            end
            if $media == "(prefers-contrast: more)" then
                if $site_decl.sel != ":root" or $site_decl.property != "--border" or $site_decl.value != "currentColor" then
                    return { kind: "site", name: $name, path: $path, fatal: "unrecognised prefers-contrast palette declaration", problems: [], compared: 0, invariants: 0, consumers: 0, service_cards: 0, blocks: 0 }
                end
            else
                if $media != "" and $media != "(prefers-color-scheme: dark)" then
                    return { kind: "site", name: $name, path: $path, fatal: "unrecognised media context '" .. $media .. "' carrying " .. $site_decl.property, problems: [], compared: 0, invariants: 0, consumers: 0, service_cards: 0, blocks: 0 }
                end
                $delivery = delivery_of($site_decl.sel, $media == "(prefers-color-scheme: dark)")
                if $delivery != nil then
                    $delivery_list = get_or($delivery_decls, $delivery.id, [])
                    push($delivery_list, $site_decl)
                    $delivery_decls[$delivery.id] = $delivery_list
                else
                    $is_image_candidate = contains($site_decl.arms, ".hero-bg") or contains($site_decl.arms, ".bg-image-section") or contains($site_decl.arms, ".hero-canvas") or contains($site_decl.value, "--accent-on-image")
                    if $is_image_candidate then
                        if not contains($consumer_blocks, $site_decl.block_id) then push($consumer_blocks, $site_decl.block_id) end
                    else
                        if $site_decl.sel == ".service-card[data-card-scheme]" then
                            push($known_service_consumer, $site_decl)
                        else
                            $light_row = re_find($site_decl.sel, "^\\.service-card\\[data-card-scheme=\"([a-z]+)\"\\]$")
                            $dark_row = re_find($site_decl.sel, "^html\\.dark \\.service-card\\[data-card-scheme=\"([a-z]+)\"\\]$")
                            if length($light_row) == 1 or length($dark_row) == 1 then
                                $row_scheme = length($light_row) == 1 ? $light_row[0].groups[0] : $dark_row[0].groups[0]
                                $row_mode = length($light_row) == 1 ? "light" : "dark"
                                if contains($SCHEMES, $row_scheme) then
                                    $row_key = $row_scheme .. "/" .. $row_mode
                                    $row_list = get_or($service_rows, $row_key, [])
                                    push($row_list, $site_decl)
                                    $service_rows[$row_key] = $row_list
                                end
                            else
                                if contains($site_decl.sel, "data-card-scheme") then
                                    push($problems, { kind: "service-card-selector", ctx: "-", sel: $site_decl.sel, detail: "unrecognised service-card palette row" })
                                else
                                    return { kind: "site", name: $name, path: $path, fatal: "unrecognised palette-block selector '" .. $site_decl.sel .. "'", problems: [], compared: 0, invariants: 0, consumers: 0, service_cards: 0, blocks: 0 }
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- The generic service-card consumer is optional with its row surface, but exact.
    if length($known_service_consumer) > 0 then
        $service_expected = {
            "--glass": "var(--sw-bg)",
            "--glass-border": "color-mix(in oklch, var(--sw-fg) 14%, transparent)",
            "--accent": "var(--sw-ac)",
            "--accent-glow": "color-mix(in oklch, var(--sw-ac) 30%, transparent)",
            "--fg-primary": "var(--sw-fg)"
        }
        for each $service_prop in keys($service_expected)
            $service_winner = winner($known_service_consumer, $service_prop)
            if $service_winner == nil or $service_winner.value != $service_expected[$service_prop] then
                push($problems, { kind: "consumer-mismatch", ctx: "service-card", sel: ".service-card[data-card-scheme]", detail: $service_prop .. " must be " .. $service_expected[$service_prop] })
            end
        end
    end

    -- Required image-ground consumer, including its exact selector-arm set.
    if length($consumer_blocks) != 1 then
        push($problems, { kind: "onimage-consumer-count", ctx: "-", sel: "", detail: "expected exactly one substitution block, found " .. ("" .. length($consumer_blocks)) })
    else
        $consumer_decls = declarations_for_block($parsed.declarations, $consumer_blocks[0])
        $consumer_arms = length($consumer_decls) > 0 ? $consumer_decls[0].arms : []
        $wanted_arms = get_or($ONIMAGE_ARMS, $name, nil)
        if $wanted_arms == nil then
            -- --file mode: no clone name, so the arm set must match exactly one pin.
            $pin_hits = []
            for each $pin_name in keys($ONIMAGE_ARMS)
                if exact_set($consumer_arms, $ONIMAGE_ARMS[$pin_name]) then push($pin_hits, $pin_name) end
            end
            -- Any hit is unambiguous: exact_set matching several pins means those
            -- configured pins are the same set, not a real ambiguity.
            if length($pin_hits) > 0 then $wanted_arms = $ONIMAGE_ARMS[$pin_hits[0]] end
        end
        if $wanted_arms == nil or not exact_set($consumer_arms, $wanted_arms) then
            push($problems, { kind: "onimage-arm-set", ctx: "-", sel: join($consumer_arms, ", "), detail: "substitution arm set is not the pinned clone shape" })
        end
        $consumer_expected = {
            "--accent": "var(--accent-on-image)",
            "--accent-hover": "var(--accent-on-image-hover)",
            "--accent-fg": "var(--accent-on-image-fg)",
            "--accent-glow": "var(--accent-on-image-glow)"
        }
        for each $consumer_prop in keys($consumer_expected)
            $consumer_winner = winner($consumer_decls, $consumer_prop)
            if $consumer_winner == nil or $consumer_winner.value != $consumer_expected[$consumer_prop] then
                push($problems, { kind: "consumer-mismatch", ctx: "on-image", sel: join($consumer_arms, ", "), detail: $consumer_prop .. " must be " .. $consumer_expected[$consumer_prop] })
            else
                $consumer_count = $consumer_count + 1
            end
        end
    end

    for each $expected_delivery in $DELIVERIES
        $context_decls = get_or($delivery_decls, $expected_delivery.id, [])
        $primary_blocks = []
        for each $coverage_decl in $context_decls
            if $coverage_decl.property == "--bg-primary" and not contains($primary_blocks, $coverage_decl.block_id) then push($primary_blocks, $coverage_decl.block_id) end
        end
        $delivery_count = length($primary_blocks)
        $block_count = $block_count + $delivery_count
        if $delivery_count == 0 then
            push($problems, { kind: "uncovered-context", ctx: $expected_delivery.scheme .. "/" .. $expected_delivery.mode, sel: $expected_delivery.sel, detail: "delivery path " .. $expected_delivery.id .. " is missing" })
        end
        if $delivery_count > 1 then
            push($problems, { kind: "duplicate-context", ctx: $expected_delivery.scheme .. "/" .. $expected_delivery.mode, sel: $expected_delivery.sel, detail: "delivery path " .. $expected_delivery.id .. " has " .. ("" .. $delivery_count) .. " primary blocks" })
        end
        $delivery = $expected_delivery
        $ctx = $delivery.scheme .. "/" .. $delivery.mode
        $primary_decls = $delivery_count == 1 ? declarations_for_block($context_decls, $primary_blocks[0]) : []
        $want_roles = $ctk.roles[$ctx]

        for each $role_check in $ROLES
            $role_name = $role_check[0]
            $role_prop = $role_check[1]
            $primary_role = winner($primary_decls, $role_prop)
            if $delivery_count == 1 and $primary_role == nil then
                push($problems, { kind: "missing-token", ctx: $ctx, sel: $delivery.sel, detail: $role_prop .. " absent from primary delivery block" })
            end
            $role_winner = winner($context_decls, $role_prop)
            if $role_winner != nil then
                $role_got = parse_oklch($role_winner.value)
                if $role_got == nil then
                    push($problems, { kind: "unparseable", ctx: $ctx, sel: $delivery.sel, detail: $role_prop .. " is not exactly oklch(L% C H)" })
                else
                    $compared = $compared + 1
                    if not same3($role_got, $want_roles[$role_name]) then
                        push($problems, { kind: "value-mismatch", ctx: $ctx, sel: $delivery.sel, detail: $role_prop .. ": site " .. colour_str($role_got) .. " != ctk " .. $role_name .. " " .. colour_str($want_roles[$role_name]) })
                    end
                end
            else
                if $delivery_count > 0 then push($problems, { kind: "missing-token", ctx: $ctx, sel: $delivery.sel, detail: $role_prop .. " has no cascade winner" }) end
            end
        end

        for each $status_check in $STATUS
            $status_name = $status_check[0]
            $status_prop = $status_check[1]
            $primary_status = winner($primary_decls, $status_prop)
            if $delivery_count == 1 and $delivery.status and $primary_status == nil then
                push($problems, { kind: "missing-token", ctx: $ctx, sel: $delivery.sel, detail: $status_prop .. " absent from primary delivery block" })
            end
            $status_winner = winner($context_decls, $status_prop)
            if $status_winner != nil then
                $status_got = parse_oklch($status_winner.value)
                if $status_got == nil then
                    push($problems, { kind: "unparseable", ctx: $ctx, sel: $delivery.sel, detail: $status_prop .. " is not exactly oklch(L% C H)" })
                else
                    if $delivery.status then $compared = $compared + 1 end
                    $status_want = $ctk.status[$delivery.mode][$status_name]
                    if not same3($status_got, $status_want) then
                        push($problems, { kind: "value-mismatch", ctx: $ctx, sel: $delivery.sel, detail: $status_prop .. ": site " .. colour_str($status_got) .. " != ctk status." .. $status_name .. " " .. colour_str($status_want) })
                    end
                end
            end
        end

        for each $opaque_check in $ONIMAGE_OPAQUE
            $opaque_prop = $opaque_check[1]
            $primary_opaque = winner($primary_decls, $opaque_prop)
            if $delivery_count == 1 and $primary_opaque == nil then
                push($problems, { kind: "missing-token", ctx: $ctx, sel: $delivery.sel, detail: $opaque_prop .. " absent from primary delivery block" })
            end
            $opaque_winner = winner($context_decls, $opaque_prop)
            if $opaque_winner != nil then
                $opaque_got = parse_oklch($opaque_winner.value)
                if $opaque_got == nil then
                    push($problems, { kind: "unparseable", ctx: $ctx, sel: $delivery.sel, detail: $opaque_prop .. " is not exactly oklch(L% C H)" })
                else
                    $compared = $compared + 1
                    $opaque_want = $ctk.roles[$delivery.scheme .. "/dark"][$opaque_check[0]]
                    if not same3($opaque_got, $opaque_want) then
                        push($problems, { kind: "onimage-invariant", ctx: $ctx, sel: $delivery.sel, detail: $opaque_prop .. ": " .. colour_str($opaque_got) .. " != " .. $delivery.scheme .. " dark " .. $opaque_check[0] .. " " .. colour_str($opaque_want) })
                    end
                end
            end
        end

        $primary_fg = winner($primary_decls, $ONIMAGE_FG)
        if $delivery_count == 1 and $primary_fg == nil then
            push($problems, { kind: "missing-token", ctx: $ctx, sel: $delivery.sel, detail: $ONIMAGE_FG .. " absent from primary delivery block" })
        end
        $fg_winner = winner($context_decls, $ONIMAGE_FG)
        if $fg_winner != nil then
            $fg_got = parse_oklch($fg_winner.value)
            if $fg_got == nil then
                push($problems, { kind: "unparseable", ctx: $ctx, sel: $delivery.sel, detail: $ONIMAGE_FG .. " is not exactly oklch(L% C H)" })
            else
                $invariants = $invariants + 1
                $fg_want = parse_oklch($PINNED[$delivery.scheme .. "/dark"]["--accent-fg"])
                if not same3($fg_got, $fg_want) then
                    push($problems, { kind: "onimage-invariant", ctx: $ctx, sel: $delivery.sel, detail: $ONIMAGE_FG .. ": " .. colour_str($fg_got) .. " != " .. $delivery.scheme .. " dark --accent-fg " .. colour_str($fg_want) })
                end
            end
        end

        $primary_glow = winner($primary_decls, $ONIMAGE_GLOW)
        if $delivery_count == 1 and $primary_glow == nil then
            push($problems, { kind: "missing-token", ctx: $ctx, sel: $delivery.sel, detail: $ONIMAGE_GLOW .. " absent from primary delivery block" })
        end
        $glow_winner = winner($context_decls, $ONIMAGE_GLOW)
        if $glow_winner != nil then
            $glow_got = parse_oklch_alpha($glow_winner.value)
            if $glow_got == nil then
                push($problems, { kind: "unparseable", ctx: $ctx, sel: $delivery.sel, detail: $ONIMAGE_GLOW .. " is not exactly oklch(L% C H / A)" })
            else
                $invariants = $invariants + 1
                $glow_want = parse_oklch_alpha($PINNED[$delivery.scheme .. "/dark"]["--accent-glow"])
                if not same4($glow_got, $glow_want) then
                    push($problems, { kind: "onimage-invariant", ctx: $ctx, sel: $delivery.sel, detail: $ONIMAGE_GLOW .. ": " .. colour_str($glow_got) .. " != " .. $delivery.scheme .. " dark --accent-glow " .. colour_str($glow_want) })
                end
            end
        end

        for each $pinned_prop in keys($PINNED[$ctx])
            $primary_pinned = winner($primary_decls, $pinned_prop)
            if $delivery_count == 1 and $primary_pinned == nil then
                push($problems, { kind: "missing-token", ctx: $ctx, sel: $delivery.sel, detail: $pinned_prop .. " absent from primary delivery block" })
            end
            $pinned_winner = winner($context_decls, $pinned_prop)
            if $pinned_winner != nil then
                $pinned_want_text = $PINNED[$ctx][$pinned_prop]
                $pinned_want = contains($pinned_want_text, "/") ? parse_oklch_alpha($pinned_want_text) : parse_oklch($pinned_want_text)
                $pinned_got = contains($pinned_want_text, "/") ? parse_oklch_alpha($pinned_winner.value) : parse_oklch($pinned_winner.value)
                if $pinned_got == nil then
                    push($problems, { kind: "unparseable", ctx: $ctx, sel: $delivery.sel, detail: $pinned_prop .. " does not match its pinned OKLCH grammar" })
                else
                    $compared = $compared + 1
                    $pinned_same = length($pinned_want) == 4 ? same4($pinned_got, $pinned_want) : same3($pinned_got, $pinned_want)
                    if not $pinned_same then
                        push($problems, { kind: "pinned-mismatch", ctx: $ctx, sel: $delivery.sel, detail: $pinned_prop .. ": site " .. colour_str($pinned_got) .. " != pinned " .. colour_str($pinned_want) })
                    end
                end
            end
        end
    end


    -- Optional service-card palette: one row opts the clone into all 12 contexts.
    if $service_surface_seen then
        for each $service_scheme in $SCHEMES
            for each $service_mode in $MODES
                $service_ctx = $service_scheme .. "/" .. $service_mode
                $row_decls = get_or($service_rows, $service_ctx, [])
                if length($row_decls) == 0 then
                    push($problems, { kind: "service-card-missing", ctx: $service_ctx, sel: "", detail: "palette row is absent" })
                else
                    $service_row_blocks = []
                    for each $service_row_decl in $row_decls
                        if not contains($service_row_blocks, $service_row_decl.block_id) then push($service_row_blocks, $service_row_decl.block_id) end
                    end
                    if length($service_row_blocks) != 1 then
                        push($problems, { kind: "service-card-duplicate", ctx: $service_ctx, sel: $row_decls[0].sel, detail: "expected exactly one palette row, found " .. ("" .. length($service_row_blocks)) })
                    end
                    $service_checks = [["--sw-bg", "bg1"], ["--sw-fg", "fg"], ["--sw-ac", "accent"]]
                    for each $service_check in $service_checks
                        $service_value = winner($row_decls, $service_check[0])
                        if $service_value == nil then
                            push($problems, { kind: "service-card-missing", ctx: $service_ctx, sel: $row_decls[0].sel, detail: $service_check[0] .. " absent" })
                        else
                            $service_got = parse_oklch($service_value.value)
                            $service_want = $ctk.roles[$service_ctx][$service_check[1]]
                            if $service_got == nil then
                                push($problems, { kind: "service-card-unparseable", ctx: $service_ctx, sel: $service_value.sel, detail: $service_check[0] .. " is not opaque OKLCH" })
                            else
                                $service_count = $service_count + 1
                                if not same3($service_got, $service_want) then
                                    push($problems, { kind: "service-card-mismatch", ctx: $service_ctx, sel: $service_value.sel, detail: $service_check[0] .. ": " .. colour_str($service_got) .. " != ctk " .. $service_check[1] .. " " .. colour_str($service_want) })
                                end
                            end
                        end
                    end
                end
            end
        end
        if $service_count != $EXPECTED_SERVICE_CARD_ANCHORS then
            push($problems, { kind: "service-card-count", ctx: "-", sel: "", detail: "compared " .. ("" .. $service_count) .. ", expected " .. ("" .. $EXPECTED_SERVICE_CARD_ANCHORS) })
        end
    end

    if $compared != $EXPECTED_SITE_ANCHORS then
        push($problems, { kind: "anchor-count", ctx: "-", sel: "", detail: "compared " .. ("" .. $compared) .. ", expected " .. ("" .. $EXPECTED_SITE_ANCHORS) })
    end
    if $invariants != $EXPECTED_ONIMAGE_INVARIANTS then
        push($problems, { kind: "invariant-count", ctx: "-", sel: "", detail: "checked " .. ("" .. $invariants) .. ", expected " .. ("" .. $EXPECTED_ONIMAGE_INVARIANTS) })
    end
    if $consumer_count != $EXPECTED_ONIMAGE_CONSUMERS then
        push($problems, { kind: "consumer-count", ctx: "-", sel: "", detail: "checked " .. ("" .. $consumer_count) .. ", expected " .. ("" .. $EXPECTED_ONIMAGE_CONSUMERS) })
    end
    if $block_count != $EXPECTED_PALETTE_BLOCKS then
        push($problems, { kind: "palette-block-count", ctx: "-", sel: "", detail: "found " .. ("" .. $block_count) .. ", expected " .. ("" .. $EXPECTED_PALETTE_BLOCKS) })
    end

    return { kind: "site", name: $name, path: $path, fatal: "", problems: $problems, compared: $compared, invariants: $invariants, consumers: $consumer_count, service_cards: $service_count, blocks: $block_count }
end

function check_swatches($name, $path, $ctk)
    $src = ""
    try
        $src = read_file($path)
    catch $swatch_read_error
        return { kind: "swatch", name: $name .. " swatches", path: $path, fatal: "unreadable", problems: [], compared: 0, invariants: 0, blocks: 0 }
    end

    $problems = []
    $compared = 0
    $found = {}
    $button_scheme_count = 0
    for each $button_hit in re_find($src, "(?s)<button\\b([^>]*)>(.*?)</button>")
        $button_attrs = $button_hit.groups[0]
        $button_body = $button_hit.groups[1]
        $scheme_attrs = data_scheme_values($button_attrs)
        if length($scheme_attrs) > 1 then
            push($problems, { kind: "swatch-binding", ctx: "-", detail: "scheme button carries multiple data-scheme attributes" })
        end
        if length($scheme_attrs) == 1 then
            $button_scheme_count = $button_scheme_count + 1
            $scheme = $scheme_attrs[0]
            $scheme = get_or($SWATCH_ALIAS, $scheme, $scheme)
            if not contains($SCHEMES, $scheme) then
                push($problems, { kind: "unknown-swatch", ctx: $scheme, detail: "data-scheme is not one of the six schemes" })
            else
                $found[$scheme] = get_or($found, $scheme, 0) + 1
                $dot_tags = []
                for each $span_tag in re_find($button_body, "<span\\b[^>]*>")
                    $span_class = re_find($span_tag.match, "\\bclass=\"([^\"]*)\"")
                    if length($span_class) == 1 and contains(split(re_replace(trim($span_class[0].groups[0]), "\\s+", " "), " "), "scheme-dot") then
                        push($dot_tags, $span_tag)
                    end
                end
                $got = nil
                if length($dot_tags) == 1 then
                    $dot_style = re_find($dot_tags[0].match, "\\bstyle=\"([^\"]*)\"")
                    if length($dot_style) == 1 then
                        $dot_backgrounds = re_find($dot_style[0].groups[0], "(?:^|;)\\s*background\\s*:\\s*([^;]+)")
                        if length($dot_backgrounds) == 1 then
                            $got = parse_oklch(trim($dot_backgrounds[0].groups[0]))
                        end
                    end
                end
                if $got == nil then
                    push($problems, { kind: "missing-swatch", ctx: $scheme, detail: "exactly one .scheme-dot must carry one exact opaque oklch(L% C H) background" })
                else
                    $compared = $compared + 1
                    $want = get_or($SWATCH_EXCEPT, $scheme, $ctk.roles[$scheme .. "/light"]["accent"])
                    if not same3($got, $want) then
                        push($problems, { kind: "swatch-mismatch", ctx: $scheme, detail: "dot " .. colour_str($got) .. " != expected " .. colour_str($want) })
                    end
                end
            end
        end
    end

    $all_scheme_attrs = length(data_scheme_values($src))
    if $all_scheme_attrs != $button_scheme_count then
        push($problems, { kind: "swatch-binding", ctx: "-", detail: ("" .. ($all_scheme_attrs - $button_scheme_count)) .. " data-scheme attribute(s) are not bound to a button" })
    end

    for each $expected_swatch in $SCHEMES
        $swatch_count = get_or($found, $expected_swatch, 0)
        if $swatch_count == 0 then
            push($problems, { kind: "missing-swatch", ctx: $expected_swatch, detail: "no scheme-picker dot" })
        end
        if $swatch_count > 1 then
            push($problems, { kind: "duplicate-swatch", ctx: $expected_swatch, detail: ("" .. $swatch_count) .. " scheme-picker dots" })
        end
    end
    if $compared != $EXPECTED_SWATCHES then
        push($problems, { kind: "swatch-count", ctx: "-", detail: "compared " .. ("" .. $compared) .. ", expected " .. ("" .. $EXPECTED_SWATCHES) })
    end

    return { kind: "swatch", name: $name .. " swatches", path: $path, fatal: "", problems: $problems, compared: $compared, invariants: 0, blocks: 0 }
end

-- ------------------------------------------------------------------- main

$argv = args()
$json = false
$only = ""
$adhoc = ""
$oracle_path = $CTK
$arg_index = 0
while $arg_index < length($argv)
    $cli_arg = $argv[$arg_index]
    if $cli_arg == "--json" then
        $json = true
    else
        if $cli_arg == "--file" or $cli_arg == "--oracle" then
            $arg_index = $arg_index + 1
            if $arg_index >= length($argv) then
                stop_gate($cli_arg .. " needs a path")
            end
            if $cli_arg == "--file" then $adhoc = $argv[$arg_index] end
            if $cli_arg == "--oracle" then $oracle_path = $argv[$arg_index] end
        else
            if starts_with($cli_arg, "--") then
                stop_gate("unknown option " .. $cli_arg)
            end
            $only = $cli_arg
        end
    end
    $arg_index = $arg_index + 1
end

$ctk = parse_ctk($oracle_path)
$reports = []
$matched_any = false
if $adhoc != "" then
    $matched_any = true
    if ends_with($adhoc, ".html") then
        push($reports, check_swatches("--file", $adhoc, $ctk))
    else
        push($reports, check_site("--file", $adhoc, $ctk))
    end
else
    for each $site_entry in $SITES
        if $only == "" or $only == $site_entry[0] then
            $matched_any = true
            push($reports, check_site($site_entry[0], $site_entry[1], $ctk))
        end
    end
    for each $html_entry in $SWATCH_HTML
        if $only == "" or $only == $html_entry[0] then
            push($reports, check_swatches($html_entry[0], $html_entry[1], $ctk))
        end
    end
end
if not $matched_any then
    stop_gate("no clone named '" .. $only .. "' — known: " .. join($CLONE_NAMES, ", "))
end

$bad = 0
$cannot_answer = 0
for each $report_tally in $reports
    if $report_tally.fatal != "" then $cannot_answer = $cannot_answer + 1 end
    if length($report_tally.problems) > 0 then $bad = $bad + 1 end
end

if $json then
    print(json_encode({
        oracle: $oracle_path,
        role_fields: $ctk.role_fields,
        role_properties: $ROLES,
        expected_web_ok_calls: $EXPECTED_WEB_OK_CALLS,
        expected_status_ok_calls: $EXPECTED_STATUS_OK_CALLS,
        expected_site_anchors: $EXPECTED_SITE_ANCHORS,
        expected_oracle_anchors: $EXPECTED_ORACLE_ANCHORS,
        expected_pinned_anchors: $EXPECTED_PINNED_ANCHORS,
        expected_onimage_invariants: $EXPECTED_ONIMAGE_INVARIANTS,
        expected_onimage_consumers: $EXPECTED_ONIMAGE_CONSUMERS,
        expected_palette_blocks: $EXPECTED_PALETTE_BLOCKS,
        expected_service_card_anchors: $EXPECTED_SERVICE_CARD_ANCHORS,
        expected_swatches: $EXPECTED_SWATCHES,
        swatch_exception_keys: keys($SWATCH_EXCEPT),
        reports: $reports,
        clones_with_problems: $bad,
        cannot_answer: $cannot_answer
    }))
else
    print("oracle: " .. $oracle_path .. " (web_roles + status)")
    for each $shown_report in $reports
        if $shown_report.fatal != "" then
            print("[CANNOT ANSWER] " .. $shown_report.name .. "  " .. $shown_report.path .. " — " .. $shown_report.fatal)
        else
            if length($shown_report.problems) == 0 then
                if $shown_report.kind == "swatch" then
                    print("[agrees]   " .. $shown_report.name .. "  " .. ("" .. $shown_report.compared) .. " picker swatches compared")
                else
                    $service_suffix = $shown_report.service_cards > 0 ? " + " .. ("" .. $shown_report.service_cards) .. " service-card anchors" : ""
                    print("[agrees]   " .. $shown_report.name .. "  " .. ("" .. $shown_report.compared) .. " anchors + " .. ("" .. $shown_report.invariants) .. " on-image invariants + " .. ("" .. $shown_report.consumers) .. " required consumer declarations" .. $service_suffix .. " across " .. ("" .. $shown_report.blocks) .. " palette delivery blocks")
                end
            else
                print("[DISAGREES] " .. $shown_report.name .. "  " .. ("" .. length($shown_report.problems)) .. " problem(s):")
                for each $shown_problem in $shown_report.problems
                    print("    " .. $shown_problem.kind .. "  " .. get_or($shown_problem, "ctx", "-") .. "  " .. get_or($shown_problem, "sel", "") .. "  " .. $shown_problem.detail)
                end
            end
        end
    end
end

if $cannot_answer > 0 then exit(2) end
if $bad > 0 then exit(1) end
