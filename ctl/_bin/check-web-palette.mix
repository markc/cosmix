#!/usr/bin/env mix
-- check-web-palette.mix — gate every site.css clone against ctk's web_roles.
--
--   check-web-palette.mix                 check every clone, human output
--   check-web-palette.mix --json          one JSON report
--   check-web-palette.mix <name>          check one clone by name
--   check-web-palette.mix --file PATH     check one ad-hoc CSS or HTML file
--   check-web-palette.mix --oracle PATH   use an ad-hoc theme.rs (tests only)
--
-- Exit contract:
--   0 = every checked value and delivery path agrees
--   1 = a real value, token, swatch, invariant, or coverage disagreement
--   2 = cannot answer: unreadable input, unparseable oracle, or an unrecognised
--       selector carrying palette declarations
--
-- `uncovered-context` is exit 1: the oracle and CSS were understood, and the CSS
-- is observably missing a required delivery path. It is not a parser failure.

$d = require("../_lib/deploy_lib.mix")

$CONF_PATH = $d.hub_root() .. "/_etc/check-web-palette.conf.mix"
if not is_file($CONF_PATH) then
    print("  ERROR: no web palette configuration at " .. $CONF_PATH)
    print("         copy _etc/check-web-palette.conf.mix.example there and set clones")
    exit(2)
end

fn config_error($message)
    print("  ERROR: " .. $CONF_PATH .. ": " .. $message)
    exit(2)
end

$CONF = nil
try
    $loaded = load_data($CONF_PATH)
    if type($loaded) != "map" or type($loaded["check_web_palette"]) != "map" then
        config_error("must contain a check_web_palette strict-data map")
    end
    $CONF = validate($loaded["check_web_palette"], {
        schema_version: {type: "integer", enum: [1]},
        clones: {type: "list", min_length: 1, items: {type: "map", schema: {
            name: {type: "string", nonblank: true},
            css_path: {type: "string", nonblank: true},
            html_path: {type: "string", nonblank: true},
            onimage_arms: {type: "list", min_length: 1,
                items: {type: "string", nonblank: true}}
        }}}
    })
catch $error
    print("  ERROR: invalid strict-data config " .. $CONF_PATH .. ": " .. $error)
    exit(2)
end

fn source_path($key, $relative)
    if (starts_with($relative, "/") or starts_with($relative, "\\") or
        contains($relative, "//") or contains($relative, "\n") or
        contains($relative, "\r")) then
        config_error($key .. " must be a normalised one-line path relative to $COSMIX")
    end
    for each $part in split($relative, "/")
        if $part == "" or $part == "." or $part == ".." then
            config_error($key .. " must not contain empty, . or .. components")
        end
    end
    return $d.cosmix_root() .. "/" .. $relative
end

$CTK = $d.cosmix_root() .. "/src/desktop/ctk/src/theme.rs"
$SITES = []
$SWATCH_HTML = []
$ONIMAGE_ARMS = {}
$CLONE_NAMES = []
$seen_css = {}
$seen_html = {}
for each $clone in $CONF["clones"]
    $name = $clone["name"]
    if contains($name, "\n") or contains($name, "\r") then
        config_error("clone names must be one line")
    end
    if has_key($ONIMAGE_ARMS, $name) then
        config_error("duplicate clone name '" .. $name .. "'")
    end
    $css = source_path("clone '" .. $name .. "' css_path", $clone["css_path"])
    $html = source_path("clone '" .. $name .. "' html_path", $clone["html_path"])
    if has_key($seen_css, $css) then
        config_error("clone '" .. $name .. "' repeats css_path " .. $clone["css_path"])
    end
    if has_key($seen_html, $html) then
        config_error("clone '" .. $name .. "' repeats html_path " .. $clone["html_path"])
    end
    $arms = []
    for each $arm in $clone["onimage_arms"]
        if contains($arm, "\n") or contains($arm, "\r") then
            config_error("clone '" .. $name .. "' onimage_arms must be one line each")
        end
        if contains($arms, $arm) then
            config_error("clone '" .. $name .. "' repeats on-image arm '" .. $arm .. "'")
        end
        push($arms, $arm)
    end
    $ONIMAGE_ARMS[$name] = $arms
    $seen_css[$css] = true
    $seen_html[$html] = true
    push($CLONE_NAMES, $name)
    push($SITES, [$name, $css])
    push($SWATCH_HTML, [$name, $html])
end

-- ctk Roles field -> CSS custom property. ROLE_EXCLUDE is deliberately explicit:
-- every Roles field must be mapped here or named there, or oracle parsing bails.
$ROLES = [
    ["bg1",          "--bg-primary"],
    ["bg2",          "--bg-secondary"],
    ["bg3",          "--bg-tertiary"],
    ["fg",           "--fg-primary"],
    ["fg_muted",     "--fg-muted"],
    ["accent",       "--accent"],
    ["accent_hover", "--accent-hover"]
]
$ROLE_EXCLUDE = []
$EXPECTED_ROLE_FIELDS = ["bg1", "bg2", "bg3", "fg", "fg_muted", "accent", "accent_hover"]
$EXPECTED_WEB_OK_CALLS = 84
$EXPECTED_STATUS_OK_CALLS = 6

$STATUS = [
    ["green", "--success"],
    ["amber", "--warning"],
    ["red",   "--danger"]
]

$ONIMAGE_OPAQUE = [
    ["accent",       "--accent-on-image"],
    ["accent_hover", "--accent-on-image-hover"]
]
$ONIMAGE_FG = "--accent-on-image-fg"
$ONIMAGE_GLOW = "--accent-on-image-glow"

-- Pinned image-ground arm set PER CLONE. Each configured set reflects that clone's
-- own markup, not one shared shape. A clone whose
-- substitution block does not match its pin EXACTLY — extra arm, missing arm, or block
-- absent — is exit 1, because an unpinned arm is how the substitution silently becomes
-- global (prefix `html.light,` and every context adopts the on-image accent). In
-- --file mode the arm set must match one pin; several pins matching means those pins
-- are the same set, not an ambiguity.

$SCHEMES = ["ocean", "crimson", "stone", "forest", "sunset", "mono"]
$SCHEME_RUST = ["Ocean", "Crimson", "Stone", "Forest", "Sunset", "Mono"]
$MODES = ["light", "dark"]
$MODE_RUST = ["Light", "Dark"]

-- Delivery coverage is selector + media environment, not merely semantic key.
-- The three status-bearing blocks are marked: status is required there, while
-- html.light inherits the light status anchors from :root.
$DELIVERIES = [
    { id: "ocean-light-default", sel: ":root",                    dark_media: false, scheme: "ocean",   mode: "light", status: true },
    { id: "ocean-dark-auto",     sel: ":root:not(.light)",        dark_media: true,  scheme: "ocean",   mode: "dark",  status: true },
    { id: "ocean-dark-forced",   sel: "html.dark",                dark_media: false, scheme: "ocean",   mode: "dark",  status: true },
    { id: "ocean-light-forced",  sel: "html.light",               dark_media: false, scheme: "ocean",   mode: "light", status: false },
    { id: "crimson-light",       sel: ".scheme-crimson:not(.dark)", dark_media: false, scheme: "crimson", mode: "light", status: false },
    { id: "crimson-dark",        sel: ".scheme-crimson.dark",       dark_media: false, scheme: "crimson", mode: "dark",  status: false },
    { id: "stone-light",         sel: ".scheme-stone:not(.dark)",   dark_media: false, scheme: "stone",   mode: "light", status: false },
    { id: "stone-dark",          sel: ".scheme-stone.dark",         dark_media: false, scheme: "stone",   mode: "dark",  status: false },
    { id: "forest-light",        sel: ".scheme-forest:not(.dark)",  dark_media: false, scheme: "forest",  mode: "light", status: false },
    { id: "forest-dark",         sel: ".scheme-forest.dark",        dark_media: false, scheme: "forest",  mode: "dark",  status: false },
    { id: "sunset-light",        sel: ".scheme-sunset:not(.dark)",  dark_media: false, scheme: "sunset",  mode: "light", status: false },
    { id: "sunset-dark",         sel: ".scheme-sunset.dark",        dark_media: false, scheme: "sunset",  mode: "dark",  status: false },
    { id: "mono-light",          sel: ".scheme-mono:not(.dark)",    dark_media: false, scheme: "mono",    mode: "light", status: false },
    { id: "mono-dark",           sel: ".scheme-mono.dark",          dark_media: false, scheme: "mono",    mode: "dark",  status: false }
]

$EXPECTED_ORACLE_ANCHORS = 135
$EXPECTED_PINNED_ANCHORS = 126
$EXPECTED_SITE_ANCHORS = 261
$EXPECTED_ONIMAGE_INVARIANTS = 28
$EXPECTED_ONIMAGE_CONSUMERS = 4
$EXPECTED_PALETTE_BLOCKS = 14
$EXPECTED_SERVICE_CARD_ANCHORS = 36
$EXPECTED_SWATCHES = 6

$SWATCH_ALIAS = { default: "ocean" }
-- Authorised, pinned literal exception: mono's picker dot is L50 rather than the
-- L25 mono/light accent. This is not derived from another token and is not skipped.
$SWATCH_EXCEPT = { mono: [50, 0, 0] }

-- Literal web-only roles absent from ctk. These values are the agreed result of
