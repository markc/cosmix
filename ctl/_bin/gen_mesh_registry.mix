#!/usr/bin/env mix
-- gen_mesh_registry.mix — generate the flat mesh-locator registry in a
-- private namespace repository.
--
--   mix _bin/gen_mesh_registry.mix [mesh] [--check]
--
-- The registry is a committed projection for locator/search tooling, not a
-- topology authority. Its roster and addresses come only from the verified
-- signed inventory; the filesystem contributes only each member's vnode path.
-- --check compares exact bytes without writing and is suitable for a hook.

$d = require("../_lib/deploy_lib.mix")

$mesh_arg = nil
$check = false
for each $arg in args()
  if $arg == "--check" then
    $check = true
  else
    if $mesh_arg != nil then
      print("usage: mix _bin/gen_mesh_registry.mix [mesh] [--check]")
      exit(2)
    end
    $mesh_arg = $arg
  end
end

$CONF_PATH = $d.hub_root() .. "/_etc/gen_mesh_registry.conf.mix"
if not is_file($CONF_PATH) then
  print("  ERROR: no gen_mesh_registry configuration at " .. $CONF_PATH)
  print("         copy _etc/gen_mesh_registry.conf.mix.example there and set expected_mesh and namespace_root")
  exit(2)
end

$loaded = nil
try
  $loaded = load_data($CONF_PATH)
catch $msg
  print("  ERROR: invalid strict-data config " .. $CONF_PATH .. ": " .. $msg)
  exit(2)
end
if type($loaded) != "map" or type($loaded["gen_mesh_registry"]) != "map" then
  print("  ERROR: " .. $CONF_PATH .. " must contain a gen_mesh_registry map")
  exit(2)
end
$CONF = $loaded["gen_mesh_registry"]
if $CONF["schema_version"] != 1 then
  print("  ERROR: " .. $CONF_PATH .. " needs gen_mesh_registry.schema_version: 1")
  exit(2)
end
$EXPECTED_MESH = $CONF["expected_mesh"]
if type($EXPECTED_MESH) != "string" or trim($EXPECTED_MESH) == "" then
  print("  ERROR: " .. $CONF_PATH .. " needs a non-empty gen_mesh_registry.expected_mesh")
  exit(2)
end
$NS_ROOT = $CONF["namespace_root"]
if type($NS_ROOT) != "string" or not starts_with($NS_ROOT, "/") then
  print("  ERROR: " .. $CONF_PATH .. " needs an absolute gen_mesh_registry.namespace_root")
  exit(2)
end
if not is_dir($NS_ROOT) then
  print("  ERROR: namespace repository is not a directory: " .. $NS_ROOT)
  exit(2)
end

-- mesh_lib owns authenticated inventory ingress, the freshness floor, the
-- mesh writer lock, and durable leaf publication.
$m = require("../_lib/mesh_lib.mix")

$HUB = $d.hub_root()
$SIGNED = $HUB .. "/_etc/mesh/inventory.signed"
$AUTHORED = $HUB .. "/_etc/mesh/inventory.mix"
$BASELINE = $HUB .. "/_etc/mesh/epoch.baseline.mix"
$OUT_DIR = $NS_ROOT .. "/_meshes"

-- A generating run holds the lock before its first authority read. Discovery
-- may take long enough for another mesh writer to advance the floor; without
-- this lock, stale topology could be published after that advance. --check
-- writes nothing, so it deliberately remains lock-free and may be re-run.
if not $check then
  $_lock = $m.mesh_take_write_lock("gen_mesh_registry")
end
$vi = $m.verified_inventory($SIGNED, {
  mesh: $EXPECTED_MESH,
  against_authored: $AUTHORED,
  baseline: $BASELINE
})
$inv = $vi["inventory"]
$mesh = $inv["mesh"]
if $mesh_arg != nil and $mesh_arg != $mesh then
  print("ERROR: requested mesh '" .. $mesh_arg .. "' != inventory mesh '" .. $mesh .. "' (single-inventory only for now)")
  exit(1)
end

-- Stamp the commit that last changed the authored inventory, rather than the
-- moving repository head, so unrelated control changes do not create drift.
$git = run_argv(["git", "-C", $HUB, "log", "-1", "--pretty=%h", "--", $AUTHORED])
$d.die_if($git["exit_code"] != 0,
  "could not identify inventory provenance: " .. trim($git["stderr"]))
$commit = trim($git["stdout"])
$d.die_if($commit == "", "inventory provenance query returned no commit")
$epoch = "" .. $inv["epoch"]

$doc = "<!-- GENERATED by gen_mesh_registry.mix — DO NOT EDIT -->\n"
$doc = $doc .. "<!-- source: VERIFIED " .. $SIGNED .. " @ control " .. $commit .. " (epoch " .. $epoch .. ") -->\n"
$doc = $doc .. "<!-- regenerate: mix " .. $HUB .. "/_bin/gen_mesh_registry.mix " .. $mesh .. " -->\n"
$doc = $doc .. "<!-- locator only: roster=signed inventory · operations=vnode journal · design=control hub -->\n\n"
$doc = $doc .. "# Mesh `" .. $mesh .. "` — node locator\n\n"
$doc = $doc .. "subnet `" .. $inv["subnet"] .. "` · hub `" .. join($inv["hub"], ", ") .. "` · epoch " .. $epoch .. "\n\n"
$doc = $doc .. "| node | " .. $mesh .. " address | wg ip | status | namespace vnode |\n"
$doc = $doc .. "|---|---|---|---|---|\n"

-- Vnodes are canonical at depth four (vsite/vcell/vserv/vnode). Restricting
-- discovery prevents a deeper vhost or shallower group with the same name
-- from being accepted. A generate run publishes a useful partial roster but
-- exits non-zero when any member is missing, ambiguous, or undiscoverable.
$anomalies = 0
for each $member in $inv["members"]
  $name = $member["name"]
  $find = run_argv(["find", $NS_ROOT, "-mindepth", "4", "-maxdepth", "4", "-type", "d", "-name", $name])
  $found = trim($find["stdout"])
  $path = "**MISSING — no namespace vnode**"
  if $find["exit_code"] != 0 then
    $anomalies = $anomalies + 1
    $path = "**DISCOVERY ERROR — vnode lookup failed**"
  else
    if $found == "" then
      $anomalies = $anomalies + 1
    else
      $lines = split($found, "\n")
      if length($lines) > 1 then
        $anomalies = $anomalies + 1
        $path = "**AMBIGUOUS — " .. ("" .. length($lines)) .. " vnodes named '" .. $name .. "'**"
      else
        $path = "`" .. $lines[0] .. "`"
      end
    end
  end
  $status = $member["status"]
  if not $member["bus"] then
    $status = $status .. " (transport-only)"
  end
  $doc = $doc .. "| " .. $name .. " | `" .. $name .. "." .. $mesh .. "` | " ..
    $member["mesh_ip"] .. " | " .. $status .. " | " .. $path .. " |\n"
end

$target = $OUT_DIR .. "/" .. $mesh .. ".md"
if $check then
  $existing = ""
  if is_file($target) then
    $existing = read_file($target)
  end
  if $existing == $doc then
    print("OK: " .. $target .. " matches inventory")
  else
    print("DRIFT: " .. $target .. " differs from generated output — run: mix " ..
      $HUB .. "/_bin/gen_mesh_registry.mix " .. $mesh)
    exit(1)
  end
  return
end

mkdir($OUT_DIR, {parents: true})
$m.write_leaf($target, $doc)
print("wrote " .. $target .. " (" .. ("" .. length($inv["members"])) ..
  " members, control " .. $commit .. ")")
if $anomalies > 0 then
  print("WARNING: " .. ("" .. $anomalies) ..
    " member(s) had missing, ambiguous, or failed vnode discovery — inspect the marked rows")
  exit(1)
end
