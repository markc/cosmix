#!/usr/bin/env mix
-- Bridge Syncthing events to non-retained Bus topics and expose two folder
-- control commands.
--
--   mix _bin/syncthing-bus-bridge.mix bridge
--   mix _bin/syncthing-bus-bridge.mix share-list
--   mix _bin/syncthing-bus-bridge.mix share-add <path> <label> <folder-id>

$d = require("../_lib/deploy_lib.mix")

fn refuse($message)
  print("  ERROR: " .. $message)
  exit(2)
end

fn usage()
  print("usage: mix _bin/syncthing-bus-bridge.mix bridge|share-list|share-add <path> <label> <folder-id>")
  exit(2)
end

-- Validate the command before reading workstation config or contacting
-- Syncthing. A malformed invocation must remain a side-effect-free refusal.
$argv = args()
if len($argv) == 0 then
  usage()
end
$cmd = $argv[0]
if $cmd == "bridge" or $cmd == "share-list" then
  if len($argv) != 1 then
    usage()
  end
elif $cmd == "share-add" then
  if len($argv) != 4 then
    usage()
  end
else
  refuse("unknown command '" .. $cmd .. "'")
end

$CONF_PATH = $d.hub_root() .. "/_etc/syncthing-bus-bridge.conf.mix"
if not is_file($CONF_PATH) then
  print("  ERROR: no Syncthing bridge config at " .. $CONF_PATH)
  print("         create it from syncthing-bus-bridge.conf.mix.example")
  exit(2)
end

$CONF = nil
try
  $loaded = load_data($CONF_PATH)
  $CONF = validate($loaded["syncthing_bus_bridge"], {
    schema_version: {type: "integer", enum: [1]},
    endpoint: {type: "string", nonblank: true},
    syncthing_config_path: {type: "string", nonblank: true},
    checkpoint_path: {type: "string", nonblank: true},
    conflict_marker: {type: "string", nonblank: true},
    status_topic: {type: "string", nonblank: true}
  })
catch $e
  print("  ERROR: invalid strict-data config " .. $CONF_PATH .. ": " .. $e)
  exit(2)
end

$ST = $CONF["endpoint"]
$CFG = $CONF["syncthing_config_path"]
$CKPT = $CONF["checkpoint_path"]
$CONFLICT_MARKER = $CONF["conflict_marker"]
$STATUS_TOPIC = $CONF["status_topic"]

if not starts_with($ST, "http://") and not starts_with($ST, "https://") then
  refuse($CONF_PATH .. ": endpoint must use http:// or https://")
end
if ends_with($ST, "/") then
  refuse($CONF_PATH .. ": endpoint must not end with '/'")
end
if not starts_with($CFG, "/") then
  refuse($CONF_PATH .. ": syncthing_config_path must be absolute")
end
if not starts_with($CKPT, "/") then
  refuse($CONF_PATH .. ": checkpoint_path must be absolute")
end
if not regex_match("^[A-Za-z0-9][A-Za-z0-9._-]*$", $STATUS_TOPIC) then
  refuse($CONF_PATH .. ": status_topic must be a Bus-safe topic name")
end

fn read_api_key($config_path)
  if not is_file($config_path) then
    print("  ERROR: Syncthing config not found: " .. $config_path)
    return ""
  end
  $xml = read_file($config_path)
  $open = "<apikey>"
  $close = "</apikey>"
  $p = pos($open, $xml)
  if $p == 0 then
    print("  ERROR: <apikey> not found in " .. $config_path)
    return ""
  end
  $start = ($p - 1) + len($open)
  $q = pos($close, $xml)
  if $q == 0 or ($q - 1) < $start then
    print("  ERROR: malformed <apikey> element in " .. $config_path)
    return ""
  end
  return trim(substr($xml, $start, ($q - 1) - $start))
end

fn st_get($endpoint, $key, $path, $timeout)
  return http_get($endpoint .. $path, {"X-API-Key": $key}, {timeout: $timeout})
end

fn st_put($endpoint, $key, $path, $body)
  return http_request("PUT", $endpoint .. $path, $body,
    {"X-API-Key": $key, "Content-Type": "application/json"},
    {timeout: 10})
end

fn response_error($response)
  $detail = $response["error"]
  if $detail == nil or trim("" .. $detail) == "" then
    return "no detail"
  end
  return "" .. $detail
end

fn load_since($checkpoint_path)
  if not is_file($checkpoint_path) then
    return 0
  end
  try
    $since = to_number(trim(read_file($checkpoint_path)))
    if $since < 0 then
      return 0
    end
    return $since
  catch $_e
    return 0
  end
end

fn save_since($checkpoint_path, $since)
  write_file($checkpoint_path, "" .. $since)
end

-- topic.publish carries a complete inner Bus message. Events are deliberately
-- non-retained: late subscribers must not mistake an old file event for a
-- current snapshot.
fn publish_event($topic, $body)
  $inner = "---\ncommand: " .. $topic .. "\n---\n" .. json_encode($body)
  send noded topic.publish name=$topic retain=false body=$inner timeout=10
  if $rc != 0 then
    print("  ERROR: Bus publish " .. $topic .. " failed (rc=" .. $rc .. "): " ..
      ("" .. $result))
    exit(1)
  end
end

fn translate($event, $conflict_marker, $status_topic)
  $event_type = $event["type"]
  $data = $event["data"]

  if $event_type == "ItemFinished" then
    $body = {folder: $data["folder"], path: $data["item"]}
    if contains($data["item"], $conflict_marker) then
      publish_event("file.conflict", $body)
    elif $data["action"] == "delete" then
      publish_event("file.deleted", $body)
    else
      publish_event("file.changed", $body)
    end
  elif $event_type == "StateChanged" then
    publish_event($status_topic, {
      folder: $data["folder"],
      state: $data["to"]
    })
  elif $event_type == "FolderSummary" then
    publish_event($status_topic, {
      folder: $data["folder"],
      summary: $data["summary"]
    })
  elif $event_type == "DeviceConnected" then
    publish_event("file.peer-status", {
      device: $data["id"],
      connected: true
    })
  elif $event_type == "DeviceDisconnected" then
    publish_event("file.peer-status", {
      device: $data["id"],
      connected: false
    })
  end
end

fn run_bridge($endpoint, $key, $checkpoint_path, $conflict_marker, $status_topic)
  mkdir(dirname($checkpoint_path), {parents: true})
  $since = load_since($checkpoint_path)
  print("bridge: starting from event id " .. $since)
  while true
    $path = "/rest/events?since=" .. $since .. "&timeout=60&limit=100"
    $response = st_get($endpoint, $key, $path, 65)
    if $response["status"] == 200 then
      $events = json_parse($response["body"])
      if type($events) != "list" then
        print("  ERROR: Syncthing events response was not a JSON list")
        exit(1)
      end
      for each $event in $events
        translate($event, $conflict_marker, $status_topic)
        $since = $event["id"]
      end
      save_since($checkpoint_path, $since)
    else
      print("bridge: poll failed status=" .. $response["status"] .. " " ..
        response_error($response))
      sleep(2)
    end
  end
end

$KEY = read_api_key($CFG)
if $KEY == "" then
  print("  ERROR: could not read Syncthing API key; is Syncthing configured?")
  exit(2)
end

if $cmd == "share-list" then
  $response = st_get($ST, $KEY, "/rest/config/folders", 10)
  if $response["status"] != 200 then
    print("  ERROR: share-list failed status=" .. $response["status"] .. " " ..
      response_error($response))
    exit(1)
  end
  print($response["body"])
elif $cmd == "share-add" then
  $path = $argv[1]
  $label = $argv[2]
  $folder_id = $argv[3]
  if not starts_with($path, "/") then
    refuse("share-add path must be absolute")
  end
  if trim($label) == "" or trim($folder_id) == "" then
    refuse("share-add label and folder-id must be non-empty")
  end
  $body = json_encode({
    id: $folder_id,
    label: $label,
    path: $path,
    type: "sendreceive"
  })
  $response = st_put($ST, $KEY,
    "/rest/config/folders/" .. url_encode($folder_id), $body)
  if $response["status"] < 200 or $response["status"] >= 300 then
    print("  ERROR: share-add failed status=" .. $response["status"] .. " " ..
      response_error($response))
    exit(1)
  end
  print("share-add status=" .. $response["status"])
else
  run_bridge($ST, $KEY, $CKPT, $CONFLICT_MARKER, $STATUS_TOPIC)
end
