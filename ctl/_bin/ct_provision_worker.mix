#!/usr/bin/env mix
-- ct_provision_worker.mix — claim one container job, provision it on a
-- configured Proxmox host, commit its DNS identity, verify it through a
-- reboot, then report the fenced terminal result.
--
-- The worker never opens the service database. It authenticates with the
-- dedicated provisiond secret and every apply is fenced by the claimed lease.
-- PVE nodes are foreign roster nodes reached by SSH alias; the DNS node may
-- be foreign or a mesh member. Every remote action is Mix source via ssh_mix.

$d = require("../_lib/deploy_lib.mix")
$prov = require("../_lib/provisiond_worker_lib.mix")

$CONF_PATH = $d.hub_root() .. "/_etc/ct_provision_worker.conf.mix"
if not is_file($CONF_PATH) then
  print("  ERROR: missing ct_provision_worker config: " .. $CONF_PATH)
  print("         copy _etc/ct_provision_worker.conf.mix.example there and replace every placeholder")
  exit(2)
end

$CONF = nil
try
  $loaded = load_data($CONF_PATH)
  $CONF = validate($loaded["ct_provision_worker"], {
    schema_version: {type: "integer", enum: [1]},
    default_base_url: {type: "string", nonblank: true},
    default_relid: {type: "string", nonblank: true},
    preseed_node_min_relid: {type: "string", nonblank: true},
    pve_hosts: {type: "list", min_length: 1,
      items: {type: "string", nonblank: true}},
    template_cache_dir: {type: "string", nonblank: true},
    release_root: {type: "string", nonblank: true},
    release_archive_name: {type: "string", nonblank: true},
    template_prefix: {type: "string", nonblank: true},
    template_suffix: {type: "string", nonblank: true},
    template_storage: {type: "string", nonblank: true},
    rootfs_storage: {type: "string", nonblank: true},
    network_bridge: {type: "string", nonblank: true},
    pct_features: {type: "string", nonblank: true},
    disk_gib: {type: "integer", min: 1},
    memory_mib: {type: "integer", min: 1},
    cores: {type: "integer", min: 1},
    ct_mount_root: {type: "string", nonblank: true},
    uid_shift_root: {type: "integer", min: 0},
    gid_shift_tls: {type: "integer", min: 0},
    description_prefix: {type: "string", nonblank: true},
    provision_ip_pool: {type: "list", min_length: 1, items: {
      type: "map", schema: {
        prefix: {type: "string", nonblank: true},
        first: {type: "integer", min: 0, max: 255},
        last: {type: "integer", min: 0, max: 255}
      }
    }},
    allowed_domains: {type: "list", min_length: 1,
      items: {type: "string", nonblank: true}},
    certificate_root: {type: "string", nonblank: true},
    certificate_fullchain_name: {type: "string", nonblank: true},
    certificate_private_key_name: {type: "string", nonblank: true},
    credential_fullchain_name: {type: "string", nonblank: true},
    credential_private_key_name: {type: "string", nonblank: true},
    dns_node: {type: "string", nonblank: true},
    dns_server: {type: "string", nonblank: true},
    preseed_nameserver: {type: "string", nonblank: true},
    dnsmasq_dropin: {type: "string", nonblank: true},
    dnsmasq_main_config: {type: "string", nonblank: true},
    dnsmasq_conf_dir: {type: "string", nonblank: true},
    dnsmasq_lease_file: {type: "string", nonblank: true},
    dnsmasq_service: {type: "string", nonblank: true},
    fault_ready_path: {type: "string", nonblank: true}
  })
catch $error
  print("  ERROR: invalid strict-data config " .. $CONF_PATH .. ": " .. $error)
  exit(2)
end

fn config_error($message)
  print("  ERROR: " .. $CONF_PATH .. ": " .. $message)
  exit(2)
end

fn has_item($items, $wanted)
  for each $item in $items
    if $item == $wanted then return true end
  end
  return false
end

fn safe_path($key, $path)
  $bad = not starts_with($path, "/")
  $bad = $bad or contains($path, "//")
  $bad = $bad or contains($path, "\n")
  $bad = $bad or contains($path, "\r")
  if $bad then
    config_error($key .. " must be a normalised one-line absolute path")
  end
  for each $part in split($path, "/")
    if $part == "." or $part == ".." then
      config_error($key .. " must not contain . or .. components")
    end
  end
  if not re_match($path, "^/[A-Za-z0-9._/-]+$") then
    config_error($key .. " contains an unsafe path character")
  end
  return $path
end

fn safe_token($key, $value)
  if not re_match($value, "^[A-Za-z0-9_.,:=@%+/-]+$") then
    config_error($key .. " contains a character unsafe for a remote command token")
  end
  return $value
end

fn valid_ipv4($address)
  $parts = split($address, ".")
  if len($parts) != 4 then return false end
  for each $part in $parts
    if not re_match($part, "^[0-9]{1,3}$") then return false end
    $octet = to_number($part)
    if $octet < 0 or $octet > 255 or ("" .. $octet) != $part then
      return false
    end
  end
  return true
end

fn valid_domain($domain)
  return len($domain) <= 245 and re_match($domain, "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$")
end

if not starts_with($CONF["default_base_url"], "http://") and not starts_with($CONF["default_base_url"], "https://") then
  config_error("default_base_url must start with http:// or https://")
end
if contains($CONF["default_base_url"], "\n") or contains($CONF["default_base_url"], "\r") then
  config_error("default_base_url must be one line")
end
for each $key in ["default_relid", "preseed_node_min_relid"]
  $value = $CONF[$key]
  if not re_match($value, "^[A-Za-z0-9][A-Za-z0-9._-]*$") or contains($value, "..") then
    config_error($key .. " must be a slug without '..'")
  end
end

$PATH_KEYS = [
  "template_cache_dir", "release_root", "ct_mount_root",
  "certificate_root", "dnsmasq_dropin", "dnsmasq_main_config",
  "dnsmasq_conf_dir", "dnsmasq_lease_file", "fault_ready_path"
]
for each $key in $PATH_KEYS
  $_path = safe_path($key, $CONF[$key])
end
$TOKEN_KEYS = [
  "release_archive_name", "template_prefix", "template_suffix",
  "template_storage", "rootfs_storage", "network_bridge", "pct_features",
  "description_prefix", "certificate_fullchain_name",
  "certificate_private_key_name", "credential_fullchain_name",
  "credential_private_key_name", "dnsmasq_service"
]
for each $key in $TOKEN_KEYS
  $_token = safe_token($key, $CONF[$key])
end
if not valid_ipv4($CONF["dns_server"]) or not valid_ipv4($CONF["preseed_nameserver"]) then
  config_error("dns_server and preseed_nameserver must be canonical IPv4 addresses")
end
for each $domain in $CONF["allowed_domains"]
  if not valid_domain($domain) then
    config_error("allowed_domains contains an invalid DNS name: " .. $domain)
  end
end
for each $range in $CONF["provision_ip_pool"]
  $bad_prefix = not re_match($range["prefix"], "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.$")
  $bad_prefix = $bad_prefix or not valid_ipv4($range["prefix"] .. "0")
  if $bad_prefix then
    config_error("provision_ip_pool prefix must be a canonical IPv4 /24 prefix")
  end
  if $range["first"] > $range["last"] then
    config_error("provision_ip_pool range first must not exceed last")
  end
end

$ROSTER = $d.roster()
$seen_pve = []
for each $host in $CONF["pve_hosts"]
  if not re_match($host, "^[A-Za-z0-9][A-Za-z0-9_.-]*$") then
    config_error("PVE host is not a safe roster/SSH name: " .. $host)
  end
  if has_item($seen_pve, $host) then
    config_error("duplicate PVE host: " .. $host)
  end
  push($seen_pve, $host)
  $d.assert_node($ROSTER, $host)
  if not $d.is_foreign($ROSTER, $host) then
    config_error("PVE host '" .. $host .. "' must be foreign in the fleet roster")
  end
end
if not re_match($CONF["dns_node"], "^[A-Za-z0-9][A-Za-z0-9_.-]*$") then
  config_error("dns_node is not a safe roster/SSH name")
end
$d.assert_node($ROSTER, $CONF["dns_node"])
$DNS_REMOTE = $CONF["dns_node"]
if not $d.is_foreign($ROSTER, $CONF["dns_node"]) then
  $DNS_REMOTE = "root@" .. $d.mesh_ip($CONF["dns_node"])
end

$g = getopt(args(), {
  "base-url": {arg: true},
  "secret-file": {arg: true},
  "drain-mode": {arg: false},
  preclaimed: {arg: false},
  relid: {arg: true}
})
if len($g["errors"]) != 0 then
  print("bad options: " .. join($g["errors"], "; "))
  exit(2)
end

$BASE = env("CT_BASE_URL")
if $BASE == "" then $BASE = $CONF["default_base_url"] end
if $g["opts"]["base-url"] != nil then
  $BASE = "" .. $g["opts"]["base-url"]
end
$bad_base = not starts_with($BASE, "http://") and not starts_with($BASE, "https://")
$bad_base = $bad_base or contains($BASE, "\n") or contains($BASE, "\r")
if $bad_base then
  print("--base-url/CT_BASE_URL must be a one-line HTTP(S) URL")
  exit(2)
end

$RELID = env("CT_RELID")
if $RELID == "" then $RELID = $CONF["default_relid"] end
if $g["opts"]["relid"] != nil then $RELID = "" .. $g["opts"]["relid"] end
if not re_match($RELID, "^[A-Za-z0-9][A-Za-z0-9._-]*$") or contains($RELID, "..") then
  print("--relid/CT_RELID must be a slug without '..': '" .. $RELID .. "'")
  exit(2)
end

$DRAIN_MODE = $g["opts"]["drain-mode"] == true
$PRECLAIMED = $g["opts"]["preclaimed"] == true
$SECRET = $prov.load_secret($g["opts"]["secret-file"])
$HEADERS = {"X-Provision-Secret": $SECRET}

fn drain_exit($outcome)
  $prov.drain_exit($outcome, $DRAIN_MODE)
end

$job = nil
if $PRECLAIMED then
  try
    $envelope = json_parse(read_stdin())
    $spec = $envelope["spec"]
    if $spec == nil then $spec = {} end
    $job = {
      job_id: $envelope["job_id"],
      lease_token: $envelope["lease_token"],
      service_id: $envelope["service_id"],
      pve_host: $spec["pve_host"],
      node_name: $spec["node_name"],
      domain: $spec["domain"],
      ip: $spec["ip"]
    }
  catch $error
    print("bad preclaimed envelope json: " .. $error)
    exit(1)
  end
else
  $claim = nil
  $claim_status = 0
  $tries = 0
  while $tries < 25
    $claim = http_get($BASE .. "/biz/provision-claim", $HEADERS, {timeout: 10})
    $claim_status = to_number($claim["status"])
    if $claim_status != 202 then break end
    $tries = $tries + 1
  end
  if $claim_status == 204 then drain_exit("empty") end
  if $claim_status == 202 then
    print("provision claim still hitting the poison bound (202) after 25 retries — aborting")
    exit(1)
  end
  if $claim_status != 200 then
    print("provision claim failed: " .. ("" .. $claim["status"]) ..
      " " .. ("" .. $claim["error"]))
    exit(1)
  end
  try
    $job = json_parse($claim["body"])
  catch $error
    print("bad claim json: " .. $error)
    exit(1)
  end
end

try
  validate($job, {
    job_id: {type: "integer", min: 1},
    service_id: {type: "integer", min: 1},
    lease_token: {type: "string", nonblank: true},
    pve_host: {type: "string", nonblank: true},
    node_name: {type: "string"},
    ip: {type: "string", nonblank: true},
    domain: {type: "string", nonblank: true}
  })
catch $message, $error
  print("bad claim job (" .. $error["code"] .. " at " ..
    $error["details"]["path"] .. "): " .. $message)
  exit(1)
end

$JOB_ID = $job["job_id"]
$LEASE_TOKEN = "" .. $job["lease_token"]
$SERVICE_ID = $job["service_id"]
$PVE = $job["pve_host"]
$PVE_REMOTE = $PVE
$NODE_NAME = $job["node_name"]
$IP = $job["ip"]
$DOMAIN = $job["domain"]
$VMID = ""
$FQDN = ""

-- Run one argv-shaped command through a literal remote Mix program. The
-- allowlist preserves the old argv-inert boundary before joining tokens for
-- run(), and bindings keep job/config values out of source construction.
fn remote_exec($host, $argv, $timeout)
  return ssh_mix($host, '
for each $arg in $argv
  if not re_match($arg, "^[A-Za-z0-9_./,:=@%+~-]+$") then
    eprint("unsafe remote command token refused")
    exit(125)
  end
end
$output = run(join($argv, " "), {timeout: $command_timeout})
$code = $rc
if $code != 0 then
  eprint($output)
  exit($code)
end
print($output)
', {bindings: {argv: $argv, command_timeout: $timeout},
    connect_timeout: 8, timeout: $timeout + 15, batch: true})
end

fn exec_err($result)
  $text = trim($result["stderr"])
  if trim($result["stdout"]) != "" then
    if $text != "" then $text = $text .. " " end
    $text = $text .. trim($result["stdout"])
  end
  if $result["exit_code"] != nil then
    $text = $text .. " (exit " .. $result["exit_code"] .. ")"
  end
  return trim($text)
end

fn post_apply($payload)
  $prov.post_apply($BASE, $SECRET, $JOB_ID, $LEASE_TOKEN, $payload,
    "provision_ct")
end

fn progress($step)
  post_apply({
    job_id: $JOB_ID, step: $step, node: $NODE_NAME, vmid: $VMID,
    ip: $IP, fqdn: $FQDN
  })
end

$FAULT_POINT = env("PROVISIOND_FAULT_POINT")
fn fault_hook($point)
  if $FAULT_POINT == "" or $FAULT_POINT != $point then return end
  write_file($CONF["fault_ready_path"], $point .. " job=" .. $JOB_ID ..
    " vmid=" .. $VMID .. " fqdn=" .. $FQDN .. "\n")
  print("FAULT HOOK armed at " .. $point .. " (job " .. $JOB_ID ..
    ", vmid " .. $VMID .. ") — sleeping for SIGKILL")
  sleep(900)
end

fn fail_job($step, $message)
  $cleanup = ""
  $clean = true
  if $step == "dns" or $step == "starting" or $step == "verifying" then
    $clean = false
  end
  if $VMID != "" then
    $_unmount = remote_exec($PVE_REMOTE, ["pct", "unmount", $VMID], 60)
    $destroy = remote_exec($PVE_REMOTE,
      ["pct", "destroy", $VMID, "--force"], 120)
    if not $destroy["ok"] then
      $clean = false
      $cleanup = " [CLEANUP INCOMPLETE: pct destroy " .. $VMID .. " on " ..
        $PVE .. " failed: " .. exec_err($destroy) ..
        " — CT may be orphaned, manual teardown required]"
    end
  end
  post_apply({
    job_id: $JOB_ID, ok: false, step: $step, cleanup_clean: $clean,
    fqdn: $FQDN, error: $message .. $cleanup, vmid: $VMID, ip: $IP
  })
  print("provision failed job " .. $JOB_ID .. ": " .. $message .. $cleanup)
  drain_exit("processed_failed")
end

fn fail_collision($message)
  post_apply({
    job_id: $JOB_ID, ok: false, step: "cloning", cleanup_clean: false,
    fqdn: $FQDN, error: $message, ip: $IP
  })
  print("provision aborted job " .. $JOB_ID .. ": " .. $message)
  drain_exit("processed_failed")
end

fn must_argv($argv, $step)
  $result = run_argv($argv, {timeout: 180})
  if $result["exit_code"] != 0 then
    fail_job($step, "failed: " .. join($argv, " ") .. " :: " ..
      exec_err($result))
  end
  return trim($result["stdout"])
end

fn remote_must($host, $argv, $step, $timeout)
  $result = remote_exec($host, $argv, $timeout)
  if not $result["ok"] then
    fail_job($step, "remote " .. $host .. " failed: " .. join($argv, " ") ..
      " :: " .. exec_err($result))
  end
  return trim($result["stdout"])
end

-- Create the destination with its final ownership/mode before writing secret
-- bytes, then prove exact byte identity and mode in the same remote process.
fn remote_write($host, $dest, $bytes, $mode_text, $mode_value, $owner, $group,
    $step)
  $result = ssh_mix($host, '
for each $token in [$dest, $mode_text, $owner, $group]
  if not re_match($token, "^[A-Za-z0-9_./:-]+$") then
    eprint("unsafe remote-write token refused")
    exit(125)
  end
end
$output = run("install -m " .. $mode_text .. " -o " .. $owner .. " -g " ..
  $group .. " /dev/null " .. $dest, {timeout: 15})
if $rc != 0 then eprint($output); exit($rc) end
write_file($dest, $bytes)
chmod($dest, $mode_value)
$landed = read_file($dest)
if byte_length($landed) != byte_length($bytes) or $landed != $bytes then
  eprint("remote write byte-identity mismatch")
  exit(7)
end
$info = stat($dest)
if $info["perm"] != $mode_value then
  eprint("remote write mode mismatch")
  exit(8)
end
if $info["uid"] != to_number($owner) or $info["gid"] != to_number($group) then
  eprint("remote write ownership mismatch")
  exit(9)
end
print("write-ok")
', {bindings: {
      dest: $dest, bytes: $bytes, mode_text: $mode_text,
      mode_value: $mode_value, owner: "" .. $owner, group: "" .. $group
    }, connect_timeout: 8, timeout: 60, batch: true})
  if not $result["ok"] then
    fail_job($step, "remote write " .. $dest .. " on " .. $host ..
      " failed: " .. exec_err($result))
  end
end

fn shortname($mac)
  if not re_match($mac, "^[0-9A-Fa-f:]{17}$") then
    fail_job("cloning", "bad MAC shape: '" .. $mac .. "'")
  end
  $hex = replace(lower($mac), ":", "")
  return "n" .. substr($hex, len($hex) - 5, 5)
end

$READY_WAIT = 180
$HEARTBEAT_SECS = 30

fn wait_running($vmid)
  $deadline = time() + $READY_WAIT
  $next_heartbeat = time() + $HEARTBEAT_SECS
  $last = "unknown"
  while time() < $deadline
    $result = remote_exec($PVE_REMOTE,
      ["pct", "exec", $vmid, "--", "systemctl", "is-system-running"], 15)
    $last = trim($result["stdout"])
    if $last == "running" then return "running" end
    sleep(1)
    if time() >= $next_heartbeat then
      progress("verifying")
      $next_heartbeat = time() + $HEARTBEAT_SECS
    end
  end
  return $last
end

fn count_failed($vmid)
  $raw = remote_must($PVE_REMOTE,
    ["pct", "exec", $vmid, "--", "systemctl", "--failed", "--no-legend"],
    "verifying", 30)
  $count = 0
  for each $line in split($raw, "\n")
    if trim($line) != "" then $count = $count + 1 end
  end
  return $count
end

fn probe($vmid, $fqdn)
  $state = wait_running($vmid)
  $failed = count_failed($vmid)
  $code = "000"
  $https_error = ""
  $deadline = time() + $READY_WAIT
  $next_heartbeat = time() + $HEARTBEAT_SECS
  while time() < $deadline and $code != "200"
    $result = http_get("https://" .. $fqdn .. "/", {}, {timeout: 10})
    $code = "" .. $result["status"]
    $https_error = ""
    if $result["error"] != nil then $https_error = "" .. $result["error"] end
    if $code != "200" then
      sleep(1)
      if time() >= $next_heartbeat then
        progress("verifying")
        $next_heartbeat = time() + $HEARTBEAT_SECS
      end
    end
  end
  return {
    state: $state, failed: $failed, https: $code, https_error: $https_error
  }
end

fn verify_probe($phase, $probe)
  $bad = []
  if $probe["state"] != "running" then
    push($bad, "state=" .. $probe["state"] .. " (want running)")
  end
  if $probe["failed"] != 0 then
    push($bad, $probe["failed"] .. " failed unit(s)")
  end
  if $probe["https"] != "200" then
    $message = "HTTPS=" .. $probe["https"] .. " (want 200, validated chain)"
    if $probe["https_error"] != "" then
      $message = $message .. ": " .. $probe["https_error"]
    end
    push($bad, $message)
  end
  if len($bad) != 0 then
    fail_job("verifying", "[" .. $phase .. "] VERIFY FAIL: " ..
      join($bad, "; "))
  end
end

fn ip_is_allowed($address)
  for each $range in $CONF["provision_ip_pool"]
    if starts_with($address, $range["prefix"]) then
      $suffix = substr($address, len($range["prefix"]), len($address))
      if re_match($suffix, "^[0-9]{1,3}$") then
        $octet = to_number($suffix)
        if ("" .. $octet) == $suffix and $octet >= $range["first"] and $octet <= $range["last"] then
          return true
        end
      end
    end
  end
  return false
end

if not has_item($CONF["pve_hosts"], $PVE) then
  fail_job("cloning", "pve_host is not in the configured PVE host set: '" ..
    $PVE .. "'")
end
if not ip_is_allowed($IP) then
  fail_job("cloning", "ip is outside the configured provision_ip_pool: '" ..
    $IP .. "'")
end
if not valid_domain($DOMAIN) then
  fail_job("cloning", "domain is not a valid DNS name: '" .. $DOMAIN .. "'")
end
if not has_item($CONF["allowed_domains"], $DOMAIN) then
  fail_job("cloning", "domain is not in allowed_domains: '" .. $DOMAIN .. "'")
end
if $NODE_NAME != "" and $RELID < $CONF["preseed_node_min_relid"] then
  fail_job("cloning", "node_name must be blank for template " .. $RELID ..
    " because explicit names require release >= " ..
    $CONF["preseed_node_min_relid"] .. ". Got: '" .. $NODE_NAME .. "'")
end
if $NODE_NAME != "" and not re_match($NODE_NAME, "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$") then
  fail_job("cloning", "node_name is not a DNS label: '" .. $NODE_NAME .. "'")
end
if $NODE_NAME != "" and len($NODE_NAME .. "." .. $DOMAIN) > 253 then
  fail_job("cloning", "explicit node_name + domain exceeds the 253-character FQDN limit: '" ..
    $NODE_NAME .. "." .. $DOMAIN .. "'")
end

-- Reach every host that the collision scan or DNS commit can touch before the
-- first provisioning mutation. Each challenge is invocation-specific.
for each $host in $CONF["pve_hosts"]
  $token = uuid()
  $reach = ssh_mix($host, 'print("CT_REACH " .. $token)', {
    bindings: {token: $token}, connect_timeout: 8, timeout: 15, batch: true
  })
  if not $reach["ok"] or trim($reach["stdout"]) != "CT_REACH " .. $token then
    fail_job("cloning", $host .. " unreachable or has no working system Mix: " ..
      exec_err($reach))
  end
end
$dns_token = uuid()
$dns_reach = ssh_mix($DNS_REMOTE, 'print("CT_DNS_REACH " .. $token)', {
  bindings: {token: $dns_token}, connect_timeout: 8, timeout: 15, batch: true
})
if not $dns_reach["ok"] or trim($dns_reach["stdout"]) != "CT_DNS_REACH " .. $dns_token then
  fail_job("cloning", $CONF["dns_node"] ..
    " unreachable or has no working system Mix: " .. exec_err($dns_reach))
end

$template = $CONF["template_prefix"] .. $RELID .. $CONF["template_suffix"]
$_template = safe_token("derived template name", $template)
$certificate_dir = $CONF["certificate_root"] .. "/" .. $DOMAIN
$CERT_FULLCHAIN = $certificate_dir .. "/" ..
  $CONF["certificate_fullchain_name"]
$CERT_PRIVKEY = $certificate_dir .. "/" ..
  $CONF["certificate_private_key_name"]
$credential_dir = env("CREDENTIALS_DIRECTORY")
if $credential_dir != "" then
  $credential_fullchain = $credential_dir .. "/" ..
    $CONF["credential_fullchain_name"]
  $credential_privkey = $credential_dir .. "/" ..
    $CONF["credential_private_key_name"]
  if is_file($credential_fullchain) then
    $CERT_FULLCHAIN = $credential_fullchain
    $CERT_PRIVKEY = $credential_privkey
  end
end
if not is_file($CERT_FULLCHAIN) or stat($CERT_FULLCHAIN)["size"] == 0 then
  fail_job("cloning", "certificate fullchain is missing or empty (" ..
    $CERT_FULLCHAIN .. ")")
end
if not is_file($CERT_PRIVKEY) or stat($CERT_PRIVKEY)["size"] == 0 then
  fail_job("cloning", "certificate private key is missing or empty (" ..
    $CERT_PRIVKEY .. ")")
end

progress("staging")
$remote_template = $CONF["template_cache_dir"] .. "/" .. $template
$cached = remote_exec($PVE_REMOTE, ["test", "-f", $remote_template], 15)
if not $cached["ok"] then
  $release = $CONF["release_root"] .. "/" .. $RELID .. "/" ..
    $CONF["release_archive_name"]
  if not is_file($release) then
    fail_job("cloning", "release rootfs not found: " .. $release)
  end
  $copy = run_argv([
    "scp", "-q", "-o", "BatchMode=yes", $release,
    $PVE_REMOTE .. ":" .. $remote_template
  ], {timeout: 900})
  if $copy["exit_code"] != 0 then
    fail_job("cloning", "release upload to " .. $PVE ..
      " failed (or exceeded 15m): " .. exec_err($copy))
  end
  $local_hash_result = run_argv(["sha256sum", $release], {timeout: 180})
  if $local_hash_result["exit_code"] != 0 then
    fail_job("cloning", "could not hash release rootfs: " ..
      exec_err($local_hash_result))
  end
  $remote_hash_result = remote_exec($PVE_REMOTE,
    ["sha256sum", $remote_template], 180)
  if not $remote_hash_result["ok"] then
    fail_job("cloning", "could not hash uploaded release rootfs: " ..
      exec_err($remote_hash_result))
  end
  $local_hash = split(trim($local_hash_result["stdout"]), " ")[0]
  $remote_hash = split(trim($remote_hash_result["stdout"]), " ")[0]
  if $local_hash == "" or $remote_hash != $local_hash then
    fail_job("cloning", "release upload byte-identity check failed")
  end
end

fn description_value($line)
  $value = trim(substr(trim($line), 12, len(trim($line))))
  if ends_with($value, "%0A") then
    $value = trim(substr($value, 0, len($value) - 3))
  end
  return $value
end

progress("cloning")
$description = $CONF["description_prefix"] .. $JOB_ID
$SCAN_DEADLINE = time() + 300
$scan_heartbeat = time() + $HEARTBEAT_SECS
$hits = []
for each $host in $CONF["pve_hosts"]
  $listing = remote_exec($host, ["pct", "list"], 20)
  if not $listing["ok"] then
    fail_collision("fleet list on " .. $host .. " failed (uncertain): " ..
      exec_err($listing))
  end
  for each $line in split($listing["stdout"], "\n")
    if time() > $SCAN_DEADLINE then
      fail_collision("fleet collision scan exceeded its 300s budget — treating the incomplete scan as uncertain")
    end
    if time() >= $scan_heartbeat then
      progress("cloning")
      $scan_heartbeat = time() + $HEARTBEAT_SECS
    end
    $candidate_vmid = split(trim($line), " ")[0]
    if re_match($candidate_vmid, "^[0-9]+$") then
      $candidate = remote_exec($host,
        ["pct", "config", $candidate_vmid], 15)
      if not $candidate["ok"] then
        fail_collision("pct config " .. $candidate_vmid .. " on " .. $host ..
          " failed (uncertain): " .. exec_err($candidate))
      end
      for each $config_line in split($candidate["stdout"], "\n")
        if starts_with(trim($config_line), "description:") and description_value($config_line) == $description then
          push($hits, $host .. ":" .. $candidate_vmid)
        end
      end
    end
  end
end
if len($hits) > 0 then
  fail_collision("a CT for this job already exists (" .. join($hits, ", ") ..
    ") — not building a duplicate; reconcile required")
end

$VMID = remote_must($PVE_REMOTE,
  ["pvesh", "get", "/cluster/nextid"], "cloning", 30)
if not re_match($VMID, "^[0-9]+$") then
  fail_job("cloning", "pvesh nextid returned an invalid VMID: '" .. $VMID .. "'")
end
remote_must($PVE_REMOTE, [
  "pct", "create", $VMID,
  $CONF["template_storage"] .. ":vztmpl/" .. $template,
  "--ostype", "unmanaged", "--unprivileged", "1",
  "--features", $CONF["pct_features"],
  "--net0", "name=eth0,bridge=" .. $CONF["network_bridge"] .. ",ip=dhcp",
  "--rootfs", $CONF["rootfs_storage"] .. ":" .. $CONF["disk_gib"],
  "--cores", "" .. $CONF["cores"],
  "--memory", "" .. $CONF["memory_mib"],
  "--onboot", "1", "--description", $description
], "cloning", 180)

$config_raw = remote_must($PVE_REMOTE,
  ["pct", "config", $VMID], "cloning", 30)
$mac = ""
for each $line in split($config_raw, "\n")
  if contains($line, "hwaddr=") then
    $parts = split($line, "hwaddr=")
    if len($parts) > 1 then $mac = split($parts[1], ",")[0] end
  end
end
if $mac == "" then
  fail_job("cloning", "pct config did not contain a net0 hwaddr")
end
$derived = shortname($mac)
if $NODE_NAME == "" then $NODE_NAME = $derived end
$FQDN = $NODE_NAME .. "." .. $DOMAIN
remote_must($PVE_REMOTE,
  ["pct", "set", $VMID, "--hostname", $NODE_NAME], "cloning", 30)

progress("preseeding")
fault_hook("post_create_pre_dns")
$fullchain = read_file($CERT_FULLCHAIN)
$private_key = read_file($CERT_PRIVKEY)
if byte_length($fullchain) == 0 or byte_length($private_key) == 0 then
  fail_job("preseeding", "staged certificate material is empty")
end
$mounted = remote_exec($PVE_REMOTE, ["pct", "mount", $VMID], 60)
if not $mounted["ok"] then
  fail_job("preseeding", "pct mount " .. $VMID .. " failed: " ..
    exec_err($mounted))
end
$mount = $CONF["ct_mount_root"] .. "/" .. $VMID .. "/rootfs"
$ssl_dir = $mount .. "/etc/ssl/" .. $FQDN
$preseed = data_encode({
  domain: $DOMAIN, nameserver: $CONF["preseed_nameserver"], node: $NODE_NAME
}) .. "\n"
$shift_root = "" .. $CONF["uid_shift_root"]
$shift_tls = "" .. $CONF["gid_shift_tls"]
remote_must($PVE_REMOTE, [
  "install", "-d", "-o", $shift_root, "-g", $shift_root, "-m", "0755",
  $mount .. "/etc/cosmix"
], "preseeding", 30)
remote_must($PVE_REMOTE, [
  "install", "-d", "-o", $shift_root, "-g", $shift_root, "-m", "0755",
  $ssl_dir
], "preseeding", 30)
remote_write($PVE_REMOTE, $mount .. "/etc/cosmix/preseed.conf.mix", $preseed,
  "0644", 0o644, $shift_root, $shift_root, "preseeding")
remote_write($PVE_REMOTE, $ssl_dir .. "/" ..
  $CONF["certificate_fullchain_name"], $fullchain,
  "0644", 0o644, $shift_root, $shift_root, "preseeding")
remote_write($PVE_REMOTE, $ssl_dir .. "/" ..
  $CONF["certificate_private_key_name"], $private_key,
  "0640", 0o640, $shift_root, $shift_tls, "preseeding")
remote_must($PVE_REMOTE, ["pct", "unmount", $VMID], "preseeding", 60)

progress("dns")
-- One remote process owns the complete candidate-test, install, full-test,
-- restart and rollback transaction. Splitting it would expose half-applied
-- DNS/DHCP state between SSH calls.
$DNS_APPLY_TOKEN = uuid()
$dns_apply = ssh_mix($DNS_REMOTE, '
fn fail($message)
  eprint($message)
  exit(1)
end

for each $path in [$dropin, $main_config, $conf_dir, $lease_file]
  if not re_match($path, "^/[A-Za-z0-9._/-]+$") then
    fail("unsafe configured dnsmasq path")
  end
end
if not re_match($service, "^[A-Za-z0-9_.@-]+$") then
  fail("unsafe configured dnsmasq service")
end

$header = "# Provisioned containers — one DHCP host, A/PTR record and MX record per CT.\n"
$original = $header
if is_file($dropin) then $original = read_file($dropin) end
for each $line in split($original, "\n")
  if starts_with($line, "host-record=" .. $fqdn .. ",") or starts_with($line, "mx-host=" .. $fqdn .. ",") then
    fail($fqdn .. " already registered")
  end
  if contains($line, "," .. $ip) then
    fail($ip .. " already reserved")
  end
end

$candidate = $original .. "dhcp-host=" .. $mac .. "," .. $ip ..
  "\nhost-record=" .. $fqdn .. "," .. $ip ..
  "\nmx-host=" .. $fqdn .. "," .. $fqdn .. ",10\n"
$temporary = "/tmp/ct-dns-" .. uuid() .. ".conf"
write_file($temporary, $candidate)
chmod($temporary, 0o644)
$output = run("dnsmasq --test --conf-file=" .. $temporary, {timeout: 20})
if $rc != 0 then
  remove($temporary)
  fail("candidate dnsmasq test failed: " .. trim($output))
end
copy($temporary, $dropin)
remove($temporary)
chmod($dropin, 0o644)

$output = run("dnsmasq --test -C " .. $main_config .. " --conf-dir=" ..
  $conf_dir, {timeout: 20})
if $rc != 0 then
  write_file($dropin, $original)
  chmod($dropin, 0o644)
  fail("full dnsmasq test failed; config rolled back: " .. trim($output))
end

$lease_original = ""
if is_file($lease_file) then $lease_original = read_file($lease_file) end
$output = run("systemctl stop " .. $service, {timeout: 20})
if $rc != 0 then
  write_file($dropin, $original)
  chmod($dropin, 0o644)
  fail("dnsmasq stop failed; config rolled back: " .. trim($output))
end

if $lease_original != "" then
  $kept = []
  for each $line in split($lease_original, "\n")
    if $line != "" and not contains($line, " " .. $ip .. " ") and not contains(lower($line), lower($mac)) then
      push($kept, $line)
    end
  end
  write_file($lease_file, join($kept, "\n") .. "\n")
end

$output = run("systemctl start " .. $service, {timeout: 20})
if $rc != 0 then
  write_file($dropin, $original)
  chmod($dropin, 0o644)
  if $lease_original != "" then write_file($lease_file, $lease_original) end
  $_restart = run("systemctl start " .. $service, {timeout: 20})
  fail("dnsmasq start failed; config and lease rolled back: " .. trim($output))
end
print("DNS_COMMIT_OK " .. $token)
', {bindings: {
    dropin: $CONF["dnsmasq_dropin"],
    main_config: $CONF["dnsmasq_main_config"],
    conf_dir: $CONF["dnsmasq_conf_dir"],
    lease_file: $CONF["dnsmasq_lease_file"],
    service: $CONF["dnsmasq_service"],
    mac: $mac, ip: $IP, fqdn: $FQDN, token: $DNS_APPLY_TOKEN
  }, connect_timeout: 8, timeout: 60, batch: true})
$dns_marker_ok = trim($dns_apply["stdout"]) == "DNS_COMMIT_OK " .. $DNS_APPLY_TOKEN
if not $dns_apply["ok"] or not $dns_marker_ok then
  fail_job("dns", "remote DNS transaction on " .. $CONF["dns_node"] ..
    " failed: " .. exec_err($dns_apply))
end

fault_hook("post_dns_commit")
remote_must($DNS_REMOTE,
  ["systemctl", "is-active", $CONF["dnsmasq_service"]], "dns", 15)
$answer = must_argv([
  "dig", "+short", "@" .. $CONF["dns_server"], $FQDN
], "dns")
if $answer != $IP then
  fail_job("dns", "configured DNS server did not serve " .. $FQDN ..
    " -> " .. $IP .. " (got '" .. $answer .. "')")
end
$mx = must_argv([
  "dig", "+short", "@" .. $CONF["dns_server"], "MX", $FQDN
], "dns")
if pos($FQDN, $mx) == 0 then
  fail_job("dns", "configured DNS server did not serve MX for " .. $FQDN ..
    " (got '" .. $mx .. "')")
end
$ptr = must_argv([
  "dig", "+short", "@" .. $CONF["dns_server"], "-x", $IP
], "dns")
if pos($FQDN, $ptr) == 0 then
  fail_job("dns", "configured DNS server did not serve PTR " .. $IP ..
    " -> " .. $FQDN .. " (got '" .. $ptr .. "')")
end

progress("starting")
remote_must($PVE_REMOTE, ["pct", "start", $VMID], "starting", 120)

progress("verifying")
verify_probe("boot", probe($VMID, $FQDN))
$node_config = remote_must($PVE_REMOTE, [
  "pct", "exec", $VMID, "--", "cat", "/etc/cosmix/node.conf.mix"
], "verifying", 30)
$double_quote = '"'
if pos($double_quote .. $FQDN .. $double_quote, $node_config) == 0 then
  fail_job("verifying", "appliance node.conf.mix lacks fqdn " .. $FQDN ..
    " — firstboot identity is unproven: " .. $node_config)
end
$address = remote_must($PVE_REMOTE, [
  "pct", "exec", $VMID, "--", "ip", "-4", "-br", "addr", "show", "eth0"
], "verifying", 30)
if pos($IP .. "/", $address) == 0 then
  fail_job("verifying", "CT eth0 lacks reserved IP " .. $IP ..
    " (reservation not honoured?): " .. $address)
end
$wireguard = remote_exec($PVE_REMOTE, [
  "pct", "exec", $VMID, "--", "ip", "link", "show", "wg0"
], 15)
if $wireguard["ok"] then
  fail_job("verifying", "wg0 exists — provisioned edge CTs must be standalone")
end
$smtp_result = run_argv([
  "curl", "-s", "--max-time", "5", "telnet://" .. $IP .. ":25"
], {timeout: 10})
$smtp = $smtp_result["stdout"]
if $smtp_result["exit_code"] != 0 or pos("220", $smtp) == 0 or pos($FQDN, $smtp) == 0 then
  fail_job("verifying", "no SMTP 220/" .. $FQDN .. " banner from " .. $IP ..
    ":25 — service not reachable or wrong host: '" .. trim($smtp) .. "'")
end
remote_must($PVE_REMOTE, ["pct", "shutdown", $VMID], "verifying", 120)
$stopped_result = remote_exec($PVE_REMOTE, ["pct", "status", $VMID], 15)
$stopped = trim($stopped_result["stdout"])
if not $stopped_result["ok"] or pos("stopped", $stopped) == 0 then
  fail_job("verifying", "CT " .. $VMID .. " did not stop ('" .. $stopped ..
    "') — reboot test unsound")
end
remote_must($PVE_REMOTE, ["pct", "start", $VMID], "verifying", 120)
verify_probe("reboot", probe($VMID, $FQDN))

fault_hook("pre_success_apply")
post_apply({
  job_id: $JOB_ID, ok: true, step: "done", service_id: $SERVICE_ID,
  node: $NODE_NAME, vmid: $VMID, ip: $IP, fqdn: $FQDN, pve_host: $PVE
})
print("provisioned job " .. $JOB_ID .. ": CT " .. $VMID .. " " ..
  $FQDN .. " " .. $IP .. " on " .. $PVE)
drain_exit("processed_ok")
