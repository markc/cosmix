-- deploy_lib.mix — the shared half of every deploy/provision script.
--
--   $d = require("../_lib/deploy_lib.mix")      -- from any script under _bin/
--
-- Isolated module (require): nothing here touches the caller's scope, and every
-- function takes what it needs as arguments. Names starting with `_` are private.
--
-- Roots. Two, and only two, and both are located, never hardcoded:
--   hub_root()     the control hub this script lives in — $CMCTL — found from the
--                  script's own path (the dir above _bin/ or _lib/ that holds
--                  _etc/public-hygiene.conf.mix), else the CMCTL env var, else ~/.ctl.
--   cosmix_root()  $COSMIX — the env var, else ~/Projects/cosmix; refuses a
--                  directory without src/Cargo.toml.
-- Everything else derives: cosmix_bin(name) is the release binary (honouring
-- CARGO_TARGET_DIR), roster() is $CMCTL/_etc/fleet-roster.conf.mix.

fn hub_root()
  $here = dirname(dirname(realpath($0)))
  if is_file($here .. "/_etc/public-hygiene.conf.mix") then
    return $here
  end
  $e = env("CMCTL")
  if $e != "" then
    return $e
  end
  return env("HOME") .. "/.ctl"
end

fn cosmix_root()
  $r = env("COSMIX", env("HOME") .. "/Projects/cosmix")
  if not is_file($r .. "/src/Cargo.toml") then
    print("  ERROR: $COSMIX=" .. $r .. " is not a CosMix checkout (no src/Cargo.toml)")
    exit(2)
  end
  return $r
end

-- Release binary for a bin target. CARGO_TARGET_DIR wins when set, exactly as
-- cargo itself would have placed it.
fn cosmix_bin($name)
  $ct = env("CARGO_TARGET_DIR")
  if $ct != "" then
    return $ct .. "/release/" .. $name
  end
  return cosmix_root() .. "/src/target/release/" .. $name
end

-- The interpreter to hand to child mix processes: the one on PATH, else the
-- system tier. A deploy script never assumes either exists silently.
fn mix_bin()
  $w = which("mix")
  if $w != nil and $w != "" then
    return $w
  end
  if is_file("/opt/cosmix/bin/mix") then
    return "/opt/cosmix/bin/mix"
  end
  print("  ERROR: no mix on PATH and no /opt/cosmix/bin/mix")
  exit(2)
end

fn die_if($cond, $msg)
  if $cond then
    print("  ERROR: " .. $msg)
    exit(1)
  end
end

fn _is_in($list, $x)
  for each $e in $list
    if $e == $x then
      return true
    end
  end
  return false
end

-- {mesh: [...], foreign: [...], all: [...]} from the hub's fleet roster. The
-- roster is the hub's private file; the starter ships none, and a hub without
-- one cannot deploy — say so rather than deploy to an empty list.
fn roster()
  $p = hub_root() .. "/_etc/fleet-roster.conf.mix"
  if not is_file($p) then
    print("  ERROR: no fleet roster at " .. $p .. " — create it (mesh: [...], foreign: [...]) before deploying")
    exit(2)
  end
  $r = load_data($p)["fleet_roster"]
  $all = []
  for each $n in $r["mesh"]
    push($all, $n)
  end
  for each $n in $r["foreign"]
    push($all, $n)
  end
  return {mesh: $r["mesh"], foreign: $r["foreign"], all: $all, order: $r["rollout_order"]}
end

fn is_foreign($roster, $host)
  return _is_in($roster["foreign"], $host)
end

fn assert_node($roster, $host)
  if not _is_in($roster["all"], $host) then
    print("  ERROR: unknown node '" .. $host .. "' — valid: " .. join($roster["all"], " "))
    exit(2)
  end
end

-- Node list from argv: no args = every node in the roster; each named node is
-- asserted. Flags the caller handles are passed in `flags` and stripped.
--   {nodes: [...], flags: {"--allow-downgrade": true, ...}}
fn parse_nodes($roster, $argv, $known_flags)
  $flags = {}
  $rest = []
  for each $a in $argv
    if _is_in($known_flags, $a) then
      $flags[$a] = true
    else
      push($rest, $a)
    end
  end
  $nodes = []
  if len($rest) == 0 then
    for each $n in $roster["all"]
      push($nodes, $n)
    end
  else
    for each $a in $rest
      assert_node($roster, $a)
      push($nodes, $a)
    end
  end
  return {nodes: $nodes, flags: $flags}
end

-- Copy a binary to a private temp path before the per-node loop, so a rebuild
-- (nightly job, another session) landing mid-deploy cannot make node N+1
-- receive different bytes from node N. Caller removes it when done.
fn snapshot_bin($bin)
  $mk = run_argv(["mktemp", "/tmp/cosmix-deploy-XXXXXX"])
  $snap = trim($mk["stdout"])
  if $mk["exit_code"] != 0 or $snap == "" then
    print("  ERROR: mktemp failed for binary snapshot: " .. trim($mk["stderr"]))
    exit(1)
  end
  $cp = run_argv(["cp", "-f", $bin, $snap])
  if $cp["exit_code"] != 0 then
    $_rm = run_argv(["rm", "-f", $snap])
    print("  ERROR: binary snapshot cp failed: " .. trim($cp["stderr"]))
    exit(1)
  end
  chmod($snap, 0o755)
  return $snap
end

-- The FIRST dotted-numeric token of a --version line -> [major, minor, patch]:
-- "mix 0.61.1" and "cosmix-maild 0.8.1 (abc123, built 2026-08-30)" both work.
-- Daemons print build provenance after the version; the last token is not it.
fn ver_tuple($s)
  $v = ""
  for each $tok in split(trim($s), " ")
    -- a leading v ("alloy v1.2.3") is tolerated
    if $v == "" and re_match($tok, "^v?[0-9]+([.][0-9]+)+$") then
      $v = re_replace($tok, "^v", "")
    end
  end
  if $v == "" then
    print("  ERROR: no version number in: " .. trim($s))
    exit(1)
  end
  $out = []
  for each $p in split($v, ".")
    push($out, to_number($p))
  end
  return $out
end

fn ver_lt($a, $b)
  $i = 0
  while $i < 3
    $x = $i < len($a) ? $a[$i] : 0
    $y = $i < len($b) ? $b[$i] : 0
    if $x < $y then
      return true
    end
    if $x > $y then
      return false
    end
    $i = $i + 1
  end
  return false
end

-- Refuse to push an older build over a newer node unless the caller opted in.
-- `current` is the node's --version output (may be blank: nothing installed).
fn assert_not_downgrade($host, $current, $local_ver, $allow)
  if trim($current) == "" then
    return nil
  end
  if not ver_lt(ver_tuple($local_ver), ver_tuple($current)) then
    return nil
  end
  die_if(not $allow,
    $host .. " REFUSING DOWNGRADE: node runs " .. trim($current) ..
    ", local build is " .. $local_ver .. " -- is $COSMIX behind origin/main?" ..
    " Pass --allow-downgrade if a rollback is intended.")
  print("  !! DOWNGRADE (--allow-downgrade): " .. trim($current) .. " -> " .. $local_ver)
end

-- ── mesh inventory ──────────────────────────────────────────────────────
-- The authored inventory ($CMCTL/_etc/mesh/inventory.mix) is the roster's
-- source of addresses. Deploy scripts used to carry their own `$ADDR = {…}`
-- tables and hand-listed node arrays; every one of those drifted from the
-- inventory at some point. These lookups read the inventory each call (it is
-- small) and refuse loudly when a node is not an active member.

fn _inventory()
  $p = hub_root() .. "/_etc/mesh/inventory.mix"
  if not is_file($p) then
    print("  ERROR: no mesh inventory at " .. $p .. " — this deploy needs mesh addresses")
    exit(2)
  end
  return load_data($p)["inventory"]
end

-- Active members only: [{name, mesh_ip, bus, status}, …]
fn mesh_members()
  $out = []
  for each $m in _inventory()["members"]
    if $m["status"] == "active" then
      push($out, $m)
    end
  end
  return $out
end

fn mesh_nodes()
  $out = []
  for each $m in mesh_members()
    push($out, $m["name"])
  end
  return $out
end

fn mesh_ip($node)
  for each $m in mesh_members()
    if $m["name"] == $node then
      return $m["mesh_ip"]
    end
  end
  print("  ERROR: '" .. $node .. "' is not an active member of the mesh inventory")
  exit(2)
end

-- The inventory's hub node(s) — the broker(s) every other node talks through;
-- a rollout touches them LAST.
fn mesh_hubs()
  return _inventory()["hub"]
end

-- Rollout order for a mesh-wide change: the roster's `rollout_order` when the
-- hub defines one, else the roster's mesh list with the inventory hubs moved
-- to the end. Either way, hubs last.
fn rollout_order($roster)
  if $roster["order"] != nil then
    return $roster["order"]
  end
  $hubs = mesh_hubs()
  $head = []
  $tail = []
  for each $n in $roster["mesh"]
    if _is_in($hubs, $n) then
      push($tail, $n)
    else
      push($head, $n)
    end
  end
  return concat($head, $tail)
end

-- The rollout order restricted to a given subset of nodes (still hubs last).
-- Used when a deploy targets some mesh nodes, not all.
fn order_subset($roster, $nodes)
  $out = []
  for each $n in rollout_order($roster)
    if _is_in($nodes, $n) then
      push($out, $n)
    end
  end
  -- nodes absent from the rollout order (roster drift) go last, unordered
  for each $n in $nodes
    if not _is_in($out, $n) then
      push($out, $n)
    end
  end
  return $out
end

-- ── shipped templates vs hub-private overrides ──────────────────────────
-- A unit file, sysusers/tmpfiles fragment, polkit rule or config payload is
-- normally the PUBLIC template under $COSMIX/src/_etc. When the hub carries
-- its own copy — a unit whose environment names a mesh address, a config with
-- site values — that copy is site CONFIG and wins. Kinds and the two roots:
--   unit      $CMCTL/_etc/systemd/<name>          $COSMIX/src/_etc/systemd-system/<name>
--   sysusers  $CMCTL/_etc/sysusers/<name>         $COSMIX/src/_etc/sysusers/<name>
--   tmpfiles  $CMCTL/_etc/tmpfiles/<name>         $COSMIX/src/_etc/tmpfiles.d/<name>
--   polkit    $CMCTL/_etc/polkit-1/rules.d/<name> $COSMIX/src/_etc/polkit-1/rules.d/<name>
--   cosmix    $CMCTL/_etc/cosmix/<name>           $COSMIX/src/_etc/cosmix/<name>
-- Returns the path that exists (private first); refuses when neither does.
fn shipped($kind, $name)
  $priv = {unit: "/_etc/systemd/", sysusers: "/_etc/sysusers/", tmpfiles: "/_etc/tmpfiles/",
           polkit: "/_etc/polkit-1/rules.d/", cosmix: "/_etc/cosmix/"}
  $pub = {unit: "/src/_etc/systemd-system/", sysusers: "/src/_etc/sysusers/", tmpfiles: "/src/_etc/tmpfiles.d/",
          polkit: "/src/_etc/polkit-1/rules.d/", cosmix: "/src/_etc/cosmix/"}
  if $priv[$kind] == nil then
    print("  ERROR: shipped(): unknown kind '" .. $kind .. "'")
    exit(2)
  end
  $p = hub_root() .. $priv[$kind] .. $name
  if is_file($p) then
    return $p
  end
  $q = cosmix_root() .. $pub[$kind] .. $name
  if is_file($q) then
    return $q
  end
  print("  ERROR: no " .. $kind .. " template '" .. $name .. "' — looked in " .. $p .. " and " .. $q)
  exit(2)
end
