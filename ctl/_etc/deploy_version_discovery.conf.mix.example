-- deploy_version_discovery.conf.mix.example — private defaults for the
-- version-discovery rollout. Copy this file to
-- deploy_version_discovery.conf.mix in the private control hub.
{
  deploy_version_discovery: {
    schema_version: 1,

    -- Used when the deploy script is run without explicit node arguments.
    -- Each name must exist in the private fleet roster.
    default_nodes: ["alpha", "beta", "gamma"],

    -- Client daemons that must be installed before the broker is restarted.
    -- `service` is the name each daemon registers with the local broker.
    client_daemons: [
      {binary: "cosmix-dnsd", unit: "cosmix-dnsd", service: "dnsd"},
      {binary: "cosmix-maild", unit: "cosmix-maild", service: "maild"},
      {binary: "cosmix-webd", unit: "cosmix-webd", service: "webd"}
    ]
  }
}
