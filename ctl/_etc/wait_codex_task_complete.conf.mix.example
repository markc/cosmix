-- Private local paths for wait_codex_task_complete.mix. Copy this file to
-- wait_codex_task_complete.conf.mix in the private control hub and replace
-- the placeholder before running the watcher.
{
  wait_codex_task_complete: {
    schema_version: 1,

    -- Directory containing Codex rollout transcripts for this workstation.
    sessions_dir: "/home/user/.codex/sessions"
  }
}
