-- ct_reconcile.conf.mix.example — private reconcile endpoints and targets.
-- Copy this file to ct_reconcile.conf.mix in the private control hub and
-- replace every placeholder. Each node must exist in the fleet roster;
-- foreign nodes are reached through their SSH aliases.
ct_reconcile: {
  schema_version: 1,
  base_url: "https://provision.example.org",
  pve_hosts: ["alpha", "beta"],
  dns_node: "gamma",
  dns_server: "192.0.2.53",
  dnsmasq_dropin: "/etc/dnsmasq.d/provision.example.conf",
  ct_description_prefix: "example-provision-"
}
