-- gen-doc-pages.mix — pre-rendered per-doc pages behind the interactive shell.
--
-- Each tracked bus/ cos/ mix/ bugs/ spec/ markdown doc gets an HTML page
-- beside it (page.md -> page.html; README.md -> index.html in its directory)
-- so GitHub Pages serves /sec/page and /sec/dir/ as real 200s without the
-- hash router. The page is index.html minus the brochure, with root-relative
-- asset URLs — and since 2026-09-05 the doc's markdown() output is
-- PRE-RENDERED into #content-doc at build time (heading ids and clean-URL
-- doc links included), so curl, `mix http_serve`, crawlers and no-JS
-- browsers receive the full document, while the shell's JS hydrates the
-- same DOM for the SPA behaviour (the data-prerendered check in index.html
-- skips the initial fetch and re-render). One URL, both presentations.
--
-- Heading-id and link-rewrite rules deliberately MIRROR index.html's
-- slugify()/link pass, so a doc navigated to client-side and the same doc
-- served pre-rendered carry identical anchors and hrefs.
--
-- Re-run after adding, renaming, removing or EDITING any doc, or after
-- editing index.html:   mix build/gen-doc-pages.mix
-- Idempotent: previously generated pages (identified by $marker) are pruned
-- first, so removed docs lose their pages.

$marker = "<!-- generated by build/gen-doc-pages.mix; do not edit -->"

-- The site is the repo's docs/ tree (Pages source = /docs since the
-- 2026-08-30 monorepo). The repo-root README/AGENTS/CLAUDE are mirrored into
-- it so cosmix.dev/README etc. keep resolving — Pages serves docs/ only.
$repo = trim(run_argv_must(["git", "rev-parse", "--show-toplevel"]))
$root = $repo .. "/docs"
for each $doc in ["README.md", "AGENTS.md", "CLAUDE.md"]
    copy($repo .. "/" .. $doc, $root .. "/" .. $doc)
    run_argv_must(["git", "add", "--", "docs/" .. $doc], {cwd: $repo})
end

-- 1. Template: index.html minus the brochure, assets absolutized, with
--    placeholders for the per-doc title and the pre-rendered body.
$html = read_file($root .. "/index.html")
$open = "<div id=\"brochure\">"
$close = "</div><!-- /#brochure -->"
$head_tail = split($html, $open)
if len($head_tail) != 2 then
    raise("GEN_MARKERS", "expected exactly one brochure open marker in index.html")
end
$mid_tail = split($head_tail[1], $close)
if len($mid_tail) != 2 then
    raise("GEN_MARKERS", "expected exactly one brochure close marker in index.html")
end
$tpl = $head_tail[0] .. "<div id=\"brochure\" data-stub style=\"display:none\"></div>" .. $mid_tail[1]
$tpl = replace($tpl, "<!DOCTYPE html>", "<!DOCTYPE html>\n" .. $marker)
$tpl = replace($tpl, "\"web/", "\"/web/")
$tpl = replace($tpl, "href=\"./\"", "href=\"/\"")
$tpl = replace($tpl, "href=\"ai.txt\"", "href=\"/ai.txt\"")
$tpl = replace($tpl, "href=\"#", "href=\"/#")

-- Per-doc title. The <title> text tracks index.html, so locate it by tag
-- rather than by value.
$tm = re_find($tpl, "<title>[^<]*</title>")
if len($tm) != 1 then
    raise("GEN_MARKERS", "expected exactly one <title> in index.html")
end
$tpl = replace($tpl, $tm[0]["match"], "<title>__COSMIX_DOC_TITLE__</title>")

-- Doc view visible without JS (index.html hides it because the brochure
-- leads there; a doc page IS the doc). #content-doc becomes the body slot.
$dv_hidden = "<div id=\"doc-view\" class=\"content-section\" style=\"display:none\">"
if not contains($tpl, $dv_hidden) then
    raise("GEN_MARKERS", "expected the hidden #doc-view container in index.html")
end
$tpl = replace($tpl, $dv_hidden, "<div id=\"doc-view\" class=\"content-section\">")
$slot = "<div id=\"content-doc\"></div>"
if not contains($tpl, $slot) then
    raise("GEN_MARKERS", "expected the empty #content-doc slot in index.html")
end
$tpl = replace($tpl, $slot, "__COSMIX_DOC_BODY__")

-- 2. Prune every page a previous run generated. Root depth included: the
--    marker check keeps hand-written index.html / 404.html safe.
$found = run_argv_must(["find", ".", "-maxdepth", "1", "-name", "*.html"], {cwd: $root})
$found = $found .. run_argv_must(["find", "bus", "cos", "mix", "bugs", "spec", "-name", "*.html"], {cwd: $root})
$pruned = 0
for each $old in split(trim($found), "\n")
    if $old != "" then
        $oldpath = $root .. "/" .. $old
        if pos($marker, read_file($oldpath)) > 0 then
            remove($oldpath)
            $pruned = $pruned + 1
        end
    end
end

-- Clean URL for a doc path — parity with index.html's urlFor():
-- 'sec/page.md' -> '/sec/page', 'sec/README.md' -> '/sec/'.
fn url_for($path)
    if ends_with($path, "/README.md") then
        return "/" .. substr($path, 0, len($path) - len("README.md"))
    end
    return "/" .. substr($path, 0, len($path) - 3)
end

-- Resolve a doc-relative href against the doc's directory — parity with
-- index.html's resolveRel(). Returns "" when the path escapes the site
-- root (the caller then leaves the href untouched).
fn resolve_rel($dir, $href)
    $joined = $href
    if $dir != "" then $joined = $dir .. "/" .. $href end
    $stack = []
    $bad = false
    for each $p in split($joined, "/")
        if $p != "" and $p != "." then
            if $p == ".." then
                if len($stack) == 0 then
                    $bad = true
                else
                    pop($stack)
                end
            else
                push($stack, $p)
            end
        end
    end
    if $bad then return "" end
    return join($stack, "/")
end

-- Strip leading YAML frontmatter — parity with md.js's strip (the spec
-- suite carries Jekyll-style frontmatter; markdown() would render it as
-- an <hr> plus a setext <h2> blob). Same regex as md.js.
fn strip_frontmatter($src)
    $fm = re_find($src, "^---\\r?\\n[\\s\\S]*?\\r?\\n---\\r?\\n?")
    if len($fm) == 1 then
        $n = len($fm[0]["match"])
        return substr($src, $n, len($src) - $n)
    end
    return $src
end

-- Render one doc into a full page: markdown() body, heading ids (slugify
-- parity with index.html), relative .md links rewritten to clean
-- root-absolute URLs (so no-JS navigation lands on the sibling page, and
-- the JS click router routes the same href in-page).
fn page_for($doc)
    $body = markdown(strip_frontmatter(read_file($root .. "/" .. $doc)))

    -- Heading ids. markdown() emits each heading on one line and escapes
    -- raw HTML, so a line-wise match cannot hit code-block content.
    $out = []
    $used = {}
    for each $line in lines($body)
        $keep = true
        $hm = re_find($line, "^<h([1-6])>(.*)</h([1-6])>$")
        if len($hm) == 1 then
            $g = $hm[0]["groups"]
            if $g[0] == $g[2] then
                -- slugify parity: textContent (tags stripped, entities
                -- decoded), lowercase, keep [a-z0-9_- ], spaces -> dashes.
                -- &amp; decodes LAST so escaped entity text ('&amp;lt;')
                -- decodes once, matching what the DOM's textContent gives
                -- the JS slugify.
                $text = re_replace($g[1], "<[^>]*>", "")
                $text = replace($text, "&lt;", "<")
                $text = replace($text, "&gt;", ">")
                $text = replace($text, "&quot;", "\"")
                $text = replace($text, "&#39;", "'")
                $text = replace($text, "&amp;", "&")
                $s = lower($text)
                $s = re_replace($s, "[^a-z0-9_\\- ]", "")
                $s = replace($s, " ", "-")
                if $s == "" then $s = "section" end
                $id = $s
                $n = 1
                while has_key($used, $id)
                    $id = $s .. "-" .. to_string($n)
                    $n = $n + 1
                end
                $used[$id] = true
                push($out, "<h" .. $g[0] .. " id=\"" .. $id .. "\">" .. $g[1] .. "</h" .. $g[0] .. ">")
                $keep = false
            end
        end
        if $keep then push($out, $line) end
    end
    $body = join($out, "\n")

    -- Relative .md links -> clean URLs, and bare '#frag' links -> the doc's
    -- own canonical '/sec/page#frag' (both in parity with the JS rewrite
    -- pass, so the DOM is identical whether this page hydrated or the doc
    -- was client-rendered — and so a click in the pre-hydration window
    -- routes correctly instead of hitting the stub's brochure-anchor
    -- branch). Scheme-prefixed and root-absolute hrefs pass through.
    -- Known latent limits, accepted: this is a string-level pass, so an
    -- href=".."-shaped LITERAL inside escaped code-sample text would also
    -- be rewritten (none exist in tracked docs); '.md' is matched
    -- lowercase-only (all tracked docs are); and a '../'-escape past the
    -- site root leaves the href untouched where the JS pass would clamp
    -- to root — refusing is the safer half of that divergence.
    for each $m in re_find($body, "href=\"([^\"]*)\"")
        $href = $m["groups"][0]
        if starts_with($href, "#") and len($href) > 1 then
            $body = replace($body, "href=\"" .. $href .. "\"",
                "href=\"" .. url_for($doc) .. $href .. "\"")
        end
        $rel = $href != "" and not starts_with($href, "/") and not starts_with($href, "#")
        if $rel and not re_match($href, "^[A-Za-z][A-Za-z0-9+.\\-]*:") then
            $lm = re_find($href, "^([^#?]+\\.md)(#(.*))?$")
            if len($lm) == 1 then
                $target = resolve_rel(dirname($doc), $lm[0]["groups"][0])
                if $target != "" then
                    $new = url_for($target)
                    if $lm[0]["groups"][2] != nil then
                        $new = $new .. "#" .. $lm[0]["groups"][2]
                    end
                    $body = replace($body, "href=\"" .. $href .. "\"", "href=\"" .. $new .. "\"")
                end
            end
        end
    end

    -- Assemble. $doc passed the safe-name grammar before we were called,
    -- so it is attribute-safe verbatim. Title parity with the JS
    -- (document.title = 'CosMix — ' + urlFor(path).slice(1)).
    $page = replace($tpl, "__COSMIX_DOC_TITLE__", "CosMix — " .. substr(url_for($doc), 1))
    return replace($page, "__COSMIX_DOC_BODY__",
        "<div id=\"content-doc\" data-prerendered=\"" .. $doc .. "\">"
        .. "<div class=\"prose\">" .. $body .. "</div></div>")
end

-- 3. One page per tracked markdown doc. Doc names must fit the reader's
--    safePath() grammar (plain ASCII word/dot/dash path segments) or the
--    clean URL would be unroutable — refuse rather than emit a dead page.
$tracked = run_argv_must(["git", "ls-files", "--", "bus/", "cos/", "mix/", "bugs/", "spec/"], {cwd: $root})
$made = 0

-- 3a. Root-level docs (cosmix.dev/README etc.). Fixed whitelist mirroring
--     docFromPath() in index.html (and the 404.html fallback): a root doc
--     the reader can't route must fail generation, not ship a dead page.
$root_docs = ["README.md", "AGENTS.md", "CLAUDE.md", "VERSIONS.md", "history.md"]
for each $doc in split(trim(run_argv_must(["git", "ls-files"], {cwd: $root})), "\n")
    if ends_with($doc, ".md") and pos("/", $doc) == 0 then
        if not contains($root_docs, $doc) then
            raise("GEN_UNROUTED_ROOT_DOC", $doc .. " is not in the reader's root whitelist - add it to docFromPath() in index.html, the 404.html fallback, and $root_docs here")
        end
        write_file($root .. "/" .. substr($doc, 0, len($doc) - 3) .. ".html", page_for($doc))
        $made = $made + 1
    end
end
for each $doc in split(trim($tracked), "\n")
    if ends_with($doc, ".md") then
        if not re_match($doc, "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$") or pos("/../", "/" .. $doc .. "/") > 0 then
            raise("GEN_UNSAFE_NAME", "doc name outside the safe URL grammar: " .. $doc)
        end
        -- an all-dots stem ('.md', '..md') would collapse to /sec/ or /sec/.
        -- once urlFor strips the extension — another page's URL, so refuse
        $parts = split($doc, "/")
        if re_match($parts[len($parts) - 1], "^[.]*[.]md$") then
            raise("GEN_UNSAFE_NAME", "doc stem empty or dots-only: " .. $doc)
        end
        if ends_with($doc, "/README.md") then
            -- suffix-only: replace() would also hit a mid-path README.md dir
            $stub = substr($doc, 0, len($doc) - len("README.md")) .. "index.html"
        else
            $stub = substr($doc, 0, len($doc) - 3) .. ".html"
        end
        write_file($root .. "/" .. $stub, page_for($doc))
        $made = $made + 1
    end
end

print("pruned " .. to_string($pruned) .. ", generated " .. to_string($made) .. " pre-rendered pages")
