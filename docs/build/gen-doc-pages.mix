-- gen-doc-pages.mix — clean-URL HTML stubs for every doc page.
--
-- Each tracked bus/ cos/ mix/ bugs/ markdown doc gets a byte-identical HTML shell
-- beside it (page.md -> page.html; README.md -> index.html in its directory)
-- so GitHub Pages serves /sec/page and /sec/dir/ as real 200s without the
-- hash router. The shell is index.html minus the brochure, with root-relative
-- asset URLs; its JS reads location.pathname and renders the markdown.
--
-- Re-run after adding, renaming, or removing any doc, or after editing
-- index.html:   mix build/gen-doc-pages.mix
-- Idempotent: previously generated stubs (identified by $marker) are pruned
-- first, so removed docs lose their stubs.

$marker = "<!-- generated by build/gen-doc-pages.mix; do not edit -->"

-- The site is the repo's docs/ tree (Pages source = /docs since the
-- 2026-08-30 monorepo). The repo-root README/AGENTS/CLAUDE are mirrored into
-- it so cosmix.dev/README etc. keep resolving — Pages serves docs/ only.
$repo = trim(run_argv_must(["git", "rev-parse", "--show-toplevel"]))
$root = $repo .. "/docs"
for each $doc in ["README.md", "AGENTS.md", "CLAUDE.md"]
    copy($repo .. "/" .. $doc, $root .. "/" .. $doc)
    run_argv_must(["git", "add", "--", "docs/" .. $doc], {cwd: $repo})
end

-- 1. Template: index.html minus the brochure, assets absolutized.
$html = read_file($root .. "/index.html")
$open = "<div id=\"brochure\">"
$close = "</div><!-- /#brochure -->"
$head_tail = split($html, $open)
if len($head_tail) != 2 then
    raise("GEN_MARKERS", "expected exactly one brochure open marker in index.html")
end
$mid_tail = split($head_tail[1], $close)
if len($mid_tail) != 2 then
    raise("GEN_MARKERS", "expected exactly one brochure close marker in index.html")
end
$tpl = $head_tail[0] .. "<div id=\"brochure\" data-stub style=\"display:none\"></div>" .. $mid_tail[1]
$tpl = replace($tpl, "<!DOCTYPE html>", "<!DOCTYPE html>\n" .. $marker)
$tpl = replace($tpl, "\"web/", "\"/web/")
$tpl = replace($tpl, "href=\"./\"", "href=\"/\"")
$tpl = replace($tpl, "href=\"ai.txt\"", "href=\"/ai.txt\"")
$tpl = replace($tpl, "href=\"#", "href=\"/#")

-- 2. Prune every stub a previous run generated. Root depth included: the
--    marker check keeps hand-written index.html / 404.html safe.
$found = run_argv_must(["find", ".", "-maxdepth", "1", "-name", "*.html"], {cwd: $root})
$found = $found .. run_argv_must(["find", "bus", "cos", "mix", "bugs", "-name", "*.html"], {cwd: $root})
$pruned = 0
for each $old in split(trim($found), "\n")
    if $old != "" then
        $oldpath = $root .. "/" .. $old
        if pos($marker, read_file($oldpath)) > 0 then
            remove($oldpath)
            $pruned = $pruned + 1
        end
    end
end

-- 3. One stub per tracked markdown doc. Doc names must fit the reader's
--    safePath() grammar (plain ASCII word/dot/dash path segments) or the
--    clean URL would be unroutable — refuse rather than emit a dead stub.
$tracked = run_argv_must(["git", "ls-files", "--", "bus/", "cos/", "mix/", "bugs/"], {cwd: $root})
$made = 0

-- 3a. Root-level docs (cosmix.dev/README etc.). Fixed whitelist mirroring
--     docFromPath() in index.html (and the 404.html fallback): a root doc
--     the reader can't route must fail generation, not ship a dead stub.
$root_docs = ["README.md", "AGENTS.md", "CLAUDE.md", "VERSIONS.md", "history.md"]
for each $doc in split(trim(run_argv_must(["git", "ls-files"], {cwd: $root})), "\n")
    if ends_with($doc, ".md") and pos("/", $doc) == 0 then
        if not contains($root_docs, $doc) then
            raise("GEN_UNROUTED_ROOT_DOC", $doc .. " is not in the reader's root whitelist - add it to docFromPath() in index.html, the 404.html fallback, and $root_docs here")
        end
        write_file($root .. "/" .. substr($doc, 0, len($doc) - 3) .. ".html", $tpl)
        $made = $made + 1
    end
end
for each $doc in split(trim($tracked), "\n")
    if ends_with($doc, ".md") then
        if not re_match($doc, "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$") or pos("/../", "/" .. $doc .. "/") > 0 then
            raise("GEN_UNSAFE_NAME", "doc name outside the safe URL grammar: " .. $doc)
        end
        -- an all-dots stem ('.md', '..md') would collapse to /sec/ or /sec/.
        -- once urlFor strips the extension — another page's URL, so refuse
        $parts = split($doc, "/")
        if re_match($parts[len($parts) - 1], "^[.]*[.]md$") then
            raise("GEN_UNSAFE_NAME", "doc stem empty or dots-only: " .. $doc)
        end
        if ends_with($doc, "/README.md") then
            -- suffix-only: replace() would also hit a mid-path README.md dir
            $stub = substr($doc, 0, len($doc) - len("README.md")) .. "index.html"
        else
            $stub = substr($doc, 0, len($doc) - 3) .. ".html"
        end
        write_file($root .. "/" .. $stub, $tpl)
        $made = $made + 1
    end
end

print("pruned " .. to_string($pruned) .. ", generated " .. to_string($made) .. " stubs")
