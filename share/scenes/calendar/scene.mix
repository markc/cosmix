```mix
root: {"children":["cal_day","cal_full","cal_gap","cal_nav","wk_h","wk_0","wk_1","wk_2","wk_3","wk_4","wk_5","cal_fill","cal_open"],"fill":true,"gap":6,"padding":18,"widget":"column"}
cal_day: {"bold":true,"color":"#fcfcfc","size":24,"text":"= $model.day","widget":"text"}
cal_full: {"color":"#a1a9b1","size":13,"text":"= $model.full","widget":"text"}
cal_gap: {"size":10,"widget":"spacer"}
