cal_prev_t: {"bold":true,"color":"#fcfcfc","size":16,"text":"‹","widget":"text"}
cal_today: {"align":"center","background":"#ffffff0f","children":["cal_today_t"],"height":30,"hover":"#ffffff1a","justify":"center","on_click":"cal_today","padding":10,"radius":6,"widget":"row"}
