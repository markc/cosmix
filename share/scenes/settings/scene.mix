motion_head: {"bold":true,"color":"#fcfcfc","size":13,"text":"Carousel motion","widget":"text"}
motion_slide: {"children":["motion_slide_t"],"height":32,"hover":"#ffffff1a","on_click":"shell.settings.motion","padding":6,"widget":"row"}
motion_slide_t: {"color":"#fcfcfc","size":13,"text":"= $model.motion.slide","widget":"text"}
motion_fade: {"children":["motion_fade_t"],"height":28,"padding":6,"widget":"row"}
