size_bottom_label: {"color":"#fcfcfc","elide":true,"fill":true,"size":12,"text":"Bottom height","widget":"text"}
size_bottom_minus: {"align":"center","children":["size_bottom_minus_t"],"height":28,"hover":"#ffffff1a","justify":"center","max_width":24,"min_width":24,"on_click":"shell.settings.size","widget":"row"}
