---
scene: 1
name: quoin-settings
citizen: scene-quoin-settings
window: {"edge":"right","kind":"edge","panel":"settings.appearance","title":"Settings"}
model: {"fade_reason":"","motion":{"fade":"○ Fade (unavailable)","slide":"○ Slide"},"schemes":{"crimson":{"accent":"#00000000","background":"#00000000","mark":"○"},"forest":{"accent":"#00000000","background":"#00000000","mark":"○"},"mono":{"accent":"#00000000","background":"#00000000","mark":"○"},"ocean":{"accent":"#00000000","background":"#00000000","mark":"○"},"stone":{"accent":"#00000000","background":"#00000000","mark":"○"},"sunset":{"accent":"#00000000","background":"#00000000","mark":"○"}},"sizes":{"bottom":"","left":"","right":"","top":""}}
---
```mix
root: {"children":["viewport"],"fill":true,"min_height":0,"widget":"column"}
viewport: {"basis":0,"grow":1,"min_height":0,"row":"content","row_height":760,"rows":[{"cells":[],"id":"appearance"}],"shrink":1,"widget":"list"}
content: {"children":["title","theme_head","scheme_ocean","scheme_crimson","scheme_stone","scheme_forest","scheme_sunset","scheme_mono","motion_head","motion_slide","motion_fade","fade_reason","size_head","size_top","size_bottom","size_left","size_right"],"gap":10,"padding":12,"widget":"column"}
title: {"bold":true,"color":"#fcfcfc","size":16,"text":"Appearance","widget":"text"}
theme_head: {"bold":true,"color":"#fcfcfc","size":13,"text":"Colour scheme","widget":"text"}
scheme_ocean: {"align":"center","background":"= $model.schemes.ocean.background","children":["scheme_ocean_chip","scheme_ocean_name","scheme_ocean_mark"],"gap":8,"height":32,"hover":"#ffffff1a","on_click":"shell.settings.scheme","padding":6,"radius":6,"widget":"row"}
scheme_ocean_chip: {"background":"= $model.schemes.ocean.accent","children":[],"height":16,"max_width":16,"min_width":16,"radius":8,"widget":"row"}
scheme_ocean_name: {"color":"#fcfcfc","elide":true,"fill":true,"size":13,"text":"Ocean","widget":"text"}
scheme_ocean_mark: {"color":"#fcfcfc","size":13,"text":"= $model.schemes.ocean.mark","widget":"text"}
scheme_crimson: {"align":"center","background":"= $model.schemes.crimson.background","children":["scheme_crimson_chip","scheme_crimson_name","scheme_crimson_mark"],"gap":8,"height":32,"hover":"#ffffff1a","on_click":"shell.settings.scheme","padding":6,"radius":6,"widget":"row"}
scheme_crimson_chip: {"background":"= $model.schemes.crimson.accent","children":[],"height":16,"max_width":16,"min_width":16,"radius":8,"widget":"row"}
scheme_crimson_name: {"color":"#fcfcfc","elide":true,"fill":true,"size":13,"text":"Crimson","widget":"text"}
scheme_crimson_mark: {"color":"#fcfcfc","size":13,"text":"= $model.schemes.crimson.mark","widget":"text"}
