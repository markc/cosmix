size_head: {"bold":true,"color":"#fcfcfc","size":13,"text":"Panel size","widget":"text"}
size_top: {"align":"center","children":["size_top_label","size_top_minus","size_top_value","size_top_plus"],"gap":4,"height":32,"widget":"row"}
size_top_label: {"color":"#fcfcfc","elide":true,"fill":true,"size":12,"text":"Top height","widget":"text"}
size_top_minus: {"align":"center","children":["size_top_minus_t"],"height":28,"hover":"#ffffff1a","justify":"center","max_width":24,"min_width":24,"on_click":"shell.settings.size","widget":"row"}
size_top_minus_t: {"color":"#fcfcfc","size":13,"text":"−","widget":"text"}
size_top_plus: {"align":"center","children":["size_top_plus_t"],"height":28,"hover":"#ffffff1a","justify":"center","max_width":24,"min_width":24,"on_click":"shell.settings.size","widget":"row"}
size_top_plus_t: {"color":"#fcfcfc","size":13,"text":"+","widget":"text"}
size_top_value: {"align":"right","color":"#fcfcfc","size":12,"text":"= $model.sizes.top","widget":"text","width":48}
