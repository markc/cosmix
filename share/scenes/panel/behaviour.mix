-- version: 0.2.0
-- The bottom panel's behaviour: compositor, tray, notification and popup
-- state in; one complete model out through the loader (scenes.model). The
-- layout is static in scene.mix. Clicks arrive as {scene,node,kind,item?};
-- repeated rows (workspaces, tasks, tray) carry their complete model row.
$LIB = env("SCENES_LIB", env("XDG_DATA_HOME", env("HOME") .. "/.local/share") .. "/cosmix/scenes/lib")
$r = require($LIB .. "/runtime.mix")
$m = require($LIB .. "/models.mix")
$p = require($LIB .. "/data.mix")
$t = require($LIB .. "/taskbar.mix")
$ctx = $r.scene_context("panel")
$COMP = env("COMP_SERVICE", "comp")
$APPS = env("APPS_SERVICE", "apps")
$TRAY = env("TRAY_SERVICE", "tray")
$NOTIFY = env("NOTIFY_SERVICE", "notify")
$NODED = env("NODED_SERVICE", "noded")
-- Status icons come from the dark variant so they read on the dark panel.
$ICON_THEME = env("PANEL_ICON_THEME", "breeze-dark")
-- PipeWire lives in the login session's runtime dir, not the desktop's.
$PW_RUNTIME = env("PIPEWIRE_RUNTIME_DIR", "/run/user/" .. to_string(uid()))
-- The loader-owned popup scenes the panel's buttons toggle.
$POPUPS = {launcher: env("PANEL_LAUNCHER_SCENE", "launcher"),
  calendar: env("PANEL_CALENDAR_SCENE", "calendar"), notes: env("PANEL_NOTES_SCENE", "notes")}

-- The panel's own settings, beside its scene (SCENE_DIR, the user copy on a
-- live desktop), canonicalised because inotify reports canonical paths.
-- tasks_scope: "all" (Plasma's default) or "current". A missing file or key
-- is "all"; an unreadable or invalid file keeps the scope in force (start:
-- "all") and says why on stderr, so a half-written save never flips the panel.
fn scene_dir()
  $dir = env("SCENE_DIR", "")
  if $dir == "" then $dir = cwd() end
  return realpath($dir) ?? $dir
end
$SETTINGS = scene_dir() .. "/settings.conf.mix"

-- {scope, data, why}: scope nil = the file exists but cannot be used.
fn read_settings()
  if not is_file($SETTINGS) then return {scope: "all", data: {}, why: nil} end
  try
    $data = load_data($SETTINGS)
    if type($data) != "map" then return {scope: nil, data: nil, why: "not a key: value file"} end
    if $data.tasks_scope == nil then return {scope: "all", data: $data, why: nil} end
    $scope = $t.valid_scope($data.tasks_scope)
    if $scope == nil then return {scope: nil, data: $data, why: "tasks_scope must be \"all\" or \"current\""} end
    return {scope: $scope, data: $data, why: nil}
  catch $message
    return {scope: nil, data: nil, why: to_string($message)}
  end
end

-- The whole file, other keys kept (comments are not: the header is rewritten).
fn settings_text($data)
  $out = "-- The bottom panel's settings: edit here (ced), or send\n" ..
    "-- `panel.tasks_scope {\"scope\":\"current\"}` to scene-panel ({} toggles).\n" ..
    "-- tasks_scope: \"all\" shows windows from every workspace (Plasma's default);\n" ..
    "-- \"current\" shows only the current workspace's windows.\n"
  $keys = ["schema", "tasks_scope"]
  for each $k in sort(keys($data))
    if not contains($keys, $k) then push($keys, $k) end
  end
  for each $k in $keys
    if not has_key($data, $k) then continue end
    -- A key that is not a bare identifier is written quoted (load_data reads both).
    $name = re_match($k, "^[a-z_][a-z0-9_]*$") ? $k : data_encode($k)
    $out = $out .. $name .. ": " .. data_encode($data[$k]) .. "\n"
  end
  return $out
end

fn empty_icons()
  return {themed: {}, plain: {}, windows: {}}
end

$state = {ready: false, windows: [], ws_count: 1, ws_current: 1, tray: [], notes_count: 0,
  net: {up: false, wireless: false}, vol: {ok: false, level: 0, muted: false},
  open: {launcher: false, calendar: false, notes: false}, peeked: [], peek_busy: false,
  icons: empty_icons(), services: [], dirty: false, rebuilding: false, clock_armed: false, status_refreshing: false,
  net_watch: nil, net_started: 0, net_retry: 5, net_retrying: false,
  audio_watch: nil, audio_started: 0, audio_retry: 5, audio_retrying: false, audio_unavailable: false,
  model: nil, settings_watch: nil}
$first = read_settings()
$state.tasks_scope = $first.scope ?? "all"
if $first.scope == nil then eprint("panel: " .. $SETTINGS .. ": " .. $first.why .. "; using \"all\"") end

-- ── status: network + volume, pushed by the kernel and PipeWire ─────────
-- rtnetlink link events and a `pactl subscribe` stream (net_watch /
-- audio_watch); every batch re-reads state (events are hints, state is
-- truth). A mix without these builtins shows the network offline and hides
-- volume, and says so: there is no polling fallback.
fn start_status()
  if not has_builtin("net_watch") then
    eprint("panel: status events unavailable: this mix has no net_watch/audio_watch")
    return
  end
  start_net()
  start_audio()
end

-- Only an I/O failure is retried (a local backoff); any other refusal (the
-- handle limit, a retired evaluator) is terminal and logged once.
fn start_net()
  if $state.net_watch != nil then return end
  try
    $state.net_watch = net_watch({events: ["link"]})
    $state.net_started = monotonic()
  catch $message, $error
    eprint("panel: net_watch failed: " .. to_string($message))
    if $error.code == "NET_WATCH_IO" then retry_net() end
  end
end

-- A host without pactl (AUDIO_UNAVAILABLE) will never answer: the volume
-- applet stays hidden for this behaviour's life, with no retry timer.
fn start_audio()
  if $state.audio_watch != nil or $state.audio_unavailable then return end
  try
    $state.audio_watch = audio_watch({runtime_dir: $PW_RUNTIME})
    $state.audio_started = monotonic()
  catch $message, $error
    eprint("panel: audio_watch failed: " .. to_string($message))
    if $error.code == "AUDIO_UNAVAILABLE" then
      $state.audio_unavailable = true
    elif $error.code == "AUDIO_WATCH_IO" then
      retry_audio()
    end
  end
end

-- A subscription that outlived the current delay was a working one, so the
-- server (or the link socket) only restarted: come back after the shortest
-- delay instead of a stale doubled one.
fn reset_if_lived($started, $delay)
  return monotonic() - $started >= $delay ? 5 : $delay
end

-- The link socket failed: subscribe again after a delay doubling to five
-- minutes. A reconnect backoff, not a state poll.
fn retry_net()
  if $state.net_retrying then return end
  $state.net_retrying = true
  try
    task_start("net.retry", "{}")
  catch $message
    $state.net_retrying = false
    eprint("panel: net retry not scheduled: " .. to_string($message))
  end
end

-- PipeWire's server went away or is not up yet: subscribe again after a
-- delay doubling to five minutes. A reconnect backoff, not a state poll.
fn retry_audio()
  if $state.audio_retrying then return end
  $state.audio_retrying = true
  try
    task_start("audio.retry", "{}")
  catch $message
    $state.audio_retrying = false
    eprint("panel: audio retry not scheduled: " .. to_string($message))
  end
end

fn toggle_mute()
  $w = run_argv(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"], {timeout: 2, env: {XDG_RUNTIME_DIR: $PW_RUNTIME}})
  if not $w.ok then return $r.failure("mute_failed", "wpctl set-mute failed: " .. trim($w.stderr ?? "")) end
  return {ok: true, rc: 0, value: {}}
end


-- Each source re-reads only its own state: a link event forks no wpctl and
-- an audio event runs no netlink dump.
fn apply_net()
  $state.net = has_builtin("net_state") ? $r.status_net() : {up: false, wireless: false}
end

fn apply_volume()
  $state.vol = $state.audio_watch != nil ? $r.status_volume($PW_RUNTIME) : {ok: false, level: 0, muted: false}
end

fn apply_status()
  apply_net()
  apply_volume()
end

-- ── service state (events are hints; these reads are the truth) ─────────
fn fetch_windows()
  $out = $r.call($COMP, "comp.windows.list", {})
  if not $out.ok or type($out.value) != "map" or type($out.value.windows) != "list" then return false end
  $state.windows = $t.normal_windows($out.value.windows)
  $ws = $r.call($COMP, "comp.props.get", {path: "workspaces"})
  if $ws.ok and type($ws.value) == "map" then
    $state.ws_count = $ws.value.count ?? 1
    $state.ws_current = $ws.value.current ?? 1
  end
  return true
end

fn fetch_tray()
  $out = $r.call($TRAY, "tray.list", {})
  $ok = $out.ok and type($out.value) == "map" and type($out.value.items) == "list"
  $state.tray = $ok ? $out.value.items : []
end

-- notify.list rows carry no body; the props tree holds every notification.
fn fetch_notes()
  $out = $r.call($NOTIFY, "notify.props.get", {})
  $ok = $out.ok and type($out.value) == "map"
  $state.notes_count = $ok ? length($m.notification_rows($out.value)) : 0
end

-- Desired popup state is the loader's; applied completion arrives through
-- scenes.changed. The panel only tints the matching button.
fn apply_scenes($inventory)
  if type($inventory) != "map" or type($inventory.scenes) != "list" then return false end
  $open = {launcher: false, calendar: false, notes: false}
  for each $row in $inventory.scenes
    for each $key, $scene in $POPUPS
      if type($row) == "map" and $row.name == $scene and $row.open == true then $open[$key] = true end
    end
  end
  $state.open = $open
  return true
end

fn sync_popups()
  $out = $r.call($ctx.loader, "scenes.list", {})
  if $out.ok then apply_scenes($out.value) end
end

-- ── icons (the apps citizen resolves themes; cached per session) ─────────
-- Misses are cached too, so a missing theme costs one request per name, not
-- one per rebuild. apps.changed, an apps restart and a reconnect clear it.
fn apps_icon($name, $size, $theme)
  if $name == nil or $name == "" then return "" end
  $req = {name: $name, size: $size}
  if $theme != "" then $req.theme = $theme end
  $hit = $r.call($APPS, "apps.icon", $req)
  if $hit.ok and type($hit.value) == "map" and type($hit.value.path) == "string" then return $hit.value.path end
  return ""
end

-- A compositor app_id to an icon: the desktop entry's Icon= when one matches
-- (tried as-is, then lower-case), else the app_id as an icon name, else a
-- generic window icon.
fn window_icon($app_id)
  $icon_name = ""
  if $app_id != nil and $app_id != "" then
    for each $candidate in [$app_id, lower($app_id)]
      if $icon_name == "" then
        $entry = $r.call($APPS, "apps.get", {id: $candidate})
        if $entry.ok and type($entry.value) == "map" and type($entry.value.icon) == "string" then $icon_name = $entry.value.icon end
      end
    end
    if $icon_name == "" then $icon_name = $app_id end
  end
  $path = apps_icon($icon_name, 48, "")
  if $path == "" then $path = apps_icon("application-x-executable", 48, "") end
  return $path
end

fn resolve_icons()
  if length(keys($state.icons.windows)) + length(keys($state.icons.plain)) >= 512 then $state.icons = empty_icons() end
  for each $name in $m.PANEL_THEMED_ICONS
    if not has_key($state.icons.themed, $name) then
      $size = starts_with($name, "start-here") ? 48 : 22
      $state.icons.themed[$name] = apps_icon($name, $size, $ICON_THEME)
    end
  end
  for each $w in $t.panel_tasks($state.windows, $state.ws_current, $state.tasks_scope, $m.MAX_TASKS)
    $key = to_string($w.app_id)
    if not has_key($state.icons.windows, $key) then $state.icons.windows[$key] = window_icon($w.app_id) end
  end
  for each $item in $state.tray
    $name = $item.icon_name ?? ""
    if not has_key($state.icons.plain, $name) then $state.icons.plain[$name] = apps_icon($name, 24, "") end
  end
end

fn snapshot()
  return {windows: $state.windows, ws_count: $state.ws_count, ws_current: $state.ws_current,
    tasks_scope: $state.tasks_scope, tray: $state.tray, notes_count: $state.notes_count, net: $state.net, vol: $state.vol,
    open: $state.open, peeked: length($state.peeked) > 0}
end

-- ── one queued rebuild (dirty-state batching, no debounce sleep) ────────
fn rebuild()
  if not $state.ready then return end
  fetch_windows()
  fetch_tray()
  fetch_notes()
  resolve_icons()
  $model = $m.panel(snapshot(), $state.icons, time())
  $out = $r.publish_model($ctx, $model)
  if $out.ok then
    $state.model = $model
  else
    eprint("panel model refused: " .. json_encode($out.value))
  end
end

fn schedule()
  $state.dirty = true
  if $state.rebuilding or not $state.ready then return end
  $state.rebuilding = true
  try
    task_start("panel.rebuild", "{}")
  catch $message, $error
    $state.rebuilding = false
    raise($error.code, $message, $error.details)
  end
end

-- Local task only (empty headers): drains every change queued while the
-- previous pass was waiting on the Bus, then stops.
on panel.rebuild async
  if len(keys($event.headers)) != 0 then return end
  try
    while $state.dirty and $state.ready
      $state.dirty = false
      try
        rebuild()
      catch $message
        eprint("panel rebuild: " .. to_string($message))
      end
    end
  finally
    $state.rebuilding = false
  end
end

fn resync()
  $r.call($COMP, "comp.props.watch", {})
  sync_popups()
  refresh_status()
  schedule()
end

-- net_state() and audio_state() block for up to 2 s each, so a sync path
-- (init, bus.connected, a props gap) never calls them: it queues this one
-- local task instead. Single in flight, like the clock; never a Bus self-emit.
fn refresh_status()
  if $state.status_refreshing then return end
  $state.status_refreshing = true
  try
    task_start("status.refresh", "{}")
  catch $message
    $state.status_refreshing = false
    eprint("panel: status refresh not scheduled: " .. to_string($message))
  end
end

on status.refresh async
  if len(keys($event.headers)) != 0 then return end
  try
    apply_status()
  finally
    $state.status_refreshing = false
  end
  schedule()
end

-- The broker's full registration list, or nil when the snapshot failed.
fn registered()
  $out = $r.call($NODED, "noded.props.get", {})
  if not $out.ok or type($out.value) != "map" or type($out.value.services) != "map" then return nil end
  return $out.value.services.registered
end

fn services_changed($live)
  if type($live) != "list" then return end
  $previous = $state.services
  $state.services = $live
  if contains($live, $APPS) and not contains($previous, $APPS) then $state.icons = empty_icons() end
  if contains($live, $COMP) and not contains($previous, $COMP) then $r.call($COMP, "comp.props.watch", {}) end
  if not $state.ready then
    $ready = $r.ready($ctx)
    $state.ready = $ready.ok
    if $state.ready then resync() end
  end
  schedule()
end

-- ── the clock: one wall-clock deadline per displayed minute ──────────────
fn start_clock()
  if $state.clock_armed then return end
  $state.clock_armed = true
  try
    task_start("clock.deadline", "{}")
  catch $message, $error
    $state.clock_armed = false
    raise($error.code, $message, $error.details)
  end
end

on clock.deadline async
  if len(keys($event.headers)) != 0 then return end
  try
    while true
      sleep($p.seconds_to_next_minute(time()))
      try
        schedule()
      catch $message
        eprint("panel clock: " .. to_string($message))
      end
    end
  finally
    $state.clock_armed = false
  end
end

-- ── scene handlers ──────────────────────────────────────────────────────
fn toggle_popup($key)
  $out = $r.call($ctx.loader, "scenes.toggle", {name: $POPUPS[$key]})
  if $out.ok and type($out.value) == "map" then
    -- The loader keeps one popup open at a time.
    $open = {launcher: false, calendar: false, notes: false}
    $open[$key] = $out.value.open == true
    $state.open = $open
    schedule()
  end
  return $out
end

on launcher async
  $r.respond(toggle_popup("launcher"))
end
on calendar async
  $r.respond(toggle_popup("calendar"))
end
on notes async
  $r.respond(toggle_popup("notes"))
end

on ws async
  $index = $t.workspace_index($r.event_args($event).item)
  if $index == nil then $r.respond($r.failure("invalid_args", "item.index must be a workspace number")); return end
  $out = $r.call($COMP, "comp.workspace.switch", {index: $index})
  schedule()
  $r.respond($out)
end

on task async
  $item = $r.event_args($event).item
  if not fetch_windows() then $r.respond($r.failure("comp_unavailable", "window list unavailable")); return end
  $action = $t.task_action_at($state.windows, $item, $state.ws_current)
  if not $action.ok then
    schedule()
    $r.respond($r.failure($action.error_code, $action.message))
    return
  end
  $out = $r.call($COMP, $action.verb, $action.args)
  schedule()
  $r.respond($out)
end

on tray async
  $key = $t.tray_key($r.event_args($event).item)
  if $key == nil then $r.respond($r.failure("invalid_args", "item.key must name a tray item")); return end
  $r.respond($r.call($TRAY, "tray.activate", {id: $key}))
end

on vol_mute async
  $out = toggle_mute()
  apply_volume()
  schedule()
  $r.respond($out)
end

fn peek_toggle()
  if not fetch_windows() then return $r.failure("comp_unavailable", "window list unavailable") end
  if length($state.peeked) > 0 then
    for each $w in $t.peek_restores($state.windows, $state.peeked)
      $r.call($COMP, "comp.window.restore", $w)
    end
    $state.peeked = []
    return {ok: true, rc: 0, value: {peeked: false}}
  end
  $marks = []
  for each $w in $t.peek_candidates($state.windows, $state.ws_current)
    $out = $r.call($COMP, "comp.window.minimize", $w)
    if $out.ok then push($marks, $w) end
  end
  $state.peeked = $marks
  return {ok: true, rc: 0, value: {peeked: true, minimized: length($marks)}}
end

-- Two quick clicks must not interleave and clobber each other's restore
-- marks, so a click while one is running is refused.
on peek async
  if $state.peek_busy then $r.respond($r.failure("busy", "peek already in progress")); return end
  $state.peek_busy = true
  $out = nil
  try
    $out = peek_toggle()
  catch $message
    $out = $r.failure("peek_failed", to_string($message))
  end
  $state.peek_busy = false
  schedule()
  $r.respond($out)
end

on panel.state desc "panel model {model}; the last model the loader accepted"
  reply(0, json_encode({model: $state.model}))
end

on panel.tasks_scope desc "set the task scope {scope: all|current}, or toggle it {}; persisted beside the scene; replies {scope, file}"
  if $event.args != nil and $event.args != "" and type($event.args) != "map" then
    reply(10, json_encode({error_code: "invalid_args", message: "args must be {} or {scope}"}))
    return
  end
  $args = type($event.args) == "map" ? $event.args : {}
  $current = read_settings()
  $scope = $args.scope
  if $scope == nil then
    -- A toggle is relative to the file; one that cannot be read is not
    -- overwritten on a guess (an explicit scope replaces it).
    if $current.scope == nil then
      reply(10, json_encode({error_code: "settings_invalid", message: $current.why, file: $SETTINGS}))
      return
    end
    $scope = $current.scope == "all" ? "current" : "all"
  end
  if $t.valid_scope($scope) == nil then
    reply(10, json_encode({error_code: "invalid_args", message: "scope must be \"all\" or \"current\""}))
    return
  end
  $data = type($current.data) == "map" ? $current.data : {}
  $data.schema = $data.schema ?? 1
  $data.tasks_scope = $scope
  try
    write_atomic($SETTINGS, settings_text($data))
  catch $message
    reply(10, json_encode({error_code: "settings_unwritable", message: to_string($message), file: $SETTINGS}))
    return
  end
  $state.tasks_scope = $scope
  -- The scope and file changed: say so even if the redraw cannot be queued.
  try
    schedule()
  catch $message
    eprint("panel: tasks_scope redraw not scheduled: " .. to_string($message))
  end
  reply(0, json_encode({scope: $scope, file: $SETTINGS}))
end

on panel.refresh desc "queue one rebuild from fresh service state {}"
  schedule()
  reply(0, json_encode({queued: $state.ready}))
end

-- ── events ──────────────────────────────────────────────────────────────
fn gap($event)
  return $event.headers.gap == "true" or ($r.event_args($event).gap == true)
end

-- Compositor (windows, workspaces), tray and notification diffs all arrive
-- with the inner verb props.changed; broker registrations too.
on props.changed
  $a = $r.event_args($event)
  if $event.headers.topic == $NODED .. ".props.changed" then
    if gap($event) then
      services_changed(registered())
    elif $a.path == "services.registered" then
      services_changed($a.new)
    end
    return
  end
  if gap($event) then resync() else schedule() end
end

on tray.item.added
  schedule()
end
on tray.item.removed
  schedule()
end
on notification.created
  schedule()
end
on notification.closed
  schedule()
end
on apps.changed
  $state.icons = empty_icons()
  schedule()
end

on scenes.changed
  if gap($event) or not apply_scenes($r.event_args($event)) then sync_popups() end
  schedule()
end

on bus.connected
  if len(keys($event.headers)) != 0 then return end
  start_clock()
  $state.ready = false
  $state.icons = empty_icons()
  $ready = $r.ready($ctx)
  $state.ready = $ready.ok
  if $state.ready then resync() end
end

-- A closed batch from the live handle re-subscribes after the backoff; one
-- from an older handle (already replaced) changes nothing.
on net.changed async
  if len(keys($event.headers)) != 0 then return end
  $batch = type($event.args) == "map" ? $event.args : {}
  if type($batch.closed) == "map" then
    eprint("panel: net_watch ended: " .. to_string($batch.closed.message))
    if $batch.watch != $state.net_watch then return end
    try
      net_unwatch($batch.watch)
    catch $e
    end
    $state.net_watch = nil
    $state.net_retry = reset_if_lived($state.net_started, $state.net_retry)
    retry_net()
  end
  apply_net()
  schedule()
end

on audio.changed async
  if len(keys($event.headers)) != 0 then return end
  $batch = type($event.args) == "map" ? $event.args : {}
  if type($batch.closed) == "map" then
    eprint("panel: audio events ended: " .. to_string($batch.closed.message))
    if $batch.watch != $state.audio_watch then return end
    try
      audio_unwatch($batch.watch)
    catch $e
    end
    $state.audio_watch = nil
    $state.audio_retry = reset_if_lived($state.audio_started, $state.audio_retry)
    apply_volume()
    schedule()
    retry_audio()
    return
  end
  $state.audio_retry = 5
  apply_volume()
  schedule()
end

on net.retry async
  if len(keys($event.headers)) != 0 then return end
  try
    sleep($state.net_retry)
    $state.net_retry = min($state.net_retry * 2, 300)
  finally
    $state.net_retrying = false
  end
  start_net()
  apply_net()
  schedule()
end

on audio.retry async
  if len(keys($event.headers)) != 0 then return end
  try
    sleep($state.audio_retry)
    $state.audio_retry = min($state.audio_retry * 2, 300)
  finally
    $state.audio_retrying = false
  end
  start_audio()
  apply_volume()
  schedule()
end

-- A hand edit of settings.conf.mix (ced, the Scene Editor) applies live:
-- inotify on the scene directory, re-read on a change to that file or an
-- overflow. The panel's own write lands here too and changes nothing.
on fs.changed
  if len(keys($event.headers)) != 0 then return end
  if $event.args.watch != $state.settings_watch then return end
  $touched = $event.args.overflow == true
  for each $c in $event.args.changes ?? []
    if type($c) == "map" and $c.path == $SETTINGS then $touched = true end
  end
  if not $touched then return end
  $now = read_settings()
  if $now.scope == nil then
    eprint("panel: " .. $SETTINGS .. ": " .. $now.why .. "; keeping \"" .. $state.tasks_scope .. "\"")
    return
  end
  if $now.scope != $state.tasks_scope then
    $state.tasks_scope = $now.scope
    schedule()
  end
end

-- ── init: subscribe before the first snapshot ───────────────────────────
subscribe($COMP .. ".props.changed")
subscribe($TRAY .. ".item.added")
subscribe($TRAY .. ".item.removed")
subscribe($TRAY .. ".props.changed")
subscribe($NOTIFY .. ".changed")
subscribe($NOTIFY .. ".props.changed")
subscribe($APPS .. ".changed")
subscribe($NODED .. ".props.changed")
subscribe("scenes.changed")
start_status()
try
  $state.settings_watch = fs_watch(dirname($SETTINGS), {recursive: false, events: ["created", "modified", "deleted", "moved"]})
catch $message
  eprint("panel: settings watch unavailable (" .. to_string($message) .. "); edits apply on the next start")
end
$state.services = registered() ?? []
$ready = $r.ready($ctx)
if not $ready.ok then raise("SCENE_READY", json_encode($ready.value)) end
$state.ready = true
resync()
start_clock()
