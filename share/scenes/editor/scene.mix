size_bottom_minus_t: {"color":"#fcfcfc","size":13,"text":"−","widget":"text"}
size_bottom_value: {"align":"right","color":"#fcfcfc","size":12,"text":"= $model.edges.bottom.size","widget":"text","width":56}
size_bottom_plus: {"align":"center","children":["size_bottom_plus_t"],"height":26,"hover":"#ffffff1a","justify":"center","max_width":24,"min_width":24,"on_click":"editor.edge.size","widget":"row"}
size_bottom_plus_t: {"color":"#fcfcfc","size":13,"text":"+","widget":"text"}
edge_bottom_pages: {"align":"center","children":["pages_bottom","order_bottom_up","order_bottom_down"],"gap":6,"widget":"row"}
pages_bottom: {"align":"center","fill":true,"flow":"horizontal","gap":4,"on_click":"editor.edge.page","row":"page_bottom_row","row_height":26,"rows":"= $model.edges.bottom.pages","widget":"list"}
